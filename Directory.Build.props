<Project>
  <PropertyGroup>
    <Version>0.8.48-alpha.26</Version>
    <NoWarn>$(NoWarn);NU1507</NoWarn>

    <!-- Analyse nested projects (the test suites) with this worktree's own
         build once it has been published; the compiler's own sources stay on
         the pinned release they must bootstrap under. See degory/ghul#2151. -->
    <PropsDirectory>$([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileDirectory)'))</PropsDirectory>
    <GhulAnalyserCompiler Condition="'$(MSBuildProjectDirectory)' != '$(PropsDirectory)'">$(MSBuildThisFileDirectory)publish/ghul.dll</GhulAnalyserCompiler>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ghul.runtime" />
  </ItemGroup>
</Project>
