namespace Syntax.Parsers is
    use IO.Std;
    
    class LAZY_PARSER[T: class]: Parser[T] is
        _parser: System.Lazy[Parser[T]]?;

        create: () -> Parser[T] public
            = value is
                _parser = System.Lazy[Parser[T]](value);
            si

        init() is
            super.init();
        si

        parse(context: CONTEXT) -> T? is
            let parser = _parser;

            assert parser? else "Lazy parser is null: {self}";
            
            let v = parser.value;
            
            assert v? else "Lazy parser value is null: {_parser}";

            return v.parse(context);
        si
    si

si
