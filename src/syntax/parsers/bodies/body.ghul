namespace Syntax.Parsers.Bodies is
    use IO.Std;


    class BODY(
        expression_parser: Parser[Trees.Expressions.Expression],
        statement_parser: Parser[Trees.Statements.Statement],
        statement_list_parser: Parser[Trees.Statements.LIST],
        identifier_qualified_parser: Parser[Trees.Identifiers.Identifier]
    ): Base[Trees.Bodies.Body] is
        description: string => "function body";

        super();

        init(..) is
            add_parsers();
        si
        
        add_parsers() is
            add_parser(
                (context: CONTEXT) is
                    context.next_token(Lexical.TOKEN.ARROW_FAT);

                    // `=> throw E` stubs out a body that always diverges.
                    // `throw` is a statement, not an expression, so wrap
                    // it the way `if`/`case` bodies are wrapped; the body
                    // takes its type from the declared return type (or
                    // settles void when that is inferred).
                    if context.current.token == Lexical.TOKEN.THROW then
                        let statement = statement_parser.parse(context)!;
                        return Trees.Bodies.EXPRESSION(statement.location, Trees.Expressions.STATEMENT(statement.location, statement));
                    fi

                    let expression = expression_parser.parse(context)!;
                    return Trees.Bodies.EXPRESSION(expression.location, expression);
                si,
                Lexical.TOKEN.ARROW_FAT
            );

            add_parser(
                (context: CONTEXT) is
                    let start = context.location;
                    context.next_token(Lexical.TOKEN.IS);
                    let statement_list = statement_list_parser.parse(context)!;

                    // A closing `si` indented left of the column the
                    // enclosing member or global started at closes an
                    // enclosing construct, and the body just parsed is
                    // missing its own `si`. Report that at the token and
                    // leave it unconsumed, so the enclosing list closes
                    // here and the definitions after it parse normally
                    // instead of being swallowed as members to end of
                    // file. Two `si` tokens in a row are the legal (if
                    // unusual) shape of both closers written at the same
                    // leftward column, so that case consumes normally.
                    if context.current.token == Lexical.TOKEN.SI then
                        let enclosing_indent =
                            if context.in_member then
                                context.member_indent
                            elif context.in_global_function then
                                context.global_indent
                            else
                                null
                            fi;

                        if enclosing_indent? /\ context.location.start_column < enclosing_indent then
                            let next_is_si = val
                                let probe = context.tokenizer_speculate_then_backtrack_bounded();
                                context.next_token(Lexical.TOKEN.SI);
                                let result = context.current.token == Lexical.TOKEN.SI;
                                probe.backtrack();
                                result
                            lav;

                            if !next_is_si then
                                context.error(context.location, "the definition above is missing its si");

                                return Trees.Bodies.BLOCK(start::context.location, statement_list);
                            fi
                        fi
                    fi

                    let end = context.location;
                    context.next_token(Lexical.TOKEN.SI);
                    return Trees.Bodies.BLOCK(start::end, statement_list);
                si,
                Lexical.TOKEN.IS
            );

            add_parser(
                (context: CONTEXT) is
                    let start = context.location;
                    context.next_token(Lexical.TOKEN.INNATE);
                    let identifier = identifier_qualified_parser.parse(context)!;
                    return Trees.Bodies.INNATE(start::identifier.location, identifier);
                si,
                Lexical.TOKEN.INNATE
            );            
        si

        other_token(context: CONTEXT) -> Trees.Bodies.Body => 
            Trees.Bodies.NULL(context.location);
    si
si
