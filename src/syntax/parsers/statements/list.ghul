namespace Syntax.Parsers.Statements is
    use System.Exception

    use IO.Std

    use Source

    use Ghul.Pipes

    class LIST(
        terminators: Collections.LIST[Lexical.TOKEN],
        statement_parser: Parser[Trees.Statements.Statement]
    ): Base[Trees.Statements.LIST] is
        terminators: Collections.List[Lexical.TOKEN]
        description: string => "statement list"

        super()

        parse(context: CONTEXT) -> Trees.Statements.LIST is
            self.terminators = terminators

            let start = context.location
            let end mut = context.location
            let statements = Collections.LIST[Trees.Statements.Statement]()

            let want_semicolon mut = false

            // Whether the final statement of the list was terminated with
            // a written `;`. Compound statements never demand one, so a
            // `;` after them is consumed here and recorded - at end-of-body
            // the fact distinguishes a discarded statement from an
            // implicit tail return.
            let last_terminated mut = true

            while !context.is_end_of_file /\ !at_terminator(context) do
                if context.current.token == Lexical.TOKEN.SEMICOLON then
                    let semicolon_location = context.location
                    context.next_token()
                    context.note_written_terminator(semicolon_location)

                    want_semicolon = false
                    last_terminated = true;
                elif want_semicolon then
                    case context.accept_terminator(end)
                    when Parsers.TERMINATOR.WRITTEN then
                        last_terminated = true;
                    when Parsers.TERMINATOR.INFERRED then
                        last_terminated = false;
                    when Parsers.TERMINATOR.MISSING then
                        // reported; recovery continues below as before
                    esac

                    want_semicolon = false;
                else
                    try
                        let statement = statement_parser.parse(context)

                        if statement? then
                            statements.add(statement)

                            end = statement.location

                            if statement.expects_semicolon then
                                want_semicolon = true
                                last_terminated = false;
                            elif context.current.token == Lexical.TOKEN.SEMICOLON then
                                let semicolon_location = context.location
                                context.next_token()
                                context.note_written_terminator(semicolon_location)
                                last_terminated = true;
                            else
                                last_terminated = false;
                            fi
                        else
                            // the statement parser reported its errors and gave up:
                            // skip ahead so the unparsed tokens don't produce a
                            // cascade of follow-on errors
                            end = recover_to_terminator(context);
                        fi
                    catch e: UnwindException
                        throw e;
                    catch e: Exception
                        end = recover_to_terminator(context);
                    yrt
                fi
            od

            let result = Trees.Statements.LIST(start::end, statements)
            result.last_was_terminated = last_terminated

            return result;
        si

        at_terminator(context: CONTEXT) -> bool => terminators |> any(t => t == context.current_token)

        recover_to_terminator(context: CONTEXT) -> LOCATION is
            let end mut = context.current.location

            while !at_terminator(context) do
                end = context.current.location

                context.next_token();
            od

            return end;
        si
    si
si
