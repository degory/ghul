namespace Syntax.Parsers.Statements is
    use System.Exception

    use IO.Std

    use Source

    use Ghul.Pipes

    class LIST(
        terminators: Collections.LIST[Lexical.TOKEN],
        statement_parser: Parser[Trees.Statements.Statement]
    ): Base[Trees.Statements.LIST] is
        terminators: Collections.List[Lexical.TOKEN]
        description: string => "statement list"

        super()

        parse(context: CONTEXT) -> Trees.Statements.LIST is
            self.terminators = terminators

            let start = context.location
            let end mut = context.location
            let statements = Collections.LIST[Trees.Statements.Statement]()

            let want_semicolon mut = false

            // Whether the final statement of the list was terminated with
            // a written `;`. Compound statements never demand one, so a
            // `;` after them is consumed here and recorded - at end-of-body
            // the fact distinguishes a discarded statement from an
            // implicit tail return.
            let last_terminated mut = true

            while !context.is_end_of_file /\ !at_terminator(context) do
                if context.current.token == Lexical.TOKEN.SEMICOLON then
                    let semicolon = context.current
                    context.next_token()
                    context.note_written_terminator(semicolon)

                    want_semicolon = false
                    last_terminated = true
                elif want_semicolon then
                    case context.accept_terminator()
                    when Parsers.TERMINATOR.WRITTEN then
                        last_terminated = true
                    when Parsers.TERMINATOR.INFERRED then
                        last_terminated = false
                    when Parsers.TERMINATOR.MISSING then
                        // reported; recovery continues below as before
                    esac

                    want_semicolon = false
                else
                    try
                        let statement = statement_parser.parse(context)

                        if statement? then
                            statements.add(statement)

                            end = statement.location

                            if statement.expects_semicolon then
                                want_semicolon = true
                                last_terminated = false
                            elif context.current.token == Lexical.TOKEN.SEMICOLON then
                                let semicolon = context.current
                                context.next_token()
                                context.note_written_terminator(semicolon)
                                last_terminated = true
                            else
                                // A compound statement demands no terminator,
                                // so its boundary never reaches
                                // accept_terminator - but a `;` written here
                                // is redundant, so the boundary is one the
                                // inlay marks.
                                context.note_inferred_terminator()

                                last_terminated = false
                            fi
                        else
                            // the statement parser reported its errors and gave up:
                            // skip ahead so the unparsed tokens don't produce a
                            // cascade of follow-on errors
                            end = recover_to_terminator(context, start.start_column)
                        fi
                    catch e: UnwindException
                        throw e
                    catch e: Exception
                        end = recover_to_terminator(context, start.start_column)
                    yrt
                fi
            od

            // The last statement of the list falls out of the loop before
            // reaching accept_terminator, so its boundary is recorded here.
            if want_semicolon then
                context.note_inferred_terminator()
            fi

            let result = Trees.Statements.LIST(start::end, statements)
            result.last_was_terminated = last_terminated

            return result
        si

        at_terminator(context: CONTEXT) -> bool => terminators |> any(t => t == context.current_token)

        // Resynchronise after a statement the parser could not build. The
        // tokens from here to the next statement boundary are unparsed, so
        // skipping them stops each producing an error of its own - but
        // skipping too many is far worse than skipping too few. A closer
        // consumed here leaves every enclosing construct hunting a closer
        // that no longer exists, and one unparseable statement takes the
        // rest of the body with it.
        //
        // Three things stop the skip. A terminator of this list, and a
        // keyword that can only begin a statement, stop it only where the
        // constructs in between have all closed: either can legitimately
        // appear inside one being skipped over, and a flat scan that
        // ignored that would halt on the `fi` of an `if` whose head it had
        // just consumed, which every level above reads as its own closer
        // arriving early.
        //
        // The third is a line indented no further than the list itself, and
        // that one stops the skip whatever is still open. It is what bounds
        // the damage when the constructs do not balance, which is the
        // ordinary state of code being edited: an opener with no closer
        // would otherwise leave every other escape unreachable and the skip
        // would run to the end of the file. Where the nesting and the
        // layout disagree about whether anything is still open, the layout
        // is the more reliable witness, because it is not the thing the
        // mistake corrupted.
        //
        // What is tracked is a stack of the closers being waited for rather
        // than a count of them, because a count cannot tell a construct's
        // own closing keyword from a dedent - a closer is written level
        // with its opener, not indented under it - and would stop the skip
        // on every nested `si`. A closer that is the one being waited for
        // closes it; one that is not says the stack itself is wrong, so it
        // is abandoned and the token is offered to the checks above.
        //
        // The skip always consumes at least one token once it has started,
        // or the caller re-attempts the same failing parse forever.
        recover_to_terminator(context: CONTEXT, indent: int) -> LOCATION is
            let end mut = context.previous_end
            let expected = Collections.STACK[Lexical.TOKEN]()
            let consumed mut = false

            while !context.is_end_of_file do
                let token = context.current_token
                let awaited = expected.count > 0 /\ expected.peek() == token

                if _closes_something(token) /\ expected.count > 0 /\ !awaited then
                    expected.clear()
                fi

                let balanced = expected.count == 0

                if balanced /\ at_terminator(context) then
                    break
                fi

                if consumed /\ !awaited /\ _at_resync_point(context, indent, balanced) then
                    break
                fi

                if awaited then
                    expected.pop()
                elif let closer = _closer_for(token) then
                    expected.push(closer)
                fi

                end = context.current.location

                context.next_token()

                consumed = true
            od

            return end
        si

        // A line that has dedented back to the list's own level starts
        // something new whatever it opens with, and whatever is still open.
        // Deeper in, only a keyword that can begin nothing but a statement
        // is taken as a fresh start, and only where nothing is open: an
        // identifier or a literal there is far more often the tail of the
        // construct being skipped, and a keyword inside an unclosed one
        // belongs to it.
        _at_resync_point(context: CONTEXT, indent: int, balanced: bool) -> bool is
            if !context.current.first_on_line then
                return false
            fi

            context.current.location.start_column <= indent \/
            (balanced /\ _starts_statement(context.current_token))
        si

        _starts_statement(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.LET \/
            token == Lexical.TOKEN.IF \/
            token == Lexical.TOKEN.CASE \/
            token == Lexical.TOKEN.WHILE \/
            token == Lexical.TOKEN.FOR \/
            token == Lexical.TOKEN.TRY \/
            token == Lexical.TOKEN.RETURN \/
            token == Lexical.TOKEN.YIELD \/
            token == Lexical.TOKEN.THROW \/
            token == Lexical.TOKEN.BREAK \/
            token == Lexical.TOKEN.CONTINUE \/
            token == Lexical.TOKEN.ASSERT

        // The closing keyword an opening one is waited for with. Loops are
        // keyed on their `do` rather than their `while` or `for`: all three
        // forms carry exactly one `do` and close with one `od`, so waiting
        // on the head as well would leave every counted loop open.
        _closer_for(token: Lexical.TOKEN) -> Lexical.TOKEN? =>
            case token
            when Lexical.TOKEN.IF then Lexical.TOKEN.FI
            when Lexical.TOKEN.DO then Lexical.TOKEN.OD
            when Lexical.TOKEN.CASE then Lexical.TOKEN.ESAC
            when Lexical.TOKEN.TRY then Lexical.TOKEN.YRT
            when Lexical.TOKEN.IS then Lexical.TOKEN.SI
            when Lexical.TOKEN.VAL then Lexical.TOKEN.LAV
            when Lexical.TOKEN.PAREN_OPEN then Lexical.TOKEN.PAREN_CLOSE
            when Lexical.TOKEN.SQUARE_OPEN then Lexical.TOKEN.SQUARE_CLOSE
            when Lexical.TOKEN.SQUARE_OPEN_TICK then Lexical.TOKEN.SQUARE_CLOSE
            else null
            esac

        _closes_something(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.FI \/
            token == Lexical.TOKEN.OD \/
            token == Lexical.TOKEN.ESAC \/
            token == Lexical.TOKEN.YRT \/
            token == Lexical.TOKEN.SI \/
            token == Lexical.TOKEN.LAV \/
            token == Lexical.TOKEN.PAREN_CLOSE \/
            token == Lexical.TOKEN.SQUARE_CLOSE
    si
si
