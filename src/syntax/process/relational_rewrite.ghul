namespace Syntax.Process is
    // Whether a binary expression that resolved to a `<>` member got
    // there by the parser's relational rewrite rather than by being
    // written as `<>`.
    //
    // `<`, `<=`, `>` and `>=` all parse into a call to `<>` (see
    // `_real_operation` in the expression parser), so the operation
    // name alone cannot tell the two apart. The distinction decides
    // what the expression produces: a rewritten token wants the bool
    // its surface syntax promised, reduced from the ordering value,
    // while a literal `<>` yields that ordering value itself.
    class RELATIONAL_REWRITE is
        is_relational_rewrite(operation_name: string?, actual_operation: string?) -> bool static is
            if !operation_name? \/ !(operation_name =~ "<>") then
                return false;
            fi

            return
                actual_operation =~ "<" \/ actual_operation =~ "<=" \/
                actual_operation =~ ">" \/ actual_operation =~ ">=";
        si
    si
si
