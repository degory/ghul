namespace Syntax.Process is
    use Logging

    use Trees

    // Walks the edited file's declaration skeleton, entering the retained
    // scopes, and re-declares each function's body through DECLARE_MEMBERS -
    // the declare-symbols half of the incremental body re-walk.
    //
    // The interface declarations are not re-declared: ScopedVisitor's
    // inherited `pre`/`visit` for namespace / class / trait / … only *enter*
    // the retained scopes (a lookup, not a fresh declaration), so the
    // retained interface symbols are kept and declare-symbols' non-idempotency
    // is never exercised. Only the new body subtrees get fresh block scopes
    // and locals.
    class BODY_DECLARER: ScopedVisitor is
        _declare_members: DECLARE_MEMBERS

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            declare_members: DECLARE_MEMBERS
        ) is
            super.init(logger, symbol_table, namespaces)

            _declare_members = declare_members
        si

        // At a function: enter its retained scope, declare the new body, and
        // return true so the skeleton walk does not also descend the body.
        // `visit(function)` (inherited) leaves the scope.
        pre(function: Trees.Definitions.FUNCTION) -> bool is
            enter_scope(function)

            if function.is_top_level_entry then
                _remove_top_level_variables()
            fi

            _declare_members.declare_body(function)

            return true
        si

        // A top-level `let` is declared into the file's namespace from
        // inside the synthesised entry's body, so re-declaring that body
        // declares each of them again. The ones the previous build left
        // are removed first: the entry is the only thing that declares a
        // variable of this kind into the namespace, so all of them are
        // its own, and an edit that renamed or removed one leaves nothing
        // behind for a sibling function to resolve against. The namespace
        // block remembers what each name resolved to, so that goes too.
        _remove_top_level_variables() is
            if let scope = _symbol_table.current_namespace_block then
                scope.forget_lookups()
            fi

            let `namespace = _symbol_table.current_namespace_symbol

            if !`namespace? then
                return
            fi

            let stale = Collections.LIST[string]()

            for symbol in `namespace.symbols do
                if isa Semantic.Symbols.TOP_LEVEL_VARIABLE(symbol) then
                    stale.add(symbol.name)
                fi
            od

            for name in stale do
                `namespace.remove_direct(name)
            od
        si

        // Property and indexer accessor bodies are reached through the
        // synthesised sibling `$get_`/`$set_` (and `get_`/`set_`) FUNCTION
        // nodes, so the declaration node itself is not descended.
        pre(property: Trees.Definitions.PROPERTY) -> bool => true

        pre(indexer: Trees.Definitions.INDEXER) -> bool => true
    si
si
