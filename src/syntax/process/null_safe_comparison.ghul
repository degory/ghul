namespace Syntax.Process is
    // How a null-safe `=~` compares its two operands once the presence
    // tests around it have settled that both are there.
    //
    // The wrapper is the same either way - the presence tests, the
    // temporaries, the arms that answer for an absent operand - so the
    // only thing that varies is the comparison at the centre of it,
    // and it varies exactly as it does for two operands that were
    // never optional.
    //
    // Nothing compares two of these, so what the synthesized `=~`
    // would make of a field whose type declares none does not arise.
    @suppress("synthesized-equality-fallback")
    union NullSafeComparison is
        // An operator reached with the left operand as its receiver: a
        // `=~` declared on the type, or the innate one an enum carries.
        OPERATOR(function: Semantic.Symbols.Function)

        // A type that cannot declare an operator - a tuple, or a bare
        // type parameter - compared through `EqualityComparer[T]`.
        COMPARER(comparer_type: Semantic.Types.Type)
    si
si
