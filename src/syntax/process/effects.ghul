namespace Syntax.Process is
    use Function = Semantic.Symbols.Function;
    use Symbol = Semantic.Symbols.Symbol;
    use Semantic.Symbols.STORE_FREE_IMPORTS;

    // The solved whole-program effect facts the reliance judge reads:
    // per function, the members it may write, and the members it may
    // assign a possibly-absent value, each folded over everything the
    // function can dispatch to or invoke. Installed by the
    // infer-effects pass after compile-expressions; every query answers
    // conservatively until then, and again after clear().
    //
    // Keys are root symbols on both axes - a specialized function or
    // member queries as its root - so facts recorded against one
    // instantiation answer for all of them.
    class EFFECTS is
        _write_sets: Collections.MutableMap[Function, Collections.SET[Symbol]]? static;
        _write_unbounded: Collections.SET[Function]? static;
        _null_sets: Collections.MutableMap[Function, Collections.SET[Symbol]]? static;
        _null_unbounded: Collections.SET[Function]? static;
        _store_free: Collections.SET[Function]? static;

        is_solved: bool static => _write_sets?;

        install(
            write_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            write_unbounded: Collections.SET[Function],
            null_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            null_unbounded: Collections.SET[Function],
            store_free: Collections.SET[Function]
        ) static is
            _write_sets = write_sets;
            _write_unbounded = write_unbounded;
            _null_sets = null_sets;
            _null_unbounded = null_unbounded;
            _store_free = store_free;
        si

        clear() static is
            _write_sets = null;
            _write_unbounded = null;
            _null_sets = null;
            _null_unbounded = null;
            _store_free = null;
        si

        // May calling `callee` - or anything it can reach - store to
        // `member` through any receiver? Conservatively yes when
        // nothing is solved, when the callee's write set could not be
        // bounded, or when the callee was not walked and is neither
        // declared pure nor on the curated store-free whitelist.
        may_write(callee: Function?, member: Symbol?) -> bool static is
            let sets = _write_sets;
            let unbounded = _write_unbounded;

            if !sets? \/ !unbounded? \/ !callee? \/ !member? then
                return true;
            fi

            let root = cast Function?(callee.root_specialized_from);

            if !root? then
                return true;
            fi

            if !sets.contains_key(root) then
                // not walked here: a store-free or receiver-interior
                // import writes no ghul member; anything else could
                return !_trusted_leaf(root) /\ !root.writes_only_receiver_interior;
            fi

            if unbounded.contains(root) then
                return true;
            fi

            return sets[root].contains(member.root_specialized_from);
        si

        // May calling `callee` - or anything it can reach - assign a
        // possibly-absent value to `member`? Same conservative
        // defaults as may_write.
        may_null(callee: Function?, member: Symbol?) -> bool static is
            let sets = _null_sets;
            let unbounded = _null_unbounded;

            if !sets? \/ !unbounded? \/ !callee? \/ !member? then
                return true;
            fi

            let root = cast Function?(callee.root_specialized_from);

            if !root? then
                return true;
            fi

            if !sets.contains_key(root) then
                // not walked here: a store-free or receiver-interior
                // import writes no ghul member; anything else could
                return !_trusted_leaf(root) /\ !root.writes_only_receiver_interior;
            fi

            if unbounded.contains(root) then
                return true;
            fi

            return sets[root].contains(member.root_specialized_from);
        si

        // Does `callee` provably store nothing at all - member writes,
        // element writes, and everything reachable included? The
        // strong answer property facts need, since a getter can read
        // any of it.
        is_store_free(callee: Function?) -> bool static is
            if !callee? then
                return false;
            fi

            let root = cast Function?(callee.root_specialized_from);

            if !root? then
                return false;
            fi

            // The declared, whitelisted and previously-proven answers
            // are sound however this run's solve went, so take the
            // union with the solved set rather than replacing it.
            if root.is_store_free then
                return true;
            fi

            let store_free = _store_free;

            return store_free? /\ store_free.contains(root);
        si

        _trusted_leaf(root: Function) -> bool static =>
            root.is_declared_pure \/ STORE_FREE_IMPORTS.is_store_free(root);
    si
si
