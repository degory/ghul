namespace Syntax.Process is
    use Semantic.Types.Type;

    // Whether a `null` written at a call site lands in a slot that
    // cannot hold it. Stated here rather than inline so both consumers
    // read the same rule: the literal's own visit asks
    // is_non_optional_reference about the constraint pushed onto it,
    // and the argument sweep that runs once overload resolution has a
    // callee asks should_report about the formal the argument landed
    // on.
    class NULL_ARGUMENT_CHECK is
        init() is si

        // True iff `type` is a non-optional reference type - the kind
        // of slot the non-optional-by-default check guards. Value
        // types, `T?`, type variables, void and error/placeholder
        // types are all excluded.
        is_non_optional_reference(type: Type?) -> bool =>
            type? /\ type.is_named /\
            !type.is_value_type /\ !type.is_optional /\
            !type.is_type_variable /\ !type.is_void /\
            !type.is_error /\ !type.is_inferred;

        // True iff `argument`, as written, is a bare `null` landing on
        // a formal that cannot hold one.
        //
        // An argument already carrying the constraint is left alone:
        // it was walked with the formal pushed onto it, so its own
        // visit reported it, and reporting again here would duplicate.
        should_report(argument: Trees.Expressions.Expression, formal: Type?) -> bool =>
            isa Trees.Expressions.NULL(argument) /\
            !is_non_optional_reference(argument.expected_type) /\
            is_non_optional_reference(formal);
    si
si
