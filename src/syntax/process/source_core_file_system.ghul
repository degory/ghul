@@IF.not.dotnet()

// The part of System.IO.Abstractions that EXPAND_NAMESPACES reads, for a
// build of the compiler with no .NET library to supply it: the real file
// system, through the core library's IO. The work is done in
// Syntax.Process, where IO names the core library's namespace rather
// than System.IO.
namespace System.IO.Abstractions is
    use Syntax.Process.SOURCE_CORE_PATH_ACCESS
    use Syntax.Process.SOURCE_CORE_DIRECTORY_ACCESS
    use Syntax.Process.SOURCE_CORE_FILE_ACCESS
    use Syntax.Process.SOURCE_CORE_DIRECTORY_INFO_FACTORY

    @suppress("non-upper-snake-case-name")
    class FileSystem: IFileSystem is
        path: SOURCE_CORE_PATH_ACCESS => SOURCE_CORE_PATH_ACCESS()
        directory: SOURCE_CORE_DIRECTORY_ACCESS => SOURCE_CORE_DIRECTORY_ACCESS()
        directory_info: SOURCE_CORE_DIRECTORY_INFO_FACTORY => SOURCE_CORE_DIRECTORY_INFO_FACTORY()
        file: SOURCE_CORE_FILE_ACCESS => SOURCE_CORE_FILE_ACCESS()

        init() is si
    si

    trait IFileSystem is
        path: SOURCE_CORE_PATH_ACCESS
        directory: SOURCE_CORE_DIRECTORY_ACCESS
        directory_info: SOURCE_CORE_DIRECTORY_INFO_FACTORY
        file: SOURCE_CORE_FILE_ACCESS
    si

    @suppress("non-upper-snake-case-name")
    class IDirectoryInfo is
        full_name: string

        init(full_name: string) is
            self.full_name = full_name
        si

        name: string => SOURCE_CORE_PATH_ACCESS.file_name(full_name)

        parent: IDirectoryInfo? is
            if let directory = SOURCE_CORE_PATH_ACCESS().get_directory_name(full_name) then
                return IDirectoryInfo(directory)
            fi

            return null
        si
    si
si

namespace Syntax.Process is
    use IO.Path
    use IO.File
    use IO.Directory

    class SOURCE_CORE_PATH_ACCESS is
        init() is si

        get_path_root(path: string) -> string? =>
            if path.starts_with('/') then "/" else "" fi

        get_file_name_without_extension(path: string) -> string? => Path.get_file_name_without_extension(path)

        get_directory_name(path: string) -> string? => Path.get_directory_name(path)

        combine(first: string, second: string) -> string => Path.combine(first, second)

        file_name(path: string) -> string static => Path.get_file_name(path)
    si

    class SOURCE_CORE_DIRECTORY_ACCESS is
        init() is si

        get_current_directory() -> string => Directory.get_current_directory()

        get_files(path: string, pattern: string) -> string[] => Directory.get_files(path, pattern)
    si

    class SOURCE_CORE_FILE_ACCESS is
        init() is si

        exists(path: string) -> bool => File.exists(path)
    si

    class SOURCE_CORE_DIRECTORY_INFO_FACTORY is
        init() is si

        `new(path: string) -> System.IO.Abstractions.IDirectoryInfo =>
            System.IO.Abstractions.IDirectoryInfo(Path.get_full_path(path))
    si
si
