namespace Syntax.Process is
    use Symbol = Semantic.Symbols.Symbol
    use Type = Semantic.Types.Type

    // Why a use that names a member, or reads through a value that may
    // be absent, is failing: the narrowing it would have needed was
    // dropped earlier in this body, at a call the effect relations
    // could not show left the value alone. The kill ledger holds every
    // such drop of the walk, so the question is only which of them this
    // use is short of, and the answer goes on the error as related
    // information at the call.
    class DROPPED_NARROWING is
        // The call that dropped a type narrowing which would have made
        // this member reachable. A drop of some other fact about the
        // same value, or of a narrowing the member is missing from too,
        // explains nothing and is not offered.
        for_member(target: Symbol?, path: ACCESS_PATH?, name: string) -> KILL? static is
            if !target? /\ !path? then
                return null
            fi

            let kill = KILL_LEDGER.first_dropped(target, path, false)

            if !kill? then
                return null
            fi

            if let narrowed = kill.narrowed_type /\ _has_member(narrowed, name) then
                return kill
            fi

            return null
        si

        // The call that dropped the presence of this value.
        for_presence(target: Symbol?, path: ACCESS_PATH?) -> KILL? static is
            if !target? /\ !path? then
                return null
            fi

            return KILL_LEDGER.first_dropped(target, path, true)
        si

        // What to say at the call. One wording for both domains: a
        // presence fact narrows an optional to the type it holds, which
        // is what was lost as much as a type test's own narrower type.
        message(kill: KILL) -> string static is
            let what = if let target = kill.target then target.name elif let path = kill.path then path.to_string() else "the value" fi

            if let narrowed = kill.narrowed_type then
                "the narrowing of {what} to {narrowed} ended at this call"
            else
                "the narrowing of {what} ended at this call"
            fi
        si

        _has_member(type: Type, name: string) -> bool static is
            if let named: Semantic.Types.NAMED = type then
                return named.find_member(name)?
            fi

            return false
        si
    si
si
