namespace Syntax.Process is
    use Symbol = Semantic.Symbols.Symbol
    use LOCATION = Source.LOCATION

    // One heap fact killed at one call during a body walk, because the
    // relations solved by the previous effects round could not show
    // the callee left it alone.
    class KILL(
        file_name: string,
        crossing: CROSSING,
        target: Symbol?,
        path: ACCESS_PATH?,
        is_presence: bool
    )

    // The combined type + effect solve prototype, in-walk form. When a
    // solved set of effect relations exists, the call transfer asks of
    // every heap fact live across a call whether the callee provably
    // left it alone, and drops the fact at the call when it cannot -
    // the fact's validity region ends there, the widened view flows
    // on, and a use only the fact satisfied is an ordinary type error.
    //
    // A walk made with no relations solved, or with relations an edit
    // has since made stale, may have kept a fact it should have dropped
    // or dropped one it should have kept. Both are found after the next
    // solve: the reliance judge reports the first as a load whose
    // crossing is undischarged, and this ledger reports the second as
    // a recorded kill whose crossing is now discharged. Either makes
    // the file inexact, and the driver re-walks inexact files until a
    // solve finds none. The ledger keys nothing on rendered text: it
    // holds the crossing and fact objects the walk recorded.
    class KILL_LEDGER is
        _kills: Collections.LIST[KILL] static
        _inexact: Collections.SET[string] static
        _enabled: bool static

        init() static is
            _kills = Collections.LIST[KILL]()
            _inexact = Collections.SET[string]()
            _enabled = System.Environment.get_environment_variable("GHUL_COMBINED_SOLVE")?
        si

        // Enabled by GHUL_COMBINED_SOLVE.
        enabled: bool static => _enabled

        // Whether the walk can consult relations at all.
        can_kill_in_walk: bool static => enabled /\ EFFECTS.is_solved

        record(kill: KILL) static is
            if enabled then
                _kills.add(kill)
            fi
        si

        // A file whose walk kept a fact the solved relations cannot
        // back: reported by the judge from a stamped load.
        note_inexact(file_name: string) static is
            if enabled then
                _inexact.add(file_name)
            fi
        si

        // The file's walk is being redone from its source: whatever it
        // recorded is superseded by the walk to come.
        clear_for(file_name: string) static is
            if !enabled then
                return
            fi

            let kept = Collections.LIST[KILL]()

            for kill in _kills do
                if kill.file_name !~ file_name then
                    kept.add(kill)
                fi
            od

            _kills = kept
        si

        clear_all() static is
            if enabled then
                _kills.clear()
                _inexact.clear()
            fi
        si

        // After a solve: every file the judge found inexact, plus every
        // file holding a kill the new relations would not make. Empty
        // means the last walk of every file agrees with the relations,
        // which is the fixpoint.
        take_inexact_files() -> Collections.SET[string] static is
            let files = Collections.SET[string]()

            if !enabled then
                return files
            fi

            for file_name in _inexact do
                files.add(file_name)
            od

            _inexact.clear()

            for kill in _kills do
                if RELIANCES.crossing_discharged(kill.crossing, kill.target, kill.path, kill.is_presence) then
                    files.add(kill.file_name)
                fi
            od

            return files
        si
    si
si
