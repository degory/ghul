namespace Syntax.Process is
    use Symbol = Semantic.Symbols.Symbol
    use LOCATION = Source.LOCATION

    // One heap fact crossed by one call during a body walk, and what
    // the walk did about it: killed it, because the relations solved by
    // the previous effects round could not show the callee left it
    // alone, or kept it - because they could, or because no relations
    // had been solved yet. `function` is the definition whose walk
    // made the record, so that walk alone can be redone.
    class KILL(
        file_name: string,
        crossing: CROSSING,
        target: Symbol?,
        path: ACCESS_PATH?,
        is_presence: bool,
        killed: bool
    ) is
        function: Trees.Definitions.FUNCTION? public
    si

    // The combined type + effect solve prototype, in-walk form. When a
    // solved set of effect relations exists, the call transfer asks of
    // every heap fact live across a call whether the callee provably
    // left it alone, and drops the fact at the call when it cannot -
    // the fact's validity region ends there, the widened view flows
    // on, and a use only the fact satisfied is an ordinary type error.
    //
    // Every crossing a fact takes is recorded here with the walk's
    // decision. After each solve the decisions are re-asked against the
    // new relations: a fact kept across a call that cannot now be
    // discharged - every crossing of a walk made before any solve, and
    // some after an edit - or dropped at one that now can, makes its
    // body inexact, and the driver re-walks inexact bodies until a
    // solve finds none. The ledger keys nothing on rendered text: it
    // holds the crossing, fact and definition objects the walk
    // recorded.
    class KILL_LEDGER is
        _kills: Collections.LIST[KILL] static
        _enabled: bool static

        init() static is
            _kills = Collections.LIST[KILL]()
            _enabled = !System.Environment.get_environment_variable("GHUL_NO_COMBINED_SOLVE")?
        si

        // On unless GHUL_NO_COMBINED_SOLVE is set.
        enabled: bool static => _enabled

        // The file whose bodies are being walked, for records made
        // where no location is at hand.
        current_file: string? public static

        // The definition whose body is being walked. Set for the
        // duration of each definition's walk by compile-expressions;
        // a record made outside one is keyed on its file alone.
        current_function: Trees.Definitions.FUNCTION? public static

        // Whether the walk can consult relations at all.
        can_kill_in_walk: bool static => enabled /\ EFFECTS.is_solved

        record(kill: KILL) static is
            if enabled then
                kill.function = current_function

                _kills.add(kill)
            fi
        si

        // The file's walk is being redone from its source: whatever it
        // recorded is superseded by the walk to come.
        clear_for(file_name: string) static is
            _drop_where(kill => kill.file_name =~ file_name)
        si

        // One definition's body walk is being redone.
        clear_for(function: Trees.Definitions.FUNCTION) static is
            _drop_where(kill => kill.function == function)
        si

        _drop_where(condition: (KILL) -> bool) static is
            if !enabled then
                return
            fi

            let kept = Collections.LIST[KILL]()

            for kill in _kills do
                if !condition(kill) then
                    kept.add(kill)
                fi
            od

            _kills = kept
        si

        // One line per record, for comparing what walks recorded.
        dump(writer: IO.TextWriter) static is
            for kill in _kills do
                let what = if let target = kill.target then target.name elif let path = kill.path then path.to_string() else "?" fi

                writer.write_line("{kill.file_name} {if let function = kill.function then function.location.start_line else 0 fi} {kill.crossing.location} {if kill.is_presence then "presence" else "type" fi} {what} {if kill.killed then "killed" else "kept" fi}")
            od
        si

        clear_all() static is
            if enabled then
                _kills.clear()
            fi
        si

        // After a solve: every body whose walk decided some crossing
        // differently from the way the new relations would, and the
        // files of the records made outside any definition's walk.
        // Both empty means the last walk of every body agrees with the
        // relations, which is the fixpoint.
        take_inexact() -> INEXACT static is
            let result = INEXACT()

            if !enabled then
                return result
            fi

            let stopwatch = System.Diagnostics.Stopwatch.start_new()
            let asked mut = 0

            for kill in _kills do
                if let function = kill.function then
                    if result.bodies.contains(function) then
                        continue
                    fi
                elif result.files.contains(kill.file_name) then
                    continue
                fi

                asked = asked + 1

                let discharged = RELIANCES.crossing_discharged(kill.crossing, kill.target, kill.path, kill.is_presence)

                if discharged == kill.killed then
                    if let function = kill.function then
                        result.bodies.add(function)
                    else
                        result.files.add(kill.file_name)
                    fi
                fi
            od

            if System.Environment.get_environment_variable("GHUL_EFFECTS_TIMING")? then
                IO.Std.error.write_line("ledger: {_kills.count} records, {asked} re-asked in {stopwatch.elapsed_milliseconds} ms, {result.bodies.count} body(ies) and {result.files.count} file(s) inexact")
            fi

            return result
        si
    si

    // What a solve found inexact: the definitions whose body walks
    // disagree with the relations, and the files of records that were
    // made outside a definition's walk.
    class INEXACT is
        bodies: Collections.SET[Trees.Definitions.FUNCTION]
        files: Collections.SET[string]

        init() is
            bodies = Collections.SET[Trees.Definitions.FUNCTION]()
            files = Collections.SET[string]()
        si

        is_empty: bool => bodies.count == 0 /\ files.count == 0
    si
si
