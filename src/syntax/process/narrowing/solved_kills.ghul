namespace Syntax.Process is
    use Symbol = Semantic.Symbols.Symbol
    use LOCATION = Source.LOCATION

    // Prototype of the combined type + effect solve's kill set: the
    // fact-at-crossing pairs a previous solve round found the effect
    // relations could not discharge. A consuming round drops each
    // such fact at that call, so the widened type flows from there
    // and any use only the fact satisfied is an ordinary type error
    // - no reliance judgement needed for it. Kills are sticky: a
    // round never resurrects a fact an earlier round killed, which
    // keeps the descent monotone.
    //
    // The rounds are separate compiler invocations exchanging the
    // kill set through files, so the state each round starts from is
    // a clean process. GHUL_SOLVE_KILLS_IN names the kills to
    // consume; GHUL_SOLVE_KILLS_OUT collects the undischarged
    // fact-crossing pairs this round's solved relations find. The
    // driving loop merges OUT into IN and repeats until no new kills
    // appear. Inert when neither variable is set.
    //
    // Keys are serialized as text because they cross a process
    // boundary; every component is a source position, never a
    // rendered name, so distinct entities cannot collide.
    class SOLVED_KILLS is
        _kills: Collections.SET[string]? static
        _emitted: Collections.SET[string]? static
        _out_path: string? static
        _initialized: bool static

        // Kills recorded since the last take, each with the file its
        // crossing is in - the in-process descent recompiles exactly
        // those files' expressions before the next effects round.
        _pending: Collections.MAP[string, string]? static

        // The in-process descent: GHUL_COMBINED_SOLVE runs the rounds
        // inside one build, consuming kills as they are found.
        in_process: bool static

        _ensure_initialized() static is
            if _initialized then
                return
            fi

            _initialized = true

            let in_path = System.Environment.get_environment_variable("GHUL_SOLVE_KILLS_IN")

            if in_path? /\ IO.File.exists(in_path) then
                let kills = Collections.SET[string]()

                for line in IO.File.read_all_lines(in_path) do
                    if line.length > 0 then
                        kills.add(line)
                    fi
                od

                _kills = kills
            fi

            _out_path = System.Environment.get_environment_variable("GHUL_SOLVE_KILLS_OUT")

            if _out_path? then
                _emitted = Collections.SET[string]()
            fi

            if System.Environment.get_environment_variable("GHUL_COMBINED_SOLVE")? then
                in_process = true

                if !_kills? then
                    _kills = Collections.SET[string]()
                fi

                if !_emitted? then
                    _emitted = Collections.SET[string]()
                fi

                _pending = Collections.MAP[string, string]()
            fi
        si

        // Promote the kills recorded since the last take into the
        // consumed set and hand back the files whose expressions have
        // to be recompiled for them to take effect. Empty means the
        // descent has reached its fixpoint.
        take_new_kills() -> Collections.SET[string] static is
            let files = Collections.SET[string]()
            let pending = _pending
            let kills = _kills

            if !pending? \/ !kills? then
                return files
            fi

            for entry in pending do
                if kills.add(entry.key) then
                    files.add(entry.value)
                fi
            od

            pending.clear()

            return files
        si

        consume_active: bool static is
            _ensure_initialized()
            return _kills?
        si

        emit_active: bool static is
            _ensure_initialized()
            return _emitted?
        si

        _location_key(location: LOCATION) -> string static =>
            "{location.file_name}@{location.start}"

        _symbol_key(v: Symbol) -> string static =>
            _location_key(v.root_specialized_from.location)

        _path_key(path: ACCESS_PATH) -> string static is
            let result = System.Text.StringBuilder()

            result.append(_symbol_key(path.root))

            for m in path.members do
                result.append(">")
                result.append(_symbol_key(m))
            od

            return result.to_string()
        si

        _key(crossing_location: LOCATION, fact_key: string, is_presence: bool) -> string static =>
            "{if is_presence then "P" else "N" fi}|{_location_key(crossing_location)}|{fact_key}"

        is_killed(crossing_location: LOCATION, v: Symbol, is_presence: bool) -> bool static is
            _ensure_initialized()

            let kills = _kills

            if !kills? then
                return false
            fi

            return kills.contains(_key(crossing_location, _symbol_key(v), is_presence))
        si

        is_path_killed(crossing_location: LOCATION, path: ACCESS_PATH, is_presence: bool) -> bool static is
            _ensure_initialized()

            let kills = _kills

            if !kills? then
                return false
            fi

            return kills.contains(_key(crossing_location, _path_key(path), is_presence))
        si

        record(crossing_location: LOCATION, target: Symbol?, path: ACCESS_PATH?, is_presence: bool) static is
            _ensure_initialized()

            let emitted = _emitted

            if !emitted? then
                return
            fi

            let key =
                if target? then
                    _key(crossing_location, _symbol_key(target), is_presence)
                elif path? then
                    _key(crossing_location, _path_key(path), is_presence)
                else
                    return
                fi

            emitted.add(key)

            let pending = _pending
            let kills = _kills

            if pending? /\ kills? /\ !kills.contains(key) then
                pending[key] = crossing_location.file_name
            fi
        si

        flush() static is
            let emitted = _emitted
            let out_path = _out_path

            if !emitted? \/ !out_path? then
                return
            fi

            let result = System.Text.StringBuilder()

            for key in emitted do
                result.append(key)
                result.append('\n')
            od

            IO.File.write_all_text(out_path, result.to_string())
        si
    si
si
