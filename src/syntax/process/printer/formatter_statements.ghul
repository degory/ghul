namespace Syntax.Process.Printer is
    use Collections

    use Trees
    use Source

    use Lexical.TRIVIA


    // Statement and case formatting: lists, blocks, lets, if statements and expressions,
    // refutable bindings, for loops and case arms.
    partial FORMATTER is

        // --- definition / statement lists: leading-trivia interleaving ---

        // A file with no namespace can carry bare statements at its root
        // (synthesise-top-level-entry consumes them into a global entry
        // point before declare-symbols), interleaved with global
        // definitions in source order - GHUL.md: "may be interleaved with
        // global definitions, which are visible regardless of where they
        // appear." `definitions` and `top_level_statements` are two
        // separately-ordered runs, so a formatter that rendered every
        // definition before every statement would silently reorder the
        // file. Walk both by source position instead.
        visit(definitions: Definitions.LIST) is
            let items = LIST[Trees.Node]()

            for d in definitions do
                items.add(d)
            od

            if let statements = definitions.top_level_statements then
                for s in statements do
                    items.add(s)
                od
            fi

            items.sort((a, b) => a.location.start - b.location.start)

            let first mut = true

            for item in items do
                flush_leading(item.location.start)

                // Nothing has been written yet before the very first item
                // (the root Definitions.LIST is visited before anything
                // else), so `at_line_start` is still at its unset default
                // there - only break between items, never before the first.
                if !first /\ !at_line_start then
                    write_line()
                fi

                item.accept(self)

                first = false

                if let variable: Variables.VARIABLE = item then
                    if let variable.name? /\ name.name.starts_with("$") then
                        write_terminator()
                    fi
                fi
            od
        si

        visit(list: Statements.LIST) is
            for s in list do
                // A statement ending in a block terminator leaves the line open,
                // and running the next statement onto it produces source that no
                // longer parses - `odwrite_line(...)`.
                if !at_line_start then
                    write_line()
                fi

                flush_leading(s.location.start)
                s.accept(self)
            od
        si

        visit(block: Bodies.BLOCK) is
            // An empty body renders on the header's line - `init() is si` -
            // rather than splitting over two. A body carrying comments keeps
            // the general path so they stay inside the block.
            if block.statements.is_empty /\ ! _has_trivia_before(block.location.end) then
                write("is si")
                return
            fi

            write_line("is")
            indent()

            // A final statement that reached the body terminator without
            // its `;` is an implicit tail return: it renders as a bare
            // expression, since printing the `;` would turn the return
            // back into a discarded statement.
            let tail_expression: Trees.Expressions.Expression? mut = null

            if !block.statements.last_was_terminated then
                if let l = block.statements.last then
                    if let te = cast Statements.EXPRESSION?(l) then
                        tail_expression = te.expression
                    fi
                fi
            fi

            if let te = tail_expression then
                let items = LIST[Statements.Statement]()

                for s in block.statements do
                    items.add(s)
                od

                let i mut = 0
                while i < items.count - 1 do
                    flush_leading(items[i].location.start)

                    // A statement ending in a block terminator leaves the
                    // line open; the next one must not run onto it.
                    if ! at_line_start then
                        write_line()
                    fi

                    items[i].accept(self)
                    i = i + 1
                od

                flush_leading(items[items.count - 1].location.start)

                if ! at_line_start then
                    write_line()
                fi

                te.accept(self)
                write_line("")
            else
                block.statements.accept(self)
            fi

            // The last statement may have ended in a block terminator of its
            // own, leaving the line open: `si` must not run onto it.
            if !at_line_start then
                write_line()
            fi

            flush_leading(block.location.end)
            outdent()
            write("si")
        si

        // --- visits the plain printer never implemented ---

        visit(let_in: Expressions.LET_IN) is
            note(let_in.location)
            write("let ")
            if let_in.want_dispose then
                write("use ")
            fi
            let_in.variables.accept(self)
            write(" in ")
            let_in.expression.accept(self)
        si

        visit(assert_in: Expressions.ASSERT_IN) is
            note(assert_in.location)
            write("assert ")
            assert_in.condition.accept(self)
            if assert_in.message? then
                write(" else ")
                assert_in.message!.accept(self)
            fi
            write(" in ")
            assert_in.expression.accept(self)
        si

        visit(recurse: Expressions.RECURSE) is
            note(recurse.location)
            write("rec")
        si

        // --- faithfulness fix: an `if ... fi` in expression position is
        //     Expressions.STATEMENT wrapping Statements.IF. The inherited
        //     visit renders the statement form — `;`-terminated branch
        //     bodies plus a trailing `;` — which is invalid in expression
        //     position. Render the expression form instead. ---

        visit(statement: Expressions.STATEMENT) is
            note(statement.location)

            if let if_statement: Statements.IF = statement.statement then
                emit_if_expression(if_statement)
            elif let case_statement: Statements.CASE = statement.statement then
                emit_case_expression(case_statement)
            elif let for_statement: Statements.FOR = statement.statement then
                emit_for_expression(for_statement)
            elif let do_statement: Statements.DO = statement.statement then
                emit_do_expression(do_statement)
            elif let throw_statement: Statements.THROW = statement.statement then
                // `=> throw E` stubs a diverging body. The statement form
                // writes its own `;`, which the member's `after_body` would
                // duplicate - render the expression form instead.
                write("throw")
                if throw_statement.expression? then
                    write(" ")
                    throw_statement.expression.accept(self)
                fi
            else
                statement.statement.accept(self)
            fi
        si

        // `val ... lav` block expression. The keyword pair is load-
        // bearing; each statement renders normally (with its own `;`)
        // and the surrounding context decides whether the block's value
        // is consumed.
        visit(block: Expressions.VAL_BLOCK) is
            note(block.location)

            if block.is_parenthesised then
                write_line("(")
                indent()
                block.body.accept(self)
                outdent()
                write(")")
            else
                write_line("val")
                indent()
                block.body.accept(self)
                outdent()
                write("lav")
            fi
        si

        // --- faithfulness fix: the inherited visit(Statements.LET) never
        //     emits the `use` disposal keyword, so `let use x = e` round-trips
        //     to `let x = e`, silently dropping the disposal. ---

        visit(l: Statements.LET) is
            write("let ")

            if l.want_dispose then
                write("use ")
            fi

            l.variables.accept(self)
            write_terminator()
        si

        // --- faithfulness fix: the inherited visit(Statements.IF) ignores a
        //     branch binding, so `if let v = e then` renders as a bare `else`
        //     with the binding dropped. ---

        visit(if_statement: Statements.IF) is
            note(if_statement.location)

            let branches = LIST[Statements.IF_BRANCH]()
            for b in if_statement.branches do
                branches.add(b)
            od

            let first mut = true
            let i mut = 0
            for branch in branches do
                // The previous branch ended with a statement that may
                // itself have closed a block, leaving the line open:
                // `elif` and `else` must not run onto it.
                if !first /\ !at_line_start then
                    write_line()
                fi

                if let branch.binding? then
                    if first then
                        write("if let ")
                    else
                        write("elif let ")
                    fi
                    binding.accept(self)
                    if let branch.condition? then
                        write(" /\\ ")
                        condition.accept(self)
                    fi
                    write_line(" then")
                elif let branch.condition? then
                    if first then
                        write("if ")
                    else
                        write("elif ")
                    fi
                    condition.accept(self)
                    write_line(" then")
                else
                    write_line("else")
                fi

                indent()
                branch.body.accept(self)

                // A comment after the branch's last statement belongs inside
                // the branch: consume it while still indented, or it is
                // emitted after the `fi` - or, ahead of the next clause's
                // keyword, trails that keyword's line instead.
                flush_leading(
                    if i + 1 < branches.count then
                        branches[i + 1].location.start
                    else
                        if_statement.location.end
                    fi)

                outdent()

                first = false
                i = i + 1
            od

            // The last branch's body may have ended in a block terminator
            // of its own, leaving the line open: `fi` must not run onto it.
            if !at_line_start then
                write_line()
            fi

            write_line("fi")
        si

        // --- the REFUTABLE_BINDING node carries the `pattern[: T] =
        //     scrutinee[ /\ guard]` shape that drives an `if let` arm,
        //     or the leaf-name shorthand `path?` / `path: T` when the
        //     variable name was inferred from the path. The `if let ` /
        //     `elif let ` keyword is emitted by the surrounding
        //     visit(Statements.IF); this renders the clause payload
        //     only. ---

        visit(rb: Statements.REFUTABLE_BINDING) is
            note(rb.location)

            let first mut = true

            for c in rb.clauses do
                if !first then
                    write(", ")
                fi

                if c.is_inferred_name then
                    c.scrutinee.accept(self)

                    if let c.narrow_type_expression? then
                        write(": ")
                        narrow_type_expression.accept(self)
                    else
                        write("?")
                    fi
                else
                    c.pattern.accept(self)

                    if let c.narrow_type_expression? then
                        write(": ")
                        narrow_type_expression.accept(self)
                    fi

                    write(" = ")
                    c.scrutinee.accept(self)
                fi

                if let c.guard? then
                    write(" /\\ ")
                    guard.accept(self)
                fi

                first = false
            od
        si

        // --- faithfulness fix: the inherited visit(Statements.FOR) emits
        //     `for` with a trailing newline, stranding it on its own line. ---

        visit(for_statement: Statements.FOR) is
            note(for_statement.location)

            write("for ")

            let variable = for_statement.variable
            if variable? then
                variable.accept(self)
            fi

            write(" in ")

            let expression = for_statement.expression
            if expression? then
                expression.accept(self)
            fi

            write_line(" do")

            indent()

            let body = for_statement.body
            if body? then
                body.accept(self)
            fi

            // A comment after the body's last statement belongs inside the
            // loop: consume it while still indented, or it is emitted after
            // the `od`.
            flush_leading(for_statement.location.end)

            outdent()

            // Nested blocks each end with their own terminator, and the inner
            // one leaves the line open: `od` must not run onto it.
            if !at_line_start then
                write_line()
            fi

            write("od")
        si

        // The base visit renders the statement form but never consumes the
        // trivia queue, so a comment trailing the body is emitted after the
        // `od` rather than inside the loop.
        visit(`do: Statements.DO) is
            note(`do.location)

            if let `do.binding? then
                write("while let ")
                binding.accept(self)
                write(" ")
            elif let `do.condition? then
                write("while ")
                condition.accept(self)
                write(" ")
            fi

            write_line("do")
            indent()
            `do.body.accept(self)

            // A comment after the body's last statement belongs inside the
            // loop: consume it while still indented, or it is emitted after
            // the `od`.
            flush_leading(`do.location.end)

            outdent()

            // Nested blocks each end with their own terminator, and the inner
            // one leaves the line open: `od` must not run onto it.
            if !at_line_start then
                write_line()
            fi

            write_line("od")
        si

        // The base visit renders the statement form but never consumes the
        // trivia queue, so a comment trailing a body is emitted after the
        // `yrt` - or, ahead of a `catch` or `finally` keyword, trails that
        // keyword's line - rather than staying in the body it was written in.
        visit(`try: Statements.TRY) is
            note(`try.location)

            write_line("try")
            indent()
            `try.body.accept(self)

            let catches = LIST[Statements.CATCH]()
            for c in `try.catches do
                catches.add(c)
            od

            flush_leading(next_clause_start(`try, catches, 0))

            outdent()

            let i mut = 0
            for c in catches do
                // The body may have ended in a nested block, whose own
                // terminator leaves the line open: `catch` must not run
                // onto it, as the `yrt` below does not.
                if !at_line_start then
                    write_line()
                fi

                write("catch ")

                if let c.variable? then
                    variable.accept(self)
                fi
                write_line()

                indent()
                c.body.accept(self)

                flush_leading(next_clause_start(`try, catches, i + 1))

                outdent()

                i = i + 1
            od

            let `finally = `try.`finally

            if `finally? then
                if !at_line_start then
                    write_line()
                fi

                write_line("finally")
                indent()
                `finally.accept(self)

                // A comment after the last statement of the finally body
                // belongs inside it: consume it while still indented, or it
                // is emitted after the `yrt`.
                flush_leading(`try.location.end)

                outdent()
            fi

            if !at_line_start then
                write_line()
            fi

            write_line("yrt")
        si

        // The position a body's trailing trivia is flushed against: the next
        // `catch` clause when one follows, the `finally` body if the next
        // thing is a finally, and the end of the try otherwise.
        next_clause_start(`try: Statements.TRY, catches: LIST[Statements.CATCH], next: int) -> int is
            if next < catches.count then
                return catches[next].location.start
            fi

            let `finally = `try.`finally

            if `finally? then
                return `finally.location.start
            fi

            return `try.location.end
        si

        emit_if_expression(if_statement: Statements.IF) is
            _builder.begin_group()

            let first mut = true
            for branch in if_statement.branches do
                if !first /\ !at_line_start then
                    _builder.line()
                fi

                // Trivia (a comment, a blank line) between one branch's
                // last statement and the next branch's keyword has to be
                // consumed here - otherwise it stays in the trivia queue
                // and surfaces later, wherever the next flush_leading
                // happens to land.
                if !first then
                    flush_leading(branch.location.start)
                fi

                if let branch.binding? then
                    if first then
                        write("if let ")
                    else
                        write("elif let ")
                    fi
                    binding.accept(self)
                    if let branch.condition? then
                        write(" /\\ ")
                        condition.accept(self)
                    fi
                    write(" then")
                elif let branch.condition? then
                    if first then
                        write("if ")
                    else
                        write("elif ")
                    fi
                    condition.accept(self)
                    write(" then")
                else
                    write("else")
                fi

                _builder.begin_nest(4)
                _builder.line()
                emit_branch_value(branch.body)

                // A statement arm - a `return`, say - writes its own line
                // break. The soft break that separates it from the next
                // keyword would then be a second one, and the blank line
                // it leaves comes back as another on every reformat.
                _builder.end_nest()

                first = false
            od

            flush_leading(if_statement.location.end)

            if !at_line_start then
                _builder.line()
            fi

            write("fi")
            _builder.end_group()
        si

        // Emit an if-expression branch body. The branch's value is its last
        // bare expression (no `;`); any leading statements render
        // normally.
        emit_branch_value(body: Statements.LIST) is
            let statements = LIST[Statements.Statement]()
            for s in body do
                statements.add(s)
            od

            let i mut = 0
            while i < statements.count do
                let s = statements[i]
                let is_last = i == statements.count - 1

                // Leading trivia (blank lines, comments) between arm-body
                // statements has to be consumed here, in place - otherwise
                // it stays in the trivia queue and surfaces later, at
                // whichever definition or statement next calls
                // flush_leading, stacking with whatever blank line already
                // belongs there.
                flush_leading(s.location.start)

                // A statement ending in a block terminator - an arm body's
                // `od` - leaves the line open; the next statement must not
                // run onto it. The arm's own opening break is a soft one,
                // which `at_line_start` does not see, so this asks only
                // about a break the previous statement should have left.
                if i > 0 /\ !at_line_start then
                    write_line()
                fi

                // A tail statement can itself be an if/case/for/do used as
                // a value (implicit tail return). Each of those has its own
                // no-trailing-terminator expression renderer, matching the
                // dispatch in visit(Expressions.STATEMENT); the ordinary
                // statement-form renderers (`visit(Statements.IF)` and
                // friends) are for a statement in statement position, and
                // terminate their own line.
                if is_last /\ isa Statements.EXPRESSION(s) then
                    let expression_statement = cast Statements.EXPRESSION(s)
                    expression_statement.expression.accept(self)
                elif is_last /\ isa Statements.IF(s) then
                    emit_if_expression(cast Statements.IF(s))
                elif is_last /\ isa Statements.CASE(s) then
                    emit_case_expression(cast Statements.CASE(s))
                elif is_last /\ isa Statements.FOR(s) then
                    emit_for_expression(cast Statements.FOR(s))
                elif is_last /\ isa Statements.DO(s) then
                    emit_do_expression(cast Statements.DO(s))
                else
                    s.accept(self)
                fi
                i = i + 1
            od
        si

        // Loop expressions render like their statement forms but end at
        // the closing keyword with no trailing `;` — the consuming
        // context owns statement termination — and the body's value is
        // its last bare expression, as in an if-expression branch.
        emit_for_expression(for_statement: Statements.FOR) is
            write("for ")

            if let for_statement.variable? then
                variable.accept(self)
            fi

            write(" in ")

            if let for_statement.expression? then
                expression.accept(self)
            fi

            write_line(" do")
            indent()

            if let for_statement.body? then
                body.accept(self)
            fi

            outdent()

            // Nested blocks each end with their own terminator, and the inner
            // one leaves the line open: `od` must not run onto it.
            if !at_line_start then
                write_line()
            fi

            write("od")
        si

        emit_do_expression(do_statement: Statements.DO) is
            if let do_statement.binding? then
                write("while let ")
                binding.accept(self)
                write(" ")
            elif let do_statement.condition? then
                write("while ")
                condition.accept(self)
                write(" ")
            fi

            write_line("do")
            indent()
            do_statement.body.accept(self)
            outdent()

            // Nested blocks each end with their own terminator, and the inner
            // one leaves the line open: `od` must not run onto it.
            if !at_line_start then
                write_line()
            fi

            write("od")
        si

        // --- faithfulness fix: `case` statement / expression. The base
        //     printer emits a legacy `when X :` / `default` / `esac`
        //     shape; the parser accepts only `when X then` / `else` /
        //     `esac`. Binding-pattern arms (`when v: int then`) and
        //     literal-leaf patterns live on the arm's `pattern` field
        //     rather than its `expressions` list and must be emitted
        //     from there. ---

        visit(`case: Statements.CASE) is
            emit_case_header(`case)

            let i mut = 0
            for m in `case.matches do
                // A comment after an arm's last statement belongs inside the
                // arm: bound the flush by the next arm's keyword (or the
                // `esac`), or it trails the next keyword's line.
                let limit =
                    if i + 1 < `case.matches.count then
                        `case.matches[i + 1].location.start
                    else
                        `case.location.end
                    fi

                emit_case_match_at(m, false, limit)
                i = i + 1
            od

            write_line("esac")
        si

        visit(match: Statements.CASE_MATCH) is
            emit_case_match_at(match, false, match.location.end)
        si

        emit_case_header(case_statement: Statements.CASE) is
            note(case_statement.location)
            write("case ")
            case_statement.expression.accept(self)
            write_line()
        si

        emit_case_match_at(match: Statements.CASE_MATCH, as_expression: bool, limit: int) is
            note(match.location)

            if let match.pattern? then
                write("when ")
                pattern.accept(self)

                if let match.guard? then
                    write(" /\\ ")
                    guard.accept(self)
                fi

                write_line(" then")
            elif match.expressions? then
                write("when ")
                let first mut = true
                for e in match.expressions! do
                    if !first then
                        write(", ")
                    fi
                    e.accept(self)
                    first = false
                od
                write_line(" then")
            else
                write_line("else")
            fi

            indent()

            if as_expression then
                emit_branch_value(match.statements)
                write_line()
            else
                match.statements.accept(self)
            fi

            // A comment after the arm's last statement belongs inside the
            // arm: consume it while still indented, or it is emitted after
            // the `esac` - or trails the next arm keyword's line.
            flush_leading(limit)

            outdent()
        si

        emit_case_expression(case_statement: Statements.CASE) is
            emit_case_header(case_statement)

            let i mut = 0
            for m in case_statement.matches do
                let limit =
                    if i + 1 < case_statement.matches.count then
                        case_statement.matches[i + 1].location.start
                    else
                        case_statement.location.end
                    fi

                emit_case_match_at(m, true, limit)
                i = i + 1
            od

            write("esac")
        si
    si
si
