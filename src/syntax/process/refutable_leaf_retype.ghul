namespace Syntax.Process is
    // Decides whether a refutable pattern leaf's symbol type must be
    // re-derived even though an earlier pass already gave it a settled
    // type. Two independent earlier passes each type a refutable leaf's
    // symbol before COMPILE_EXPRESSIONS.visit(SIMPLE_VARIABLE_LEFT) runs:
    // an ascribed leaf (`when v: T`) is typed by the parser/earlier pass
    // as the written ascription, and every leaf of a destructure pattern
    // is typed (wrongly, by a blanket assignment in
    // RESOLVE_EXPLICIT_VARIABLE_TYPES.visit(VARIABLE)) as the whole
    // pattern's ascription rather than its own field type. Both of those
    // settled types are stale here — `explicit_type` carries the
    // receiver-specialised narrow target, `right_value` carries the
    // per-element type the destructure resolver derived — so either one
    // being present on a refutable leaf means the earlier type has to be
    // discarded and re-set from the fresher source.
    //
    // Scoped to `is_refutable`: a non-refutable leaf (a plain `let`) has
    // no such earlier mistyping to correct, so this must never fire
    // there regardless of what `explicit_type` / `right_value` carry.
    class REFUTABLE_LEAF_RETYPE is
        needs_retype(is_refutable: bool, has_explicit_type: bool, has_right_value: bool) -> bool static =>
            is_refutable /\ (has_explicit_type \/ has_right_value);
    si
si
