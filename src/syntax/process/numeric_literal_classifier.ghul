namespace Syntax.Process is
    use System.Reflection.Metadata.ILOpCode;
    use Logging;
    use Source.LOCATION;

    use Semantic.Lookups.InnateSymbolLookup;
    use Semantic.Types.Type;

    use IR.Values;

    // Classify a parsed integer literal: pick the target type from
    // any trailing type-suffix (`b`/`s`/`i`/`l`/`w`/`c`, optionally
    // prefixed by `u` for unsigned or `s` for sign-without-width),
    // strip the suffix from the value string, and range-check the
    // result against the chosen type. The lexer accepts arbitrarily
    // long digit strings and any suffix combination; this is where
    // suffix → type and value → fits-in-type get decided.
    //
    // Bounds errors and "character literals cannot be unsigned"
    // structural errors are logged via the constructor-supplied
    // logger. Callers receive a non-null `Literal.NUMBER` on success
    // and null on either kind of failure.
    //
    // The `fits` / `parse_hex` / `max_unsigned_for` helpers are
    // exposed for unit testing in isolation from the suffix path.
    class NUMERIC_LITERAL_CLASSIFIER is
        _logger: Logger;
        _innate_symbol_lookup: InnateSymbolLookup;

        init(logger: Logger, innate_symbol_lookup: InnateSymbolLookup) is
            super.init();

            _logger = logger;
            _innate_symbol_lookup = innate_symbol_lookup;
        si

        // How many trailing characters of an integer literal are its
        // type suffix: one sign selector and one size selector, in
        // either order, both optional.
        //
        // Not radix-aware. `b` and `c` are hex digits as well as size
        // selectors, and every reader of a given token has to resolve
        // that the same way, so this is the one place the rule lives.
        suffix_length(value_string: string) -> int static is
            if value_string.length == 0 then
                return 0;
            fi

            let last_char = value_string.get_chars(value_string.length - 1);

            if !"bBcCsSiIlLwWuU".contains(last_char) then
                return 0;
            fi

            // `u` on its own is a sign selector with no size after it.
            if last_char == 'u' \/ last_char == 'U' then
                return 1;
            fi

            if value_string.length > 2 then
                let sign_char = value_string.get_chars(value_string.length - 2);

                if "uUsS".contains(sign_char) then
                    return 2;
                fi
            fi

            return 1;
        si

        // The literal with its type suffix removed, which is the value
        // it denotes and the string every back end should read.
        strip_suffix(value_string: string) -> string static =>
            value_string.substring(0, value_string.length - suffix_length(value_string));

        classify_integer(location: LOCATION, value_string: string) -> Literal.NUMBER? is
            let type: Type mut;
            let is_wide mut = false;
            let conv: ILOpCode? mut = null;
            let working mut = value_string;

            let last_char = working.get_chars(working.length - 1);

            if "bBcCsSiIlLwWuU".contains(last_char) then
                let cutoff = working.length - suffix_length(working);

                let is_unsigned =
                    last_char == 'u' \/ last_char == 'U' \/
                    (working.length - cutoff == 2 /\
                        "uU".contains(working.get_chars(working.length - 2)));

                case last_char
                when 'b', 'B' then
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_ubyte_type();
                    else
                        type = _innate_symbol_lookup.get_byte_type();
                    fi

                when 'c', 'C' then
                    if is_unsigned then
                        _logger.error(location, "numeric character literal cannot be unsigned");
                    else
                        type = _innate_symbol_lookup.get_char_type();
                    fi

                when 's', 'S' then
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_ushort_type();
                    else
                        type = _innate_symbol_lookup.get_short_type();
                    fi

                when 'i', 'I' then
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_uint_type();
                    else
                        type = _innate_symbol_lookup.get_int_type();
                    fi

                when 'l', 'L' then
                    is_wide = true;

                    if is_unsigned then
                        type = _innate_symbol_lookup.get_ulong_type();
                    else
                        type = _innate_symbol_lookup.get_long_type();
                    fi

                when 'w', 'W' then
                    is_wide = true;

                    if is_unsigned then
                        type = _innate_symbol_lookup.get_uword_type();
                        conv = ILOpCode.CONV_U;
                    else
                        type = _innate_symbol_lookup.get_word_type();
                        conv = ILOpCode.CONV_I;
                    fi

                else
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_uint_type();
                    else
                        type = _innate_symbol_lookup.get_int_type();
                    fi
                esac

                working = working.substring(0, cutoff);
            else
                type = _innate_symbol_lookup.get_int_type();
            fi

            // the resolved type may be null
            @suppress("presence-test-non-optional")
            if !type? then
                return null;
            fi

            let (ok, parsed) = parse_magnitude(working);

            if !ok \/ !fits(location, working, type) then
                return null;
            fi

            let constant =
                if is_wide then
                    Literal.CONSTANT.I8(cast long(parsed))
                else
                    Literal.CONSTANT.I4(cast int(cast uint(parsed)))
                fi;

            return Literal.NUMBER(constant, type, conv);
        si

        // The magnitude a literal denotes, whatever radix it is written
        // in. Both the range check and the constant the literal loads
        // need it, so it is read once here rather than each reading the
        // spelling for itself.
        parse_magnitude(value_string: string) -> (ok: bool, value: ulong) =>
            if value_string.starts_with("0x") \/ value_string.starts_with("0X") then
                parse_hex(value_string.substring(2, value_string.length - 2));
            else
                val
                    let v: ulong mut = _;
                    let parsed_ok = ulong.try_parse(value_string, v ref);
                    (parsed_ok, v)
                lav;
            fi;

        // Range-check a parsed integer literal against its target
        // type. Comparing as a ulong using each type's unsigned max
        // preserves the standard "literal fits in N unsigned bits,
        // unary minus negates separately" convention. Without this,
        // oversize literals reach IL emission, where the constant no
        // longer fits the instruction it is loaded by (issue #580).
        fits(location: LOCATION, value_string: string, type: Type) -> bool is
            let (ok, parsed) = parse_magnitude(value_string);

            if !ok then
                _logger.error(location, "numeric literal {value_string} does not fit in {type}");
                return false;
            fi

            let max_value = max_unsigned_for(type);

            if max_value > 0UL /\ parsed > max_value then
                _logger.error(location, "numeric literal {value_string} does not fit in {type}");
                return false;
            fi

            return true;
        si

        // Parse a hex digit string (no `0x` prefix) into a ulong.
        // Returns (false, 0) for empty, > 16 digits, or any non-hex
        // character.
        parse_hex(s: string) -> (ok: bool, value: ulong) is
            if s.length == 0 \/ s.length > 16 then
                return (false, 0UL);
            fi

            let value: ulong mut = 0UL;

            for c in s do
                let digit: int mut;

                if c >= '0' /\ c <= '9' then
                    digit = cast int(c) - cast int('0');
                elif c >= 'a' /\ c <= 'f' then
                    digit = cast int(c) - cast int('a') + 10;
                elif c >= 'A' /\ c <= 'F' then
                    digit = cast int(c) - cast int('A') + 10;
                else
                    return (false, 0UL);
                fi

                value = (value << 4UL) + cast ulong(digit);
            od

            return (true, value);
        si

        // Largest non-negative literal value the type accepts, or 0
        // to signal "no narrower bound than the ulong-parse range"
        // (used for ulong / uword: ulong.try_parse already enforces
        // the 64-bit ceiling). 0 makes `fits` skip the narrower-
        // bound check.
        max_unsigned_for(type: Type) -> ulong is
            if type.matches(_innate_symbol_lookup.get_byte_type()) then
                return 127UL;
            elif type.matches(_innate_symbol_lookup.get_ubyte_type()) then
                return 255UL;
            elif type.matches(_innate_symbol_lookup.get_short_type()) then
                return 32767UL;
            elif type.matches(_innate_symbol_lookup.get_ushort_type()) then
                return 65535UL;
            elif type.matches(_innate_symbol_lookup.get_char_type()) then
                return 65535UL;
            elif type.matches(_innate_symbol_lookup.get_int_type()) then
                return 2147483647UL;
            elif type.matches(_innate_symbol_lookup.get_uint_type()) then
                return 4294967295UL;
            elif type.matches(_innate_symbol_lookup.get_long_type()) then
                return 9223372036854775807UL;
            elif type.matches(_innate_symbol_lookup.get_word_type()) then
                return 9223372036854775807UL;
            fi

            return 0UL;
        si
    si
si
