namespace Syntax.Process is
    use Type = Semantic.Types.Type;

    // Whether a composite expression (`if` / `case`) sitting in a
    // position that wants a value but tolerates a void one should
    // decline to produce a value at all, and be compiled as the
    // statement it is.
    //
    // The position is the body of a function literal whose return type
    // is still being inferred: nothing has yet said whether the body
    // yields a value, so an arm that only calls a void function is not
    // an error there the way it is in `let x = if ... fi`. Arms that do
    // yield a value keep the value form, so a void arm mixed in with
    // them is still reported where it cannot be consumed.
    class VOID_TOLERANT_POSITION is
        declines_value(
            void_tolerated: bool,
            has_expected_type: bool,
            seen_void_arm: bool,
            seen_non_void_arm: bool
        ) -> bool static pure =>
            void_tolerated /\
            !has_expected_type /\
            seen_void_arm /\
            !seen_non_void_arm;

        // An arm's contribution to the two counts above. An error-typed
        // arm counts as neither: it has already been reported, and
        // letting it force the value form would pile a second
        // diagnostic onto the same arm.
        counts_as_void(type: Type?) -> bool static pure =>
            type? /\ type.is_void;

        counts_as_non_void(type: Type?) -> bool static pure =>
            type? /\ !type.is_void /\ !type.is_error;
    si
si
