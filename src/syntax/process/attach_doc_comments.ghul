namespace Syntax.Process is
    use Source
    use Trees

    use Lexical.TRIVIA

    // Gives each declaration the `///` block written directly above it:
    // lines of doc comment on consecutive lines, the last of them on the
    // line before the declaration or, where pragmas precede it, before
    // its outermost pragma. Anything between the block and that line
    // detaches it. The text is the lines with `///` and one following
    // space removed, joined with newlines, and is otherwise left alone.
    //
    // Only declarations are walked: a function or property body holds
    // nothing that takes a doc comment.
    class ATTACH_DOC_COMMENTS: Visitor is
        _blocks: Collections.MAP[int, string]

        // The first line of the outermost pragma wrapping the next
        // declaration, or -1 when no pragma is pending.
        _pragma_line: int

        init() is
            super.init()

            _blocks = Collections.MAP[int, string]()
            _pragma_line = -1
        si

        apply(source_file: Compiler.SOURCE_FILE) is
            _blocks = _collect_blocks(source_file.trivia)
            _pragma_line = -1

            if _blocks.count > 0 then
                source_file.definition.walk(self)
            fi
        si

        // Keyed by the line after each block's last line, which is the
        // line a declaration has to start on to take the block.
        _collect_blocks(trivia: Collections.Iterable[TRIVIA]?) -> Collections.MAP[int, string] is
            let result = Collections.MAP[int, string]()

            if !trivia? then
                return result
            fi

            let lines = Collections.LIST[string]()
            let last_line mut = -1

            for t in trivia do
                if let dc: TRIVIA.DOC_COMMENT = t then
                    let line = dc.location.start_line

                    if lines.count > 0 /\ line != last_line + 1 then
                        result[last_line + 1] = string.join("\n", lines)
                        lines.clear()
                    fi

                    lines.add(_strip_marker(dc.text))
                    last_line = line
                fi
            od

            if lines.count > 0 then
                result[last_line + 1] = string.join("\n", lines)
            fi

            return result
        si

        _strip_marker(text: string) -> string is
            let start = if text.length > 3 /\ text[3] == ' ' then 4 else 3 fi

            return text.substring(start)
        si

        _attach(definition: Definitions.Definition) is
            let line =
                if _pragma_line >= 0 then
                    _pragma_line
                else
                    definition.location.start_line
                fi

            _pragma_line = -1

            let text: string mut = ""

            if _blocks.try_get_value(line, text ref) then
                definition.doc = text
            fi
        si

        _skip() is
            _pragma_line = -1
        si

        pre(pragma: Definitions.PRAGMA) -> bool is
            if _pragma_line < 0 then
                _pragma_line = pragma.location.start_line
            fi

            return false
        si

        pre(`class: Definitions.CLASS) -> bool is
            _attach(`class)
            return false
        si

        pre(`trait: Definitions.TRAIT) -> bool is
            _attach(`trait)
            return false
        si

        pre(`struct: Definitions.STRUCT) -> bool is
            _attach(`struct)
            return false
        si

        pre(`union: Definitions.UNION) -> bool is
            _attach(`union)
            return false
        si

        pre(variant: Definitions.VARIANT) -> bool is
            _attach(variant)
            return true
        si

        pre(`enum: Definitions.ENUM) -> bool is
            _attach(`enum)
            return false
        si

        pre(enum_member: Definitions.ENUM_MEMBER) -> bool is
            _attach(enum_member)
            return true
        si

        pre(function: Definitions.FUNCTION) -> bool is
            _attach(function)
            return true
        si

        pre(property: Definitions.PROPERTY) -> bool is
            _attach(property)
            return true
        si

        pre(`namespace: Definitions.NAMESPACE) -> bool is
            _skip()
            return false
        si

        pre(`partial: Definitions.PARTIAL) -> bool is
            _skip()
            return false
        si

        pre(`impl: Definitions.IMPL) -> bool is
            _skip()
            return false
        si

        pre(`use: Definitions.USE) -> bool is
            _skip()
            return true
        si

        pre(super_call: Definitions.SUPER_CALL) -> bool is
            _skip()
            return true
        si

        pre(indexer: Definitions.INDEXER) -> bool is
            _skip()
            return true
        si

        pre(variable: Variables.VARIABLE) -> bool is
            _skip()
            return true
        si
    si
si
