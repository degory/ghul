namespace Syntax.Process is
    use Logging

    // Reports what a comprehension's element and conditions may not
    // contain. Its loops are internal, so a break or continue would leave
    // them half way through filling the result; yield and await would
    // suspend with the result under construction; and a try needs an
    // empty evaluation stack, which the enclosing expression may not
    // leave it. A function literal inside the comprehension is a body of
    // its own and is not scanned.
    class COMPREHENSION_RESTRICTIONS: Visitor is
        _logger: Logger
        _loop_depth: int
        _inside_loop: bool

        init(logger: Logger) is
            super.init()

            _logger = logger
        si

        // `inside_loop` says whether a loop encloses the comprehension.
        // Without one, a break or continue is already reported as outside
        // any loop.
        check(expression: Trees.Expressions.Expression, inside_loop: bool) is
            _loop_depth = 0
            _inside_loop = inside_loop
            expression.walk(self)
        si

        pre(function: Trees.Expressions.FUNCTION) -> bool => true

        pre(`for: Trees.Statements.FOR) -> bool is
            _loop_depth = _loop_depth + 1
            return false
        si

        visit(`for: Trees.Statements.FOR) is
            _loop_depth = _loop_depth - 1
        si

        pre(`do: Trees.Statements.DO) -> bool is
            _loop_depth = _loop_depth + 1
            return false
        si

        visit(`do: Trees.Statements.DO) is
            _loop_depth = _loop_depth - 1
        si

        visit(`break: Trees.Statements.BREAK) is
            if _loop_depth == 0 /\ _inside_loop then
                _logger.error(`break.location, "break cannot leave a list comprehension")
            fi
        si

        visit(`continue: Trees.Statements.CONTINUE) is
            if _loop_depth == 0 /\ _inside_loop then
                _logger.error(`continue.location, "continue cannot leave a list comprehension")
            fi
        si

        visit(`yield: Trees.Statements.YIELD) is
            _logger.error(`yield.location, "cannot yield inside a list comprehension")
        si

        visit(`yield: Trees.Statements.YIELD_ALL) is
            _logger.error(`yield.location, "cannot yield inside a list comprehension")
        si

        visit(`await: Trees.Expressions.AWAIT) is
            _logger.error(`await.location, "cannot await inside a list comprehension")
        si

        visit(`try: Trees.Statements.TRY) is
            _logger.error(`try.location, "try is not allowed inside a list comprehension")
        si
    si
si
