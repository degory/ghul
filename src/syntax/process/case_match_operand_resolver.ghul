namespace Syntax.Process is
    use Source;
    use Type = Semantic.Types.Type;
    use Function = Semantic.Symbols.Function;

    // Resolves how a `case`'s `when` labels should be tested against
    // the scrutinee: the scrutinee type's own `=~`, falling back to
    // its `<>` (compared to zero), falling back to nothing when
    // neither resolves - at which point IL generation keeps its
    // original identity-or-value compare, matching what a bare `==`
    // does for the same type. Resolved once per `case`, against the
    // scrutinee type paired with itself, since a `when` label's type
    // is expected to match the scrutinee's.
    //
    // Only non-optional reference types are considered. A value type
    // (int, enum, a struct with no `=~`, ...) already gets the right
    // answer from identity/value compare, so routing it through an
    // operator call would be pure overhead. An optional scrutinee is
    // left alone too: a `when null` label needs no operator at all,
    // resolving `=~`/`<>` against the non-optional operand would
    // reject an optional argument outright (the operator's parameter
    // is written non-optional; see GHUL.md ".NET interop"), and a
    // present optional would need the same null-guarding
    // `_try_null_safe_equality` gives `=~` proper - out of scope here.
    class CASE_MATCH_OPERAND_RESOLVER(_overload_resolver: Semantic.OVERLOAD_RESOLVER) is
        resolve(scrutinee_type: Type?, location: LOCATION) -> (equality_operator: Function?, order_operator: Function?) is
            if !scrutinee_type? \/ scrutinee_type.is_value_type \/ scrutinee_type.is_optional then
                return (null, null);
            fi

            let equality_operator = _resolve_operator(scrutinee_type, "=~", location);

            if equality_operator? then
                return (equality_operator, null);
            fi

            let order_operator = _resolve_operator(scrutinee_type, "<>", location);

            return (null, order_operator);
        si

        _resolve_operator(scrutinee_type: Type, name: string, location: LOCATION) -> Function? is
            let member = scrutinee_type.find_member(name);

            if !member? \/ !isa Semantic.Symbols.FUNCTION_GROUP(member) then
                return null;
            fi

            let group = cast Semantic.Symbols.FUNCTION_GROUP(member);

            let resolved = _overload_resolver.resolve(
                location,
                group,
                Collections.LIST[Type]([scrutinee_type]),
                false,
                true,
                false
            );

            return resolved?.function;
        si
    si
si
