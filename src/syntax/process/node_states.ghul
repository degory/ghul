namespace Syntax.Process is
    use Collections

    // Per-build compile-expressions state for the node kinds that
    // carry more than the common EXPRESSION_STATE / STATEMENT_STATE.
    // Each struct is hosted as a field on its node class, which keeps
    // forwarders for the members and no knowledge of the storage, so
    // that what a walk writes is reset by Node.clear() and
    // Node.clear_outputs() through the struct rather than field by
    // field.

    // A function literal's part in an argument-pack adaptation. All of
    // it describes a splice the adaptation made in the tree, which a
    // re-walk of the same body does not undo, so clear_outputs() keeps
    // every field: the wrapper is still in the tree, the literals it
    // carries still need their bodies emitted, and the depth the call
    // pushed down still says what the literal is for.
    struct PACK_ADAPTER_STATE is
        expected_pack_depth: int public
        pack_hoist: (symbol: Semantic.Symbols.Symbol, type: Semantic.Types.Type, value: IR.Values.Value)? public
        nested_return_pack_literals: LIST[Syntax.Trees.Expressions.FUNCTION]? public

        init() is
        si

        nested_literals() -> LIST[Syntax.Trees.Expressions.FUNCTION] is
            let list = nested_return_pack_literals ?? LIST[Syntax.Trees.Expressions.FUNCTION]()
            nested_return_pack_literals = list

            return list
        si

        clear() is
            expected_pack_depth = 0
            pack_hoist = null
            nested_return_pack_literals = null
        si

        clear_outputs() is
        si
    si

    // The wrapper literal a call or operator whose callee returns a
    // pack is re-presented through. Written afresh by every walk that
    // resolves the call, so it is an output.
    struct RETURN_PACK_STATE is
        literal: Syntax.Trees.Expressions.FUNCTION? public

        init() is
        si

        clear() is
            literal = null
        si
    si

    // Whether a `ref` argument is a write, decided from the resolved
    // callee.
    struct REFERENCE_STATE is
        writes_target: bool public

        init() is
        si

        clear() is
            writes_target = false
        si
    si

    // The operators a synthesized memberwise comparison calls, one per
    // member, recorded as each resolves.
    struct MEMBERWISE_STATE is
        called_functions: LIST[Semantic.Symbols.Function]? public

        init() is
        si

        functions() -> LIST[Semantic.Symbols.Function] is
            let list = called_functions ?? LIST[Semantic.Symbols.Function]()
            called_functions = list

            return list
        si

        clear() is
            called_functions = null
        si
    si

    // What an `if` in value position yields when no branch runs.
    struct IF_STATE is
        yields_absence_on_fall_through: bool public

        init() is
        si

        clear() is
            yields_absence_on_fall_through = false
        si
    si

    // The iterator surface a `for` or `yield in` drives, resolved once
    // by compile-expressions and read by generate-il. The frame field a
    // state machine keeps the iterator in is allocated once and retyped
    // by later walks, so clear_outputs() keeps it.
    struct ITERATOR_STATE is
        read_iterator: Semantic.Symbols.Function? public
        read_current: Semantic.Symbols.Function? public
        move_next: Semantic.Symbols.Function? public
        iterator_field: Semantic.Symbols.Field? public
        fusion: PIPE_FUSION? public

        init() is
        si

        clear() is
            read_iterator = null
            read_current = null
            move_next = null
            iterator_field = null
            fusion = null
        si

        clear_outputs() is
            read_iterator = null
            read_current = null
            move_next = null
            fusion = null
        si
    si

    // The awaiter pattern an `await` resolved on its operand's type.
    struct AWAIT_STATE is
        awaitable: Semantic.AWAITABLE? public

        init() is
        si

        clear() is
            awaitable = null
        si
    si

    // The loop a `break` or `continue` resolved to.
    struct JUMP_STATE is
        resolved_target: Syntax.Trees.Statements.Statement? public

        init() is
        si

        clear() is
            resolved_target = null
        si
    si
si
