namespace Syntax.Process is
    use Collections

    use Semantic

    // One stage of a recognised pipe chain. Three kinds:
    //
    // - map (is_filter false, is_index false): `argument` is the mapper.
    // - filter (is_filter true): `argument` is the predicate.
    // - index (is_index true): no argument; the loop keeps a running
    //   counter starting at `index_start` and emits
    //   `INDEXED_VALUE[element](counter, current)` per element.
    //   compile-expressions fills `indexed_value_type` (the constructed
    //   `INDEXED_VALUE[element]` struct) and `indexed_value_constructor`.
    //
    // A fourth kind is transparent: a `memo` stage (is_noop true) is
    // recognised but never added to a chain's stage list. A memo pipe
    // consumed inline by the one `for` loop or terminal consumer that
    // fuses a chain is unobservable - its cache is never read a second
    // time and its source runs exactly once with or without it - so the
    // chain fuses as though the memo were absent. The MEMO_PIPE itself is
    // then never constructed; wherever the chain does not fuse, the memo
    // is built and behaves exactly as written.
    //
    // For a map/filter stage whose `argument` is an inlinable literal
    // lambda, compile-expressions fills `param_local` (a synthetic
    // enclosing-method local the loop assigns the incoming element to) and
    // `inline_body` (the lambda body re-walked in the enclosing scope, so
    // its parameter loads that local and its captures load ordinary
    // enclosing locals - no delegate, no closure frame). When both are set
    // the loop emits the body inline; otherwise it invokes the argument's
    // compiled delegate value.
    class PIPE_FUSION_STAGE is
        is_filter: bool public
        is_index: bool public
        is_noop: bool public

        // A `take`/`skip` stage: `argument` is the int count expression,
        // evaluated once into a running counter that the loop decrements per
        // pulled element (take stops the loop when it runs out; skip drops
        // the element while it remains).
        is_take: bool public
        is_skip: bool public

        // The stage's argument: a map/filter lambda or delegate, or the int
        // count of a take/skip stage. Null for an index stage.
        argument: Trees.Expressions.Expression? public

        // Index stage only.
        index_start: int public
        indexed_value_type: Semantic.Types.Type? public
        indexed_value_constructor: Semantic.Symbols.Function? public

        param_local: Semantic.Symbols.Variable? public
        inline_body: IR.Values.Value? public

        // A take/skip stage keeps a running counter but transforms nothing,
        // so the element passes through unchanged.
        is_countdown: bool => is_take \/ is_skip

        is_inlined: bool => param_local? /\ inline_body?

        // A fusible index stage needs both its type and constructor
        // resolved; otherwise the recogniser rejects the chain.
        is_index_ready: bool => indexed_value_type? /\ indexed_value_constructor?

        init(is_filter: bool, argument: Trees.Expressions.Expression) is
            self.is_filter = is_filter
            self.argument = argument
        si

        init(index_start: int) is
            self.is_index = true
            self.index_start = index_start
        si

        init(is_take: bool, is_skip: bool, count: Trees.Expressions.Expression) is
            self.is_take = is_take
            self.is_skip = is_skip
            self.argument = count
        si

        init() is
            is_noop = true
        si
    si

    // Stage-B inlining (`_try_inline_stage` in compile-expressions)
    // harvests IR straight from a speculative compile-expressions walk of
    // the stage lambda's body, then splices it directly into the fused
    // loop - it is never walked again during generate-il. A `cast`
    // expression compiles in two stages: compile-expressions leaves a
    // `WRAPPER` placeholder around a poisoning `DUMMY` value, and only
    // generate-il's own walk (`visit(CAST)`) fills it in with the real
    // conversion. An inlined stage skips that second walk entirely, so a
    // `cast` anywhere in its body reaches `gen()` still holding the
    // placeholder and the compiler dies with "generated dummy value".
    // Scanning for one disqualifies the stage from inlining; the delegate
    // fallback compiles the same body as an ordinary function, which does
    // get generate-il's normal walk.
    class INLINE_DISQUALIFYING_SCANNER: Visitor is
        _found: bool

        init() is
            super.init()
        si

        contains_cast(body: Trees.Bodies.Body?) -> bool is
            _found = false

            if body? then
                body.walk(self)
            fi

            return _found
        si

        pre(`cast: Trees.Expressions.CAST) -> bool is
            _found = true

            return true
        si

        pre(function: Trees.Definitions.FUNCTION) -> bool => true
        pre(function: Trees.Expressions.FUNCTION) -> bool => true
    si

    // A recognised fusible pipe chain rooted at a `for` loop. `source` is
    // the iterable the chain starts from; the fused loop iterates it
    // directly - so no pipe object is built for it - and applies `stages`
    // inline per element. `stages`
    // are outermost-first (the order they wrap the source), so inline
    // application walks them in reverse.
    class PIPE_FUSION(source: Trees.Expressions.Expression, stages_outermost_first: LIST[PIPE_FUSION_STAGE], needs_guard: bool) is
        source: Trees.Expressions.Expression public
        stages_outermost_first: LIST[PIPE_FUSION_STAGE] public

        // True when the source's dynamic type could be a user Pipe with an
        // overridden map/filter (any non-sealed source - it is only
        // statically not a Pipe). The fused loop is then emitted behind a
        // per-site `if source isa Pipe[elem]` guard that mirrors what
        // pipe() itself does (pipe.ghul: `elif isa Pipe[T](source)`): guard
        // true falls back to the ordinary pipe-object loop, guard false
        // fuses. False for sealed sources (value types, arrays) which
        // cannot dynamically be a Pipe, so fuse unconditionally.
        needs_guard: bool public

        // The source's own iterator members, resolved against its type
        // exactly as a plain `for x in source` would. read_iterator is
        // null when the source is directly an iterator (e.g. a range);
        // otherwise it yields the iterator that move_next / read_current
        // drive. Filled by compile-expressions after recognition.
        source_read_iterator: Semantic.Symbols.Function? public
        source_move_next: Semantic.Symbols.Function? public
        source_read_current: Semantic.Symbols.Function? public

        // The source's `reset`, resolved only when the loop drives the
        // source's own cursor rather than an iterator it obtained for
        // itself - a reference-typed source with `move_next` on it, so a
        // Pipe. Whoever else holds that source sees every element the loop
        // pulls, and a `take` stage running out leaves the loop with the
        // cursor part way through where the unfused lowering would have
        // reset it: the stage pipe resets its upstream at the moment its
        // own pass ends. The fused loop resets the source at the same
        // point. A fresh iterator, and a value-type source the loop holds
        // a copy of, are nobody else's to restore. Filled by
        // compile-expressions after recognition.
        source_reset: Semantic.Symbols.Function? public

        // The `Pipe[source-element]` type the runtime guard tests the
        // source against (`source isa Pipe[T]`). T is the SOURCE's own
        // element type - the same T `pipe()` uses when it decides whether
        // to short-circuit - so guard and pipe() always agree. Filled by
        // compile-expressions only when `needs_guard`.
        guard_isa_type: Semantic.Types.Type? public
    si

    // Decides whether a `for x in <chain>` loop's expression is a
    // fusible pipe chain, and if so returns the plan the IL pass
    // consumes. Pure recognition — no compilation side effects.
    //
    // A chain is a run of `Ghul.Pipes` free-function calls, which have no
    // receiver, so no call in one can reach a `Pipe[T]` implementation
    // that overrides a combinator: what a stage does is settled by the
    // function the call resolved to. Nothing about the source's dynamic
    // type can change that, so a chain fuses whatever it starts from -
    // see `recognize_free_function_chain`.
    class PIPE_FUSION_RECOGNIZER(fusion_functions: Collections.MAP[Semantic.Symbols.Symbol, string]) is

        recognize(`for: Trees.Statements.FOR) -> PIPE_FUSION? =>
            recognize_any(`for.expression)

        // Peel a chain of `Ghul.Pipes` free functions off `expression`.
        // Used both by the `for`-loop path and by consumer fusion.
        recognize_any(expression: Trees.Expressions.Expression?) -> PIPE_FUSION? =>
            recognize_free_function_chain(expression)

        // Peel a `... |> map(f) |> filter(p)` chain of `Ghul.Pipes` free
        // functions off an arbitrary expression. `|>` is desugared entirely
        // at parse time into an ordinary CALL with the threaded value
        // inserted as argument 0, so by the time this pass runs `xs |>
        // map(f)` is indistinguishable from `map(xs, f)` - a plain
        // global-function call resolved once via ordinary overload
        // resolution.
        //
        // Soundness, dispatch: `Ghul.Pipes.map`/`filter`/`take`/`skip` are
        // global functions with no receiver, so a call to one is never a
        // member access and never reaches an overridden `Pipe[T].map`/
        // `filter` - fused or not. There is no isa-based dispatch anywhere
        // in the call for a guard to route around, so `needs_guard` is
        // always false regardless of the source's static or dynamic type.
        //
        // A source that is itself a Pipe also fuses, because a
        // thread-first chain is routinely
        // written straight off a generator or a `stream`. Driving such a
        // source's own cursor carries an obligation the fused loop has to
        // honour by hand - see `source_reset` on PIPE_FUSION.
        recognize_free_function_chain(expression: Trees.Expressions.Expression?) -> PIPE_FUSION? is
            if !expression? then
                return null
            fi

            let stages = LIST[PIPE_FUSION_STAGE]()

            let current mut = expression
            let calls mut = 0

            while isa Trees.Expressions.CALL(current) do
                let call = cast Trees.Expressions.CALL(current)

                let stage = _classify_free_function_stage(call)

                if !stage? then
                    break
                fi

                calls = calls + 1

                // A memo stage is elided rather than fused: the chain
                // fuses as though it were absent (see PIPE_FUSION_STAGE).
                if !stage.is_noop then
                    stages.add(stage)
                fi

                current = call.arguments.expressions[0]
            od

            // A chain whose only call was a memo still fuses - it iterates
            // the memo's source directly - but an expression that peeled
            // nothing at all is not a chain.
            if calls == 0 then
                return null
            fi

            let source = current
            let source_value = source.value

            if !source_value? \/ !source_value.type? then
                return null
            fi

            return PIPE_FUSION(source, stages, false)
        si

        // Classify `call` as a fusible `Ghul.Pipes` free-function stage -
        // map, filter, take or skip, or a `memo` stage that is recognised
        // only to be elided - by comparing the resolved call target
        // against the fusible-combinator symbols, so what fuses follows
        // the function the call bound rather than how it spells itself.
        // Returns null for any other function, which stops the peel loop
        // and leaves the call as an ordinary, unfused expression - still
        // correct, since an unrecognised stage drives its own result
        // through its own iterator exactly as the unfused lowering would.
        _classify_free_function_stage(call: Trees.Expressions.CALL) -> PIPE_FUSION_STAGE? is
            let value = call.value

            if !isa IR.Values.Call.GLOBAL(value) then
                return null
            fi

            let global_call = cast IR.Values.Call.GLOBAL(value)
            let role: string mut

            if !fusion_functions.try_get_value(global_call.function.root_specialized_from, role ref) then
                return null
            fi

            if role =~ "memo" then
                if call.arguments.expressions.count != 1 then
                    return null
                fi

                return PIPE_FUSION_STAGE()
            fi

            if call.arguments.expressions.count != 2 then
                return null
            fi

            if role =~ "map" \/ role =~ "filter" then
                return PIPE_FUSION_STAGE(role =~ "filter", call.arguments.expressions[1])
            fi

            if role =~ "take" \/ role =~ "skip" then
                return PIPE_FUSION_STAGE(role =~ "take", role =~ "skip", call.arguments.expressions[1])
            fi

            return null
        si
    si
si
