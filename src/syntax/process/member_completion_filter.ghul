namespace Syntax.Process is
    use Semantic.Symbols.Function
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Symbols.INDEXER_NAMES
    use Semantic.Symbols.Symbol

    // Which of a receiver's members completion offers after a dot: the
    // ones a program can write there. An indexer is reached by indexing,
    // so its accessors are never offered. A constructor is reached by
    // calling the type, and an imported protected member only from inside
    // its type, so both are offered only after `self` or `super`, where
    // `super.init(...)` is how a constructor chains.
    class MEMBER_COMPLETION_FILTER is
        init() is si

        is_offered(name: string, symbol: Symbol, from_inside: bool) -> bool static is
            if name =~ INDEXER_NAMES.read \/ name =~ INDEXER_NAMES.assign then
                return false
            fi

            if from_inside then
                return true
            fi

            if let group = cast FUNCTION_GROUP?(symbol) then
                if group.functions.count == 0 then
                    return true
                fi

                for function in group.functions do
                    if _is_reachable(function) then
                        return true
                    fi
                od

                return false
            fi

            if let function = cast Function?(symbol) then
                return _is_reachable(function)
            fi

            return true
        si

        _is_reachable(function: Function) -> bool static =>
            !function.is_constructor /\ !function.is_imported_protected
    si
si
