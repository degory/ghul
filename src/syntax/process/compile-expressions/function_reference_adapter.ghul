namespace Syntax.Process is
    use Source.LOCATION

    use Semantic.Types.Type

    // A function referred to by name becomes a delegate directly -
    // `ldftn` on the method, no closure - so its type is fixed by its
    // declaration. Where a formal's shape differs from it only in which
    // carrier an optional position uses, no such delegate exists: the
    // optional carriers convert at a value boundary, and a delegate's
    // parameter and return are type arguments, where nothing converts.
    //
    // The reference is eta-expanded instead. `f` written into a
    // `(T) -> U?` slot becomes the literal `(a) => f(a)`, spliced into
    // the tree in the reference's place, and the ordinary literal path
    // compiles it under the slot: the return boundary coerces one
    // carrier into the other, and the delegate the slot binds against
    // is the closure's own.
    class FUNCTION_REFERENCE_ADAPTER(
        _symbol_table: Semantic.SYMBOL_TABLE
    ) is
        _index: int

        super()

        // Whether `source` - the shape a function reference walked to -
        // and `target` - the formal it is going into - describe the same
        // call, differing only in the optional carrier of one or more
        // positions. A position still carrying an inference placeholder
        // says nothing either way and is passed over; a position that
        // disagrees on anything but the carrier rules the pair out, so
        // an ordinary mismatch is still reported rather than adapted.
        is_carrier_only_mismatch(source: Type?, target: Type?) -> bool static is
            if !source? \/ !target? \/ !source.is_function \/ !target.is_function then
                return false
            fi

            if source.arguments.count != target.arguments.count then
                return false
            fi

            let last = source.arguments.count - 1
            let any_carrier_pair mut = false

            for i in 0..source.arguments.count do
                let from = source.arguments[i]
                let to = target.arguments[i]

                if from.is_error \/ to.is_error then
                    return false
                fi

                if _is_carrier_pair(from, to) then
                    any_carrier_pair = true
                    continue
                fi

                if from.contains_inferred \/ to.contains_inferred \/ from.is_wild \/ to.is_wild then
                    continue
                fi

                // The return is covariant, every parameter
                // contravariant, exactly as assignability reads them.
                let compatible =
                    if i == last then
                        to.is_assignable_from(from)
                    else
                        from.is_assignable_from(to)
                    fi

                if !compatible then
                    return false
                fi
            od

            return any_carrier_pair
        si

        // Two optional types over the same inner type held in different
        // carriers: `MAYBE[T]` against a reference `T?` or a
        // `Nullable[T]`. Both directions, since a reference may be going
        // either way across the boundary.
        _is_carrier_pair(left: Type, right: Type) -> bool static is
            if !left.is_optional \/ !right.is_optional then
                return false
            fi

            if left.is_maybe == right.is_maybe then
                return false
            fi

            let left_inner = left.optional_inner_type
            let right_inner = right.optional_inner_type

            if !left_inner? \/ !right_inner? then
                return false
            fi

            // A type variable or a placeholder at the inner position
            // says nothing about whether the two agree - the carrier
            // is what is being compared, and it already differs.
            return
                left_inner.contains_inferred \/
                right_inner.contains_inferred \/
                left_inner.is_wild \/
                right_inner.is_wild \/
                left_inner.is_equivalent_to(right_inner)
        si

        // Builds `((a0, .., an)) => callee(a0, .., an)` - one physical
        // parameter destructured into the names the call passes on - and
        // declares the closure the literal needs. This is the shape a
        // slot whose parameter is an argument pack asks for: the pack
        // binds to a positional tuple, and the wrapper is what turns
        // that one value back into the N arguments the callee takes.
        //
        // The callee is whatever stood in the slot, a named function
        // reference or a function literal alike. A literal walks in its
        // new home as the callee of a call whose actual types are the
        // tuple's elements, which is what settles its own parameter
        // types.
        try_adapt_packed(
            callee: Trees.Expressions.Expression,
            arity: int,
            packed_type: Type?
        ) -> Trees.Expressions.FUNCTION? is
            let enclosing = _symbol_table.current_function

            if !enclosing? then
                return null
            fi

            let location = callee.location

            let leaves = Collections.LIST[Trees.Variables.VariableLeft]()
            let actuals = Collections.LIST[Trees.Expressions.Expression]()
            let names = Collections.LIST[string]()

            for i in 0..arity do
                let name = "$packed_{_index}_{i}"

                names.add(name)

                leaves.add(
                    Trees.Variables.SIMPLE_VARIABLE_LEFT(
                        location,
                        Trees.Identifiers.Identifier(location, name)
                    )
                )

                actuals.add(
                    Trees.Expressions.IDENTIFIER(
                        location,
                        Trees.Identifiers.Identifier(location, name)
                    )
                )
            od

            let group_name = "$packed_group_{_index}"

            let formal =
                Trees.Expressions.VARIABLE(
                    location,
                    Trees.Identifiers.Identifier(location, group_name),
                    Trees.TypeExpressions.INFER(location),
                    null
                )

            formal.mark_synthesized()
            formal.set_left(Trees.Variables.DESTRUCTURING_VARIABLE_LEFT(location, leaves))

            callee.set_expected_type(null, null)

            _reset_literal_parameter_types(callee)

            let call =
                Trees.Expressions.CALL(
                    location,
                    callee,
                    Trees.Expressions.LIST(location, actuals)
                )

            let body = Trees.Bodies.EXPRESSION(location, call)

            let literal =
                Trees.Expressions.FUNCTION(
                    location,
                    Trees.Expressions.LIST(
                        location,
                        Collections.LIST[Trees.Expressions.Expression]([formal])
                    ),
                    Trees.TypeExpressions.INFER(location),
                    body,
                    false
                )

            literal.is_pack_adapter = true

            let closure =
                cast Semantic.Symbols.Closure?(
                    enclosing.declare_closure(
                        location,
                        "$packed_{_index}",
                        cast Semantic.Scope?(_symbol_table.current_closure_context)!,
                        _symbol_table.current_scope,
                        false,
                        null
                    )
                )

            _index = _index + 1

            if !closure? then
                return null
            fi

            closure.mark_synthesized()

            _symbol_table.associate_node_with_scope(literal, closure)

            // The aggregate is the closure's one argument; its leaves
            // are ordinary body locals, unpacked at entry - the same
            // split declare-members gives a source-written destructured
            // parameter.
            closure.start_declaring_arguments()

            let group = closure.declare_variable(location, group_name, false, null)

            group.mark_synthesized()

            // Where the callee's own parameter types are settled, the
            // tuple they pack into is what the pack binds to, and
            // saying so here is what lets the type argument be inferred
            // rather than written out at the call. Left to be inferred
            // otherwise, as it was before: a callee that is still
            // taking its own types from the slot has nothing to give.
            if let packed = packed_type then
                if let settable: Semantic.Types.SettableTyped = group then
                    settable.set_type(packed)
                fi
            fi

            closure.end_declaring_arguments()

            // The local-id generator is only in a function frame during
            // the declare pass; push one so the LOCAL_VARIABLE ctor can
            // mint an id. The leaf names are unique already, so each
            // takes its own name as its IL slot name rather than the
            // minted one, which restarts at zero in the pushed frame.
            let local_id_generator = IoC.CONTAINER.instance.local_id_generator

            local_id_generator.enter_function()

            for name in names do
                let leaf = closure.declare_variable(location, name, false, null)

                leaf.mark_synthesized()
                leaf.il_name_override = name
            od

            local_id_generator.leave_function()

            _symbol_table.associate_node_with_scope(body, Semantic.BLOCK_SCOPE(closure))

            return literal
        si

        // A literal that reached the slot before the wrapper was built
        // may have taken a parameter type from the slot's own shape,
        // which describes the packed call rather than this literal's.
        // Those types are dropped so the re-walk in the wrapper's body
        // infers them from the arguments the wrapper passes.
        _reset_literal_parameter_types(callee: Trees.Expressions.Expression) is
            if !isa Trees.Expressions.FUNCTION(callee) then
                return
            fi

            let literal = cast Trees.Expressions.FUNCTION(callee)

            let closure = cast Semantic.Symbols.Closure?(_symbol_table.scope_for(literal))

            if !closure? then
                return
            fi

            for a in literal.arguments.expressions do
                if let parameter: Trees.Expressions.VARIABLE = a then
                    // A parameter whose type the author wrote is not
                    // one the slot supplied, so it is not the slot's to
                    // take back.
                    if !isa Trees.TypeExpressions.INFER(parameter.type_expression) then
                        continue
                    fi

                    if let symbol: Semantic.Symbols.Variable = closure.find_direct(parameter.name.name) then
                        symbol.set_type(Semantic.Types.INFERRED_VARIABLE_TYPE(symbol))
                    fi
                fi
            od
        si

        // Builds `(a0, .., an) => reference(a0, .., an)` over the
        // reference, and declares the closure the literal needs. The
        // caller puts the literal where the reference stood - a call
        // holds one in its argument list by index, an operator in a
        // named slot - and re-walks it in the reference's place. Null
        // when the reference is not one this can wrap.
        try_adapt(
            reference: Trees.Expressions.Expression,
            arity: int
        ) -> Trees.Expressions.FUNCTION? is
            if isa Trees.Expressions.FUNCTION(reference) then
                return null
            fi

            let enclosing = _symbol_table.current_function

            if !enclosing? then
                return null
            fi

            let location = reference.location

            let formals = Collections.LIST[Trees.Expressions.Expression]()
            let actuals = Collections.LIST[Trees.Expressions.Expression]()
            let names = Collections.LIST[string]()

            for i in 0..arity do
                let name = "$adapted_{_index}_{i}"

                names.add(name)

                formals.add(
                    Trees.Expressions.VARIABLE(
                        location,
                        Trees.Identifiers.Identifier(location, name),
                        Trees.TypeExpressions.INFER(location),
                        null
                    )
                )

                actuals.add(
                    Trees.Expressions.IDENTIFIER(
                        location,
                        Trees.Identifiers.Identifier(location, name)
                    )
                )
            od

            // The reference itself becomes the literal's callee, so it
            // is walked once, in its new home. Whatever the earlier walk
            // pushed onto it was a function-type slot it no longer sits
            // in.
            reference.set_expected_type(null, null)

            let call =
                Trees.Expressions.CALL(
                    location,
                    reference,
                    Trees.Expressions.LIST(location, actuals)
                )

            let body = Trees.Bodies.EXPRESSION(location, call)

            let literal =
                Trees.Expressions.FUNCTION(
                    location,
                    Trees.Expressions.LIST(location, formals),
                    Trees.TypeExpressions.INFER(location),
                    body,
                    false
                )

            let closure =
                cast Semantic.Symbols.Closure?(
                    enclosing.declare_closure(
                        location,
                        "$adapted_{_index}",
                        cast Semantic.Scope?(_symbol_table.current_closure_context)!,
                        _symbol_table.current_scope,
                        false,
                        null
                    )
                )

            _index = _index + 1

            if !closure? then
                return null
            fi

            closure.mark_synthesized()

            closure.is_carrier_adapter = true

            _symbol_table.associate_node_with_scope(literal, closure)

            closure.start_declaring_arguments()

            for name in names do
                closure.declare_variable(location, name, false, null).mark_synthesized()
            od

            closure.end_declaring_arguments()

            // The body is a scope carrier in its own right, as it is
            // under any other literal.
            _symbol_table.associate_node_with_scope(body, Semantic.BLOCK_SCOPE(closure))

            return literal
        si
    si
si
