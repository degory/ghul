namespace Syntax.Process is
    // A function literal written with an argument pack spread out -
    // `(a, b) => ...` where the formal takes `T.. -> U` - is compiled
    // taking the pack's tuple directly, with its parameters unpacked on
    // entry. These are the literals that can be.
    class PACKED_LITERAL is
        is_eligible(function: Trees.Expressions.FUNCTION) -> bool static is
            let arity = function.arguments.expressions.count

            if arity < 2 \/ arity > Semantic.ARGUMENT_PACK.MAXIMUM_ARITY then
                return false
            fi

            if function.is_recursive \/ function.contains_let_await then
                return false
            fi

            for a in function.arguments.expressions do
                let parameter = cast Trees.Expressions.VARIABLE?(a)

                if !parameter? \/ parameter.left? \/ parameter.pragmas? then
                    return false
                fi
            od

            return true
        si
    si
si
