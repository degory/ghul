namespace Syntax.Process is
    // Recognises an empty list literal that nothing around it has said
    // the element type of: no elements, no written type and no expected
    // type. Such a literal takes its type from its siblings - the other
    // elements of an enclosing literal, or the other arms of an if or
    // case - so it stays out of their join and is walked again at the
    // type they settle on.
    class CONTEXTLESS_EMPTY_LITERAL is
        is_expression(expression: Trees.Expressions.Expression) -> bool static is
            if let literal: Trees.Expressions.SEQUENCE = expression then
                return
                    literal.elements.expressions.count == 0 /\
                    isa Trees.TypeExpressions.INFER(literal.type_expression) /\
                    !literal.expected_type?
            fi

            return false
        si

        // An arm counts only when the literal is everything it holds:
        // walking the arm again then repeats no other statement.
        is_arm(arm: Trees.Statements.LIST) -> bool static is
            let only: Trees.Statements.Statement? mut = null
            let count mut = 0

            for s in arm.statements do
                only = s
                count = count + 1
            od

            if count != 1 then
                return false
            fi

            if let statement: Trees.Statements.EXPRESSION = only then
                return is_expression(statement.expression)
            fi

            return false
        si
    si
si
