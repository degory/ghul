namespace Syntax.Process is
    use System.Exception;

    use Ghul.Pipes;

    use Logging;
    use Trees;

    use Semantic.Types.Type;

    use Function = Semantic.Symbols.Function;
    use Symbol = Semantic.Symbols.Symbol;

    // Facts the body walk gathers for one function, consumed by the
    // finish-time fixpoint.
    class STORE_FREE_FACTS is
        // The body performs a store or an effect the walk cannot
        // bound: an assignment to anything but a local, a call with
        // an unresolvable callee set, disposal, iteration, an
        // untyped interpolation fragment, an await or yield, ...
        is_disqualified: bool public;

        // The same, except a write to the receiver's own instance state
        // does not set it. That write is invisible to every caller when
        // the receiver is an object nothing else can reach yet, which
        // is what both consumers of this bit guarantee: a constructor
        // run by a `NEW`, and a member reached on `self` from inside
        // such a constructor. So it says "writes nothing but the state
        // of the object it is called on", and is only ever read where
        // that object is known to be fresh.
        is_construction_disqualified: bool public;

        // Statically-bounded callees. The function is store-free
        // only if every one of them proves store-free too.
        callees: Collections.MutableList[Function];

        // Callees reached on a receiver that is fresh, or that is the
        // fresh receiver the caller is itself being constructed on: a
        // constructor run by a construction, and the assign accessor
        // of a property written on `self` inside a constructor. Their
        // own-state writes cannot touch a slot any caller holds a fact
        // about, so these are bounded by the construction-store-free
        // classification rather than the strict one.
        construction_callees: Collections.MutableList[Function];

        init() is
            callees = Collections.LIST[Function]();
            construction_callees = Collections.LIST[Function]();
        si

        add_callee(callee: Function) is
            callees.add(callee);
        si

        add_construction_callee(callee: Function) is
            construction_callees.add(callee);
        si
    si

    // Runs after resolve-overrides, before compile-expressions.
    // Computes for every function declared in the compilation whether
    // it provably performs no store to any pre-existing heap location
    // — no field, property, global, indexer or array-element
    // assignment — directly or through anything a call from its body
    // could dispatch to. Reads are always harmless; only writes and
    // unboundable calls disqualify. A call to a store-free function
    // can never invalidate a field narrowing, which is what
    // IR.Values.Call.*.is_state_changing_call consumes the bit for.
    //
    // The classification runs before types are inferred, so it only
    // trusts declared types: fields, properties, parameters,
    // annotated locals, and locals whose initializer type is trivial.
    // Any call whose callee set it cannot bound — a delegate
    // invocation, a member of an untyped receiver, an imported
    // function — disqualifies the caller. Dispatch is bounded using
    // resolve-overrides' overrider links; a method reachable through
    // an open class or a trait is never store-free, because an
    // override in another assembly could store.
    //
    // Every node kind not explicitly classified below is unsafe via
    // visit_default. When a new node kind is added, it must be
    // explicitly audited here before functions containing it can
    // classify as store-free.
    //
    // This pass never reports diagnostics. It runs on incomplete and
    // incorrect code in analysis mode, where the other passes own
    // finding and reporting every problem; anything suspect here just
    // classifies conservatively. Incremental analysis-mode edit paths
    // do not re-run it, so their per-edit results can hold stale bits;
    // COMPILER.refresh_store_free re-runs it at the debounced compile,
    // and on any flip the compile trues up the files referencing a
    // flipped function - or rebuilds outright when the flip set can't
    // be bounded - so callers' narrowings never stay wrong.
    class INFER_STORE_FREE: DefaultVisitor is
        _facts: Collections.MutableMap[Function, STORE_FREE_FACTS];
        _current: STORE_FREE_FACTS?;
        _current_function: Function?;

        // The study's record for the function being walked, or null
        // when the study is off. See NARROWING_STUDY.
        _current_record: STUDY_RECORD?;

        // Whether the most recent finish_run moved any function's
        // store-free bit. Only meaningful between finish_run and the
        // next start_run.
        _last_run_changed: bool;
        last_run_changed: bool => _last_run_changed;

        // The functions the most recent finish_run's fixpoint moved, or
        // null when a broken run made the flip set unboundable. Same
        // lifetime as last_run_changed.
        _last_flipped: Collections.List[Function]?;
        last_flipped: Collections.List[Function]? => _last_flipped;

        // Mirror of _facts scoped to the file currently being walked,
        // handed back to the caller as the file's reusable fact bucket.
        // Null outside begin_file_bucket / end_file_bucket.
        _bucket: Collections.MutableMap[Function, STORE_FREE_FACTS]?;

        // Files whose bodies were actually re-walked during the most
        // recent finished run, versus absorbed from a retained bucket.
        // Snapshotted by finish_run; the accumulator resets with each
        // start_run. Refresh telemetry.
        _walked_files: int;
        _last_run_walked_files: int;
        last_run_walked_files: int => _last_run_walked_files;

        // Start mirroring walked facts into a fresh per-file bucket.
        begin_file_bucket() is
            _bucket = Collections.MAP[Function, STORE_FREE_FACTS]();
            _walked_files = _walked_files + 1;
        si

        end_file_bucket() -> Collections.MutableMap[Function, STORE_FREE_FACTS] is
            let result = _bucket!;
            _bucket = null;
            return result;
        si

        // Feed a retained file bucket into this run's facts without
        // re-walking the file. Callee edges in retained facts can hold
        // symbol objects an incremental edit has since replaced; the
        // fixpoint treats such an edge as an unknown target and
        // classifies the caller conservatively, and the file's bucket is
        // dropped whenever its expressions recompile, so the pessimism
        // heals at the next walk.
        absorb(bucket: Collections.MutableMap[Function, STORE_FREE_FACTS]) is
            for pair in bucket do
                _facts[pair.key] = pair.value;
            od
        si

        // Trivially-derivable static types, including the per-function
        // record of locals whose initializer type was derivable.
        _typer: TRIVIAL_EXPRESSION_TYPER;

        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup;

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        )
        is
            super.init(logger, symbol_table, namespaces);

            _typer = TRIVIAL_EXPRESSION_TYPER(symbol_table, innate_symbol_lookup);
            _innate_symbol_lookup = innate_symbol_lookup;

            start_run();
        si

        start_run() is
            _facts = Collections.MAP[Function, STORE_FREE_FACTS]();
            _typer.reset();
            _current = null;
            _current_function = null;
            _bucket = null;
            _walked_files = 0;
        si

        // The walk must survive incomplete and incorrect code — it
        // runs in analysis mode on whatever the user has half-typed.
        // It reports nothing, ever: broken code is found and
        // diagnosed by the other passes, and an analysis here that
        // cannot complete only means some functions conservatively
        // stay not-store-free. On an exception the symbol-table scope
        // stack is restored to its entry depth so a long-lived
        // analysis process is not poisoned for later passes, and
        // whatever function was mid-walk keeps its disqualification.
        apply(root: Trees.Node) is
            let mark = mark_scope_stack();

            _last_walk_failed = false;

            try
                root.walk(self);
            catch ex: Exception
                _disqualify_because("walk-aborted");
                release_scope_stack(mark);

                _last_walk_failed = true;
            yrt

            _current = null;
            _current_function = null;
            _current_record = null;
        si

        // Whether the most recent apply abandoned its walk on an
        // exception. A partial walk's facts must not be retained as a
        // file bucket: the functions it never reached would stay absent
        // from every later run's union instead of getting a fresh walk.
        _last_walk_failed: bool;
        last_walk_failed: bool => _last_walk_failed;

        // Study-only: repeat the walk reading the types
        // compile-expressions resolved, rather than the declared-types-
        // only approximation available when the pass really runs.
        set_resolved_mode(on: bool) is
            _typer.use_resolved = on;
            _resolved_mode = on;
        si

        _resolved_mode: bool;

        // Facts in, bits out — the graph solving lives in
        // STORE_FREE_FIXPOINT.
        finish_run() is
            _last_run_walked_files = _walked_files;

            try
                let fixpoint = STORE_FREE_FIXPOINT();

                NARROWING_STUDY.prepare(_facts);

                _last_run_changed = fixpoint.mark(_facts);
                _last_flipped = fixpoint.flipped;

                _trust_value_optional_accessors();

                _run_study();
            catch ex: Exception
                // a broken fixpoint must not leave optimistic bits
                // from a partial write-back behind; treat the run as
                // having changed, with the flip set unboundable, so any
                // incremental shortcut escalates
                _last_run_changed = true;
                _last_flipped = null;

                for function in _facts.keys do
                    function.set_store_free(false);
                od
            yrt

            start_run();
        si

        // Complete each study record from the solved graph, and run the
        // counterfactual solvers the report compares against.
        _run_study() is
            if !NARROWING_STUDY.enabled then
                return;
            fi

            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let record = NARROWING_STUDY.record_for(function);

                if !record? then
                    continue;
                fi

                record.is_disqualified = _facts[function].is_disqualified;
                record.callee_count = _facts[function].callees.count;
                record.openly_dispatchable = shadow.is_openly_dispatchable(function);
                record.declared_pure = function.is_declared_pure;

                let overriders = function.overriders;

                let overrider_count mut = 0;

                if overriders? then
                    for overrider in overriders do
                        overrider_count = overrider_count + 1;
                    od
                fi

                record.overrider_count = overrider_count;
            od

            let study = STORE_FREE_STUDY(_facts);

            let writes = study.definitely_writes();
            let clean = study.body_clean();

            NARROWING_STUDY.set_ground_truth(writes, clean);

            // Classify each function's override closure against the
            // ground truth, so the report can say whether the
            // assumption is contradicted anywhere in this codebase.
            for function in _facts.keys do
                let record = NARROWING_STUDY.record_for(function);

                if !record? then
                    continue;
                fi

                let overriders = function.overriders;

                if !overriders? then
                    continue;
                fi

                for overrider in overriders do
                    if !isa Function(overrider) then
                        record.overrider_unprovable = true;
                        continue;
                    fi

                    let overrider_function = cast Function(overrider);

                    if writes.contains(overrider_function) then
                        record.overrider_writes = true;
                    elif !clean.contains(overrider_function) then
                        record.overrider_unprovable = true;
                    fi
                od
            od

            let write_set_variants = Collections.LIST[Collections.MutableMap[Function, Collections.SET[Symbol]]]();
            let write_unbounded_variants = Collections.LIST[Collections.SET[Function]]();

            for spec in [(false, false), (true, false), (true, true)] do
                let w = study.write_sets(spec.`0, spec.`1);

                write_set_variants.add(w.sets);
                write_unbounded_variants.add(w.unbounded);
            od

            NARROWING_STUDY.set_write_sets(write_set_variants, write_unbounded_variants);

            let nulling_set_variants = Collections.LIST[Collections.MutableMap[Function, Collections.SET[Symbol]]]();
            let nulling_unbounded_variants = Collections.LIST[Collections.SET[Function]]();

            for spec in [(false, false), (true, false), (true, true)] do
                let n = study.may_null_sets(spec.`0);

                nulling_set_variants.add(n.sets);
                nulling_unbounded_variants.add(n.unbounded);
            od

            NARROWING_STUDY.set_nulling_sets(nulling_set_variants, nulling_unbounded_variants);

            NARROWING_STUDY.set_blame(study.blame(true, true));

            NARROWING_STUDY.set_import_blame(study.blame(true, false));

            NARROWING_STUDY.set_element_safe(
                study.element_only(false),
                study.element_only(true));

            NARROWING_STUDY.set_never_nulls(
                study.never_nulls(true),
                study.never_nulls(false));

            let mn = study.may_null_sets(false);

            NARROWING_STUDY.set_may_null(mn.sets, mn.unbounded);

            NARROWING_STUDY.set_control(study.solve(Collections.SET[Function]()));

            NARROWING_STUDY.set_optimistic(
                study.solve(study.exempt_getters(true)),
                study.solve(study.exempt_getters(false)));
        si

        // The value-type optional carriers' accessors get the bit
        // directly: `x?` / `x!` on an `int?`-style slot lower to
        // these at compile-expressions time without appearing as
        // call edges here, and both read a field of a sealed struct
        // — no overrider can exist, so unconditional trust is sound.
        // Without the bit every value-type presence test would count
        // as a possibly-storing call and kill the very facts it
        // establishes.
        _trust_value_optional_accessors() is
            let bool_type = _innate_symbol_lookup.get_bool_type();

            _mark_read_accessors_store_free(_innate_symbol_lookup.get_optional_type(bool_type));
            _mark_read_accessors_store_free(_innate_symbol_lookup.get_maybe_type(bool_type));
        si

        _mark_read_accessors_store_free(type: Semantic.Types.Type?) is
            if !type? then
                return;
            fi

            for name in ["has_value", "value"] do
                let member = type.find_member(name);

                if member? /\ isa Semantic.Symbols.Property(member) then
                    let read_function = (cast Semantic.Symbols.Property(member)).read_function;

                    if read_function? then
                        read_function.set_store_free(true);
                    fi
                fi
            od
        si

        // Open a study record for the function about to be walked, and
        // classify its accessor role from the name add-accessors-for-
        // properties synthesised.
        _note_study_function(function: Definitions.FUNCTION, symbol: Function) is
            _current_record = null;

            if !NARROWING_STUDY.enabled /\ NARROWING_STUDY.assume_mode == 0 then
                return;
            fi

            let raw_name = if function.name? then function.name.name else "" fi;

            let role mut = "";

            if function.for_property? \/ function.for_indexer? then
                let is_indexer = function.for_indexer?;

                if raw_name.starts_with("$get_") \/ raw_name.starts_with("get_") then
                    role = if is_indexer then "index-get" else "get" fi;
                elif raw_name.starts_with("$set_") \/ raw_name.starts_with("set_") then
                    role = if is_indexer then "index-set" else "set" fi;
                fi
            fi

            let owner = symbol.owner;

            NARROWING_STUDY.note_function(
                symbol,
                raw_name,
                if owner? then owner.name else "" fi,
                "{function.location}",
                role);

            _current_record = NARROWING_STUDY.record_for(symbol);

            if _current_record? /\ function.for_property? then
                _current_record.for_auto_property = function.for_property.is_auto_property;
            fi
        si

        // ==== default: any node kind without an explicit override ====

        visit_default(node: Trees.Node) is
            if _resolved_mode /\ _classify_resolved(node) then
                return;
            fi

            _disqualify_because("unaudited-node:{node.get_type().full_name}");
        si

        // Study-only. Once compile-expressions has run, the node kinds
        // this walk never modelled carry enough resolved state to be
        // classified: a `for` names the three iterator members it calls,
        // and every other expression carries the value it compiled to,
        // whose callee is a bounded edge like any other. Returns whether
        // the node was classified; false falls through to disqualifying
        // it as before.
        _classify_resolved(node: Trees.Node) -> bool is
            if let `for: Statements.FOR = node then
                if `for.fusion? then
                    return _classify_fused_for(`for.fusion);
                fi

                // read_iterator is legitimately null when the loop
                // expression is already an iterator - the emitter
                // drives move_next/current on the value directly
                if !`for.move_next? \/ !`for.read_current? then
                    let expression = `for.expression;

                    let detail =
                        if !expression? then
                            "no-expression"
                        elif !expression.value? then
                            "no-value"
                        elif !expression.value.type? then
                            "no-type"
                        else
                            "{expression.value.type}"
                        fi;

                    _disqualify_because("for-unresolved:{detail}");
                    return true;
                fi

                if `for.read_iterator? then
                    _add_callee(`for.read_iterator);
                fi

                _add_callee(`for.move_next);
                _add_callee(`for.read_current);

                return true;
            fi

            if let expression: Trees.Expressions.Expression = node then
                let value = expression.value;

                if !value? then
                    return false;
                fi

                return _classify_resolved_value(value);
            fi

            return false;
        si

        // A fused loop never builds the pipe objects: it iterates the
        // pinned built-in source directly and runs each map/filter
        // stage's lambda body inline, so the loop's effects are the
        // stage bodies' effects. The lambda literals were skipped by
        // the ordinary walk (creating a closure is effect-free), so
        // they are walked here, attributed to the enclosing function
        // exactly as the fused lowering executes them. A stage fed an
        // arbitrary delegate value rather than a literal is invoked
        // per element with no bounded callee, so it stays unbounded
        // unless the value's type is a pure function type.
        _classify_fused_for(fusion: PIPE_FUSION) -> bool is
            for stage in fusion.stages_outermost_first do
                if stage.is_countdown \/ stage.is_index then
                    continue;
                fi

                let argument = stage.argument;

                if !argument? then
                    continue;
                fi

                if let literal: Trees.Expressions.FUNCTION = argument then
                    literal.body.walk(self);
                elif !(argument.value? /\ argument.value.type? /\ argument.value.type.is_pure_function) then
                    _disqualify_because("fused-stage-delegate");
                    return true;
                fi
            od

            return true;
        si

        _classify_resolved_value(value: IR.Values.Value) -> bool is
            if let view: IR.Values.NARROW_VIEW = value then
                return _classify_resolved_value(view.underlying);
            fi

            if let call: IR.Values.Call.INSTANCE = value then
                _add_callee(call.function);
                _study_note_call_arguments(call.function, call.arguments);
                return true;
            fi

            if let call: IR.Values.Call.STATIC = value then
                _add_callee(call.function);
                _study_note_call_arguments(call.function, call.arguments);
                return true;
            fi

            if let call: IR.Values.Call.GLOBAL = value then
                _add_callee(call.function);
                _study_note_call_arguments(call.function, call.arguments);
                return true;
            fi

            if let call: IR.Values.Call.STRUCT = value then
                _add_callee(call.function);
                _study_note_call_arguments(call.function, call.arguments);
                return true;
            fi

            if let construction: IR.Values.NEW = value then
                _add_construction_callee(construction.constructor);
                _study_note_call_arguments(construction.constructor, construction.arguments);
                return true;
            fi

            // Invoking a function value: bounded when the value names
            // its function, effect-polymorphic when it is one of the
            // enclosing function's own parameters, unboundable
            // otherwise.
            if let call: IR.Values.Call.CLOSURE = value then
                if !call.is_state_changing_call then
                    return true;
                fi

                let fn = _function_value_of(call.from);

                if fn? then
                    _add_callee(fn);
                    _study_note_call_arguments(fn, call.arguments);
                    return true;
                fi

                if isa IR.Values.Load.LOCAL_ARGUMENT(call.from) then
                    if _current_record? then
                        _current_record.invokes_function_param = true;
                    fi

                    return true;
                fi

                return false;
            fi

            // not a call at all: reading a value writes nothing, and any
            // sub-expression is classified as the walk reaches it
            return !value.is_state_changing_call;
        si

        // The function a value denotes, when the value's shape names
        // one: a lambda literal compiled to a closure, a delegate
        // constructed from a named function, a function pointer.
        _function_value_of(value: IR.Values.Value?) -> Function? is
            if !value? then
                return null;
            fi

            if let view: IR.Values.NARROW_VIEW = value then
                return _function_value_of(view.underlying);
            fi

            if let load: IR.Values.Load.INSTANCE_ANONYMOUS_FUNCTION = value then
                return cast Function?(load.symbol);
            fi

            if let load: IR.Values.Load.STATIC_ANONYMOUS_FUNCTION = value then
                return cast Function?(load.symbol);
            fi

            if let load: IR.Values.Load.GLOBAL_ANONYMOUS_FUNCTION = value then
                return cast Function?(load.symbol);
            fi

            return value.referenced_function;
        si

        // Record which function values flow into a callee's
        // function-typed parameters. A named value joins the callee's
        // passed set; the caller's own parameter forwarded onward is
        // accounted at the caller's own call sites instead; anything
        // else function-typed makes the callee's parameter values
        // unknowable - unless its type is pure, which admits only
        // store-free values whoever invokes it.
        _study_note_call_arguments(callee: Function?, arguments: Collections.List[IR.Values.Value]) is
            if !callee? then
                return;
            fi

            for argument in arguments do
                let fn = _function_value_of(argument);

                if fn? then
                    NARROWING_STUDY.note_passed_function(callee, fn);
                    continue;
                fi

                if isa IR.Values.Load.LOCAL_ARGUMENT(argument) then
                    let argument_type = argument.type;

                    if argument_type? /\ argument_type.is_function /\ !argument_type.is_pure_function then
                        if _current_record? then
                            let root = cast Function?(callee.root_specialized_from);

                            if root? then
                                _current_record.forwards_param_to.add(root!);
                            fi
                        fi
                    fi

                    continue;
                fi

                let argument_type = argument.type;

                if argument_type? /\ argument_type.is_function /\ !argument_type.is_pure_function then
                    NARROWING_STUDY.note_passed_opaque(callee);
                fi
            od
        si

        // `_disqualify` with the reason recorded for the study, so the
        // report can say what the walk actually gives up on. First
        // reason wins: it is the one that made the function unbounded.
        _disqualify_because(reason: string) is
            if _current? /\ _current_record? /\ _current_record.unbounded_reason =~ "" then
                _current_record.unbounded_reason = reason;
            fi

            _disqualify();
        si

        _disqualify() is
            if !_current? then
                return;
            fi

            _current.is_disqualified = true;
            _current.is_construction_disqualified = true;

            if _current_record? then
                _current_record.own_unbounded = true;

                // whatever the walk could not bound could write
                // anything, so the write set stops being a bound too
                _current_record.writes_unbounded = true;
            fi
        si

        // The subset of `_disqualify` where the walk saw a write to a
        // pre-existing heap slot rather than merely failing to bound
        // something. Behaves identically; only the study distinguishes
        // them.
        _disqualify_store() is
            if !_current? then
                return;
            fi

            _current.is_disqualified = true;
            _current.is_construction_disqualified = true;

            if _current_record? then
                _current_record.own_stores = true;
            fi
        si

        // A store the strict analysis rejects but a construction does
        // not: writing the receiver's own instance state touches only
        // the fresh object a `NEW` is building.
        _disqualify_strict_only() is
            if !_current? then
                return;
            fi

            _current.is_disqualified = true;

            if _current_record? then
                _current_record.own_stores = true;
            fi
        si

        _in_constructor: bool =>
            _current_function? /\ _current_function.is_constructor;

        // A `self.field` target naming an instance field of the
        // receiver. `self` is the only receiver the construction bit
        // says anything about; a member on any other receiver stays a
        // heap store.
        _writes_own_instance_field_member(target: Trees.Expressions.Expression?) -> bool is
            if !target? \/ !isa Trees.Expressions.MEMBER(target) then
                return false;
            fi

            let member = cast Trees.Expressions.MEMBER(target);

            if !isa Trees.Expressions.SELF(member.left) then
                return false;
            fi

            let context = current_instance_context;

            if !context? then
                return false;
            fi

            let field_symbol = context.find_member(member.identifier.name);

            return field_symbol? /\ field_symbol.is_field /\ field_symbol.is_instance;
        si

        // The assign accessor behind a `self.property` target on the
        // type under construction. Writing a property runs its
        // accessor rather than storing directly, so the write is only
        // as safe as that accessor is — an auto-property's accessor
        // writes nothing but its own backing field and qualifies, a
        // hand-written one that stores elsewhere does not. Null for any
        // target that is not an instance property on `self`.
        _writes_own_instance_property_member(target: Trees.Expressions.Expression?) -> Function? is
            if !target? \/ !isa Trees.Expressions.MEMBER(target) then
                return null;
            fi

            let member = cast Trees.Expressions.MEMBER(target);

            if !isa Trees.Expressions.SELF(member.left) then
                return null;
            fi

            let context = current_instance_context;

            if !context? then
                return null;
            fi

            return _instance_property_assign(context.find_member(member.identifier.name));
        si

        // A constructor delegating to another constructor on the same
        // object — `super.init(…)` from a subclass, `self.init(…)` from
        // a secondary constructor.
        _is_constructor_chain(member: Trees.Expressions.MEMBER) -> bool =>
            _in_constructor /\
            member.identifier.name =~ "init" /\
            (isa Trees.Expressions.SELF(member.left) \/ isa Trees.Expressions.SUPER(member.left));

        _instance_property_assign(symbol: Symbol?) -> Function? is
            if !symbol? \/ !symbol.is_instance \/ !isa Semantic.Symbols.Property(symbol) then
                return null;
            fi

            return (cast Semantic.Symbols.Property(symbol)).assign_function;
        si

        _add_callee(callee: Function?) is
            if !_current? then
                return;
            fi

            if !callee? then
                _disqualify_because("callee-null");
                return;
            fi

            let root = cast Function?(callee.root_specialized_from);

            if !root? then
                _disqualify_because("callee-no-root");
                return;
            fi

            _current.add_callee(root);
        si

        _add_construction_callee(callee: Function?) is
            if !_current? then
                return;
            fi

            if !callee? then
                _disqualify_because("ctor-callee-null");
                return;
            fi

            let root = cast Function?(callee.root_specialized_from);

            if !root? then
                _disqualify_because("ctor-callee-no-root");
                return;
            fi

            _current.add_construction_callee(root);
        si

        _add_callee_edges(symbol: Symbol?) is
            if !_current? then
                return;
            fi

            if !symbol? then
                _disqualify_because("callee-symbol-null");
                return;
            fi

            if isa Semantic.Symbols.FUNCTION_GROUP(symbol) then
                for function in (cast Semantic.Symbols.FUNCTION_GROUP(symbol)).functions do
                    _add_callee(function);
                od
            elif isa Function(symbol) then
                _add_callee(cast Function(symbol));
            elif
                _resolved_mode /\
                isa Semantic.Symbols.LOCAL_ARGUMENT(symbol) /\
                symbol.type? /\ symbol.type.is_function
            then
                // invoking a function-typed parameter: bounded by the
                // values the enclosing function's own callers pass
                if _current_record? then
                    _current_record.invokes_function_param = true;
                fi
            elif _is_store_free_construction(symbol) then
                // constructing a fresh exception writes only that new
                // object, never a pre-existing heap slot, so it cannot
                // invalidate a narrowing
            elif isa Semantic.Symbols.Classy(symbol) /\ !symbol.is_reflected then
                _add_construction_edges((cast Semantic.Symbols.Classy(symbol)).find_member("init"));
            else
                // a delegate-typed value, an imported constructor, or
                // something stranger: the call's effect cannot be
                // bounded
                _disqualify_because("callee-not-a-function:{symbol.get_type().name}");
            fi
        si

        // Constructing a source-declared type runs a constructor on an
        // object nothing else can reach yet, so the caller is bounded
        // by the constructor's construction-store-free classification
        // rather than its strict one — a constructor writing its own
        // instance state stays store-free from where the construction
        // is written. Overload resolution has not run, so every `init`
        // the type declares has to qualify.
        _add_construction_edges(constructors: Symbol?) is
            if isa Semantic.Symbols.FUNCTION_GROUP(constructors) then
                for function in (cast Semantic.Symbols.FUNCTION_GROUP(constructors)).functions do
                    _add_construction_callee(function);
                od

                return;
            fi

            if isa Function(constructors) then
                _add_construction_callee(cast Function(constructors));
                return;
            fi

            _disqualify_because("constructor-unresolved");
        si

        // Constructing an imported exception type is store-free for
        // narrowing: an exception constructor by .NET convention only
        // records its arguments into the new exception's own state and
        // invokes no behaviour on them, so no user code runs and no
        // pre-existing heap slot is written. The constructor arguments
        // are classified as the walk reaches them, so a storing
        // argument still disqualifies. Restricted to reflected types so
        // a user-declared exception - whose constructor could store -
        // stays unbounded.
        _is_store_free_construction(symbol: Symbol?) -> bool is
            if !symbol? \/ !symbol.is_reflected \/ !isa Semantic.Symbols.Classy(symbol) then
                return false;
            fi

            let exception_type = _innate_symbol_lookup.get_exception_type();
            let classy_type = (cast Semantic.Symbols.Classy(symbol)).type;

            return classy_type? /\ exception_type.is_assignable_from(classy_type);
        si

        // A property read runs its getter, and a call that reaches
        // the getter may dispatch to any overriding property's getter.
        // Property override links live on the Property symbols, not
        // on the accessor functions, so the override closure is
        // expanded here rather than through Function.overriders.
        _add_property_read_edges(property: Semantic.Symbols.Property) is
            if !_current? then
                return;
            fi

            if !property.read_function? then
                _disqualify_because("property-no-getter");
                return;
            fi

            _add_callee(property.read_function);

            let overriders = property.overriders;

            if !overriders? then
                return;
            fi

            for overrider in overriders do
                if isa Semantic.Symbols.Property(overrider) then
                    _add_property_read_edges(cast Semantic.Symbols.Property(overrider));
                else
                    _disqualify_because("overrider-not-a-property");
                fi
            od
        si

        _classify_member_read(symbol: Symbol?) is
            if !symbol? then
                return;
            fi

            if isa Semantic.Symbols.Property(symbol) then
                _add_property_read_edges(cast Semantic.Symbols.Property(symbol));
            fi

            // fields, locals, parameters, function groups (a bare
            // function reference only creates a delegate), types and
            // namespaces are harmless reads
        si

        // ==== function context ====

        pre(function: Definitions.FUNCTION) -> bool is
            enter_scope(function);

            if _current? then
                // function definitions do not nest; if the tree ever
                // produces one, poison the enclosing classification
                // rather than mis-attribute the nested body's facts
                _current.is_disqualified = true;
            fi

            _typer.reset();

            let symbol = function_for(function);

            if symbol? then
                let facts = STORE_FREE_FACTS();

                _facts[symbol] = facts;

                if _bucket? then
                    _bucket![symbol] = facts;
                fi

                _current = facts;
                _current_function = symbol;

                _note_study_function(function, symbol);
            else
                _current = null;
                _current_function = null;
                _current_record = null;
            fi

            return false;
        si

        visit(function: Definitions.FUNCTION) is
            leave_scope(function);

            _current = null;
            _current_function = null;
        si

        // Property and indexer accessor bodies arrive as synthesised
        // sibling FUNCTION definitions; the original nodes carry the
        // same body and would double-classify it.
        pre(property: Definitions.PROPERTY) -> bool => true;
        visit(property: Definitions.PROPERTY) is si

        pre(indexer: Definitions.INDEXER) -> bool => true;
        visit(indexer: Definitions.INDEXER) is si

        // A lambda body does not run when the enclosing function
        // merely creates the closure; any invocation happens through
        // a delegate-typed value, which is never a bounded callee.
        // Closure symbols are never marked store-free.
        //
        // In resolved mode the body is walked anyway, under the
        // closure's own function symbol, so the effect-polymorphic
        // absorption has a write set for every function value it can
        // trace to a literal.
        pre(function: Expressions.FUNCTION) -> bool is
            if _resolved_mode then
                _study_walk_lambda(function);
            fi

            return true;
        si

        visit(function: Expressions.FUNCTION) is si

        _study_walk_lambda(function: Expressions.FUNCTION) is
            let symbol = _function_value_of(function.value);

            if !symbol? then
                return;
            fi

            let root = cast Function?(symbol.root_specialized_from);

            if !root? \/ _facts.contains_key(root!) then
                return;
            fi

            let saved_facts = _current;
            let saved_function = _current_function;
            let saved_record = _current_record;

            let facts = STORE_FREE_FACTS();

            _facts[root!] = facts;
            _current = facts;
            _current_function = root;

            NARROWING_STUDY.note_function(root, root.name, "", "{function.location}", "lambda");
            _current_record = NARROWING_STUDY.record_for(root);

            enter_scope(function);
            function.body.walk(self);
            leave_scope(function);

            _current = saved_facts;
            _current_function = saved_function;
            _current_record = saved_record;
        si

        // ==== stores ====

        // The target of a store is written, not read: walking it
        // generically would classify the member as a read as well,
        // adding its getter's edges - and disqualifying outright when
        // the property is assign-only and has no getter. So the
        // children are driven by hand: the value and every receiver
        // and index expression inside the target are walked, the
        // target member itself is not.
        pre(assign: Statements.ASSIGNMENT) -> bool is
            assign.right.walk(self);

            _walk_assignment_target_operands(assign.left);

            return true;
        si

        _walk_assignment_target_operands(left: Trees.Expressions.AssignmentLeftExpression?) is
            if !left? then
                return;
            fi

            if isa Trees.Expressions.SIMPLE_LEFT_EXPRESSION(left) then
                _walk_store_target_operands((cast Trees.Expressions.SIMPLE_LEFT_EXPRESSION(left)).expression);
            elif isa Trees.Expressions.DESTRUCTURING_LEFT_EXPRESSION(left) then
                for element in (cast Trees.Expressions.DESTRUCTURING_LEFT_EXPRESSION(left)).elements do
                    _walk_assignment_target_operands(element);
                od
            fi
        si

        _walk_store_target_operands(target: Trees.Expressions.Expression?) is
            if !target? then
                return;
            fi

            if let member: Trees.Expressions.MEMBER = target then
                if !isa Trees.Expressions.SELF(member.left) then
                    member.left.walk(self);
                fi

                return;
            fi

            if let index: Trees.Expressions.INDEX = target then
                index.left.walk(self);
                index.index.walk(self);
                return;
            fi

            if let ambiguous: Trees.Expressions.AMBIGUOUS_EXPRESSION = target then
                if ambiguous.result == Trees.Expressions.AmbiguousExpressionResult.INDEX then
                    _walk_store_target_operands(ambiguous.index);
                elif ambiguous.left? then
                    ambiguous.left.walk(self);
                fi

                return;
            fi

            // a bare identifier target: nothing inside it to read
        si

        visit(assign: Statements.ASSIGNMENT) is
            if !_current? then
                return;
            fi

            // Study-only: whether this assignment's value could be
            // absent. An RHS of declared non-optional type cannot be
            // null under the language's own rules; anything optional or
            // untypeable counts as possibly-null.
            let rhs_type = _typer.try_type(assign.right);

            _study_rhs_nulling = !rhs_type? \/ rhs_type.is_optional;

            _classify_assignment_target(assign.left);

            _study_rhs_nulling = false;
        si

        _study_rhs_nulling: bool;

        // Flag the current function as assigning a possibly-absent
        // value to member-or-wider storage. A constructor's writes to
        // its own fresh instance cannot make any pre-existing member
        // absent, so they are excluded.
        _study_note_nulling(own_instance: bool) is
            if !_current_record? \/ !_study_rhs_nulling then
                return;
            fi

            if _in_constructor /\ own_instance then
                return;
            fi

            _current_record.assigns_optional = true;
        si

        // The member-keyed refinement of the above: record which member
        // the possibly-null assignment targets, or that it could not be
        // resolved.
        _study_note_nulling_member(symbol: Symbol?, own_instance: bool) is
            if !_current_record? \/ !_study_rhs_nulling then
                return;
            fi

            if _in_constructor /\ own_instance then
                return;
            fi

            if symbol? then
                _current_record.nulling_writes.add(symbol.root_specialized_from);
            else
                _current_record.nulling_unbounded = true;
            fi
        si

        _classify_assignment_target(left: Trees.Expressions.AssignmentLeftExpression?) is
            if !left? then
                _disqualify_because("assign-target-null");
                return;
            fi

            if isa Trees.Expressions.SIMPLE_LEFT_EXPRESSION(left) then
                _classify_simple_store((cast Trees.Expressions.SIMPLE_LEFT_EXPRESSION(left)).expression);
            elif isa Trees.Expressions.DESTRUCTURING_LEFT_EXPRESSION(left) then
                for element in (cast Trees.Expressions.DESTRUCTURING_LEFT_EXPRESSION(left)).elements do
                    _classify_assignment_target(element);
                od
            else
                _disqualify_because("assign-target-shape");
            fi
        si

        _classify_simple_store(target: Trees.Expressions.Expression?) is
            _study_note_store(target);

            if _writes_own_instance_field_member(target) then
                // `self.field = …` writes only the receiver's own
                // state: disqualifies the strict bit but not
                // construction, exactly like the bare-field form below
                _disqualify_strict_only();
                return;
            fi

            let member_assign_function = _writes_own_instance_property_member(target);

            if member_assign_function? then
                // `self.property = …` reaches that same state through
                // the property's accessor
                _disqualify_strict_only();
                _add_construction_callee(member_assign_function);
                return;
            fi

            if _is_local_target(target) then
                // reassigning a local variable or parameter is
                // callee-private
                return;
            fi

            if !target? \/ !isa Trees.Expressions.IDENTIFIER(target) then
                // a member, index or other compound target is a heap
                // store
                _disqualify_store();
                return;
            fi

            let identifier = (cast Trees.Expressions.IDENTIFIER(target)).identifier;

            if identifier.is_qualified then
                _disqualify_store();
                return;
            fi

            let symbol = try_find(identifier);

            if symbol? /\ symbol.is_field /\ symbol.is_instance then
                // a bare instance-field name resolves to the receiver's
                // own field, so the write disqualifies the strict bit
                // but not construction
                _disqualify_strict_only();
                return;
            fi

            let assign_function = _instance_property_assign(symbol);

            if assign_function? then
                // the bare-name form of the own-property write handled
                // above
                _disqualify_strict_only();
                _add_construction_callee(assign_function);
                return;
            fi

            // a global variable, or a target the walk could not
            // resolve: either way the write is not to a local
            _disqualify_store();
        si

        // A bare name for a local variable or a parameter — the one
        // storage location a function can write without any caller
        // seeing it.
        _is_local_target(target: Trees.Expressions.Expression?) -> bool is
            if !target? \/ !isa Trees.Expressions.IDENTIFIER(target) then
                return false;
            fi

            let identifier = (cast Trees.Expressions.IDENTIFIER(target)).identifier;

            if identifier.is_qualified then
                return false;
            fi

            let symbol = try_find(identifier);

            return
                symbol? /\
                (isa Semantic.Symbols.LOCAL_VARIABLE(symbol) \/ isa Semantic.Symbols.LOCAL_ARGUMENT(symbol));
        si

        // `x ref` hands the callee the address of a storage location
        // rather than a value, and the callee may write through it.
        // What the callee itself does is bounded by the enclosing
        // call's own edges, with one exception that decides this
        // classification: several of the imports trusted store-free
        // write a by-ref argument by contract — `try_get_value` is the
        // everyday one — so a write through the address is not always
        // covered by a callee edge. The operand therefore has to carry
        // it. The address of a local variable or parameter is
        // callee-private, exactly as assigning one is; the address of a
        // field, a property or an element is a possible heap store.
        //
        // The node's own `writes_target` flag says which direction the
        // matched parameter takes, and is deliberately not consulted:
        // it is set during call resolution, which runs after this pass,
        // so every REFERENCE reaching here still reads false.
        //
        // The operand is walked as a child, so its own reads are
        // classified independently of this.
        visit(reference: Expressions.REFERENCE) is
            if !_current? then
                return;
            fi

            if !_is_local_target(reference.left) then
                _disqualify();
            fi
        si

        // Record, for the study, which member symbol a store targets.
        // Mirrors the classification below without affecting it: a
        // local target records nothing, a resolvable member records
        // that symbol, anything else marks the writes unboundable.
        _study_note_store(target: Trees.Expressions.Expression?) is
            if !_current_record? then
                return;
            fi

            if !target? then
                _current_record.writes_unbounded = true;
                return;
            fi

            if isa Trees.Expressions.IDENTIFIER(target) then
                let symbol = try_find((cast Trees.Expressions.IDENTIFIER(target)).identifier);

                if
                    symbol? /\
                    (isa Semantic.Symbols.LOCAL_VARIABLE(symbol) \/ isa Semantic.Symbols.LOCAL_ARGUMENT(symbol))
                then
                    return;
                fi

                _study_note_nulling(symbol? /\ symbol.is_instance);
                _study_note_nulling_member(symbol, symbol? /\ symbol.is_instance);
                _study_add_write(symbol);
                return;
            fi

            if isa Trees.Expressions.MEMBER(target) then
                let member = cast Trees.Expressions.MEMBER(target);

                if isa Trees.Expressions.SELF(member.left) then
                    let context = current_instance_context;

                    if context? then
                        _study_note_nulling(true);
                        _study_note_nulling_member(context.find_member(member.identifier.name), true);
                        _study_add_write(context.find_member(member.identifier.name));
                        return;
                    fi
                fi

                let left_type = _typer.try_type(member.left);

                if !left_type? then
                    _study_note_nulling(false);
                    _study_note_nulling_member(null, false);
                    _study_unbounded_store("store-receiver-untyped");
                    return;
                fi

                let member_symbol = left_type.find_member(member.identifier.name);

                if !member_symbol? then
                    _study_note_nulling(false);
                    _study_note_nulling_member(null, false);
                    _study_unbounded_store("store-member-not-found");
                    return;
                fi

                _study_note_nulling(false);
                _study_note_nulling_member(member_symbol, false);
                _study_add_write(member_symbol);
                return;
            fi

            if isa Trees.Expressions.INDEX(target) then
                // an element store: cannot change what any field holds,
                // so it is recorded apart from member writes - the
                // element-rescue measurement keys on the distinction
                _current_record.writes_elements = true;
                return;
            fi

            // `xs[i] = v` parses as an ambiguous expression; once
            // compile-expressions has settled which shape it is, an
            // index store is an element store like any other
            if let ambiguous: Trees.Expressions.AMBIGUOUS_EXPRESSION = target then
                if ambiguous.result == Trees.Expressions.AmbiguousExpressionResult.INDEX then
                    _current_record.writes_elements = true;
                    return;
                fi

                _study_note_nulling(false);
                _study_note_nulling_member(null, false);
                _study_unbounded_store("store-ambiguous-unresolved");
                return;
            fi

            // a target shape the walk does not model
            _study_note_nulling(false);
            _study_note_nulling_member(null, false);
            _study_unbounded_store("store-target-shape:{target.get_type().name}");
        si

        // Mark the current record's write set unboundable, naming why,
        // so the blame table can split the catch-all
        // "write-target-unresolved" bucket by cause.
        _study_unbounded_store(reason: string) is
            if !_current_record? then
                return;
            fi

            _current_record.writes_unbounded = true;

            if _current_record.unbounded_reason =~ "" then
                _current_record.unbounded_reason = reason;
            fi
        si

        _study_add_write(symbol: Symbol?) is
            if !_current_record? then
                return;
            fi

            if !symbol? then
                _current_record.writes_unbounded = true;
                return;
            fi

            _current_record.writes.add(symbol.root_specialized_from);
        si

        // ==== calls ====

        visit(call: Expressions.CALL) is
            if !_current? then
                return;
            fi

            // Study-only: after compile-expressions the call carries the
            // value it compiled to, which names the callee directly
            // whatever shape the target expression has.
            if _resolved_mode then
                let value = call.value;

                if value? /\ _classify_resolved_value(value) then
                    return;
                fi
            fi

            _add_call_target_edges(call.function);
        si

        // A value slot whose declared type is a pure function type:
        // invoking the held value is trusted store-free, whatever it
        // turns out to be — the pure-typed slot only admits pure
        // values. Parameters and fields qualify; a property is excluded
        // because reading it runs its getter. A local variable is
        // excluded too: its `type` is filled by compile-expressions,
        // which runs after this pass, so reading it here would make the
        // classification depend on whether that later pass has run — it
        // has in an analysis-mode refresh, it has not in a batch build.
        _is_pure_function_valued(symbol: Semantic.Symbols.Symbol?) -> bool =>
            symbol? /\
            isa Semantic.Symbols.Variable(symbol) /\
            (_resolved_mode \/ !isa Semantic.Symbols.LOCAL_VARIABLE(symbol)) /\
            symbol.type? /\ symbol.type.is_pure_function;

        _add_call_target_edges(target: Trees.Expressions.Expression?) is
            if !target? then
                _disqualify_because("call-target-null");
                return;
            fi

            if isa Trees.Expressions.IDENTIFIER(target) then
                let identifier = (cast Trees.Expressions.IDENTIFIER(target)).identifier;

                let symbol = try_find(identifier);

                if _is_pure_function_valued(symbol) then
                    return;
                fi

                _add_callee_edges(symbol);
                return;
            fi

            if isa Trees.Expressions.MEMBER(target) then
                let member = cast Trees.Expressions.MEMBER(target);

                if _is_constructor_chain(member) then
                    // `super.init(…)` or `self.init(…)` runs on the
                    // object this constructor is itself being run on,
                    // so it is bounded the same way a construction is —
                    // and writes that receiver's own state, so it
                    // disqualifies the strict bit just as writing a
                    // field directly does
                    _disqualify_strict_only();

                    let receiver_type = _typer.try_type(member.left);

                    if !receiver_type? then
                        _disqualify_because("ctor-chain-receiver-untyped");
                        return;
                    fi

                    _add_construction_edges(receiver_type.find_member("init"));
                    return;
                fi

                let as_identifier = member.try_copy_as_identifer();

                if as_identifier? then
                    let symbol = try_find(as_identifier);

                    if symbol? then
                        if _is_pure_function_valued(symbol) then
                            return;
                        fi

                        _add_callee_edges(symbol);
                        return;
                    fi
                fi

                let left_type = _typer.try_type(member.left);

                if !left_type? then
                    _disqualify_because("call-receiver-untyped");
                    return;
                fi

                let member_symbol = left_type.find_member(member.identifier.name);

                if member_symbol? /\ _is_pure_function_valued(member_symbol) /\ member_symbol.is_field then
                    return;
                fi

                _add_callee_edges(member_symbol);
                return;
            fi

            if isa Trees.Expressions.RECURSE(target) then
                _add_callee(_current_function);
                return;
            fi

            if isa Trees.Expressions.EXPLICIT_SPECIALIZATION(target) then
                _add_call_target_edges((cast Trees.Expressions.EXPLICIT_SPECIALIZATION(target)).left);
                return;
            fi

            _disqualify_because("call-target-shape");
        si

        // ==== operators ====

        visit(binary: Expressions.BINARY) is
            if !_current? then
                return;
            fi

            _add_operator_edges(binary.operation, binary.left, binary.right);
        si

        visit(unary: Expressions.UNARY) is
            if !_current? then
                return;
            fi

            _add_operator_edges(unary.operation, unary.right, null);
        si

        _add_operator_edges(
            operation: Identifiers.Identifier?,
            left: Trees.Expressions.Expression?,
            right: Trees.Expressions.Expression?
        ) is
            if !operation? then
                _disqualify_because("operator-unresolved");
                return;
            fi

            // free operator functions visible in scope: the innate
            // operators and user-defined operators share one group
            let group = find(operation.name);

            if group? then
                _add_callee_edges(group);
            fi

            // `==` has a single compiler-generated implementation:
            // `==` and `!=` both carry the operation name `==` (the
            // parser rewrites `!=`), and neither can be overloaded or
            // overridden as a member. There is never a member operator
            // to bound, so the member lookup — which otherwise
            // disqualifies the function whenever an operand's type is
            // not trivially derivable — is skipped.
            //
            // `=~` and `<>` are skipped for a different reason: every
            // declaration is store-free by construction, because
            // CHECK_PURE_OVERRIDES rejects any that is not declared
            // pure or provably store-free. A member lookup could only
            // find implementations already known safe, and would
            // disqualify on operands whose type is not derivable here
            // — a lambda parameter, or a bare type parameter compared
            // through the runtime's comparer, where the comparison can
            // dispatch to any implementation at all. Reflected forms
            // reach Equals/CompareTo, which the runtime contract
            // treats as side-effect-free, so they are trusted the same
            // way.
            if operation.name =~ "==" \/ operation.name =~ "=~" \/ operation.name =~ "<>" then
                return;
            fi

            // operator members can only be bounded when the operand
            // types are known
            _add_member_operator_edges(operation.name, left);

            if right? then
                _add_member_operator_edges(operation.name, right);
            fi
        si

        _add_member_operator_edges(name: string, operand: Trees.Expressions.Expression?) is
            let operand_type = _typer.try_type(operand);

            if !operand_type? then
                // The operand's type is not trivially derivable, so a
                // member operator on it cannot be bounded here — the
                // same position a call on an untypable receiver is
                // in, and answered the same way. The free and innate
                // operators are already bounded through the operator
                // group above.
                _disqualify_because("member-operator-unresolved");

                return;
            fi

            let member_symbol = operand_type.find_member(name);

            // A member hidden from operator resolution is never what an
            // operator expression calls, so following its call edge would
            // bound the enclosing function by a method it cannot invoke.
            //
            // Soundness rests on this matching `COMPILE_OPERATORS`, which
            // discards the same members when it gathers candidates. Both
            // ask `HIDDEN_OPERATOR_MEMBERS`, so the two cannot drift: the
            // operand ends up bounded by the operator that really runs,
            // which for these types is an innate already classified by
            // `STORE_FREE_INNATES`.
            //
            // A group is skipped only when every function in it is hidden,
            // so a same-named user overload is still bounded as before.
            if member_symbol? /\ !HIDDEN_OPERATOR_MEMBERS.is_hidden(member_symbol) then
                _add_callee_edges(member_symbol);
            fi
        si

        // ==== reads ====

        visit(identifier: Expressions.IDENTIFIER) is
            if !_current? then
                return;
            fi

            // an unresolvable bare name is either an error compile-
            // expressions will report or a contextual load (a unit
            // variant); neither can store
            _classify_member_read(try_find(identifier.identifier));
        si

        visit(member: Expressions.MEMBER) is
            if !_current? then
                return;
            fi

            let as_identifier = member.try_copy_as_identifer();

            if as_identifier? then
                let symbol = try_find(as_identifier);

                if symbol? then
                    _classify_member_read(symbol);
                    return;
                fi
            fi

            let left_type = _typer.try_type(member.left);

            if left_type? then
                let member_symbol = left_type.find_member(member.identifier.name);

                if member_symbol? then
                    _classify_member_read(member_symbol);
                    return;
                fi
            fi

            // untyped receiver: if this member turns out to be a
            // property, its getter could run arbitrary code
            _disqualify_because("member-receiver-untyped");
        si

        visit(index: Expressions.INDEX) is
            if !_current? then
                return;
            fi

            let left_type = _typer.try_type(index.left);

            if !left_type? then
                _disqualify_because("index-receiver-untyped");
                return;
            fi

            if isa Semantic.Types.ARRAY(left_type) then
                // array element read; element stores only occur as
                // assignment targets, which are classified separately
                return;
            fi

            // an indexer read runs the receiver type's get_Item —
            // bound it like any other member call
            _add_callee_edges(left_type.find_member(Semantic.Symbols.INDEXER_NAMES.read));
        si

        visit(recurse: Expressions.RECURSE) is
            if !_current? then
                return;
            fi

            _add_callee(_current_function);
        si

        // ==== type application ====

        // `a.b[X]` where `X` reads as both a type argument and an index
        // expression. Resolve-type-expressions settles the index
        // reading when the type argument fails to resolve, and then the
        // INDEX node it built is walked and classified in its own
        // right, leaving nothing to do here.
        visit(ambiguous: Expressions.AMBIGUOUS_EXPRESSION) is
            if !_current? then
                return;
            fi

            if ambiguous.result == Expressions.AmbiguousExpressionResult.INDEX then
                return;
            fi

            _classify_type_application(ambiguous.result, ambiguous.left, ambiguous.identifier);
        si

        // `a.b[X]` where `X` can only be a type argument. Applying type
        // arguments to a generic type or member is a read, so it
        // classifies exactly as the same member read without them
        // would; a call spelt this way is wrapped in a CALL node, which
        // is classified separately and on its own terms.
        visit(generic_application: Expressions.GENERIC_APPLICATION) is
            if !_current? then
                return;
            fi

            _classify_type_application(
                generic_application.result,
                generic_application.left,
                generic_application.identifier
            );
        si

        _classify_type_application(
            result: Expressions.AmbiguousExpressionResult,
            left: Trees.Expressions.Expression?,
            identifier: Identifiers.Identifier
        ) is
            // Both node kinds walk their receiver only once a later
            // pass has settled what the application applies to, which
            // for every node reaching this pass means not yet. So the
            // receiver has to be walked from here — otherwise a call or
            // an index sitting in it would never be classified at all.
            if result == Expressions.AmbiguousExpressionResult.UNKNOWN /\ left? then
                left.walk(self);
            fi

            if !left? then
                _classify_member_read(try_find(identifier));
                return;
            fi

            // a receiver that is itself a name resolves as one
            // qualified name — the route a namespace-qualified type or
            // a union's variant arrives by. The joined name exists only
            // for this lookup, so its spans are the identifier's own.
            let left_as_identifier = left.try_copy_as_identifer();

            if left_as_identifier? then
                let symbol =
                    try_find(
                        Identifiers.QUALIFIED(
                            identifier.location,
                            left_as_identifier,
                            identifier.name,
                            identifier.location,
                            identifier.right_location
                        )
                    );

                if symbol? then
                    _classify_member_read(symbol);
                    return;
                fi
            fi

            let left_type = _typer.try_type(left);

            if !left_type? then
                _disqualify();
                return;
            fi

            let member_symbol = left_type.find_member(identifier.name);

            if !member_symbol? then
                // untyped or unresolvable member: if it turns out to be
                // a property, its getter could run arbitrary code
                _disqualify();
                return;
            fi

            _classify_member_read(member_symbol);
        si

        // ==== local variable declarations ====

        visit(variable: Variables.VARIABLE) is
            if !_current? then
                return;
            fi

            if variable.want_dispose then
                // `let use` runs dispose() at scope exit. Before
                // compile-expressions the value's type is unknown, so
                // the disposal cannot be bounded; after it, the
                // dispose member resolves like any other callee.
                if !_resolved_mode then
                    _disqualify_because("let-use-dispose");
                    return;
                fi

                let disposed_type = _typer.try_type(variable.initializer);

                if !disposed_type? then
                    _disqualify_because("let-use-dispose-untyped");
                    return;
                fi

                let dispose = disposed_type.find_member("dispose");

                if !dispose? then
                    _disqualify_because("let-use-dispose-unresolved");
                    return;
                fi

                _add_callee_edges(dispose);
            fi

            if variable.is_argument then
                // parameter types come from the symbol; a default
                // value expression is walked as part of this body and
                // classified like any other code
                return;
            fi

            let name = variable.name;

            if !name? then
                return;
            fi

            let symbol = find(name.name);

            if !symbol? \/ !isa Semantic.Symbols.LOCAL_VARIABLE(symbol) then
                return;
            fi

            // An explicitly-declared local carries its type on the
            // declaration node, resolved before this pass. Read it there,
            // not from the symbol: the symbol's `type` field is also
            // written later by compile-expressions inference, so reading
            // it would make the store-free classification depend on
            // whether that later pass has run — it has in an analysis-mode
            // refresh, it has not in a batch build.
            if !isa TypeExpressions.INFER(variable.type_expression) then
                if let declared = _typer.usable(variable.type_expression.type) then
                    _typer.set_local_type(symbol, declared);
                fi

                return;
            fi

            let initializer_type = _typer.try_type(variable.initializer);

            if initializer_type? then
                _typer.set_local_type(symbol, initializer_type);
            fi
        si

        // An assert's condition and message classify like any other
        // code as the walk reaches them; the construct-and-throw
        // machinery a failing assert runs is compiler-synthesised —
        // it allocates a fresh exception and stores nothing that
        // existed before it, so even a caller that catches the
        // failure observes an unchanged heap.
        visit(`assert: Statements.ASSERT) is si
        visit(assert_in: Expressions.ASSERT_IN) is si

        // Interpolation formats each fragment by calling to_string
        // on it. When a fragment's static type is known, that
        // dispatch is bounded like any other member call — the
        // fixpoint checks the type's to_string and every override a
        // call could reach; primitive and object to_string bodies
        // are trusted imports. An untyped fragment, or one with a
        // format specifier (which selects a different, culture-aware
        // formatting path), cannot be bounded.
        visit(interpolation: Expressions.STRING_INTERPOLATION) is
            if !_current? then
                return;
            fi

            for fragment in interpolation.values do
                if fragment.is_expression then
                    if fragment.format? then
                        _disqualify_because("interpolation-format");
                        return;
                    fi

                    let fragment_type = _typer.try_type(fragment.expression);

                    if !fragment_type? then
                        _disqualify_because("interpolation-fragment-untyped");
                        return;
                    fi

                    _add_callee_edges(fragment_type.find_member("to_string"));
                fi
            od
        si

        // ==== innate bodies ====

        visit(block: Bodies.INNATE) is
            if !_current? then
                return;
            fi

            if !STORE_FREE_INNATES.is_store_free(block.name) then
                _disqualify_because("innate-not-store-free");
            fi
        si

        // ==== audited-harmless node kinds ====
        //
        // Everything below either has no effect of its own (its
        // children are classified independently as the walk reaches
        // them) or cannot occur in an executable position.

        visit(identifier: Identifiers.Identifier) is si
        visit(identifier: Identifiers.QUALIFIED) is si
        visit(modifier: Modifiers.Modifier) is si
        visit(modifiers: Modifiers.LIST) is si
        visit(pragma: Pragmas.PRAGMA) is si
        visit(pragma: Statements.PRAGMA) is si

        visit(type_expression: TypeExpressions.TypeExpression) is si
        visit(type_expression: TypeExpressions.INFER) is si
        visit(structured: TypeExpressions.Structured) is si
        visit(array: TypeExpressions.ARRAY_) is si
        visit(pointer: TypeExpressions.POINTER) is si
        visit(optional: TypeExpressions.OPTIONAL) is si
        visit(reference: TypeExpressions.REFERENCE) is si
        visit(member: TypeExpressions.MEMBER) is si
        visit(named: TypeExpressions.NAMED) is si
        visit(types: TypeExpressions.LIST) is si
        visit(generic: TypeExpressions.GENERIC) is si
        visit(function: TypeExpressions.FUNCTION) is si
        visit(functions: TypeExpressions.FUNCTION_GROUP) is si
        visit(tuple: TypeExpressions.TUPLE) is si
        visit(element: TypeExpressions.NAMED_TUPLE_ELEMENT) is si
        visit(element: TypeExpressions.UNDEFINED) is si
        visit(constraint: TypeExpressions.TYPE_PARAMETER_CONSTRAINT) is si

        visit(literal: Expressions.Literals.Literal) is si
        visit(`string: Expressions.Literals.STRING) is si
        visit(integer: Expressions.Literals.INTEGER) is si
        visit(float: Expressions.Literals.FLOAT) is si
        visit(character: Expressions.Literals.CHARACTER) is si
        visit(boolean: Expressions.Literals.BOOLEAN) is si
        visit(none: Expressions.Literals.NONE) is si

        visit(`null: Expressions.NULL) is si
        visit(`self: Expressions.SELF) is si
        visit(`super: Expressions.SUPER) is si
        visit(`cast: Expressions.CAST) is si
        visit(`isa: Expressions.ISA) is si
        visit(`isa: Expressions.TYPEOF) is si
        visit(`default: Expressions.DEFAULT) is si
        visit(has_value: Expressions.HAS_VALUE) is si
        visit(unwrap: Expressions.UNWRAP) is si
        visit(tuple: Expressions.TUPLE) is si
        visit(variable: Expressions.TUPLE_ELEMENT) is si
        visit(sequence: Expressions.SEQUENCE) is si
        visit(list: Expressions.LIST) is si
        visit(variable: Expressions.VARIABLE) is si
        visit(statement: Expressions.STATEMENT) is si
        visit(block: Expressions.VAL_BLOCK) is si
        visit(member: Expressions.EXPLICIT_SPECIALIZATION) is si

        // In resolved mode the disposal is bounded per variable, from
        // the initializer's compiled type - see the want_dispose case
        // in visit(variable) - so the statement-level catch-alls only
        // fire when the type was unknowable.
        visit(statement: Expressions.LET_IN) is
            if statement.want_dispose /\ !_resolved_mode then
                _disqualify_because("let-in-dispose");
            fi

            leave_scope(statement);
        si

        visit(left: Trees.Expressions.SIMPLE_LEFT_EXPRESSION) is si
        visit(destructure_left: Trees.Expressions.DESTRUCTURING_LEFT_EXPRESSION) is si

        visit(left: Trees.Variables.SIMPLE_VARIABLE_LEFT) is si
        visit(destructure_left: Trees.Variables.DESTRUCTURING_VARIABLE_LEFT) is si
        visit(left: Trees.Variables.LITERAL_VARIABLE_LEFT) is si
        visit(variables: Variables.LIST) is si

        visit(statements: Statements.LIST) is si
        visit(expression: Statements.EXPRESSION) is si
        visit(`return: Statements.RETURN) is si
        visit(`throw: Statements.THROW) is si
        visit(`if: Statements.IF) is si
        visit(`break: Statements.BREAK) is si
        visit(`continue: Statements.CONTINUE) is si
        visit(rb: Statements.REFUTABLE_BINDING) is si

        visit(l: Statements.LET) is
            if l.want_dispose /\ !_resolved_mode then
                _disqualify_because("let-dispose");
            fi
        si

        visit(if_branch: Statements.IF_BRANCH) is
            leave_scope(if_branch);
        si

        visit(`case: Statements.CASE) is
            leave_scope(`case);
        si

        visit(case_match: Statements.CASE_MATCH) is
            leave_scope(case_match);
        si

        visit(`try: Statements.TRY) is
            leave_scope(`try);
        si

        visit(`catch: Statements.CATCH) is
            leave_scope(`catch);
        si

        visit(`do: Statements.DO) is
            leave_scope(`do);
        si

        visit(labelled: Statements.LABELLED) is
        si

        visit(expression: Bodies.EXPRESSION) is
            leave_scope(expression);
        si

        visit(block: Bodies.BLOCK) is
            leave_scope(block);
        si

        // a bodiless declaration stores nothing; whether calls to it
        // are safe is decided by its overriders through the fixpoint
        visit(block: Bodies.NULL) is si
    si
si
