namespace Syntax.Process is
    use Pair = Collections.KeyValuePair

    use Ghul.Pipes

    // Which of the names in scope can lead a `|>` call.
    //
    // `subject |> f(rest)` is `f(subject, rest)`, so the useful names are
    // those that can take `subject` as their first argument: a function or
    // a function-typed value whose first parameter accepts it, a type with
    // a constructor or a static function that does, and a namespace, which
    // is a prefix rather than a call and so carries no shape to judge.
    // Every other name in scope - a local of ordinary type, a type whose
    // members take something else, a statement keyword - can only be the
    // start of something that is not a call, and a whole-scope dump of
    // them is what this replaces.
    //
    // The judgement is deliberately generous where it cannot be exact: a
    // generic function's first parameter mentions type parameters that
    // inference has not yet pinned, so it is offered rather than judged,
    // and a subject whose own type is unknown offers everything callable.
    class THREAD_FIRST_CANDIDATE_FILTER is
        init() is si

        // Drop from `candidates` every name that cannot lead a `|>` call
        // over a subject of type `subject_type`. A null subject type means
        // the subject did not compile, and then only the shapeless test
        // applies: keep what is callable at all.
        apply(
            candidates: Collections.MAP[string, Semantic.Symbols.Symbol],
            subject_type: Semantic.Types.Type?
        ) -> Collections.MAP[string, Semantic.Symbols.Symbol] is
            let kept = Collections.MAP[string, Semantic.Symbols.Symbol]()

            for pair in candidates do
                if _is_candidate(pair.value, subject_type) then
                    kept.add(pair.key, pair.value)
                fi
            od

            return kept
        si

        _is_candidate(symbol: Semantic.Symbols.Symbol, subject_type: Semantic.Types.Type?) -> bool is
            if symbol.completion_kind == Semantic.Symbols.CompletionKind.MODULE then
                return true
            fi

            if let group = cast Semantic.Symbols.FUNCTION_GROUP?(symbol) then
                return _group_accepts(group, subject_type)
            fi

            if _accepts_as_function_value(symbol, subject_type) then
                return true
            fi

            return _has_threadable_member(symbol, subject_type)
        si

        // A type is a prefix for one of its own constructors or static
        // functions, so it stays only when one of those could take the
        // subject. Instance members are not reachable this way - `T.m()`
        // needs a receiver the `|>` does not supply.
        _has_threadable_member(symbol: Semantic.Symbols.Symbol, subject_type: Semantic.Types.Type?) -> bool is
            if !isa Semantic.Symbols.Classy(symbol) then
                return false
            fi

            let members = Collections.MAP[string, Semantic.Symbols.Symbol]()

            symbol.find_member_matches("", members)

            for pair in members do
                if let group = cast Semantic.Symbols.FUNCTION_GROUP?(pair.value) then
                    for f in group.functions do
                        if (!f.is_instance \/ f.is_constructor) /\ _accepts(f, subject_type) then
                            return true
                        fi
                    od
                fi
            od

            return false
        si

        _group_accepts(group: Semantic.Symbols.FUNCTION_GROUP, subject_type: Semantic.Types.Type?) -> bool is
            for f in group.functions do
                if _accepts(f, subject_type) then
                    return true
                fi
            od

            return false
        si

        _accepts(f: Semantic.Symbols.Function, subject_type: Semantic.Types.Type?) -> bool is
            if f.is_internal \/ f.arguments.count == 0 then
                return false
            fi

            // The first parameter of a generic function is written in terms
            // of type parameters a call would infer, so there is nothing
            // settled to test it against here.
            if !subject_type? \/ f.generic_arguments.count > 0 then
                return true
            fi

            return f.arguments[0].is_assignable_from(subject_type)
        si

        // A variable, field or property holding a function is callable
        // under its own name, so it is judged on that function's first
        // parameter exactly as a declared function is.
        _accepts_as_function_value(symbol: Semantic.Symbols.Symbol, subject_type: Semantic.Types.Type?) -> bool is
            if !isa Semantic.Types.Typed(symbol) then
                return false
            fi

            let type = (cast Semantic.Types.Typed(symbol)).type

            if !type? \/ !type.is_function \/ type.arguments.count < 2 then
                return false
            fi

            if !subject_type? then
                return true
            fi

            return type.arguments[0].is_assignable_from(subject_type)
        si
    si
si
