namespace Syntax.Process is
    use Trees;

    // Tracks the `IL.stub`, `KEEP` and `INTRINSIC_ATTRIBUTE` pragma scopes a
    // tree walk is currently nested inside: `enter` on the way in, `leave` on
    // the way out. Several passes need to know whether the node being walked
    // sits inside such a scope, so each visitor delegates here rather than
    // reimplementing the enter / leave bookkeeping.
    class PRAGMA_SCOPE_STACK is
        _stub_depth: int;
        _keep_depth: int;
        _intrinsic_operations: Collections.LIST[string];

        in_stub: bool => _stub_depth > 0;
        in_keep: bool => _keep_depth > 0;

        // The operation named by the innermost enclosing
        // `INTRINSIC_ATTRIBUTE`, or null outside one.
        intrinsic_operation: string? =>
            if _intrinsic_operations.count > 0 then
                _intrinsic_operations[_intrinsic_operations.count - 1]
            else
                null
            fi;

        is_balanced: bool => _stub_depth == 0 /\ _keep_depth == 0 /\ _intrinsic_operations.count == 0;

        init() is
            _intrinsic_operations = Collections.LIST[string]();
        si

        enter(pragma: Pragmas.PRAGMA) is
            _adjust(pragma, 1);
        si

        leave(pragma: Pragmas.PRAGMA) is
            _adjust(pragma, -1);
        si

        _adjust(pragma: Pragmas.PRAGMA, delta: int) is
            let name = pragma.name.to_string();

            if name =~ "IL.stub" then
                _stub_depth = _stub_depth + delta;
            elif name =~ "KEEP" then
                _keep_depth = _keep_depth + delta;
            elif name =~ "INTRINSIC_ATTRIBUTE" then
                if let operation = pragma.try_get_string_literal_at(0) then
                    if delta > 0 then
                        _intrinsic_operations.add(operation);
                    else
                        _intrinsic_operations.remove_at(_intrinsic_operations.count - 1);
                    fi
                fi
            fi
        si
    si
si
