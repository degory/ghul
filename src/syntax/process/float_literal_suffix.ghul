namespace Syntax.Process is
    // Which type a fractional literal's trailing suffix selects.
    enum FloatLiteralKind is
        SINGLE,
        DOUBLE,
        DECIMAL,
    si

    // The type suffix of a fractional literal: `s` single, `d` double,
    // `m` decimal, and double where none is written.
    //
    // The lexer leaves the literal exactly as it was written, so an
    // absent suffix is absent here too and every reader has to apply
    // the default itself. Both of them resolve it through this class,
    // so the compile path and the analysis fast path cannot disagree
    // about what `1.5` is.
    //
    // The suffix is always the last character: an exponent's digits
    // follow `e`, so nothing else can end the literal.
    class FLOAT_LITERAL_SUFFIX is
        kind(value_string: string) -> FloatLiteralKind static is
            if value_string.length == 0 then
                return FloatLiteralKind.DOUBLE
            fi

            let last = value_string[value_string.length - 1]

            if last == 's' \/ last == 'S' then
                return FloatLiteralKind.SINGLE
            elif last == 'm' \/ last == 'M' then
                return FloatLiteralKind.DECIMAL
            fi

            return FloatLiteralKind.DOUBLE
        si

        has_suffix(value_string: string) -> bool static is
            if value_string.length == 0 then
                return false
            fi

            let last = value_string[value_string.length - 1]

            return
                last == 's' \/ last == 'S' \/
                last == 'd' \/ last == 'D' \/
                last == 'm' \/ last == 'M'
        si

        // The literal with its suffix removed, which is the value it
        // denotes and the string every back end should read.
        strip(value_string: string) -> string static =>
            if has_suffix(value_string) then
                value_string.substring(0, value_string.length - 1)
            else
                value_string
            fi
    si
si
