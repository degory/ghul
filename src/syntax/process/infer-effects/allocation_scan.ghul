namespace Syntax.Process is
    use Logging
    use Trees

    // Decides whether a function body allocates by itself: whether any
    // value compiled for one of its expressions builds an object, an
    // array, a string, a closure or a box. Calls are not judged here -
    // what a callee allocates is the allocation-free solve's question -
    // but the values passed to them are, since a conversion boxing an
    // argument is a value of the call rather than of any expression.
    //
    // Conservative by construction: a value kind not named below
    // allocates, so a new kind is assumed to until it is audited here.
    class ALLOCATION_SCAN: DefaultVisitor is
        _allocates: bool

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES
        )
        is
            super.init(logger, symbol_table, namespaces)
        si

        // Whether `body` allocates. A missing body, or a walk that
        // fails, answers true.
        allocates(body: Bodies.Body?) -> bool is
            if !body? then
                return true
            fi

            _allocates = false

            let mark = mark_scope_stack()

            try
                body.walk(self)
            catch ex: System.Exception
                _allocates = true
            yrt

            release_scope_stack(mark)

            return _allocates
        si

        visit_default(node: Node) is
            if _allocates then
                return
            fi

            if let expression: Expressions.Expression = node then
                if value_allocates(expression.value) then
                    _allocates = true
                fi
            fi
        si

        // Creating a closure allocates it; the literal's body runs only
        // when the closure is invoked, and is judged as its own function.
        pre(function: Expressions.FUNCTION) -> bool is
            _allocates = true

            return true
        si

        visit(function: Expressions.FUNCTION) is si

        value_allocates(value: IR.Values.Value?) -> bool static is
            if !value? then
                return false
            fi

            if let view: IR.Values.NARROW_VIEW = value then
                return value_allocates(view.underlying)
            fi

            if let call: IR.Values.Call.INSTANCE = value then
                return value_allocates(call.from) \/ any_allocates(call.arguments)
            fi

            if let call: IR.Values.Call.STRUCT = value then
                return value_allocates(call.from) \/ any_allocates(call.arguments)
            fi

            if let call: IR.Values.Call.STATIC = value then
                return any_allocates(call.arguments)
            fi

            if let call: IR.Values.Call.GLOBAL = value then
                return any_allocates(call.arguments)
            fi

            // An innate producing a value type computes it in place; one
            // producing a reference may be building it.
            if let call: IR.Values.Call.INNATE = value then
                return
                    !call.type.is_value_type \/
                    value_allocates(call.from) \/
                    any_allocates(call.arguments)
            fi

            if let load: IR.Values.Load.SYMBOL = value then
                return value_allocates(load.from)
            fi

            if
                isa IR.Values.Load.REFERENCE_SELF(value) \/
                isa IR.Values.Load.VALUE_SELF(value) \/
                isa IR.Values.Load.OUTER_SELF(value) \/
                isa IR.Values.Literal.NUMBER(value) \/
                isa IR.Values.Literal.STRING(value) \/
                isa IR.Values.NULL(value) \/
                isa IR.Values.DEFAULT(value)
            then
                return false
            fi

            if let arithmetic: IR.Values.ARITHMETIC = value then
                return any_allocates(arithmetic.operands)
            fi

            if let compare: IR.Values.COMPARE = value then
                return value_allocates(compare.left) \/ value_allocates(compare.right)
            fi

            if let negation: IR.Values.NOT = value then
                return value_allocates(negation.value)
            fi

            if let compare: IR.Values.COMPARE_ORDER_TO_ZERO = value then
                return value_allocates(compare.value)
            fi

            if let test: IR.Values.HAS_VALUE = value then
                return value_allocates(test.value)
            fi

            if let test: IR.Values.ISA = value then
                return value_allocates(test.value)
            fi

            if let conversion: IR.Values.CAST = value then
                return value_allocates(conversion.value)
            fi

            return true
        si

        any_allocates(values: Collections.List[IR.Values.Value]) -> bool static is
            for value in values do
                if value_allocates(value) then
                    return true
                fi
            od

            return false
        si
    si
si
