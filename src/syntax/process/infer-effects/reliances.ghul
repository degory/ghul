namespace Syntax.Process is
    use Logging.Logger;
    use LOCATION = Source.LOCATION;
    use Symbol = Semantic.Symbols.Symbol;
    use Function = Semantic.Symbols.Function;

    // Provenance stamped on a compiled value that was loaded through
    // a flow-narrowing fact while the fact still had call crossings
    // the inline tiers could not discharge. The crossing lists are
    // snapshot at load time — a call walked after the load cannot
    // change a value already loaded, so the snapshot is exact.
    // Nothing is reported at the load: whether the fact was *relied
    // on* is a property of each consumption of the value, judged by
    // JUDGE_RELIANCES after the effect relations are solved. A null
    // crossing list means that fact kind either was not applied to
    // the load or had every crossing inline-discharged.
    class RELIANCE_PROVENANCE(
        location: LOCATION,
        name: string,
        target: Symbol?,
        path: ACCESS_PATH?,
        wide_type: Semantic.Types.Type,
        // which fact kinds were in force at the load - a consumption
        // can only lean on a fact that was actually applied
        narrows_type: bool,
        asserts_presence: bool,
        narrow_crossings: Collections.LIST[CROSSING]?,
        presence_crossings: Collections.LIST[CROSSING]?,
        // some getter the fact reads through is not proven store-free
        // by the symbol-local tier; a relying consumption must get the
        // proof from the solved effect relations or be an error
        getter_unproven: bool
    );


    // One heap fact that was live over one call, recorded while the
    // environment still held it because the environment is gone by the
    // time the effect relations can say whether the callee left the
    // fact alone. `detail` is rendered at the call for the same reason:
    // the narrowed and declared types are only in scope there.
    class KILL_CANDIDATE(
        crossing: CROSSING,
        target: Symbol?,
        path: ACCESS_PATH?,
        is_presence: bool,
        detail: string
    );


    // The discharge rules the consumption judge (JUDGE_RELIANCES)
    // asks of a stamped value's crossings and getters, plus the
    // volume counters the study summary reports: how many heap-fact
    // loads were consulted for provenance, how many actually got
    // stamped, and how many consumptions were reported.
    class RELIANCES is
        loads_consulted: int public static;
        loads_stamped: int public static;
        consumptions_reported: int public static;

        // Facts live over a call in a file the client has open, held
        // per file until the effect relations are solved and each can
        // be asked whether the callee left it alone. Only the hint gate
        // populates this, so batch compilation collects nothing.
        //
        // Held state described by source text that can be re-walked, so
        // it is dropped exactly where a file's other expression-level
        // output is: an analysis-mode recompile of one file's
        // expressions clears the file's entry before re-walking it, and
        // a build clears every entry. Without that a walk whose round
        // is never judged - the query-miss recompile - would leave
        // entries for a later round to report twice, and at the
        // locations the text had before the edit.
        //
        // A body the compile-expressions retry loop walks more than
        // once re-notes its calls' candidates on every walk; the
        // report collapses those repeats by site when it renders.
        _kill_candidates: Collections.MAP[string, Collections.LIST[KILL_CANDIDATE]] static;

        init() static is
            _kill_candidates = Collections.MAP[string, Collections.LIST[KILL_CANDIDATE]]();
        si

        note_kill_candidate(candidate: KILL_CANDIDATE) static is
            let path = candidate.crossing.location.file_name;

            if !_kill_candidates.contains_key(path) then
                _kill_candidates[path] = Collections.LIST[KILL_CANDIDATE]();
            fi

            _kill_candidates[path].add(candidate);
        si

        clear_kill_candidates_for(path: string) static is
            _kill_candidates.remove(path);
        si

        clear_kill_candidates() static is
            _kill_candidates.clear();
        si

        // Hand over what has been recorded since the last call and
        // start fresh: the caller reports against the relations just
        // solved, and the next round records its own.
        take_kill_candidates() -> Collections.List[KILL_CANDIDATE] static is
            let taken = Collections.LIST[KILL_CANDIDATE]();

            for entry in _kill_candidates do
                for candidate in entry.value do
                    taken.add(candidate);
                od
            od

            _kill_candidates.clear();

            return taken;
        si

        reset_counters() static is
            loads_consulted = 0;
            loads_stamped = 0;
            consumptions_reported = 0;
        si

        // Whether a call the solved relations cannot show harmless
        // was crossed while this load's fact was live.
        //
        // Only crossings are consulted. A fact read through a getter
        // the relations cannot back is unproven too; no crossing
        // marks it, because the hazard is the getter's own re-read,
        // not a call between test and use. The mark lives at the
        // test site instead - the unbacked-fact report retracts the
        // introduction inlay there and leaves a hint - and a use
        // that leans on the fact names the getter as an error.
        //
        // False while nothing is solved: not-yet-known is not the same
        // answer as unproven, and only one of them is worth acting on.
        has_undischarged_crossing(provenance: RELIANCE_PROVENANCE) -> bool static is
            if !EFFECTS.is_solved then
                return false;
            fi

            let presence = provenance.presence_crossings;

            if presence? /\ _first_undischarged(presence, provenance, true)? then
                return true;
            fi

            let narrow = provenance.narrow_crossings;

            return narrow? /\ _first_undischarged(narrow, provenance, false)?;
        si

        _first_undischarged(
            crossings: Collections.LIST[CROSSING],
            provenance: RELIANCE_PROVENANCE,
            is_presence: bool
        ) -> CROSSING? static is
            for crossing in crossings do
                if !crossing_discharged(crossing, provenance.target, provenance.path, is_presence) then
                    return crossing;
                fi
            od

            return null;
        si


        // The getter's own call over a presence fact it backs: a
        // monotone memoiser's answer can only move from absent to
        // present, so the presence fact survives the re-read its own
        // getter performs. Type facts stay on the ordinary route - a
        // rewrite while absent can change the runtime type a wider
        // member holds.
        _is_presence_monotone_self_call(
            callee: Function,
            target: Symbol?,
            path: ACCESS_PATH?
        ) -> bool static is
            let property: Semantic.Symbols.Property? mut = null;

            if target? /\ isa Semantic.Symbols.Property(target) then
                property = cast Semantic.Symbols.Property?(target);
            elif path? /\ path.members.count > 0 then
                let last = path.members[path.members.count - 1];

                if isa Semantic.Symbols.Property(last) then
                    property = cast Semantic.Symbols.Property?(last);
                fi
            fi

            if !property? then
                return false;
            fi

            let getter = property.read_function;

            if !getter? then
                return false;
            fi

            return
                getter.root_specialized_from == callee.root_specialized_from /\
                MONOTONE_MEMOISER.is_presence_monotone(property);
        si


        // The first property a provenance's fact reads through whose
        // getter is self-unstable for the fact — its own call,
        // treated as an ordinary crossing over the fact, is not
        // discharged by the solved effect relations — or null when
        // every getter backs the fact. No special case: this is the
        // same question asked of any call crossed over a property
        // fact, so a store-free, passthrough or write-only getter
        // backs both kinds, a monotone memoiser backs presence only,
        // and a getter that writes what its closure reads backs
        // neither.
        first_unproven_getter(target: Symbol?, path: ACCESS_PATH?, for_presence: bool) -> Symbol? static is
            if target? then
                if _self_unstable_getter(target, target, null, for_presence) then
                    return target;
                fi

                return null;
            fi

            if path? then
                if _self_unstable_getter(path.root, null, path, for_presence) then
                    return path.root;
                fi

                for m in path.members do
                    if _self_unstable_getter(m, null, path, for_presence) then
                        return m;
                    fi
                od
            fi

            return null;
        si

        // Whether `m` is a property whose getter does not back a
        // fact read through it: the getter's own call, asked of the
        // fact as any crossing is. Non-property hops back every fact.
        _self_unstable_getter(m: Symbol, target: Symbol?, path: ACCESS_PATH?, for_presence: bool) -> bool static is
            if !isa Semantic.Symbols.Property(m) then
                return false;
            fi

            let getter = (cast Semantic.Symbols.Property(m)).read_function;

            if !getter? then
                return false;
            fi

            return !crossing_discharged(CROSSING(m.location, getter), target, path, for_presence);
        si

        // The unbacked-at-formation classification: some getter the
        // fact reads through is unproven for a fact kind the stamped
        // load leans on. Such a fact is dead at its first re-read —
        // every use of the path re-invokes the getter, and that call
        // is an undischarged crossing — so every surface reports the
        // wide shape for it.
        unbacked_at_formation(provenance: RELIANCE_PROVENANCE) -> bool static is
            if !provenance.getter_unproven \/ !EFFECTS.is_solved then
                return false;
            fi

            if provenance.narrows_type /\ first_unproven_getter(provenance.target, provenance.path, false)? then
                return true;
            fi

            return provenance.asserts_presence /\ first_unproven_getter(provenance.target, provenance.path, true)?;
        si

        // A fact read through a getter survives a crossing when the
        // callee provably writes nothing the getters read: the
        // callee's write set is disjoint from the union of the fact's
        // hop symbols and every getter hop's read closure, elements
        // included. Anything unboundable on either side declines.
        _getter_fact_discharged(callee: Function, target: Symbol?, path: ACCESS_PATH?) -> bool static is
            let reads = Collections.SET[Symbol]();
            let reads_elements mut = false;

            if target? then
                if !_collect_hop_reads(target, reads) then
                    return false;
                fi

                reads_elements = _hop_reads_elements(target);
            fi

            if path? then
                if !_collect_hop_reads(path.root, reads) then
                    return false;
                fi

                reads_elements = reads_elements \/ _hop_reads_elements(path.root);

                for m in path.members do
                    if !_collect_hop_reads(m, reads) then
                        return false;
                    fi

                    reads_elements = reads_elements \/ _hop_reads_elements(m);
                od
            fi

            if reads_elements /\ EFFECTS.may_write_elements(callee) then
                return false;
            fi

            for m in reads do
                if EFFECTS.may_write(callee, m) then
                    return false;
                fi
            od

            return true;
        si

        // Add the hop symbol itself, and - when it is a property -
        // its getter's read closure. False when the closure cannot be
        // bounded.
        _collect_hop_reads(m: Symbol, reads: Collections.SET[Symbol]) -> bool static is
            reads.add(m.root_specialized_from);

            if !isa Semantic.Symbols.Property(m) then
                return true;
            fi

            let getter = (cast Semantic.Symbols.Property(m)).read_function;

            if !getter? then
                return false;
            fi

            let closure = EFFECTS.getter_read_closure(getter);

            if !closure? then
                return false;
            fi

            for r in closure do
                reads.add(r);
            od

            return true;
        si

        _hop_reads_elements(m: Symbol) -> bool static is
            if !isa Semantic.Symbols.Property(m) then
                return false;
            fi

            return EFFECTS.getter_reads_elements((cast Semantic.Symbols.Property(m)).read_function);
        si

        // Whether `crossing`'s callee provably left the fact alone.
        // A fact read through a getter — a property target, or a path
        // with a getter hop — needs a callee that stores nothing at
        // all, since a getter can read anything a store changed. A
        // fields-only fact needs less: a presence fact survives any
        // callee that cannot assign a possibly-absent value to its
        // member, and a type narrow survives any callee that cannot
        // store to it; for a path, every hop below the last is held
        // to may-write, since rewriting a prefix redirects the path
        // to a different object entirely.

        // Shared by the deferred judge above and the consumption judge
        // (JUDGE_RELIANCES): whether the crossing's callee provably
        // left the identified fact alone.
        crossing_discharged(crossing: CROSSING, target: Symbol?, path: ACCESS_PATH?, is_presence: bool) -> bool static is
            let callee = crossing.callee;

            if !callee? then
                return false;
            fi

            let getter =
                (target? /\ isa Semantic.Symbols.Property(target)) \/
                (path? /\ path.has_getter_hop);

            if callee.is_store_free \/ EFFECTS.is_store_free(callee) then
                return true;
            fi

            // A constructor that writes only its own fresh receiver's
            // state is harmless to every fact established before the
            // construction — including one read through a getter,
            // since nothing pre-existing can reach the fresh object.
            if callee.is_constructor /\ EFFECTS.constructs_store_free(callee) then
                return true;
            fi

            if getter then
                if is_presence /\ _is_presence_monotone_self_call(callee, target, path) then
                    return true;
                fi

                return _getter_fact_discharged(callee, target, path);
            fi

            if callee.writes_only_receiver_interior then
                return true;
            fi

            if target? then
                if is_presence then
                    return !EFFECTS.may_null(callee, target);
                fi

                return !EFFECTS.may_write(callee, target);
            fi

            if path? then
                if isa Semantic.Symbols.Field(path.root) /\ EFFECTS.may_write(callee, path.root) then
                    return false;
                fi

                let members = path.members;

                for i in 0..members.count do
                    let hop = members[i];

                    if i < members.count - 1 then
                        if EFFECTS.may_write(callee, hop) then
                            return false;
                        fi
                    elif is_presence then
                        return !EFFECTS.may_null(callee, hop);
                    else
                        return !EFFECTS.may_write(callee, hop);
                    fi
                od

                return true;
            fi

            return false;
        si
    si
si
