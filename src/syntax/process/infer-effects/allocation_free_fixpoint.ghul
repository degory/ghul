namespace Syntax.Process is
    use Function = Semantic.Symbols.Function

    // Solves which functions provably allocate nothing, on every path
    // a call bound to them can take: the body allocates nothing itself,
    // every callee and every override is allocation-free in turn, and
    // nothing outside the compilation can override it. Only bodies the
    // walk fully bounded qualify, so a function whose facts were
    // disqualified for any reason allocates as far as this is
    // concerned, and so does anything without facts - an imported
    // member included. Mutual recursion between clean bodies is never
    // demoted, so it ends up allocation-free.
    class ALLOCATION_FREE_FIXPOINT is
        init() is si

        solve(facts: Collections.MutableMap[Function, STORE_FREE_FACTS]) -> Collections.SET[Function] is
            let shadow = STORE_FREE_FIXPOINT()

            let allocation_free = Collections.SET[Function]()
            let dependencies = Collections.MAP[Function, Collections.List[Function]]()

            for entry in facts do
                let function = entry.key
                let function_facts = entry.value

                if function_facts.is_disqualified \/ function_facts.allocates \/ shadow.is_openly_dispatchable(function) then
                    continue
                fi

                if let depends_on = _dependencies(function, function_facts) then
                    allocation_free.add(function)
                    dependencies[function] = depends_on
                fi
            od

            // Who depends on whom, so a demotion revisits only the
            // functions it can affect.
            let dependants = Collections.MAP[Function, Collections.LIST[Function]]()

            for entry in dependencies do
                for dependency in entry.value do
                    if !dependants.contains_key(dependency) then
                        dependants[dependency] = Collections.LIST[Function]()
                    fi

                    dependants[dependency].add(entry.key)
                od
            od

            let pending = Collections.LIST[Function]()

            for function in allocation_free do
                pending.add(function)
            od

            while pending.count > 0 do
                let function = pending[pending.count - 1]

                pending.remove_at(pending.count - 1)

                if !allocation_free.contains(function) \/ _all_free(dependencies[function], allocation_free) then
                    continue
                fi

                allocation_free.remove(function)

                if dependants.contains_key(function) then
                    for dependant in dependants[function] do
                        if allocation_free.contains(dependant) then
                            pending.add(dependant)
                        fi
                    od
                fi
            od

            return allocation_free
        si

        _all_free(functions: Collections.List[Function], allocation_free: Collections.SET[Function]) -> bool static is
            for function in functions do
                if !allocation_free.contains(function) then
                    return false
                fi
            od

            return true
        si

        // Everything a call bound to `function` can run: its callees,
        // the constructors it runs, and its overrides, or null where
        // some of that cannot be judged. An accessor's overrides are
        // linked on its property rather than on the accessor itself.
        _dependencies(function: Function, facts: STORE_FREE_FACTS) -> Collections.List[Function]? is
            if facts.is_indexer_accessor then
                return null
            fi

            let result = Collections.LIST[Function]()

            for callee in facts.callees do
                result.add(callee)
            od

            for callee in facts.construction_callees do
                result.add(callee)
            od

            let overriders = function.overriders

            if overriders? then
                for overrider in overriders do
                    if let overrider_function: Function = overrider then
                        result.add(overrider_function)
                    else
                        return null
                    fi
                od
            fi

            if let property = facts.property then
                if !_add_accessor_overriders(function, property, result) then
                    return null
                fi
            fi

            return result
        si

        _add_accessor_overriders(function: Function, property: Semantic.Symbols.Property, into: Collections.LIST[Function]) -> bool is
            let read_function = property.read_function
            let is_read = read_function? /\ read_function.root_specialized_from == function.root_specialized_from

            let overriders = property.overriders

            if !overriders? then
                return true
            fi

            for overrider in overriders do
                let overrider_property = cast Semantic.Symbols.Property?(overrider)

                if !overrider_property? then
                    return false
                fi

                let accessor = if is_read then overrider_property.read_function else overrider_property.assign_function fi

                if !accessor? then
                    return false
                fi

                let root = cast Function?(accessor.root_specialized_from)

                if !root? then
                    return false
                fi

                into.add(root)

                if !_add_accessor_overriders(root, overrider_property, into) then
                    return false
                fi
            od

            return true
        si
    si
si
