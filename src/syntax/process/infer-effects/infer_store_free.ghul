namespace Syntax.Process is
    use System.Exception;

    use Ghul.Pipes;

    use Logging;
    use Trees;

    use Semantic.Types.Type;

    use Function = Semantic.Symbols.Function;
    use Symbol = Semantic.Symbols.Symbol;

    // Facts the body walk gathers for one function, consumed by the
    // finish-time fixpoint.
    class STORE_FREE_FACTS is
        // The body performs a store or an effect the walk cannot
        // bound: an assignment to anything but a local, a call with
        // an unresolvable callee set, disposal, iteration, an
        // untyped interpolation fragment, an await or yield, ...
        is_disqualified: bool public;

        // The same, except a write to the receiver's own instance state
        // does not set it. That write is invisible to every caller when
        // the receiver is an object nothing else can reach yet, which
        // is what both consumers of this bit guarantee: a constructor
        // run by a `NEW`, and a member reached on `self` from inside
        // such a constructor. So it says "writes nothing but the state
        // of the object it is called on", and is only ever read where
        // that object is known to be fresh.
        is_construction_disqualified: bool public;

        // Statically-bounded callees. The function is store-free
        // only if every one of them proves store-free too.
        callees: Collections.MutableList[Function];

        // Callees reached on a receiver that is fresh, or that is the
        // fresh receiver the caller is itself being constructed on: a
        // constructor run by a construction, and the assign accessor
        // of a property written on `self` inside a constructor. Their
        // own-state writes cannot touch a slot any caller holds a fact
        // about, so these are bounded by the construction-store-free
        // classification rather than the strict one.
        construction_callees: Collections.MutableList[Function];

        init() is
            callees = Collections.LIST[Function]();
            construction_callees = Collections.LIST[Function]();
        si

        add_callee(callee: Function) is
            callees.add(callee);
        si

        add_construction_callee(callee: Function) is
            construction_callees.add(callee);
        si
    si

    // The body walk behind the infer-effects pass, run after
    // compile-expressions with the types that pass resolved. Gathers
    // for every function the facts the effect solvers consume — its
    // member writes, nulling writes and reads, its bounded callees,
    // and whether anything in the body defeats bounding — from which
    // solve_effects derives the member-granular effect relations
    // (EFFECTS) and the store-free classification written back onto
    // the symbols. Reads are always harmless; only writes and
    // unboundable calls disqualify. Dispatch is bounded using
    // resolve-overrides' overrider links; a method reachable through
    // an open class or a trait is never store-free, because an
    // override in another assembly could store.
    //
    // Every node kind not explicitly classified below is unsafe via
    // visit_default. When a new node kind is added, it must be
    // explicitly audited here before functions containing it can
    // classify as store-free.
    //
    // This pass never reports diagnostics. It runs on incomplete and
    // incorrect code in analysis mode, where the other passes own
    // finding and reporting every problem; anything suspect here just
    // classifies conservatively.
    class INFER_STORE_FREE: DefaultVisitor is
        _facts: Collections.MutableMap[Function, STORE_FREE_FACTS];
        _current: STORE_FREE_FACTS?;
        _current_function: Function?;

        // The study's record for the function being walked, or null
        // when the study is off. See NARROWING_STUDY.
        _current_record: FUNCTION_EFFECT_FACTS?;

        // Trivially-derivable static types, including the per-function
        // record of locals whose initializer type was derivable.
        _typer: TRIVIAL_EXPRESSION_TYPER;

        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup;

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        )
        is
            super.init(logger, symbol_table, namespaces);

            _typer = TRIVIAL_EXPRESSION_TYPER(symbol_table, innate_symbol_lookup);
            _innate_symbol_lookup = innate_symbol_lookup;
            function_values = FUNCTION_VALUES();

            start_run();
        si

        start_run() is
            _facts = Collections.MAP[Function, STORE_FREE_FACTS]();
            _typer.reset();
            _current = null;
            _current_function = null;
        si

        // The walk must survive incomplete and incorrect code — it
        // runs in analysis mode on whatever the user has half-typed.
        // It reports nothing, ever: broken code is found and
        // diagnosed by the other passes, and an analysis here that
        // cannot complete only means some functions conservatively
        // stay not-store-free. On an exception the symbol-table scope
        // stack is restored to its entry depth so a long-lived
        // analysis process is not poisoned for later passes, and
        // whatever function was mid-walk keeps its disqualification.
        apply(root: Trees.Node) is
            let mark = mark_scope_stack();

            MONOTONE_MEMOISER.clear_file(root.location.file_name);

            _last_walk_failed = false;

            try
                root.walk(self);
            catch ex: Exception
                _disqualify_because("walk-aborted");
                release_scope_stack(mark);

                _last_walk_failed = true;
            yrt

            _current = null;
            _current_function = null;
            _current_record = null;
        si

        // Whether the most recent apply abandoned its walk on an
        // exception. The partial walk's facts stay in this run's union,
        // which is conservative: whatever was mid-walk keeps its
        // disqualification.
        _last_walk_failed: bool;
        last_walk_failed: bool => _last_walk_failed;

        // Read the types compile-expressions resolved rather than
        // deriving trivial static types from declarations — the
        // production setting for the infer-effects pass; off leaves
        // the declared-types-only approximation, which unit fixtures
        // without compiled expressions still use.
        set_resolved_mode(on: bool) is
            _typer.use_resolved = on;
            _resolved_mode = on;

            if on then
                // A fresh round is starting: drop the previous round's
                // local-value record before the walk re-derives it, so
                // the judge that runs after the solve reads only what
                // this round's bodies actually hold.
                function_values.clear();

                // Before the walk, so a call to one of these is a
                // trusted leaf rather than a callee edge that poisons
                // its caller.
                _trust_value_optional_accessors();
            fi
        si

        _resolved_mode: bool;

        // Solve the effect relations over this run's facts and install
        // them for the reliance judge. Called by the infer-effects
        // pass's finish hook, after the resolved-mode walk of every
        // file. A failure leaves the registry cleared, which every
        // query answers conservatively.
        solve_effects() is
            try
                let study = EFFECT_SOLVERS(_facts);

                let sw = System.Diagnostics.Stopwatch.start_new();
                let writes = study.write_sets(false, false);
                let t_w = sw.elapsed_milliseconds;
                let nulls = study.may_null_sets(false, false);
                let t_n = sw.elapsed_milliseconds;
                let solved = study.solve();
                let store_free = solved.store_free;
                let t_s = sw.elapsed_milliseconds;
                let reads = study.read_sets();
                let t_r = sw.elapsed_milliseconds;

                if NARROWING_STUDY.enabled then
                    IO.Std.error.write_line("solve phases: writes {t_w} nulls {t_n - t_w} store-free {t_s - t_n} reads {t_r - t_s}");
                fi

                EFFECTS.install(
                    writes.sets, writes.unbounded,
                    nulls.sets, nulls.unbounded,
                    store_free,
                    solved.constructs_store_free,
                    reads.sets, reads.unbounded, reads.reads_elements, reads.writes_elements);

                // Mark what the solve proved back onto the symbols,
                // where the display surfaces read it. Assigned both
                // ways so a function that stops being provable is
                // unmarked by the next solve rather than staying
                // stale-true.
                for function in _facts.keys do
                    let root = cast Function?(function.root_specialized_from);

                    if root? then
                        root.set_proven_store_free(store_free.contains(root));
                    fi
                od

                if NARROWING_STUDY.enabled then
                    IO.Std.error.write_line(
                        "effects: {writes.sets.count} walked, "
                        "{writes.unbounded.count} write-unbounded, "
                        "{nulls.unbounded.count} null-unbounded, "
                        "{store_free.count} store-free");

                    _complete_records();
                    NARROWING_STUDY.report();
                fi
            catch ex: Exception
                EFFECTS.clear();

                if NARROWING_STUDY.enabled then
                    IO.Std.error.write_line("effects: solve failed: {ex}");
                fi
            yrt

            start_run();
        si

        // Complete each effect record with the solve-side facts the
        // report prints - reporting only, nothing reads these back.
        _complete_records() is
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if !record? then
                    continue;
                fi

                record.is_disqualified = _facts[function].is_disqualified;
                record.callee_count = _facts[function].callees.count;
                record.openly_dispatchable = shadow.is_openly_dispatchable(function);
                record.declared_pure = function.is_declared_pure;

                let overriders = function.overriders;

                let overrider_count mut = 0;

                if overriders? then
                    for overrider in overriders do
                        overrider_count = overrider_count + 1;
                    od
                fi

                record.overrider_count = overrider_count;
            od
        si

        // The value-type optional carriers' accessors get the bit
        // directly: `x?` / `x!` on an `int?`-style slot lower to
        // these at compile-expressions time without appearing as
        // call edges here, and both read a field of a sealed struct
        // — no overrider can exist, so unconditional trust is sound.
        // Without the bit every value-type presence test would count
        // as a possibly-storing call and kill the very facts it
        // establishes.
        _trust_value_optional_accessors() is
            let bool_type = _innate_symbol_lookup.get_bool_type();

            _mark_read_accessors_store_free(_innate_symbol_lookup.get_optional_type(bool_type));
            _mark_read_accessors_store_free(_innate_symbol_lookup.get_maybe_type(bool_type));
        si

        _mark_read_accessors_store_free(type: Semantic.Types.Type?) is
            if !type? then
                return;
            fi

            for name in ["has_value", "value"] do
                let member = type.find_member(name);

                if member? /\ isa Semantic.Symbols.Property(member) then
                    let read_function = (cast Semantic.Symbols.Property(member)).read_function;

                    if read_function? then
                        read_function.mark_declared_pure();
                    fi
                fi
            od
        si

        // Open an effect record for the function about to be walked,
        // classifying its accessor role from the structural links the
        // accessor synthesiser stamped.
        _note_study_function(function: Definitions.FUNCTION, symbol: Function) is
            _current_record = null;

            if !EFFECT_FACTS.collecting /\ !NARROWING_STUDY.enabled then
                return;
            fi

            let raw_name = if function.name? then function.name.name else "" fi;

            // The role is structural: the accessor synthesiser links
            // each accessor to its property or indexer and stamps
            // which half it is, so nothing is inferred back from the
            // accessor's name.
            let role =
                if function.for_indexer? then
                    if function.is_assign_accessor then "index-set" else "index-get" fi
                elif function.for_property? then
                    if function.is_assign_accessor then "set" else "get" fi
                else
                    ""
                fi;

            let owner = symbol.owner;

            EFFECT_FACTS.note_function(
                symbol,
                raw_name,
                if owner? then owner.name else "" fi,
                "{function.location}",
                role);

            _current_record = EFFECT_FACTS.record_for(symbol);

            if _current_record? /\ function.for_property? then
                _current_record.for_auto_property = function.for_property.is_auto_property;
            fi
        si

    si
si
