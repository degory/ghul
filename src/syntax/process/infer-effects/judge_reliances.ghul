namespace Syntax.Process is
    use Logging;
    use Source.LOCATION;
    use Trees;

    use Collections.LIST;

    use Symbol = Semantic.Symbols.Symbol;
    use Function = Semantic.Symbols.Function;
    use Type = Semantic.Types.Type;
    use Value = IR.Values.Value;

    // The consumption judge. Runs after infer-effects has solved the
    // effect relations, walking each body's compiled values: for
    // every consumption of a value stamped with reliance provenance,
    // it first asks whether the consumption leans on the fact at all
    // — a use the un-narrowed type already satisfies asks nothing of
    // it — and only then whether every crossing is discharged by the
    // solved relations and every getter the fact reads through is
    // provably stable. A value that reaches its consumption through
    // `!`, `?.`, `??`, an `isa` test, a refutable pattern or a
    // checked cast carries no provenance, because those re-check at
    // runtime — and the one thing a checked cast does not re-check,
    // the presence its non-optional target assumes, is judged at the
    // cast itself.
    //
    // The consumptions judged are the ones the emitted code would get
    // wrong if the fact were false: an argument or stored value whose
    // slot only the narrowed type satisfies — including a local's
    // initializing store, recorded on the variable-left state rather
    // than an expression node — a return the declared return type
    // would reject wide (block-bodied and arrow-bodied alike), a
    // tuple element whose declared type rejects the wide value, a
    // thrown value the wide type does not make an Exception, the
    // presence a checked cast's target slot assumes, the iterable an
    // iterator resolution ran against, and a dispatch or field access
    // through a receiver that could be null again or of a type that
    // no longer declares the member.
    class JUDGE_RELIANCES: DefaultVisitor is
        // Declared return type of each enclosing function or lambda
        // body, for judging `return` expressions.
        _return_type_stack: Collections.LIST[Type?];

        // One error per stamped load, however many consumptions it
        // flows into.
        _reported: Collections.SET[RELIANCE_PROVENANCE];

        // Crossings that some later load of the fact carries. A
        // crossing outside this set was live over a fact no load
        // downstream goes on to read, so a kill hint there would name
        // a type nothing afterwards reports.
        _relied_crossings: Collections.SET[CROSSING];

        // The compile-expressions output for variable-left nodes,
        // where a local's initializing store is recorded: a slot the
        // walk over expression nodes never sees.
        _variable_left_state: VARIABLE_LEFT_STATE_STORE;

        _exception_type: Type;

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            variable_left_state: VARIABLE_LEFT_STATE_STORE,
            exception_type: Type
        ) is
            super.init(logger, symbol_table, namespaces);

            _return_type_stack = Collections.LIST[Type?]();
            _reported = Collections.SET[RELIANCE_PROVENANCE]();
            _relied_crossings = Collections.SET[CROSSING]();
            _variable_left_state = variable_left_state;
            _exception_type = exception_type;
        si

        apply(root: Trees.Node) is
            try
                root.walk(self);
            catch ex: System.Exception
                // judging is best-effort over whatever compiled;
                // broken code is diagnosed by the earlier passes
            yrt
        si

        visit_default(node: Trees.Node) is
            if isa Trees.Expressions.Expression(node) then
                let value = (cast Trees.Expressions.Expression(node)).value;

                if value? then
                    _note_relied_crossings_of(value);

                    _judge_shallow(value);
                fi
            fi
        si

        pre(function: Definitions.FUNCTION) -> bool is
            let symbol = function_for(function);

            _return_type_stack.add(if symbol? then symbol.return_type else null fi);

            return false;
        si

        visit(function: Definitions.FUNCTION) is
            if _return_type_stack.count > 0 then
                _judge_expression_body(function.body, _return_type_stack[_return_type_stack.count - 1]);
                _return_type_stack.remove_at(_return_type_stack.count - 1);
            fi
        si

        pre(function: Expressions.FUNCTION) -> bool is
            let symbol = function_for(function);

            _return_type_stack.add(if symbol? then symbol.return_type else null fi);

            return false;
        si

        visit(function: Expressions.FUNCTION) is
            if _return_type_stack.count > 0 then
                _judge_expression_body(function.body, _return_type_stack[_return_type_stack.count - 1]);
                _return_type_stack.remove_at(_return_type_stack.count - 1);
            fi
        si

        // An arrow body delivers its value as the function's return
        // without a RETURN node, so the slot judgement the return
        // visitor performs has to happen here for it.
        _judge_expression_body(body: Trees.Bodies.Body?, return_type: Type?) is
            if !body? \/ !return_type? \/ return_type.is_void then
                return;
            fi

            if let expression_body: Trees.Bodies.EXPRESSION = body, value = expression_body.expression.value then
                _judge_slot(value, return_type);
            fi
        si

        visit(r: Statements.RETURN) is
            if r.expression? /\ r.expression.value? /\ _return_type_stack.count > 0 then
                _judge_slot(r.expression.value, _return_type_stack[_return_type_stack.count - 1]);
            fi
        si

        // The thrown value must satisfy System.Exception; a wide type
        // that does not means resolution leaned on the narrow.
        visit(t: Statements.THROW) is
            if t.expression? /\ t.expression.value? then
                _judge_slot(t.expression.value, _exception_type);
            fi
        si

        // A cast the program wrote faults on a value of the wrong
        // type but not on an absent one - castclass passes null
        // through - so a non-optional target leans on any presence
        // fact the operand carries. The compiler-synthesised casts
        // are all unchecked (they decline rather than fault) and are
        // exempt.
        visit(c: Trees.Expressions.CAST) is
            if !c.is_checked then
                return;
            fi

            if let target = c.value, target_type = target.type, operand = c.right.value, provenance = operand.reliance_provenance then
                if target_type.is_optional \/ !provenance.asserts_presence \/ !provenance.wide_type.is_optional then
                    return;
                fi

                if _reported.contains(provenance) then
                    return;
                fi

                if !operand.type? \/ !target_type.is_assignable_from(operand.type) then
                    return;
                fi

                _judge_reliance(provenance, true, false, false);
            fi
        si

        // Destructuring consumes the source whole: the element pulls
        // the lowering builds assume a present value of the shape the
        // destructure was resolved against, and the source is the
        // only value in the construct that carries the fact.
        visit(v: Trees.Variables.VARIABLE) is
            if v.left.is_refutable then
                return;
            fi

            if !isa Trees.Variables.DESTRUCTURING_VARIABLE_LEFT(v.left) then
                return;
            fi

            if let init = v.initializer, source = init.value then
                _judge_receiver_against(source, null);
            fi
        si

        // Iterator resolution ran against the iterable's type: when
        // only the narrowed view is iterable there, the loop leans on
        // the fact for the dispatch the generated code performs.
        visit(`for: Statements.FOR) is
            if let iterator = `for.read_iterator, expression = `for.expression, value = expression.value then
                _judge_receiver_against(value, _owner_type(iterator.owner));
            fi

            // The loop body is a scope; DefaultVisitor's visit pops
            // what its pre pushed, so the scope bookkeeping must run
            // even though this override replaces the default body.
            super.visit(`for);
        si

        // A local's initializing store is recorded on the
        // variable-left state, not on an expression node, so the walk
        // over expressions never offers it to the dispatch below.
        // Judging the store covers the declared-or-inferred slot;
        // judging the stored value reaches the source a destructure
        // pulls its elements from, which exists only in this state.
        visit(left: Trees.Variables.SIMPLE_VARIABLE_LEFT) is
            // A refutable pattern re-checks the source at runtime
            // before anything binds
            if left.is_refutable then
                return;
            fi

            if let state = _variable_left_state.get(left), value = state.value then
                _judge_shallow(value);

                if let store: IR.Values.Store.SYMBOL = value then
                    _judge_shallow(store.value);
                fi
            fi
        si

        // Mark each call the solved relations cannot show left a fact
        // it was crossed over alone. The fact survives the call, so
        // this is not the fact ending; it is the point past which the
        // narrowed type is no longer backed by anything, which is what
        // the editor has to show for the type it reports afterwards to
        // be readable. A call the relations clear draws nothing.
        //
        // One sigil per call site, however many facts the call was
        // crossed over: a kill is a property of the site, and stacking
        // a sigil per fact would render as a row of arrows. Candidates
        // for one site can also arrive more than once - the
        // compile-expressions retry loop re-walks a body that has not
        // converged, and each walk re-notes the calls it crosses - so
        // the collapse has to be by location, not just per walk.
        report_narrowing_kills() is
            let taken = RELIANCES.take_kill_candidates();
            let reported = Collections.LIST[LOCATION]();

            for candidate in taken do
                if _contains_location(reported, candidate.crossing.location) then
                    continue;
                fi

                let at_site = _undischarged_at(taken, candidate.crossing.location);

                if at_site.count == 0 then
                    continue;
                fi

                reported.add(candidate.crossing.location);

                _logger.inlay(
                    candidate.crossing.location,
                    "narrowing-killed",
                    "◄",
                    _kill_detail(at_site));
            od
        si

        _contains_location(reported: Collections.List[LOCATION], location: LOCATION) -> bool is
            for seen in reported do
                if seen =~ location then
                    return true;
                fi
            od

            return false;
        si

        // The candidates for one call site the relations cannot clear,
        // in note order, with repeats of the same fact collapsed.
        _undischarged_at(taken: Collections.List[KILL_CANDIDATE], location: LOCATION)
            -> Collections.List[KILL_CANDIDATE] is
            let result = Collections.LIST[KILL_CANDIDATE]();

            for candidate in taken do
                if candidate.crossing.location !~ location then
                    continue;
                fi

                if !_relied_crossings.contains(candidate.crossing) then
                    continue;
                fi

                if RELIANCES.crossing_discharged(
                    candidate.crossing, candidate.target, candidate.path, candidate.is_presence) then
                    continue;
                fi

                // A body walked more than once notes the same fact once
                // per walk. The later note wins: an earlier walk can
                // render a type it had not yet settled.
                let same = _index_of_same_fact(result, candidate);

                if same >= 0 then
                    result[same] = candidate;
                else
                    result.add(candidate);
                fi
            od

            return result;
        si

        // Index in `found` of the candidate describing the same fact as
        // `candidate`, or -1. A fact is the value it is about and what
        // it claims of it - the triple `crossing_discharged` judges by -
        // never its rendered description, which two distinct facts can
        // share and one fact can vary between walks.
        _index_of_same_fact(found: Collections.List[KILL_CANDIDATE], candidate: KILL_CANDIDATE) -> int is
            for i in 0..found.count do
                if _is_same_fact(found[i], candidate) then
                    return i;
                fi
            od

            return -1;
        si

        _is_same_fact(a: KILL_CANDIDATE, b: KILL_CANDIDATE) -> bool is
            if a.is_presence != b.is_presence then
                return false;
            fi

            let a_target = a.target;
            let b_target = b.target;

            if a_target? \/ b_target? then
                return a_target? /\ b_target? /\ a_target == b_target;
            fi

            let a_path = a.path;
            let b_path = b.path;

            return a_path? /\ b_path? /\ a_path.equals(b_path);
        si

        _kill_detail(candidates: Collections.List[KILL_CANDIDATE]) -> string is
            if candidates.count == 1 then
                return "{candidates[0].detail}\n\na call here may change it";
            fi

            let out = System.Text.StringBuilder("a call here may change:");

            for candidate in candidates do
                out.append("\n    ");
                out.append(candidate.detail);
            od

            return out.to_string();
        si

        _judge_shallow(value: Value) is
            if let call: IR.Values.Call.INSTANCE = value then
                _judge_receiver(call.from, call.function);
                _judge_arguments(call.function, call.arguments);
            elif let call: IR.Values.Call.STRUCT = value then
                _judge_receiver(call.from, call.function);
                _judge_arguments(call.function, call.arguments);
            elif let call: IR.Values.Call.STATIC = value then
                _judge_arguments(call.function, call.arguments);
            elif let call: IR.Values.Call.GLOBAL = value then
                _judge_arguments(call.function, call.arguments);
            elif let new_value: IR.Values.NEW = value then
                _judge_arguments(new_value.constructor, new_value.arguments);
            elif let closure_call: IR.Values.Call.CLOSURE = value then
                _judge_closure(closure_call);
            elif let store: IR.Values.Store.SYMBOL = value then
                _judge_slot(store.value, _symbol_type(store.symbol));
            elif let store: IR.Values.Store.INDIRECT = value then
                _judge_slot(store.value, store.type);
            elif let sequence: IR.Values.SEQUENCE = value then
                for element in sequence.values do
                    _judge_slot(element, sequence.element_type);
                od
            elif let load: IR.Values.Load.INSTANCE_FIELD = value then
                if load.from? then
                    _judge_member_receiver(load.from, load.symbol);
                fi
            elif let tuple: IR.Values.TUPLE = value then
                _judge_tuple(tuple);
            fi

            // Intrinsic (INNATE) operations need no judging: on
            // references they are identity comparisons, valid at any
            // type and null-tolerant. A value-type presence fact
            // reaches a scalar intrinsic through NARROW_PROJECT,
            // whose `.value` projection re-checks at every read, so
            // the worst outcome there is a clean invalid-operation
            // throw rather than a wrong result.
        si

        // Invoking a function-typed value: the invocation
        // dereferences the value, and the arguments flow into the
        // function type's parameter slots (all of the type's
        // arguments for an action, all but the trailing return type
        // otherwise).
        _judge_closure(call: IR.Values.Call.CLOSURE) is
            _judge_receiver_against(call.from, null);

            let func_type = call.func_type;

            if !func_type? then
                return;
            fi

            let formals = func_type.arguments;
            let formal_count =
                if call.is_action then formals.count else formals.count - 1 fi;

            for i in 0..call.arguments.count do
                if i < formal_count then
                    _judge_slot(call.arguments[i], formals[i]);
                fi
            od
        si

        _symbol_type(symbol: Symbol?) -> Type? is
            if !symbol? \/ !isa Semantic.Types.Typed(symbol) then
                return null;
            fi

            return (cast Semantic.Types.Typed(symbol)).type;
        si

        _judge_arguments(function: Function, arguments: Collections.List[Value]) is
            let formals = function.arguments;

            for i in 0..arguments.count do
                if i < formals.count then
                    _judge_slot(arguments[i], formals[i]);
                fi
            od
        si

        // A value flowing into a typed slot: relies on its facts only
        // when the slot rejects the un-narrowed type.
        _judge_slot(value: Value, formal: Type?) is
            let provenance = value.reliance_provenance;

            if !provenance? \/ !formal? \/ _reported.contains(provenance) then
                return;
            fi

            let wide = provenance.wide_type;

            if formal.is_assignable_from(wide) then
                return;
            fi

            // Only a slot the narrowed view itself satisfies was
            // resolved against the fact; anything else reached this
            // slot through a conversion (task wrapping, delegate
            // construction, boxing paths) that re-shapes the value.
            if !value.type? \/ !formal.is_assignable_from(value.type) then
                return;
            fi

            let needs_presence = wide.is_optional /\ provenance.asserts_presence;
            let needs_narrow =
                provenance.narrows_type /\
                !formal.is_assignable_from(
                    if wide.is_optional then wide.as_non_optional() else wide fi);

            if !needs_presence /\ !needs_narrow then
                return;
            fi

            _judge_reliance(provenance, needs_presence, needs_narrow, false);
        si

        // A narrowed value packed into a tuple element leans on its
        // facts whenever the element's declared type would reject the
        // un-narrowed value.
        // Tuple element types ride the type's generic argument list,
        // whichever wrapper represents the tuple shape.
        _judge_tuple(tuple: IR.Values.TUPLE) is
            let element_types = tuple.type.arguments;

            for i in 0..tuple.values.count do
                if i < element_types.count then
                    _judge_slot(tuple.values[i], element_types[i]);
                fi
            od
        si

        // Dispatch through a receiver: a null receiver fails whatever
        // the member is, so presence is always leaned on; the member
        // itself is only leaned on when the un-narrowed type does not
        // declare it — a replacement value of the wide type still
        // carries any member declared at or above it.
        _judge_receiver(receiver: Value, function: Function) is
            _judge_receiver_against(receiver, _owner_type(function.owner));
        si

        _judge_member_receiver(receiver: Value, member: Symbol?) is
            if !member? then
                return;
            fi

            _judge_receiver_against(receiver, _owner_type(member.owner));
        si

        _judge_receiver_against(receiver: Value, owner_type: Type?) is
            let provenance = receiver.reliance_provenance;

            if !provenance? \/ _reported.contains(provenance) then
                return;
            fi

            let wide = provenance.wide_type;

            let needs_presence = wide.is_optional /\ provenance.asserts_presence;

            let wide_inner =
                if wide.is_optional then wide.as_non_optional() else wide fi;

            // a fact that never narrowed the type cannot be leaned on
            // for member reachability - resolution saw the wide type
            let needs_narrow =
                provenance.narrows_type /\
                (!owner_type? \/ !owner_type.is_assignable_from(wide_inner));

            if !needs_presence /\ !needs_narrow then
                return;
            fi

            // dereferencing a possibly-null receiver is the same
            // hazard the null-deref warning already covers, so a
            // presence-only receiver reliance warns rather than
            // errors; a type reliance is type confusion and stays an
            // error
            _judge_reliance(provenance, needs_presence, needs_narrow, !needs_narrow);
        si

        _owner_type(owner: Semantic.Scope?) -> Type? is
            if !owner? \/ !isa Semantic.Symbols.Classy(owner) then
                return null;
            fi

            return (cast Semantic.Symbols.Classy(owner)).type;
        si

        _judge_reliance(provenance: RELIANCE_PROVENANCE, needs_presence: bool, needs_narrow: bool, warn_only: bool) is
            // leaning on the fact at all requires every getter it
            // reads through to be proven for the fact kind leaned
            // on: store-free backs both kinds, a monotone memoiser
            // backs presence only
            if provenance.getter_unproven then
                let unproven = RELIANCES.first_unproven_getter(
                    provenance.target,
                    provenance.path,
                    !needs_narrow);

                if unproven? then
                    let related = LIST[RELATED_LOCATION]();

                    related.add(RELATED_LOCATION(unproven.location, "getter declared here"));

                    let test_site = UNBACKED_FACTS.test_location_for(
                        provenance.location.file_name,
                        provenance.target,
                        provenance.path,
                        provenance.location);

                    if test_site? then
                        related.add(RELATED_LOCATION(test_site, "narrowed here"));
                    fi

                    related.add(
                        RELATED_LOCATION(
                            provenance.location,
                            "help: copy the value into a local variable"));

                    _report(
                        provenance,
                        warn_only,
                        "the getter of '{unproven.name}' is not provably stable",
                        related);

                    return;
                fi
            fi

            if needs_presence /\ provenance.presence_crossings? then
                if _report_first_undischarged(provenance, provenance.presence_crossings, true, warn_only) then
                    return;
                fi
            fi

            if needs_narrow /\ provenance.narrow_crossings? then
                _report_first_undischarged(provenance, provenance.narrow_crossings, false, false);
            fi
        si

        // Every load the walk sees carries the crossings that were
        // live over the fact it reads, so noting them for the load
        // itself is what makes the set mean "read again downstream at
        // all". Noting them only where a consumption is judged asks a
        // narrower question: judging covers calls, stores, sequences
        // and instance-field receivers, while a load reaching an
        // intrinsic operation is judged by nothing and is still a read
        // the editor reports a narrowed type for.
        _note_relied_crossings_of(value: Value) is
            _note_relied_crossings_of(value.reliance_provenance);
            _note_relied_crossings_of(value.rechecked_provenance);
        si

        _note_relied_crossings_of(provenance: RELIANCE_PROVENANCE?) is
            if !provenance? then
                return;
            fi

            let presence_crossings = provenance.presence_crossings;

            if presence_crossings? then
                _note_relied_crossings(provenance, presence_crossings, true);
            fi

            let narrow_crossings = provenance.narrow_crossings;

            if narrow_crossings? then
                _note_relied_crossings(provenance, narrow_crossings, false);
            fi
        si

        // Up to and including the first crossing the relations cannot
        // clear, and no further: that call is where the fact stops
        // being backed, and a call after it was crossed over a fact
        // already gone, so marking it would report the same loss a
        // second time.
        _note_relied_crossings(
            provenance: RELIANCE_PROVENANCE,
            crossings: Collections.LIST[CROSSING],
            is_presence: bool
        ) is
            for crossing in crossings do
                _relied_crossings.add(crossing);

                if !RELIANCES.crossing_discharged(
                    crossing, provenance.target, provenance.path, is_presence) then
                    return;
                fi
            od
        si

        _report_first_undischarged(
            provenance: RELIANCE_PROVENANCE,
            crossings: Collections.LIST[CROSSING],
            is_presence: bool,
            warn_only: bool
        ) -> bool is
            for crossing in crossings do
                if !RELIANCES.crossing_discharged(crossing, provenance.target, provenance.path, is_presence) then
                    let call_description =
                        if crossing.callee? then
                            "the call to '{crossing.callee.name}()'"
                        else
                            "the call at line {crossing.location.start_line}"
                        fi;

                    let related = LIST[RELATED_LOCATION]();

                    related.add(
                        RELATED_LOCATION(
                            crossing.location,
                            "this call can change {provenance.name}"));

                    related.add(
                        RELATED_LOCATION(
                            provenance.location,
                            "help: test '{provenance.name}' again, or copy it into a local variable before the call"));

                    _report(provenance, warn_only, "{call_description} can change it", related);

                    return true;
                fi
            od

            return false;
        si

        _report(provenance: RELIANCE_PROVENANCE, warn_only: bool, detail: string) is
            _report(provenance, warn_only, detail, LIST[RELATED_LOCATION]());
        si

        _report(
            provenance: RELIANCE_PROVENANCE,
            warn_only: bool,
            detail: string,
            related: LIST[RELATED_LOCATION]
        ) is
            _reported.add(provenance);
            RELIANCES.consumptions_reported = RELIANCES.consumptions_reported + 1;

            if warn_only then
                _logger.warn(
                    provenance.location,
                    "null-deref",
                    "{provenance.name} may not hold a value here: {detail}",
                    related);
            else
                _logger.error(
                    provenance.location,
                    "cannot rely on the narrowing of '{provenance.name}' here: {detail}",
                    related);
            fi
        si
    si
si
