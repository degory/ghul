namespace Syntax.Process is
    use Function = Semantic.Symbols.Function

    // What one function contributed to the effect solve's inputs, as
    // taken before a partial round drops and re-derives it. The
    // member-granular record accumulates across walks - its sets only
    // grow - so a set is captured by its size; the store-free facts are
    // replaced whole, so their callee lists are captured as sets.
    class EFFECT_INPUT_SNAPSHOT(
        is_disqualified: bool,
        is_construction_disqualified: bool,
        callees: Collections.SET[Function],
        construction_callees: Collections.SET[Function],
        record: FUNCTION_EFFECT_FACTS?,
        writes: int,
        nulling_writes: int,
        reads: int,
        forwards_param_to: int,
        flags: int
    ) is
        of(facts: STORE_FREE_FACTS, record: FUNCTION_EFFECT_FACTS?) -> EFFECT_INPUT_SNAPSHOT static is
            let callees = Collections.SET[Function]()

            for c in facts.callees do
                callees.add(c)
            od

            let construction_callees = Collections.SET[Function]()

            for c in facts.construction_callees do
                construction_callees.add(c)
            od

            return EFFECT_INPUT_SNAPSHOT(
                facts.is_disqualified,
                facts.is_construction_disqualified,
                callees,
                construction_callees,
                record,
                if record? then record.writes.count else 0 fi,
                if record? then record.nulling_writes.count else 0 fi,
                if record? then record.reads.count else 0 fi,
                if record? then record.forwards_param_to.count else 0 fi,
                if record? then flags_of(record) else 0 fi)
        si

        flags_of(record: FUNCTION_EFFECT_FACTS) -> int static is
            let bits = [
                record.own_stores, record.own_unbounded, record.is_disqualified,
                record.writes_unbounded, record.assigns_optional, record.nulling_unbounded,
                record.writes_elements, record.reads_elements, record.for_auto_property,
                record.openly_dispatchable, record.declared_pure, record.invokes_function_param
            ]

            let result mut = 0

            for bit in bits do
                result = result * 2 + if bit then 1 else 0 fi
            od

            return result * 65536 + record.callee_count * 256 + record.overrider_count
        si

        // Whether the function's contribution after its re-walk is the
        // one captured here.
        matches(facts: STORE_FREE_FACTS, record: FUNCTION_EFFECT_FACTS?) -> bool is
            if facts.is_disqualified != is_disqualified \/ facts.is_construction_disqualified != is_construction_disqualified then
                return false
            fi

            if !_same_members(facts.callees, callees) \/ !_same_members(facts.construction_callees, construction_callees) then
                return false
            fi

            if record != self.record then
                return false
            fi

            if !record? then
                return true
            fi

            return
                record.writes.count == writes /\
                record.nulling_writes.count == nulling_writes /\
                record.reads.count == reads /\
                record.forwards_param_to.count == forwards_param_to /\
                flags_of(record) == flags
        si

        _same_members(list: Collections.Iterable[Function], set: Collections.SET[Function]) -> bool static is
            let seen = Collections.SET[Function]()

            for f in list do
                if !set.contains(f) then
                    return false
                fi

                seen.add(f)
            od

            return seen.count == set.count
        si
    si

    partial INFER_STORE_FREE is
        // The contributions of every walked function in `files`, plus the
        // sizes of the whole-program tables a walk can only add to, so a
        // partial round can tell whether re-deriving them changed any
        // input the solve reads. Taken before the files' facts are
        // dropped.
        snapshot_inputs(files: Collections.Iterable[string]) -> Collections.MAP[Function, EFFECT_INPUT_SNAPSHOT] is
            let names = Collections.SET[string]()

            for file_name in files do
                names.add(file_name)
            od

            let result = Collections.MAP[Function, EFFECT_INPUT_SNAPSHOT]()

            for entry in _facts do
                if names.contains(entry.key.location.file_name) then
                    result[entry.key] = EFFECT_INPUT_SNAPSHOT.of(entry.value, EFFECT_FACTS.record_for(entry.key))
                fi
            od

            return result
        si

        // The passed-function tables a walk can only add to, both
        // consulted by the solve. Compared element by element below: a
        // tuple has no `=~` yet and its `==` is not a value comparison
        // (ghul#2369).
        passed_table_sizes() -> (functions: int, opaque: int) =>
            (EFFECT_FACTS.passed_function_count, EFFECT_FACTS.passed_opaque.count)

        // Whether the re-walk of `files` left every solve input exactly
        // as the snapshot captured it: the same functions, each with the
        // same contribution, and nothing added to the passed-function
        // tables. When it did, the installed relations already answer
        // for these facts and the solve can be skipped.
        inputs_unchanged(
            files: Collections.Iterable[string],
            snapshot: Collections.MAP[Function, EFFECT_INPUT_SNAPSHOT],
            passed: (functions: int, opaque: int)
        ) -> bool is
            let now = passed_table_sizes()

            if now.functions != passed.functions \/ now.opaque != passed.opaque then
                return false
            fi

            let names = Collections.SET[string]()

            for file_name in files do
                names.add(file_name)
            od

            let seen mut = 0

            for entry in _facts do
                if !names.contains(entry.key.location.file_name) then
                    continue
                fi

                let before: EFFECT_INPUT_SNAPSHOT mut

                if !snapshot.try_get_value(entry.key, before ref) then
                    return false
                fi

                if !before.matches(entry.value, EFFECT_FACTS.record_for(entry.key)) then
                    return false
                fi

                seen = seen + 1
            od

            return seen == snapshot.count
        si
    si
si
