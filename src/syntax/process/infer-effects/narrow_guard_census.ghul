namespace Syntax.Process is
    use Collections.LIST;
    use Collections.SET;
    use LOCATION = Source.LOCATION;

    // Measurement scaffolding, off unless GHUL_GUARD_CENSUS is set:
    // counts the consumptions a sound implementation would have to
    // guard at runtime — a type narrow on a heap fact, leaned on by
    // the consumption, carried over a call the solved relations
    // cannot discharge. Presence facts and locals are excluded from
    // the guard question: a wrong presence fact dereferences null,
    // and a callee cannot reach a local.
    //
    // Classification follows the shipped formation semantics: a fact
    // whose getter chain is self-unstable for it is unbacked and
    // never presented as a narrowing, so a leaning use is a compile
    // error rather than a guard candidate. A backed fact's own
    // getter calls discharge by construction, so the undischarged
    // crossings counted here are external calls only.
    class NARROW_GUARD_CENSUS is
        _entries: LIST[NARROW_GUARD_SITE] static;
        _seen: SET[RELIANCE_PROVENANCE] static;
        _leaning_narrows: int public static;
        _leaning_unbacked_narrows: int public static;
        _leaning_presence: int public static;
        _leaning_unbacked_presence: int public static;
        _presence_external: int public static;
        _loads_seen: int public static;
        _loads_unbacked_type: int public static;
        _loads_unbacked_presence: int public static;
        _loads_narrow_external: int public static;
        _loads_presence_external: int public static;
        _loads_clean: int public static;
        _seen_loads: SET[RELIANCE_PROVENANCE] static;
        _at_risk: LIST[NARROW_GUARD_SITE] static;

        init() static is
            _entries = LIST[NARROW_GUARD_SITE]();
            _seen = SET[RELIANCE_PROVENANCE]();
            _seen_loads = SET[RELIANCE_PROVENANCE]();
            _at_risk = LIST[NARROW_GUARD_SITE]();
        si

        is_enabled: bool static =>
            System.Environment.get_environment_variable("GHUL_GUARD_CENSUS")?;

        is_verbose: bool static =>
            System.Environment.get_environment_variable("GHUL_GUARD_CENSUS_VERBOSE")?;

        note_leaning_narrow(unbacked: bool) static is
            _leaning_narrows = _leaning_narrows + 1;

            if unbacked then
                _leaning_unbacked_narrows = _leaning_unbacked_narrows + 1;
            fi
        si

        note_leaning_presence(unbacked: bool, external_undischarged: bool) static is
            _leaning_presence = _leaning_presence + 1;

            if unbacked then
                _leaning_unbacked_presence = _leaning_unbacked_presence + 1;
            elif external_undischarged then
                _presence_external = _presence_external + 1;
            fi
        si

        // Every stamped load the walk reaches, classified by the
        // formation question (is the getter chain self-unstable for
        // the fact?) and by what would need a guard if some
        // consumption leaned on a backed fact.
        note_load(
            provenance: RELIANCE_PROVENANCE,
            in_loop: bool,
            unbacked_type: bool,
            unbacked_presence: bool,
            narrow_external: bool,
            presence_external: bool
        ) static is
            if _seen_loads.contains(provenance) then
                return;
            fi

            _seen_loads.add(provenance);
            _loads_seen = _loads_seen + 1;

            let accounted mut = false;

            if unbacked_type then
                _loads_unbacked_type = _loads_unbacked_type + 1;
                _at_risk.add(NARROW_GUARD_SITE(provenance.location, provenance.name, in_loop, "unbacked type"));
                accounted = true;
            fi

            if unbacked_presence then
                _loads_unbacked_presence = _loads_unbacked_presence + 1;
                accounted = true;
            fi

            if !unbacked_type /\ narrow_external then
                _loads_narrow_external = _loads_narrow_external + 1;
                _at_risk.add(NARROW_GUARD_SITE(provenance.location, provenance.name, in_loop, "external crossing"));
                accounted = true;
            fi

            if !unbacked_presence /\ presence_external then
                _loads_presence_external = _loads_presence_external + 1;
                accounted = true;
            fi

            if !accounted then
                _loads_clean = _loads_clean + 1;
            fi
        si

        note(
            provenance: RELIANCE_PROVENANCE,
            in_loop: bool,
            enclosing: string
        ) static is
            if _seen.contains(provenance) then
                return;
            fi

            _seen.add(provenance);

            _entries.add(
                NARROW_GUARD_SITE(provenance.location, provenance.name, in_loop, enclosing));
        si

        report() static is
            if !is_enabled then
                return;
            fi

            let sites = SET[string]();
            let in_loop = LIST[NARROW_GUARD_SITE]();

            for entry in _entries do
                sites.add("{entry.location}");

                if entry.in_loop then
                    in_loop.add(entry);
                fi
            od

            IO.Std.error.write_line("load census: {_loads_seen} stamped loads; unbacked at formation: {_loads_unbacked_type} type / {_loads_unbacked_presence} presence; backed past an external undischarged call: {_loads_narrow_external} type / {_loads_presence_external} presence; clean: {_loads_clean}");
            IO.Std.error.write_line("presence census: {_leaning_presence} leaning presence facts, {_leaning_unbacked_presence} through an unbacked getter, {_presence_external} past an external call");
            IO.Std.error.write_line("guard census: {_leaning_narrows} leaning type narrows, {_leaning_unbacked_narrows} through an unbacked getter (compile errors), {_entries.count} would need a guard, {sites.count} distinct sites, {in_loop.count} in loop bodies");

            for entry in _at_risk do
                IO.Std.error.write_line("at-risk load: {entry.location}: {entry.name} [{entry.enclosing}]{if entry.in_loop then " [loop]" else "" fi}");
            od

            for entry in _entries do
                IO.Std.error.write_line(
                    "guard site: {entry.location}: {entry.name}{if entry.in_loop then " [loop]" else "" fi} in {entry.enclosing}");
            od
        si
    si

    class NARROW_GUARD_SITE(
        location: LOCATION,
        name: string,
        in_loop: bool,
        enclosing: string
    );
si
