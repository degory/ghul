namespace Syntax.Process is
    use Collections.LIST;
    use Collections.SET;
    use LOCATION = Source.LOCATION;

    // Measurement scaffolding, off unless GHUL_GUARD_CENSUS is set:
    // counts the consumptions a sound implementation would have to
    // guard at runtime — a type narrow on a heap fact, leaned on by
    // the consumption, carried over a call the solved relations
    // cannot discharge. Presence facts and locals are excluded: a
    // wrong presence fact dereferences null, and a callee cannot
    // reach a local.
    class NARROW_GUARD_CENSUS is
        _entries: LIST[NARROW_GUARD_SITE] static;
        _seen: SET[RELIANCE_PROVENANCE] static;
        _leaning_narrows: int public static;
        _leaning_presence: int public static;
        _presence_undischarged: int public static;
        _loads_seen: int public static;
        _loads_narrow_at_risk: int public static;
        _loads_presence_at_risk: int public static;
        _loads_getter_only: int public static;
        _seen_loads: SET[RELIANCE_PROVENANCE] static;
        _at_risk: LIST[NARROW_GUARD_SITE] static;

        init() static is
            _entries = LIST[NARROW_GUARD_SITE]();
            _seen = SET[RELIANCE_PROVENANCE]();
            _seen_loads = SET[RELIANCE_PROVENANCE]();
            _at_risk = LIST[NARROW_GUARD_SITE]();
        si

        is_enabled: bool static =>
            System.Environment.get_environment_variable("GHUL_GUARD_CENSUS")?;

        is_verbose: bool static =>
            System.Environment.get_environment_variable("GHUL_GUARD_CENSUS_VERBOSE")?;

        note_leaning_narrow() static is
            _leaning_narrows = _leaning_narrows + 1;
        si

        note_leaning_presence(undischarged: bool) static is
            _leaning_presence = _leaning_presence + 1;

            if undischarged then
                _presence_undischarged = _presence_undischarged + 1;
            fi
        si

        // Every stamped load the walk reaches, classified by what
        // would need a guard if some consumption leaned on it.
        note_load(
            provenance: RELIANCE_PROVENANCE,
            in_loop: bool,
            narrow_at_risk: bool,
            presence_at_risk: bool
        ) static is
            if _seen_loads.contains(provenance) then
                return;
            fi

            _seen_loads.add(provenance);
            _loads_seen = _loads_seen + 1;

            if narrow_at_risk then
                _loads_narrow_at_risk = _loads_narrow_at_risk + 1;
                _at_risk.add(NARROW_GUARD_SITE(provenance.location, provenance.name, in_loop, ""));
            fi

            if presence_at_risk then
                _loads_presence_at_risk = _loads_presence_at_risk + 1;
            fi

            if provenance.getter_unproven /\ !narrow_at_risk /\ !presence_at_risk then
                _loads_getter_only = _loads_getter_only + 1;
            fi
        si

        note(
            provenance: RELIANCE_PROVENANCE,
            in_loop: bool,
            enclosing: string
        ) static is
            if _seen.contains(provenance) then
                return;
            fi

            _seen.add(provenance);

            _entries.add(
                NARROW_GUARD_SITE(provenance.location, provenance.name, in_loop, enclosing));
        si

        report() static is
            if !is_enabled then
                return;
            fi

            let sites = SET[string]();
            let in_loop = LIST[NARROW_GUARD_SITE]();

            for entry in _entries do
                sites.add("{entry.location}");

                if entry.in_loop then
                    in_loop.add(entry);
                fi
            od

            IO.Std.error.write_line("load census: {_loads_seen} stamped loads, {_loads_narrow_at_risk} type-narrow past an undischarged call, {_loads_presence_at_risk} presence past one, {_loads_getter_only} clean but refused on the getter gate");
            IO.Std.error.write_line("presence census: {_leaning_presence} leaning presence facts, {_presence_undischarged} undischarged");
            IO.Std.error.write_line("guard census: {_leaning_narrows} leaning type narrows, {_entries.count} would need a guard, {sites.count} distinct sites, {in_loop.count} in loop bodies");

            for entry in _at_risk do
                IO.Std.error.write_line("at-risk type narrow: {entry.location}: {entry.name}{if entry.in_loop then " [loop]" else "" fi}");
            od

            for entry in _entries do
                IO.Std.error.write_line(
                    "guard site: {entry.location}: {entry.name}{if entry.in_loop then " [loop]" else "" fi} in {entry.enclosing}");
            od
        si
    si

    class NARROW_GUARD_SITE(
        location: LOCATION,
        name: string,
        in_loop: bool,
        enclosing: string
    );
si
