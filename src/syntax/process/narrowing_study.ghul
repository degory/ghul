namespace Syntax.Process is
    use IO.Std;

    use Function = Semantic.Symbols.Function;
    use Symbol = Semantic.Symbols.Symbol;

    // Per-function record the study keeps alongside INFER_STORE_FREE's
    // own facts. Populated during the body walk, completed at fixpoint
    // time, dumped at the end of the compile.
    class STUDY_RECORD is
        name: string public;
        owner_name: string public;
        location: string public;

        // The accessor role, derived from the synthesised accessor
        // name: "get" for a property read accessor, "set" for its
        // assign accessor, "index-get" / "index-set" for an indexer's,
        // "" for an ordinary function or method.
        role: string public;

        // The body walk saw a write to something other than a local:
        // a member, an index, a global, or the receiver's own state.
        own_stores: bool public;

        // The body walk gave up for a reason that is not a write: an
        // unboundable callee, an unaudited node kind, an await, ...
        own_unbounded: bool public;

        // Copied from the function's STORE_FREE_FACTS at fixpoint
        // time, so the table can be checked for records aliased
        // between two functions.
        is_disqualified: bool public;
        aliased: bool public;

        // Whether any override of this function definitely writes the
        // heap, and whether any is merely unprovable. The assumption
        // under test is exactly that the first of these is empty.
        overrider_writes: bool public;
        overrider_unprovable: bool public;

        // The member symbols this body writes directly, and whether it
        // performs a write the walk could not pin to a symbol (an
        // index, an unresolvable target) or does something unboundable
        // that could write anything.
        writes: Collections.SET[Symbol] public;
        writes_unbounded: bool public;

        // What the walk first gave up on in this body, or "" if it
        // never did.
        unbounded_reason: string public;

        // Set on a property accessor's record when the owning property
        // is an auto-property: its getter reads only the hidden backing
        // field, so the property's value can only change through an
        // assignment to the property itself. A hand-written getter can
        // read anything, so it is never stability-eligible.
        for_auto_property: bool public;

        callee_count: int public;
        overrider_count: int public;
        openly_dispatchable: bool public;
        declared_pure: bool public;

        init(name: string, owner_name: string, location: string, role: string) is
            self.name = name;
            self.owner_name = owner_name;
            self.location = location;
            self.role = role;
            writes = Collections.SET[Symbol]();
            unbounded_reason = "";
        si
    si

    // One killed narrowing fact, reduced to the member symbols whose
    // being written by the callee would justify the kill.
    class KILL_FACT(
        location: string public,
        callee: Function? public,
        members: Collections.LIST[Symbol] public,
        is_getter: bool public
    );

    // One run of the store-free analysis, and the write sets it
    // produced under each relaxation variant. Two runs are compared:
    // the analysis where it really sits, and the same analysis repeated
    // after compile-expressions, which is what moving it would know.
    class WRITE_GENERATION(
        label: string public,
        sets: Collections.LIST[Collections.MutableMap[Function, Collections.SET[Symbol]]] public,
        unbounded: Collections.LIST[Collections.SET[Function]] public
    ) is
        blame: Collections.MutableMap[Function, string]?  public;
    si

    // Empirical study of narrowing kills and store-free classification.
    //
    // Entirely env-gated and off by default: GHUL_NARROWING_STUDY names
    // the file the per-function table is written to, and
    // GHUL_ASSUME_GETTERS_PURE selects a counterfactual under which the
    // dispatch shadow is ignored for property read accessors, so a
    // build can be run with the assumption genuinely installed.
    class NARROWING_STUDY is
        _enabled: bool static;
        _enabled_known: bool static;

        // Path the table is written to, or null.
        _path: string? static;

        enabled: bool static is
            if !_enabled_known then
                _path = System.Environment.get_environment_variable("GHUL_NARROWING_STUDY");
                _enabled = _path? /\ _path.length > 0;
                _enabled_known = true;
            fi

            return _enabled;
        si

        // 0 off; 1 assume the dispatch shadow away for a *leaf* property
        // read accessor (clean body, no bounded callees); 2 the same for
        // any property read accessor whose own body is clean.
        _assume_mode: int static;
        _assume_mode_known: bool static;

        assume_mode: int static is
            if !_assume_mode_known then
                let text = System.Environment.get_environment_variable("GHUL_ASSUME_GETTERS_PURE");

                if text? then
                    if text =~ "1" then
                        _assume_mode = 1;
                    elif text =~ "2" then
                        _assume_mode = 2;
                    fi
                fi

                _assume_mode_known = true;
            fi

            return _assume_mode;
        si

        _records: Collections.MutableMap[Function, STUDY_RECORD]? static;

        records: Collections.MutableMap[Function, STUDY_RECORD] static is
            if !_records? then
                _records = Collections.MAP[Function, STUDY_RECORD]();
            fi

            return _records;
        si

        record_for(function: Function?) -> STUDY_RECORD? static is
            if !function? then
                return null;
            fi

            let root = cast Function?(function.root_specialized_from);

            if !root? then
                return null;
            fi

            if records.contains_key(root) then
                return records[root];
            fi

            return null;
        si

        note_function(
            function: Function?,
            name: string,
            owner_name: string,
            location: string,
            role: string
        ) static is
            if !enabled /\ assume_mode == 0 then
                return;
            fi

            if !function? then
                return;
            fi

            let root = cast Function?(function.root_specialized_from);

            if !root? then
                return;
            fi

            if records.contains_key(root) then
                records[root].aliased = true;
                return;
            fi

            records[root] = STUDY_RECORD(name, owner_name, location, role);
        si

        // ==== the assumed-safe set ====

        _assumed_safe: Collections.SET[Function]? static;

        assumed_safe: Collections.SET[Function] static is
            if !_assumed_safe? then
                _assumed_safe = Collections.SET[Function]();
            fi

            return _assumed_safe;
        si

        // GHUL_STUDY_RESOLVED: after the build, repeat the store-free
        // analysis with compile-expressions' resolved types available.
        _resolved_pass: bool static;
        _resolved_pass_known: bool static;

        resolved_pass: bool static is
            if !_resolved_pass_known then
                let text = System.Environment.get_environment_variable("GHUL_STUDY_RESOLVED");
                _resolved_pass = enabled /\ text? /\ text.length > 0;
                _resolved_pass_known = true;
            fi

            return _resolved_pass;
        si

        // GHUL_NO_CALL_KILLS: stop calls killing heap facts at all, the
        // unsound rule most languages with flow narrowing use. For
        // measuring what the analysis is buying, not a supported mode.
        _no_call_kills: bool static;
        _no_call_kills_known: bool static;

        no_call_kills: bool static is
            if !_no_call_kills_known then
                let text = System.Environment.get_environment_variable("GHUL_NO_CALL_KILLS");
                _no_call_kills = text? /\ text.length > 0;
                _no_call_kills_known = true;
            fi

            return _no_call_kills;
        si

        // Whether the counterfactual exempts `function` from the
        // dispatch-shadow test. Consulted by STORE_FREE_FIXPOINT only
        // when GHUL_ASSUME_GETTERS_PURE is set, so an ordinary build
        // never reaches it.
        is_assumed_safe(function: Function) -> bool static =>
            assume_mode != 0 /\ assumed_safe.contains(function);

        // Rebuild the assumed-safe set from this run's facts. Called at
        // the top of the fixpoint, before any solving.
        prepare(facts: Collections.MutableMap[Function, STORE_FREE_FACTS]) static is
            if assume_mode == 0 then
                return;
            fi

            let set = Collections.SET[Function]();

            for function in facts.keys do
                let record = record_for(function);

                if !record? \/ !(record.role =~ "get") then
                    continue;
                fi

                let f = facts[function];

                if f.is_disqualified then
                    continue;
                fi

                if assume_mode == 1 /\ f.callees.count > 0 then
                    continue;
                fi

                set.add(function);
            od

            _assumed_safe = set;
        si

        // ==== kill counters ====

        kill_events_call: int static public;
        facts_killed_call: int static public;

        // Of the above, those whose killing callee is store-free once
        // the dispatch shadow is assumed away — the kills the
        // hypothesis would prevent.
        kill_events_call_preventable_leaf: int static public;
        facts_killed_call_preventable_leaf: int static public;
        kill_events_call_preventable_clean: int static public;
        facts_killed_call_preventable_clean: int static public;

        // Kills whose callee is a property read accessor at all,
        // whatever the reason it was not store-free.
        kill_events_call_by_getter: int static public;
        facts_killed_call_by_getter: int static public;

        // Call kills the study could not attribute to a single callee
        // (a closure invocation, an interpolation, a pure-slot check).
        kill_events_call_unattributed: int static public;
        facts_killed_call_unattributed: int static public;

        // Call kills bucketed by the role of the callee, and by
        // whether the counterfactual rescues them.
        _by_role: Collections.MutableMap[string, int]? static;
        _by_role_preventable: Collections.MutableMap[string, int]? static;

        by_role: Collections.MutableMap[string, int] static is
            if !_by_role? then
                _by_role = Collections.MAP[string, int]();
            fi

            return _by_role;
        si

        by_role_preventable: Collections.MutableMap[string, int] static is
            if !_by_role_preventable? then
                _by_role_preventable = Collections.MAP[string, int]();
            fi

            return _by_role_preventable;
        si

        // A member is stability-eligible when its value is exactly its
        // storage: a field, or an auto-property. It is stable when it is
        // eligible and never written outside a constructor.
        _is_stable_member(m: Symbol, written: Collections.SET[Symbol]) -> bool static =>
            _is_eligible_member(m) /\ !written.contains(m);

        _is_eligible_member(m: Symbol) -> bool static is
            if m.is_field then
                return true;
            fi

            if let property: Semantic.Symbols.Property = m then
                let read_function = property.read_function;

                if !read_function? then
                    return false;
                fi

                let record = record_for(read_function);

                return record? /\ record.for_auto_property;
            fi

            return false;
        si

        _bump(map: Collections.MutableMap[string, int], key: string) static is
            if map.contains_key(key) then
                map[key] = map[key] + 1;
            else
                map[key] = 1;
            fi
        si

        // Rescued kills whose callee has an override that definitely
        // writes: the subset of the gain the assumption only buys by
        // being wrong.
        kill_events_rescued_unsound: int static public;
        kill_events_rescued_unprovable: int static public;
        kill_events_rescued_sound: int static public;

        // ==== necessity accounting ====
        //
        // For each killed fact, whether the callee's write set actually
        // contains the member the fact is about. `unknown` means the
        // callee's writes could not be bounded, so nothing can be said.
        facts_killed_necessary: Collections.LIST[int]? static;
        facts_killed_unnecessary: Collections.LIST[int]? static;
        facts_killed_unknown: Collections.LIST[int]? static;

        _counts(list: Collections.LIST[int]?) -> Collections.LIST[int] static is
            if list? then
                return list;
            fi

            let made = Collections.LIST[int]();

            for i in 0..VARIANTS do
                made.add(0);
            od

            return made;
        si

        // The same split restricted to kills by a property read
        // accessor.
        getter_killed_necessary: int static public;
        getter_killed_unnecessary: int static public;
        getter_killed_unknown: int static public;

        // Calls that did not kill because the callee is store-free, and
        // the heap facts that survived them.
        save_events: int static public;
        save_facts: int static public;

        // Three write-set variants, each relaxing one source of
        // conservatism, so the report can say how much of the
        // undecidability each source accounts for.
        //   0  as shipped
        //   1  whole-program: an override outside the assembly cannot exist
        //   2  the same, plus every unannotated import trusted to write nothing
        _write_sets: Collections.LIST[Collections.MutableMap[Function, Collections.SET[Symbol]]]? static;
        _write_unbounded: Collections.LIST[Collections.SET[Function]]? static;

        VARIANTS: int static => 3;

        set_write_sets(
            sets: Collections.LIST[Collections.MutableMap[Function, Collections.SET[Symbol]]],
            unbounded: Collections.LIST[Collections.SET[Function]]
        ) static is
            _write_sets = sets;
            _write_unbounded = unbounded;

            generations.add(
                WRITE_GENERATION(
                    if _next_label =~ "" then "as-shipped" else _next_label fi,
                    sets,
                    unbounded));
        si

        // Blame counts for kills that stay undecidable under the most
        // relaxed variant.
        _blame: Collections.MutableMap[Function, string]? static;
        _blame_counts: Collections.MutableMap[string, int]? static;

        set_blame(blame: Collections.MutableMap[Function, string]) static is
            _blame = blame;

            if generations.count > 0 then
                generations[generations.count - 1].blame = blame;
            fi
        si

        blame_counts: Collections.MutableMap[string, int] static is
            if !_blame_counts? then
                _blame_counts = Collections.MAP[string, int]();
            fi

            return _blame_counts;
        si

        note_call_saved(callee: Function?, live: int) static is
            if !enabled \/ live == 0 then
                return;
            fi

            save_events = save_events + 1;
            save_facts = save_facts + live;
        si

        kill_events_heap_store: int static public;
        facts_killed_heap_store: int static public;

        kill_events_member_store: int static public;
        facts_killed_member_store: int static public;

        // Whether `function` would be store-free under counterfactual
        // `mode`, computed by the analysis pass and cached here.
        // The same solver with an empty exempt set: must reproduce the
        // shipped classification exactly, and is dumped as the report's
        // control column.
        _control: Collections.SET[Function]? static;

        _optimistic_leaf: Collections.SET[Function]? static;
        _optimistic_clean: Collections.SET[Function]? static;

        set_control(control: Collections.SET[Function]) static is
            _control = control;
        si

        set_optimistic(leaf: Collections.SET[Function], clean: Collections.SET[Function]) static is
            _optimistic_leaf = leaf;
            _optimistic_clean = clean;
        si

        // Sites where the most relaxed variant can still show the
        // callee writes the very member the fact is about - the kills
        // that would become real unsoundness if calls stopped killing.
        necessary_sites: Collections.LIST[string]? static;

        note_call_kill(
            location: Source.LOCATION,
            callee: Function?,
            killed_symbols: Collections.SET[Symbol],
            killed_paths: Collections.SET[ACCESS_PATH]
        ) static is
            if !enabled then
                return;
            fi

            let killed = killed_symbols.count + killed_paths.count;

            kill_events_call = kill_events_call + 1;
            facts_killed_call = facts_killed_call + killed;

            _buffer_kill(location, callee, killed_symbols, killed_paths);

            if !callee? then
                kill_events_call_unattributed = kill_events_call_unattributed + 1;
                facts_killed_call_unattributed = facts_killed_call_unattributed + killed;
                return;
            fi

            let root = cast Function?(callee.root_specialized_from);

            if !root? then
                kill_events_call_unattributed = kill_events_call_unattributed + 1;
                facts_killed_call_unattributed = facts_killed_call_unattributed + killed;
                return;
            fi

            let record = record_for(root);

            let role =
                if !record? then
                    "not-walked"
                elif record.role =~ "" then
                    "ordinary"
                else
                    record.role
                fi;

            _bump(by_role, role);

            if
                (_optimistic_leaf? /\ _optimistic_leaf.contains(root)) \/
                (_optimistic_clean? /\ _optimistic_clean.contains(root))
            then
                _bump(by_role_preventable, role);
            fi

            if
                (_optimistic_leaf? /\ _optimistic_leaf.contains(root)) \/
                (_optimistic_clean? /\ _optimistic_clean.contains(root))
            then
                if record? /\ record.overrider_writes then
                    kill_events_rescued_unsound = kill_events_rescued_unsound + 1;
                elif record? /\ record.overrider_unprovable then
                    kill_events_rescued_unprovable = kill_events_rescued_unprovable + 1;
                else
                    kill_events_rescued_sound = kill_events_rescued_sound + 1;
                fi
            fi

            if record? /\ record.role =~ "get" then
                kill_events_call_by_getter = kill_events_call_by_getter + 1;
                facts_killed_call_by_getter = facts_killed_call_by_getter + killed;
            fi

            if _optimistic_leaf? /\ _optimistic_leaf.contains(root) then
                kill_events_call_preventable_leaf = kill_events_call_preventable_leaf + 1;
                facts_killed_call_preventable_leaf = facts_killed_call_preventable_leaf + killed;
            fi

            if _optimistic_clean? /\ _optimistic_clean.contains(root) then
                kill_events_call_preventable_clean = kill_events_call_preventable_clean + 1;
                facts_killed_call_preventable_clean = facts_killed_call_preventable_clean + killed;
            fi
        si

        // One killed fact, reduced to the member symbols whose being
        // written would justify the kill: the symbol itself for a
        // variable fact, the root and every hop for a path fact.
        // Buffered rather than classified on the spot, so the same
        // kills can be re-judged against a second, better-informed run
        // of the analysis.
        _kills: Collections.LIST[KILL_FACT]? static;

        kills: Collections.LIST[KILL_FACT] static is
            if !_kills? then
                _kills = Collections.LIST[KILL_FACT]();
            fi

            return _kills;
        si

        _buffer_kill(
            location: Source.LOCATION,
            callee: Function?,
            killed_symbols: Collections.SET[Symbol],
            killed_paths: Collections.SET[ACCESS_PATH]
        ) static is
            let record = if callee? then record_for(callee) else null fi;
            let is_getter = record? /\ record.role =~ "get";
            let root = if callee? then cast Function?(callee.root_specialized_from) else null fi;

            for v in killed_symbols do
                let members = Collections.LIST[Symbol]();

                members.add(v.root_specialized_from);
                kills.add(KILL_FACT("{location}", root, members, is_getter));
            od

            for p in killed_paths do
                let members = Collections.LIST[Symbol]();

                members.add(p.root.root_specialized_from);

                for m in p.members do
                    members.add(m.root_specialized_from);
                od

                kills.add(KILL_FACT("{location}", root, members, is_getter));
            od
        si

        // ==== write-set generations ====

        _generations: Collections.LIST[WRITE_GENERATION]? static;

        generations: Collections.LIST[WRITE_GENERATION] static is
            if !_generations? then
                _generations = Collections.LIST[WRITE_GENERATION]();
            fi

            return _generations;
        si

        // Label the run whose facts the next set_write_sets carries, and
        // clear the per-function records so the new walk's answers
        // replace the old ones rather than being discarded as duplicates.
        _next_label: string static;

        begin_generation(label: string) static is
            _next_label = label;
            _records = Collections.MAP[Function, STUDY_RECORD]();
        si

        note_heap_store_kill(killed: int) static is
            if !enabled then
                return;
            fi

            kill_events_heap_store = kill_events_heap_store + 1;
            facts_killed_heap_store = facts_killed_heap_store + killed;
        si

        note_member_store_kill(killed: int) static is
            if !enabled then
                return;
            fi

            kill_events_member_store = kill_events_member_store + 1;
            facts_killed_member_store = facts_killed_member_store + killed;
        si

        // ==== the per-function table ====

        // Written once, at the end of the compile. Two sections: a
        // header of counter lines, then one tab-separated row per
        // function the compilation walked.
        report() static is
            if !enabled \/ !_path? then
                return;
            fi

            try
                let writer = IO.StreamWriter(_path!);

                writer.write_line("# counters");
                writer.write_line("kill_events_call\t{kill_events_call}");
                writer.write_line("facts_killed_call\t{facts_killed_call}");
                writer.write_line("kill_events_call_by_getter\t{kill_events_call_by_getter}");
                writer.write_line("facts_killed_call_by_getter\t{facts_killed_call_by_getter}");
                writer.write_line("kill_events_call_preventable_leaf\t{kill_events_call_preventable_leaf}");
                writer.write_line("facts_killed_call_preventable_leaf\t{facts_killed_call_preventable_leaf}");
                writer.write_line("kill_events_call_preventable_clean\t{kill_events_call_preventable_clean}");
                writer.write_line("facts_killed_call_preventable_clean\t{facts_killed_call_preventable_clean}");
                writer.write_line("kill_events_call_unattributed\t{kill_events_call_unattributed}");
                writer.write_line("facts_killed_call_unattributed\t{facts_killed_call_unattributed}");
                for role in by_role.keys do
                    let rescued = if by_role_preventable.contains_key(role) then by_role_preventable[role] else 0 fi;
                    writer.write_line("kill_events_call_role_{role}\t{by_role[role]}\trescued\t{rescued}");
                od

                for variant in 0..VARIANTS do
                    writer.write_line(
                        "necessity_variant_{variant}\tnecessary\t{_counts(facts_killed_necessary)[variant]}"
                        "\tunnecessary\t{_counts(facts_killed_unnecessary)[variant]}"
                        "\tunknown\t{_counts(facts_killed_unknown)[variant]}");
                od
                writer.write_line("getter_killed_necessary\t{getter_killed_necessary}");
                writer.write_line("getter_killed_unnecessary\t{getter_killed_unnecessary}");
                writer.write_line("getter_killed_unknown\t{getter_killed_unknown}");
                for key in blame_counts.keys do
                    writer.write_line("blame_{key}\t{blame_counts[key]}");
                od

                // ==== stability: members never written outside a
                // constructor ====
                //
                // The written-member union, over every non-constructor
                // function's direct writes. A member outside it, if it
                // is a field or an auto-property, cannot change after
                // construction, so no call can invalidate a fact on it.
                // Writes made by constructors are excluded wholesale -
                // strictly that over-excludes a constructor writing
                // *another* object's member, but the pattern is rare.
                let written = Collections.SET[Symbol]();
                let write_wildcards mut = 0;

                for function in records.keys do
                    if function.is_constructor then
                        continue;
                    fi

                    let r = records[function];

                    for m in r.writes do
                        written.add(m);
                    od

                    if r.writes_unbounded then
                        write_wildcards = write_wildcards + 1;
                    fi
                od

                writer.write_line("stability_written_members\t{written.count}");
                writer.write_line("stability_write_wildcards\t{write_wildcards}");

                for generation in generations do
                    for variant in 0..VARIANTS do
                        let necessary mut = 0;
                        let unnecessary mut = 0;
                        let unknown mut = 0;

                        let blame_counts = Collections.MAP[string, int]();

                        let fail_ineligible mut = 0;
                        let fail_written mut = 0;

                        let exempt_necessary mut = 0;
                        let exempt_unnecessary mut = 0;
                        let exempt_unknown mut = 0;
                        let exempt_total mut = 0;

                        for kill in kills do
                            let stable_exempt = val
                                let any_ineligible mut = false;
                                let any_written mut = false;

                                for m in kill.members do
                                    if !_is_eligible_member(m) then
                                        any_ineligible = true;
                                    elif written.contains(m) then
                                        any_written = true;
                                    fi
                                od

                                if variant == VARIANTS - 1 then
                                    if any_ineligible then
                                        fail_ineligible = fail_ineligible + 1;
                                    elif any_written then
                                        fail_written = fail_written + 1;
                                    fi
                                fi

                                !any_ineligible /\ !any_written
                            lav;

                            if stable_exempt /\ variant == VARIANTS - 1 then
                                exempt_total = exempt_total + 1;
                            fi

                            let sets = generation.sets[variant];
                            let root = kill.callee;

                            let is_unbounded =
                                !root? \/
                                !sets.contains_key(root!) \/
                                generation.unbounded[variant].contains(root!);

                            if is_unbounded then
                                unknown = unknown + 1;

                                if stable_exempt /\ variant == VARIANTS - 1 then
                                    exempt_unknown = exempt_unknown + 1;
                                fi

                                if variant == VARIANTS - 1 then
                                    let blame = generation.blame;

                                    _bump(
                                        blame_counts,
                                        if root? /\ blame? /\ blame.contains_key(root!) then
                                            blame![root!]
                                        else
                                            "callee-not-walked"
                                        fi);
                                fi

                                continue;
                            fi

                            let writes = sets[root!];
                            let hit mut = false;

                            for m in kill.members do
                                if writes.contains(m) then
                                    hit = true;
                                fi
                            od

                            if hit then
                                necessary = necessary + 1;

                                if stable_exempt /\ variant == VARIANTS - 1 then
                                    exempt_necessary = exempt_necessary + 1;
                                fi

                                if variant == VARIANTS - 1 then
                                    writer.write_line("necessary_site\t{generation.label}\t{kill.location}");
                                fi
                            else
                                unnecessary = unnecessary + 1;

                                if stable_exempt /\ variant == VARIANTS - 1 then
                                    exempt_unnecessary = exempt_unnecessary + 1;
                                fi
                            fi
                        od

                        if variant == VARIANTS - 1 then
                            writer.write_line(
                                "stability\t{generation.label}"
                                "\texempt_total\t{exempt_total}"
                                "\texempt_necessary\t{exempt_necessary}"
                                "\texempt_unnecessary\t{exempt_unnecessary}"
                                "\texempt_unknown\t{exempt_unknown}"
                                "\tfail_ineligible\t{fail_ineligible}"
                                "\tfail_written\t{fail_written}");
                        fi

                        writer.write_line(
                            "necessity\t{generation.label}\tvariant{variant}"
                            "\tnecessary\t{necessary}\tunnecessary\t{unnecessary}\tunknown\t{unknown}");

                        for key in blame_counts.keys do
                            writer.write_line("blame\t{generation.label}\t{key}\t{blame_counts[key]}");
                        od
                    od
                od

                if necessary_sites? then
                    for site in necessary_sites do
                        writer.write_line("necessary_site\t{site}");
                    od
                fi

                writer.write_line("save_events\t{save_events}");
                writer.write_line("save_facts\t{save_facts}");
                writer.write_line("kill_events_rescued_sound\t{kill_events_rescued_sound}");
                writer.write_line("kill_events_rescued_unprovable\t{kill_events_rescued_unprovable}");
                writer.write_line("kill_events_rescued_unsound\t{kill_events_rescued_unsound}");
                writer.write_line("kill_events_heap_store\t{kill_events_heap_store}");
                writer.write_line("facts_killed_heap_store\t{facts_killed_heap_store}");
                writer.write_line("kill_events_member_store\t{kill_events_member_store}");
                writer.write_line("facts_killed_member_store\t{facts_killed_member_store}");

                writer.write_line(
                    "# role\towner\tname\tstore_free\tdefinitely_writes\tbody_clean\tdisqualified\taliased\t"
                    "own_stores\town_unbounded\tcallees\toverriders\topenly_dispatchable\t"
                    "declared_pure\tovr_writes\tovr_unprovable\treason\tcontrol\topt_leaf\topt_clean\tlocation");

                for function in records.keys do
                    let r = records[function];

                    writer.write_line(
                        "{r.role}\t{r.owner_name}\t{r.name}\t"
                        "{function.is_store_free}\t"
                        "{_definitely_writes? /\ _definitely_writes.contains(function)}\t"
                        "{_body_clean? /\ _body_clean.contains(function)}\t"
                        "{r.is_disqualified}\t{r.aliased}\t"
                        "{r.own_stores}\t{r.own_unbounded}\t{r.callee_count}\t{r.overrider_count}\t"
                        "{r.openly_dispatchable}\t{r.declared_pure}\t"
                        "{r.overrider_writes}\t{r.overrider_unprovable}\t{r.unbounded_reason}\t"
                        "{_control? /\ _control.contains(function)}\t"
                        "{_optimistic_leaf? /\ _optimistic_leaf.contains(function)}\t"
                        "{_optimistic_clean? /\ _optimistic_clean.contains(function)}\t"
                        "{r.location}");
                od

                writer.flush();
                writer.close();
            catch ex: System.Exception
                Std.error.write_line("narrowing study: could not write {_path}: {ex.message}");
            yrt
        si

        _definitely_writes: Collections.SET[Function]? static;
        _body_clean: Collections.SET[Function]? static;

        set_ground_truth(writes: Collections.SET[Function], clean: Collections.SET[Function]) static is
            _definitely_writes = writes;
            _body_clean = clean;
        si
    si
si
