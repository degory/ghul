namespace Syntax.Process is
    use Source;
    use Trees;

    // Records, per source file, the top-level `let` locals collected into the
    // file's synthesised entry point, keyed by variable name. A top-level
    // local is visible only to other top-level statements, so when a name
    // fails to resolve inside another function in the same file, the failure
    // can point back at the invisible local instead of reporting a bare
    // unresolved symbol.
    class TOP_LEVEL_LOCALS is
        _locals_by_file: Collections.MAP[string, Collections.MAP[string, LOCATION]];

        init() is
            _locals_by_file = Collections.MAP[string, Collections.MAP[string, LOCATION]]();
        si

        clear_file(file_name: string) is
            _locals_by_file.remove(file_name);
        si

        record(name: Identifiers.Identifier) is
            let file_name = name.location.file_name;

            let locals: Collections.MAP[string, LOCATION] mut;

            if _locals_by_file.contains_key(file_name) then
                locals = _locals_by_file[file_name];
            else
                locals = Collections.MAP[string, LOCATION]();
                _locals_by_file.add(file_name, locals);
            fi

            if !locals.contains_key(name.name) then
                locals.add(name.name, name.location);
            fi
        si

        find(file_name: string, name: string) -> LOCATION? =>
            if
                _locals_by_file.contains_key(file_name) /\
                _locals_by_file[file_name].contains_key(name)
            then
                _locals_by_file[file_name][name]
            else
                null
            fi;
    si
si
