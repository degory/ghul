namespace Syntax.Process is
    use Logging;

    use Source.LOCATION;

    // Enforces pure function-typed slots: a value reaching one must be
    // a store-free literal, a store-free or declared-pure named
    // function, or a value whose own static type is already pure.
    //
    // The test is "cannot prove store-free", not "is known to store",
    // so it is conservative and reports a warning. An unsatisfied
    // argument also drops heap facts at the call; a store does not,
    // so for a store the warning is the only signal.
    class PURE_SLOT_CHECK is
        _logger: Logger;
        _flow: NARROWING_FLOW;
        _build_flags: Compiler.GLOBAL_BUILD_FLAGS;

        init(
            logger: Logger,
            flow: NARROWING_FLOW,
            build_flags: Compiler.GLOBAL_BUILD_FLAGS
        ) is
            super.init();

            _logger = logger;
            _flow = flow;
            _build_flags = build_flags;
        si

        // Every argument of a fully-built call that lands in a pure
        // formal. Applies to any call-shaped value: an ordinary call,
        // a user-defined operator or indexer, a construction.
        //
        // `syntax_arguments` are the written argument expressions, used
        // to report against the offending argument rather than the whole
        // call. They are only trusted when their count matches the
        // built call's, so a lowering that inserts or drops an argument
        // falls back to the call's own location rather than blaming the
        // wrong one.
        check_call(
            location: LOCATION,
            value: IR.Values.Value?,
            syntax_arguments: Trees.Expressions.LIST?
        ) is
            let function: Semantic.Symbols.Function? mut = null;
            let arguments: Collections.List[IR.Values.Value]? mut = null;

            if isa IR.Values.Call.INSTANCE(value) then
                let call = cast IR.Values.Call.INSTANCE(value);
                function = call.function;
                arguments = call.arguments;
            elif isa IR.Values.Call.GLOBAL(value) then
                let call = cast IR.Values.Call.GLOBAL(value);
                function = call.function;
                arguments = call.arguments;
            elif isa IR.Values.Call.STATIC(value) then
                let call = cast IR.Values.Call.STATIC(value);
                function = call.function;
                arguments = call.arguments;
            elif isa IR.Values.Call.STRUCT(value) then
                let call = cast IR.Values.Call.STRUCT(value);
                function = call.function;
                arguments = call.arguments;
            else
                return;
            fi

            let formals = function.arguments;

            for i in 0..formals.count do
                if i >= arguments.count then
                    return;
                fi

                if formals[i].is_pure_function /\ !is_satisfied(arguments[i]) then
                    if !_build_flags.no_warn_impure_function_value then
                        _logger.warn(
                            _argument_location(syntax_arguments, i, arguments.count, location),
                            "impure-function-value",
                            "argument must be a pure function"
                        );
                    fi

                    _flow.on_call(location);
                fi
            od
        si

        _argument_location(
            syntax_arguments: Trees.Expressions.LIST?,
            index: int,
            count: int,
            fallback: LOCATION
        ) -> LOCATION =>
            if syntax_arguments? /\ syntax_arguments.count == count then
                syntax_arguments.expressions[index].location
            else
                fallback
            fi;

        // A value stored into a slot whose type is a pure function
        // type. The slot's type is a claim that it holds store-free
        // values, and is trusted wherever the slot is read, so the
        // store is where the value has to be shown store-free.
        check_store(location: LOCATION, target_type: Semantic.Types.Type?, value: IR.Values.Value?) is
            if
                target_type? /\ target_type.is_pure_function /\
                !is_satisfied(value) /\
                !_build_flags.no_warn_impure_function_value
            then
                _logger.warn(location, "impure-function-value", "value must be a pure function");
            fi
        si

        is_satisfied(argument: IR.Values.Value?) -> bool is
            if !argument? then
                return true;
            fi

            // A reference is typed with the type of the slot it is
            // read into, so where it names a known function that
            // function's own store-free bit decides.
            if let function = argument.referenced_function then
                return _is_store_free(function);
            fi

            if argument.has_symbol then
                let symbol = argument.symbol;

                if isa Semantic.Symbols.Function(symbol) then
                    return _is_store_free(cast Semantic.Symbols.Function(symbol));
                elif isa Semantic.Symbols.Variable(symbol) /\ symbol.type? /\ symbol.type.is_pure_function then
                    return true;
                fi
            fi

            return argument.type? /\ argument.type!.is_pure_function;
        si

        // A literal is answered by what its body did, since
        // infer-store-free only covers named functions; a named
        // function by its store-free bit, which a `pure` declaration
        // sets without the body being provable.
        _is_store_free(function: Semantic.Symbols.Function) -> bool =>
            if isa Semantic.Symbols.Closure(function) then
                function.is_store_free \/ !function.literal_body_impure
            else
                function.is_store_free
            fi;
    si
si
