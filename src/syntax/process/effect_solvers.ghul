namespace Syntax.Process is
    use Function = Semantic.Symbols.Function;
    use Symbol = Semantic.Symbols.Symbol;
    use Semantic.Symbols.STORE_FREE_IMPORTS;

    // Counterfactual solvers over the same facts STORE_FREE_FIXPOINT
    // consumes, run only when the study is enabled. Nothing here writes
    // a store-free bit; each solver hands back a set the study reports
    // against.
    class EFFECT_SOLVERS is
        _facts: Collections.MutableMap[Function, STORE_FREE_FACTS];

        // Functions that invoke a function-typed parameter, directly
        // or by forwarding one to something that does. Their write
        // sets absorb the write sets of every function value passed
        // to them at any recorded call site.
        _param_invokers: Collections.SET[Function]?;

        init(facts: Collections.MutableMap[Function, STORE_FREE_FACTS]) is
            _facts = facts;
        si

        param_invokers: Collections.SET[Function] is
            if _param_invokers? then
                return _param_invokers!;
            fi

            let invokers = Collections.SET[Function]();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if record? /\ record.invokes_function_param then
                    invokers.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if invokers.contains(function) then
                        continue;
                    fi

                    let record = EFFECT_FACTS.record_for(function);

                    if !record? then
                        continue;
                    fi

                    for target in record.forwards_param_to do
                        if invokers.contains(target) then
                            invokers.add(function);
                            changed = true;
                        fi
                    od
                od
            od

            _param_invokers = invokers;

            return invokers;
        si

        // Lower bound on "writes a pre-existing heap slot": the body
        // performs a write, or a bounded callee does. Unboundable
        // constructs contribute nothing, so membership means the write
        // is real rather than merely unruled-out.
        definitely_writes() -> Collections.SET[Function] is
            let writes = Collections.SET[Function]();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if record? /\ record.own_stores then
                    writes.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if writes.contains(function) then
                        continue;
                    fi

                    if _any_callee_in(function, writes) then
                        writes.add(function);
                        changed = true;
                    fi
                od
            od

            return writes;
        si

        _any_callee_in(function: Function, set: Collections.SET[Function]) -> bool is
            for callee in _facts[function].callees do
                if set.contains(callee) then
                    return true;
                fi
            od

            return false;
        si

        // Upper bound on "provably writes nothing": the body neither
        // writes nor gives up, and every bounded callee is itself clean
        // or a trusted import. The dispatch shadow is ignored
        // altogether, so membership is a statement about the code that
        // is actually written rather than about what an override might
        // do.
        body_clean() -> Collections.SET[Function] is
            let unclean = Collections.SET[Function]();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if !record? \/ record.own_stores \/ record.own_unbounded then
                    unclean.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if unclean.contains(function) then
                        continue;
                    fi

                    if !_callees_clean(function, unclean) then
                        unclean.add(function);
                        changed = true;
                    fi
                od
            od

            let clean = Collections.SET[Function]();

            for function in _facts.keys do
                if !unclean.contains(function) then
                    clean.add(function);
                fi
            od

            return clean;
        si

        _callees_clean(function: Function, unclean: Collections.SET[Function]) -> bool is
            for callee in _facts[function].callees do
                if !_leaf_target_clean(callee, unclean) then
                    return false;
                fi
            od

            for callee in _facts[function].construction_callees do
                if !_leaf_target_clean(callee, unclean) then
                    return false;
                fi
            od

            return true;
        si

        _leaf_target_clean(target: Function, unclean: Collections.SET[Function]) -> bool is
            if target.is_declared_pure then
                return true;
            fi

            if _facts.contains_key(target) then
                return !unclean.contains(target);
            fi

            return STORE_FREE_IMPORTS.is_store_free(target);
        si

        // The production relation, solved by STORE_FREE_FIXPOINT itself
        // so the study cannot drift from it, with the dispatch shadow
        // skipped for every function in `exempt`. An empty exempt set
        // reproduces the shipped answer exactly, which is the control
        // the report checks.
        solve(exempt: Collections.SET[Function]) -> Collections.SET[Function] is
            let unsafe = STORE_FREE_FIXPOINT().solve(_facts, exempt).unsafe;

            let safe = Collections.SET[Function]();

            for function in _facts.keys do
                if !unsafe.contains(function) then
                    safe.add(function);
                fi
            od

            return safe;
        si

        // What each function may write, at member-symbol granularity:
        // its own writes, plus those of everything it can dispatch to.
        // `unbounded` names the functions for which no such set exists
        // - the walk lost track, a callee was not walked, or an
        // override outside the compilation could write anything.
        //
        // Receiver-blind, exactly as NARROWING_FLOW.on_member_store is:
        // a write to `other.f` and one to `self.f` are the same entry,
        // because the two receivers may alias.
        write_sets(close_open: bool, trust_imports: bool) -> (
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function]
        ) is
            let sets = Collections.MAP[Function, Collections.SET[Symbol]]();
            let unbounded = Collections.SET[Function]();
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let set = Collections.SET[Symbol]();
                let record = EFFECT_FACTS.record_for(function);

                if record? then
                    for member in record.writes do
                        set.add(member);
                    od

                    if record.writes_unbounded then
                        unbounded.add(function);
                    fi
                else
                    unbounded.add(function);
                fi

                // An override in another assembly could write anything.
                // `close_open` drops that, which is the whole-program
                // assumption a self-contained program like the compiler
                // could legitimately make.
                if !close_open /\ shadow.is_openly_dispatchable(function) then
                    unbounded.add(function);
                fi

                sets[function] = set;
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    let set = sets[function];
                    let before = set.count;
                    let was_unbounded = unbounded.contains(function);

                    if _absorb(function, sets, unbounded, trust_imports) then
                        changed = true;
                    fi

                    if !was_unbounded /\ unbounded.contains(function) then
                        changed = true;
                    fi

                    if set.count != before then
                        changed = true;
                    fi
                od
            od

            return (sets = sets, unbounded = unbounded);
        si

        // Pull every dispatch target's writes into `function`'s set.
        // Returns whether the function became unbounded.
        _absorb(
            function: Function,
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            // Once unbounded, nothing more can change: queries answer
            // conservatively without reading the member set, and
            // callers read only the unbounded flag.
            if unbounded.contains(function) then
                return false;
            fi

            let became mut = false;

            for callee in _facts[function].callees do
                if _absorb_target(function, callee, sets, unbounded, trust_imports) then
                    became = true;
                fi
            od

            for callee in _facts[function].construction_callees do
                if _absorb_target(function, callee, sets, unbounded, trust_imports) then
                    became = true;
                fi
            od

            // Effect-polymorphic absorption: an invoked function-typed
            // parameter is bounded by the values recorded flowing in
            // at the function's call sites; a value nothing could name
            // makes the invocation unboundable after all.
            if param_invokers.contains(function) then
                if EFFECT_FACTS.passed_opaque.contains(function) then
                    if !unbounded.contains(function) then
                        unbounded.add(function);
                        became = true;
                    fi
                else
                    let passed = EFFECT_FACTS.passed_functions_for(function);

                    if passed? then
                        for value in passed do
                            if _absorb_target(function, value, sets, unbounded, trust_imports) then
                                became = true;
                            fi
                        od
                    fi
                fi
            fi

            let overriders = function.overriders;

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        if !unbounded.contains(function) then
                            unbounded.add(function);
                            became = true;
                        fi

                        continue;
                    fi

                    if _absorb_target(function, cast Function(overrider), sets, unbounded, trust_imports) then
                        became = true;
                    fi
                od
            fi

            return became;
        si

        _absorb_target(
            function: Function,
            target: Function,
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            if target.is_declared_pure then
                return false;
            fi

            if !sets.contains_key(target) then
                // not walked here: a trusted store-free import writes
                // nothing, a receiver-interior mutator writes only its
                // own receiver's internal state - never a ghul member -
                // and anything else could write anything
                if
                    trust_imports \/
                    STORE_FREE_IMPORTS.is_store_free(target) \/
                    target.writes_only_receiver_interior
                then
                    return false;
                fi

                unbounded.add(function);
                return true;
            fi

            if unbounded.contains(target) then
                // the caller's members no longer matter either, so
                // skip the union
                unbounded.add(function);
                return true;
            fi

            let function_set = sets[function];

            for member in sets[target] do
                function_set.add(member);
            od

            return false;
        si

        // Functions whose transitive effect is at most element stores:
        // no member writes, nothing unboundable, dispatch bounded, every
        // reachable callee the same (or store-free / trusted). A call to
        // one can change no field, so field-only facts survive it under
        // the element-rescue rule.
        element_only(trust_imports: bool) -> Collections.SET[Function] is
            let unsafe = Collections.SET[Function]();
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if
                    !record? \/
                    record.writes.count > 0 \/
                    record.writes_unbounded \/
                    record.own_unbounded \/
                    shadow.is_openly_dispatchable(function)
                then
                    unsafe.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if unsafe.contains(function) then
                        continue;
                    fi

                    if !_element_dependencies_safe(function, unsafe, trust_imports) then
                        unsafe.add(function);
                        changed = true;
                    fi
                od
            od

            let safe = Collections.SET[Function]();

            for function in _facts.keys do
                if !unsafe.contains(function) then
                    safe.add(function);
                fi
            od

            return safe;
        si

        _element_dependencies_safe(
            function: Function,
            unsafe: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            for callee in _facts[function].callees do
                if !_element_target_safe(callee, unsafe, trust_imports) then
                    return false;
                fi
            od

            for callee in _facts[function].construction_callees do
                if !_element_target_safe(callee, unsafe, trust_imports) then
                    return false;
                fi
            od

            let overriders = function.overriders;

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        return false;
                    fi

                    let overrider_function = cast Function(overrider);

                    if !_facts.contains_key(overrider_function) \/ unsafe.contains(overrider_function) then
                        return false;
                    fi
                od
            fi

            return true;
        si

        _element_target_safe(
            target: Function,
            unsafe: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            if target.is_declared_pure then
                return true;
            fi

            if _facts.contains_key(target) then
                return !unsafe.contains(target);
            fi

            return trust_imports \/ STORE_FREE_IMPORTS.is_store_free(target);
        si

        // Functions that provably never assign a possibly-absent value
        // to anything a pre-existing presence fact could be about:
        // their own assignments store only declared-non-optional values
        // (constructor writes to the fresh instance excepted), and
        // everything they can dispatch to does the same. Imports are
        // trusted when `trust_imports` - imported code cannot assign a
        // ghul member at all except by re-entering ghul code, which the
        // walked side of the closure covers; delegate-invoking imports
        // are the leak that flag papers over.
        never_nulls(trust_imports: bool) -> Collections.SET[Function] is
            let nulling = Collections.SET[Function]();
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if
                    !record? \/
                    record.assigns_optional \/
                    shadow.is_openly_dispatchable(function)
                then
                    nulling.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if nulling.contains(function) then
                        continue;
                    fi

                    if !_never_nulls_dependencies_ok(function, nulling, trust_imports) then
                        nulling.add(function);
                        changed = true;
                    fi
                od
            od

            let safe = Collections.SET[Function]();

            for function in _facts.keys do
                if !nulling.contains(function) then
                    safe.add(function);
                fi
            od

            return safe;
        si

        _never_nulls_dependencies_ok(
            function: Function,
            nulling: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            for callee in _facts[function].callees do
                if !_never_nulls_target_ok(callee, nulling, trust_imports) then
                    return false;
                fi
            od

            for callee in _facts[function].construction_callees do
                if !_never_nulls_target_ok(callee, nulling, trust_imports) then
                    return false;
                fi
            od

            let overriders = function.overriders;

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        return false;
                    fi

                    let overrider_function = cast Function(overrider);

                    if !_facts.contains_key(overrider_function) \/ nulling.contains(overrider_function) then
                        return false;
                    fi
                od
            fi

            return true;
        si

        _never_nulls_target_ok(
            target: Function,
            nulling: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            if target.is_declared_pure then
                return true;
            fi

            if _facts.contains_key(target) then
                return !nulling.contains(target);
            fi

            return trust_imports \/ STORE_FREE_IMPORTS.is_store_free(target);
        si

        // The member-keyed may-null relation: which members each
        // function (or anything it dispatches to) may assign a
        // possibly-absent value. Open dispatch makes the set
        // unboundable.
        //
        // `trust_imports` selects the import model. Trusted, an
        // unwalked callee contributes nothing, on the argument that
        // imported code cannot assign a ghul member except by
        // re-entering ghul code - an argument with a known leak
        // (delegate re-entry), so it is a measurement configuration
        // only. Untrusted - the production setting - an unwalked
        // callee that is not declared pure and not on the curated
        // store-free whitelist makes the caller unboundable.
        may_null_sets(close_open: bool, trust_imports: bool) -> (
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function]
        ) is
            let sets = Collections.MAP[Function, Collections.SET[Symbol]]();
            let unbounded = Collections.SET[Function]();
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let set = Collections.SET[Symbol]();
                let record = EFFECT_FACTS.record_for(function);

                if record? then
                    for m in record.nulling_writes do
                        set.add(m);
                    od

                    // an unbounded write could write null just as well
                    // as it could write anything else, so the nulling
                    // set is only a bound where the write set is
                    if record.nulling_unbounded \/ record.writes_unbounded then
                        unbounded.add(function);
                    fi
                else
                    unbounded.add(function);
                fi

                if !close_open /\ shadow.is_openly_dispatchable(function) then
                    unbounded.add(function);
                fi

                sets[function] = set;
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if _absorb_nulling(function, sets, unbounded, trust_imports) then
                        changed = true;
                    fi
                od
            od

            return (sets = sets, unbounded = unbounded);
        si

        _absorb_nulling(
            function: Function,
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            // Once unbounded, nothing more can change - see _absorb.
            if unbounded.contains(function) then
                return false;
            fi

            let became mut = false;

            for callee in _facts[function].callees do
                if _absorb_nulling_target(function, callee, sets, unbounded, trust_imports) then
                    became = true;
                fi
            od

            for callee in _facts[function].construction_callees do
                if _absorb_nulling_target(function, callee, sets, unbounded, trust_imports) then
                    became = true;
                fi
            od

            if param_invokers.contains(function) then
                if EFFECT_FACTS.passed_opaque.contains(function) then
                    if !unbounded.contains(function) then
                        unbounded.add(function);
                        became = true;
                    fi
                else
                    let passed = EFFECT_FACTS.passed_functions_for(function);

                    if passed? then
                        for value in passed do
                            if _absorb_nulling_target(function, value, sets, unbounded, trust_imports) then
                                became = true;
                            fi
                        od
                    fi
                fi
            fi

            let overriders = function.overriders;

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        if !unbounded.contains(function) then
                            unbounded.add(function);
                            became = true;
                        fi

                        continue;
                    fi

                    if _absorb_nulling_target(function, cast Function(overrider), sets, unbounded, trust_imports) then
                        became = true;
                    fi
                od
            fi

            return became;
        si

        _absorb_nulling_target(
            function: Function,
            target: Function,
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            trust_imports: bool
        ) -> bool is
            if target.is_declared_pure then
                return false;
            fi

            if !sets.contains_key(target) then
                // Same tiers as _absorb_target; a receiver-interior
                // mutator cannot assign a ghul member at all, null or
                // otherwise.
                if
                    trust_imports \/
                    STORE_FREE_IMPORTS.is_store_free(target) \/
                    target.writes_only_receiver_interior
                then
                    return false;
                fi

                unbounded.add(function);
                return true;
            fi

            if unbounded.contains(target) then
                // the caller's members no longer matter either, so
                // skip the union
                unbounded.add(function);
                return true;
            fi

            let became mut = false;
            let function_set = sets[function];

            for m in sets[target] do
                if !function_set.contains(m) then
                    function_set.add(m);
                    became = true;
                fi
            od

            return became;
        si

        // The member read closure: which members each function - or
        // anything it can dispatch to or invoke - may read, plus
        // whether it may read or write collection/array elements.
        // Consumed by the reliance judge for facts read through a
        // getter: a crossing callee whose write set is disjoint from
        // the getter's read closure provably leaves the getter's
        // answer alone. An unwalked callee makes the reads
        // unboundable, except the curated import tiers: a store-free
        // import reads only its receiver's interior, and a
        // receiver-interior mutator additionally writes it.
        read_sets() -> (
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            reads_elements: Collections.SET[Function],
            writes_elements: Collections.SET[Function]
        ) is
            let sets = Collections.MAP[Function, Collections.SET[Symbol]]();
            let unbounded = Collections.SET[Function]();
            let reads_elements = Collections.SET[Function]();
            let writes_elements = Collections.SET[Function]();
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let set = Collections.SET[Symbol]();
                let record = EFFECT_FACTS.record_for(function);

                if record? then
                    for m in record.reads do
                        set.add(m);
                    od

                    if record.reads_elements then
                        reads_elements.add(function);
                    fi

                    if record.writes_elements then
                        writes_elements.add(function);
                    fi

                    if record.own_unbounded \/ record.writes_unbounded then
                        unbounded.add(function);
                    fi
                else
                    unbounded.add(function);
                fi

                if shadow.is_openly_dispatchable(function) then
                    unbounded.add(function);
                    writes_elements.add(function);
                fi

                sets[function] = set;
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if _absorb_reads(function, sets, unbounded, reads_elements, writes_elements) then
                        changed = true;
                    fi
                od
            od

            return (sets = sets, unbounded = unbounded, reads_elements = reads_elements, writes_elements = writes_elements);
        si

        _absorb_reads(
            function: Function,
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            reads_elements: Collections.SET[Function],
            writes_elements: Collections.SET[Function]
        ) -> bool is
            let became mut = false;

            for callee in _facts[function].callees do
                if _absorb_reads_target(function, callee, sets, unbounded, reads_elements, writes_elements) then
                    became = true;
                fi
            od

            for callee in _facts[function].construction_callees do
                if _absorb_reads_target(function, callee, sets, unbounded, reads_elements, writes_elements) then
                    became = true;
                fi
            od

            if param_invokers.contains(function) then
                if EFFECT_FACTS.passed_opaque.contains(function) then
                    became = _add_once(unbounded, function) \/ became;
                    became = _add_once(writes_elements, function) \/ became;
                else
                    let passed = EFFECT_FACTS.passed_functions_for(function);

                    if passed? then
                        for value in passed do
                            if _absorb_reads_target(function, value, sets, unbounded, reads_elements, writes_elements) then
                                became = true;
                            fi
                        od
                    fi
                fi
            fi

            let overriders = function.overriders;

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        became = _add_once(unbounded, function) \/ became;
                        became = _add_once(writes_elements, function) \/ became;

                        continue;
                    fi

                    if _absorb_reads_target(function, cast Function(overrider), sets, unbounded, reads_elements, writes_elements) then
                        became = true;
                    fi
                od
            fi

            return became;
        si

        _absorb_reads_target(
            function: Function,
            target: Function,
            sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            unbounded: Collections.SET[Function],
            reads_elements: Collections.SET[Function],
            writes_elements: Collections.SET[Function]
        ) -> bool is
            let became mut = false;

            if !sets.contains_key(target) then
                // not walked here. A curated store-free import reads
                // only its receiver's interior; a receiver-interior
                // mutator also writes it. A declared-pure import
                // stores nothing but can read anything; everything
                // else could do either.
                if STORE_FREE_IMPORTS.is_store_free(target) then
                    became = _add_once(reads_elements, function);
                elif target.writes_only_receiver_interior then
                    became = _add_once(reads_elements, function) \/ became;
                    became = _add_once(writes_elements, function) \/ became;
                elif target.is_declared_pure then
                    became = _add_once(unbounded, function);
                else
                    became = _add_once(unbounded, function) \/ became;
                    became = _add_once(writes_elements, function) \/ became;
                fi

                return became;
            fi

            if unbounded.contains(target) then
                became = _add_once(unbounded, function) \/ became;
            elif !unbounded.contains(function) then
                // the member union matters only while both closures
                // are still bounded - an unbounded closure answers
                // null whatever its set holds. The element flags
                // below still propagate regardless, because
                // may_write_elements consults them independently of
                // the read closure.
                let function_set = sets[function];

                for m in sets[target] do
                    if !function_set.contains(m) then
                        function_set.add(m);
                        became = true;
                    fi
                od
            fi

            if reads_elements.contains(target) then
                became = _add_once(reads_elements, function) \/ became;
            fi

            if writes_elements.contains(target) then
                became = _add_once(writes_elements, function) \/ became;
            fi

            return became;
        si

        _add_once(set: Collections.SET[Function], function: Function) -> bool static is
            if set.contains(function) then
                return false;
            fi

            set.add(function);
            return true;
        si

        // For each function whose write set cannot be bounded, what to
        // blame: its own give-up reason if it has one, otherwise the
        // reason of something it can reach. Answers "what would the
        // walk have to model for this kill to become decidable?".
        blame(close_open: bool, trust_imports: bool) -> Collections.MutableMap[Function, string] is
            let blamed = Collections.MAP[Function, string]();
            let shadow = STORE_FREE_FIXPOINT();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if record? /\ !(record.unbounded_reason =~ "") then
                    blamed[function] = record.unbounded_reason;
                elif record? /\ record.writes_unbounded then
                    blamed[function] = "write-target-unresolved";
                elif param_invokers.contains(function) /\ EFFECT_FACTS.passed_opaque.contains(function) then
                    blamed[function] = "param-values-opaque";
                elif !close_open /\ shadow.is_openly_dispatchable(function) then
                    blamed[function] = "open-dispatch";
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if blamed.contains_key(function) then
                        continue;
                    fi

                    let reached = _blame_of(function, blamed, trust_imports);

                    if reached? then
                        blamed[function] = reached;
                        changed = true;
                    fi
                od
            od

            return blamed;
        si

        _blame_of(
            function: Function,
            blamed: Collections.MutableMap[Function, string],
            trust_imports: bool
        ) -> string? is
            for callee in _facts[function].callees do
                let r = _blame_target(callee, blamed, trust_imports);

                if r? then
                    return r;
                fi
            od

            for callee in _facts[function].construction_callees do
                let r = _blame_target(callee, blamed, trust_imports);

                if r? then
                    return r;
                fi
            od

            let overriders = function.overriders;

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        return "overrider-not-a-function";
                    fi

                    let r = _blame_target(cast Function(overrider), blamed, trust_imports);

                    if r? then
                        return r;
                    fi
                od
            fi

            return null;
        si

        _blame_target(
            target: Function,
            blamed: Collections.MutableMap[Function, string],
            trust_imports: bool
        ) -> string? is
            if target.is_declared_pure then
                return null;
            fi

            if !_facts.contains_key(target) then
                if trust_imports \/ STORE_FREE_IMPORTS.is_store_free(target) then
                    return null;
                fi

                return "imported:{target.qualified_name}";
            fi

            if blamed.contains_key(target) then
                return blamed[target];
            fi

            return null;
        si

        // The exempt set for a counterfactual: property read accessors
        // whose own body is clean, optionally restricted to those that
        // call nothing at all.
        exempt_getters(leaf_only: bool) -> Collections.SET[Function] is
            let set = Collections.SET[Function]();

            for function in _facts.keys do
                let record = EFFECT_FACTS.record_for(function);

                if !record? \/ !(record.role =~ "get") then
                    continue;
                fi

                if _facts[function].is_disqualified then
                    continue;
                fi

                if leaf_only /\ _facts[function].callees.count > 0 then
                    continue;
                fi

                set.add(function);
            od

            return set;
        si
    si
si
