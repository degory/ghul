namespace Syntax.Process is
    use Function = Semantic.Symbols.Function;
    use Semantic.Symbols.STORE_FREE_IMPORTS;

    // Counterfactual solvers over the same facts STORE_FREE_FIXPOINT
    // consumes, run only when the study is enabled. Nothing here writes
    // a store-free bit; each solver hands back a set the study reports
    // against.
    class STORE_FREE_STUDY is
        _facts: Collections.MutableMap[Function, STORE_FREE_FACTS];

        init(facts: Collections.MutableMap[Function, STORE_FREE_FACTS]) is
            _facts = facts;
        si

        // Lower bound on "writes a pre-existing heap slot": the body
        // performs a write, or a bounded callee does. Unboundable
        // constructs contribute nothing, so membership means the write
        // is real rather than merely unruled-out.
        definitely_writes() -> Collections.SET[Function] is
            let writes = Collections.SET[Function]();

            for function in _facts.keys do
                let record = NARROWING_STUDY.record_for(function);

                if record? /\ record.own_stores then
                    writes.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if writes.contains(function) then
                        continue;
                    fi

                    if _any_callee_in(function, writes) then
                        writes.add(function);
                        changed = true;
                    fi
                od
            od

            return writes;
        si

        _any_callee_in(function: Function, set: Collections.SET[Function]) -> bool is
            for callee in _facts[function].callees do
                if set.contains(callee) then
                    return true;
                fi
            od

            return false;
        si

        // Upper bound on "provably writes nothing": the body neither
        // writes nor gives up, and every bounded callee is itself clean
        // or a trusted import. The dispatch shadow is ignored
        // altogether, so membership is a statement about the code that
        // is actually written rather than about what an override might
        // do.
        body_clean() -> Collections.SET[Function] is
            let unclean = Collections.SET[Function]();

            for function in _facts.keys do
                let record = NARROWING_STUDY.record_for(function);

                if !record? \/ record.own_stores \/ record.own_unbounded then
                    unclean.add(function);
                fi
            od

            let changed mut = true;

            while changed do
                changed = false;

                for function in _facts.keys do
                    if unclean.contains(function) then
                        continue;
                    fi

                    if !_callees_clean(function, unclean) then
                        unclean.add(function);
                        changed = true;
                    fi
                od
            od

            let clean = Collections.SET[Function]();

            for function in _facts.keys do
                if !unclean.contains(function) then
                    clean.add(function);
                fi
            od

            return clean;
        si

        _callees_clean(function: Function, unclean: Collections.SET[Function]) -> bool is
            for callee in _facts[function].callees do
                if !_leaf_target_clean(callee, unclean) then
                    return false;
                fi
            od

            for callee in _facts[function].construction_callees do
                if !_leaf_target_clean(callee, unclean) then
                    return false;
                fi
            od

            return true;
        si

        _leaf_target_clean(target: Function, unclean: Collections.SET[Function]) -> bool is
            if target.is_declared_pure then
                return true;
            fi

            if _facts.contains_key(target) then
                return !unclean.contains(target);
            fi

            return STORE_FREE_IMPORTS.is_store_free(target);
        si

        // The production relation, solved by STORE_FREE_FIXPOINT itself
        // so the study cannot drift from it, with the dispatch shadow
        // skipped for every function in `exempt`. An empty exempt set
        // reproduces the shipped answer exactly, which is the control
        // the report checks.
        solve(exempt: Collections.SET[Function]) -> Collections.SET[Function] is
            let unsafe = STORE_FREE_FIXPOINT().solve(_facts, exempt).unsafe;

            let safe = Collections.SET[Function]();

            for function in _facts.keys do
                if !unsafe.contains(function) then
                    safe.add(function);
                fi
            od

            return safe;
        si

        // The exempt set for a counterfactual: property read accessors
        // whose own body is clean, optionally restricted to those that
        // call nothing at all.
        exempt_getters(leaf_only: bool) -> Collections.SET[Function] is
            let set = Collections.SET[Function]();

            for function in _facts.keys do
                let record = NARROWING_STUDY.record_for(function);

                if !record? \/ !(record.role =~ "get") then
                    continue;
                fi

                if _facts[function].is_disqualified then
                    continue;
                fi

                if leaf_only /\ _facts[function].callees.count > 0 then
                    continue;
                fi

                set.add(function);
            od

            return set;
        si
    si
si
