namespace Syntax.Process is
    // Which terminal pipe consumer a call names, if any.
    //
    // The recognizer matches the combinator by its source-level name,
    // so a rename in the runtime library silently stops a chain fusing:
    // the call still compiles, and still produces the same results
    // through the unfused Pipe objects, so only a test that pins the
    // recognition itself can catch the drift.
    //
    // The returned kind is what `FUSED_CONSUMER` switches on, and is
    // not always the method name - `collect_list` fuses as `collect`.
    class PIPE_CONSUMER_KIND is
        of(name: string?, argument_count: int) -> string? static is
            if !name? then
                return null;
            fi

            if name =~ "count" /\ argument_count == 0 then
                return "count";
            elif name =~ "any" /\ argument_count == 1 then
                return "any";
            elif name =~ "all" /\ argument_count == 1 then
                return "all";
            elif name =~ "each" /\ argument_count == 1 then
                return "each";
            elif name =~ "reduce" /\ argument_count == 2 then
                return "reduce";
            elif name =~ "find" /\ argument_count == 1 then
                return "find";
            elif name =~ "first" /\ argument_count == 0 then
                return "first";
            elif name =~ "collect_list" /\ argument_count == 0 then
                return "collect";
            fi

            return null;
        si

        // A consumer that takes a function argument, and so needs the
        // fused loop to invoke it per element.
        takes_function(consumer_kind: string?) -> bool static =>
            consumer_kind =~ "any" \/ consumer_kind =~ "all" \/
            consumer_kind =~ "each" \/ consumer_kind =~ "find";

        // A consumer that produces no value.
        is_void(consumer_kind: string?) -> bool static =>
            consumer_kind =~ "each";
    si
si
