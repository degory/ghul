namespace Syntax.Process is
    // Collects the variables written within a walked subtree - by
    // assignment (`=`, including destructuring) or by being passed
    // `ref`. Two consumers: the loop kill-set, where a narrow on a
    // variable the body writes cannot be assumed across the
    // back-edge, and the entry to a finally body, where a narrow
    // proven before the try survives what the try did not write.
    //
    // Both a name and, where the walked subtree has been compiled,
    // the written symbol are recorded. The symbols are what a
    // consumer should ask, since two locals can share a name; a
    // consumer that reads them must also honour
    // `saw_unresolved_write`, which says a write was seen whose
    // symbol was not available and so is absent from the set.
    //
    // A `Visitor` whose default per-node visits are no-ops, so only
    // ASSIGNMENT and REFERENCE need overriding; default `pre`
    // returns false, so the framework descends through everything.
    class LOOP_ASSIGNMENT_COLLECTOR: Visitor is
        names: Collections.SET[string] public
        symbols: Collections.SET[Semantic.Symbols.Symbol] public
        saw_unresolved_write: bool public

        init() is
            super.init()
            names = Collections.SET[string]()
            symbols = Collections.SET[Semantic.Symbols.Symbol]()
        si

        visit(assignment: Trees.Statements.ASSIGNMENT) is
            let targets = Collections.LIST[Trees.Expressions.Expression]()
            assignment.left.get_names_into(targets)

            for target in targets do
                _collect(target)
            od
        si

        visit(reference: Trees.Expressions.REFERENCE) is
            // `x ref` — a `ref` argument may be written by the callee.
            _collect(reference.left)
        si

        _collect(expr: Trees.Expressions.Expression) is
            if !isa Trees.Expressions.IDENTIFIER(expr) then
                return
            fi

            let identifier = expr

            names.add(identifier.identifier.name)

            if let value = identifier.value /\ value.has_symbol then
                symbols.add(value.symbol)
            else
                saw_unresolved_write = true
            fi
        si
    si
si
