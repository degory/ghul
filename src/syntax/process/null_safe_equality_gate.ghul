namespace Syntax.Process is
    use Semantic.Types.Type;

    // Whether `a =~ b` gets its null checks written around the call.
    //
    // Each decline leaves the operands resolving exactly as they did
    // before, so getting one wrong is a silent change of meaning rather
    // than a compile failure: the call still builds and still answers,
    // just from the wrong place.
    class NULL_SAFE_EQUALITY_GATE is
        // The operands have to include something absent to test, and
        // both have to be references. A `NULLABLE[T]` or `MAYBE[T]`
        // carries presence in a field rather than in the reference, so
        // it needs a payload extract rather than a branch on the value.
        accepts_operands(left_type: Type?, right_type: Type?) -> bool static is
            if !left_type? \/ !right_type? then
                return false;
            fi

            if left_type.is_error \/ right_type.is_error then
                return false;
            fi

            if !left_type.is_optional /\ !right_type.is_optional then
                return false;
            fi

            return !left_type.is_value_type /\ !right_type.is_value_type;
        si

        // The operator has to be one the lowering can call at all: an
        // instance member of one parameter. One hidden from operator
        // resolution is not what the expression calls in the first
        // place, so it is left alone entirely.
        accepts_operator(function: Semantic.Symbols.Function?) -> bool static is
            if !function? then
                return false;
            fi

            if !function.is_instance \/ function.is_hidden_from_operator_resolution then
                return false;
            fi

            return function.arguments? /\ function.arguments.count == 1;
        si

        // Whether the absent *argument* is answered here rather than by
        // the operator. An operator declaring its parameter optional is
        // written to answer for one itself, so it is handed the value
        // and decides.
        //
        // The absent *receiver* is never its decision: there is nothing
        // to dispatch on, so that arm is always answered here.
        guards_argument(function: Semantic.Symbols.Function?) -> bool static is
            if !accepts_operator(function) then
                return false;
            fi

            let argument = function!.arguments[0];

            return argument? /\ !argument.is_optional;
        si
    si
si
