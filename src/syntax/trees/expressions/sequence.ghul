namespace Syntax.Trees.Expressions is

    use Source

    class SEQUENCE: Expression  is
        elements: LIST
        type_expression: TypeExpressions.TypeExpression

        init(location: LOCATION, elements: LIST, type_expression: TypeExpressions.TypeExpression) is
            super.init(location)


            self.elements = elements
            self.type_expression = type_expression
        si

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message)
        si

        // A list literal written as the target of an assignment is a sequence
        // pattern: each element is a target, and a trailing `..target`
        // takes the rest.
        rewrite_as_assignment_left() -> AssignmentLeftExpression is
            let result = Collections.LIST[AssignmentLeftExpression](elements.expressions.count)

            for element in elements.expressions do
                if let rest: UNARY = element then
                    if rest.operation.name =~ ".." then
                        let target = SIMPLE_LEFT_EXPRESSION(rest.location, rest.right.rewrite_as_expression())

                        target.is_rest = true
                        result.add(target)

                        continue
                    fi
                fi

                let expression = element.rewrite_as_expression()

                if element.is_tuple_literal \/ isa SEQUENCE(element) then
                    result.add(expression.rewrite_as_assignment_left())
                else
                    result.add(SIMPLE_LEFT_EXPRESSION(element.location, expression))
                fi
            od

            let destructure = DESTRUCTURING_LEFT_EXPRESSION(location, result)

            destructure.is_sequence = true

            return destructure
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                elements.walk(visitor)
                type_expression.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
