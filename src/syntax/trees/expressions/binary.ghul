namespace Syntax.Trees.Expressions is
    use IO.Std

    use Source

    class BINARY(
        location: LOCATION,
        operation: Identifiers.Identifier,
        actual_operation: string?,
        left: Expression,
        right: Expression
    ): Expression is
        super(location)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            // enter/leave_node wrap the whole visit so the ambient
            // location covers Values built by `pre()` overrides that
            // take control of the walk — `pre_binary` for `/\`/`\/`
            // does its own narrowing-aware walk and returns true,
            // skipping the default recursion below.
            visitor.enter_node(self)
            try
                if !visitor.pre(self) then
                    left.walk(visitor)
                    right.walk(visitor)
                fi
                accept(visitor)
            finally
                visitor.leave_node(self)
            yrt
        si

        // The wrapper closure literal for a call whose callee's declared
        // return type carries the return-pack marker - the operator
        // spelling's counterpart of CALL.return_pack_literal. Its value
        // is composed into the operator's own IR, so the literal is not
        // reachable from the tree the generate-il pass walks - this
        // field is where that pass finds it, to emit the closure body.
        return_pack_literal: Trees.Expressions.FUNCTION? public

        replace_child(old: Expression, replacement: Expression) is
            if left == old then
                left = replacement
            elif right == old then
                right = replacement
            fi
        si
    si
si
