namespace Syntax.Trees.Expressions is

    use Source;

    // A field comparison inside a synthesized union `=~`, where the
    // comparison to run is not knowable when the body is built: it is
    // the field type's own `=~` where the type defines one, and the
    // default equality comparer otherwise. The parser never produces
    // this node — add_accessors_for_properties builds one per compared
    // field, and compile-expressions lowers it once the field's static
    // type is known.
    class FIELD_EQUALS(
        location: LOCATION,
        left: Expression,
        right: Expression
    ): Expression is
        super(location);

        accept(visitor: Visitor) is
            visitor.visit(self);
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                left.walk(visitor);
                right.walk(visitor);
            fi

            accept(visitor);
        si
    si
si
