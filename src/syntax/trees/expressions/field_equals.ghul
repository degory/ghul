namespace Syntax.Trees.Expressions is

    use Source

    // A field comparison inside a synthesized union `=~`, where the
    // comparison to run is not knowable when the body is built: it is
    // the field type's own `=~` where the type defines one, and the
    // default equality comparer otherwise. The parser never produces
    // this node — add_accessors_for_properties builds one per compared
    // field, and compile-expressions lowers it once the field's static
    // type is known.
    class FIELD_EQUALS(
        location: LOCATION,
        left: Expression,
        right: Expression
    ): Expression is
        // Whether a member that reaches neither an operator nor an
        // element-wise comparison is worth reporting. A union's
        // structural equality is what choosing a union asks for, so a
        // member that degrades it is; a struct's operator is given
        // rather than asked for, and reporting there would fire on
        // every struct in a program, including the ones nothing ever
        // compares.
        reports_fallback: bool public

        super(location)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                left.walk(visitor)
                right.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
