namespace Syntax.Trees.Expressions is

    use Source

    // `await E` expression. The operand is anything that resolves the
    // awaiter pattern (see `Semantic.AWAITABLE_RESOLVER`); the AWAIT is
    // typed as whatever the awaiter's `get_result` returns.
    class AWAIT: Expression is
        operand: Expression

        // The resolved awaiter pattern for the operand's type, settled
        // by compile-expressions and read back when the suspend is
        // emitted. Null when the operand is not awaitable.
        awaitable: Semantic.AWAITABLE? public => await_state.awaitable, = value is await_state.awaitable = value si

        await_state: Syntax.Process.AWAIT_STATE field

        // The frame field the awaited result is held in across the
        // suspend, or null when the result is void. Allocated where the
        // result type is worked out rather than while the await is
        // emitted, for the same reason SPILL's is.
        result_field: Semantic.Symbols.Field? public => await_state.result_field, = value is await_state.result_field = value si

        // The frame field holding the awaiter between registering the
        // continuation and being resumed. Allocated alongside the
        // result field, and for the same reason.
        awaiter_field: Semantic.Symbols.Field? public => await_state.awaiter_field, = value is await_state.awaiter_field = value si

        init(location: LOCATION, operand: Expression) is
            super.init(location)

            self.operand = operand
        si

        clear_outputs() is
            super.clear_outputs()
            await_state.clear_outputs()
        si

        clear() is
            super.clear()
            await_state.clear()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                operand.walk(visitor)
            fi
            accept(visitor)
        si
    si
si
