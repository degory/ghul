namespace Syntax.Trees.Expressions is

    use Source

    // Which reading of `cast (X)(args)` is meant. Every other cast is
    // `TYPED` from the start.
    enum CastReading is
        UNDECIDED,
        TYPED,
        CALLED,
    si

    // `type_expression` is the target type: `cast T(v)`. Null for
    // `cast(v)`, whose target type is supplied by the context.
    //
    // `is_checked` is true for a cast the program wrote, which faults when
    // it fails, and false for one the compiler synthesises, which declines.
    // See IR.Values.CAST.
    class CAST(
        location: LOCATION,
        type_expression: TypeExpressions.TypeExpression?,
        right: Expression,
        is_checked: bool
    ): Expression is
        super(location)

        // `cast (X)(args)` reads two ways and the parser cannot tell
        // them apart: a cast to the parenthesised type `X` taking
        // `args` as its value, or a cast of the value `X` whose result
        // is then called with `args`. Both readings are carried until
        // resolve-type-expressions can ask the scope whether `X` names
        // a type. `called_form` is the second reading written out;
        // `call_arguments` is the list it shares with the first, whose
        // single element is `right`.
        called_form: CALL? public
        call_arguments: LIST? public

        reading: CastReading public

        is_ambiguous: bool => called_form?

        awaits_context_type: bool => !type_expression?

        set_ambiguous_readings(called_form: CALL, call_arguments: LIST) is
            self.called_form = called_form
            self.call_arguments = call_arguments
        si

        set_reading(reading: CastReading) is
            self.reading = reading
        si

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message)

            // Under the called reading this node is the call, so the
            // context's type is the call's result type rather than
            // anything the cast targets.
            if reading == CastReading.CALLED then
                called_form!.set_expected_type(expected_type, error_message)
            fi
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                // Until the reading is settled both branches are
                // walked, so a pass running ahead of the decision sees
                // every subtree exactly once. Afterwards only the
                // branch that won is walked: resolving the loser would
                // report a type name as an undefined value, or an
                // undefined value as a missing type.
                case reading
                when CastReading.TYPED then
                    type_expression!.walk(visitor)
                    call_arguments!.walk(visitor)

                when CastReading.CALLED then
                    called_form!.walk(visitor)

                else
                    if type_expression? then
                        type_expression.walk(visitor)
                    fi

                    if let form = called_form then
                        form.walk(visitor)
                    else
                        right.walk(visitor)
                    fi
                esac
            fi
            accept(visitor)
        si
    si
si
