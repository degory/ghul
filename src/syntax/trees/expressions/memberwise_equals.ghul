namespace Syntax.Trees.Expressions is

    use Source

    // The whole body of a synthesized `=~`. The parser never produces
    // one: ADD_ACCESSORS_FOR_PROPERTIES puts a single node where the
    // body goes, and compile-expressions emits the comparison from it
    // once the owner, its ancestors and its members have resolved.
    //
    // One node rather than a tree of tests and calls. Everything the
    // comparison needs to decide - which guard the owner takes, how
    // each member compares, whether a base contributes members of its
    // own - is settled by types and ancestors that do not exist where
    // the body is written, and a tree built ahead of them has to be
    // patched afterwards by a pass that does know. It is also read by
    // every diagnostic that reads user code, so it draws reports at
    // source locations for expressions nobody wrote.
    //
    // `members` names what to compare, in declaration order, under the
    // names a value of the owner is read by - an auto-property through
    // its backing field, a `field` member by its own name. The rules
    // that decide which members those are read the declarations, so
    // they are answered where the declarations are.
    class MEMBERWISE_EQUALS(
        location: LOCATION,
        members: Collections.LIST[string],
        // Where each member was declared, so that a report about how
        // it compares lands on the declaration rather than on a body
        // nobody wrote.
        member_locations: Collections.LIST[LOCATION]
    ): Expression is
        // Whether a member reaching neither an operator nor an
        // element-wise comparison is worth reporting. A union's
        // structural equality is what choosing a union asks for, so a
        // member that degrades it is; a struct's or a class's operator
        // is given rather than asked for, and reporting there would
        // fire on every type in a program, including the ones nothing
        // ever compares.
        reports_fallback: bool public

        // Every function the lowering decided to call - each member's
        // own comparison, and the base's operator where one is
        // reached. The effects walk reads them: a synthesized body
        // stores nothing itself, so what it can do is exactly what
        // these do, and the solver is told rather than left to guess.
        called_functions: Collections.LIST[Semantic.Symbols.Function] public

        super(location)

        init(..) is
            called_functions = Collections.LIST[Semantic.Symbols.Function]()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si
    si
si
