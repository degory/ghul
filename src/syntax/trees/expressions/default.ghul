namespace Syntax.Trees.Expressions is

    use Source;

    // `type_expression` is the optional explicit type argument: `default[T]`.
    // Null for a bare `default` (or the `_` alias), whose type is supplied by
    // the context.
    //
    // `is_underscore` distinguishes which spelling produced this node: true
    // for `_`, false for the `default` keyword. Both spellings mean the same
    // thing in a value position, but only `_` also has a binding-position
    // reading (the discard formal in a lambda parameter group) — `default`
    // is not a discard placeholder. Set by the parser, never derived, since
    // nothing else on the node records which token was consumed.
    class DEFAULT(location: LOCATION, type_expression: TypeExpressions.TypeExpression?, is_underscore: bool): Expression is
        // Constraint pushed in by the parent context (assignment RHS,
        // return position, typed `let` initializer, call argument).
        // For a bare `default` this is what gives it its type.

        super(location);

        // Only an untyped `_` can stand in for a discard formal in a
        // lambda's parameter group (`(_, b) => ...`, `_ => ...`): the
        // group is parsed as a tuple expression first and reinterpreted
        // as a pattern when the `=>` arrives, so `_` must round-trip
        // back into a discard binding leaf here. declare-members renames
        // the `_` name to a unique slot the way it does any other
        // discard. `default` has no such reading, and `_[T]` has no
        // reading as a formal either — a formal's type comes from the
        // `: T` syntax, not from `[T]`.
        could_be_formal_argument: bool => is_underscore /\ !type_expression?;

        try_copy_as_variable_left() -> Variables.VariableLeft? =>
            if !could_be_formal_argument then
                null
            else
                Variables.SIMPLE_VARIABLE_LEFT(location, Identifiers.Identifier(location, "_"))
            fi;

        try_copy_as_variable() -> VARIABLE? =>
            if !could_be_formal_argument then
                null
            else
                VARIABLE(location, Identifiers.Identifier(location, "_"), TypeExpressions.INFER(location), null)
            fi;

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message);
        si

        accept(visitor: Visitor) is
            visitor.visit(self);
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if type_expression? then
                    type_expression.walk(visitor);
                fi
            fi

            accept(visitor);
        si
    si
si
