namespace Syntax.Trees.Definitions is
    use Source

    class Definition: Trees.Node  abstract is
        without_pragmas: Definition => self

        // The `///` doc comment directly above this declaration, set by
        // ATTACH_DOC_COMMENTS after parsing.
        doc: string? public

        init(location: LOCATION) is
            super.init(location)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si
    si
si
