namespace Syntax.Trees.Definitions is

    use Source

    class USE(location: LOCATION, name: Identifiers.Identifier?, `use: Identifiers.Identifier?): Definition is
        // Set by the first use-resolution round when the used name bound.
        // A name that resolves only once members exist - a static method,
        // a global function, an enum member - stays unset and is retried
        // by the second round, after declare-members; the flag is written
        // unconditionally by round one, so it never carries stale state
        // across builds on a retained tree.
        is_import_resolved: bool public

        // A type alias - `use NAME[T] = <type expression>;` - names a type
        // rather than importing a symbol, so it carries a target type
        // expression and optional type parameters in place of `use`.
        arguments: TypeExpressions.LIST? public
        target: TypeExpressions.TypeExpression? public

        // The symbol declared for an alias clause, set by resolve-uses and
        // read by resolve-type-expressions.
        alias_symbol: Semantic.Symbols.TYPE_ALIAS? public

        is_alias: bool => target?

        // `use default` - the clause stands for the set of imports the
        // project declares, or the compiler's curated set. It carries no
        // name of its own, so it is the one clause with neither a `use`
        // identifier nor an alias target.
        is_default: bool public

        // `use X.*` - imports every usable member of the type or namespace
        // named by `` `use ``, rather than one symbol. A namespace target
        // resolves in the same round as a plain `use X;`; a class, struct,
        // union or enum target has no members to enumerate until
        // declare-members has run, so resolution stashes the resolved
        // container here and expands it in the second use-resolution round.
        is_all: bool public
        wildcard_target: Semantic.Symbols.Symbol? public

        super(location)

        init(
            ..,
            arguments: TypeExpressions.LIST?,
            target: TypeExpressions.TypeExpression?
        ) is
            self.arguments = arguments
            self.target = target
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        // wildcard_target is read as an authoritative cache before it is
        // ever reassigned (RESOLVE_USES._resolve_use_all reuses it rather
        // than re-resolving), unlike is_import_resolved and alias_symbol,
        // which round one always overwrites before either is read for a
        // decision. A retained node whose symbol table has since been
        // rebuilt would otherwise hand round one a dangling symbol.
        clear() is
            super.clear()

            is_import_resolved = false
            alias_symbol = null
            wildcard_target = null
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if name? then
                    name.walk(visitor)
                fi

                if `use? then
                    `use.walk(visitor)
                fi

                if let a = arguments then
                    a.walk(visitor)
                fi

                if let t = target then
                    t.walk(visitor)
                fi
            fi

            accept(visitor)
        si
    si
si
