namespace Syntax.Trees.Definitions is

    use Source

    class USE(location: LOCATION, name: Identifiers.Identifier?, `use: Identifiers.Identifier?): Definition is
        // Set by the first use-resolution round when the used name bound.
        // A name that resolves only once members exist - a static method,
        // a global function, an enum member - stays unset and is retried
        // by the second round, after declare-members; the flag is written
        // unconditionally by round one, so it never carries stale state
        // across builds on a retained tree.
        is_import_resolved: bool public

        // A type alias - `use NAME[T] = <type expression>;` - names a type
        // rather than importing a symbol, so it carries a target type
        // expression and optional type parameters in place of `use`.
        arguments: TypeExpressions.LIST? public
        target: TypeExpressions.TypeExpression? public

        // The symbol declared for an alias clause, set by resolve-uses and
        // read by resolve-type-expressions.
        alias_symbol: Semantic.Symbols.TYPE_ALIAS? public

        is_alias: bool => target?

        super(location)

        init(
            ..,
            arguments: TypeExpressions.LIST?,
            target: TypeExpressions.TypeExpression?
        ) is
            self.arguments = arguments
            self.target = target;
        si

        accept(visitor: Visitor) is
            visitor.visit(self);
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if name? then
                    name.walk(visitor);
                fi

                if `use? then
                    `use.walk(visitor);
                fi

                if let a = arguments then
                    a.walk(visitor);
                fi

                if let t = target then
                    t.walk(visitor);
                fi
            fi

            accept(visitor);
        si
    si
si
