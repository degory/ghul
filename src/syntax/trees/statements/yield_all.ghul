namespace Syntax.Trees.Statements is
    use Source

    // `yield in E` - yield every element of E in turn. The iterator
    // surface is resolved exactly as a `for` loop's is; the difference
    // is the loop body, which suspends the enclosing generator with the
    // element rather than running user statements.
    class YIELD_ALL(location: LOCATION, expression: Expressions.Expression public): Statement, IteratorCarrier is
        expects_semicolon: bool => true

        iterated: Expressions.Expression? => expression

        read_iterator: Semantic.Symbols.Function? public => iterator_state.read_iterator, = value is iterator_state.read_iterator = value si
        read_current: Semantic.Symbols.Function? public => iterator_state.read_current, = value is iterator_state.read_current = value si
        move_next: Semantic.Symbols.Function? public => iterator_state.move_next, = value is iterator_state.move_next = value si

        iterator_field: Semantic.Symbols.Field? public => iterator_state.iterator_field, = value is iterator_state.iterator_field = value si

        iterator_state: Syntax.Process.ITERATOR_STATE field

        clear() is
            super.clear()
            iterator_state.clear()
        si

        clear_outputs() is
            super.clear_outputs()
            iterator_state.clear_outputs()
        si

        super(location)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                expression.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
