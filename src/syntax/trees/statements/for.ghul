namespace Syntax.Trees.Statements is
    use Source;

    class FOR(
        location: LOCATION,
        variable: Variables.VARIABLE?,
        expression: Expressions.Expression?,
        body: Statements.LIST?
    ): Statement, ScopeCarrier is
        scope: Semantic.Scope? public;

        read_iterator: Semantic.Symbols.Function? public;
        read_current: Semantic.Symbols.Function? public;
        move_next: Semantic.Symbols.Function? public;

        // Inside a generator or async function the iterator has to
        // survive every suspension, so it lives in a frame field rather
        // than a CLR local, which MoveNext would reset on re-entry.
        // Allocated here rather than while emitting, because the
        // emitted assembly's rows are numbered before any body is
        // compiled and a field that appears after that has none.
        // Null outside a state machine.
        iterator_field: Semantic.Symbols.Field? public;

        // Set by compile-expressions when the loop expression is a
        // fusible Pipe[T] chain: the IL pass then lowers the whole
        // chain to one inline loop instead of iterating the built pipe
        // objects. Null means iterate normally. See
        // Syntax.Process.PIPE_FUSION_RECOGNIZER.
        fusion: Syntax.Process.PIPE_FUSION? public;

        super(location);

        debug_location: LOCATION is
            if let self.expression? then
                return location.start_position :: expression.location;
            fi

            return location.start_position;
        si

        accept(visitor: Visitor) is
            visitor.visit(self);
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if variable? then
                    variable.walk(visitor);
                fi

                if expression? then
                    expression.walk(visitor);
                fi

                if body? then
                    body.walk(visitor);
                fi
            fi

            accept(visitor);
        si
    si
si
