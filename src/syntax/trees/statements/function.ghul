namespace Syntax.Trees.Statements is
    use Source

    // A named function written among the statements of a function body.
    // The name is a local of the enclosing body, defined from this
    // statement onward, and the function itself is the literal the
    // variable is initialized with - so capture, emission and calling
    // are an anonymous literal's throughout. The node exists so that
    // what the source wrote survives: the formatter writes the named
    // form back, and diagnostics anchor on the function rather than on
    // a variable the user did not write.
    class FUNCTION(location: LOCATION, variable: Variables.VARIABLE, has_block_body: bool): Statement is
        // A `=>` body ends where the expression does, so its boundary
        // needs a terminator, as an expression statement's does. An
        // `is ... si` body carries its own, exactly as a compound
        // statement does.
        expects_semicolon: bool => !has_block_body

        name: Identifiers.Identifier? => variable.name

        function: Expressions.FUNCTION? => cast Expressions.FUNCTION?(variable.initializer)

        super(location)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                variable.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
