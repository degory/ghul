namespace Syntax.Trees.Statements is
    use Source

    // `break` parses uniformly as `break <expr>`; a missing expression is
    // the bare form. When the expression is a bare identifier resolving to
    // a loop-label symbol, compile-expressions stamps `resolved_target`
    // with the labelled loop statement and the name is taken as a label
    // rather than a value; any other resolution breaks with the value.
    class BREAK(location: LOCATION, expression: Expressions.Expression?): Statement is
        expects_semicolon: bool => true

        resolved_target: Statement? public

        super(location)

        clear() is
            super.clear()

            resolved_target = null
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if let self.expression? then
                    expression.walk(visitor)
                fi
            fi
            accept(visitor)
        si
    si
si
