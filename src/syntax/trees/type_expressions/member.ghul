namespace Syntax.Trees.TypeExpressions is
    use Source

    class MEMBER(location: LOCATION, left: TypeExpression, name: Identifiers.Identifier): TypeExpression is
        try_copy_as_value_expression() -> Expressions.Expression? =>
            let maybe_left = left.try_copy_as_value_expression() in
            if maybe_left? then
                Expressions.MEMBER(location, maybe_left, name.copy(), name.location)
            else
                null
            fi

        super(location)

        // The `Namespace.TYPE.member` spelling this rewrites to, built
        // on the first walk and reused by later ones.
        qualified_form: TypeExpression? public

        keep_qualified_form(form: TypeExpression) -> TypeExpression is
            qualified_form = form

            return form
        si

        // A member of a member, as in `A.b.c`: the left is qualified with
        // its own name first, then with this one.
        qualify_member(member: Identifiers.Identifier) -> TypeExpression =>
            left.qualify_member(name).qualify_member(member)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                left.walk(visitor)
                name.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
