namespace Compiler is
    use System.Exception;

    use IO.Std;

    use Collections.Iterable;
    use Collections.MutableList;
    use Collections.LIST;
    
    use IoC;
    use Logging;

    class COMPILER is
        container: CONTAINER;
        logger: Logger;

        source_files: LIST[SOURCE_FILE];

        post_parse_passes: MutableList[Pass];

        build_passes: MutableList[Pass];

        _compile_expressions_pass: Pass;

        is_full_compile_needed: bool public;

        // True when the declaration-level state - symbols, ancestries,
        // override links, store-free bits - reflects every registered
        // file's current source: set by a completed build, cleared the
        // moment clear_symbols abandons the tables. Distinct from
        // is_full_compile_needed, which tracks whether expression-level
        // DIAGNOSTICS are stale for some files; right after an
        // interface-affecting EDIT's rebuild the tables are current while
        // a full compile is still needed.
        are_tables_current: bool public;

        // Called at each per-file boundary of the compile-expressions
        // walk, if anything is interested. Analysis mode uses it to
        // answer queries that arrived while a compile was running; a
        // batch build leaves it unset.
        //
        // The boundary is where a file has just been walked and both the
        // scope stack and the namespace stack are back at their base -
        // the only point during a compile at which the retained state is
        // as consistent as it is between builds.
        on_file_boundary: (() -> void)? public;

        generated_source_files: MutableList[string];

        _effects_stopwatch: System.Diagnostics.Stopwatch?;

        init() is
            container = IoC.CONTAINER.instance;
            logger = container.logger;

            source_files = LIST[SOURCE_FILE]();
            generated_source_files = LIST[string]();

            post_parse_passes = LIST[Pass]();
            add_pass(post_parse_passes, "conditional-compilation", (source_file) -> bool => conditional_compilation_pass(source_file));
            add_pass(post_parse_passes, "collect-modifier-keyword-locations", (source_file) -> bool => collect_modifier_keyword_locations_pass(source_file));
            add_pass(post_parse_passes, "rewrite-syntax-trees", (source_file) -> bool => rewrite_syntax_tree_pass(source_file));
            add_pass(post_parse_passes, "collect-suppress-pragmas", (source_file) -> bool => collect_suppress_pragmas_pass(source_file));

            build_passes = LIST[Pass]();
            // Declares the type-level skeleton only: namespaces, types,
            // variants and type parameters - everything a type expression
            // can name. Members are declared by declare-members below.
            add_pass(build_passes, "declare-symbols", (source_file) -> bool => declare_symbols_pass(source_file));
            // First round: binds imports of namespaces and types. Imports
            // of members bind in resolve-member-uses, once they exist.
            add_pass(build_passes, "resolve-uses", (source_file) -> bool => resolve_uses_pass(source_file));
            // Runs after resolve-uses so a member - in particular an
            // impl/partial block's target name - can be reached through a
            // use import and declared anywhere relative to its uses.
            add_pass(build_passes, "declare-members", (source_file) -> bool => declare_members_pass(source_file));
            // Second round: binds imports of members - static methods,
            // global functions, enum members - and reports anything still
            // unresolved.
            add_pass(build_passes, "resolve-member-uses", (source_file) -> bool => resolve_member_uses_pass(source_file));
            // Runs after declare-members so it can read each class's
            // computed `is_abstract` (explicit + implicit) rather than
            // just the syntactic modifier.
            // Walks every file to report warnings but leaves nothing a
            // later pass reads, so it reports its walk without advancing
            // the compiled_through marker.
            add_pass(build_passes, "check-name-conventions", (source_file) -> bool => check_name_conventions_pass(source_file))
                .advances_milestone = false;
            add_pass(build_passes, "resolve-type-expressions", (source_file: SOURCE_FILE) -> bool => resolve_type_expressions_pass(source_file));
            add_pass(build_passes, "resolve-ancestors", (source_file) -> bool => resolve_ancestors_pass(source_file));
            add_pass(build_passes, "resolve-explicit-types", (source_file) -> bool => resolve_explicit_types_pass(source_file));
            add_pass(build_passes, "check-type-argument-bounds", (source_file) -> bool => check_type_argument_bounds_pass(source_file));
            add_pass(
                build_passes,
                "resolve-overrides",
                () -> void is si,
                (source_file) -> bool => resolve_overrides_pass(source_file),
                () -> void is
                    container.resolve_overrides.check_duplicate_global_functions();
                si
            );
            // Editor-only: announces each declaration's dispatch state
            // once every file's overrides have been resolved. Reports
            // nothing a later pass reads, so it does not advance the
            // milestone.
            add_pass(build_passes, "definition-virtuality", (source_file) -> bool => definition_virtuality_pass(source_file))
                .advances_milestone = false;
            add_pass(build_passes, "register-source-intrinsics", (source_file) -> bool => register_source_intrinsics_pass(source_file));
            add_pass(build_passes, "record-type-argument-uses", (source_file) -> bool => record_type_argument_uses_pass(source_file));

            add_pass(build_passes, "mark-boxed-locals", (source_file) -> bool => mark_boxed_locals_pass(source_file));

            _compile_expressions_pass = add_pass(build_passes, "compile-expressions", (source_file) -> bool => compile_expressions_pass(source_file));

            // Re-walks every body with the types compile-expressions
            // resolved, then solves the member-granular effect
            // relations the reliance judge reads. Reports nothing a
            // later pass consumes through the milestone, so it does not
            // advance it.
            add_pass(
                build_passes,
                "infer-effects",
                () -> void is
                    _effects_stopwatch = System.Diagnostics.Stopwatch.start_new();

                    Syntax.Process.EFFECT_FACTS.collecting = true;
                    Syntax.Process.EFFECT_FACTS.begin_generation("infer-effects");

                    container.infer_store_free.set_resolved_mode(true);
                    container.infer_store_free.start_run();
                si,
                (source_file) -> bool => infer_effects_pass(source_file),
                () -> void is
                    let stopwatch = _effects_stopwatch;
                    let walk_ms = if stopwatch? then stopwatch.elapsed_milliseconds else 0L fi;

                    container.infer_store_free.solve_effects();
                    container.infer_store_free.set_resolved_mode(false);

                    Syntax.Process.EFFECT_FACTS.collecting = false;

                    let solve_ms = if stopwatch? then stopwatch.elapsed_milliseconds else 0L fi;

                    // With the effect relations installed, judge every
                    // consumption of a value that was loaded through a
                    // narrowing fact — see JUDGE_RELIANCES.
                    run_reliance_judge(source_files);
                    run_post_effects_purity_checks(source_files);

                    if System.Environment.get_environment_variable("GHUL_EFFECTS_TIMING")? /\ stopwatch? then
                        IO.Std.error.write_line("effects round: {stopwatch.elapsed_milliseconds} ms (walk {walk_ms} solve {solve_ms - walk_ms} judge {stopwatch.elapsed_milliseconds - solve_ms})");
                    fi
                si
            ).advances_milestone = false;

            add_pass(
                build_passes,
                "generate-il",
                () -> void is
                    if !is_emitting_assembly then
                        return;
                    fi

                    let srm_emitter = container.ir_context.srm_assembly_emitter;

                    container.referenced_assemblies.gen(srm_emitter);

                    // Not at the point the emitter is constructed: the
                    // constructor signature these reference is built from
                    // the string type, which the symbol table does not
                    // hold until the reflected assemblies have been read.
                    container.assembly_info.gen(srm_emitter);

                    // Assign every definition its metadata row before any
                    // body is encoded, so a body can name a target whose
                    // row is not written yet.
                    IR.Emitter.SRM_STRUCTURE_WALK(srm_emitter)
                        .number(container.symbol_table.global_scope);
                si,
                (source_file) -> bool => generate_il_pass(source_file),
                () -> void is
                    if !is_emitting_assembly then
                        return;
                    fi

                    let srm_emitter = container.ir_context.srm_assembly_emitter;

                    // Write the rows the numbering pass promised, now
                    // that every body has been encoded and deposited.
                    // Driven by the sequence that pass recorded, not by
                    // the symbol table, which has moved on since.
                    if !container.logger.any_errors then
                        IR.Emitter.SRM_STRUCTURE_WALK(srm_emitter)
                            .write_rows();
                    fi

                    // An executable build that named no entry point would
                    // otherwise be written out and fail only when something
                    // tried to run it. Surface it as a located compiler
                    // error instead; `finish_build` aborts on `any_errors`
                    // before the image is written. Library builds
                    // (`--library`) legitimately have no entry point. Gated
                    // on no prior errors so it doesn't pile onto a build
                    // already failing for another reason (an error-aborted
                    // build never reaches `.entrypoint` emission, so
                    // `seen_entrypoint` is false regardless of whether the
                    // source declares an `entry`).
                    let flags = container.build_flags;

                    if flags.want_executable
                        /\ !flags.want_library
                        /\ !container.ir_context.seen_entrypoint
                        /\ !container.logger.any_errors
                    then
                        container.logger.error(
                            Source.LOCATION.internal,
                            "no entry point declared; add an 'entry()' function or build with --library"
                        );
                    fi
                si
            );

            // Pass.order is set in registration order so a SOURCE_FILE's
            // compiled_through.order can be compared numerically against the
            // order of a target pass (e.g. _compile_expressions_pass). Post-
            // parse passes get their own counter starting at zero and don't
            // participate in compiled_through queries.
            assign_pass_orders(post_parse_passes);
            assign_pass_orders(build_passes);
        si

        assign_pass_orders(passes: Collections.Iterable[Pass]) static is
            let order mut = 0;
            for p in passes do
                p.order = order;
                order = order + 1;
            od
        si

        dump_counts() is 
            container.namespaces.dump_counts();
            container.symbol_use_locations.dump_counts();
            container.symbol_definition_locations.dump_counts();
        si

        clear_symbols() is
            are_tables_current = false;

            container.symbol_table.clear();
            container.namespaces.clear();
            container.symbol_use_locations.clear();
            container.symbol_definition_locations.clear();
            Semantic.Symbols.STORE_FREE_BITS.clear();

            // The emitter's rows and reference caches name symbols that
            // have just been abandoned, and analysis rebuilds on every
            // edit: kept, they accumulate for the session's lifetime.
            container.ir_context.reset_srm_assembly_emitter();
            // container.logger.clear();

            // Every previously-queued file's expression-level state now
            // references symbols that have just been abandoned. Drop the
            // marker so query handlers can tell.
            for f in source_files do
                f.compiled_through = null;
            od
        si

        is_compiled_through_expressions(source_file: SOURCE_FILE) -> bool =>
            let compiled_through = source_file?.compiled_through in
            compiled_through? /\
            compiled_through.order >= _compile_expressions_pass.order;

        clear_queue() is
            source_files.clear();
        si

        add_pass(passes: Collections.MutableList[Pass], description: string, apply: SOURCE_FILE -> bool) -> Pass is
            let pass = PASS(container.timers, description, null, apply, null);
            passes.add(pass);
            return pass;
        si

        add_pass(
            passes: Collections.MutableList[Pass],
            description: string,
            start: () -> void,
            apply: SOURCE_FILE -> bool,
            finish: () -> void
        ) -> Pass
        is
            let pass = PASS(container.timers, description, start, apply, finish);
            passes.add(pass);
            return pass;
        si

        add_pass(passes: Collections.MutableList[Pass], pass: Pass) is
            passes.add(pass);
        si

        parse_and_queue(path: string, reader: IO.TextReader, want_compile_up_to_expressions: bool, want_compile_expressions: bool, is_internal_file: bool) is
            queue(
                parse(path, reader, want_compile_up_to_expressions, want_compile_expressions, is_internal_file)
            );
        si

        queue(source_file: SOURCE_FILE) is
            source_files.add(source_file);
        si

        queue(source_files: Collections.Iterable[SOURCE_FILE]) is
            self.source_files.add_range(source_files);
        si

        parse(path: string, reader: IO.TextReader, want_compile_up_to_expressions: bool, want_compile_expressions: bool, is_internal_file: bool) -> SOURCE_FILE =>
            parse(path, reader, want_compile_up_to_expressions, want_compile_expressions, is_internal_file, logger);

        // Parsing into an explicitly-supplied logger lets a caller (the
        // analysis-mode format handlers) parse without touching the shared
        // diagnostics store: a throwaway logger keeps parse diagnostics and
        // the speculation state stack isolated from the live analyser state.
        parse(
            path: string,
            reader: IO.TextReader,
            want_compile_up_to_expressions: bool,
            want_compile_expressions: bool,
            is_internal_file: bool,
            logger: Logger
        ) -> SOURCE_FILE is
            let tokenizer = Lexical.TOKENIZER(
                logger,
                path,
                reader, 
                is_internal_file
            );

            // Speculative-lookahead ring buffer; a power of 2 (the
            // queue masks indices with `size - 1`), sized generously so
            // deep-but-finite speculation does not overflow it. A true
            // speculation loop is caught separately by the tokenizer's
            // backtrack-loop detector.
            let token_queue = Lexical.TOKEN_QUEUE(2048);

            let token_lookahead = Lexical.TOKEN_LOOKAHEAD(
                token_queue,
                tokenizer
            );

            let context = Syntax.Parsers.CONTEXT(
                token_lookahead,
                logger
            );

            // The file root parses as a definition list at namespace depth 0,
            // where a file with no namespace may carry bare top-level
            // statements (collected into a synthesised entry point).
            let definitions = container.definition_global_list_parser.parse(context)!;

            let result =
                SOURCE_FILE(
                    want_compile_up_to_expressions,
                    want_compile_expressions,
                    path,
                    definitions
                );

            result.trivia = tokenizer.trivia;

            return result;
        si

        post_parse(source_files: Iterable[SOURCE_FILE]) is
            build(post_parse_passes, source_files);
        si

        post_parse() is
            build(post_parse_passes, source_files);
        si

        build() is
            container.ghul_namespace_creator.create_namespaces();

            Syntax.Process.RELIANCES.reset_counters();
            Syntax.Process.RELIANCES.clear_kill_candidates();
            Syntax.Process.UNBACKED_FACTS.clear();
            Syntax.Process.PURE_SLOTS.clear();

            build(build_passes, source_files);

            are_tables_current = true;
        si

        build(passes: Collections.Iterable[Pass], source_files: Collections.Iterable[SOURCE_FILE]) is
            let is_compiling_expressions mut = false;

            for pass in passes do
                if pass == _compile_expressions_pass then
                    is_compiling_expressions = true;
                fi

                logger.set_is_compiling_expressions(is_compiling_expressions);

                pass.start();

                for i in source_files do
                    let symbol_table = IoC.CONTAINER.instance.symbol_table;
                    let symbol_table_mark = symbol_table.mark_scope_stack();
                    let diagnostics_mark = logger.mark();
                    let symbol_uses_mark = container.symbol_use_locations.mark();

                    let did_work mut = false;

                    try
                        did_work = pass.apply(i);
                    catch e: Exception
                        logger.exception(i.definition.location, e, "caught exception running pass {pass} on work item {i}");
                    finally
                        logger.release(diagnostics_mark);
                        container.symbol_use_locations.release(symbol_uses_mark);
                        symbol_table.release_scope_stack(symbol_table_mark);
                    yrt

                    if did_work then
                        WORK_COUNTERS.file_pass(container.timers, pass.description);

                        if pass.advances_milestone then
                            i.compiled_through = pass;
                        fi
                    fi

                    IoC.CONTAINER.instance.namespaces.pop_all_namespaces();

                    if pass == _compile_expressions_pass then
                        _reached_file_boundary();
                    fi
                od

                // Every method has now been walked, which is what the
                // constructor field check needs: a constructor is routinely
                // written before the helper it delegates to, so the helper's
                // summary does not exist until the pass is over.
                if pass == _compile_expressions_pass then
                    container.compile_expressions.report_field_assignments();
                fi

                pass.finish();
            od
        si

        // On-demand expression compile for one file against the retained
        // symbol table, replaying only the pipeline's compile-expressions
        // step with the same per-file bookkeeping as the build loop.
        // Valid when the file has been built up to expressions in the
        // current symbol generation - declare/resolve state current, only
        // the expression-level walk missing. The analysis-mode query-miss
        // recompile takes this instead of a whole-project rebuild when no
        // interface change is pending.
        compile_expressions_only(source_file: SOURCE_FILE) is
            source_file.want_compile_expressions = true;

            // This walk is the only pass a file the client opened after
            // the last full build ever gets: the build ran the
            // declaration-level virtuality pass gated on the open-files
            // set, so a file that was closed then recorded none of its
            // carriers. Re-run it here, as the body re-walk does, so its
            // inlays arrive with the expression-level ones.
            container.definition_virtuality.apply(source_file);

            logger.set_is_compiling_expressions(true);

            let symbol_table = container.symbol_table;
            let symbol_table_mark = symbol_table.mark_scope_stack();
            let diagnostics_mark = logger.mark();
            let symbol_uses_mark = container.symbol_use_locations.mark();

            let did_work mut = false;

            try
                did_work = _compile_expressions_pass.apply(source_file);
            catch e: Exception
                logger.exception(source_file.definition.location, e, "caught exception compiling expressions on demand for {source_file}");
            finally
                logger.release(diagnostics_mark);
                container.symbol_use_locations.release(symbol_uses_mark);
                symbol_table.release_scope_stack(symbol_table_mark);

                container.namespaces.pop_all_namespaces();

                logger.set_is_compiling_expressions(false);
            yrt

            if did_work then
                WORK_COUNTERS.file_pass(container.timers, _compile_expressions_pass.description);

                source_file.compiled_through = _compile_expressions_pass;
            fi

            // This file is the whole of the walk, so its constructors are
            // reported here rather than waiting for a build loop that may
            // never run - without this an on-demand recompile reports the
            // file differently from a whole-project build of the same
            // source.
            container.compile_expressions.report_field_assignments();

            _reached_file_boundary();
        si

        _reached_file_boundary() is
            let boundary = on_file_boundary;

            if boundary? then
                boundary();
            fi
        si

        // Drop what compile-expressions left behind for one file and put
        // it back in the set that pass has yet to walk. A CE-output-only
        // clear (preserve_resolved_types) drops that output - including
        // the node-keyed stores - while leaving TypeExpression.type
        // intact, so the walk can run again without re-resolving (and
        // thus double-setting) the retained interface types.
        //
        // The caller either re-walks the file now, through
        // recompile_file_expressions, or leaves it for the next compile's
        // expressions-only pass to pick up.
        invalidate_file_expressions(source_file: SOURCE_FILE) is
            let ce_clear = Syntax.Process.CLEAR_STATE_VISITOR(true);
            ce_clear.apply(source_file.definition);

            container.state_store_registry.drop_file(source_file.file_name);

            source_file.compiled_through = null;
        si

        // Recompile one file's expressions against the current symbol
        // table, keeping its resolved interface, so every body rebinds.
        recompile_file_expressions(source_file: SOURCE_FILE) is
            invalidate_file_expressions(source_file);

            logger.clear_expression_diagnostics(source_file.file_name);
            Syntax.Process.RELIANCES.clear_kill_candidates_for(source_file.file_name);
            Syntax.Process.UNBACKED_FACTS.clear_for(source_file.file_name);
            Syntax.Process.PURE_SLOTS.clear_for(source_file.file_name);

            compile_expressions_only(source_file);
        si

        // Declare, resolve and compile just the definitions an append-only
        // interface edit added to the end of a file, against the retained
        // symbol table. The appended subtree is new - nothing referenced
        // it before this edit - so no retained symbol changes and no other
        // file's state is touched: each pass walks only the new nodes.
        // The new functions carry no proven store-free bit, which is
        // the sound not-proven default until the next effects solve.
        // Namespaces named by the new declarations
        // merge into the retained namespace map exactly as they would in
        // a full build.
        build_appended(source_file: SOURCE_FILE, new_definitions: Syntax.Trees.Definitions.LIST) is
            source_file.want_compile_up_to_expressions = true;
            source_file.want_compile_expressions = true;

            _run_appended_pass(source_file, "declare-symbols", () is container.declare_symbols.apply(new_definitions); si);
            _run_appended_pass(source_file, "resolve-uses", () is container.resolve_uses.apply(new_definitions); si);
            _run_appended_pass(source_file, "declare-members", () is container.declare_members.apply(new_definitions); si);
            _run_appended_pass(source_file, "resolve-member-uses", () is container.resolve_member_uses.apply(new_definitions); si);
            _run_appended_pass(source_file, "resolve-type-expressions", () is container.resolve_type_expressions.apply(new_definitions); si);
            _run_appended_pass(source_file, "resolve-ancestors", () is container.resolve_ancestors.apply(new_definitions); si);
            _run_appended_pass(source_file, "resolve-explicit-types", () is container.resolve_explicit_types.apply(new_definitions); si);
            _run_appended_pass(source_file, "check-type-argument-bounds", () is container.check_type_argument_bounds.apply(new_definitions); si);
            _run_appended_pass(source_file, "resolve-overrides", () is container.resolve_overrides.apply(new_definitions); si);

            logger.set_is_compiling_expressions(true);

            _run_appended_pass(source_file, "compile-expressions", () is container.compile_expressions.apply(new_definitions); si);

            logger.set_is_compiling_expressions(false);
        si

        // Declare and resolve a container's changed function members
        // against the retained symbol table, with the scope cursor
        // positioned inside the enclosing namespace and class scopes the
        // way the build loop's tree walk would have it. Split from the
        // expression walk so a class's pull-down can re-run between the
        // two: overrides and pulled-down members must reflect the new
        // member set before any body compiles against them.
        build_members_interface(
            source_file: SOURCE_FILE,
            enclosing: Collections.List[Syntax.Trees.Definitions.Definition],
            members: Syntax.Trees.Definitions.LIST
        ) is
            source_file.want_compile_up_to_expressions = true;
            source_file.want_compile_expressions = true;

            _run_positioned_pass(source_file, enclosing, "declare-members", () is container.declare_members.apply(members); si);
            _run_positioned_pass(source_file, enclosing, "resolve-type-expressions", () is container.resolve_type_expressions.apply(members); si);
            _run_positioned_pass(source_file, enclosing, "resolve-explicit-types", () is container.resolve_explicit_types.apply(members); si);
            _run_positioned_pass(source_file, enclosing, "check-type-argument-bounds", () is container.check_type_argument_bounds.apply(members); si);
        si

        build_members_expressions(
            source_file: SOURCE_FILE,
            enclosing: Collections.List[Syntax.Trees.Definitions.Definition],
            members: Syntax.Trees.Definitions.LIST
        ) is
            logger.set_is_compiling_expressions(true);

            _run_positioned_pass(source_file, enclosing, "compile-expressions", () is container.compile_expressions.apply(members); si);

            logger.set_is_compiling_expressions(false);
        si

        // One pass application over a changed member subtree, with the
        // symbol-table and namespace cursors positioned inside the
        // enclosing scopes first - a namespace enters through its own
        // node's scope plus the namespace prefix stack, a class-like
        // definition through its own node's scope, mirroring
        // ScopedVisitor. The finally's release and pop restore both
        // cursors however deep the positioning got.
        _run_positioned_pass(
            source_file: SOURCE_FILE,
            enclosing: Collections.List[Syntax.Trees.Definitions.Definition],
            pass_name: string,
            apply_pass: () -> void
        ) is
            WORK_COUNTERS.subtree_pass(container.timers, pass_name);

            let symbol_table = container.symbol_table;
            let symbol_table_mark = symbol_table.mark_scope_stack();
            let diagnostics_mark = logger.mark();
            let symbol_uses_mark = container.symbol_use_locations.mark();

            try
                for node in enclosing do
                    if let namespace_definition: Syntax.Trees.Definitions.NAMESPACE = node then
                        container.namespaces.enter_namespace(namespace_definition.name.location, namespace_definition.name.name);
                        symbol_table.enter_scope(namespace_definition);
                    elif let carrier: Syntax.Trees.ScopeCarrier = node then
                        symbol_table.enter_scope(carrier);
                    else
                        logger.poison(node.location, "no scope found for {node.get_type()}");
                    fi
                od

                apply_pass();
            catch e: Exception
                logger.exception(source_file.definition.location, e, "caught exception building changed members in {source_file}");
            finally
                logger.release(diagnostics_mark);
                container.symbol_use_locations.release(symbol_uses_mark);
                symbol_table.release_scope_stack(symbol_table_mark);

                container.namespaces.pop_all_namespaces();
            yrt
        si

        // One pass application over an appended subtree, under the build
        // loop's per-file bookkeeping.
        _run_appended_pass(source_file: SOURCE_FILE, pass_name: string, apply_pass: () -> void) is
            WORK_COUNTERS.subtree_pass(container.timers, pass_name);

            let symbol_table = container.symbol_table;
            let symbol_table_mark = symbol_table.mark_scope_stack();
            let diagnostics_mark = logger.mark();
            let symbol_uses_mark = container.symbol_use_locations.mark();

            try
                apply_pass();
            catch e: Exception
                logger.exception(source_file.definition.location, e, "caught exception building appended declarations in {source_file}");
            finally
                logger.release(diagnostics_mark);
                container.symbol_use_locations.release(symbol_uses_mark);
                symbol_table.release_scope_stack(symbol_table_mark);

                container.namespaces.pop_all_namespaces();
            yrt
        si

        // Incremental body re-walk: re-process only the edited file's new
        // function bodies, after its donor bodies have been spliced in by the
        // analysis-mode EDIT handler. Every pass runs body-scoped — through
        // BODY_DECLARER for declare-symbols, BODY_REWALKER for the rest — so
        // the retained interface (arguments, signatures, indexer / property
        // parameters) is never re-processed. Re-resolving a retained,
        // already-typed argument would poison it ("set type twice"); the
        // bodies are leaves, so processing them alone is also sufficient.
        // resolve-uses / resolve-ancestors / resolve-overrides are skipped —
        // they do not visit body interiors and the interface is unchanged.
        //
        // Before the re-walk re-records the bodies, the edited file's stale
        // symbol-use / definition entries are reconciled: `correspondence`
        // gives every retained interface node's post-edit location, and
        // `body_spans` the pre-edit spans of the re-walked bodies. Body
        // entries are dropped (re-recorded here), interface entries and
        // symbols moved to their post-edit locations.
        rewalk_bodies(
            source_file: SOURCE_FILE,
            correspondence: Source.LOCATION_CORRESPONDENCE,
            body_spans: Source.BODY_SPANS
        ) is
            source_file.want_compile_up_to_expressions = true;
            source_file.want_compile_expressions = true;

            // Definition reconciliation first — it classifies symbols by
            // their pre-edit location, before the use reconciliation moves
            // the interface symbols.
            container.symbol_definition_locations.refresh_edited_file(source_file.file_name, body_spans);
            container.symbol_use_locations.refresh_edited_file(source_file.file_name, correspondence, body_spans);

            let flags = container.build_flags;
            let symbol_table = container.symbol_table;

            let body_declarer = Syntax.Process.BODY_DECLARER(
                logger,
                symbol_table,
                container.namespaces,
                container.declare_members
            );

            // body-scoped declare-symbols
            WORK_COUNTERS.file_rewalk(container.timers, "declare-symbols");

            let mark = symbol_table.mark_scope_stack();

            try
                source_file.definition.walk(body_declarer);
            catch e: Exception
                logger.exception(source_file.definition.location, e, "caught exception declaring bodies in incremental re-walk of {source_file}");
            finally
                symbol_table.release_scope_stack(mark);
                container.namespaces.pop_all_namespaces();
            yrt

            rewalk_pass(source_file, "resolve-type-expressions", container.resolve_type_expressions);
            rewalk_pass(source_file, "resolve-explicit-types", container.resolve_explicit_types);
            rewalk_pass(source_file, "check-type-argument-bounds", container.check_type_argument_bounds);

            if flags.want_assembler \/ flags.want_executable then
                rewalk_pass(source_file, "record-type-argument-uses", container.record_type_argument_uses);
            fi

            // The edited file's declaration-level diagnostics were
            // dropped along with everything else before the re-walk, and
            // no whole-project pass runs to replace them. This one is a
            // per-file declaration walk over symbols an
            // interface-preserving edit did not touch, so re-running it
            // here restores its inlays against the refreshed locations
            // rather than leaving them absent until the next full build.
            container.definition_virtuality.apply(source_file);

            logger.set_is_compiling_expressions(true);

            // The re-walk drives the visitor directly rather than through
            // its apply(), so the state apply() drops at a walk boundary
            // has to be dropped here instead. Left in place, the phantom
            // type-arg placeholders minted during the previous walk stay
            // in the registry, and the first function whose retry loop
            // fails to converge sweeps them and reports them against
            // their pre-edit locations.
            container.compile_expressions.reset_between_walks();

            rewalk_pass(source_file, "compile-expressions", container.compile_expressions);

            logger.set_is_compiling_expressions(false);

            // Every constructor this re-walk touched has a fresh
            // summary; without this, the field check's report() -
            // called only from a whole-project build and from
            // compile_expressions_only - never runs on this path, and
            // a field a prior full build already flagged (or cleared)
            // stops tracking the source entirely once analysis mode
            // starts driving edits through incremental re-walk.
            container.compile_expressions.report_field_assignments();
        si

        // Run one body-visiting pass over the edited file's bodies only,
        // driven by BODY_REWALKER, under a scope-stack mark/release. The
        // pass name is passed separately because a body-visiting pass is
        // a bare visitor, not a registered Pass with a description.
        rewalk_pass(source_file: SOURCE_FILE, pass_name: string, pass: Syntax.Visitor) is
            WORK_COUNTERS.file_rewalk(container.timers, pass_name);

            let symbol_table = container.symbol_table;
            let mark = symbol_table.mark_scope_stack();

            let rewalker = Syntax.Process.BODY_REWALKER(
                logger,
                symbol_table,
                container.namespaces,
                pass
            );

            try
                source_file.definition.walk(rewalker);
            catch e: Exception
                logger.exception(source_file.definition.location, e, "caught exception in incremental re-walk of {source_file}");
            finally
                symbol_table.release_scope_stack(mark);
                container.namespaces.pop_all_namespaces();
            yrt
        si

        conditional_compilation_pass(source_file: SOURCE_FILE) -> bool is
            let definition = source_file.definition;

            container
                .conditional_compilation
                .apply(
                    definition
                );

            return true;
        si

        rewrite_syntax_tree_pass(source_file: SOURCE_FILE) -> bool is
            let definition = source_file.definition;

            container
                .rewrite_primary_constructors
                .apply(definition);

            container
                .synthesise_top_level_entry
                .apply(definition);

            container
                .expand_namespaces
                .apply(definition);

            container
                .add_accessors_for_properties
                .apply(definition);

            container
                .spill_awaits
                .apply(definition);

            return true;
        si

        collect_suppress_pragmas_pass(source_file: SOURCE_FILE) -> bool is
            container
                .collect_suppress_pragmas
                .apply(source_file);

            return true;
        si

        collect_modifier_keyword_locations_pass(source_file: SOURCE_FILE) -> bool is
            container
                .collect_modifier_keyword_locations
                .apply(source_file);

            return true;
        si

        check_name_conventions_pass(source_file: SOURCE_FILE) -> bool is
            container
                .check_name_conventions
                .apply(source_file);

            return true;
        si

        definition_virtuality_pass(source_file: SOURCE_FILE) -> bool is
            container
                .definition_virtuality
                .apply(source_file);

            return true;
        si

        declare_symbols_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .declare_symbols
                    .apply(definition);

                return true;
            fi

            return false;
        si

        resolve_uses_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .resolve_uses
                    .apply(definition);

                return true;
            fi

            return false;
        si

        declare_members_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .declare_members
                    .apply(definition);

                return true;
            fi

            return false;
        si

        resolve_member_uses_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .resolve_member_uses
                    .apply(definition);

                return true;
            fi

            return false;
        si

        resolve_ancestors_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .resolve_ancestors
                    .apply(definition);

                return true;
            fi

            return false;
        si

        resolve_type_expressions_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .resolve_type_expressions
                    .apply(definition);

                return true;
            fi

            return false;
        si

        resolve_explicit_types_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .resolve_explicit_types
                    .apply(definition);

                return true;
            fi

            return false;
        si

        check_type_argument_bounds_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            if flags.want_declare_symbols \/ source_file.want_compile_up_to_expressions then
                container
                    .check_type_argument_bounds
                    .apply(definition);

                return true;
            fi

            return false;
        si

        compile_expressions_pass(source_file: SOURCE_FILE) -> bool is
            let definition = source_file.definition;

            if source_file.want_compile_expressions then
                container
                    .compile_expressions
                    .apply(definition);

                return true;
            fi

            return false;
        si

        mark_boxed_locals_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;
            let definition = source_file.definition;

            // Boxing only matters once the IR is lowered to IL:
            // assignability of a captured local is keyed on its
            // mut marker alone, so analysis-only builds skip
            // deriving the boxing flags. Within an IL-bound
            // build, pair the gate with compile-expressions -
            // if the file isn't being walked for expression-level
            // semantics this run, no downstream consumer would
            // see the `is_boxed` flags we'd set.
            if
                source_file.want_compile_expressions /\
                (flags.want_assembler \/ flags.want_executable)
            then
                container
                    .mark_boxed_locals
                    .apply(definition);

                return true;
            fi

            return false;
        si

        resolve_overrides_pass(source_file: SOURCE_FILE) -> bool is
            let definition = source_file.definition;

            if source_file.want_compile_up_to_expressions then
                container
                    .resolve_overrides
                    .apply(definition);

                return true;
            fi

            return false;
        si

        // The infer-effects pass as a directly callable round, for the
        // analysis-mode COMPILE paths that recompile expressions
        // without running the pass list: re-walk every file's bodies
        // with resolved types, solve the effect relations, and judge
        // whatever reliances those recompiles recorded. Without this,
        // a reliance recorded on an incremental path would never be
        // reported.
        run_effects_pass(files: Collections.Iterable[SOURCE_FILE]) is
            Syntax.Process.EFFECT_FACTS.collecting = true;
            Syntax.Process.EFFECT_FACTS.begin_generation("infer-effects");

            container.infer_store_free.set_resolved_mode(true);
            container.infer_store_free.start_run();

            for source_file in files do
                infer_effects_pass(source_file);
            od

            container.infer_store_free.solve_effects();
            container.infer_store_free.set_resolved_mode(false);

            Syntax.Process.EFFECT_FACTS.collecting = false;

            run_reliance_judge(files);
            run_post_effects_purity_checks(files);
        si

        // The two purity checks that need a body's own store-freedom:
        // what reached a pure function-typed slot, and whether an
        // operator or override that has to be pure actually is. Both
        // ask the solved effect relations, so both run here rather
        // than against the declared-types-only approximation that is
        // all a pass before compile-expressions could have.
        run_post_effects_purity_checks(files: Collections.Iterable[SOURCE_FILE]) is
            logger.set_is_compiling_expressions(true);

            Syntax.Process.PURE_SLOT_JUDGE(
                container.logger,
                container.infer_store_free.function_values).judge();

            for source_file in files do
                if source_file.want_compile_up_to_expressions then
                    check_pure_overrides_pass(source_file);
                fi
            od

            logger.set_is_compiling_expressions(false);
        si

        // A reliance error belongs to the body that leaned on the
        // fact, so it is logged as an expression-level diagnostic:
        // the next expression clear for its file must drop it, or a
        // fixed error would stick across analysis-mode recompiles.
        run_reliance_judge(files: Collections.Iterable[SOURCE_FILE]) is
            logger.set_is_compiling_expressions(true);

            let judge = Syntax.Process.JUDGE_RELIANCES(
                container.logger,
                container.symbol_table,
                container.namespaces,
                container.variable_left_state,
                container.innate_symbol_lookup.get_exception_type());

            // Consumptions are re-derived and re-reported against this
            // round's solve for every file, recompiled or not, so the
            // round owns its diagnostics: drop the previous round's and
            // stamp this round's. The kill report stays outside the
            // window — its candidates are taken once, so its output
            // must persist the way any other expression diagnostic
            // does.
            logger.clear_reliance_diagnostics();
            logger.set_is_judging_reliances(true);

            for source_file in files do
                if source_file.want_compile_up_to_expressions then
                    judge.apply(source_file.definition);
                fi
            od

            // Inside the judging window so the retracted inlays'
            // replacement hints are cleared and re-reported with the
            // rest of the round's reliance diagnostics.
            Syntax.Process.UNBACKED_FACTS.report(logger);

            logger.set_is_judging_reliances(false);

            judge.report_narrowing_kills();

            logger.set_is_compiling_expressions(false);

            if Syntax.Process.NARROWING_STUDY.enabled then
                IO.Std.error.write_line(
                    "reliance: {Syntax.Process.RELIANCES.loads_consulted} heap-fact loads, "
                    "{Syntax.Process.RELIANCES.loads_stamped} stamped, "
                    "{Syntax.Process.RELIANCES.consumptions_reported} reported");
            fi
        si

        infer_effects_pass(source_file: SOURCE_FILE) -> bool is
            let definition = source_file.definition;

            if source_file.want_compile_up_to_expressions then
                // Always the full body re-walk: the per-file facts
                // retained for the pre-expressions run were derived
                // from declared types only, and reusing them here would
                // reintroduce exactly the imprecision this pass exists
                // to remove.
                container.infer_store_free.apply(definition);

                return true;
            fi

            return false;
        si

        register_source_intrinsics_pass(source_file: SOURCE_FILE) -> bool is
            container
                .register_source_intrinsics
                .apply(source_file.definition);

            return true;
        si

        check_pure_overrides_pass(source_file: SOURCE_FILE) -> bool is
            let definition = source_file.definition;

            if source_file.want_compile_up_to_expressions then
                container
                    .check_pure_overrides
                    .apply(definition);

                return true;
            fi

            return false;
        si

        record_type_argument_uses_pass(source_file: SOURCE_FILE) -> bool is
            let flags = container.build_flags;

            if flags.want_assembler \/ flags.want_executable then
                let definition = source_file.definition;

                container
                    .record_type_argument_uses
                    .apply(definition);

                return true;
            fi

            return false;
        si

        // Whether this build produces an assembly. Analysis mode does not,
        // and the generate-il pass then has nothing to do - including in
        // its whole-build hooks, which lay out and write the metadata for
        // an image nobody asks for.
        is_emitting_assembly: bool =>
            let flags = container.build_flags in
            flags.want_assembler \/ flags.want_executable;

        generate_il_pass(source_file: SOURCE_FILE) -> bool is
            if is_emitting_assembly then
                let definition = source_file.definition;

                container
                    .generate_il
                    .apply(definition);

                return true;
            fi

            return false;
        si
    si
si