namespace Compiler is
    /// What a build produces. DOTNET is the .NET assembly the backend in
    /// `src/ir/emitter/` writes; WASM is the WebAssembly module the backend
    /// in `src/ir/wasmgc/` writes; LLVM is a native executable, and has no
    /// backend yet, so a build naming it stops after the front end.
    enum Target is
        DOTNET, WASM, LLVM
    si
si
