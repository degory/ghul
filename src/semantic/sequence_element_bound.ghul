namespace Semantic is
    use Types.Type

    class SEQUENCE_ELEMENT_BOUND is
        // The upper bound a formal's element type puts on an array literal
        // element whose type is still being inferred, or null when the
        // element type is no type to bound with: absent, still holding a
        // placeholder, or over a type parameter the call has not bound,
        // which names a binding still to be made.
        for_element_type(element_type: Type?) -> Type? static =>
            if
                element_type? /\
                element_type.is_settled /\
                !element_type.contains_function_generic_argument
            then
                element_type
            else
                null
            fi
    si
si
