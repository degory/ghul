namespace Semantic is
    use Semantic.Types.Type

    // The type an if expression takes from its own arms when the type
    // pushed down to it still holds placeholders. Such a type comes from a
    // call whose type arguments the expression is meant to pin, so it
    // cannot also be the expression's type. The arms' join stands in for
    // it only when every arm that yields a value has contributed a type
    // that is neither null nor an error, and the join itself is settled.
    class EXPECTED_ARM_JOIN is
        _lub: LEAST_UPPER_BOUND_MAP
        _usable: bool

        init(expected_type: Type?) is
            super.init()

            _lub = LEAST_UPPER_BOUND_MAP()
            _usable = expected_type? /\ expected_type.contains_inferred
        si

        // An arm that yields a value but contributes no type to join: its
        // type is not known yet, or it cannot be consumed. A join over the
        // remaining arms would not describe the whole expression.
        add_untyped_arm() is
            _usable = false
        si

        add(arm_type: Type) is
            if arm_type.is_null \/ arm_type.is_error then
                _usable = false
            else
                _lub.add(arm_type)
            fi
        si

        // An expression that yields absence on fall-through is typed by
        // the optional join elsewhere, so it takes nothing from here.
        result(yields_absence: bool) -> Type? is
            if !_usable \/ yields_absence then
                return null
            fi

            if let joined = _lub.get_result() /\ joined.is_settled then
                return joined
            fi

            return null
        si
    si
si
