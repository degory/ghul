namespace Semantic is
    use Collections.Iterable

    /// What the front end and driver need to know about a build target,
    /// asked of the target rather than read off its name, so that targets
    /// sharing a behaviour share the answer.
    trait TargetProfile is
        /// Whether the core types are declared in a library compiled from
        /// source, rather than reflected from referenced assemblies. Such a
        /// target loads no assemblies and constructs its built-in types.
        has_source_core_library: bool

        /// Whether the program's entry point is called with its command
        /// line arguments and environment.
        entry_takes_arguments: bool

        /// The `@IF` names the target turns on. A name another target
        /// turns on is off for this one.
        conditions: Iterable[string]

        /// What the target's back end can consume.
        capabilities: TargetCapabilities
    si

    /// The .NET target.
    class DOTNET_TARGET_PROFILE: TargetProfile is
        init() is
        si

        has_source_core_library: bool => false
        entry_takes_arguments: bool => true
        conditions: Iterable[string] => ["dotnet"]
        capabilities: TargetCapabilities => DOTNET_TARGET_CAPABILITIES()
    si

    /// The WebAssembly target.
    class WASM_TARGET_PROFILE: TargetProfile is
        init() is
        si

        has_source_core_library: bool => true
        entry_takes_arguments: bool => false
        conditions: Iterable[string] => ["wasm"]
        capabilities: TargetCapabilities => WASM_TARGET_CAPABILITIES()
    si

    /// The profile of every target.
    class TARGET_PROFILES is
        /// Every target's profile.
        all: Iterable[TargetProfile] static =>
            [DOTNET_TARGET_PROFILE(), WASM_TARGET_PROFILE()]

        /// The profile of `target`.
        ///
        /// - target: the target to describe
        for_target(target: Compiler.Target) -> TargetProfile static =>
            case target
            when Compiler.Target.DOTNET then DOTNET_TARGET_PROFILE()
            when Compiler.Target.WASM then WASM_TARGET_PROFILE()
            esac
    si
si
