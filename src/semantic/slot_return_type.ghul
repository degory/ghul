namespace Semantic is
    use Types.Type

    // The return type a function-typed call slot asks a literal for.
    //
    // A Func slot carries its return as the last entry in `arguments`.
    // An Action slot has none there: the void return is stripped, so
    // `arguments` holds only the input types and reading the last entry
    // would take an input for the return. The void is no less a demand
    // for being unwritten - a literal that declares no return type
    // adopts it, and a body producing a value has that value discarded
    // rather than returned.
    //
    // Whether the answer is real enough to push onto the body as an
    // expected type is a separate question, and LAMBDA_RETURN_CONSTRAINT
    // answers it. Void never is: it is the absence of a demand for a
    // value, not a type the body has to produce.
    class SLOT_RETURN_TYPE is
        of(slot: Type, void_type: Type?) -> Type? static is
            if slot.is_action then
                return void_type
            fi

            let count = slot.arguments.count

            if count == 0 then
                return null
            fi

            return slot.arguments[count - 1]
        si
    si
si
