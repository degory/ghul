namespace Semantic is
    use Types.Type;

    // Recognises .NET delegate types and reports the function type that
    // describes how they are called.
    //
    // `Func` and `Action` are excluded: they are already modelled as
    // FUNCTION / ACTION, so `is_named_delegate` answers false for them
    // and callers keep their existing path.
    class DELEGATE_SHAPE is
        MULTICAST_DELEGATE_NAME: string static => "System.MulticastDelegate";

        init() is
        si

        // True for a delegate type ghūl does not already model as a
        // function type.
        is_named_delegate(type: Type) -> bool =>
            !type.is_function /\ _inherits_multicast_delegate(type);

        // The function type describing `type`'s call shape, or null when
        // `type` is not a named delegate or carries no usable `invoke`.
        try_get_function_type(type: Type, innate_symbol_lookup: Lookups.InnateSymbolLookup) -> Type? is
            if !is_named_delegate(type) then
                return null;
            fi

            let invoke = _find_invoke(type);

            if !invoke? \/ !invoke.return_type? \/ !invoke.are_arguments_declared then
                return null;
            fi

            return invoke.get_full_type(innate_symbol_lookup);
        si

        // A delegate declares exactly one `Invoke`, so the group it
        // arrives in holds a single function.
        _find_invoke(type: Type) -> Symbols.Function? is
            let member = type.find_member("invoke");

            if let group: Symbols.FUNCTION_GROUP = member then
                if group.count == 1 then
                    return group.functions[0];
                fi

                return null;
            fi

            return cast Symbols.Function?(member);
        si

        _inherits_multicast_delegate(type: Type) -> bool is
            for ancestor in type.ancestors do
                if ancestor.symbol.qualified_name =~ MULTICAST_DELEGATE_NAME then
                    return true;
                fi

                if _inherits_multicast_delegate(ancestor) then
                    return true;
                fi
            od

            return false;
        si
    si
si
