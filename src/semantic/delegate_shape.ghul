namespace Semantic is
    use Types.Type

    // Recognises .NET delegate types and reports the function type that
    // describes how they are called.
    //
    // `Func` and `Action` are excluded: they are already modelled as
    // FUNCTION / ACTION, so `is_named_delegate` answers false for them
    // and callers keep their existing path.
    class DELEGATE_SHAPE is
        init() is
        si

        // True for a delegate type ghūl does not already model as a
        // function type.
        is_named_delegate(type: Type, innate_symbol_lookup: Lookups.InnateSymbolLookup) -> bool =>
            !type.is_function /\ _inherits_multicast_delegate(type, innate_symbol_lookup)

        // The function type describing `type`'s call shape, or null when
        // `type` is not a named delegate or carries no usable `invoke`.
        try_get_function_type(type: Type, innate_symbol_lookup: Lookups.InnateSymbolLookup) -> Type? is
            if !is_named_delegate(type, innate_symbol_lookup) then
                return null
            fi

            let invoke = _find_invoke(type)

            if !invoke? \/ !invoke.return_type? \/ !invoke.are_arguments_declared then
                return null
            fi

            // Beyond the innate function-type shapes' own parameter
            // limit, no function type exists to describe this call
            // shape - answered here rather than by invoke.get_full_type,
            // which would report an error at the delegate's own
            // declaration instead of leaving this a quiet null probe.
            if invoke.arguments.count > Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS then
                return null
            fi

            return invoke.get_full_type(innate_symbol_lookup)
        si

        // A delegate declares exactly one `Invoke`, so the group it
        // arrives in holds a single function.
        _find_invoke(type: Type) -> Symbols.Function? is
            let member = type.find_member("invoke")

            if let group: Symbols.FUNCTION_GROUP = member then
                if group.count == 1 then
                    return group.functions[0]
                fi

                return null
            fi

            return cast Symbols.Function?(member)
        si

        // `System.MulticastDelegate` resolved from the lookup and
        // compared by symbol identity down the recursion — a rendered
        // name here would conflate a duplicate symbol rather than
        // resolve it. Null when the lookup cannot resolve it, in
        // which case nothing is a named delegate.
        _inherits_multicast_delegate(type: Type, innate_symbol_lookup: Lookups.InnateSymbolLookup) -> bool is
            let multicast = innate_symbol_lookup.get_multicast_delegate_type()

            if !multicast? then
                return false
            fi

            return _inherits(type, multicast.symbol)
        si

        _inherits(type: Type, multicast: Symbols.Symbol) -> bool is
            for ancestor in type.ancestors do
                if ancestor.symbol =~ multicast then
                    return true
                fi

                if _inherits(ancestor, multicast) then
                    return true
                fi
            od

            return false
        si
    si
si
