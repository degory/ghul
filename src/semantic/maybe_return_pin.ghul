namespace Semantic is
    use Types.Type

    // Settles the inferred return type of a function literal whose slot
    // asked for `U?` over an unconstrained U. The slot's return is
    // `MAYBE[U]`, a distinct CLR type from the `string?` or bare `int`
    // the body produces, and the literal's delegate has to carry the
    // slot's shape for the call to bind: the body's type is pinned as
    // `MAYBE[T]` over what it produced, and the return boundary makes
    // the coercion into it.
    class MAYBE_RETURN_PIN is
        of(
            function: Symbols.Function,
            value_type: Type,
            innate_symbol_lookup: Lookups.InnateSymbolLookup
        ) -> Type static is
            if
                !function.wrap_inferred_return_as_maybe \/
                !value_type.is_settled \/
                value_type.is_maybe \/
                value_type.is_null
            then
                return value_type
            fi

            let inner = value_type.optional_inner_type ?? value_type

            if let maybe: Types.GENERIC = innate_symbol_lookup.get_maybe_type(inner) then
                // A `MAYBE` the body wrote out by name is a plain
                // construction over the same symbol: already the carrier.
                if maybe.is_construction_of_same_symbol_as(value_type) then
                    return value_type
                fi

                return maybe
            fi

            return value_type
        si
    si
si
