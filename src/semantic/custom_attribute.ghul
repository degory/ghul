namespace Semantic is
    // One `name = value` argument of an attribute application, resolved
    // against the attribute's own members.
    //
    // `il_name` is the member's .NET name rather than the identifier the
    // call site used: a reflected attribute can be renamed on the way in
    // - `TypeDiscriminatorPropertyName` is written
    // `type_discriminator_property_name` in ghūl - and it is the
    // original a reader looks the member up by.
    class NAMED_ATTRIBUTE_ARGUMENT(
        is_field: bool,
        il_name: string,
        member_type: Types.Type,
        value: IR.Values.Value?,
        location: Source.LOCATION
    );

    // A resolved attribute application: the constructor it selected and
    // its arguments.
    //
    // `positional` and `named` are what the value blob is encoded from.
    // `positional` is the completed list, one entry per constructor
    // parameter: a trailing parameter the call site omitted carries the
    // default the resolver filled in for it.
    //
    // `arguments_text` renders the same arguments as assembler source.
    // Nothing reads it - the blob is encoded from the arguments
    // themselves, since reading a rendering back would be taking
    // presentation for fact. It survives because ATTRIBUTE_RESOLVER
    // fails to produce it for an argument shape it cannot render, and
    // that failure is what rejects the attribute.
    class CUSTOM_ATTRIBUTE(
        constructor: Symbols.Function,
        arguments_text: string,
        positional: Collections.List[IR.Values.Value],
        named: Collections.List[NAMED_ATTRIBUTE_ARGUMENT]
    ) is
        gen_il_line() -> string => ".custom {constructor.get_il_reference()} = {arguments_text}";
    si
si
