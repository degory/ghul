namespace Semantic is
    // One `name = value` argument of an attribute application, resolved
    // against the attribute's own members.
    //
    // `il_name` is the member's .NET name rather than the identifier the
    // call site used: a reflected attribute can be renamed on the way in
    // - `TypeDiscriminatorPropertyName` is written
    // `type_discriminator_property_name` in ghūl - and it is the
    // original a reader looks the member up by.
    class NAMED_ATTRIBUTE_ARGUMENT(
        is_field: bool,
        il_name: string,
        member_type: Types.Type,
        value: IR.Values.Value?,
        location: Source.LOCATION
    );

    // A resolved attribute application: the constructor it selected and
    // its arguments. `positional` and `named` are what the value blob is
    // encoded from; `positional` is the completed list, one entry per
    // constructor parameter, a trailing parameter the call site omitted
    // carrying the default the resolver filled in for it.
    class CUSTOM_ATTRIBUTE(
        constructor: Symbols.Function,
        positional: Collections.List[IR.Values.Value],
        named: Collections.List[NAMED_ATTRIBUTE_ARGUMENT]
    );
si
