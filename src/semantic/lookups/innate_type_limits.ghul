namespace Semantic.Lookups is
    // The innate function and tuple shapes are backed by the
    // Func`N / Action`N and ValueTuple`1..`7 families. Func`17 is
    // Func<T1..T16, TResult> — 16 parameters, 17 slots including the
    // return — which is the widest shape either family reaches, so
    // that caps a function at 16 parameters. ValueTuple`8's last
    // parameter is the nested-rest slot rather than an eighth
    // element, so it is not one of the flat shapes the compiler
    // models and a tuple caps at 7 elements.
    class INNATE_TYPE_LIMITS is
        MAX_FUNCTION_PARAMETERS: int static => 16
        MAX_TUPLE_ELEMENTS: int static => 7;
    si
si
