namespace Semantic is
    use Types.Type

    /*
        Shape equivalence between two functions whose formals may name
        different type parameters. Two overloads of the same name
        declared in different scopes - a project's own `apply` beside
        the runtime's, say - can describe exactly the same call, and
        resolution cannot pick between them. Equivalence here says the
        two describe the same signature: the same arity, and every
        formal pair agreeing structurally, where each function's own
        type parameters compare equal to each other's by position.
    */
    class FUNCTION_SHAPE_EQUIVALENCE is
        are_equivalent(a: Symbols.Function, b: Symbols.Function) -> bool static is
            let fa = a.arguments
            let fb = b.arguments

            if fa.count != fb.count then
                return false
            fi

            for i in 0..fa.count do
                if !same_shape(fa[i], fb[i]) then
                    return false
                fi
            od

            let ra = a.return_type
            let rb = b.return_type

            if ra? != rb? then
                return false
            fi

            if ra? /\ rb? then
                return same_shape(ra!, rb!)
            fi

            return true
        si

        same_shape(a: Type, b: Type) -> bool static is
            let a_param = is_type_parameter(a)
            let b_param = is_type_parameter(b)

            if a_param \/ b_param then
                return a_param /\ b_param
            fi

            if a.is_function != b.is_function then
                return false
            fi

            if a.is_function then
                return same_elements(a, b)
            fi

            if isa Types.TUPLE(a) != isa Types.TUPLE(b) then
                return false
            fi

            if isa Types.TUPLE(a) then
                return same_elements(a, b)
            fi

            if isa Types.GENERIC(a) /\ isa Types.GENERIC(b) then
                let ga = cast Types.GENERIC(a)
                let gb = cast Types.GENERIC(b)

                if ga.is_optional != gb.is_optional then
                    return false
                fi

                let sa = cast Symbols.GENERIC?(ga.symbol)
                let sb = cast Symbols.GENERIC?(gb.symbol)

                if sa? != sb? then
                    return false
                fi

                if sa? then
                    if sa!.symbol != sb!.symbol then
                        return false
                    fi

                    // The generic's own type parameters - a type
                    // parameter of each function's own - compare equal
                    // by position here; anything concrete recurses.
                    return same_elements_on(sa!, sb!)
                fi
            fi

            return a.is_equivalent_to(b)
        si

        same_elements_on(a: Symbols.GENERIC, b: Symbols.GENERIC) -> bool static is
            let ea = a.arguments
            let eb = b.arguments

            if ea.count != eb.count then
                return false
            fi

            for i in 0..ea.count do
                if !same_shape(ea[i], eb[i]) then
                    return false
                fi
            od

            return true
        si

        same_elements(a: Type, b: Type) -> bool static is
            let ea = a.arguments
            let eb = b.arguments

            if ea.count != eb.count then
                return false
            fi

            for i in 0..ea.count do
                if !same_shape(ea[i], eb[i]) then
                    return false
                fi
            od

            return true
        si

        // A bare type parameter of a function under comparison arrives
        // as a GenericArgument; anything concrete is a named or
        // constructed type.
        is_type_parameter(t: Type) -> bool static is
            isa Types.GenericArgument(t)
        si
    si
si
