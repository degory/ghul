namespace Semantic is

    use Semantic.Types.Type;

    // Which of two equally-scoring overloads a `null` argument belongs
    // in.
    //
    // `null` compares alike against an optional slot and a non-optional
    // reference one - both accept it - so a call passing `null` to a
    // group holding one of each scores them the same and lands in the
    // ambiguity tie-breaks. Those prefer the more specific parameter,
    // which for `f(string)` against `f(object?)` is the slot that
    // cannot hold the value: the call selects the non-optional overload
    // and the argument arrives absent in a parameter declared present.
    class NULL_ARGUMENT_PREFERENCE is

        // Whether every argument written as `null` lands in a slot
        // declared to accept absence. A candidate with no `null`
        // argument is vacuously true, so applying this to a call
        // without one leaves the field of candidates unchanged.
        accepts_every_null_argument(
            formals: Collections.List[Type]?,
            actuals: Collections.List[Type]?
        ) -> bool static
        is
            if !formals? \/ !actuals? then
                return true;
            fi

            // An overload reached here may take a different number of
            // arguments than the call supplies - a generic still being
            // bound, or a candidate already scored `DIFFERENT` on
            // arity. Positions past the shorter of the two say nothing
            // about `null` handling either way.
            let count = System.Math.min(formals.count, actuals.count);

            for i in 0..count do
                let actual = actuals[i];
                let formal = formals[i];

                // Either entry can be absent while a call is still
                // being resolved.
                if !actual? \/ !formal? then
                    continue;
                fi

                // The literal's own type, not `is_null` - error types
                // and the sentinels standing in for a type still being
                // inferred answer that too, and treating one of those
                // as a written `null` settles an ambiguity the call
                // needs left open.
                if isa Types.NULL(actual) /\ !formal.is_optional then
                    return false;
                fi
            od

            return true;
        si
    si
si
