namespace Semantic.Types is

    class NULL: Type is
        is_null: bool => true;

        // The type of the `null` literal is an optional type - it is
        // the one value every optional type has and no other type
        // does. Saying so here is what lets the ordinary rule that a
        // non-optional slot rejects an optional value carry the
        // literal too, rather than each slot testing for null.
        is_optional: bool => true;

        init() is
            super.init();
        si

        specialize(type_map: Collections.Map[string,Type]) -> Type => self;

        matches(other: Type) -> bool
            => true;

        // Only an optional slot takes a `null`. A type variable stays
        // assignable: an unconstrained `T` can still be instantiated
        // at an optional type. Sentinels stay assignable so a type
        // that is already broken, or not yet inferred, does not draw a
        // second diagnostic here.
        compare(other: Type) -> Types.MATCH =>
            if
                other.is_sentinel \/ other.is_type_variable \/ other.is_optional
            then
                MATCH.ASSIGNABLE
            else
                MATCH.DIFFERENT
            fi;

        to_string() -> string => "null";
    si
si
