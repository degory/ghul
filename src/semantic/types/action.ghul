namespace Semantic.Types is
    use Source.LOCATION

    use Ghul.Pipes

    class ACTION: GENERIC is
        is_action: bool => true
        is_function: bool => true

        short_description: string => get_short_description(self)

        get_short_description(action: GENERIC) -> string static is
            let result = System.Text.StringBuilder()

            let args = action.arguments

            if args.count == 1 then
                result
                    .append(_parameter_description(args[0]))
                    .append(" -> void")
            else
                result.append('(')

                (0..args.count) |> map(i => args[i]) |> append_to(result)

                result.append(") -> void")
            fi

            return result.to_string()
        si

        // A lone parameter that is itself a tuple or a function keeps
        // its own parentheses, so that `((int, int)) -> int` is not
        // written as the two-parameter `(int, int) -> int`, nor
        // `(int -> int) -> int` as a curried `int -> int -> int`.
        _parameter_description(parameter: Type) -> string static =>
            if parameter.is_value_tuple \/ parameter.is_function then
                "({parameter.short_description})"
            else
                parameter.short_description
            fi

        init(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Collections.List[Type]
        ) is
            super.init(location, symbol, arguments)
        si

        get_argument_type_variance(index: int) -> TypeVariance => TypeVariance.CONTRAVARIANT

        create(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Collections.List[Type]
        ) -> GENERIC =>
            ACTION(location, symbol, arguments)

        to_string() -> string => get_short_description(self)
    si
si
