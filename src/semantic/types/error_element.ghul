namespace Semantic.Types is
    // Whether a type holds ERROR somewhere inside it, as a tuple built from
    // an element whose own type failed, or has not been worked out yet,
    // does. ERROR says nothing about what the element holds, so such a type
    // is not evidence of what a variable holds either.
    class ERROR_ELEMENT is
        within(type: Type) -> bool static is
            if let generic: GENERIC = type then
                for argument in generic.arguments do
                    if argument.is_error \/ within(argument) then
                        return true
                    fi
                od
            fi

            return false
        si
    si
si
