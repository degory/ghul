namespace Semantic.Types is
    // The types a narrowing arrived at by eliminating every other
    // alternative of a closed hierarchy, rather than by a test that
    // checked the value. Nothing about such a type distinguishes it:
    // it is the plain type of the same symbol, and a use of it emits no
    // check, which is right when the hierarchy is complete.
    //
    // Under `--submission` it is not complete: a later cell is another
    // assembly and may add an alternative the elimination never saw, so
    // a use has to be checked. Held here rather than as a field on
    // `Type` so that an ordinary build carries neither the field nor
    // the test that would set it - nothing is ever added outside
    // submission mode, and the whole mechanism is this class and the
    // loads that consult it.
    //
    // Membership is instance identity. No type in the hierarchy
    // declares `equals`, so the set compares by reference; the
    // `get_hash_code` types do declare buckets them by symbol, which
    // costs nothing at the sizes this holds. Identity is sound because
    // every marked type is freshly built where it is marked - a class's
    // own type object is shared, and marking that would mark every
    // value of the class rather than one narrowing of one of them.
    // Nothing carries a mark from one type to another, because nothing
    // needs to: the narrowing environment holds the instance marked
    // here, and every load that presents a value at the narrowed type
    // reads that same instance. A step that rebuilds the type - viewing
    // it as optional, say - produces a type the value is used at
    // without the narrowing, so it needs no check of the narrowing.
    class COMPLEMENT_SINGLETONS is
        _marked: Collections.SET[Type]

        init() is
            // Identity, said rather than inherited: no type declares
            // `=~` today, so a default set would compare by reference
            // anyway, and one that gained an operator later would
            // silently start conflating every type of a symbol.
            _marked = Collections.SET[Type](Collections.ReferenceEqualityComparer.instance)
        si

        mark(type: Type?) is
            if let marked = type then
                let _ = _marked.add(marked)
            fi
        si

        contains(type: Type?) -> bool =>
            if let asked = type then _marked.contains(asked) else false fi

    si
si
