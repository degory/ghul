namespace Semantic.Types is
    // The result of a join whose operands include a type that is still
    // being inferred. Deciding the join from the settled operands alone
    // would settle the placeholder's slot early, and possibly wrongly,
    // so the join waits for the operand instead: this type is what its
    // consumers see until a later walk of the body finds every operand
    // settled and the join can be taken.
    //
    // A placeholder like INFERRED_RETURN_TYPE rather than the awaited
    // placeholder itself: the lower-bound push a per-position merge
    // makes into an INFERRED_VARIABLE_TYPE would otherwise carry the
    // join's other operands into the awaited variable's own type.
    class INFERRED_JOIN_TYPE(awaiting: Type): Type is
        is_null: bool => true
        is_wild: bool => false
        is_inferred: bool => true
        is_sentinel: bool => true

        specialize(type_map: Collections.Map[Symbols.Symbol,Type]) -> Type => self

        matches(other: Type) -> bool => true

        compare(other: Type) -> Types.MATCH => MATCH.ASSIGNABLE

        walk(action: (Type) -> void) is
            action(self)
        si

        to_string() -> string => "***"
    si
si
