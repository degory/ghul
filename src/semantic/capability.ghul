namespace Semantic is
    // A language feature a target's back end can lack. One member per
    // feature some target does not support, added as the checks for them
    // land.
    enum Capability is
        // An `IL.` pragma: it names a fact about a .NET assembly, and a
        // target other than .NET produces no assembly for it to name.
        IL_PRAGMA,

        // A pointer type written in a type expression.
        POINTER,

        // A `ref` type written in a type expression, or a `ref` argument.
        REFERENCE,
        // A namespace named `llvm` at the root, whose qualified names LLVM
        // reserves for its intrinsics.
        LLVM_NAMESPACE
    si
si
