namespace Semantic.DotNet is
    // Some of what the runtime declares exists for the compiler rather
    // than for programs: the attributes that carry language facts across
    // an assembly boundary. Source that names one can state something
    // about a type the compiler never established, and a consumer's
    // narrowing and exhaustiveness then rest on it.
    //
    // They are declined where an imported name is resolved, so a program
    // naming one is told the symbol is not found. The assembly that
    // declares them reaches its own declarations as source symbols and is
    // unaffected, as is the compiler, which reaches them through the type
    // source and through reflected custom-attribute data rather than by
    // resolving a name.
    class HIDDEN_SYMBOLS is
        INTERNAL_NAMESPACE: string static => "Ghul.Internal"

        is_hidden_namespace(namespace_name: string?) -> bool static =>
            namespace_name =~ INTERNAL_NAMESPACE

        // Completion collects the members of a namespace from the
        // symbols declared in it, from the namespace registry and from
        // the imported assemblies, each keyed by its bare name. Pruning
        // the collected map is what covers all three at once.
        prune_hidden(
            namespace_name: string,
            matches: Collections.MutableMap[string, Symbols.Symbol]
        ) static is
            let hidden = Collections.LIST[string]()

            for match in matches do
                if is_hidden_namespace("{namespace_name}.{match.key}") then
                    hidden.add(match.key)
                fi
            od

            for name in hidden do
                matches.remove(name)
            od
        si
    si
si
