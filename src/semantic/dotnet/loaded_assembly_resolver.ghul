namespace Semantic.DotNet is
    use System.Reflection.Assembly
    use System.Reflection.AssemblyName
    use System.Reflection.MetadataAssemblyResolver
    use System.Reflection.MetadataLoadContext

    // Resolves a reference from one loaded assembly to another. The load
    // context asks its resolver for every assembly a type's metadata names,
    // and a path resolver knows only the paths it was built with, so an
    // assembly added to a reference set already in use - an earlier
    // submission, in a compile server - could not be found from a later
    // one that refers to it. An assembly already loaded under the name is
    // the answer; anything else is the path resolver's.
    class LOADED_ASSEMBLY_RESOLVER(
        _loaded: (string) -> Assembly?,
        _fallback: MetadataAssemblyResolver
    ): MetadataAssemblyResolver is
        resolve(context: MetadataLoadContext, assembly_name: AssemblyName) -> Assembly? is
            if let name = assembly_name.name then
                if let assembly = _loaded(name) then
                    return assembly
                fi
            fi

            return _fallback.resolve(context, assembly_name)
        si
    si
si
