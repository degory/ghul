namespace Semantic.DotNet is
    use System.Reflection.FieldInfo;

    // Reads a reflected `const` field's value.
    //
    // A `const` is a compile-time literal: metadata carries the value and
    // no field is emitted to hold it, because a language that inlines a
    // constant at each use leaves nothing behind for anyone to load. So a
    // consumer has to take the value from here rather than read the field
    // it looks like.
    //
    // The value comes back as invariant-culture text, which is the form a
    // reflected argument default is already carried in, so one conversion
    // reads both back at the type they were declared with.
    class REFLECTED_CONSTANTS is
        // Null when the field is not a constant, and when it is one whose
        // value cannot be described this way - which leaves it an
        // ordinary field, no worse off than it was.
        value_of(`field: FieldInfo) -> string? static is
            if !`field.is_literal then
                return null;
            fi

            let raw = `field.get_raw_constant_value();

            // The only constant of a reference type metadata can hold.
            if !raw? then
                return "default";
            fi

            let field_type = `field.field_type;

            if
                !field_type.is_primitive /\
                !field_type.is_enum /\
                field_type.full_name !~ "System.String"
            then
                return null;
            fi

            let convertible = cast System.IConvertible?(raw);

            if !convertible? then
                return null;
            fi

            return convertible.to_string(
                System.Globalization.CultureInfo.invariant_culture
            );
        si
    si
si
