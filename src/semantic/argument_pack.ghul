namespace Semantic is
    use Types.Type

    // The shape rules for a type parameter declared `[T..]`.
    //
    // A pack binds to a positional tuple, so a slot typed `T -> U` over
    // one takes a function of a single parameter. An actual that is a
    // function of two or more parameters describes the same call with
    // the pack spread out, and the front end adapts it to the shape the
    // slot asks for. Arity one is not a pack use - the parameter binds
    // to whatever that one parameter's type is, tuple or not - and
    // neither is anything past the tuple limit.
    class ARGUMENT_PACK is
        // The widest positional tuple there is, and so the widest call
        // a pack can stand for.
        MAXIMUM_ARITY: int static => 7

        // How many parameters a function type takes. A void-returning
        // one is an action, whose type arguments are its parameters
        // alone; every other function type carries its return as the
        // last of them.
        parameter_count(function_type: Type) -> int static =>
            if function_type.is_action then
                function_type.arguments.count
            else
                function_type.arguments.count - 1
            fi

        // Whether this call shape is one a pack parameter fills.
        is_pack_slot(shape: Type?) -> bool static is
            if !shape? \/ !shape.is_function \/ parameter_count(shape) != 1 then
                return false
            fi

            let parameter = shape.arguments[0]

            return isa Types.GenericArgument(parameter) /\ parameter.symbol.is_argument_pack
        si

        // The arity to adapt `argument_type` with to fill `shape`, and
        // absent when the pair is not one the adaptation applies to.
        adaptation_arity(shape: Type?, argument_type: Type?) -> int? static is
            if !is_pack_slot(shape) then
                return null
            fi

            if !argument_type? \/ !argument_type.is_function then
                return null
            fi

            let arity = parameter_count(argument_type)

            if arity < 2 \/ arity > MAXIMUM_ARITY then
                return null
            fi

            return arity
        si
    si
si
