namespace Semantic is
    use Types.Type

    // What an untyped immutable local initialized with `[]` does on one
    // walk of its body.
    enum EmptyLiteralLocal is
        // Its uses have settled it: the literal is typed from the local.
        TYPE_FROM_USE,

        // The local stands as a placeholder its uses can bound.
        AWAIT,

        // A whole walk passed without settling it: the literal keeps its
        // own object element type.
        FALLBACK
    si

    class EMPTY_LITERAL_LOCAL is
        // `inferred` is what the local's recorded bounds settle to so far;
        // `waited_on_previous_walk` says whether the walk before this one
        // already left the local waiting.
        decide(inferred: Type?, waited_on_previous_walk: bool) -> EmptyLiteralLocal static is
            if inferred? /\ inferred.is_settled /\ inferred.get_element_type()? then
                return EmptyLiteralLocal.TYPE_FROM_USE
            fi

            if waited_on_previous_walk then
                return EmptyLiteralLocal.FALLBACK
            fi

            EmptyLiteralLocal.AWAIT
        si
    si
si
