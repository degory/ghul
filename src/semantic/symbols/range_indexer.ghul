namespace Semantic.Symbols is
    // Supplies the `[System.Range]` indexer for a built-in indexable
    // type.
    //
    // It cannot be declared in the runtime beside the type's other
    // members. An array satisfies `Collections.List[E]` by runtime
    // magic rather than by carrying an implementation, so a body
    // declared on the trait the compiler reconstructs arrays from is
    // never reached: the call compiles and then finds nothing to
    // dispatch to. An innate has no body to dispatch, so the call
    // lowers at the site instead.
    //
    // Mirrors `ENUM_EQUALITY_OPERATOR`, which supplies `=~` for a type
    // that has nothing to hang a declaration on for the same kind of
    // reason.
    class RANGE_INDEXER is
        register(owner: Classy) static is
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup;

            let element = owner.type_parameter_at(0);

            if !element? \/ !element.type? then
                return;
            fi

            let indexer =
                INNATE_METHOD(
                    owner.location,
                    owner,
                    INDEXER_NAMES.read,
                    owner,
                    "slice.array");

            indexer.argument_names = Collections.LIST[string](["r"]);
            indexer.arguments = Collections.LIST[Types.Type]([lookup.get_range_type()]);
            indexer.return_type = lookup.get_list_type(element.type!);

            // The slice reads the source and writes nothing. Declared
            // rather than inferred: the store-free analysis classifies a
            // function by walking its body, and this one is built as a
            // symbol without one.
            indexer.mark_declared_pure();

            owner.add_member(indexer);
        si
    si
si
