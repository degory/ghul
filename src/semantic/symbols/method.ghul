namespace Semantic.Symbols is
    use IO.Std;

    use System.Text.StringBuilder;

    use Collections.Iterable;
    use Collections.LIST;
    
    use IoC;
    use Logging;
    use Source;

    use IR.Values.Value;

    use Types.Type;

    class Method: Function abstract is
        is_constructor: bool => self.il_name_override =~ ".ctor";

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        // Underscore access policy for the state-machine method kinds
        // (generator / async). Those are already distinct method kinds and so
        // cannot be the dedicated PRIVATE_/PROTECTED_ classes; they consult the
        // name and policy here instead. Regular methods use the dedicated kinds
        // chosen in Classy._make_instance_method / _make_static_method.
        _is_underscore_non_public: bool =>
            name.starts_with('_') /\
            IoC.CONTAINER.instance.build_flags.underscore_access != Compiler.UnderscoreAccess.LEGACY;

        _gen_underscore_access(buffer: StringBuilder) is
            if _is_underscore_non_public then
                buffer.append("assembly ");
            else
                buffer.append("public ");
            fi
        si

        // Shared by every default-trait-method kind: the plain one and the
        // generator / async ones, which extend the state-machine method
        // classes instead and so cannot inherit it.
        _check_ineffective_trait_override(into: Classy, overrider: Function, logger: Logger) is
            // Property accessors flow through handle_property_overridee, which
            // raises this diagnostic at the property level. Skip the accessor
            // here so we don't double-fire with the mangled `$get_*`/`$set_*`
            // name.
            if name.starts_with('$') then
                return;
            fi

            if let owner_classy: Classy = owner then
                INEFFECTIVE_TRAIT_OVERRIDE_CHECKER()
                    .check(into, overrider.location, overrider.to_string(), self, name, owner_classy, logger);
            fi
        si

        _underscore_is_accessible_to(accessor: Classy?) -> bool is
            if !_is_underscore_non_public then
                return true;
            fi

            let o = cast Classy?(owner?.unspecialized_symbol);

            if IoC.CONTAINER.instance.build_flags.underscore_access == Compiler.UnderscoreAccess.PRIVATE then
                return is_accessible_to_declaring_type(accessor);
            fi

            // PROTECTED: a member reached through a specialization is the
            // declaring type under a distinct symbol, so normalise before
            // the assignability test - same specialisation-identity case
            // as the private branch above.
            let owning_type = o?.type;

            return accessor? /\ owning_type? /\ accessor.type? /\ owning_type.is_assignable_from(accessor.type);
        si
    si
    
    class INSTANCE_METHOD: Method is
        describe(context: DESCRIBE_CONTEXT) -> SignaturePart =>
            _describe_function(context, !is_constructor);

        describe_kind(context: DESCRIBE_CONTEXT) -> string? =>
            if is_constructor then "constructor" else "{pure_prefix}{access_prefix}method" fi;

        symbol_kind: SymbolKind => SymbolKind.METHOD;
        completion_kind: CompletionKind => CompletionKind.METHOD;

        is_instance: bool => true;
        is_virtual: bool => true;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        declare_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.INSTANCE_CLOSURE(location, owner, name, enclosing, is_recursive));

        declare_async_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.INSTANCE_ASYNC_CLOSURE(location, owner, name, enclosing, is_recursive));

        load(location: LOCATION, from: Value?, loader: SYMBOL_LOADER) -> Value => loader.load_instance_method(location, from, self);

        load_self(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            let context = IoC.CONTAINER.instance.symbol_table.current_instance_context;

            return IR.Values.Load.REFERENCE_SELF(context!, context.own_instantiation);
        si

        call(location: Source.LOCATION, from: Value?, arguments: Collections.List[Value], type: Type?, caller: FUNCTION_CALLER) -> Value is
            return caller.call_instance_method(location, from, self, arguments, self.arguments, type);
        si

        try_override(into: Classy, overridee: Function, logger: Logging.Logger) is
            overridee.try_instance_override_me(into, self, logger);
        si

        try_instance_override_me(into: Classy, overrider: Function, logger: Logger) is
            let return_type_matches = overrider.ensure_return_type_matches(into, self, true, logger);

            overrider.ensure_arguments_accept_optionals(into, self, true, logger);

            let il_name_matches = overrider.ensure_il_name_matches(into, self, "override", logger);

            overrider.add_overridee(self);
            self.add_overrider(overrider);
        si

        try_struct_override_me(into: Classy, overrider: Function, logger: Logger) is
            let return_type_matches = overrider.ensure_return_type_matches(into, self, true, logger);

            overrider.ensure_arguments_accept_optionals(into, self, true, logger);

            let il_name_matches = overrider.ensure_il_name_matches(into, self, "override", logger);

            overrider.add_overridee(self);
            self.add_overrider(overrider);
        si

        try_abstract_override_me(into: Classy, overrider: Function, logger: Logger) is
            // An imported interface is free to redeclare an inherited
            // member abstractly even when the inherited one carries a
            // default implementation. The assembly it came from settled
            // that already, and nobody compiling against it can change it.
            if overrider.is_reflected then
                logger.info(overrider.location, "hides {self}");

                return;
            fi

            logger.error(overrider.location, "cannot override abstract method {self}", self.location, "declared here");
        si

    si

    // An underscore-prefixed instance method under the PROTECTED policy: a
    // normal virtual method that a subclass in the same assembly can override,
    // but nothing outside the assembly can see.
    class PROTECTED_METHOD: INSTANCE_METHOD is
        is_public_readable: bool => false;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        is_accessible_to(accessor: Classy?) -> bool =>
            accessor? /\
            let o = cast Classy?(owner) in
                o? /\ o.type? /\ accessor.type? /\ o.type.is_assignable_from(accessor.type);

        access_prefix: string => "protected ";
    si

    // An underscore-prefixed instance method under the PRIVATE policy: an
    // implementation detail of its declaring type. Not virtual, so a same-named
    // method in a subclass is a distinct method rather than an override, and
    // calls resolve statically.
    class PRIVATE_METHOD: INSTANCE_METHOD is
        is_virtual: bool => false;

        is_public_readable: bool => false;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        try_override(into: Classy, overridee: Function, logger: Logging.Logger) is
        si

        is_accessible_to(accessor: Classy?) -> bool =>
            is_accessible_to_declaring_type(accessor);

        access_prefix: string => "private ";
    si

    class STRUCT_METHOD: INSTANCE_METHOD is
        // STRUCT_METHOD inherits describe / describe_kind from
        // INSTANCE_METHOD unchanged.
        symbol_kind: SymbolKind => SymbolKind.METHOD;
        completion_kind: CompletionKind => CompletionKind.METHOD;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        load(location: LOCATION, from: Value?, loader: SYMBOL_LOADER) -> Value => loader.load_struct_method(location, from, self);

        load_self(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            let context = IoC.CONTAINER.instance.symbol_table.current_instance_context;

            return IR.Values.Load.REFERENCE_SELF(context!, context.own_instantiation);
        si

        call(location: Source.LOCATION, from: Value?, arguments: Collections.List[Value], type: Type?, caller: FUNCTION_CALLER) -> Value =>
            caller.call_struct_method(location, from, self, arguments, self.arguments, type);

        try_override(into: Classy, overridee: Function, logger: Logging.Logger) =>
            overridee.try_struct_override_me(into, self, logger);

        try_struct_override_me(into: Classy, overrider: Function, logger: Logger) =>
            logger.error(overrider.location, "cannot override struct method {self}", self.location, "declared here");

        try_instance_override_me(into: Classy, overrider: Function, logger: Logger) =>
            logger.error(overrider.location, "cannot override struct method {self}", self.location, "declared here");

        try_abstract_override_me(into: Classy, overrider: Function, logger: Logger) =>
            logger.error(overrider.location, "cannot override struct method {self}", self.location, "declared here");

    si

    class ABSTRACT_METHOD: INSTANCE_METHOD is
        describe(context: DESCRIBE_CONTEXT) -> SignaturePart =>
            _describe_function(context, true);

        describe_kind(context: DESCRIBE_CONTEXT) -> string? =>
            "{pure_prefix}abstract method";

        is_abstract: bool => true;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        call(location: Source.LOCATION, from: Value?, arguments: Collections.List[Value], type: Type?, caller: FUNCTION_CALLER) -> Value => caller.call_abstract_method(location, from, self, arguments, self.arguments, type);

        try_pull_down_into(
            into: Classy,
            other_overridee_symbols: Collections.Iterable[Symbol],
            logger: Logging.Logger
        ) is
            if !into.is_trait /\ !into.is_reflected then
                logger.error(into.location, "must implement {self}", self.location, "member declared here");
            fi
            
            into.add_member(self);
        si

        try_override(into: Classy, overridee: Function, logger: Logging.Logger) =>
            overridee.try_abstract_override_me(into, self, logger);

        try_instance_override_me(into: Classy, overrider: Function, logger: Logger) is
            let return_type_matches = overrider.ensure_return_type_matches(into, self, false, logger);

            overrider.ensure_arguments_accept_optionals(into, self, false, logger);

            let il_name_matches = overrider.ensure_il_name_matches(into, self, "implement", logger);

            overrider.add_overridee(self);
            self.add_overrider(overrider);
        si

        try_struct_override_me(into: Classy, overrider: Function, logger: Logger) is
            let return_type_matches = overrider.ensure_return_type_matches(into, self, false, logger);

            overrider.ensure_arguments_accept_optionals(into, self, false, logger);

            let il_name_matches = overrider.ensure_il_name_matches(into, self, "implement", logger);

            overrider.add_overridee(self);
            self.add_overrider(overrider);
        si

        try_abstract_override_me(into: Classy, overrider: Function, logger: Logger) =>
            logger.info(overrider.location, "hides {self}");

    si

    class DEFAULT_TRAIT_METHOD: INSTANCE_METHOD is
        describe_kind(context: DESCRIBE_CONTEXT) -> string? =>
            "{pure_prefix}default trait method";

        is_default_trait_method: bool => true;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        try_instance_override_me(into: Classy, overrider: Function, logger: Logger) is
            super.try_instance_override_me(into, overrider, logger);

            _check_ineffective_trait_override(into, overrider, logger);
        si
    si

    class STATIC_METHOD: Method is
        describe(context: DESCRIBE_CONTEXT) -> SignaturePart =>
            _describe_function(context, true);

        describe_kind(context: DESCRIBE_CONTEXT) -> string? =>
            "{pure_prefix}{access_prefix}class method";
        symbol_kind: SymbolKind => SymbolKind.METHOD;
        completion_kind: CompletionKind => CompletionKind.METHOD;

        // Set for a reflected static virtual/abstract interface member -
        // the only shape of static method the CLR allows to be
        // dispatched through an as-yet-unresolved type parameter.
        is_static_interface_virtual: bool public;
        is_virtual: bool => is_static_interface_virtual;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        declare_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.STATIC_CLOSURE(location, owner, name, enclosing, is_recursive));

        declare_async_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.STATIC_ASYNC_CLOSURE(location, owner, name, enclosing, is_recursive));

        load(location: LOCATION, from: Value?, loader: SYMBOL_LOADER) -> Value => loader.load_static_method(self);

        call(location: Source.LOCATION, from: Value?, arguments: Collections.List[Value], type: Type?, caller: FUNCTION_CALLER) -> Value is
            if is_static_interface_virtual then
                let dispatch_type = _static_interface_dispatch_type(from);

                if dispatch_type? then
                    return caller.call_static_interface_method(self, dispatch_type, arguments, self.arguments, type);
                fi
            fi

            return caller.call_static_method(self, arguments, self.arguments, type);
        si

        // The type parameter to dispatch through. Written as
        // `T.member(...)` the receiver names it. Reached any other way -
        // an operator, or the member imported into scope by name - there
        // is no receiver, and the self type of the interface carries it
        // instead: every static virtual interface member is declared on
        // an interface whose first type argument is the implementing
        // type.
        _static_interface_dispatch_type(from: Value?) -> Types.Type? is
            if from? /\ from.type? /\ from.type.is_type_variable then
                return from.type!;
            fi

            if let owner_generic = cast GENERIC?(owner) /\ owner_generic.arguments.count > 0 then
                let self_type = owner_generic.arguments[0];

                if self_type.is_type_variable then
                    return self_type;
                fi
            fi

            return null;
        si

        try_override(into: Classy, overridee: Function, logger: Logging.Logger) is
            // This is arguably not an issue as the hidden instance remains available via super.method()
            if !is_internal /\ overridee.is_instance then
                logger.warn(self.location, "hides-inherited", "static method hides {overridee}", overridee.location, "hidden method declared here");
            fi
        si

        // Don't believe it makes sense to report an instance methods hiding a static method
        // as the static method remains available via CLASS.method()
        try_instance_override_me(into: Classy, overrider: Function, logger: Logger) is
        si

        try_struct_override_me(into: Classy, overrider: Function, logger: Logger) is
        si

        try_abstract_override_me(into: Classy, overrider: Function, logger: Logger) is
        si

        gen_body_header(context: IR.CONTEXT) is
            gen_entrypoint(context);
        si
    si

    // Underscore-prefixed static methods under the PROTECTED / PRIVATE
    // policies. Static methods are already non-virtual, so only the emitted
    // accessibility differs from STATIC_METHOD.
    class PROTECTED_STATIC_METHOD: STATIC_METHOD is
        is_public_readable: bool => false;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        is_accessible_to(accessor: Classy?) -> bool =>
            accessor? /\
            let o = cast Classy?(owner) in
                o? /\ o.type? /\ accessor.type? /\ o.type.is_assignable_from(accessor.type);

        access_prefix: string => "protected ";
    si

    class PRIVATE_STATIC_METHOD: STATIC_METHOD is
        is_public_readable: bool => false;

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);
        si

        is_accessible_to(accessor: Classy?) -> bool =>
            is_accessible_to_declaring_type(accessor);

        access_prefix: string => "private ";
    si

    // A static constructor: `init() static`. Emitted as the owning
    // type's `.cctor`, which the CLR runs once before the type is first
    // used. It takes no parameters and no receiver; a parameterised
    // static init is rejected during declare-symbols.
    class STATIC_CONSTRUCTOR: STATIC_METHOD is
        is_static_constructor: bool => true;

        describe(context: DESCRIBE_CONTEXT) -> SignaturePart =>
            _describe_function(context, false);

        describe_kind(context: DESCRIBE_CONTEXT) -> string? => "static constructor";

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope);

            // Function.init overrode il_name to '.ctor' for the "init"
            // name; the static constructor is the CLR's '.cctor'.
            il_name_override = ".cctor";
        si

        gen_body_header(context: IR.CONTEXT) is
        si
    si
si
