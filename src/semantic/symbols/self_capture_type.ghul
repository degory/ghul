namespace Semantic.Symbols is
    use Source.LOCATION;

    // The type a frame's captured-receiver field takes.
    //
    // A generic type's own `type` is the bare uninstantiated symbol,
    // which is not a well-formed IL type reference — the field has to
    // name the type instantiated with one argument per type parameter,
    // so that the reference resolves against the frame class's own
    // mirrored parameters. Where those arguments come from differs by
    // frame kind, so the caller supplies the lookup. A parameter the
    // lookup cannot resolve yields the bare type rather than a
    // reference with a missing argument.
    class SELF_CAPTURE_TYPE is
        _argument_type: (Classy, string) -> Types.Type?;

        init(argument_type: (Classy, string) -> Types.Type?) is
            _argument_type = argument_type;
        si

        of(context: Classy) -> Types.Type? is
            if !context.is_generic then
                return context.type;
            fi

            let arguments = Collections.LIST[Types.Type]();

            for name in context.argument_names do
                let argument = _argument_type(context, name);

                if !argument? then
                    return context.type;
                fi

                arguments.add(argument);
            od

            return Types.GENERIC(LOCATION.internal, context, arguments);
        si
    si
si
