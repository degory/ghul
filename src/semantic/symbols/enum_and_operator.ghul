namespace Semantic.Symbols is
    // Supplies the `&` operator for an enum type.
    //
    // Enums combine by their underlying integer, the same opcode the
    // numeric primitives use. It cannot be declared in the runtime
    // alongside those for the same reason `<>` and `=~` cannot: each
    // enum is its own type, so there is nothing to hang a declaration
    // on, and a declaration generic enough to cover them all also
    // covers structs.
    //
    // Mirrors `ENUM_ORDER_OPERATOR`/`ENUM_EQUALITY_OPERATOR`. Unlike
    // those two, both operands and the result are the enum's own type
    // rather than `int` or `bool` — there is no coercion to or from the
    // underlying integer, so combining values of two different enum
    // types is rejected the ordinary way an operator lookup fails,
    // rather than needing a dedicated check.
    class ENUM_AND_OPERATOR is
        register(owner: Classy) static is
            let type = owner.type

            // An enum whose type is not built yet has nothing to combine
            // against; nothing reaches this today, and the check is here
            // so a caller that does gets no half-formed operator.
            if !type? then
                return
            fi

            let operator =
                INNATE_METHOD(owner.location, owner, "&", owner, "arithmetic.and")

            operator.argument_names = Collections.LIST[string](["other"])
            operator.arguments = Collections.LIST[Types.Type]([type])
            operator.return_type = type

            // The combination lowers to an opcode and writes nothing.
            // Declared here rather than inferred: the store-free
            // analysis classifies a function by walking its body, and
            // this one is built as a symbol without one.
            operator.mark_declared_pure()

            owner.add_member(operator)
        si
    si
si
