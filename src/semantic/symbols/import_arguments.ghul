namespace Semantic.Symbols is
    use Type = Semantic.Types.Type;
    use Collections.LIST;

    // Whether an imported function's parameters hand it any way to
    // reach code declared in the assembly being built.
    //
    // Imported code can invoke only members it can name, and the names
    // available to it for an argument are those declared on the
    // parameter's own type. That type is never a type declared here,
    // so the only in-assembly code an argument can expose is an
    // override of a member the parameter's type already declares.
    // `string` is sealed and declares no such member, and neither does
    // a type that holds no reference at all.
    //
    // Being a value type is not enough on its own: a struct holds
    // whatever its fields and type arguments hold, so an
    // `(object, object)` tuple hands over two references while an
    // `(int, int)` hands over none. The test therefore descends
    // through both, and gives up rather than guessing when the
    // descent runs long or reaches something it cannot classify.
    //
    // A type variable is excluded rather than trusted. `GENERIC`
    // reports itself a value type unconditionally, and a parameter
    // spelled as a bare type variable carries whatever the
    // instantiation supplies - an in-assembly class among the
    // possibilities.
    //
    // A `ref` or pointer parameter is not a value type here, which is
    // what keeps the interpolated-string-handler overloads out.
    class IMPORT_ARGUMENTS is
        // Descending further than this costs more than the answer is
        // worth. Struct nesting reaches two or three in practice, so
        // the limit is only met by shapes the caller is better off
        // treating as opaque.
        _MAX_DEPTH: int static => 4;

        all_arguments_scalar(function: Function?) -> bool static is
            if !function? then
                return false;
            fi

            for argument in function.arguments do
                if !_holds_no_reference(argument, 0, Collections.LIST[Type]()) then
                    return false;
                fi
            od

            return true;
        si

        // `seen` carries the types the descent is already inside. A
        // primitive is its own field in .NET metadata - `Int32`
        // declares an `Int32` - so without it the walk descends
        // through `int` until it hits the depth limit and declines
        // every scalar parameter there is.
        _holds_no_reference(type: Type?, depth: int, seen: Collections.LIST[Type]) -> bool static is
            if !type? \/ depth > _MAX_DEPTH \/ type.is_type_variable then
                return false;
            fi

            for already in seen do
                if type.matches(already) then
                    return true;
                fi
            od

            // The string type is fetched only once a parameter has
            // already failed the value-type test, so a member with no
            // parameters needs no lookup at all.
            if !type.is_value_type then
                return type.matches(IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type());
            fi

            seen.add(type);

            // A constructed value type carries its arguments' values,
            // so its arguments are handed over along with it.
            for argument in type.arguments do
                if !_holds_no_reference(argument, depth + 1, seen) then
                    return false;
                fi
            od

            for member in type.symbol.symbols do
                if !member.is_field then
                    continue;
                fi

                let field_type = member.type;

                // A field spelled as one of the owner's type variables
                // holds whatever the corresponding argument holds,
                // which the loop above has already judged.
                if field_type? /\ field_type.is_type_variable then
                    continue;
                fi

                if !_holds_no_reference(field_type, depth + 1, seen) then
                    return false;
                fi
            od

            return true;
        si
    si
si
