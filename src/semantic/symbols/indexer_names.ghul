namespace Semantic.Symbols is
    // The names an indexer's accessors are declared under.
    //
    // .NET does not fix them: the indexer property carries whatever
    // name its declaring language chose (`System.String`'s is `Chars`,
    // C#'s default is `Item`, `IndexerName` overrides it), and the
    // declaring type names the real one with
    // `System.Reflection.DefaultMemberAttribute`. A type can also carry
    // indexed properties that are not that one.
    //
    // So an imported indexer is declared under these names whatever it
    // is called in metadata, and keeps its own name for emission via
    // `il_name_override`. Everything that resolves an `x[i]` expression
    // then has a single pair of names to look for, whether the type
    // came from source or from an assembly.
    class INDEXER_NAMES is
        // The property name a source indexer takes, and what the
        // default member is called on all but a handful of imported
        // types.
        //
        // Named in snake_case rather than as UPPER_SNAKE constants
        // because a static member's name is de-camelled when the
        // assembly is read back through reflection, so an UPPER_SNAKE
        // one is spelled differently either side of an assembly
        // boundary — `READ` here and `read` from the unit tests.
        property_name: string static => "Item";

        read: string static => "get_{property_name}";
        assign: string static => "set_{property_name}";

        // The name to declare an accessor of `property_name` under:
        // an indexer accessor is renamed, any other accessor keeps
        // the name it came in with.
        accessor(dotnet_name: string) -> string static =>
            if dotnet_name.starts_with("set_") then
                assign
            else
                read
            fi;

        // True when metadata already names the accessor the way it is
        // declared, so no second name is needed to reach it.
        is_canonical(dotnet_name: string) -> bool static =>
            dotnet_name =~ read \/ dotnet_name =~ assign;
    si
si
