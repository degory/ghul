namespace Semantic.Symbols is
    // Supplies the `<>` operator for enum types.
    //
    // Enums order by their underlying integer, so the comparison is the
    // same opcode the numeric primitives use. It cannot be declared in
    // the runtime alongside those: each enum is its own type, so there
    // is nothing to hang a declaration on, and a declaration generic
    // enough to cover them all also covers structs, whose values those
    // opcodes cannot compare.
    //
    // Supplied as a global binary operator in `Ghul`, matching the shape
    // of every other innate operator. A member would resolve
    // differently, taking the tie against a user's own operator on the
    // same type where a free function leaves that operator winning.
    //
    // Registration is deferred rather than run as each enum is declared:
    // an enum symbol can be created while the reflected operators are
    // still materialising, and declaring into `Ghul` at that point
    // leaves the group holding only what was added early. `flush` is
    // called once the symbol table is populated.
    class ENUM_ORDER_OPERATOR is
        _pending: Collections.MutableList[Classy] static;

        collect(owner: Classy) static is
            if !_pending? then
                _pending = Collections.LIST[Classy]();
            fi

            _pending.add(owner);
        si

        flush() static is
            if !_pending? \/ _pending.count == 0 then
                return;
            fi

            let target = IoC.CONTAINER.instance.namespaces.try_find_namespace(".Ghul");

            if !target? then
                return;
            fi

            let int_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_int_type();

            for owner in _pending do
                let type = owner.type;

                if !type? then
                    continue;
                fi

                let operator =
                    cast Function(
                        target.declare_innate(owner.location, "<>", "compare.order", target, null)
                    );

                operator.argument_names = Collections.LIST[string](["a", "b"]);
                operator.arguments = Collections.LIST[Types.Type]([type!, type!]);
                operator.return_type = int_type;

                // The comparison lowers to an opcode and writes nothing.
                // Declared here rather than inferred: infer-store-free
                // classifies an innate by walking its body, and this one
                // is built as a symbol without any.
                operator.mark_declared_pure();
            od

            _pending.clear();
        si
    si
si
