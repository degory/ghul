namespace Semantic.Symbols is
    // Supplies the `=~` operator for an enum type.
    //
    // Enums compare for equality by their underlying integer, the same
    // opcode the numeric primitives use. It cannot be declared in the
    // runtime alongside those for the same reason `<>` cannot: each enum
    // is its own type, so there is nothing to hang a declaration on, and a
    // declaration generic enough to cover them all also covers structs.
    //
    // Mirrors `ENUM_ORDER_OPERATOR`, which supplies `<>` for the same
    // types via `compare.order`. This supplies `=~` via `compare.value`,
    // the innate that emits `ceq` and already backs `==` on enums. `!~`
    // reaches the same innate with `actual_operation` `!~`; the innate
    // negates it there, as it does for `!=`.
    class ENUM_EQUALITY_OPERATOR is
        register(owner: Classy) static is
            register(owner, IoC.CONTAINER.instance.innate_symbol_lookup.get_bool_type());
        si

        register(owner: Classy, bool_type: Types.Type) static is
            let type = owner.type;

            // An enum whose type is not built yet has nothing to compare
            // against; nothing reaches this today, and the check is here
            // so a caller that does gets no half-formed operator.
            if !type? then
                return;
            fi

            let operator =
                INNATE_METHOD(owner.location, owner, "=~", owner, "compare.value");

            operator.argument_names = Collections.LIST[string](["other"]);
            operator.arguments = Collections.LIST[Types.Type]([type]);
            operator.return_type = bool_type;

            // The comparison lowers to an opcode and writes nothing.
            // Declared here rather than inferred: infer-store-free
            // classifies an innate by walking its body, and this one is
            // built as a symbol without one.
            operator.mark_declared_pure();

            owner.add_member(operator);
        si
    si
si
