namespace Semantic.Symbols is
    // Where a type parameter is reached from, when that is not where it
    // was declared.
    //
    // A generator's body is emitted into a frame class, so a parameter
    // the source declared on the function becomes one of the frame's
    // own: method-level where it is declared, class-level where it is
    // used, and at a different index. A closure that captures type
    // arguments moves them the same way.
    //
    // A position rather than rendered text, because metadata encodes a
    // VAR or an MVAR carrying the index, and reading the index back out
    // of a rendering would be taking presentation for fact.
    class TYPE_PARAMETER_POSITION is
        is_class_level: bool;
        index: int;

        init(is_class_level: bool, index: int) is
            self.is_class_level = is_class_level;
            self.index = index;
        si

        prefix: string => if is_class_level then "!" else "!!" fi;

        to_string() -> string => "{prefix}{index}";
    si
si
