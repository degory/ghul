namespace Semantic.Symbols is
    use Compiler
    use IoC
    use Source

    // The per-cell view a session compiles each cell against. A cell's
    // code was written against the cells before it, so an alternative a
    // later cell declares is invisible to the closed-hierarchy decisions
    // of an earlier cell's code; what those decisions could not see is
    // carried by the guards a session emits. An ordinary build, and any
    // file that is not a cell, sees everything.
    class SESSION_VIEW is
        // Whether `alternative`, a member of a closed root's in-set, is
        // part of the hierarchy as the code at `site` was compiled
        // against it: declared in a cell no later than the site's own,
        // or not declared in a cell at all.
        is_visible(alternative: Classy, site: LOCATION) -> bool static is
            let flags = IoC.CONTAINER.instance.build_flags

            if !flags.want_session then
                return true
            fi

            let alternative_cell = flags.session_cell_at(alternative.location.file_name)

            if !alternative_cell? then
                return true
            fi

            let site_cell = flags.session_cell_at(site.file_name)

            if !site_cell? then
                return true
            fi

            return alternative_cell <= site_cell
        si
    si
si
