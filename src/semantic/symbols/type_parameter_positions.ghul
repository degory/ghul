namespace Semantic.Symbols is
    use Collections;

    // Where each type parameter is currently reached from, for the code
    // being emitted.
    //
    // The position cannot live on the parameter's symbol, because a
    // parameter does not have one object. `GenericArgument.freeze` is a
    // memberwise clone, and a closure freezes the types it captures at
    // its load site, so by emission time the same source-level parameter
    // is represented by several symbols. A position installed on one of
    // them is invisible to the rest, and the copies then encode at their
    // declared method-level index inside a frame method that has no
    // method type parameters at all - metadata the runtime rejects.
    //
    // So the position is held here, against a key every copy of a
    // parameter agrees on. `freeze` preserves both the owner and the
    // declared index, and `make_specialized` records the parameter it
    // was specialized from as the copy's owner, so following that chain
    // and pairing the root with its index identifies the parameter
    // itself rather than one representation of it. The key is built from
    // object references and an integer: nothing about it depends on how
    // a parameter is spelled or rendered.
    class TYPE_PARAMETER_POSITIONS is
        _positions: MAP[TYPE_PARAMETER_KEY, () -> TYPE_PARAMETER_POSITION];

        init() is
            _positions = MAP[TYPE_PARAMETER_KEY, () -> TYPE_PARAMETER_POSITION]();
        si

        get(argument: GenericArgument) -> (() -> TYPE_PARAMETER_POSITION)? is
            let key = TYPE_PARAMETER_KEY.of(argument);

            let result: () -> TYPE_PARAMETER_POSITION mut;

            if _positions.try_get_value(key, result ref) then
                return result;
            fi

            return null;
        si

        set(argument: GenericArgument, position: (() -> TYPE_PARAMETER_POSITION)?) is
            let key = TYPE_PARAMETER_KEY.of(argument);

            if position? then
                _positions[key] = position;
            else
                _positions.remove(key);
            fi
        si
    si

    // Identifies a type parameter across every symbol that represents it.
    struct TYPE_PARAMETER_KEY is
        owner: object?;
        index: int;

        init(owner: object?, index: int) is
            self.owner = owner;
            self.index = index;
        si

        // A specialized copy carries the parameter it came from as its
        // owner, so the chain is followed to the parameter that was
        // declared. A frozen copy keeps its source's owner already.
        of(argument: GenericArgument) -> TYPE_PARAMETER_KEY static is
            let root: GenericArgument mut = argument;

            while isa GenericArgument(root.owner) do
                root = cast GenericArgument(root.owner);
            od

            return TYPE_PARAMETER_KEY(root.owner, root.index);
        si

        =~(other: TYPE_PARAMETER_KEY) -> bool =>
            index == other.index /\ _same_owner(other.owner);

        _same_owner(other_owner: object?) -> bool =>
            if owner? then
                if other_owner? then
                    // Reference identity: two parameters are the same
                    // parameter when they were declared by the same
                    // symbol, not when their owners describe alike.
                    object.reference_equals(owner, other_owner)
                else
                    false
                fi
            else
                !other_owner?
            fi;

        get_hash_code() -> int =>
            if owner? then
                System.Runtime.CompilerServices.RuntimeHelpers.get_hash_code(owner) * 31 + index
            else
                index
            fi;

        to_string() -> string => "[type parameter {owner} #{index}]";
    si
si
