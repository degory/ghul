namespace Semantic.Symbols is
    // The operators a type declares for itself: the arithmetic, bitwise
    // and shift operators, which a .NET type declares as a public static
    // `op_*` method and which ghūl declares as an intrinsic for each
    // scalar type. Both are registered on the type of their first
    // operand, so an operator expression finds every candidate the same
    // way - on the types of its operands - and a reflected operator never
    // competes with an intrinsic for the same operands.
    //
    // Equality, ordering, the boolean connectives and the range operators
    // stay global: no reflected type contributes one that reaches
    // operator resolution, and equality and ordering carry their own
    // resolution around the null-safe and relational rewrites.
    class TYPE_HOMED_OPERATORS is
        _names: Collections.SET[string] static

        init() static is
            _names = Collections.SET[string]([
                "+", "-", "*", "/", "%",
                "&", "|", "^", "\\",
                "<<", ">>", ">>>"
            ])
        si

        contains(name: string) -> bool static => _names.contains(name)
    si
si
