namespace IR is
    use IR.Program
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.Symbol

    /// Which definitions a cell-linked build (see `--cell-link`) emits, and
    /// which it only names because an earlier cell, loaded before this one,
    /// defines them.
    class CELL_LINK is
        init() is si

        /// Whether the build is one cell of a session whose cells are
        /// separate objects loaded into one process.
        is_active: bool static => IoC.CONTAINER.instance.build_flags.want_cell_link

        /// Whether `symbol` is defined by an earlier cell: written in one of
        /// that cell's files, and not generic, since a generic is
        /// instantiated where it is used. Such a definition is declared here
        /// and defined where its cell was compiled.
        ///
        /// - symbol: the function, variable or field to classify
        is_prebuilt(symbol: Symbol) -> bool static is
            if let at = cell_of(symbol) then
                return at < IoC.CONTAINER.instance.build_flags.previous_cells
            fi

            return false
        si

        /// Whether `symbol` is written in the cell being compiled and is not
        /// generic: a later cell may use it, so it is defined, and exported,
        /// whether or not this cell uses it.
        ///
        /// - symbol: the function, variable or field to classify
        is_exported(symbol: Symbol) -> bool static is
            if let at = cell_of(symbol) then
                return at >= IoC.CONTAINER.instance.build_flags.previous_cells
            fi

            return false
        si

        /// The place of the cell that defines `symbol` in the session, or
        /// null where the build is not cell-linked, the symbol is generic or
        /// is not written in a cell's file.
        ///
        /// - symbol: the function, variable or field to place
        cell_of(symbol: Symbol) -> int? static is
            if !is_active \/ _is_generic(symbol) then
                return null
            fi

            let location =
                if let function: Function = symbol then
                    PROGRAM_FUNCTIONS.source_location(function)
                else
                    symbol.location
                fi

            if location.is_internal \/ location.is_reflected \/ location.is_unknown then
                return null
            fi

            return IoC.CONTAINER.instance.build_flags.session_cell_at(location.file_name)
        si

        _is_generic(symbol: Symbol) -> bool static is
            if let function: Function = symbol then
                return FUNCTION_BODIES.is_generic(function)
            fi

            let scope: Semantic.Scope? mut = symbol.owner

            while scope? do
                if let classy: Classy = scope /\ classy.is_generic then
                    return true
                fi

                if let owner: Symbol = scope /\ owner.owner != scope then
                    scope = owner.owner
                else
                    scope = null
                fi
            od

            return false
        si
    si
si
