namespace IR is
    use IR.Program

    use Source

    use Collections.LIST
    use Collections.MAP
    use Collections.SET

    use Semantic.Symbols.Function
    use Semantic.Symbols.FRAME
    use Semantic.Symbols.ScopedWithEnclosingScope
    use Semantic.Symbols.Symbol

    /// The names functions and globals are given in a whole-program target's
    /// output: an LLVM module's symbols, a wasm module's name section.
    ///
    /// A name is a readable label for what it stands for: a function's
    /// qualified name and type arguments, a type's descriptor as the type's
    /// name with `.$descriptor` after it, and so on. A label is derived from
    /// the declaration alone - the namespaces it is declared in, including
    /// one the compiler synthesised for a file or a cell, and a closure's
    /// position in its source - so that the same declaration always receives
    /// the same name however the rest of the program is made up. Where two
    /// declarations still produce the same label, a numeric suffix tells
    /// them apart.
    ///
    /// A part the compiler adds starts with `$`, which no ghūl identifier
    /// can, so a label never clashes with a declared name. Only the names
    /// the runtime library itself defines or expects start `$ghul_`.
    class LINKER_NAMES is
        _names: MAP[FUNCTION_INSTANCE, string]
        _taken: SET[string]

        init() is
            _names = MAP[FUNCTION_INSTANCE, string]()
            _taken = SET[string]()
        si

        /// Keeps `name` from being given to anything else, for a name the
        /// module declares for itself.
        ///
        /// - name: the name to keep
        reserve(name: string) is
            _taken.add(name)
        si

        /// The name of the function `instance`, chosen the first time it is
        /// asked for.
        ///
        /// - instance: the function instance to name
        name_of(instance: FUNCTION_INSTANCE) -> string is
            let name mut = ""

            if _names.try_get_value(instance, name ref) then
                return name
            fi

            name = unique(label(instance))

            _names[instance] = name

            return name
        si

        /// The longest a label is kept before a name is made from it.
        MAX_LABEL_LENGTH: int static => 96

        /// A name no earlier one holds: `label`, cut to `MAX_LABEL_LENGTH`
        /// code units, itself or with the first numeric suffix that is free.
        ///
        /// - label: what the name should read as
        unique(label: string) -> string is
            let cut = shortened(label)
            let name mut = cut
            let suffix mut = 1

            while !_taken.add(name) do
                name = "{cut}.{suffix}"
                suffix = suffix + 1
            od

            return name
        si

        /// `label`, cut to at most `MAX_LABEL_LENGTH` code units without
        /// splitting a surrogate pair.
        ///
        /// - label: the label to cut
        shortened(label: string) -> string static is
            if label.length <= MAX_LABEL_LENGTH then
                return label
            fi

            let length = if label[MAX_LABEL_LENGTH - 1] >= '\uD800' /\ label[MAX_LABEL_LENGTH - 1] <= '\uDBFF' then MAX_LABEL_LENGTH - 1 else MAX_LABEL_LENGTH fi

            return label.substring(0, length)
        si

        /// The label of the function `instance`, without giving it a name.
        ///
        /// - instance: the function instance to label
        label(instance: FUNCTION_INSTANCE) -> string =>
            if instance.type_map.count == 0 then
                function_label(instance.definition)
            else
                "{function_label(instance.definition)}[{instance.type_map.values |> Ghul.Pipes.join(",")}]"
            fi

        /// The label of the class instance `type`.
        ///
        /// - type: the class instance to label
        type_label(type: CLASS_INSTANCE) -> string is
            let name =
                if let frame: FRAME = type.definition then
                    frame_label(frame)
                else
                    qualified(type.definition)
                fi

            return if type.arguments.count == 0 then name else "{name}[{type.arguments |> Ghul.Pipes.join(",")}]" fi
        si

        // A function literal has no name of its own, so it and the frame
        // holding what it captures are labelled after the function it is
        // written in, at the source position where it is written: the
        // position is a part of the declaration, so the label does not
        // depend on what else the program holds. A function a frame
        // declares is labelled after the frame.
        function_label(definition: Function) -> string =>
            if definition.is_closure then
                "{_enclosing_label(definition)}.$closure.{_position(definition)}"
            elif let frame: FRAME = definition.owner then
                "{frame_label(frame)}.{definition.name}"
            else
                qualified(definition)
            fi

        frame_label(frame: FRAME) -> string => "{_enclosing_label(frame.closure)}.$closure.{_position(frame.closure)}.$frame"

        // Where in its source a declaration sits, as a name part: line and
        // column of a real location, or nothing for one the compiler wrote.
        _position(definition: Function) -> string is
            let location = definition.location

            if location.is_internal \/ location.is_reflected \/ location.is_unknown then
                return "synthesised"
            fi

            return "{location.start_line}.{location.start_column}"
        si

        // The label of the function a literal is written in, through any
        // block or literal it is nested in; at namespace scope, the
        // namespace's name.
        _enclosing_label(literal: Function) -> string is
            let scope: Semantic.Scope? mut = literal.enclosing_scope

            while scope? do
                if let function: Function = scope /\ !function.is_closure then
                    return function_label(function)
                elif let block: Semantic.BLOCK_SCOPE = scope then
                    scope = block.enclosing
                elif let scoped: ScopedWithEnclosingScope = scope then
                    scope = scoped.enclosing_scope
                elif let symbol: Symbol = scope then
                    return qualified(symbol)
                else
                    scope = null
                fi
            od

            return "$global"
        si

        // `symbol`'s name qualified by every scope that declares it,
        // including a namespace the compiler synthesised for a file or a
        // cell. Unlike the name a diagnostic shows, a linker name keeps
        // those: a cell's declarations are reached from outside it, so what
        // cell declared them has to be in the name.
        qualified(symbol: Symbol) -> string is
            let parts = LIST[string]()

            let current: Symbol? mut = symbol

            while let declared: Symbol = current do
                parts.insert(0, declared.name)
                current = _declaring_scope(declared)
            od

            return parts |> Ghul.Pipes.join(".")
        si

        // The scope `symbol` is declared in, as a symbol worth naming
        // through; a namespace the compiler generated for a file with none
        // written is included, and the unnamed root is not.
        _declaring_scope(symbol: Symbol) -> Symbol? is
            let owner = symbol.owner

            if let `namespace: Semantic.Symbols.NAMESPACE = owner then
                if `namespace.qualified_name.length <= 1 then
                    return null
                fi
            fi

            if let declared_in: Symbol = owner then
                return declared_in
            fi

            return null
        si
    si
si
