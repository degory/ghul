namespace IR.Values is
    use Semantic.Types.Type

    /// The number of bytes a value of `measured` takes where it is stored,
    /// as an element of an array holds it, as an `int`.
    class SIZE_OF: Value is
        /// The type whose size is taken.
        measured: Type

        type: Type

        /// - measured: the type whose size is taken
        /// - type: the type of the result, `int`
        init(measured: Type, type: Type) is
            super.init()

            self.measured = measured
            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "size_of:[{measured}]()"
    si
si
