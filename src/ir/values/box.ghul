namespace IR.Values is
    use Semantic.Types.Type;

    class BOX: Value is
        value: Value;
        type: Type? pure => value.type;
        is_value_type: bool => false;

        init(
            value: Value
        ) is
            super.init();

            self.value = value;
        si

        gen(context: IR.CONTEXT) is
            gen(value, context);

            let body = context.current_srm_body_emitter!;
                body.box(context.resolve_type_token(type!));
        si

        to_string() -> string =>
            "box:[{type}]({value})";
    si
si