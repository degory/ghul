namespace IR.Values is
    use Semantic.Types.Type;

    // Coerce a reference-typed `T?` into the unconstrained-T optional
    // carrier `Ghul.MAYBE[T]`. A reference optional carries absence as
    // a null reference and MAYBE as a zeroed struct, so the two are
    // bridged by a null test: the present path wraps the reference
    // with MAYBE<T>::.ctor(T), the absent path yields the empty MAYBE.
    //
    //   <value IL>          // [..., a]
    //   dup                 // [..., a, a]
    //   brtrue <present>    // pops one a
    //   pop                 // [...]
    //   <absent IL>         // [..., empty MAYBE]
    //   br <end>
    //   <present>:
    //   newobj MAYBE<T>::.ctor(T)
    //   <end>:
    //
    // Built by VALUE_BOXER.wrap_if_needed. The value-type optional
    // sources (NULLABLE[T], another MAYBE instantiation) go through
    // NULL_COALESCE_VALUE instead, since presence there is a member
    // read off the struct's address rather than a null test.
    class WRAP_MAYBE: Value is
        value: Value;
        _maybe_type: Type;
        _absent: Value;

        type: Type => _maybe_type;
        is_value_type: bool => true;
        is_lightweight_pure: bool => false;

        init(
            maybe_type: Type,
            value: Value
        ) is
            super.init();

            self._maybe_type = maybe_type;
            self.value = value;
            self._absent = Values.DEFAULT(maybe_type);
        si

        gen(context: IR.CONTEXT) is
            let present_label = IR.LABEL();
            let end_label = IR.LABEL();

            gen(value, context);

            let body = context.current_srm_body_emitter!;
                body.op(System.Reflection.Metadata.ILOpCode.DUP);
                body.branch(System.Reflection.Metadata.ILOpCode.BRTRUE, present_label);
                body.op(System.Reflection.Metadata.ILOpCode.POP);
                gen(_absent, context);
                body.branch(System.Reflection.Metadata.ILOpCode.BR, end_label);
                body.mark_label(present_label);
                body.new_object(context.resolve_generic_constructor(_maybe_type, 1));
                body.mark_label(end_label);
        si

        to_string() -> string =>
            "wrap-maybe:[{_maybe_type}]({value})";
    si
si
