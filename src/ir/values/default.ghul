namespace IR.Values is
    use Semantic.Types.Type;

    class DEFAULT: Value is
        type: Type;
        is_value_type: bool => type.is_value_type;
        is_value_tuple: bool => type.is_value_tuple;

        has_address: bool => true;

        init(
            type: Type
        ) is
            super.init();

            self.type = type;
        si

        gen(context: IR.CONTEXT) is
            let id = TEMP.get_next_id();

            let body = context.current_srm_body_emitter!;
                body.declare_local(".default.{id}", type);
                body.ldloc(".default.{id}");
        si

        gen_address(context: IR.CONTEXT) is
            let id = TEMP.get_next_id();

            let body = context.current_srm_body_emitter!;
                body.declare_local(".default.{id}", type);
                body.ldloca(".default.{id}");
        si

        to_string() -> string =>
            "default:[{type}]()";
    si
si