namespace IR.Values is
    use Semantic.Types.Type

    // The result of `a ?? b` where `a` holds the runtime's Result
    // union: a present default variant contributes its payload and an
    // absent one is replaced by `b`, whose type is the result's — the
    // error variant never widens the answer. The receiver is spilled
    // to a temporary so the presence test, the payload extract and
    // the present arm read one value, and the payload is held in
    // `payload_local`, a local the builder made, so the present arm
    // reads it from the local rather than the evaluation stack — a
    // constructor among the present arm's arguments is emitted
    // allocation-first by some back ends, which a stack-fed argument
    // would compose with backwards. `b` is evaluated only on the
    // absent path.
    //
    // Built by COMPILE_OPERATORS._visit_null_coalesce.
    class RESULT_COALESCE: Composite is
        receiver: Value
        presence_test: Value
        value_extract: Value
        present_arm: Value
        absent_arm: Value
        payload_local: LOCAL
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(
            receiver: Value,
            presence_test: Value,
            value_extract: Value,
            present_arm: Value,
            absent_arm: Value,
            payload_local: LOCAL,
            result_type: Type
        ) is
            super.init()

            self.receiver = receiver
            self.presence_test = presence_test
            self.value_extract = value_extract
            self.present_arm = present_arm
            self.absent_arm = absent_arm
            self.payload_local = payload_local
            self._result_type = result_type
        si

        // The receiver is held in a temporary, which the presence test
        // and the payload extract read from the stack; the payload
        // lands in `payload_local`, which the present arm reads.
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let held = expansion.temp("coalesce", receiver.type!)

            expansion.store(held, receiver)

            expansion.declare(payload_local)

            let result = expansion.temp("coalesced", type)

            let done = expansion.region()
            let absent = expansion.region()

            expansion.exit_if(absent, IR.BRANCH.Z, STEPS([held.load(), presence_test]:Value))
            expansion.store(payload_local, STEPS([held.load(), value_extract]:Value))
            expansion.store(result, present_arm)
            expansion.exit(done)
            expansion.close(absent)

            expansion.store(result, absent_arm)
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si

        to_string() -> string =>
            "result-coalesce:[{type}]({receiver},{absent_arm})"
    si
si
