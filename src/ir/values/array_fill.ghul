namespace IR.Values is
    use Semantic.Types.Type

    // A new array of `element_type` with `count` elements, on the stack.
    class NEW_ARRAY: Value is
        _element_type: Type
        _count: Value

        type: Type

        init(type: Type, element_type: Type, count: Value) is
            super.init()

            self.type = type
            _element_type = element_type
            _count = count
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!

            gen(_count, context)

            body.new_array(context.resolve_type_token(_element_type))
        si

        to_string() -> string => "new-array:[{type}]({_count})"
    si

    // `array[index] = element`, boxing the element where the array holds
    // a reference type. Leaves nothing on the stack.
    class STORE_ARRAY_ELEMENT: Value is
        _array: Value
        _index: Value
        _element: Value
        _element_type: Type

        init(array: Value, index: Value, element: Value, element_type: Type) is
            super.init()

            _array = array
            _index = index
            _element = element
            _element_type = element_type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!

            gen(_array, context)
            gen(_index, context)
            gen(IoC.CONTAINER.instance.value_boxer.box_if_needed(_element, _element_type), context)

            body.store_element(context.resolve_type_token(_element_type))
        si

        to_string() -> string => "store-array-element:({_array}[{_index}] = {_element})"
    si
si
