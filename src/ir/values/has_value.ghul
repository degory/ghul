namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed;
    use Semantic.Types.Type;

    class HAS_VALUE: Value, TypeTyped is
        type: Type;

        value: Value;

        init(
            value: Value,
            type: Type
        ) is
            super.init();

            self.value = value;
            self.type = type;
        si

        gen(context: IR.CONTEXT) is
            gen(value, context);

            let body = context.current_srm_body_emitter!;
                body.ldnull();
                body.op(System.Reflection.Metadata.ILOpCode.CGT_UN);
        si

        to_string() -> string =>
            "has-value:[{type}]({value})";
    si
si