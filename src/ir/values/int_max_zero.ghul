namespace IR.Values is
    use Semantic.Types.Type

    // An int operand, or zero where it is negative, on the stack. A range
    // whose end precedes its start yields no elements, and a fused
    // collect sized at its `to - from` must allocate nothing rather than
    // ask for a negative length.
    class INT_MAX_ZERO: Value is
        _operand: Value

        type: Type

        init(operand: Value, type: Type) is
            super.init()

            _operand = operand
            self.type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
            let non_negative = IR.LABEL()

            gen(_operand, context)

            body.op(System.Reflection.Metadata.ILOpCode.DUP)
            body.ldc_i4(0)
            body.branch(System.Reflection.Metadata.ILOpCode.BGE, non_negative)
            body.op(System.Reflection.Metadata.ILOpCode.POP)
            body.ldc_i4(0)
            body.mark_label(non_negative)
        si

        to_string() -> string => "int-max-zero:({_operand})"
    si
si
