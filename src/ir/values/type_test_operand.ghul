namespace IR.Values is
    use Source.LOCATION

    use Semantic.Types.Type

    // Pushes the operand of a runtime type test as the object reference
    // `isinst` and `castclass` expect. A value type is boxed: boxing a
    // `Nullable<T>` already yields null or the boxed payload. A `MAYBE[T]`
    // does not box that way - the box would hold the carrier rather than
    // its payload - so it is unwrapped first, giving null when absent. A
    // type variable is boxed through its own token, which leaves a
    // reference alone.
    class TYPE_TEST_OPERAND is
        init() is si

        gen(value: Value, context: IR.CONTEXT) static is
            if let maybe: Semantic.Types.MAYBE = value.type then
                _gen_maybe(value, maybe, context)

                return
            fi

            value.gen(context)

            let body = context.current_srm_body_emitter!

            if value.is_value_type then
                body.box(context.resolve_type_token(value.type!))
            elif let variable = value.type?.type_variable_side then
                body.box(context.resolve_type_token(variable))
            fi
        si

        _gen_maybe(value: Value, maybe: Semantic.Types.MAYBE, context: IR.CONTEXT) static is
            let loader = IoC.CONTAINER.instance.symbol_loader
            let address = STACK_TOP_ADDRESS(maybe)

            let has_value = maybe.find_member("has_value")!.load(LOCATION.internal, address, loader)
            let payload = maybe.find_member("value")!.load(LOCATION.internal, address, loader)

            let absent = IR.LABEL()
            let end = IR.LABEL()

            let body = context.current_srm_body_emitter!
            let temp = ".type_test.{TEMP.get_next_id()}"

            body.declare_local(temp, maybe)

            value.gen(context)

            body.stloc(temp)
            body.ldloca(temp)

            has_value.gen(context)

            body.branch(System.Reflection.Metadata.ILOpCode.BRFALSE, absent)
            body.ldloca(temp)

            payload.gen(context)

            body.box(context.resolve_type_token(maybe.arguments[0]))
            body.branch(System.Reflection.Metadata.ILOpCode.BR, end)
            body.mark_label(absent)
            body.ldnull()
            body.mark_label(end)
        si
    si
si
