namespace IR.Values is
    use Semantic.Types.Type

    // One int arithmetic instruction over two pre-built int operands,
    // leaving the result on the stack. A fused collect over a range
    // sizes its result at `to - from`, and neither operand is a literal.
    class INT_ARITHMETIC: Value is
        _op_code: System.Reflection.Metadata.ILOpCode
        _left: Value
        _right: Value

        type: Type

        init(op_code: System.Reflection.Metadata.ILOpCode, left: Value, right: Value, type: Type) is
            super.init()

            _op_code = op_code
            _left = left
            _right = right
            self.type = type
        si

        gen(context: IR.CONTEXT) is
            gen(_left, context)
            gen(_right, context)

            context.current_srm_body_emitter!.op(_op_code)
        si

        to_string() -> string => "int-arithmetic:{_op_code}({_left}, {_right})"
    si
si
