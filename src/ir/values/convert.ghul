namespace IR.Values is
    use System.Reflection.Metadata.ILOpCode;
    use Semantic.Types.Type;
    
    class CONVERT: Value is
        type: Type;
        value: Value;
        op_code: ILOpCode;

        init(
            type: Type,
            value: Value,
            op_code: ILOpCode
        ) is
            super.init();

            self.type = type;
            self.value = value;
            self.op_code = op_code;
        si

        gen(context: IR.CONTEXT) is
            gen(value, context);

            context.current_srm_body_emitter!.op(op_code);
        si

        to_string() -> string =>
            "cast:[{type}]({value})";
    si
si