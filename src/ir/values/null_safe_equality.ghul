namespace IR.Values is
    use Semantic.Types.Type;

    // `a =~ b` where either operand is an optional reference and the
    // operator declares its parameter non-optional. The null checks go
    // here rather than in the body, which is therefore only entered on
    // two present values.
    //
    // Absent on the left answers whether the right is absent too, so
    // two absent values are equal; absent on one side only is not
    // equal. `!~` wraps the whole thing in a NOT, so it negates these
    // arms along with the body's answer.
    //
    //   <left IL>            // a load of an already-spilled operand,
    //   brtrue <present>     // so each of the three reads below is
    //                        // repeatable and side-effect free
    //   <right IL>
    //   ldnull
    //   ceq                  // both absent
    //   br <end>
    //   <present>:
    //   <right IL>
    //   brtrue <both>
    //   ldc.i4.0             // left present, right absent
    //   br <end>
    //   <both>:
    //   <equal IL>           // the operator's own call
    //   <end>:
    //
    // Built by COMPILE_OPERATORS when `=~` resolves against the
    // operands' non-optional types but not against the optionals
    // themselves. The branch offsets are written long rather than
    // short: the call arm carries an arbitrary user body.
    class NULL_SAFE_EQUALITY: Value is
        left: Value;
        right: Value;
        equal_when_both_present: Value;
        _result_type: Type;

        type: Type => _result_type;
        is_lightweight_pure: bool => false;

        init(left: Value, right: Value, equal_when_both_present: Value, result_type: Type) is
            super.init();

            self.left = left;
            self.right = right;
            self.equal_when_both_present = equal_when_both_present;
            self._result_type = result_type;
        si

        gen(context: IR.CONTEXT) is
            let left_present = IR.LABEL();
            let both_present = IR.LABEL();
            let end_label = IR.LABEL();

            gen(left, context);
            context.write_line("brtrue {left_present}");

            gen(right, context);
            context.write_line("ldnull");
            context.write_line("ceq");
            context.write_line("br {end_label}");

            context.write_line("{left_present}:");
            gen(right, context);
            context.write_line("brtrue {both_present}");
            context.write_line("ldc.i4.0");
            context.write_line("br {end_label}");

            context.write_line("{both_present}:");
            gen(equal_when_both_present, context);

            context.write_line("{end_label}:");
        si

        to_string() -> string =>
            "null-safe-equality:[{type}]({left},{right},{equal_when_both_present})";
    si
si
