namespace IR.Values is
    use Semantic.Types.Type;

    // `a =~ b` where either operand is an optional reference.
    //
    // The left operand is always tested here, because an absent one
    // has no receiver to dispatch on: absent on the left answers
    // whether the right is absent too, so two absent values are equal.
    //
    // The right operand is tested here only when the operator declares
    // its parameter non-optional, which is `guards_argument`. An
    // operator declaring `T?` is written to answer for an absent
    // argument itself, so it is handed one and decides.
    //
    // `!~` wraps the whole thing in a NOT, so it negates these arms
    // along with the body's answer.
    //
    //   <left IL>            // a load of an already-spilled operand,
    //   brtrue <present>     // so each of the three reads below is
    //                        // repeatable and side-effect free
    //   <right IL>
    //   ldnull
    //   ceq                  // both absent
    //   br <end>
    //   <present>:
    //   <right IL>
    //   brtrue <both>
    //   ldc.i4.0             // left present, right absent
    //   br <end>
    //   <both>:
    //   <equal IL>           // the operator's own call
    //   <end>:
    //
    // Built by COMPILE_OPERATORS when `=~` resolves against the
    // operands' non-optional types but not against the optionals
    // themselves. The branch offsets are written long rather than
    // short: the call arm carries an arbitrary user body.
    class NULL_SAFE_EQUALITY: Value is
        left: Value;
        right: Value;
        equals_call: Value;
        guards_argument: bool;
        _result_type: Type;

        type: Type => _result_type;
        is_lightweight_pure: bool => false;

        init(left: Value, right: Value, equals_call: Value, guards_argument: bool, result_type: Type) is
            super.init();

            self.left = left;
            self.right = right;
            self.equals_call = equals_call;
            self.guards_argument = guards_argument;
            self._result_type = result_type;
        si

        gen(context: IR.CONTEXT) is
            let left_present = IR.LABEL();
            let both_present = IR.LABEL();
            let end_label = IR.LABEL();

            gen(left, context);
            context.write_line("brtrue {left_present}");

            gen(right, context);
            context.write_line("ldnull");
            context.write_line("ceq");
            context.write_line("br {end_label}");

            context.write_line("{left_present}:");

            if guards_argument then
                gen(right, context);
                context.write_line("brtrue {both_present}");
                context.write_line("ldc.i4.0");
                context.write_line("br {end_label}");

                context.write_line("{both_present}:");
            fi

            gen(equals_call, context);

            context.write_line("{end_label}:");
        si

        to_string() -> string =>
            "null-safe-equality:[{type}]({left},{right},{equals_call},guards-argument={guards_argument})";
    si
si
