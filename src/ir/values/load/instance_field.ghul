namespace IR.Values.Load is
    use TypeTyped = Semantic.Types.Typed;
    use SymbolBase = Semantic.Symbols.Symbol;

    // The cast to the symbol's expected kind is a checked construction
    // invariant: the caller only ever builds this value with a symbol of
    // that kind, so a throw here means the invariant broke elsewhere.
    @suppress("cast-may-throw")
    class INSTANCE_FIELD: SYMBOL, TypeTyped is
        is_consumable: bool => true;
        is_lightweight_pure: bool => from!.is_lightweight_pure;

        // A field is addressable in place when its containing instance
        // is: a reference receiver holds the object, so ldflda always
        // works; a struct receiver must itself be addressable or the
        // field lives in a temporary copy.
        has_address: bool =>
            if from!.is_value_type then
                from!.has_address
            else
                true
            fi;

        init(from: Value, symbol: SymbolBase) is
            super.init(from, symbol);
        si

        gen(context: IR.CONTEXT) is
            gen(from, context);

            let body = context.current_srm_body_emitter!;
                body.ldfld(context.resolve_field_target(cast Semantic.Symbols.Field(symbol)));
        si

        gen_address(context: IR.CONTEXT) is
            // `ldflda` takes the containing instance: the reference value
            // for a reference-type receiver, a managed pointer for a
            // value-type (struct) receiver. Taking the receiver's address
            // unconditionally would compute the field offset from the local
            // slot holding the reference, not from the object.
            if from!.is_value_type then
                from!.gen_address(context);
            else
                gen(from, context);
            fi
            let body = context.current_srm_body_emitter!;
                body.ldflda(
                    context.resolve_field_target(
                        cast Semantic.Symbols.Field(symbol)));
        si

        to_string() -> string =>
            "load:[{type}]({from},\"{symbol.name}\")";
    si
si