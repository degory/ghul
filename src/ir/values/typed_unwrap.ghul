namespace IR.Values is
    use Semantic.Types.Type

    // `!` on a union value with a default variant, throwing the core's
    // typed unwrap exception when the value holds another variant. The
    // default arm projects the default variant the way the plain unwrap
    // does; the absent arm is the typed throw, built by the compiler from
    // the complement variant's payload.
    //
    // Built by COMPILE_ACCESS._build_default_variant_unwrap when the core
    // declares the exception class; otherwise the plain checked cast stands.
    //
    //   <isa test>             // truthy when the value holds the default
    //   present / absent arms  // one runs, its value is the result
    class TYPED_UNWRAP: Composite is
        is_default: Value
        present: Value
        absent: Value
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(is_default: Value, present: Value, absent: Value, result_type: Type) is
            super.init()

            self.is_default = is_default
            self.present = present
            self.absent = absent
            self._result_type = result_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)

            let result = expansion.temp("unwrapped", type)

            let done = expansion.region()
            let absent = expansion.region()

            expansion.exit_if(absent, IR.BRANCH.Z, STEPS([is_default]: Value))
            expansion.store(result, present)
            expansion.exit(done)
            expansion.close(absent)

            // The absent arm throws, so it leaves no value to store:
            // it runs inside its region and the divergence ends it.
            expansion.add(absent)
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si

        to_string() -> string =>
            "typed-unwrap:[{type}]({is_default},{present},{absent})"
    si
si
