namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed;
    use Semantic.Types.Type;

    // `xs[r]` where `r` is a `System.Range`: the source, the range, and
    // the call to the static that builds the window. The receiver is an
    // ordinary argument here because the static takes it as one - the
    // indexer it comes from is an instance member only so that `find_member`
    // reaches it.
    class SLICE_CALL: Value, TypeTyped is
        source: Value;
        range: Value;
        slice_type: Type;
        type: Type;

        init(source: Value, range: Value, slice_type: Type, type: Type) is
            super.init();

            self.source = source;
            self.range = range;
            self.slice_type = slice_type;
            self.type = type;
        si

        gen(context: IR.CONTEXT) is
            gen(source, context);
            gen(range, context);

            context.current_srm_body_emitter!.call(context.resolve_slice_of(slice_type));
        si

        to_string() -> string => "slice-call[{slice_type}]({source}, {range})";
    si
si
