namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    // Per-`await` IL emission inside MoveNext. Stashes the awaiter
    // to a frame field, IsCompleted-short-circuits when the awaited
    // value is already done, otherwise records the state, registers
    // the continuation through the builder and `leave`s out of
    // MoveNext. The entry-dispatch placeholder at the top of MoveNext
    // routes re-entry back to `cold_resume_label`, where state is
    // cleared and execution falls through to `hot_resume_label` to
    // call `GetResult` and leave T on the stack (or stack-effect 0
    // for a void result).
    //
    // The three awaiter-pattern calls arrive as ordinary call values:
    // `get_awaiter` over the awaited operand, and `is_completed` /
    // `get_result` over a load of the awaiter field, so the receiver
    // conventions (address of a struct, dispatch on a class) are the
    // ones every other call uses.
    //
    // ghūl uses CLASS-based state machines (matches the generator
    // shape) — `ldarg.0` is the SM instance and `ldarga.s 0` is the
    // byref needed for `ref TStateMachine`. C# Release uses STRUCT-
    // based for performance; the CLASS path costs one alloc per
    // async call.
    class AWAIT_SUSPEND: Value, TypeTyped is
        type: Type

        get_awaiter: Value
        is_completed: Value
        get_result: Value
        awaiter_type: Type

        // The awaiter implements `ICriticalNotifyCompletion`, so the
        // continuation is registered with `AwaitUnsafeOnCompleted`
        // rather than `AwaitOnCompleted`.
        is_critical: bool

        state_number: int
        cold_resume_label: IR.LABEL
        hot_resume_label: IR.LABEL
        end_of_movenext_label: IR.LABEL
        state_machine_type: Type
        state_field: Semantic.Symbols.Field
        awaiter_field: Semantic.Symbols.Field
        builder_field: Semantic.Symbols.Field

        init(
            type: Type,
            get_awaiter: Value,
            is_completed: Value,
            get_result: Value,
            awaiter_type: Type,
            is_critical: bool,
            state_number: int,
            cold_resume_label: IR.LABEL,
            hot_resume_label: IR.LABEL,
            end_of_movenext_label: IR.LABEL,
            state_machine_type: Type,
            state_field: Semantic.Symbols.Field,
            awaiter_field: Semantic.Symbols.Field,
            builder_field: Semantic.Symbols.Field
        ) is
            super.init()

            self.type = type
            self.get_awaiter = get_awaiter
            self.is_completed = is_completed
            self.get_result = get_result
            self.awaiter_type = awaiter_type
            self.is_critical = is_critical
            self.state_number = state_number
            self.cold_resume_label = cold_resume_label
            self.hot_resume_label = hot_resume_label
            self.end_of_movenext_label = end_of_movenext_label
            self.state_machine_type = state_machine_type
            self.state_field = state_field
            self.awaiter_field = awaiter_field
            self.builder_field = builder_field
        si

        // The CLR local MoveNext caches the state in. Written by the
        // same name the entry sequence declared it under, so the two
        // name one slot.
        _STATE_LOCAL: string static => ".async_state"

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                _gen_srm(context, body)
        si

        _gen_srm(context: IR.CONTEXT, body: IR.Emitter.SRM_METHOD_BODY_EMITTER) is
            let state = context.resolve_field_target(state_field)
            let awaiter = context.resolve_field_target(awaiter_field)
            let builder = context.resolve_field_target(builder_field)

            // Capture the awaiter into the frame.
            body.ldarg(0)
            gen(get_awaiter, context)
            body.stfld(awaiter)

            // Already completed: skip registering a continuation.
            gen(is_completed, context)
            body.branch(System.Reflection.Metadata.ILOpCode.BRTRUE, hot_resume_label)

            _stamp_state_srm(context, body, state_number, state)

            body.ldarg(0)
            body.ldflda(builder)
            body.ldarg(0)
            body.ldflda(awaiter)
            body.ldarga(0)
            body.call(
                context.resolve_await_on_completed(
                    builder_field.type!, awaiter_type, state_machine_type, is_critical))
            body.branch(System.Reflection.Metadata.ILOpCode.LEAVE, end_of_movenext_label)

            body.mark_label(cold_resume_label)

            _stamp_state_srm(context, body, -1, state)

            body.mark_label(hot_resume_label)
            gen(get_result, context)
        si

        // Write a state value to both the cached CLR local and the
        // frame's state field, so a `leave` out of a protected region
        // fires finally bodies that read the local and see the right
        // sentinel.
        _stamp_state_srm(
            context: IR.CONTEXT,
            body: IR.Emitter.SRM_METHOD_BODY_EMITTER,
            value: int,
            state: System.Reflection.Metadata.EntityHandle
        ) is
            body.ldarg(0)
            body.ldc_i4(value)
            body.op(System.Reflection.Metadata.ILOpCode.DUP)
            body.stloc(_STATE_LOCAL)
            body.stfld(state)
        si

        to_string() -> string =>
            "await-suspend:[{type}](state={state_number})"
    si
si
