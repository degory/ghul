namespace IR.Values is
    use Semantic.Types.Type;

    // A cast the program wrote is checked: to a non-optional reference type
    // it emits `castclass`, so a value that is not one faults here rather
    // than becoming a null in a slot whose type says it is never absent.
    // `cast T?(v)` is the spelling for a cast that is allowed to fail, and
    // keeps `isinst`.
    //
    // A coercion the compiler synthesises is unchecked, because declining is
    // the answer it wants: a refutable type test, a narrowing, and the
    // equality bridge that has to report a different type as unequal rather
    // than throw out of `Equals`.
    //
    // A value-type target keeps `isinst` whichever it is, since the unbox
    // that follows is conditional on the result being absent. So does a type
    // variable, which can be instantiated at a value type.
    class CAST: Value is
        type: Type;
        value: Value;
        is_checked: bool;

        // Whether the emitted cast faults rather than declining. Read by
        // `gen` to choose the instruction, and separately testable: a
        // fixture can settle the decision without an emitter able to
        // resolve a token for the target.
        faults_on_failure: bool =>
            is_checked /\
            !type.is_optional /\
            !type.is_value_type /\
            !type.is_type_variable;

        init(
            type: Type,
            value: Value,
            is_checked: bool
        ) is
            super.init();

            self.type = type;
            self.value = value;
            self.is_checked = is_checked;
        si

        gen(context: IR.CONTEXT) is
            gen(value, context);

            let body = context.current_srm_body_emitter!;
                if value.is_value_type then
                    body.box(context.resolve_type_token(value.type!));
                fi

                if faults_on_failure then
                    body.cast_class(context.resolve_type_token(type));
                else
                    body.is_instance(context.resolve_type_token(type));
                fi
        si

        to_string() -> string =>
            "cast:[{type}]{if is_checked then "!" else "?" fi}({value})";
    si
si
