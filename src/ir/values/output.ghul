namespace IR.Values is
    use Semantic.Types.Type;

    class ENTER_FILE: Value is
        path: string;

        init(
            path: string
        ) is
            super.init();

            self.path = path;
        si

        gen(context: IR.CONTEXT) is
            // Records the offset range the marked statement emits. The
            // range leaves the method as a custom attribute the IL test
            // runner reads. Outside a body there is no range to record:
            // a pragma on a declaration marks nothing this can measure.
            if let body = context.current_srm_body_emitter then
                body.begin_il_output(path, context.next_il_output_sequence());
            fi
        si

        to_string() -> string =>
            "enter-file:({path})";
    si

    class LEAVE_FILE: Value is
        path: string;

        init(
            path: string
        ) is
            super.init();

            self.path = path;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                body.end_il_output();
            fi
        si

        to_string() -> string =>
            "exit-file";    
    si
si
