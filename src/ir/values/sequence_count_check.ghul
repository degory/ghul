namespace IR.Values is
    use Semantic.Types.Type

    // Throws an assertion failure unless a sequence has the number of
    // elements a pattern over it needs: exactly that many, or at least that
    // many where the pattern ends in a rest element. Falls through, with no
    // value, when it does.
    class SEQUENCE_COUNT_CHECK: Composite is
        count: Value
        expected: Value
        at_least: bool
        message: Value
        _type: Type

        type: Type => _type
        is_lightweight_pure: bool => false

        init(count: Value, expected: Value, at_least: bool, message: Value, void_type: Type) is
            super.init()

            self.count = count
            self.expected = expected
            self.at_least = at_least
            self.message = message
            self._type = void_type
        si

        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)

            let matched = expansion.region()

            expansion.exit_if(matched, if at_least then IR.BRANCH.GE else IR.BRANCH.EQ fi, count, expected)
            expansion.add(THROW(RUNTIME(IR.RuntimeOperation.NEW_ASSERT_FAILED, message, null)))
            expansion.close(matched)

            return expansion.result
        si

        to_string() -> string =>
            "sequence-count-check:({count},{expected},{at_least})"
    si
si
