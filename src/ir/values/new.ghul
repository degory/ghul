namespace IR.Values is
    use Ghul.Pipes;

    use Semantic.Types.Type;

    class NEW: Value is
        is_state_changing_call: bool => !constructor.constructs_store_free;
        type: Type;
        constructor: Semantic.Symbols.Function;
        arguments: Collections.List[Value];

        init(
            type: Type,
            constructor: Semantic.Symbols.Function,
            arguments: Collections.List[Value]
        ) is
            super.init();

            self.type = type;
            self.constructor = constructor;
            self.arguments = arguments;
        si

        gen(context: IR.CONTEXT) is
            let owner = constructor.owner!;

            if owner.is_unit_variant then
                let body = context.current_srm_body_emitter!;

                // Which instance to load follows from the value's own
                // type rather than from wherever the constructor was
                // found: for a generic variant the type names the
                // instantiation, while the constructor's owner is the
                // open definition, whose parameters an imported
                // variant does not even declare.
                let variant =
                    if let constructed: Semantic.Scope = type.symbol then
                        constructed
                    else
                        owner
                    fi;

                body.ldsfld(context.resolve_unit_variant_instance(variant));

                return;
            fi

            for a in arguments do
                gen(a, context);
            od

            let body = context.current_srm_body_emitter!;
                body.new_object(context.resolve_call_target(constructor));
        si

        to_string() -> string =>
            "new:[{type}](\"{constructor.name}\",{arguments |> join(",")})";
    si
si
