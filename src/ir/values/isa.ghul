namespace IR.Values is
    use Semantic.Types.Type

    class ISA: Value is
        type: Type
        isa_type: Type
        value: Value

        init(
            type: Type,
            isa_type: Type,
            value: Value
        ) is
            super.init()

            self.type = type
            self.isa_type = isa_type
            self.value = value
        si

        gen(context: IR.CONTEXT) is
            gen(value, context)

            let body = context.current_srm_body_emitter!
                if let variable = value.type?.type_variable_side then
                    // A type variable can be instantiated at a value type,
                    // so the operand has to be boxed before the test. `box`
                    // on a `!!N` that turns out to be a reference type is
                    // defined to leave the reference alone.
                    body.box(context.resolve_type_token(variable))
                fi

                body.is_instance(context.resolve_type_token(isa_type))
                body.ldnull()
                body.op(System.Reflection.Metadata.ILOpCode.CGT_UN)
        si

        to_string() -> string =>
            "isa:[{isa_type}]({value})"
    si
si
