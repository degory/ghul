namespace IR.Values is
    use Semantic.Types.Type;

    class ISA: Value is
        type: Type;
        isa_type: Type;
        value: Value;

        init(
            type: Type,
            isa_type: Type,
            value: Value
        ) is
            super.init();

            self.type = type;
            self.isa_type = isa_type;
            self.value = value;
        si

        gen(context: IR.CONTEXT) is
            gen(value, context);

            let body = context.current_srm_body_emitter!;
                body.is_instance(context.resolve_type_token(isa_type));
                body.ldnull();
                body.op(System.Reflection.Metadata.ILOpCode.CGT_UN);
        si

        to_string() -> string =>
            "isa:[{isa_type}]({value})";
    si
si