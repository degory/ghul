namespace IR is
    use Semantic.Symbols.Function

    /// Which functions the program's own sources compiled to, as against a
    /// source library's or nothing the program wrote: what a back end's
    /// text form keeps when it is asked for the program's functions only.
    class PROGRAM_FUNCTIONS is
        init() is si

        /// Whether `function` was compiled from one of the program's own
        /// source files. The entry the top-level statements are gathered
        /// into is the program's, though it has no position.
        ///
        /// - function: the function to classify
        contains(function: Function) -> bool static is
            if function.is_top_level_entry then
                return true
            fi

            let location = source_location(function)

            if location.is_internal \/ location.is_reflected \/ location.is_unknown then
                return false
            fi

            let libraries = IoC.CONTAINER.instance.build_flags.library_sources

            return !(libraries?.library_for(IO.Path.get_full_path(location.file_name))? ?? false)
        si

        /// Where a report about `function` points: a generator frame's
        /// members have no source of their own, so it is the generator.
        ///
        /// - function: the function to locate
        source_location(function: Function) -> Source.LOCATION static =>
            if let frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE = function.owner then
                frame.owning_function.location
            else
                function.location
            fi
    si
si
