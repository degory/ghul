namespace IR.Program is
    /// The bounds that stop a program which instantiates generics at ever
    /// deeper type arguments from being compiled without end.
    class INSTANTIATION_LIMITS is
        /// How deeply type arguments may nest in a class or function
        /// instance before it is reported rather than compiled.
        MAXIMUM_TYPE_ARGUMENT_DEPTH: int static => 8

        /// How many instances of one generic class a program may use
        /// before the class is reported rather than compiled further.
        MAXIMUM_INSTANTIATIONS: int static => 4096
    si
si
