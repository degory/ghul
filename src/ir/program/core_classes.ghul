namespace IR.Program is
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy

    /// The built-in types a whole-program plan treats specially, which the
    /// core library supplies.
    trait CoreClasses open is
        /// The generic definition every array type is an instance of, or
        /// null where there is none.
        array_definition: Classy?

        /// The symbol of the built-in `bigint` type, or null where there is
        /// none.
        bigint: Symbol?
    si

    /// The core classes as the compilation's built-in symbol lookup
    /// answers them.
    class INNATE_CORE_CLASSES: CoreClasses is
        init() is si

        array_definition: Classy? =>
            cast Classy?(
                cast Semantic.Symbols.GENERIC?(
                    IoC.CONTAINER.instance.innate_symbol_lookup.get_array_type(
                        IoC.CONTAINER.instance.innate_symbol_lookup.get_int_type()).symbol)?.unspecialized_symbol)

        bigint: Symbol? => IoC.CONTAINER.instance.innate_symbol_lookup.get_bigint_type().symbol
    si
si
