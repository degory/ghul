namespace IR.Program is
    use Collections.LIST
    use Collections.MAP

    /// Packs sparse rows into one table so that each row's entries keep
    /// their columns relative to the row's offset and no two rows claim
    /// the same slot. Reading `offset(row) + column` then finds exactly the
    /// entry `row` has at `column`.
    ///
    /// Rows are placed largest first, each at the lowest offset where all
    /// of its columns are free.
    class ROW_DISPLACEMENT[T] is
        _rows: LIST[(key: T, columns: LIST[int])]
        _offsets: MAP[T, int]
        _size: int

        init() is
            _rows = LIST[(key: T, columns: LIST[int])]()
            _offsets = MAP[T, int]()
        si

        /// Adds a row that has entries at `columns`, each zero or more.
        add(key: T, columns: Collections.Iterable[int]) is
            _rows.add((key, LIST[int](columns)))
        si

        /// Places every row added; call after the last one.
        pack() is
            _offsets.clear()
            _size = 0

            let order = LIST[(key: T, columns: LIST[int])](_rows)

            order.sort((a, b) => b.columns.count - a.columns.count)

            let used = LIST[bool]()

            // Every slot below this one is taken, so no row can be placed
            // with its lowest column beneath it.
            let first_free mut = 0

            for (key, columns) in order do
                let lowest = _lowest(columns)
                let offset mut = if columns.count > 0 /\ first_free > lowest then first_free - lowest else 0 fi

                // Only an offset that puts the lowest column on a free slot
                // can fit, so the others are passed over without a test.
                while columns.count > 0 do
                    while offset + lowest < used.count /\ used[offset + lowest] do
                        offset = offset + 1
                    od

                    if _fits(columns, offset, used) then
                        break
                    fi

                    offset = offset + 1
                od

                for i in 0..columns.count do
                    let slot = offset + columns[i]

                    while used.count <= slot do
                        used.add(false)
                    od

                    used[slot] = true

                    if slot + 1 > _size then
                        _size = slot + 1
                    fi
                od

                while first_free < used.count /\ used[first_free] do
                    first_free = first_free + 1
                od

                _offsets[key] = offset
            od
        si

        _lowest(columns: LIST[int]) -> int is
            let result mut = 0

            for i in 0..columns.count do
                if i == 0 \/ columns[i] < result then
                    result = columns[i]
                fi
            od

            return result
        si

        _fits(columns: LIST[int], offset: int, used: LIST[bool]) -> bool is
            for i in 0..columns.count do
                let slot = offset + columns[i]

                if slot < used.count /\ used[slot] then
                    return false
                fi
            od

            return true
        si

        /// Where the row for `key` starts.
        offset(key: T) -> int => _offsets[key]

        /// One past the highest slot any row uses.
        size: int => _size
    si
si
