namespace IR.Program is
    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.GENERIC

    /// Applying and comparing the type maps instantiations carry.
    class TYPE_MAPS is
        /// `type` with every type parameter `map` names replaced, or `type`
        /// itself where the map is empty.
        specialize(type: Type?, map: Collections.Map[Symbol, Type]) -> Type? static =>
            if !type? \/ map.count == 0 then type else type.specialize(_with_copies(type, map)) fi

        // A type parameter can be named by its declared symbol or by a
        // frozen copy of it, which a closure's frame holds, and the map is
        // keyed by the declared one. Each parameter in `type` the map does
        // not name directly takes the argument of the parameter it is a
        // copy of.
        _with_copies(type: Type, map: Collections.Map[Symbol, Type]) -> Collections.Map[Symbol, Type] static is
            let unmapped = LIST[Semantic.Symbols.GenericArgument]()

            _collect_unmapped(type, map, unmapped, 0)

            if unmapped.count == 0 then
                return map
            fi

            let result = MAP[Symbol, Type]()

            for (parameter, argument) in map do
                result[parameter] = argument
            od

            for copy in unmapped do
                let key = Semantic.Symbols.TYPE_PARAMETER_KEY.of(copy)

                for (parameter, argument) in map do
                    if let declared: Semantic.Symbols.GenericArgument = parameter /\ Semantic.Symbols.TYPE_PARAMETER_KEY.of(declared) =~ key then
                        result[copy] = argument
                    fi
                od
            od

            return result
        si

        /// The argument `map` gives `parameter`, or the parameter it is a
        /// copy of, or null where it gives neither.
        argument_of(parameter: Symbol, map: Collections.Map[Symbol, Type]) -> Type? static is
            let argument: Type mut

            if map.try_get_value(parameter, argument ref) then
                return argument
            fi

            if let copy: Semantic.Symbols.GenericArgument = parameter then
                let key = Semantic.Symbols.TYPE_PARAMETER_KEY.of(copy)

                for (declared, value) in map do
                    if let declared_argument: Semantic.Symbols.GenericArgument = declared /\ Semantic.Symbols.TYPE_PARAMETER_KEY.of(declared_argument) =~ key then
                        return value
                    fi
                od
            fi

            return null
        si

        _collect_unmapped(type: Type, map: Collections.Map[Symbol, Type], into: LIST[Semantic.Symbols.GenericArgument], depth: int) static is
            if depth > 16 then
                return
            fi

            if let parameter: Semantic.Symbols.GenericArgument = type.symbol then
                if !map.contains_key(parameter) /\ !into.contains(parameter) then
                    into.add(parameter)
                fi
            fi

            for argument in type.arguments do
                _collect_unmapped(argument, map, into, depth + 1)
            od
        si

        /// Whether two type maps bind the same parameters to the same types.
        /// A type is the same as another only where each matches the other:
        /// the null type matches every optional type, so one direction alone
        /// would make two instantiations one.
        same(left: Collections.Map[Symbol, Type], right: Collections.Map[Symbol, Type]) -> bool static pure is
            if left.count != right.count then
                return false
            fi

            for (parameter, argument) in left do
                let other: Type mut

                if !right.try_get_value(parameter, other ref) \/ !argument.matches(other) \/ !other.matches(argument) then
                    return false
                fi
            od

            return true
        si

        /// A hash of `map` that agrees with `same`: maps that are the same
        /// hash alike. Each binding contributes its parameter and its
        /// argument, and the contributions are summed, so the order the map
        /// yields its entries in makes no difference. An argument hashes by
        /// its symbol, and a generic one's symbol hashes by its definition
        /// and arguments, which is what `matches` compares. A sentinel type
        /// matches anything and so cannot be hashed to agree; a type map an
        /// instance is compiled under holds none.
        hash(map: Collections.Map[Symbol, Type]) -> int static pure is
            let result mut = 0

            for (parameter, argument) in map do
                result = result + parameter.get_hash_code() * 31 + argument.get_hash_code()
            od

            return result
        si

        /// How deeply `types` nest generic type arguments: zero for types
        /// that take none, and one more than the deepest argument for one
        /// that does.
        depth(types: Collections.Iterable[Type]) -> int static is
            let result mut = 0

            for type in types do
                if let generic: Semantic.Types.GENERIC = type then
                    let nested = 1 + depth(generic.arguments)

                    if nested > result then
                        result = nested
                    fi
                fi
            od

            return result
        si

        /// `map` with every value specialized by `context`.
        compose(map: Collections.Map[Symbol, Type], context: Collections.Map[Symbol, Type]) -> MAP[Symbol, Type] static is
            let result = MAP[Symbol, Type]()

            for (parameter, argument) in map do
                result[parameter] = specialize(argument, context)!
            od

            return result
        si

        /// The type arguments a reference to `function` binds, read in the
        /// context `context` of the body making it: the class's from the
        /// function's owner, and the function's own from its generic
        /// arguments.
        function_map(function: Function, context: Collections.Map[Symbol, Type]) -> MAP[Symbol, Type] static is
            let definition = cast Function?(function.root_specialized_from)!
            let result = MAP[Symbol, Type]()

            if let owner: GENERIC = function.owner then
                for (parameter, argument) in owner.type_map do
                    result[parameter] = specialize(argument, context)!
                od
            elif let owner: Classy = definition.owner /\ owner.is_generic then
                // A call from inside a generic class to its own members
                // names the definition, and the class's arguments are the
                // ones the calling body was compiled with.
                for (parameter, argument) in context do
                    if parameter.owner == owner then
                        result[parameter] = argument
                    fi
                od
            elif isa Semantic.Symbols.Closure(definition) then
                // A closure body can name every type parameter of the body
                // it was written in.
                for (parameter, argument) in context do
                    result[parameter] = argument
                od
            fi

            let parameters = definition.generic_arguments
            let arguments = function.generic_arguments

            for i in 0..parameters.count do
                if i < arguments.count then
                    result[parameters[i].symbol] = specialize(arguments[i], context)!
                fi
            od

            return result
        si

        /// The type map a body of `function` is lowered under: the instance's
        /// own, and, for a member of a generator's or asynchronous function's
        /// frame, the type parameters of the function the frame was made from,
        /// which its body still names, mapped through the frame's copies of
        /// them.
        ///
        /// - function: the instance whose body is lowered
        body_map(function: FUNCTION_INSTANCE) -> Collections.Map[Symbol, Type] static is
            let frame = cast Semantic.Symbols.STATE_MACHINE_FRAME_BASE?(function.definition.owner)

            if !frame? \/ frame.function_to_class_type_map.count == 0 then
                return function.type_map
            fi

            let result = MAP[Symbol, Type]()

            for (parameter, argument) in function.type_map do
                result[parameter] = argument
            od

            for (parameter, mirrored) in frame.function_to_class_type_map do
                if let argument = specialize(mirrored, function.type_map) then
                    result[parameter] = argument
                fi
            od

            return result
        si
    si
si
