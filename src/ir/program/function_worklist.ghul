namespace IR.Program is
    use Collections.LIST
    use Collections.MAP

    use Semantic.Symbols.Function

    /// The function instances a whole program compiles, each given an
    /// ordinal the first time something asks for it, so only what is
    /// reached is compiled.
    ///
    /// Asking for an instance adds it to the list `next` drains. A function
    /// the target generates for itself takes an ordinal from `reserve` and
    /// is never handed out. Ordinals are never taken back or changed:
    /// asking twice answers the same ordinal, and `restart` walks the
    /// instances again, in order, without adding anything.
    class FUNCTION_WORKLIST is
        _has_body: (Function) -> bool

        _ordinals: MAP[FUNCTION_INSTANCE, int]
        _entries: LIST[FUNCTION_INSTANCE?]

        _cursor: int

        _is_sealed: bool

        /// A worklist for the functions `has_body` says the program
        /// compiles.
        ///
        /// - has_body: whether a function has a body the program compiles
        init(has_body: (Function) -> bool) is
            _has_body = has_body

            _ordinals = MAP[FUNCTION_INSTANCE, int]()
            _entries = LIST[FUNCTION_INSTANCE?]()
        si

        /// How many ordinals have been given out, reserved ones included.
        count: int => _entries.count

        /// The ordinal of `function`, taking no type arguments, adding it
        /// the first time it is asked for, or null where it has no body to
        /// compile.
        add(function: Function) -> int? => add(FUNCTION_INSTANCE.of(function))

        /// The ordinal of `instance`, adding it the first time it is asked
        /// for, or null where its definition has no body to compile, or
        /// where its type arguments nest too deeply to compile.
        add(instance: FUNCTION_INSTANCE) -> int? is
            let ordinal mut = 0

            if _ordinals.try_get_value(instance, ordinal ref) then
                return ordinal
            fi

            if !_has_body(instance.definition) then
                return null
            fi

            // A function that calls itself at deeper and deeper type
            // arguments would be added without end.
            if TYPE_MAPS.depth(instance.type_map.values) > INSTANTIATION_LIMITS.MAXIMUM_TYPE_ARGUMENT_DEPTH then
                return null
            fi

            assert !_is_sealed else "{instance} was first asked for after every body was compiled, so it never would be"

            ordinal = _entries.count

            _ordinals[instance] = ordinal
            _entries.add(instance)

            return ordinal
        si

        /// The ordinal `instance` already has, or null where nothing has
        /// asked for it. Unlike `add`, this adds nothing.
        ordinal_of(instance: FUNCTION_INSTANCE) -> int? is
            let ordinal mut = 0

            if _ordinals.try_get_value(instance, ordinal ref) then
                return ordinal
            fi

            return null
        si

        /// The instance holding `ordinal`, or null where the ordinal was
        /// reserved.
        instance_at(ordinal: int) -> FUNCTION_INSTANCE? => _entries[ordinal]

        /// Takes an ordinal for a function the target generates for
        /// itself, which `next` never hands out.
        reserve() -> int is
            let ordinal = _entries.count

            _entries.add(null)

            return ordinal
        si

        /// The next instance not yet handed out, or null when every one has
        /// been.
        next() -> FUNCTION_INSTANCE? is
            while _cursor < _entries.count do
                let instance = _entries[_cursor]

                _cursor = _cursor + 1

                if instance? then
                    return instance
                fi
            od

            return null
        si

        /// Records that every body has been compiled. An instance with a
        /// body that is first asked for after this would never be compiled,
        /// which `add` then asserts against.
        seal() is
            _is_sealed = true
        si

        /// Hands out the instances again from the first, in ordinal order,
        /// keeping every ordinal.
        restart() is
            _cursor = 0
        si
    si
si
