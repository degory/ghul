namespace IR.Program is
    use System.Text.StringBuilder

    use Semantic.Types.Type

    /// The names a whole-program target gives its types' descriptors, the
    /// full names .NET reports, so `get_type()` gives the same text on every
    /// target.
    class TYPE_NAMES is
        /// The name of `type`.
        ///
        /// - type: a class, array or box in `classes`
        /// - classes: the program's classes
        /// - string_type: the string type, or null where the program has none
        /// - scalar: the scalar kind a value of a type is, or null where it is not one
        /// - is_string: whether a type is `string`
        name_of(
            type: CLASS_INSTANCE,
            classes: CLASS_SET,
            string_type: CLASS_INSTANCE?,
            scalar: (Type?) -> Scalar?,
            is_string: (Type?) -> bool
        ) -> string static is
            if let boxed = classes.boxed_type(type) then
                return name_of(boxed, classes, string_type, scalar, is_string)
            elif type == string_type then
                return "System.String"
            elif type == classes.root then
                return "System.Object"
            elif type.arguments.count == 0 then
                return type.definition.qualified_name
            fi

            let result = StringBuilder()

            result.append(type.definition.qualified_name)
            result.append('[')

            for i in 0..type.arguments.count do
                if i > 0 then
                    result.append(',')
                fi

                result.append(name_of(type.arguments[i], classes, string_type, scalar, is_string))
            od

            result.append(']')

            return result.to_string()
        si

        /// The name of `type`, any type a descriptor names.
        name_of(
            type: Type,
            classes: CLASS_SET,
            string_type: CLASS_INSTANCE?,
            scalar: (Type?) -> Scalar?,
            is_string: (Type?) -> bool
        ) -> string static is
            if let kind = scalar(type) then
                return scalar_name(kind)
            elif is_string(type) then
                return "System.String"
            elif let held = classes.class_of(type) then
                return name_of(held, classes, string_type, scalar, is_string)
            fi

            return "{type}"
        si

        /// The .NET name of the scalar kind.
        scalar_name(scalar: Scalar) -> string static =>
            case scalar
            when Scalar.BOOL then "System.Boolean"
            when Scalar.CHAR then "System.Char"
            when Scalar.INT8 then "System.SByte"
            when Scalar.UINT8 then "System.Byte"
            when Scalar.INT16 then "System.Int16"
            when Scalar.UINT16 then "System.UInt16"
            when Scalar.INT32 then "System.Int32"
            when Scalar.UINT32 then "System.UInt32"
            when Scalar.INT64 then "System.Int64"
            when Scalar.UINT64 then "System.UInt64"
            when Scalar.INT_NATIVE then "System.IntPtr"
            when Scalar.UINT_NATIVE then "System.UIntPtr"
            when Scalar.FLOAT32 then "System.Single"
            when Scalar.FLOAT64 then "System.Double"
            esac
    si
si
