namespace IR.Program is
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    /// Whether a class's method implements a trait method because its name
    /// and signature are the same, as .NET binds an interface method to a
    /// class's, where the compiler recorded it overriding another trait's
    /// method of the same shape instead: one class method satisfies every
    /// trait that declares it.
    class TRAIT_SIGNATURE_MATCH is
        /// Whether `method` implements the trait method `selector` by name
        /// and signature. A parameter of the selector that is a type
        /// parameter matches whatever is given. The return has to fit as an
        /// override's would, unless the selector's is a type parameter: a
        /// same-named method returning something else hides rather than
        /// implements.
        ///
        /// - method: an instance method of a class or struct
        /// - selector: a trait method
        implements(method: Function, selector: Function) -> bool static is
            if !(cast Classy?(selector.owner)?.is_trait ?? false) \/ method.name !~ selector.name \/ !method.is_instance then
                return false
            fi

            if !(selector.return_type?.is_type_variable ?? false) /\ !method.has_overriding_return_type(selector) then
                return false
            fi

            let mine = method.arguments
            let theirs = selector.arguments

            if mine.count != theirs.count then
                return false
            fi

            for i in 0..mine.count do
                if !theirs[i].is_type_variable /\ (!mine[i].matches(theirs[i]) \/ !theirs[i].matches(mine[i])) then
                    return false
                fi
            od

            return true
        si
    si
si
