namespace IR.Program is
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    /// Questions a whole-program target asks about the functions it is
    /// handed bodies for.
    class FUNCTION_BODIES is
        /// The class `definition` is a member of, through the injection
        /// scope of a `partial` or `impl` block where it is declared in one.
        /// Null where the owner is not a class.
        ///
        /// - definition: the member
        owning_class(definition: Function) -> Classy? static =>
            if let injection: Semantic.INJECTION_SCOPE = definition.owner then
                injection.target
            else
                cast Classy?(definition.owner)
            fi

        /// The class whose members `function` is one of, where its body can
        /// name that class's type parameters: the frame of a closure body,
        /// or the class the function is a member of. Null for a function of
        /// a namespace.
        ///
        /// - function: the function whose body is compiled
        class_of_body(function: Function) -> Classy? static =>
            if let closure: Semantic.Symbols.Closure = function /\ closure.frame? then
                closure.frame
            else
                owning_class(function)
            fi

        /// Whether `function`'s body names type parameters, its own or those
        /// of a class or function enclosing it, so that it is compiled only
        /// at an instantiation and never as declared.
        ///
        /// - function: the function whose body is compiled
        is_generic(function: Function) -> bool static is
            if function.generic_arguments.count > 0 then
                return true
            fi

            let scope: Semantic.Scope? mut = owning_class(function) ?? function.owner

            while scope? do
                if let classy: Classy = scope /\ classy.is_generic then
                    return true
                elif let enclosing: Function = scope /\ enclosing.generic_arguments.count > 0 then
                    return true
                fi

                if let symbol: Semantic.Symbols.Symbol = scope /\ symbol.owner != scope then
                    scope = symbol.owner
                else
                    scope = null
                fi
            od

            return false
        si
    si

    /// The methods something in the program calls through a vtable or the
    /// trait table, so that every implementation of each can be reached.
    class DISPATCHED_METHODS is
        _methods: Collections.SET[Function]

        init() is
            _methods = Collections.SET[Function]()
        si

        /// Records that a call dispatches on `method`. A trait method that
        /// overrides another trait's dispatches through the one it
        /// overrides, so a class implementing only that one is reached too.
        note(method: Function) is
            let root = cast Function?(method.root_specialized_from)!

            if !_methods.add(root) \/ !(cast Semantic.Symbols.Classy?(root.owner)?.is_trait ?? false) then
                return
            fi

            if let overridees = root.overridees then
                for overridee in overridees do
                    if let function: Function = overridee /\ (cast Semantic.Symbols.Classy?(function.owner)?.is_trait ?? false) then
                        note(function)
                    fi
                od
            fi
        si

        /// Whether `method` is, or overrides, a method a call dispatches on.
        is_dispatched_to(method: Function) -> bool => _overrides_dispatched(method)

        _overrides_dispatched(method: Function) -> bool is
            if _methods.contains(method) then
                return true
            fi

            if let overridees = method.overridees then
                for overridee in overridees do
                    if let function: Function = overridee /\ _overrides_dispatched(function) then
                        return true
                    fi
                od
            fi

            return false
        si
    si
si
