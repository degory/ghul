namespace IR is
    trait BlockContext is
        is_in_block: bool;
        current_block: Values.BLOCK;

        enter_block() -> IR.Values.BLOCK;
        enter_block(type: Semantic.Types.Type) -> IR.Values.BLOCK;
        enter_block(block: Values.BLOCK) -> IR.Values.BLOCK;

        leave_block();

        add(value: Values.Value);
    si
