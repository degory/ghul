namespace IR.WasmGC is
    // The wasm loader's text, for a compiler built for a target other than
    // .NET, which has no assembly resource to carry it. A build of the
    // compiler that wants one compiles a copy of this file generated from
    // loader.mjs in place of this one, which has none.
    @IF.not.dotnet()
    class WASMGC_LOADER_TEXT is
        text: string? static => null
    si
si
