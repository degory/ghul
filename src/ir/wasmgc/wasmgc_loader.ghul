namespace IR.WasmGC is
    use IO.File
    use IO.Path
    use IO.StreamReader

    /// The JavaScript loader that runs a module: instantiates it with the
    /// host imports, starts it, and reports its exit status. It is the same
    /// file for every program, and finds its module beside it.
    class WASMGC_LOADER is
        /// Writes the loader for the module at `module_path` beside it, with
        /// the module's name and the extension `.mjs`. The module has the
        /// extension `.wasm`, which is how the loader finds it.
        ///
        /// - module_path: where the module was written
        write(module_path: string) static is
            let loader_path = Path.change_extension(module_path, ".mjs") ?? "{module_path}.mjs"

            File.write_all_text(loader_path, text())
        si

        /// The loader's text.
        text() -> string static => _template()

        @IF.dotnet()
        _template() -> string static is
            let assembly = System.Reflection.Assembly.get_executing_assembly()
            let stream = assembly.get_manifest_resource_stream("wasmgc-loader.mjs")

            assert stream? else "the wasm loader is not embedded in the compiler"

            let use reader = StreamReader(stream)

            return reader.read_to_end()
        si

        @IF.not.dotnet()
        _template() -> string static is
            if let text = WASMGC_LOADER_TEXT.text then
                return text
            fi

            throw Ghul.NotSupportedException("the wasm loader is not available in this build of the compiler")
        si
    si
si
