namespace IR.WasmGC is
    use IR.Program

    use Wasm.FUNCTION
    use Wasm.INSTRUCTION
    use Wasm.INDEX_INSTRUCTION
    use Wasm.HEAP_TYPE_INSTRUCTION
    use Wasm.TYPE_INSTRUCTION
    use Wasm.TYPE_FIELD_INSTRUCTION
    use Wasm.HEAP_TYPE
    use Wasm.VALUE_TYPE
    use Wasm.Opcode

    use Collections.LIST

    /// The cloners: for each class, a function that makes a shallow copy of
    /// an instance, reached through the class's descriptor by
    /// `memberwise_clone`. WasmGC has no instruction that copies a struct of
    /// a type it does not know, so each class copies its own fields.
    ///
    /// A field of struct type is held in a box, which is copied too, so the
    /// copy's struct is its own as it is on .NET. Cloners are made only
    /// where the program reaches `memberwise_clone`.
    class WASMGC_CLONE is
        _registry: WASMGC_TYPE_REGISTRY

        init(registry: WASMGC_TYPE_REGISTRY) is
            _registry = registry
        si

        /// Reserves the cloner of each class, where the program copies an
        /// object, and records it in the class's descriptor.
        ///
        /// - numbering: the defined functions the cloners are numbered among
        reserve(numbering: WASMGC_FUNCTION_NUMBERING) is
            let registry = _registry

            if !registry.clones_wanted then
                return
            fi

            let signature = registry.clone_signature

            for type in registry.classes_and_arrays do
                if !registry.is_array(type) /\ registry.type_index(type)? /\ registry.is_instantiated(type) then
                    let index = registry.type_index(type)!

                    registry.set_cloner(
                        type,
                        numbering.reserve(() -> FUNCTION => FUNCTION(signature, [VALUE_TYPE.of_type_index(index, true)], _body(type, index))))
                fi
            od
        si

        // Copies the object in parameter 0, which is an instance of `type`,
        // field by field into a new one, the descriptor included.
        _body(type: CLASS_INSTANCE, index: int) -> LIST[INSTRUCTION] is
            let registry = _registry
            let layout = registry.field_value_types(type)
            let layout_types = registry.field_types(type)
            let body = LIST[INSTRUCTION]()

            body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
            body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(index)))
            body.add(INDEX_INSTRUCTION(Opcode.LOCAL_SET, 1))

            for i in 0..layout.count do
                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 1))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, index, i))

                if i > 0 then
                    if let held = if i < layout_types.count then registry.struct_of(layout_types[i]) else null fi,
                        cloner = registry.cloner_of(held),
                        held_index = registry.type_index(held)
                    then
                        body.add(INDEX_INSTRUCTION(Opcode.CALL, cloner))
                        body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(held_index)))
                    fi
                fi
            od

            body.add(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, index))

            return body
        si
    si
si
