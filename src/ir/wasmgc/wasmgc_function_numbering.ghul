namespace IR.WasmGC is
    use IR.Program

    use Wasm.MODULE
    use Wasm.FUNCTION

    use Collections.MAP

    use Semantic.Symbols.Function

    /// The function indices of a module: the program's function worklist,
    /// numbered from after the imports, with the bodies compiled for each
    /// and the functions the target generates for itself.
    class WASMGC_FUNCTION_NUMBERING is
        _first_index: int
        _worklist: FUNCTION_WORKLIST

        _reserved: MAP[int, () -> FUNCTION]
        _placed: MAP[int, FUNCTION]

        _linker: LINKER_NAMES
        _labels: MAP[int, string]

        /// Numbers functions from `first_index` on.
        ///
        /// - first_index: the index the first function takes, after the
        ///   imports
        /// - has_body: whether a function has a body the module compiles
        init(first_index: int, has_body: (Function) -> bool) is
            _first_index = first_index
            _worklist = FUNCTION_WORKLIST(has_body)

            _reserved = MAP[int, () -> FUNCTION]()
            _placed = MAP[int, FUNCTION]()

            _linker = LINKER_NAMES()
            _labels = MAP[int, string]()
        si

        /// The instances numbered, as the program's worklist.
        worklist: FUNCTION_WORKLIST => _worklist

        /// How many indices have been given out.
        count: int => _worklist.count

        /// The index of `function`, numbering it the first time it is asked
        /// for, or null where it has no body to compile.
        index_of(function: Function) -> int? => index_of(FUNCTION_INSTANCE.of(function))

        /// The index of `instance`, numbering it the first time it is asked
        /// for, or null where its definition has no body to compile.
        index_of(instance: FUNCTION_INSTANCE) -> int? => _index(_worklist.add(instance))

        /// The index `instance` already has, or null where nothing has
        /// asked for it. Unlike `index_of`, this numbers nothing.
        indexed(instance: FUNCTION_INSTANCE) -> int? => _index(_worklist.ordinal_of(instance))

        /// The index `function`, taking no type arguments, already has.
        indexed(function: Function) -> int? => indexed(FUNCTION_INSTANCE.of(function))

        _index(ordinal: int?) -> int? => if ordinal? then _first_index + ordinal else null fi

        /// Numbers a function the target generates, which `build` makes when
        /// the module is assembled.
        reserve(build: () -> FUNCTION) -> int is
            let index = _first_index + _worklist.reserve()

            _reserved[index] = build

            return index
        si

        /// Numbers a function the target generates and names it `label`,
        /// which should say what generated it and what for: a generated
        /// function is reached only by index, so without a name a later
        /// reader of the module cannot tell which is which.
        reserve_labelled(build: () -> FUNCTION, label: string) -> int is
            let index = reserve(build)

            _labels[index] = _linker.unique(label)

            return index
        si

        /// The name of the function `instance`, as the module's name section
        /// writes it.
        name_of(instance: FUNCTION_INSTANCE) -> string => _linker.name_of(instance)

        /// The label of the class instance `type`, for naming what the
        /// target generates for it.
        type_label(type: CLASS_INSTANCE) -> string => _linker.type_label(type)

        /// The names given to the functions the target generates, by index.
        labels: MAP[int, string] => _labels

        /// The next numbered function not yet handed out, or null when every
        /// one has been.
        next() -> FUNCTION_INSTANCE? => _worklist.next()

        /// Records that every body has been compiled.
        seal() => _worklist.seal()

        /// Hands out the numbered functions again from the first, in index
        /// order, keeping every number.
        restart() => _worklist.restart()

        /// Records the compiled body of `instance`.
        place(instance: FUNCTION_INSTANCE, function: FUNCTION) is
            let index = indexed(instance)

            assert index? else "{instance} was compiled without having been numbered"

            _placed[index] = function
        si

        /// Adds every numbered function to `module` in index order,
        /// building the generated ones. Every function with a body must
        /// have been placed.
        add_to(module: MODULE) is
            let i mut = 0

            while i < _worklist.count do
                let index = _first_index + i

                let build: () -> FUNCTION mut

                let function =
                    if _reserved.try_get_value(index, build ref) then
                        build()
                    else
                        let placed: FUNCTION mut

                        assert _placed.try_get_value(index, placed ref) else "function {index}, {_worklist.instance_at(i)}, was numbered but never compiled"

                        placed
                    fi

                let added = module.add_function(function)

                assert added == index else "function {index} added at {added}"

                i = i + 1
            od
        si
    si
si
