namespace IR.LLVMTarget is
    use LLVM.BLOCK
    use LLVM.BinaryOperator
    use LLVM.Conversion
    use LLVM.FastMath
    use LLVM.FloatPredicate
    use LLVM.IntegerFlags
    use LLVM.Types

    /// The hash code of a scalar held as the LLVM target holds it, the one
    /// the wasm target gives the same value: a 32-bit kind is its own hash,
    /// a 64-bit one folds its halves together, and a floating value hashes
    /// its bits once zero of either sign and every NaN are made alike, so
    /// values `=~` reports equal hash alike.
    class LLVM_SCALAR_HASH is
        /// The instructions in `block` computing the hash of `value`, an
        /// `i32`, an `i64`, a `float` or a `double`.
        ///
        /// - block: where the instructions go
        /// - value: the scalar, as the target holds it
        hash(block: BLOCK, value: LLVM.Value) -> LLVM.Value static is
            let type = value.type

            if type =~ LLVM.Type.FLOAT then
                return block.convert(Conversion.BIT_CAST, _canonical(block, value), Types.i32)
            elif type =~ LLVM.Type.DOUBLE then
                return _fold(block, block.convert(Conversion.BIT_CAST, _canonical(block, value), Types.i64))
            elif LLVM_TYPES.width(type) == 64 then
                return _fold(block, value)
            fi

            return value
        si

        // Zero where `value` is a NaN, and otherwise `value` plus zero, which
        // turns -0 into +0.
        _canonical(block: BLOCK, value: LLVM.Value) -> LLVM.Value static is
            let zero = LLVM_TYPES.zero(value.type)
            let is_number = block.compare(FloatPredicate.ORD, value, value)

            return block.select(is_number, block.floating(BinaryOperator.FADD, FastMath.NONE, value, zero), zero)
        si

        // The low half of `value` exclusive-ored with its high half.
        _fold(block: BLOCK, value: LLVM.Value) -> LLVM.Value static is
            let high = block.binary(BinaryOperator.LSHR, IntegerFlags.NONE, value, LLVM.Values.i64(32L))

            return block.convert(Conversion.TRUNCATE, block.binary(BinaryOperator.XOR, IntegerFlags.NONE, value, high), Types.i32)
        si
    si
si
