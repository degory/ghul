namespace IR.LLVMTarget is
    use IR.Program

    use IO.File

    use Collections.LIST
    use Collections.MAP
    use Collections.STACK

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use LLVM.MODULE
    use LLVM.FUNCTION
    use LLVM.PARAMETER
    use LLVM.WRITER

    use Values.Value

    /// Writes the program as an LLVM module, and links an executable from it
    /// with `ghul-llvm` against the runtime.
    ///
    /// A body's lowering needs what only the whole program settles, so each
    /// body is kept as it is finished and lowered once the last has been
    /// handed over, in `end_assembly`.
    class LLVM_BACKEND: Backend is
        _bodies: MAP[Function, LIST[Value]]
        _order: LIST[Function]
        _enclosing: STACK[LIST[Value]?]
        _current: LIST[Value]?

        _entry_point: Function?
        _module: MODULE?
        _want_library: bool

        init() is
            _bodies = MAP[Function, LIST[Value]]()
            _order = LIST[Function]()
            _enclosing = STACK[LIST[Value]?]()
        si

        /// Starts a module, discarding anything kept from an earlier one.
        install(module_name: string, module_version: string, want_library: bool) is
            reset()

            _want_library = want_library
        si

        reset() is
            _bodies.clear()
            _order.clear()
            _enclosing.clear()
            _current = null
            _entry_point = null
            _module = null
        si

        begin_assembly() is si

        /// Lowers every kept body the program reaches into the module `write`
        /// writes.
        end_assembly() is
            _module = _build_module()
        si

        add_resource(name: string, content: ubyte[]) is si

        /// Writes the module's text to `<path>.ll` and, for an executable,
        /// links it into `path` with `ghul-llvm`. The text is kept where
        /// `--llvm-output` names a file for it.
        write(path: string) is
            let module = _module

            if !module? then
                return
            fi

            let text = WRITER.module_text(module)

            if let output = IoC.CONTAINER.instance.build_flags.llvm_output then
                File.write_all_text(output, text)
            fi

            if _want_library then
                File.write_all_text(path, text)
                return
            fi

            let ll_path = "{path}.ll"

            // The text kept for `--llvm-output` may be the very file the
            // linker reads, which is then left in place.
            let kept = IoC.CONTAINER.instance.build_flags.llvm_output
            let is_kept = kept? /\ IO.Path.get_full_path(kept) =~ IO.Path.get_full_path(ll_path)

            File.write_all_text(ll_path, text)

            try
                LLVM_LINKER.link(ll_path, path)
            finally
                if !is_kept then
                    File.delete(ll_path)
                fi
            yrt
        si

        begin_body() is
            _enclosing.push(_current)
            _current = LIST[Value]()
        si

        begin_body(member: Symbol) is
            begin_body()
        si

        write(value: Value) is
            _current!.add(value)
        si

        /// Keeps the body for lowering. A function that provides an intrinsic
        /// has its body dropped, since a call to it lowers to the operation
        /// itself, except an array's members, for a call that reaches one
        /// through a trait.
        finish_body(function: Function) is
            if function.intrinsic_operation? /\ !((function.intrinsic_operation?.starts_with("array.") ?? false) /\ function.is_instance) then
                return
            fi

            if !_bodies.contains_key(function) then
                _order.add(function)
            fi

            _bodies[function] = _current!
        si

        /// Drops the body: this target compiles no generator or asynchronous
        /// function yet, and one the program reaches is reported where a body
        /// that uses it is lowered.
        finish_frame_member_body(frame: Classy, member: FrameMember) is si

        /// Drops the initializer: a unit variant's one instance is a global
        /// whose fields are all zero, built where the module is finished.
        finish_unit_variant_initializer(variant: Classy) is si

        end_body() is
            assert _enclosing.count > 0 else "body ended without one begun"

            _current = _enclosing.pop()
        si

        abandon_bodies() is
            _enclosing.clear()
            _current = null
        si

        /// Always false: a unit variant's instance is built by the backend, not
        /// by an initializer the program runs.
        has_unit_variant_instance(variant: Classy) -> bool => false

        mark_entry_point(function: Function) is
            _entry_point = function
        si

        _report(location: Source.LOCATION, construct: string) is
            IoC.CONTAINER.instance.logger.error(
                location,
                "code generation for {construct} is not supported on the llvm target")
        si

        // Finds every instance the program reaches through the program plan,
        // declaring an LLVM function for each the first time it is named,
        // then lowers each body into its function.
        _build_module() -> MODULE is
            let module = MODULE()
            let names = LLVM_FUNCTION_NAMES()

            let worklist = FUNCTION_WORKLIST(f => _bodies.contains_key(f))
            let declared = MAP[FUNCTION_INSTANCE, FUNCTION?]()

            let declare = (instance: FUNCTION_INSTANCE) -> FUNCTION? is
                let found: FUNCTION? mut

                if declared.try_get_value(instance, found ref) then
                    return found
                fi

                let function =
                    if worklist.add(instance)? then
                        _declare(instance, names.name_of(instance))
                    else
                        null
                    fi

                declared[instance] = function

                return function
            si

            // An executable compiles what its entry point reaches; a library
            // compiles everything that is not generic, since anything can be
            // called from outside.
            if let entry = _entry_point then
                declare(FUNCTION_INSTANCE.of(entry))

                // The description of an exception nothing caught reads its
                // message.
                if let getter = LLVM_EXCEPTIONS.message_getter /\ _bodies.contains_key(getter) then
                    declare(FUNCTION_INSTANCE.of(getter))
                fi
            else
                for function in _order do
                    if !FUNCTION_BODIES.is_generic(function) then
                        declare(FUNCTION_INSTANCE.of(function))
                    fi
                od
            fi

            let container = IoC.CONTAINER.instance
            let object = cast Classy?(container.innate_symbol_lookup.get_object_type().symbol)
            let classes = CLASS_SET(object, element => LLVM_ARRAYS.holds_element(element), INNATE_CORE_CLASSES())
            let objects = LLVM_OBJECTS(module, classes)

            objects.collect(container.symbol_table.global_scope)

            let plan =
                PROGRAM_PLAN(
                    classes,
                    worklist,
                    objects.dispatched,
                    null,
                    _order)

            objects.reach = instance => declare(instance)

            let discovery_module = MODULE()
            let discovery_strings = LLVM_STRINGS(discovery_module)
            let discovery_arrays = LLVM_ARRAYS(discovery_module, discovery_strings, classes, objects)

            plan.discover(
                LLVM_DISCOVERY(
                    objects,
                    instance => _reach(discovery_module, discovery_strings, discovery_arrays, objects, instance, declare),
                    (location, construct) => _report(location, construct)))

            worklist.seal()

            objects.build()

            let strings = LLVM_STRINGS(module)
            let arrays = LLVM_ARRAYS(module, strings, classes, objects)
            let closures = LLVM_CLOSURES(module, objects)

            objects.closures = closures

            let callee = (instance: FUNCTION_INSTANCE) -> FUNCTION? is
                let found: FUNCTION? mut

                declared.try_get_value(instance, found ref)

                return found
            si

            worklist.restart()

            while let instance = worklist.next() do
                if let function = callee(instance) then
                    if !_want_library then
                        function.linkage = LLVM.Linkage.INTERNAL
                    fi

                    module.add_function(function)

                    _lower(module, strings, arrays, objects, instance, function, callee)
                fi
            od

            objects.finish(strings, callee)
            closures.finish(strings, callee)

            for (location, construct) in objects.unsupported do
                _report(location, construct)
            od

            if let entry = _entry_point then
                _add_entry(module, strings, arrays, entry, callee(FUNCTION_INSTANCE.of(entry)))

                strings.add_exports()
                arrays.add_exports()

                let getter = LLVM_EXCEPTIONS.message_getter

                LLVM_EXCEPTIONS.add_report_unhandled(module, strings, if let g = getter then callee(FUNCTION_INSTANCE.of(g)) else null fi)
            fi

            return module
        si

        // Lowers `instance`'s body into a copy of its function in `module`,
        // which is thrown away, so every instance it calls is declared.
        _reach(
            module: MODULE,
            strings: LLVM_STRINGS,
            arrays: LLVM_ARRAYS,
            objects: LLVM_OBJECTS,
            instance: FUNCTION_INSTANCE,
            declare: (FUNCTION_INSTANCE) -> FUNCTION?
        ) is
            // The plan adds implementations a dispatched call can reach without
            // naming them, so an instance can arrive here undeclared.
            if let found = declare(instance) then
                let copy = FUNCTION(found.name, found.result, found.parameters |> Ghul.Pipes.collect())

                LLVM_LOWERING(module, copy, instance, instance.specialize(instance.definition.return_type), declare, strings, arrays, objects)
                    .lower(_bodies[instance.definition])
            fi
        si

        /// The name of the function the runtime starts the program at, which
        /// takes nothing and returns the exit status.
        ENTRY_NAME: string static => "$ghul_entry"

        /// The global the runtime defines for the ABI version the program is
        /// compiled for, which a runtime of any other version lacks.
        ABI_CHECK_NAME: string static => "$ghul_abi_3"

        // Exports `$ghul_entry`, which calls the entry point and returns the
        // exit status it answers, or zero for an entry point that answers
        // nothing. An entry point taking a `string[]` is handed the
        // command-line arguments, read through the runtime's host operations.
        // It reads the runtime's ABI marker, so a program linked against a
        // runtime of another ABI version fails to link rather than failing
        // when it runs.
        _add_entry(module: MODULE, strings: LLVM_STRINGS, arrays: LLVM_ARRAYS, entry: Function, compiled: FUNCTION?) is
            let string_array: CLASS_INSTANCE? mut

            if entry.arguments.count == 1 then
                string_array = arrays.array_of(entry.arguments[0])

                if !string_array? \/ !LLVM_TYPES.is_string(arrays.element_of(string_array)) then
                    _report(entry.location, "an entry point taking {entry.arguments[0]}")
                    return
                fi
            elif entry.arguments.count > 1 then
                _report(entry.location, "an entry point that takes more than one argument")
                return
            fi

            if !compiled? then
                return
            fi

            let wrapper = FUNCTION(ENTRY_NAME, LLVM.Types.i32, [])
            let block mut = wrapper.add_block("entry")

            let marker = LLVM.GLOBAL_VARIABLE(ABI_CHECK_NAME, LLVM.Types.i32, null, true)

            module.add_global(marker)

            let read = wrapper.fresh_name()

            block.append(LLVM.Operation.LOAD(read, LLVM.Types.i32, marker.reference, 4, true), LLVM.Values.local(LLVM.Types.i32, read))

            let arguments = LIST[LLVM.Value]()

            if let type = string_array then
                arguments.add(_command_line(wrapper, block, strings, arrays, type))

                block = wrapper.blocks[wrapper.blocks.count - 1]
            fi

            if let result = block.call(compiled, arguments.to_array()) then
                block.return_value(result)
            else
                block.return_value(LLVM.Values.integer(LLVM.Types.i32, bigint.zero))
            fi

            module.add_function(wrapper)
        si

        // Builds a `string[]` of the command-line arguments, starting in
        // `block` and leaving the wrapper's last block to carry on in.
        _command_line(wrapper: FUNCTION, block: LLVM.BLOCK, strings: LLVM_STRINGS, arrays: LLVM_ARRAYS, type: CLASS_INSTANCE) -> LLVM.Value is
            let i32 = LLVM.Types.i32

            let count = block.call(strings.runtime(LLVM_STRINGS.host_name("argument_count"), i32, []), [])!
            let result = arrays.allocate(block, type, count)
            let index = block.alloca(i32, 4)

            block.store(LLVM.Values.i32(0), index, 4)

            let test = wrapper.add_block("test")
            let body = wrapper.add_block("body")
            let done = wrapper.add_block("done")

            block.branch(test)

            let at = test.load(i32, index, 4)

            test.branch(test.compare(LLVM.IntegerPredicate.SLT, at, count), body, done)

            let current = body.load(i32, index, 4)
            let argument = body.call(strings.runtime(LLVM_STRINGS.host_name("argument"), LLVM.Types.pointer, [i32]), [current])!

            arrays.store(body, type, result, current, argument)

            body.store(body.binary(LLVM.BinaryOperator.ADD, LLVM.IntegerFlags.NONE, current, LLVM.Values.i32(1)), index, 4)
            body.branch(test)

            return result
        si

        // The LLVM function an instance is compiled into, with no body yet,
        // or null, reported, where its signature has a type the target holds
        // no values of.
        _declare(instance: FUNCTION_INSTANCE, name: string) -> FUNCTION? is
            let definition = instance.definition

            let parameters = LIST[PARAMETER]()

            if definition.is_emitted_with_receiver then
                if isa Semantic.Symbols.STRUCT(definition.owner) then
                    _report(definition.location, "a method of a struct")
                    return null
                fi

                parameters.add(PARAMETER(LLVM.Types.pointer, "self"))
            fi

            for (i, argument) in definition.arguments |> Ghul.Pipes.index() do
                if let type = LLVM_TYPES.value_type(instance.specialize(argument)) then
                    parameters.add(PARAMETER(type, "a{i}"))
                else
                    _report(definition.location, "an argument of type {argument}")
                    return null
                fi
            od

            let result = LLVM_TYPES.result_type(instance.specialize(definition.return_type))

            if !result? then
                _report(definition.location, "a result of type {definition.return_type}")
                return null
            fi

            return FUNCTION(name, result, parameters.to_array())
        si

        _lower(module: MODULE, strings: LLVM_STRINGS, arrays: LLVM_ARRAYS, objects: LLVM_OBJECTS, instance: FUNCTION_INSTANCE, function: FUNCTION, callee: (FUNCTION_INSTANCE) -> FUNCTION?) is
            let definition = instance.definition

            let lowering = LLVM_LOWERING(module, function, instance, instance.specialize(definition.return_type), callee, strings, arrays, objects)

            lowering.lower(_bodies[definition])

            for construct in lowering.unsupported do
                _report(definition.location, construct)
            od
        si

    si

    // Finds a program's reach by lowering each body it reaches into a
    // module that is thrown away.
    class LLVM_DISCOVERY(
        objects: LLVM_OBJECTS private,
        reach: (FUNCTION_INSTANCE) -> void private,
        report: (Source.LOCATION, string) -> void private
    ): DiscoveryTarget is
        reach(instance: FUNCTION_INSTANCE) => _reach(instance)

        is_instantiated(type: CLASS_INSTANCE) -> bool => _objects.is_instantiated(type)

        note_instantiated(type: CLASS_INSTANCE) => _objects.note_instantiated(type)

        report(location: Source.LOCATION, construct: string) => _report(location, construct)
    si
si
