namespace IR.LLVMTarget is
    use IR.Program

    use IO.File

    use Collections.LIST
    use Collections.MAP
    use Collections.STACK

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use LLVM.MODULE
    use LLVM.FUNCTION
    use LLVM.PARAMETER
    use LLVM.WRITER

    use Values.Value

    /// Writes the program as an LLVM module, and links an executable from it
    /// with `ghul-llvm` against the runtime.
    ///
    /// A body's lowering needs what only the whole program settles, so each
    /// body is kept as it is finished and lowered once the last has been
    /// handed over, in `end_assembly`.
    class LLVM_BACKEND: Backend is
        _bodies: MAP[Function, LIST[Value]]
        _order: LIST[Function]
        _enclosing: STACK[LIST[Value]?]
        _current: LIST[Value]?

        _entry_point: Function?
        _module: MODULE?
        _want_library: bool

        init() is
            _bodies = MAP[Function, LIST[Value]]()
            _order = LIST[Function]()
            _enclosing = STACK[LIST[Value]?]()
        si

        /// Starts a module, discarding anything kept from an earlier one.
        install(module_name: string, module_version: string, want_library: bool) is
            reset()

            _want_library = want_library
        si

        reset() is
            _bodies.clear()
            _order.clear()
            _enclosing.clear()
            _current = null
            _entry_point = null
            _module = null
        si

        begin_assembly() is si

        /// Lowers every kept body the program reaches into the module `write`
        /// writes.
        end_assembly() is
            _module = _build_module()
        si

        add_resource(name: string, content: ubyte[]) is si

        /// Writes the module's text to `<path>.ll` and, for an executable,
        /// links it into `path` with `ghul-llvm`. The text is kept where
        /// `--llvm-output` names a file for it.
        write(path: string) is
            let module = _module

            if !module? then
                return
            fi

            let text = WRITER.module_text(module)

            if let output = IoC.CONTAINER.instance.build_flags.llvm_output then
                File.write_all_text(output, text)
            fi

            if _want_library then
                File.write_all_text(path, text)
                return
            fi

            let ll_path = "{path}.ll"

            File.write_all_text(ll_path, text)

            try
                LLVM_LINKER.link(ll_path, path)
            finally
                File.delete(ll_path)
            yrt
        si

        begin_body() is
            _enclosing.push(_current)
            _current = LIST[Value]()
        si

        begin_body(member: Symbol) is
            begin_body()
        si

        write(value: Value) is
            _current!.add(value)
        si

        /// Keeps the body for lowering. A function that provides an intrinsic
        /// has its body dropped, since a call to it lowers to the operation
        /// itself.
        finish_body(function: Function) is
            if function.intrinsic_operation? then
                return
            fi

            if !_bodies.contains_key(function) then
                _order.add(function)
            fi

            _bodies[function] = _current!
        si

        finish_frame_member_body(frame: Classy, member: FrameMember) is
            let location =
                if let state_machine: Semantic.Symbols.STATE_MACHINE_FRAME_BASE = frame then
                    state_machine.owning_function.location
                else
                    frame.location
                fi

            _report(location, "a generator or asynchronous function")
        si

        finish_unit_variant_initializer(variant: Classy) is
            _report(variant.location, "a union")
        si

        end_body() is
            assert _enclosing.count > 0 else "body ended without one begun"

            _current = _enclosing.pop()
        si

        abandon_bodies() is
            _enclosing.clear()
            _current = null
        si

        /// Always false: this target generates no unions yet.
        has_unit_variant_instance(variant: Classy) -> bool => false

        mark_entry_point(function: Function) is
            _entry_point = function
        si

        _report(location: Source.LOCATION, construct: string) is
            IoC.CONTAINER.instance.logger.error(
                location,
                "code generation for {construct} is not supported on the llvm target")
        si

        // Finds every instance the program reaches through the program plan,
        // declaring an LLVM function for each the first time it is named,
        // then lowers each body into its function.
        _build_module() -> MODULE is
            let module = MODULE()
            let names = LLVM_FUNCTION_NAMES()

            let worklist = FUNCTION_WORKLIST(f => _bodies.contains_key(f))
            let declared = MAP[FUNCTION_INSTANCE, FUNCTION?]()

            let declare = (instance: FUNCTION_INSTANCE) -> FUNCTION? is
                let found: FUNCTION? mut

                if declared.try_get_value(instance, found ref) then
                    return found
                fi

                let function =
                    if worklist.add(instance)? then
                        _declare(instance, names.name_of(instance))
                    else
                        null
                    fi

                declared[instance] = function

                return function
            si

            // An executable compiles what its entry point reaches; a library
            // compiles everything that is not generic, since anything can be
            // called from outside.
            if let entry = _entry_point then
                declare(FUNCTION_INSTANCE.of(entry))
            else
                for function in _order do
                    if !FUNCTION_BODIES.is_generic(function) then
                        declare(FUNCTION_INSTANCE.of(function))
                    fi
                od
            fi

            let plan =
                PROGRAM_PLAN(
                    CLASS_SET(null, _ => false, INNATE_CORE_CLASSES()),
                    worklist,
                    DISPATCHED_METHODS(),
                    null,
                    _order)

            let discovery_module = MODULE()
            let discovery_strings = LLVM_STRINGS(discovery_module)

            plan.discover(
                LLVM_DISCOVERY(
                    instance => _reach(discovery_module, discovery_strings, instance, declared, declare),
                    (location, construct) => _report(location, construct)))

            worklist.seal()

            let strings = LLVM_STRINGS(module)

            let callee = (instance: FUNCTION_INSTANCE) -> FUNCTION? is
                let found: FUNCTION? mut

                declared.try_get_value(instance, found ref)

                return found
            si

            worklist.restart()

            while let instance = worklist.next() do
                if let function = callee(instance) then
                    if !_want_library then
                        function.linkage = LLVM.Linkage.INTERNAL
                    fi

                    module.add_function(function)

                    _lower(module, strings, instance, function, callee)
                fi
            od

            if let entry = _entry_point then
                _add_entry(module, entry, callee(FUNCTION_INSTANCE.of(entry)))

                strings.add_exports()
            fi

            return module
        si

        // Lowers `instance`'s body into a copy of its function in `module`,
        // which is thrown away, so every instance it calls is declared.
        _reach(
            module: MODULE,
            strings: LLVM_STRINGS,
            instance: FUNCTION_INSTANCE,
            declared: MAP[FUNCTION_INSTANCE, FUNCTION?],
            declare: (FUNCTION_INSTANCE) -> FUNCTION?
        ) is
            let found: FUNCTION? mut

            if declared.try_get_value(instance, found ref) /\ found? then
                let copy = FUNCTION(found.name, found.result, found.parameters |> Ghul.Pipes.collect())

                LLVM_LOWERING(module, copy, instance, instance.specialize(instance.definition.return_type), declare, strings)
                    .lower(_bodies[instance.definition])
            fi
        si

        /// The name of the function the runtime starts the program at, which
        /// takes nothing and returns the exit status.
        ENTRY_NAME: string static => "$ghul_entry"

        /// The global the runtime defines for the ABI version the program is
        /// compiled for, which a runtime of any other version lacks.
        ABI_CHECK_NAME: string static => "$ghul_abi_3"

        // Exports `$ghul_entry`, which calls the entry point and returns the
        // exit status it answers, or zero for an entry point that answers
        // nothing. It reads the runtime's ABI marker, so a program linked
        // against a runtime of another ABI version fails to link rather than
        // failing when it runs.
        _add_entry(module: MODULE, entry: Function, compiled: FUNCTION?) is
            if entry.arguments.count > 0 then
                _report(entry.location, "an entry point that takes arguments")
                return
            fi

            if !compiled? then
                return
            fi

            let wrapper = FUNCTION(ENTRY_NAME, LLVM.Types.i32, [])
            let block = wrapper.add_block("entry")

            let marker = LLVM.GLOBAL_VARIABLE(ABI_CHECK_NAME, LLVM.Types.i32, null, true)

            module.add_global(marker)

            let read = wrapper.fresh_name()

            block.append(LLVM.Operation.LOAD(read, LLVM.Types.i32, marker.reference, 4, true), LLVM.Values.local(LLVM.Types.i32, read))

            if let result = block.call(compiled, []) then
                block.return_value(result)
            else
                block.return_value(LLVM.Values.integer(LLVM.Types.i32, bigint.zero))
            fi

            module.add_function(wrapper)
        si

        // The LLVM function an instance is compiled into, with no body yet,
        // or null, reported, where its signature has a type the target holds
        // no values of.
        _declare(instance: FUNCTION_INSTANCE, name: string) -> FUNCTION? is
            let definition = instance.definition

            if definition.is_emitted_with_receiver then
                _report(definition.location, "an instance method")
                return null
            fi

            let parameters = LIST[PARAMETER]()

            for (i, argument) in definition.arguments |> Ghul.Pipes.index() do
                if let type = LLVM_TYPES.value_type(instance.specialize(argument)) then
                    parameters.add(PARAMETER(type, "a{i}"))
                else
                    _report(definition.location, "an argument of type {argument}")
                    return null
                fi
            od

            let result = LLVM_TYPES.result_type(instance.specialize(definition.return_type))

            if !result? then
                _report(definition.location, "a result of type {definition.return_type}")
                return null
            fi

            return FUNCTION(name, result, parameters.to_array())
        si

        _lower(module: MODULE, strings: LLVM_STRINGS, instance: FUNCTION_INSTANCE, function: FUNCTION, callee: (FUNCTION_INSTANCE) -> FUNCTION?) is
            let definition = instance.definition

            let lowering = LLVM_LOWERING(module, function, instance, instance.specialize(definition.return_type), callee, strings)

            lowering.lower(_bodies[definition])

            for construct in lowering.unsupported do
                _report(definition.location, construct)
            od
        si

    si

    // Finds a program's reach by lowering each body it reaches into a
    // module that is thrown away. This target compiles no classes yet, so
    // none is ever instantiated.
    class LLVM_DISCOVERY(
        reach: (FUNCTION_INSTANCE) -> void private,
        report: (Source.LOCATION, string) -> void private
    ): DiscoveryTarget is
        reach(instance: FUNCTION_INSTANCE) => _reach(instance)

        is_instantiated(type: CLASS_INSTANCE) -> bool => false

        note_instantiated(type: CLASS_INSTANCE) is si

        report(location: Source.LOCATION, construct: string) => _report(location, construct)
    si
si
