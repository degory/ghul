namespace IR.LLVMTarget is
    use Semantic.Types.Type

    use LLVM.Types

    /// How the LLVM target holds values of the built-in scalar kinds.
    ///
    /// A kind narrower than 32 bits is held in an `i32`, as CIL holds it on
    /// its evaluation stack, and brought back into its range wherever CIL
    /// would truncate it. The IR is shaped by CIL, so holding values the
    /// way CIL does lets it lower without conversions it never spells out.
    class LLVM_TYPES is
        /// The scalar kind a value of `type` is, or null where the type is
        /// not one of the built-in scalars. An enum is held as the `int`
        /// underneath it.
        scalar(type: Type?) -> Scalar? static =>
            if type? /\ isa Semantic.Symbols.ENUM_STRUCT(type.symbol) /\ !type.is_optional then
                Scalar.INT32
            else
                IoC.CONTAINER.instance.value_converter.scalar(type)
            fi

        /// The LLVM type a value of the scalar kind is held in.
        value_type(scalar: Scalar) -> LLVM.Type static =>
            case scalar
            when Scalar.INT64, Scalar.UINT64, Scalar.INT_NATIVE, Scalar.UINT_NATIVE then Types.i64
            when Scalar.FLOAT32 then LLVM.Type.FLOAT
            when Scalar.FLOAT64 then LLVM.Type.DOUBLE
            else Types.i32
            esac

        /// The LLVM type a value of `type` is held in, or null where the
        /// target holds no values of the type yet.
        value_type(type: Type?) -> LLVM.Type? static =>
            if let kind = scalar(type) then
                value_type(kind)
            elif is_string(type) \/ is_array(type) \/ is_object_reference(type) then
                Types.pointer
            else
                null
            fi

        /// Whether `type` is `string`, which is held as a pointer to the
        /// string object.
        is_string(type: Type?) -> bool static =>
            type? /\ type.symbol == IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type().symbol

        /// Whether `type` is a class, a trait or `object`, whose values are held
        /// as pointers to objects.
        is_object_reference(type: Type?) -> bool static =>
            type? /\ !type.is_value_type /\ !(type.optional_inner_type?.is_value_type ?? false) /\ (type.is_class \/ type.is_trait \/ type.is_object)

        /// Whether `type` is an array type, which is held as a pointer to the
        /// array object.
        is_array(type: Type?) -> bool static =>
            if let generic: Semantic.Symbols.GENERIC = type?.symbol then
                cast Semantic.Symbols.Classy?(generic.unspecialized_symbol) == IR.Program.INNATE_CORE_CLASSES().array_definition
            else
                false
            fi

        /// The type a function returning `type` is declared to return: `void`
        /// for nothing, or null where the target holds no values of the type
        /// yet.
        result_type(type: Type?) -> LLVM.Type? static =>
            if is_void(type) then LLVM.Type.VOID else value_type(type) fi

        /// Whether `type` is absent or `void`.
        is_void(type: Type?) -> bool static => !type? \/ type.is_void

        /// Whether the kind is held in fewer bits than the type carrying it.
        is_narrow(scalar: Scalar) -> bool static =>
            case scalar
            when Scalar.BOOL, Scalar.CHAR, Scalar.INT8, Scalar.UINT8, Scalar.INT16, Scalar.UINT16 then true
            else false
            esac

        /// Whether the kind's top bit is part of its magnitude.
        is_unsigned(scalar: Scalar) -> bool static =>
            case scalar
            when Scalar.BOOL, Scalar.CHAR, Scalar.UINT8, Scalar.UINT16 then true
            when Scalar.UINT32, Scalar.UINT64, Scalar.UINT_NATIVE then true
            else false
            esac

        /// Whether `type` is a floating point type.
        is_floating(type: LLVM.Type) -> bool static =>
            type =~ LLVM.Type.FLOAT \/ type =~ LLVM.Type.DOUBLE

        /// The width in bits of an integer type, or zero for any other.
        width(type: LLVM.Type) -> int static =>
            if let integer: LLVM.Type.INTEGER = type then integer.width else 0 fi

        /// The zero of `type`.
        zero(type: LLVM.Type) -> LLVM.Value static =>
            case type
            when LLVM.Type.FLOAT then LLVM.Values.of_single(0.0s)
            when LLVM.Type.DOUBLE then LLVM.Values.of_double(0.0)
            when _: LLVM.Type.POINTER then LLVM.Values.null_pointer
            else LLVM.Values.integer(type, bigint.zero)
            esac
    si
si
