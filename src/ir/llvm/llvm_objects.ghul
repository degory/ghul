namespace IR.LLVMTarget is
    use IR.Program

    use Collections.LIST
    use Collections.MAP

    use Semantic.Scope
    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use IR.Emitter.SRM_MEMBER_ORDER
    use IR.Emitter.SRM_EMITTED_TYPE

    use LLVM.GLOBAL_VARIABLE
    use LLVM.Linkage
    use LLVM.MODULE
    use LLVM.Types
    use LLVM.Values

    /// The program's classes on the LLVM target: one object layout and one
    /// constant descriptor for each class instantiation the program uses,
    /// the vtables and the trait table calls dispatch through, and the
    /// globals holding static fields and namespace-level variables.
    ///
    /// An object is `{ ptr descriptor, superclass fields..., own fields... }`,
    /// each field held as the lowering holds a value of its type, so a field
    /// is at the same offset in every instance that has it.
    ///
    /// A descriptor is `{ i32 class number, i32 last descendant's number,
    /// ptr superclass descriptor, ptr name, ptr display function, ptr type
    /// object, i64 instance size, [N x ptr] vtable }`. The name is a string
    /// literal. The display function is null for a type with no displayer,
    /// and the type object is null until the program first asks for it, when
    /// it is made and cached there, so descriptors are writable.
    ///
    /// The trait table is one constant `[N x ptr]`, indexed by a row's offset
    /// plus the receiver's class number.
    ///
    /// Classes are found while the program's reach is discovered, then
    /// numbered and laid out by `build`, and the descriptors and the trait
    /// table are written by `finish` once every function is declared.
    class LLVM_OBJECTS: DispatchTarget, DisplayTarget is
        _module: MODULE
        _classes: CLASS_SET
        _dispatched: DISPATCHED_METHODS
        _plan: DISPATCH_PLAN

        _is_built: bool

        _layouts: MAP[CLASS_INSTANCE, LIST[LLVM.Type]]
        _sizes: MAP[CLASS_INSTANCE, int]
        _field_positions: MAP[Symbol, int]

        _statics: MAP[CLASS_INSTANCE, MAP[Symbol, (name: string, type: LLVM.Type)]]
        _globals: MAP[Symbol, (name: string, type: LLVM.Type)]
        _box_hashes: MAP[CLASS_INSTANCE, LLVM.FUNCTION]
        _box_equalities: MAP[CLASS_INSTANCE, LLVM.FUNCTION]
        _static_constructors: MAP[CLASS_INSTANCE, (constructor: FUNCTION_INSTANCE, flag: string)?]
        _unit_variants: Collections.SET[CLASS_INSTANCE]
        _trait_instances: LIST[CLASS_INSTANCE]
        _seen_trait_instances: Collections.SET[CLASS_INSTANCE]
        _declared_methods: MAP[Classy, Collections.List[Function]]
        _found_instantiated: Collections.SET[CLASS_INSTANCE]
        _allocated: Collections.SET[CLASS_INSTANCE]
        _generic_calls: LIST[(method: Function, arguments: Collections.List[Type])]
        _added_methods: MAP[Classy, LIST[Function]]
        _next_global: int

        _unsupported: LIST[(location: Source.LOCATION, construct: string)]
        _string: CLASS_INSTANCE?
        _boxes_made: Collections.SET[CLASS_INSTANCE]
        _display_state: CLASS_INSTANCE?
        _displayers: MAP[CLASS_INSTANCE, LLVM.FUNCTION]

        /// The offset of the class number within a descriptor.
        DESCRIPTOR_CLASS_ID: int static => 0

        /// The offset of the number of the class's last descendant within a
        /// descriptor.
        DESCRIPTOR_LAST_DESCENDANT: int static => 4

        /// The offset of the superclass's descriptor within a descriptor,
        /// null for the root.
        DESCRIPTOR_SUPERCLASS: int static => 8

        /// The offset of the type's name, a string, within a descriptor.
        DESCRIPTOR_NAME: int static => 16

        /// The offset of the function that writes a value of the class for
        /// display within a descriptor, null where it has none.
        DESCRIPTOR_DISPLAY: int static => 24

        /// The offset within a descriptor of the type object `get_type`
        /// answers, a constant built beside the descriptor.
        DESCRIPTOR_TYPE_OBJECT: int static => 32

        /// The offset of an instance's size in bytes within a descriptor.
        DESCRIPTOR_SIZE: int static => 40

        /// The offset of the first vtable entry within a descriptor.
        DESCRIPTOR_VTABLE: int static => 48

        /// The offset of the value within a box.
        BOX_VALUE_OFFSET: int static => 8

        /// The name of the trait table.
        TRAIT_TABLE_NAME: string static => "$ghul_trait_table"

        /// - module: where the descriptors, the trait table and the globals are added
        /// - classes: the program's classes, rooted at `object`
        /// - string_type: the string type, or null where the program has none
        init(module: MODULE, classes: CLASS_SET, string_type: Classy?) is
            _module = module
            _classes = classes

            if let definition = string_type then
                _string = classes.intern(CLASS_INSTANCE.of(definition))
            fi
            _dispatched = DISPATCHED_METHODS()
            _plan = DISPATCH_PLAN(self)

            _layouts = MAP[CLASS_INSTANCE, LIST[LLVM.Type]]()
            _sizes = MAP[CLASS_INSTANCE, int]()
            _field_positions = MAP[Symbol, int]()

            _statics = MAP[CLASS_INSTANCE, MAP[Symbol, (name: string, type: LLVM.Type)]]()
            _globals = MAP[Symbol, (name: string, type: LLVM.Type)]()
            _box_hashes = MAP[CLASS_INSTANCE, LLVM.FUNCTION]()
            _box_equalities = MAP[CLASS_INSTANCE, LLVM.FUNCTION]()
            _static_constructors = MAP[CLASS_INSTANCE, (constructor: FUNCTION_INSTANCE, flag: string)?]()
            _unit_variants = Collections.SET[CLASS_INSTANCE]()
            _trait_instances = LIST[CLASS_INSTANCE]()
            _seen_trait_instances = Collections.SET[CLASS_INSTANCE]()
            _declared_methods = MAP[Classy, Collections.List[Function]]()
            _found_instantiated = Collections.SET[CLASS_INSTANCE]()
            _allocated = Collections.SET[CLASS_INSTANCE]()
            _generic_calls = LIST[(method: Function, arguments: Collections.List[Type])]()
            _added_methods = MAP[Classy, LIST[Function]]()

            _unsupported = LIST[(location: Source.LOCATION, construct: string)]()
            _boxes_made = Collections.SET[CLASS_INSTANCE]()
            _displayers = MAP[CLASS_INSTANCE, LLVM.FUNCTION]()
        si

        /// Where function values' thunks and descriptor are made, once the
        /// program is being compiled rather than discovered.
        closures: LLVM_CLOSURES? public

        /// The methods calls dispatch on, found while discovering.
        dispatched: DISPATCHED_METHODS => _dispatched

        /// The program's classes.
        classes: CLASS_SET => _classes

        /// Whether `build` has numbered and laid out the classes. Until it
        /// has, positions, slots and offsets are placeholders, since what is
        /// lowered then is thrown away.
        is_built: bool => _is_built

        /// What the classes use that the target cannot compile yet, each
        /// with where it is declared.
        unsupported: Collections.List[(location: Source.LOCATION, construct: string)] => _unsupported

        /// Takes every class declared under `root` that is not generic, and a
        /// box for each scalar and each enum.
        collect(root: Scope) => _classes.collect(root, CLASS_SET.innate_scalar_types())

        /// The box a value of the scalar `type` is held in, or null where
        /// `type` is not a scalar.
        box_type(type: Type?) -> CLASS_INSTANCE? => _classes.box_type(type)

        /// Records that the program boxes a value in `box`, so a value of it
        /// can exist.
        note_boxed(box: CLASS_INSTANCE) is
            _boxes_made.add(box)
        si

        /// Records, while discovering, that the program allocates an object
        /// of `type`, so a call through a vtable or a trait table can reach
        /// its implementation.
        note_allocated(type: CLASS_INSTANCE) is
            if !_is_built then
                _allocated.add(type)
            fi
        si

        /// The class a value of `type` is an instance of, or null where the
        /// program has none.
        class_of(type: Type?) -> CLASS_INSTANCE? => if LLVM_TYPES.is_string(type) then _string else _classes.class_of(type) fi

        /// The class `definition` at the arguments `type_map` gives its
        /// parameters, or null where it is not a class the target represents.
        class_of(definition: Classy, type_map: Collections.Map[Symbol, Type]) -> CLASS_INSTANCE? =>
            _classes.class_of(definition, type_map)

        /// The one instance of the trait a value of `type` is.
        trait_of(type: Type) -> CLASS_INSTANCE? => _plan.trait_of(type)

        /// The one instance of the trait `definition` at the arguments
        /// `type_map` gives its parameters.
        trait_of(definition: Classy, type_map: Collections.Map[Symbol, Type]) -> CLASS_INSTANCE? =>
            _plan.trait_of(definition, type_map)

        /// Numbers the classes, lays each out and plans its vtable, and plans
        /// the trait table. Nothing is added to the classes afterwards.
        build() is
            _classes.number()

            let ordered = LIST[CLASS_INSTANCE]()

            for type in _classes.numbering.in_order() do
                if !_classes.is_array(type) then
                    _lay_out(type)
                fi

                ordered.add(type)
            od

            _plan.plan_slots(ordered)
            _plan.plan_traits()

            _is_built = true
        si

        // An object's fields follow its superclass's, after the descriptor.
        _lay_out(type: CLASS_INSTANCE) is
            let layout = LIST[LLVM.Type]()

            if _layouts.contains_key(type) then
                return
            fi

            // A struct is held in place, its fields and nothing more.
            if is_struct(type) then
                // Marked laid out first, so a struct that holds itself is caught
                // by the type checker rather than recursing here.
                _layouts[type] = layout
            elif let parent = _classes.superclass_of(type) ?? (if type != _classes.root then _classes.root else null fi) then
                _lay_out(parent)
                layout.add_range(_layouts[parent])
            else
                layout.add(Types.pointer)
            fi

            if is_string(type) then
                layout.add(Types.i32)
                layout.add(Types.i32)
            elif is_bigint(type) then
                layout.add(Types.i64)
                layout.add(Types.pointer)
            elif let boxed = _classes.boxed_type(type) then
                layout.add(LLVM_TYPES.stored_type(boxed) ?? LLVM_TYPES.value_type(boxed) ?? Types.i32)
            elif is_object_type(type) then
                for `field in SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(type.definition)) do
                    if `field.is_instance then
                        _field_positions[`field] = layout.count

                        if let stored = stored_type(type.specialize(`field.type)) then
                            layout.add(stored)
                        else
                            _unsupported.add((`field.location, "a field of type {type.specialize(`field.type)}"))
                            layout.add(Types.pointer)
                        fi
                    fi
                od
            fi

            _layouts[type] = layout
            _sizes[type] = LLVM_TYPES.size_of(Types.structure(layout.to_array()))
        si

        /// The LLVM type a value of `type` is held in: a scalar's or a
        /// reference's as LLVM_TYPES gives it, a struct as its fields, in
        /// place, and an optional value type as whether it is present and
        /// its value, `{ i1, T }`. Null where the target holds no values of the type.
        held_type(type: Type?) -> LLVM.Type? is
            if isa Semantic.Types.REFERENCE(type) then
                return Types.pointer
            elif let t = type /\ t.is_optional /\ t.is_value_type /\ !t.is_maybe then
                if let inner = stored_type(t.optional_inner_type) then
                    return Types.structure([Types.i8, inner])
                fi

                return null
            elif let held = LLVM_TYPES.value_type(type) then
                return held
            elif bigint_of(type)? then
                return Types.pointer
            elif let s = struct_of(type) then
                _lay_out(s)

                return Types.structure(_layouts[s].to_array())
            fi

            return null
        si

        /// The LLVM type a value of `type` is stored as in memory: a scalar at
        /// the width of its kind, anything else as it is held. Null where the
        /// target holds no values of the type.
        stored_type(type: Type?) -> LLVM.Type? => LLVM_TYPES.stored_type(type) ?? held_type(type)

        /// A value of `type` loaded in `block` from `pointer`, where it is held
        /// as stored, widened to the width it is computed with; null where the
        /// target holds no values of the type.
        load_stored(block: LLVM.BLOCK, type: Type?, pointer: LLVM.Value) -> LLVM.Value? is
            let stored = stored_type(type)

            if !stored? then
                return null
            fi

            let value = block.load(stored, pointer, 0)

            return if let scalar = LLVM_TYPES.scalar(type) then LLVM_TYPES.widen(block, value, scalar) else value fi
        si

        /// The struct a value of `type` is, held in place, or null where it
        /// is not one: a scalar, an enum or an optional struct is not.
        struct_of(type: Type?) -> CLASS_INSTANCE? is
            if !type? \/ (type.is_optional /\ !type.is_maybe) \/ LLVM_TYPES.value_type(type)? then
                return null
            fi

            if let s = _classes.class_of(type) /\ is_struct(s) then
                return s
            fi

            return null
        si

        /// Whether `type` is a struct, which is held in place rather than
        /// through a reference. A bigint is not: it is a reference to its
        /// box, which is never changed once made.
        is_struct(type: CLASS_INSTANCE) -> bool =>
            isa Semantic.Symbols.STRUCT(type.definition) /\ !_classes.is_box(type) /\ _classes.is_object_type(type.definition) /\ !is_bigint(type)

        /// The bigint class a value of `type` is, or null where it is not one.
        bigint_of(type: Type?) -> CLASS_INSTANCE? is
            if !type? \/ type.is_optional then
                return null
            fi

            if let b = _classes.class_of(type) /\ is_bigint(b) then
                return b
            fi

            return null
        si

        /// The position of a bigint box's i64 field, which holds its value
        /// where that fits.
        BIGINT_SMALL: int static => 1

        /// The position of a bigint box's field holding the runtime's
        /// integer, or null where its value is in the i64 field.
        BIGINT_BIG: int static => 2

        /// The LLVM struct type an instance of `type` is.
        struct_type(type: CLASS_INSTANCE) -> LLVM.Type =>
            if _is_built then Types.structure(_layouts[type].to_array()) else Types.structure([Types.pointer]) fi

        /// The size in bytes of an instance of `type`.
        size_of(type: CLASS_INSTANCE) -> int =>
            if !_is_built then
                8
            elif _classes.is_array(type) then
                LLVM_ARRAYS.ELEMENTS_OFFSET
            else
                _sizes[type]
            fi

        /// The instance fields of `type` the target holds, its superclasses'
        /// first, each with its type at `type`'s arguments and its position
        /// in `type`'s struct type. Empty until the classes are laid out.
        fields_of(type: CLASS_INSTANCE) -> LIST[(`field: Symbol, type: Type, position: int)] is
            let result = LIST[(`field: Symbol, type: Type, position: int)]()

            if !_is_built \/ !is_object_type(type) then
                return result
            fi

            if let parent = _classes.superclass_of(type) then
                result.add_range(fields_of(parent))
            fi

            for `field in SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(type.definition)) do
                let position: int mut

                if `field.is_instance /\ _field_positions.try_get_value(`field, position ref) then
                    if let field_type = type.specialize(`field.type) then
                        result.add((`field, field_type, position))
                    fi
                fi
            od

            return result
        si

        /// The position in its owner's struct type of the instance field
        /// `field`, or null where the target does not hold it.
        field_position(`field: Symbol) -> int? is
            if !_is_built then
                return 0
            fi

            let position mut = 0

            if _field_positions.try_get_value(`field.root_specialized_from, position ref) then
                return position
            fi

            return null
        si

        /// The name of the global holding `type`'s descriptor.
        descriptor_name(type: CLASS_INSTANCE) -> string =>
            if is_string(type) then
                LLVM_STRINGS.DESCRIPTOR_NAME
            elif _is_built then "$ghul_descriptor_{_classes.numbering.id(type)}" else "$ghul_descriptor" fi

        /// The name of the global holding the one instance of the unit variant
        /// `type`.
        unit_variant_name(type: CLASS_INSTANCE) -> string is
            _unit_variants.add(type)

            return if _is_built then "$ghul_unit_variant_{_classes.numbering.id(type)}" else "$ghul_unit_variant" fi
        si

        /// The number of `type` and of its last descendant, so a value is
        /// an instance of `type` exactly when its class number is between
        /// the two.
        class_range(type: CLASS_INSTANCE) -> (first: int, last: int) =>
            if _is_built then
                (_classes.numbering.id(type), _classes.numbering.last_descendant(type))
            else
                (0, 0)
            fi

        /// The class number ranges a value of the array type `type` can be in:
        /// `type` itself and, where its element is a reference type, every array
        /// type whose element is a subtype of it, as an array of a class is an
        /// array of its superclass.
        array_ranges(type: CLASS_INSTANCE) -> LIST[(first: int, last: int)] is
            let result = LIST[(first: int, last: int)]()

            if !_is_built then
                return result
            fi

            let target = _classes.array_element(type)

            for (array, element) in _classes.arrays do
                if array =~ type \/ (!target.is_value_type /\ !element.is_value_type /\ target.is_assignable_from(element)) then
                    result.add(class_range(array))
                fi
            od

            return result
        si

        /// The global holding the static field `field` of `owner`, or the
        /// namespace-level variable `field` where `owner` is null, or null
        /// where its type is one the target holds no values of.
        global_of(`field: Symbol, owner: CLASS_INSTANCE?, type: Type?) -> (name: string, type: LLVM.Type)? is
            let held = stored_type(type)

            if !held? then
                return null
            fi

            let globals =
                if let o = owner then
                    if !_statics.contains_key(o) then
                        _statics[o] = MAP[Symbol, (name: string, type: LLVM.Type)]()
                    fi

                    _statics[o]
                else
                    _globals
                fi

            let root = `field.root_specialized_from
            let found: (name: string, type: LLVM.Type) mut

            if globals.try_get_value(root, found ref) then
                return found
            fi

            let result = ("$ghul_global_{_next_global}", held)

            _next_global = _next_global + 1

            globals[root] = result

            return result
        si

        /// The static constructor of `type` and the name of the global flag
        /// recording that it has run, or null where `type` has none.
        static_constructor(type: CLASS_INSTANCE) -> (constructor: FUNCTION_INSTANCE, flag: string)? is
            let found: (constructor: FUNCTION_INSTANCE, flag: string)? mut

            if _static_constructors.try_get_value(type, found ref) then
                return found
            fi

            let result: (constructor: FUNCTION_INSTANCE, flag: string)? mut = null

            for method in SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(type.definition)) do
                if method.is_static_constructor then
                    result = (FUNCTION_INSTANCE(method, type.type_map), "$ghul_global_{_next_global}")
                    _next_global = _next_global + 1
                fi
            od

            _static_constructors[type] = result

            return result
        si

        /// Reaches, while discovering, a function the program compiles: one a
        /// dispatched call can run without naming it.
        reach: ((FUNCTION_INSTANCE) -> void)? public

        /// Records, while discovering, that a call dispatches on `method`.
        note_dispatched(method: Function) is
            if _dispatched.is_dispatched_to(cast Function?(method.root_specialized_from)!) then
                return
            fi

            _dispatched.note(method)

            if !_is_built /\ reach? then
                for trait_type in LIST[CLASS_INSTANCE](_trait_instances) do
                    _reach_dispatched_defaults(trait_type)
                od
            fi
        si

        /// Records, while discovering, that a value of `type` can exist.
        note_instantiated(type: CLASS_INSTANCE) is
            _found_instantiated.add(type)

            if !_is_built /\ reach? then
                _note_trait_instances(type.definition, type.type_map)

                for call in LIST[(method: Function, arguments: Collections.List[Type])](_generic_calls) do
                    _reach_generic(type, call.method, call.arguments)
                od
            fi
        si

        /// Records, while discovering, a call to the generic trait method
        /// `method` through `trait_type` at `arguments`, its own type
        /// arguments, and reaches its implementation in every class that can
        /// exist; a class found later is reached when it is.
        ///
        /// - method: the trait method called
        /// - trait_type: the trait instance the call goes through
        /// - arguments: the method's own type arguments at the call
        note_generic_call(method: Function, trait_type: CLASS_INSTANCE, arguments: Collections.List[Type]) is
            if _is_built \/ !reach? \/ !_plan.note_generic_call(method, trait_type, arguments)? then
                return
            fi

            _generic_calls.add((method, arguments))

            for type in LIST[CLASS_INSTANCE](_found_instantiated) do
                _reach_generic(type, method, arguments)
            od
        si

        _reach_generic(type: CLASS_INSTANCE, method: Function, arguments: Collections.List[Type]) is
            if let implementation = _plan.generic_implementation(type, method, arguments) then
                reach!(implementation)
            fi
        si

        /// The trait table row a call to the generic trait method `method`
        /// at `arguments` on an instance of `trait_type` goes through, or
        /// null where it has none.
        generic_selector_of(method: Function, trait_type: CLASS_INSTANCE, arguments: Collections.List[Type]) -> TRAIT_SELECTOR? =>
            _plan.generic_selector_of(method, trait_type, arguments)

        // The default methods of the traits an instantiated class implements
        // that a call dispatches on are reached through the trait table,
        // which names them only once it is planned, so they are reached
        // here. A generic trait's are reached at each instance of it a class
        // implements. Each trait instance is collected once, so a newly
        // dispatched method is checked against every one of them without
        // walking the classes again.
        _note_trait_instances(from: Classy, map: Collections.Map[Symbol, Type]) is
            for ancestor in from.ancestors do
                let specialized = TYPE_MAPS.specialize(ancestor, map)!

                if ancestor.is_trait then
                    if let trait_type = _plan.trait_of(specialized) /\ _seen_trait_instances.add(trait_type) then
                        _trait_instances.add(trait_type)
                        _reach_dispatched_defaults(trait_type)
                        _note_trait_instances(trait_type.definition, trait_type.type_map)
                    fi
                elif let superclass = _classes.class_of(specialized) then
                    _note_trait_instances(superclass.definition, superclass.type_map)
                fi
            od
        si

        _reach_dispatched_defaults(trait_type: CLASS_INSTANCE) is
            for method in methods_of(trait_type.definition) do
                if DISPATCH_PLAN.is_dispatched(method) /\ !method.is_abstract /\ _dispatched.is_dispatched_to(method) then
                    reach!(FUNCTION_INSTANCE(method, trait_type.type_map))
                fi
            od
        si

        /// The vtable slot a virtual call to `method` goes through, or null
        /// where it has none.
        slot_of(method: FUNCTION_INSTANCE) -> DISPATCH_SLOT? => _plan.slot_of(method)

        /// The trait table row a call to the trait method `method` on an
        /// instance of `trait_type` goes through, or null where it has none.
        selector_of(method: Function, trait_type: CLASS_INSTANCE) -> TRAIT_SELECTOR? =>
            _plan.selector_of(method, trait_type)

        /// The one implementation a call to `selector` can run on a value
        /// that can exist, or null where there is more than one.
        only_implementation(selector: TRAIT_SELECTOR) -> FUNCTION_INSTANCE? =>
            if _is_built then
                _plan.only_implementation(selector, id => _can_exist_by_id(id)) ?? _plan.only_implementation(selector)
            else
                _plan.only_implementation(selector)
            fi

        /// The one implementation a call through `slot` can run on a value
        /// that can exist, or null where there is more than one.
        only_slot_implementation(slot: DISPATCH_SLOT) -> FUNCTION_INSTANCE? =>
            if _is_built then _plan.only_slot_implementation(slot, type => _is_allocated(type)) else null fi

        _by_number: MAP[int, CLASS_INSTANCE]?

        _can_exist_by_id(id: int) -> bool is
            let by_number mut = _by_number

            if !by_number? then
                let built = MAP[int, CLASS_INSTANCE]()

                for type in _classes.numbering.in_order() do
                    built[_classes.numbering.id(type)] = type
                od

                _by_number = built
                by_number = built
            fi

            let type: CLASS_INSTANCE mut

            return by_number.try_get_value(id, type ref) /\ _is_allocated(type)
        si

        // Whether an object of `type` can exist at run time: something
        // allocates one, it is an array or a unit variant's one instance, or
        // the runtime makes it itself.
        _is_allocated(type: CLASS_INSTANCE) -> bool =>
            _can_exist(type) /\
            (is_string(type) \/ _classes.is_array(type) \/ _allocated.contains(type) \/ _unit_variants.contains(type) \/ _classes.is_box(type) \/ _is_made_by_runtime(type))

        // The runtime makes a type object for each class, and the exception
        // a read through null raises.
        _is_made_by_runtime(type: CLASS_INSTANCE) -> bool =>
            _type_class_instance() =~ type \/
            type.definition == IR.Program.CORE_LIBRARY.exception_class(Semantic.Lookups.RuntimeException.NULL_REFERENCE)

        /// The classes implementing `trait_type`, or null where the program
        /// has none.
        implementors(trait_type: CLASS_INSTANCE) -> Collections.List[CLASS_INSTANCE]? => _plan.implementors(trait_type)

        /// Adds every descriptor, the trait table and the globals to the
        /// module, each function referred to by the LLVM function `callee`
        /// answers for it, null where the program never compiles it.
        finish(strings: LLVM_STRINGS, callee: (FUNCTION_INSTANCE) -> LLVM.FUNCTION?) is
            for type in _classes.numbering.in_order() do
                _add_descriptor(type, strings, callee)
            od

            _add_trait_table(callee)

            for (_, globals) in _statics do
                for (_, (name, type)) in globals do
                    _add_global(name, type)
                od
            od

            for (_, (name, type)) in _globals do
                _add_global(name, type)
            od

            for type in LIST[CLASS_INSTANCE](_unit_variants) do
                let layout = _layouts[type]
                let values = LIST[LLVM.Value]()

                values.add(Values.global(descriptor_name(type)))

                for i in 1..layout.count do
                    values.add(LLVM_TYPES.zero(layout[i]))
                od

                let struct_type = struct_type(type)
                let global = GLOBAL_VARIABLE(unit_variant_name(type), struct_type, LLVM.Value.AGGREGATE(values.to_array(), struct_type), false)

                global.linkage = Linkage.INTERNAL
                global.alignment = 8

                _module.add_global(global)
            od

            for (_, constructor) in _static_constructors do
                if let (_, flag) = constructor then
                    _add_global(flag, Types.i32)
                fi
            od
        si

        /// The type object of the class whose descriptor is `descriptor_name`:
        /// a constant instance of the core library's `Type`, built here with
        /// `name` as its full name, so `get_type` is a load of a constant.
        /// Null where the program holds no `Type`, which is then never asked
        /// for.
        ///
        /// - descriptor_name: the name of the descriptor the type object
        ///   stands beside
        /// - name: the type's full name, a string literal
        type_object(descriptor_name: string, name: LLVM.Value) -> LLVM.Value is
            let type_class = _type_class_instance()

            if !type_class? then
                return Values.null_pointer
            fi

            let layout = struct_type(type_class)

            let fields =
                if let s: LLVM.Type.STRUCT = layout then
                    s.fields
                else
                    return Values.null_pointer
                fi

            let values = LIST[LLVM.Value]()

            for field_type in fields do
                values.add(LLVM_TYPES.zero(field_type))
            od

            values[0] = Values.global(descriptor_name(type_class))

            for (`field, _, position) in fields_of(type_class) do
                if `field.name =~ "_full_name" then
                    values[position] = name
                fi
            od

            let global_name = "{descriptor_name}$type"
            let global = GLOBAL_VARIABLE(global_name, layout, LLVM.Value.AGGREGATE(values.to_array(), layout), true)

            global.linkage = Linkage.INTERNAL
            global.alignment = 8

            _module.add_global(global)

            return Values.global(global_name)
        si

        // The core library's `Type`, where the program holds one.
        _type_class_instance() -> CLASS_INSTANCE? is
            if let definition = IR.Program.CORE_LIBRARY.type_class(), found = class_of(definition, Collections.MAP[Symbol, Type]()) /\ is_object_type(found) then
                return found
            fi

            return null
        si

        _add_global(name: string, type: LLVM.Type) is
            let global = GLOBAL_VARIABLE(name, type, LLVM_TYPES.zero(type), false)

            global.linkage = Linkage.INTERNAL

            _module.add_global(global)
        si

        _add_descriptor(type: CLASS_INSTANCE, strings: LLVM_STRINGS, callee: (FUNCTION_INSTANCE) -> LLVM.FUNCTION?) is
            let entries = LIST[LLVM.Value]()

            if _plan.has_slots(type) then
                for entry in _plan.slot_entries(type) do
                    // An entry a call can reach must be compiled, or the call
                    // would go through a null pointer. An abstract method's
                    // entry stays null: only a subclass that implements it
                    // can be instantiated, and its own entry is the one used.
                    if let e = entry /\ _can_exist(type) /\ !e.definition.is_abstract /\ _dispatched.is_dispatched_to(e.definition) /\ !callee(e)? then
                        _unsupported.add((e.definition.location, "a method of {type} called through a vtable"))
                    fi

                    entries.add(_reference(entry, callee, type))
                od
            fi

            let vtable_type = LLVM.Type.ARRAY(entries.count, Types.pointer)

            let superclass =
                if let parent = _plan.parent(type) then
                    Values.global(descriptor_name(parent))
                else
                    Values.null_pointer
                fi

            let descriptor_type =
                Types.structure([
                    Types.i32, Types.i32, Types.pointer, Types.pointer, Types.pointer, Types.pointer, Types.i64, vtable_type
                ])

            let name = strings.literal(TYPE_NAMES.name_of(type, _classes, null, t => LLVM_TYPES.scalar(t), t => LLVM_TYPES.is_string(t)))

            let initializer =
                LLVM.Value.AGGREGATE(
                    [
                        Values.i32(_classes.numbering.id(type)),
                        Values.i32(_classes.numbering.last_descendant(type)),
                        superclass,
                        name,
                        _displayer_reference(type),
                        type_object(descriptor_name(type), name),
                        Values.i64(cast long(size_of(type))),
                        LLVM.Value.AGGREGATE(entries.to_array(), vtable_type)
                    ],
                    descriptor_type)

            let global = GLOBAL_VARIABLE(descriptor_name(type), descriptor_type, initializer, true)

            global.linkage = Linkage.INTERNAL
            global.alignment = 8

            _module.add_global(global)
        si

        _add_trait_table(callee: (FUNCTION_INSTANCE) -> LLVM.FUNCTION?) is
            let by_number = MAP[int, CLASS_INSTANCE]()

            for type in _classes.numbering.in_order() do
                by_number[_classes.numbering.id(type)] = type
            od

            // A call through a row of no implementors still names the table.
            let size = if _plan.table_size > 0 then _plan.table_size else 1 fi

            let entries = LIST[LLVM.Value]()

            for i in 0..size do
                entries.add(Values.null_pointer)
            od

            for (method, row) in _plan.rows do
                let offset = _plan.selector(method).offset

                for (class_id, implementation) in row do
                    // An entry a call can reach must be compiled, or the call would
                    // go through a null pointer. A call reaches it only where a
                    // value of its class can exist, as for a vtable entry: a call
                    // is recorded against the trait method rather than the
                    // instance of the trait it goes through, so the rows of
                    // every instance count as dispatched once any one is.
                    if _dispatched.is_dispatched_to(method.definition) /\ by_number.contains_key(class_id) /\ _can_exist(by_number[class_id]) /\ !callee(implementation)? then
                        _unsupported.add((implementation.definition.location, "a method called through a trait"))
                    fi

                    entries[offset + class_id] = _reference(implementation, callee, if by_number.contains_key(class_id) then by_number[class_id] else null fi)
                od
            od

            let type = LLVM.Type.ARRAY(size, Types.pointer)

            let global = GLOBAL_VARIABLE(TRAIT_TABLE_NAME, type, LLVM.Value.AGGREGATE(entries.to_array(), type), true)

            global.linkage = Linkage.INTERNAL

            _module.add_global(global)
        si

        /// The entries of the root's vtable, which every object without a
        /// class of its own, a closure, answers virtual calls through.
        root_vtable(callee: (FUNCTION_INSTANCE) -> LLVM.FUNCTION?) -> LIST[LLVM.Value] is
            let entries = LIST[LLVM.Value]()

            if let root = _classes.root /\ _plan.has_slots(root) then
                for entry in _plan.slot_entries(root) do
                    entries.add(_reference(entry, callee, root))
                od
            fi

            return entries
        si

        // The entry for `instance` in `owner`'s vtable or trait table row. A
        // box, of a scalar or a struct, reaches a method of the value it
        // boxes through a thunk that passes the method the value's address
        // rather than the box.
        _reference(instance: FUNCTION_INSTANCE?, callee: (FUNCTION_INSTANCE) -> LLVM.FUNCTION?, owner: CLASS_INSTANCE?) -> LLVM.Value is
            if let i = instance, function = callee(i) then
                if let o = owner /\ is_box(o) /\ _is_root_hash(i), hash = _box_hash(o) then
                    return hash.reference
                fi

                if let o = owner /\ is_box(o) /\ _is_root_equals(i), equals = _box_equals(o, function) then
                    return equals.reference
                fi

                if let o = owner /\ (is_box(o) \/ is_struct(o)) /\ isa Semantic.Symbols.STRUCT(i.definition.owner), c = closures then
                    return c.unboxing_thunk(function).reference
                fi

                if let o = owner /\ is_bigint(o) /\ isa Semantic.Symbols.STRUCT(i.definition.owner), c = closures then
                    return c.referencing_thunk(function).reference
                fi

                return function.reference
            fi

            return Values.null_pointer
        si

        // Whether `instance` is the root's `get_hash_code`, which a box of a
        // scalar answers with the hash of the scalar it holds instead.
        _is_root_hash(instance: FUNCTION_INSTANCE) -> bool =>
            instance.definition.name =~ "get_hash_code" /\
            instance.definition.arguments.count == 0 /\
            (cast Classy?(instance.definition.owner)?.is_object ?? false)

        // The function the box `type` answers `get_hash_code` with: the hash
        // of the scalar it holds, or null where it holds no scalar.
        _box_hash(type: CLASS_INSTANCE) -> LLVM.FUNCTION? is
            let found: LLVM.FUNCTION mut

            if _box_hashes.try_get_value(type, found ref) then
                return found
            fi

            let boxed = _classes.boxed_type(type)

            if !LLVM_TYPES.value_type(boxed)? then
                return null
            fi

            let function = LLVM.FUNCTION("\$ghul_box_hash_{_box_hashes.count}", Types.i32, [LLVM.PARAMETER(Types.pointer, "box")])

            function.linkage = Linkage.INTERNAL

            let block = function.add_block("entry")
            let address = block.element_pointer(Types.i8, function.parameter(0), [Values.i32(BOX_VALUE_OFFSET)], true)

            block.return_value(LLVM_SCALAR_HASH.hash(block, load_stored(block, boxed, address)!))

            _module.add_function(function)

            _box_hashes[type] = function

            return function
        si

        // Whether `instance` is the root's `equals`, which a box of a scalar
        // answers by comparing the scalar it holds instead.
        _is_root_equals(instance: FUNCTION_INSTANCE) -> bool =>
            instance.definition.name =~ "equals" /\
            instance.definition.arguments.count == 1 /\
            (cast Classy?(instance.definition.owner)?.is_object ?? false)

        // The function the box `type` answers `equals` with, of the same type
        // as `root_equals`, the root's: true where the other object is a box
        // with the same descriptor holding a value equal to this one's, a NaN
        // equal to another as .NET has it. Null where it holds no scalar.
        _box_equals(type: CLASS_INSTANCE, root_equals: LLVM.FUNCTION) -> LLVM.FUNCTION? is
            let found: LLVM.FUNCTION mut

            if _box_equalities.try_get_value(type, found ref) then
                return found
            fi

            let boxed = _classes.boxed_type(type)

            if !LLVM_TYPES.value_type(boxed)? then
                return null
            fi

            let function =
                LLVM.FUNCTION(
                    "\$ghul_box_equals_{_box_equalities.count}",
                    root_equals.result,
                    [LLVM.PARAMETER(Types.pointer, "box"), LLVM.PARAMETER(Types.pointer, "other")])

            function.linkage = Linkage.INTERNAL

            let entry = function.add_block("entry")
            let same_type = function.add_block("same_type")
            let compare = function.add_block("compare")
            let different = function.add_block("different")

            let box = function.parameter(0)
            let other = function.parameter(1)

            entry.branch(entry.compare(LLVM.IntegerPredicate.EQ, other, Values.null_pointer), different, same_type)

            let descriptor = same_type.load(Types.pointer, box, 8)
            let other_descriptor = same_type.load(Types.pointer, other, 8)

            same_type.branch(same_type.compare(LLVM.IntegerPredicate.EQ, descriptor, other_descriptor), compare, different)

            let left = load_stored(compare, boxed, compare.element_pointer(Types.i8, box, [Values.i32(BOX_VALUE_OFFSET)], true))!
            let right = load_stored(compare, boxed, compare.element_pointer(Types.i8, other, [Values.i32(BOX_VALUE_OFFSET)], true))!

            let equal =
                if LLVM_TYPES.is_floating(left.type) then
                    compare.binary(
                        LLVM.BinaryOperator.OR,
                        LLVM.IntegerFlags.NONE,
                        compare.compare(LLVM.FloatPredicate.OEQ, left, right),
                        compare.binary(
                            LLVM.BinaryOperator.AND,
                            LLVM.IntegerFlags.NONE,
                            compare.compare(LLVM.FloatPredicate.UNO, left, left),
                            compare.compare(LLVM.FloatPredicate.UNO, right, right)))
                else
                    compare.compare(LLVM.IntegerPredicate.EQ, left, right)
                fi

            compare.return_value(_as_result(compare, equal, root_equals.result))
            different.return_value(_as_result(different, Values.boolean(false), root_equals.result))

            _module.add_function(function)

            _box_equalities[type] = function

            return function
        si

        // `value`, an `i1`, as a function returning `result` returns a bool.
        _as_result(block: LLVM.BLOCK, value: LLVM.Value, result: LLVM.Type) -> LLVM.Value =>
            if result =~ Types.i1 then value else block.convert(LLVM.Conversion.ZERO_EXTEND, value, result) fi

        root: CLASS_INSTANCE? => _classes.root
        numbering: CLASS_ID_NUMBERING[CLASS_INSTANCE] => _classes.numbering
        superclass_of(type: CLASS_INSTANCE) -> CLASS_INSTANCE? => _classes.superclass_of(type)
        /// Gives `owner` a method that no symbol of it declares, which dispatch
        /// reaches as it reaches the methods `owner` declares.
        add_method(owner: Classy, method: Function) is
            if !_added_methods.contains_key(owner) then
                _added_methods[owner] = LIST[Function]()
            fi

            _added_methods[owner].add(method)
        si

        /// The methods `definition` has: those it declares, then any it was
        /// given.
        methods_of(definition: Classy) -> Collections.List[Function] is
            let declared: Collections.List[Function] mut

            if !_declared_methods.try_get_value(definition, declared ref) then
                declared = SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(definition))
                _declared_methods[definition] = declared
            fi

            let added: LIST[Function] mut

            if !_added_methods.try_get_value(definition, added ref) then
                return declared
            fi

            let result = LIST[Function](declared)

            result.add_range(added)

            return result
        si
        is_object(type: CLASS_INSTANCE) -> bool => type == _classes.root
        is_object_type(type: CLASS_INSTANCE) -> bool => !_classes.is_box(type) /\ _classes.is_object_type(type.definition)
        is_box(type: CLASS_INSTANCE) -> bool => _classes.is_box(type)
        is_array(type: CLASS_INSTANCE) -> bool => _classes.is_array(type)

        /// Whether `type` is the string type.
        is_string(type: CLASS_INSTANCE) -> bool => _string? /\ type == _string

        /// Whether the program has a string type, whose descriptor this adds.
        has_string_type: bool => _string?

        is_bigint(type: CLASS_INSTANCE) -> bool => type.definition == _classes.core.bigint

        /// The element type of the array type `type`.
        array_element(type: CLASS_INSTANCE) -> Type => _classes.array_element(type)

        /// The core library's display state class, where the program renders
        /// values for display.
        display_state: CLASS_INSTANCE? => _display_state

        /// Records that the program renders values for display, through
        /// the core library's state class `state`.
        note_display(state: CLASS_INSTANCE) is
            _display_state = state
        si

        /// Records `displayer` as the function that writes a value of
        /// `type` for display, which its descriptor holds.
        set_displayer(type: CLASS_INSTANCE, displayer: LLVM.FUNCTION) is
            _displayers[type] = displayer
        si

        _displayer_reference(type: CLASS_INSTANCE) -> LLVM.Value is
            let displayer: LLVM.FUNCTION mut

            if _displayers.try_get_value(type, displayer ref) then
                return displayer.reference
            fi

            return Values.null_pointer
        si

        /// Whether a value of `type` can exist: a box only where something
        /// boxes a value in it.
        is_instantiated(type: CLASS_INSTANCE) -> bool => !_classes.is_box(type) \/ _boxes_made.contains(type)

        // Whether a value of `type` can exist in the program: discovery found it
        // instantiated. A vtable or trait table entry a call can reach must be
        // compiled exactly where this holds, so both tables ask it.
        _can_exist(type: CLASS_INSTANCE) -> bool => _found_instantiated.contains(type) /\ is_instantiated(type)

        // Every receiver is a `ptr`, so a slot or a row needs no signature
        // of its own: the call site gives the function type.
        slot_signature(owner: CLASS_INSTANCE, method: FUNCTION_INSTANCE) -> int? => 0
        selector_signature(method: FUNCTION_INSTANCE) -> int? => 0
    si
si
