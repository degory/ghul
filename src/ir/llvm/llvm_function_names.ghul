namespace IR.LLVMTarget is
    use IR.Program

    use Collections.MAP
    use Collections.SET

    /// The name each function instance is written with in an LLVM module.
    ///
    /// The instance is the identity: two instances are the same function
    /// exactly when they compare equal, whatever they are called. The name
    /// is a readable label built from the instance's qualified name and
    /// type arguments, with a numeric suffix where an earlier instance
    /// already holds that label.
    class LLVM_FUNCTION_NAMES is
        _names: MAP[FUNCTION_INSTANCE, string]
        _taken: SET[string]

        init() is
            _names = MAP[FUNCTION_INSTANCE, string]()
            _taken = SET[string]()
        si

        /// Keeps `name` from being given to any instance, for a function the
        /// module declares for itself.
        reserve(name: string) is
            _taken.add(name)
        si

        /// The name of `instance`, chosen the first time it is asked for.
        name_of(instance: FUNCTION_INSTANCE) -> string is
            let name mut = ""

            if _names.try_get_value(instance, name ref) then
                return name
            fi

            let label = _label(instance)

            name = label

            let suffix mut = 1

            while !_taken.add(name) do
                name = "{label}.{suffix}"
                suffix = suffix + 1
            od

            _names[instance] = name

            return name
        si

        // The runtime's names start with `$`, which no ghūl identifier
        // can, so a label never clashes with one. A root namespace named
        // `llvm`, whose functions' labels would fall among LLVM's intrinsic
        // names, is reported by the front end; a type named `llvm` outside
        // any namespace is not reported.
        _label(instance: FUNCTION_INSTANCE) -> string => instance.to_string()
    si
si
