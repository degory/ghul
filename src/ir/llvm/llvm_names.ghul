namespace IR.LLVMTarget is
    use IR.Program

    use Collections.MAP
    use Collections.SET

    use Semantic.Symbols.Function
    use Semantic.Symbols.FRAME
    use Semantic.Symbols.ScopedWithEnclosingScope
    use Semantic.Symbols.Symbol

    /// The names functions and globals are written with in an LLVM module.
    ///
    /// Each name is a readable label for what it stands for: a function's
    /// qualified name and type arguments, a type's descriptor as the type's
    /// name with `.$descriptor` after it, and so on. Where an earlier name
    /// already holds a label, a numeric suffix tells them apart. Names are
    /// given in the order they are asked for, so a program is named the
    /// same way every time it is compiled.
    ///
    /// A part the compiler adds starts with `$`, which no ghūl identifier
    /// can, so a label never clashes with a declared name. Only the names
    /// the runtime library itself defines or expects start `$ghul_`.
    class LLVM_NAMES is
        _names: MAP[FUNCTION_INSTANCE, string]
        _taken: SET[string]

        init() is
            _names = MAP[FUNCTION_INSTANCE, string]()
            _taken = SET[string]()
        si

        /// Keeps `name` from being given to anything else, for a name the
        /// module declares for itself.
        ///
        /// - name: the name to keep
        reserve(name: string) is
            _taken.add(name)
        si

        /// The name of the function `instance`, chosen the first time it is
        /// asked for.
        ///
        /// - instance: the function instance to name
        name_of(instance: FUNCTION_INSTANCE) -> string is
            let name mut = ""

            if _names.try_get_value(instance, name ref) then
                return name
            fi

            name = unique(label(instance))

            _names[instance] = name

            return name
        si

        /// A name no earlier one holds: `label` itself, or `label` with the
        /// first numeric suffix that is free.
        ///
        /// - label: what the name should read as
        unique(label: string) -> string is
            let name mut = label
            let suffix mut = 1

            while !_taken.add(name) do
                name = "{label}.{suffix}"
                suffix = suffix + 1
            od

            return name
        si

        /// The label of the function `instance`, without giving it a name.
        ///
        /// - instance: the function instance to label
        label(instance: FUNCTION_INSTANCE) -> string =>
            if instance.type_map.count == 0 then
                function_label(instance.definition)
            else
                "{function_label(instance.definition)}[{instance.type_map.values |> Ghul.Pipes.join(",")}]"
            fi

        /// The label of the class instance `type`.
        ///
        /// - type: the class instance to label
        type_label(type: CLASS_INSTANCE) -> string is
            let name =
                if let frame: FRAME = type.definition then
                    frame_label(frame)
                else
                    type.definition.qualified_name
                fi

            return if type.arguments.count == 0 then name else "{name}[{type.arguments |> Ghul.Pipes.join(",")}]" fi
        si

        // A function literal has no name of its own, so it and the frame
        // holding what it captures are labelled after the function it is
        // written in. A function a frame declares is labelled after the frame.
        function_label(definition: Function) -> string =>
            if definition.is_closure then
                "{_enclosing_label(definition)}.$closure"
            elif let frame: FRAME = definition.owner then
                "{frame_label(frame)}.{definition.name}"
            else
                definition.qualified_name
            fi

        frame_label(frame: FRAME) -> string => "{_enclosing_label(frame.closure)}.$frame"

        // The label of the function a literal is written in, through any
        // block or literal it is nested in; at namespace scope, the
        // namespace's name.
        _enclosing_label(literal: Function) -> string is
            let scope: Semantic.Scope? mut = literal.enclosing_scope

            while scope? do
                if let function: Function = scope /\ !function.is_closure then
                    return function_label(function)
                elif let block: Semantic.BLOCK_SCOPE = scope then
                    scope = block.enclosing
                elif let scoped: ScopedWithEnclosingScope = scope then
                    scope = scoped.enclosing_scope
                elif let symbol: Symbol = scope then
                    return symbol.qualified_name
                else
                    scope = null
                fi
            od

            return "$global"
        si
    si
si
