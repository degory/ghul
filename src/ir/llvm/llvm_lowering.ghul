namespace IR.LLVMTarget is
    use IR.Program

    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Function

    use LLVM.BinaryOperator
    use LLVM.BLOCK
    use LLVM.Conversion
    use LLVM.FloatPredicate
    use LLVM.FUNCTION
    use LLVM.IntegerFlags
    use LLVM.IntegerPredicate
    use LLVM.Intrinsics
    use LLVM.MODULE
    use LLVM.Types
    use LLVM.FastMath

    use Values.Value

    /// Lowers the IR values of one function body into the blocks of an
    /// LLVM function. A construct it cannot lower yet is recorded in
    /// `unsupported` rather than thrown.
    ///
    /// Every local, argument and temporary lives in an `alloca` in the entry
    /// block, which LLVM promotes to registers, so nothing here builds SSA
    /// form. The values the IR leaves on CIL's evaluation stack are kept on
    /// a stack of LLVM values while the body is lowered.
    class LLVM_LOWERING: Values.Visitor is
        _module: MODULE
        _function: FUNCTION
        _instance: FUNCTION_INSTANCE?
        _type_map: Collections.Map[Semantic.Symbols.Symbol, Type]
        _return_type: Type?
        _callee: (FUNCTION_INSTANCE) -> FUNCTION?
        _scalars: (Type?) -> Scalar?
        _is_string: (Type?) -> bool
        _strings: LLVM_STRINGS?
        _arrays: LLVM_ARRAYS?
        _objects: LLVM_OBJECTS?
        _receiver_offset: int

        _entry: BLOCK
        _block: BLOCK
        _is_terminated: bool
        _next_block: int

        _stack: LIST[LLVM.Value]
        _locals: MAP[LOCAL, (pointer: LLVM.Value, type: LLVM.Type)]
        _arguments: LIST[(pointer: LLVM.Value, type: LLVM.Type)]

        // The structured nodes open at the point being lowered, innermost
        // last: each node's continuation, and a loop's header after it, which
        // is where a CONTINUE goes. A region that produces a value has an
        // `alloca` each arm stores it into, and `depth` is how deep the value
        // stack was when the node began.
        _labels: LIST[(node: Values.Breakable, is_loop_head: bool, target: BLOCK, result: LLVM.Value?, depth: int)]

        _unsupported: LIST[string]

        /// The kinds of construct the lowered values used that this target
        /// cannot generate yet, each once, in the order they were met. A body
        /// with any is not a valid function.
        unsupported: Collections.List[string] => _unsupported

        /// - module: where intrinsics the body calls are declared
        /// - function: the function the body is lowered into, with no blocks yet
        /// - instance: the function instance the body belongs to, or null where it belongs to none
        /// - return_type: the type the function returns
        /// - callee: the LLVM function a call to an instance names, or null where it cannot be called
        /// - strings: where string literals and the runtime's functions are declared, or null where strings are not lowered
        /// - arrays: where array descriptors are declared, or null where arrays are not lowered
        /// - objects: the program's classes, or null where objects are not lowered
        init(
            module: MODULE,
            function: FUNCTION,
            instance: FUNCTION_INSTANCE?,
            return_type: Type?,
            callee: (FUNCTION_INSTANCE) -> FUNCTION?,
            strings: LLVM_STRINGS?,
            arrays: LLVM_ARRAYS?,
            objects: LLVM_OBJECTS?
        ) is
            self.init(module, function, instance, return_type, callee, strings, arrays, objects, t => LLVM_TYPES.scalar(t), t => LLVM_TYPES.is_string(t))
        si

        /// - module: where intrinsics the body calls are declared
        /// - function: the function the body is lowered into, with no blocks yet
        /// - instance: the function instance the body belongs to, or null where it belongs to none
        /// - return_type: the type the function returns
        /// - callee: the LLVM function a call to an instance names, or null where it cannot be called
        /// - strings: where string literals and the runtime's functions are declared, or null where strings are not lowered
        /// - arrays: where array descriptors are declared, or null where arrays are not lowered
        /// - objects: the program's classes, or null where objects are not lowered
        /// - scalars: the scalar kind a value of a type is, or null where it is not a scalar
        /// - is_string: whether a type is `string`
        init(
            module: MODULE,
            function: FUNCTION,
            instance: FUNCTION_INSTANCE?,
            return_type: Type?,
            callee: (FUNCTION_INSTANCE) -> FUNCTION?,
            strings: LLVM_STRINGS?,
            arrays: LLVM_ARRAYS?,
            objects: LLVM_OBJECTS?,
            scalars: (Type?) -> Scalar?,
            is_string: (Type?) -> bool
        ) is
            _strings = strings
            _arrays = arrays
            _objects = objects
            _receiver_offset = if instance?.definition?.is_emitted_with_receiver ?? false then 1 else 0 fi
            _scalars = scalars
            _is_string = is_string
            _module = module
            _function = function
            _instance = instance
            _type_map = if let i = instance then i.type_map else MAP[Semantic.Symbols.Symbol, Type]() fi
            _return_type = return_type
            _callee = callee

            _stack = LIST[LLVM.Value]()
            _locals = MAP[LOCAL, (pointer: LLVM.Value, type: LLVM.Type)]()
            _arguments = LIST[(pointer: LLVM.Value, type: LLVM.Type)]()
            _labels = LIST[(node: Values.Breakable, is_loop_head: bool, target: BLOCK, result: LLVM.Value?, depth: int)]()
            _unsupported = LIST[string]()

            _entry = function.add_block("entry")
            _block = _entry
        si

        /// Lowers the body into the function. Afterwards every block ends in
        /// exactly one terminator.
        lower(values: Collections.Iterable[Value]) is
            for parameter in _function.parameters do
                let pointer = _entry.alloca(parameter.type, 0)

                _entry.store(parameter.value, pointer, 0)
                _arguments.add((pointer, parameter.type))
            od

            let start = _new_block()

            _start(start)

            for value in values do
                gen(value)
            od

            // A body that falls off its end returns what it leaves, or the
            // default value of its result where it leaves nothing.
            if !_is_terminated then
                _return()
            fi

            _entry.branch(start)
        si

        /// Lowers one value. An absent value lowers to nothing.
        gen(value: Value?) is
            if value? then
                value.accept(self)
            fi
        si

        _report(construct: string) is
            if !_unsupported.contains(construct) then
                _unsupported.add(construct)
            fi
        si

        _specialize(type: Type?) -> Type? => TYPE_MAPS.specialize(type, _type_map)

        _scalar_of(type: Type?) -> Scalar? => _scalars(type)

        _scalar(type: Type?) -> Scalar? => _scalar_of(_specialize(type))

        _held(type: Type?) -> LLVM.Type? =>
            if let scalar = _scalar(type) then
                LLVM_TYPES.value_type(scalar)
            elif _is_string(_specialize(type)) \/ LLVM_TYPES.is_array(_specialize(type)) \/ LLVM_TYPES.is_object_reference(_specialize(type)) then
                Types.pointer
            else
                null
            fi

        // The block instructions go into, opened afresh where the last one
        // ended in a terminator: code after an unconditional exit is
        // unreachable, but every block needs exactly one terminator.
        _current: BLOCK is
            if _is_terminated then
                _start(_new_block())
            fi

            return _block
        si

        _new_block() -> BLOCK is
            let block = _function.add_block("b{_next_block}")

            _next_block = _next_block + 1

            return block
        si

        _start(block: BLOCK) is
            _block = block
            _is_terminated = false
        si

        _branch(target: BLOCK) is
            _current.branch(target)
            _is_terminated = true
        si

        _push(value: LLVM.Value) is
            _stack.add(value)
        si

        _pop() -> LLVM.Value? is
            if _stack.count == 0 then
                _report("a value the lowering did not produce")
                return null
            fi

            let value = _stack[_stack.count - 1]

            _stack.remove_at(_stack.count - 1)

            return value
        si

        _peek() -> LLVM.Value? =>
            if _stack.count > 0 then _stack[_stack.count - 1] else null fi

        // Lowers `value` and takes what it produces off the stack.
        _value_of(value: Value) -> LLVM.Value? is
            let depth = _stack.count

            gen(value)

            if _stack.count <= depth then
                if _unsupported.count == 0 then
                    _report("a value that produces nothing")
                fi

                return null
            fi

            return _pop()
        si

        // An `alloca` in the entry block, holding the zero of `type` from the
        // start, as a .NET local holds a zeroed value.
        _slot(type: LLVM.Type) -> LLVM.Value is
            let pointer = _entry.alloca(type, 0)

            _entry.store(LLVM_TYPES.zero(type), pointer, 0)

            return pointer
        si

        _local(local: LOCAL) -> (pointer: LLVM.Value, type: LLVM.Type)? is
            let found: (pointer: LLVM.Value, type: LLVM.Type) mut

            if _locals.try_get_value(local, found ref) then
                return found
            fi

            if let type = _held(local.type) then
                let slot = (pointer = _slot(type), type = type)

                _locals[local] = slot

                return slot
            fi

            _report("a local of type {local.type}")

            return null
        si

        _load_local(local: LOCAL) is
            if let (pointer, type) = _local(local) then
                _push(_current.load(type, pointer, 0))
            fi
        si

        _store_local(local: LOCAL, value: LLVM.Value?) is
            if let (pointer, type) = _local(local) /\ value? then
                _current.store(_normalise_for(value, local.type), pointer, 0)
            fi
        si

        // The position of the parameter `symbol` among the arguments of the
        // function being lowered, or null where it belongs to another.
        _argument_index(symbol: Semantic.Symbols.Symbol) -> int? is
            if let instance = _instance /\ symbol.owner == instance.definition then
                let names = instance.definition.argument_names

                for i in 0..names.count do
                    if names[i] =~ symbol.name then
                        return i + _receiver_offset
                    fi
                od
            fi

            return null
        si

        _load_argument(index: int) is
            if index < _arguments.count then
                let (pointer, type) = _arguments[index]

                _push(_current.load(type, pointer, 0))
            else
                _report("an argument the function does not take")
            fi
        si

        _store_argument(index: int, value: LLVM.Value?, type: Type?) is
            if index < _arguments.count /\ value? then
                let (pointer, _) = _arguments[index]

                _current.store(_normalise_for(value, type), pointer, 0)
            else
                _report("an argument the function does not take")
            fi
        si

        // Returns the value on the stack, or the default value of the result
        // where the stack is empty.
        _return() is
            if LLVM_TYPES.is_void(_return_type) then
                _current.return_void()
            elif let type = _held(_return_type) then
                let value = if _stack.count > 0 then _pop()! else LLVM_TYPES.zero(type) fi

                _current.return_value(_normalise_for(value, _return_type))
            else
                _report("a result of type {_return_type}")
                _current.unreachable()
            fi

            _is_terminated = true
        si

        // Brings a value of a narrow kind back into its range: sign-extended
        // for a signed kind and masked for an unsigned one, which is what
        // CIL's narrowing conversions and narrow stores do.
        _normalise(value: LLVM.Value, scalar: Scalar) -> LLVM.Value =>
            case scalar
            when Scalar.INT8 then _sign_extend_from(value, 8)
            when Scalar.INT16 then _sign_extend_from(value, 16)
            when Scalar.UINT8, Scalar.BOOL then _current.binary(BinaryOperator.AND, IntegerFlags.NONE, value, _i32(0xFF))
            when Scalar.UINT16, Scalar.CHAR then _current.binary(BinaryOperator.AND, IntegerFlags.NONE, value, _i32(0xFFFF))
            else value
            esac

        _sign_extend_from(value: LLVM.Value, width: int) -> LLVM.Value =>
            _current.convert(
                Conversion.SIGN_EXTEND,
                _current.convert(Conversion.TRUNCATE, value, LLVM.Type.INTEGER(width)),
                Types.i32)

        _normalise_for(value: LLVM.Value, type: Type?) -> LLVM.Value =>
            if let scalar = _scalar(type) /\ LLVM_TYPES.is_narrow(scalar) then
                _normalise(value, scalar)
            else
                value
            fi

        _i32(value: int) -> LLVM.Value => LLVM.Values.integer(Types.i32, bigint(value))

        // A comparison's `i1` widened to the `i32` a bool is held in.
        _bool(value: LLVM.Value) -> LLVM.Value =>
            _current.convert(Conversion.ZERO_EXTEND, value, Types.i32)

        visit_value(value: Value) is
            _report("{value.get_type().name}")
        si

        visit_address_of_value(value: Value) is
            _report("the address of {value.get_type().name}")
        si

        visit(number: Values.Literal.NUMBER) is
            let (value, from) =
                case number.constant
                when i4: Values.Literal.CONSTANT.I4 then (LLVM.Values.integer(Types.i32, bigint(i4.value)), Scalar.INT32)
                when i8: Values.Literal.CONSTANT.I8 then (LLVM.Values.integer(Types.i64, bigint(i8.value)), Scalar.INT64)
                when r4: Values.Literal.CONSTANT.R4 then (LLVM.Values.of_single(r4.value), Scalar.FLOAT32)
                when r8: Values.Literal.CONSTANT.R8 then (LLVM.Values.of_double(r8.value), Scalar.FLOAT64)
                esac

            if let to = number.narrowing then
                _push(_convert(value, from, to))
            else
                _push(value)
            fi
        si

        visit(string: Values.Literal.STRING) is
            if let strings = _strings then
                _push(strings.literal(string.value))
            else
                _report("a string literal")
            fi
        si
        visit(decimal: Values.Literal.DECIMAL) is _report("a decimal literal") si
        visit(bigint: Values.Literal.BIGINT) is _report("a bigint literal") si

        visit(load: Values.Load.SYMBOL) is _report("a load of {load.symbol.name}") si
        visit_address(load: Values.Load.SYMBOL) is _report("the address of {load.symbol.name}") si
        visit_address(load: Values.Load.INSTANCE_FIELD) is _report("the address of a field") si
        visit(load: Values.Load.STATIC_ANONYMOUS_FUNCTION) is _report("a function value") si
        visit(load: Values.Load.GLOBAL_ANONYMOUS_FUNCTION) is _report("a function value") si
        visit(load: Values.Load.INSTANCE_ANONYMOUS_FUNCTION) is _report("a function value") si

        visit(load: Values.Load.TEMP) is
            _load_local(load.local)
        si

        visit_address(load: Values.Load.TEMP) is _report("the address of a local") si
        visit_address(load: Values.Load.STATIC_FIELD) is _report("the address of a static field") si
        visit_address(load: Values.Load.GLOBAL_FIELD) is _report("the address of a global variable") si

        visit(load: Values.Load.LOCAL_ARGUMENT) is
            let symbol = load.symbol

            if Values.state_machine_field_for(symbol)? then
                _report("a generator or asynchronous function")
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _load_local(packed_local)
            elif let index = _argument_index(symbol) then
                _load_argument(index)
            else
                _report("an argument of another function")
            fi
        si

        visit_address(load: Values.Load.LOCAL_ARGUMENT) is _report("the address of an argument") si

        visit(load: Values.Load.LOCAL_VARIABLE) is
            if Values.state_machine_field_for(load.symbol)? then
                _report("a generator or asynchronous function")
            elif let variable = cast Semantic.Symbols.Variable?(load.symbol) then
                _load_local(variable.ir_local)
            else
                _report("a load of {load.symbol.name}")
            fi
        si

        visit_address(load: Values.Load.LOCAL_VARIABLE) is _report("the address of a local") si

        visit(load: Values.Load.ARGUMENT) is
            _load_argument(load.index + _receiver_offset)
        si


        /// A composite value's structured expansion is lowered as any other
        /// structured IR is.
        visit(composite: Values.Composite) is
            for value in composite.expand().values do
                gen(value)
            od
        si

        visit_address(coalesce: Values.COALESCE_LOAD) is _report("the address of a coalesced load") si

        visit(launch: Values.ASYNC_METHOD_LAUNCH) is _report("an asynchronous function") si
        visit(completion: Values.ASYNC_COMPLETION) is _report("an asynchronous function") si
        visit(completed: Values.COMPLETED_TASK_LIKE) is _report("an asynchronous function") si
        visit(suspend: Values.AWAIT_SUSPEND) is _report("an await") si
        visit(step: Values.AWAIT_SUSPEND_STEP) is _report("an await") si

        visit(max_stack: Values.MAX_STACK) is si
        visit(construct: Values.CONSTRUCT_MAYBE) is _report("an optional value") si

        // The value is already on the stack, where whatever reads it finds it.
        visit(stack_top: Values.STACK_TOP) is si
        visit(stack_top: Values.STACK_TOP_ADDRESS) is _report("the address of a value") si
        visit_address(stack_top: Values.STACK_TOP_ADDRESS) is _report("the address of a value") si

        /// A block lowers each of its values in turn. One that produces a
        /// value and ends in a region produces it through that region.
        visit(block: Values.BLOCK) is
            let values = block.values

            for i in 0..values.count do
                let value = values[i]

                if i == values.count - 1 /\ _produces_value(block) /\ isa Values.REGION(value) then
                    let result = _held(block.type)

                    if !result? then
                        _report("a value of type {block.type}")
                    fi

                    _lower_region(cast Values.REGION(value), result)
                else
                    gen(value)
                fi
            od
        si

        // A body every path out of which diverges, by a throw or a return,
        // is typed as an error, and produces no value.
        _produces_value(block: Values.BLOCK) -> bool =>
            !LLVM_TYPES.is_void(block.type) /\ !(block.type?.is_error ?? false)

        visit(block: Values.DUMMY_BLOCK) is
            throw System.InvalidOperationException("dummy block generated, created at: {block.location} because: {block.why}")
        si

        visit_address(self_load: Values.Load.REFERENCE_SELF) is _report("self") si
        visit(self_load: Values.Load.OUTER_SELF) is _report("self") si
        visit_address(self_load: Values.Load.OUTER_SELF) is _report("self") si
        visit(self_load: Values.Load.VALUE_SELF) is _report("self") si
        visit_address(self_load: Values.Load.VALUE_SELF) is _report("self") si
        /// An object is allocated whole where it is constructed, so there
        /// is nothing for its constructor to initialise first, and a program
        /// runs on one thread.
        visit(runtime: Values.RUNTIME) is
            if runtime.operation == IR.RuntimeOperation.INIT_OBJECT then
                return
            elif runtime.operation == IR.RuntimeOperation.CURRENT_THREAD_ID then
                _push(_i32(0))
            else
                _report("the runtime operation {runtime.operation}")
            fi
        si
        visit(creation: Values.CREATE_UNIT_VARIANT_INSTANCE) is _report("a union") si

        visit(dummy: Values.DUMMY) is _report("a placeholder value") si
        visit(type_expression: Values.TYPE_EXPRESSION) is _report("a type used as a value") si
        visit(store: Values.Need.STORE) is _report("an indirect store") si
        visit(store: Values.Store.INDIRECT) is _report("an indirect store") si
        visit(wrapper: Values.TYPE_WRAPPER) is gen(wrapper.value) si
        visit_address(wrapper: Values.TYPE_WRAPPER) is _report("the address of a value") si
        visit(wrapper: Values.WRAPPER) is
            assert wrapper.value? else "generate wrapper without value"

            gen(wrapper.value)
        si
        visit_address(wrapper: Values.WRAPPER) is _report("the address of a value") si
        visit(wrap: Values.WRAP_OPTIONAL) is _report("an optional value") si
        visit(projection: Values.NARROW_PROJECT) is _report("a narrowed value") si
        visit(view: Values.NARROW_VIEW) is _report("a narrowed value") si
        visit_address(view: Values.NARROW_VIEW) is _report("the address of a value") si
        visit(enter: Values.ENTER_FILE) is si
        visit(leave: Values.LEAVE_FILE) is si
        visit(closure: Values.MAKE_CLOSURE) is _report("a function value") si

        visit(address: Values.ARRAY_ELEMENT_ADDRESS) is _report("the address of an array element") si
        visit_address(address: Values.ARRAY_ELEMENT_ADDRESS) is _report("the address of an array element") si

        visit(array: Values.NEW_ARRAY) is
            _new_array(array.type, array.count)
        si

        visit(store: Values.STORE_ARRAY_ELEMENT) is
            _store_array_element(store.array, store.index, store.element)
        si

        visit(sequence: Values.SEQUENCE) is
            let type = _array_of(sequence.type)

            if !type? then
                return
            fi

            let arrays = _arrays!
            let result = arrays.allocate(_current, type, _i32(sequence.values.count))

            for (i, value) in sequence.values |> Ghul.Pipes.index() do
                if let element = _value_of(value) then
                    arrays.store(_current, type, result, _i32(i), _normalise_for(element, sequence.element_type))
                else
                    return
                fi
            od

            _push(result)
        si

        // The array type a value of `type` is, or null, reported, where the
        // target holds no arrays of its element type.
        _array_of(type: Type?) -> CLASS_INSTANCE? is
            if let arrays = _arrays, array = arrays.array_of(_specialize(type)) then
                return array
            fi

            _report("an array of type {type}")

            return null
        si

        _new_array(array_type: Type?, count: Value) is
            if let type = _array_of(array_type), length = _value_of(count) then
                _push(_arrays!.allocate(_current, type, length))
            fi
        si

        _store_array_element(array_value: Value, index_value: Value, element_value: Value) is
            if let type = _array_of(array_value.type),
                array = _value_of(array_value),
                index = _value_of(index_value),
                element = _value_of(element_value)
            then
                let arrays = _arrays!

                _check_index(array, index)

                arrays.store(_current, type, array, index, _normalise_for(element, arrays.element_of(type)))
            fi
        si

        // Throws where `index` is outside the array `array` points at, an
        // unsigned comparison catching a negative index too. Until the target
        // has exception objects, what is thrown carries no type or message.
        _check_index(array: LLVM.Value, index: LLVM.Value) is
            let in_range = _current.compare(IntegerPredicate.ULT, index, _arrays!.count(_current, array))

            let outside = _new_block()
            let inside = _new_block()

            _current.branch(in_range, inside, outside)

            _start(outside)

            _current.call(_strings!.runtime("$ghul_throw", LLVM.Type.VOID, [Types.pointer]), [LLVM.Values.null_pointer])
            _current.unreachable()

            _start(inside)
        si

        // The built-in array operation a call to `function` performs, or
        // null where it performs none.
        _array_operation(function: Function) -> string? is
            if let operation = cast Function?(function.root_specialized_from)?.intrinsic_operation /\ operation.starts_with("array.") then
                return operation
            fi

            return null
        si

        visit(compare: Values.COMPARE_ORDER_TO_ZERO) is
            if let value = _value_of(compare.value) then
                _push(_bool(_compare(compare.comparison, value, _i32(0), false)))
            fi
        si

        visit(receiver: Values.CONSTRAINED) is _report("a constrained call") si
        visit(arithmetic: Values.DECIMAL_ARITHMETIC) is _report("decimal arithmetic") si
        visit(compare: Values.DECIMAL_COMPARE) is _report("decimal arithmetic") si
        visit(convert: Values.DECIMAL_CONVERT) is _report("a decimal conversion") si
        visit(equality: Values.EQUALITY_COMPARISON) is _report("an equality comparison") si
        /// A reference optional is present where it is not null. A value-type
        /// optional is not lowered yet.
        visit(test: Values.HAS_VALUE) is
            if let value = _value_of(test.value) then
                if value.type =~ Types.pointer then
                    _push(_bool(_current.compare(IntegerPredicate.NE, value, LLVM.Values.null_pointer)))
                else
                    _report("an optional value of type {test.value.type}")
                fi
            fi
        si

        visit(conversion: Values.SCALAR_CONVERSION) is
            gen(conversion.converted)
        si

        visit(declaration: Values.DECLARE_LOCAL) is
            _local(declaration.local)
        si

        visit(store: Values.STORE_TEMP) is
            _store_local(store.local, _pop())
        si

        visit(tee: Values.TEE_TEMP) is
            if let value = _value_of(tee.value) then
                let held = _normalise_for(value, tee.local.type)

                _store_local(tee.local, held)
                _push(held)
            fi
        si

        visit(discard: Values.DISCARD) is
            if let value = discard.value then
                let depth = _stack.count

                gen(value)

                while _stack.count > depth do
                    _pop()
                od
            else
                _pop()
            fi
        si

        visit(thrown: Values.THROW) is _report("a throw") si

        visit(ret: Values.RET) is
            _return()
        si

        visit(default_return: Values.DEFAULT_RETURN) is
            _default(default_return.type)
        si

        visit(default_value: Values.DEFAULT) is
            _default(default_value.type)
        si

        _default(type: Type?) is
            if LLVM_TYPES.is_void(type) then
                return
            elif let value_type = _held(type) then
                _push(LLVM_TYPES.zero(value_type))
            else
                _report("the default value of {type}")
            fi
        si

        visit_address(default_value: Values.DEFAULT) is _report("the address of a value") si
        visit(deref: Values.DEREF) is _report("a reference") si
        visit_address(deref: Values.DEREF) is _report("a reference") si
        visit(address: Values.ADDRESS) is _report("a reference") si
        visit_address(address: Values.ADDRESS) is _report("a reference") si
        visit(steps: Values.STEPS) is _report("a range") si
        visit(decrement: Values.DECREMENT) is _report("a decrement") si
        visit(increment: Values.POST_INCREMENT) is _report("an increment") si
        visit(decrement: Values.PRE_DECREMENT) is _report("a decrement") si
        visit(repack: Values.TUPLE_REPACK) is _report("a tuple") si
        visit(spilled: Values.SPILLED_SUBJECT) is _report("a spilled value") si

        visit(null_value: Values.NULL) is
            _push(LLVM.Values.null_pointer)
        si
        /// A scalar is boxed in an object carrying its box's descriptor, so a
        /// boxed int and a boxed long answer type tests differently. A
        /// reference needs no box.
        visit(box: Values.BOX) is
            let value = box.value

            if let objects = _objects, box_type = objects.box_type(_specialize(value.type)) then
                objects.note_boxed(box_type)

                if let held = _value_of(value) then
                    let object =
                        _current.call(
                            _strings!.runtime("$ghul_alloc_atomic", Types.pointer, [Types.pointer, Types.i64]),
                            [LLVM.Values.global(objects.descriptor_name(box_type)), LLVM.Values.i64(cast long(objects.size_of(box_type)))])!

                    _current.store(_normalise_for(held, value.type), _current.element_pointer(objects.struct_type(box_type), object, [_i32(0), _i32(1)], true), 0)

                    _push(object)
                fi
            elif let held = _held(value.type) /\ isa LLVM.Type.POINTER(held) then
                gen(value)
            else
                _report("boxing a {value.type}")
            fi
        si

        /// A null, or a box of another type, throws, as .NET does.
        visit(unbox: Values.UNBOX) is _unbox(unbox.value, unbox.type) si

        _unbox(value: Value, type: Type?) is
            let objects = _objects
            let box_type = if let o = objects then o.box_type(_specialize(type)) else null fi
            let held = _held(type)

            if !objects? \/ !box_type? \/ !held? then
                _report("unboxing a {type}")
                return
            fi

            if let object = _value_of(value) then
                let range = LIST[(first: int, last: int)]()

                range.add(objects.class_range(box_type))

                let id = _class_id(object)

                _throw_if(_current.compare(IntegerPredicate.EQ, _in_ranges(id, range), LLVM.Values.boolean(false)))

                _push(_current.load(held, _current.element_pointer(objects.struct_type(box_type), object, [_i32(0), _i32(1)], true), 0))
            fi
        si
        visit(type_of: Values.TYPEOF) is _report("typeof") si
        visit(tuple: Values.TUPLE) is _report("a tuple") si

        visit(negation: Values.NOT) is
            if let value = _value_of(negation.value) then
                _push(_bool(_current.compare(IntegerPredicate.EQ, value, LLVM_TYPES.zero(value.type))))
            fi
        si

        visit(arithmetic: Values.ARITHMETIC) is
            let type = _specialize(arithmetic.type)
            let held = if let scalar = _scalar_of(type) then LLVM_TYPES.value_type(scalar) else null fi

            if !held? then
                _report("arithmetic on {arithmetic.type}")
                return
            fi

            let operation = arithmetic.operation
            let is_floating = LLVM_TYPES.is_floating(held)

            let result =
                if operation == ArithmeticOperation.NEGATE then
                    _negate(arithmetic.operands[0], is_floating)
                elif operation == ArithmeticOperation.COMPLEMENT then
                    _complement(arithmetic.operands[0], is_floating)
                elif _is_shift(operation) then
                    _shift(operation, arithmetic.operands[0], arithmetic.operands[1], held, _scalar_of(type))
                else
                    _binary(operation, arithmetic.operands[0], arithmetic.operands[1], is_floating)
                fi

            if !result? then
                return
            fi

            // A narrow kind's arithmetic runs at 32 bits, so its result is
            // wrapped back to the kind's width as CIL's narrow stores do.
            if let scalar = _scalar_of(type) /\ LLVM_TYPES.is_narrow(scalar) then
                _push(_normalise(result, scalar))
            else
                _push(result)
            fi
        si

        _is_shift(operation: ArithmeticOperation) -> bool =>
            operation == ArithmeticOperation.SHIFT_LEFT \/
            operation == ArithmeticOperation.SHIFT_RIGHT \/
            operation == ArithmeticOperation.SHIFT_RIGHT_UNSIGNED

        _negate(operand: Value, is_floating: bool) -> LLVM.Value? is
            if let value = _value_of(operand) then
                if is_floating then
                    return _current.negate(value)
                fi

                return _current.binary(BinaryOperator.SUB, IntegerFlags.NONE, LLVM_TYPES.zero(value.type), value)
            fi

            return null
        si

        _complement(operand: Value, is_floating: bool) -> LLVM.Value? is
            if is_floating then
                _report("complement of a floating point value")
                return null
            fi

            if let value = _value_of(operand) then
                return _current.binary(BinaryOperator.XOR, IntegerFlags.NONE, value, LLVM.Values.integer(value.type, bigint.minus_one))
            fi

            return null
        si

        // A shift count is an int whatever the shifted value is, and only its
        // low bits count, as CIL's and wasm's shifts use them: LLVM makes a
        // count at or past the width poison instead.
        _shift(operation: ArithmeticOperation, operand: Value, count: Value, held: LLVM.Type, scalar: Scalar?) -> LLVM.Value? is
            let value_found = _value_of(operand)
            let count_found = _value_of(count)

            if !value_found? \/ !count_found? then
                return null
            fi

            let value mut = value_found
            let amount mut = count_found

            // An unsigned shift of a narrow signed kind shifts in zeros at the
            // kind's own width, so its sign-extended operand is first cut back
            // to that width.
            if operation == ArithmeticOperation.SHIFT_RIGHT_UNSIGNED then
                if scalar =~ Scalar.INT8 then
                    value = _normalise(value, Scalar.UINT8)
                elif scalar =~ Scalar.INT16 then
                    value = _normalise(value, Scalar.UINT16)
                fi
            fi

            let width = LLVM_TYPES.width(held)

            if LLVM_TYPES.width(amount.type) < width then
                amount = _current.convert(Conversion.ZERO_EXTEND, amount, held)
            elif LLVM_TYPES.width(amount.type) > width then
                amount = _current.convert(Conversion.TRUNCATE, amount, held)
            fi

            amount = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, amount, LLVM.Values.integer(held, bigint(width - 1)))

            let operator =
                case operation
                when ArithmeticOperation.SHIFT_LEFT then BinaryOperator.SHL
                when ArithmeticOperation.SHIFT_RIGHT then BinaryOperator.ASHR
                else BinaryOperator.LSHR
                esac

            return _current.binary(operator, IntegerFlags.NONE, value, amount)
        si

        _binary(operation: ArithmeticOperation, left: Value, right: Value, is_floating: bool) -> LLVM.Value? is
            let operator = _operator(operation, is_floating)

            if !operator? then
                return null
            fi

            let l = _value_of(left)
            let r = _value_of(right)

            if !l? \/ !r? then
                return null
            fi

            if is_floating then
                return _current.floating(operator, FastMath.NONE, l, r)
            fi

            return _current.binary(operator, IntegerFlags.NONE, l, r)
        si

        // Integer division and remainder are not lowered until they check
        // for a zero divisor and for overflow, as .NET's do.
        _operator(operation: ArithmeticOperation, is_floating: bool) -> BinaryOperator? is
            let result: BinaryOperator? =
                if is_floating then
                    case operation
                    when ArithmeticOperation.ADD then BinaryOperator.FADD
                    when ArithmeticOperation.SUBTRACT then BinaryOperator.FSUB
                    when ArithmeticOperation.MULTIPLY then BinaryOperator.FMUL
                    when ArithmeticOperation.DIVIDE then BinaryOperator.FDIV
                    when ArithmeticOperation.REMAINDER then BinaryOperator.FREM
                    else null
                    esac
                else
                    case operation
                    when ArithmeticOperation.ADD then BinaryOperator.ADD
                    when ArithmeticOperation.SUBTRACT then BinaryOperator.SUB
                    when ArithmeticOperation.MULTIPLY then BinaryOperator.MUL
                    when ArithmeticOperation.AND then BinaryOperator.AND
                    when ArithmeticOperation.OR then BinaryOperator.OR
                    when ArithmeticOperation.XOR then BinaryOperator.XOR
                    else null
                    esac
                fi

            if !result? then
                if !is_floating /\ _is_division(operation) then
                    _report("integer division")
                else
                    _report("{operation}")
                fi
            fi

            return result
        si

        _is_division(operation: ArithmeticOperation) -> bool =>
            operation == ArithmeticOperation.DIVIDE \/
            operation == ArithmeticOperation.DIVIDE_UNSIGNED \/
            operation == ArithmeticOperation.REMAINDER \/
            operation == ArithmeticOperation.REMAINDER_UNSIGNED

        visit(compare: Values.COMPARE) is
            if !_held(compare.left.type)? then
                _report("a comparison of {compare.left.type}")
                return
            fi

            let left = _value_of(compare.left)
            let right = _value_of(compare.right)

            if left? /\ right? then
                _push(_bool(_compare(compare.comparison, left, right, compare.is_unsigned)))
            fi
        si

        // An unsigned comparison orders integers as unsigned, and answers true
        // for floating values with unordered operands, as CIL's `.un`
        // comparisons do. Inequality of floating values is always unordered,
        // since it is the negation of an ordered equality.
        _compare(comparison: Comparison, left: LLVM.Value, right: LLVM.Value, is_unsigned: bool) -> LLVM.Value is
            if LLVM_TYPES.is_floating(left.type) then
                let predicate =
                    case comparison
                    when Comparison.EQUAL then if is_unsigned then FloatPredicate.UEQ else FloatPredicate.OEQ fi
                    when Comparison.NOT_EQUAL then FloatPredicate.UNE
                    when Comparison.LESS then if is_unsigned then FloatPredicate.ULT else FloatPredicate.OLT fi
                    when Comparison.LESS_OR_EQUAL then if is_unsigned then FloatPredicate.ULE else FloatPredicate.OLE fi
                    when Comparison.GREATER then if is_unsigned then FloatPredicate.UGT else FloatPredicate.OGT fi
                    when Comparison.GREATER_OR_EQUAL then if is_unsigned then FloatPredicate.UGE else FloatPredicate.OGE fi
                    esac

                return _current.compare(predicate, left, right)
            fi

            let predicate =
                case comparison
                when Comparison.EQUAL then IntegerPredicate.EQ
                when Comparison.NOT_EQUAL then IntegerPredicate.NE
                when Comparison.LESS then if is_unsigned then IntegerPredicate.ULT else IntegerPredicate.SLT fi
                when Comparison.LESS_OR_EQUAL then if is_unsigned then IntegerPredicate.ULE else IntegerPredicate.SLE fi
                when Comparison.GREATER then if is_unsigned then IntegerPredicate.UGT else IntegerPredicate.SGT fi
                when Comparison.GREATER_OR_EQUAL then if is_unsigned then IntegerPredicate.UGE else IntegerPredicate.SGE fi
                esac

            return _current.compare(predicate, left, right)
        si

        visit(convert: Values.CONVERT) is
            if !convert.from? /\ !_scalar(convert.value.type)? then
                _report("unboxing a {convert.type}")
                return
            fi

            if let value = _value_of(convert.value) then
                _push(_convert(value, convert.from ?? Scalar.INT32, convert.to))
            fi
        si

        // The conversion of a value of kind `from` to kind `to`, saturating
        // from floating to integer as .NET does.
        _convert(value: LLVM.Value, from: Scalar, to: Scalar) -> LLVM.Value is
            let source = LLVM_TYPES.value_type(from)
            let target = LLVM_TYPES.value_type(to)
            let source_unsigned = LLVM_TYPES.is_unsigned(from)
            let target_unsigned = LLVM_TYPES.is_unsigned(to)

            let changed mut = value

            if LLVM_TYPES.is_floating(source) then
                if LLVM_TYPES.is_floating(target) then
                    if source =~ LLVM.Type.DOUBLE /\ target =~ LLVM.Type.FLOAT then
                        changed = _current.convert(Conversion.FLOAT_TRUNCATE, value, target)
                    elif source =~ LLVM.Type.FLOAT /\ target =~ LLVM.Type.DOUBLE then
                        changed = _current.convert(Conversion.FLOAT_EXTEND, value, target)
                    fi
                else
                    let intrinsic =
                        if target_unsigned then
                            Intrinsics.float_to_unsigned_saturating(target, source)
                        else
                            Intrinsics.float_to_signed_saturating(target, source)
                        fi

                    changed = _current.call(_module.declare_intrinsic(intrinsic), [value])!
                fi
            elif LLVM_TYPES.is_floating(target) then
                changed =
                    _current.convert(
                        if source_unsigned then Conversion.UNSIGNED_TO_FLOAT else Conversion.SIGNED_TO_FLOAT fi,
                        value,
                        target)
            else
                let source_width = LLVM_TYPES.width(source)
                let target_width = LLVM_TYPES.width(target)

                if source_width > target_width then
                    changed = _current.convert(Conversion.TRUNCATE, value, target)
                elif source_width < target_width then
                    changed =
                        _current.convert(
                            if source_unsigned then Conversion.ZERO_EXTEND else Conversion.SIGN_EXTEND fi,
                            value,
                            target)
                fi
            fi

            if LLVM_TYPES.is_narrow(to) then
                return _normalise(changed, to)
            fi

            return changed
        si

        visit(node: Values.Breakable) is
            assert node.is_closed else "structured node generated before it was closed"

            if let region: Values.REGION = node then
                _lower_region(region, null)
            elif let loop: Values.LOOP = node then
                _lower_loop(loop)
            elif isa Values.TRY(node) then
                _report("a try")
            else
                _report("a generator or asynchronous function")
            fi
        si

        // A region continues at a block of its own. One that produces a value
        // has each arm store the value into an `alloca` before it leaves,
        // and the value is read back where the region continues.
        _lower_region(region: Values.REGION, result_type: LLVM.Type?) is
            let end = _new_block()
            let result = if let type = result_type then _slot(type) else null fi
            let depth = _stack.count

            _labels.add((region, false, end, result, depth))

            let values = region.body.values

            // A region that ends in another produces its value through that
            // one: a block expression's statements end with the value they
            // leave, and that region falls through holding it.
            let last_region =
                if result_type? /\ values.count > 0 then
                    cast Values.REGION?(values[values.count - 1])
                else
                    null
                fi

            if let last = last_region then
                for i in 0..values.count - 1 do
                    gen(values[i])
                od

                _lower_region(last, result_type)
            else
                for value in values do
                    gen(value)
                od
            fi

            if !_is_terminated then
                _leave_with_result(result, depth)
                _branch(end)
            fi

            _labels.remove_at(_labels.count - 1)

            _start(end)

            _check_depth(depth, "region")

            if let pointer = result, type = result_type then
                _push(_current.load(type, pointer, 0))
            fi
        si

        // Stores the value an arm leaves into its region's result.
        _leave_with_result(result: LLVM.Value?, depth: int) is
            if let pointer = result /\ _stack.count > depth then
                _current.store(_pop()!, pointer, 0)
            fi
        si

        // The IR never leaves a value on the stack across a branch, so the
        // stack is as deep where a node continues as where it began.
        _check_depth(depth: int, construct: string) is
            if _stack.count != depth then
                _report("a value left on the stack across a {construct}")

                while _stack.count > depth do
                    _pop()
                od
            fi
        si

        // A loop has a header, where its body starts and where reaching the
        // end of the body and a CONTINUE both go, and a continuation a BREAK
        // goes to.
        _lower_loop(loop: Values.LOOP) is
            let header = _new_block()
            let end = _new_block()
            let depth = _stack.count

            _labels.add((loop, false, end, null, depth))
            _labels.add((loop, true, header, null, depth))

            _branch(header)
            _start(header)

            for value in loop.body.values do
                gen(value)
            od

            if !_is_terminated then
                _branch(header)
            fi

            _labels.remove_at(_labels.count - 1)
            _labels.remove_at(_labels.count - 1)

            _start(end)

            _check_depth(depth, "loop")
        si

        visit(exit: Values.Exit) is
            let is_continue = isa Values.CONTINUE(exit)

            let i mut = _labels.count - 1

            while i >= 0 do
                let label = _labels[i]

                if label.node == exit.target /\ label.is_loop_head == is_continue then
                    _exit(exit, label.target, label.result, label.depth)
                    return
                fi

                i = i - 1
            od

            _report("an exit from a construct the lowering does not handle")
        si

        _exit(exit: Values.Exit, target: BLOCK, result: LLVM.Value?, depth: int) is
            if exit.condition == IR.BRANCH.ALWAYS then
                _leave_with_result(result, depth)
                _branch(target)
                return
            fi

            // A conditional exit from a region that produces a value leaves
            // the value on the stack for the path that carries on.
            if let pointer = result /\ _stack.count > depth then
                _current.store(_peek()!, pointer, 0)
            fi

            if let condition = _test(exit.condition, exit.operands) then
                let next = _new_block()

                _current.branch(condition, target, next)
                _start(next)
            fi
        si

        // The `i1` a conditional exit branches on.
        _test(condition: IR.BRANCH, operands: Collections.List[Value]) -> LLVM.Value? is
            let first = _value_of(operands[0])

            if !first? then
                return null
            fi

            if condition == IR.BRANCH.Z \/ condition == IR.BRANCH.NZ then
                if LLVM_TYPES.is_floating(first.type) then
                    _report("a condition on {operands[0].type}")
                    return null
                fi

                return _current.compare(
                    if condition == IR.BRANCH.Z then IntegerPredicate.EQ else IntegerPredicate.NE fi,
                    first,
                    LLVM_TYPES.zero(first.type))
            fi

            if operands.count < 2 then
                _report("the condition {condition}")
                return null
            fi

            let second = _value_of(operands[1])

            if !second? then
                return null
            fi

            let comparison: (Comparison, bool)? =
                case condition
                when IR.BRANCH.EQ then (Comparison.EQUAL, false)
                when IR.BRANCH.NE then (Comparison.NOT_EQUAL, true)
                when IR.BRANCH.GE then (Comparison.GREATER_OR_EQUAL, false)
                when IR.BRANCH.GEU then (Comparison.GREATER_OR_EQUAL, true)
                when IR.BRANCH.GT then (Comparison.GREATER, false)
                when IR.BRANCH.GTU then (Comparison.GREATER, true)
                when IR.BRANCH.LE then (Comparison.LESS_OR_EQUAL, false)
                when IR.BRANCH.LEU then (Comparison.LESS_OR_EQUAL, true)
                when IR.BRANCH.LT then (Comparison.LESS, false)
                when IR.BRANCH.LTU then (Comparison.LESS, true)
                else null
                esac

            if let (operation, is_unsigned) = comparison then
                return _compare(operation, first, second, is_unsigned)
            fi

            _report("the condition {condition}")

            return null
        si

        visit(dispatch: Values.DISPATCH) is _report("a generator or asynchronous function") si
        visit(resume: Values.RESUME_POINT) is _report("a generator or asynchronous function") si

        visit(call: Values.Call.GLOBAL) is
            _call(call.function, call.arguments)
        si

        /// A static method takes no receiver, so it is called as a global
        /// function is.
        visit(call: Values.Call.STATIC) is
            _ensure_initialised(call.function.owner)
            _call(call.function, call.arguments)
        si

        visit(call: Values.Call.STRUCT) is _report("a method of a struct") si

        /// An array's count and indexer lower to the operations they stand
        /// for. No other instance method can be called yet.
        visit(call: Values.Call.INSTANCE) is
            let operation = _array_operation(call.function)

            if operation =~ "array.count" then
                if let _ = _array_of(call.from.type), array = _value_of(call.from) then
                    _push(_arrays!.count(_current, array))
                fi
            elif operation =~ "array.get" then
                if let type = _array_of(call.from.type), array = _value_of(call.from), index = _value_of(call.arguments[0]) then
                    _check_index(array, index)

                    _push(_arrays!.load(_current, type, array, index))
                fi
            else
                _call_instance(call)
            fi
        si

        visit(call: Values.Call.CLOSURE) is _report("a function value") si
        /// A built-in operation lowers to the IR the operation stands for,
        /// made once and reused by every later lowering of the same body.
        visit(call: Values.Call.INNATE) is
            if call.innate_name.starts_with("host.") \/ call.innate_name.starts_with("nullable.") then
                _report("the operation {call.innate_name}")
            elif call.is_lowered then
                gen(call.lowering)
            else
                gen(call.lower())
            fi
        si

        // The instance a call from this body names: a reference from inside a
        // generic body takes its type arguments from the body's own.
        _instance_of(function: Function) -> FUNCTION_INSTANCE =>
            FUNCTION_INSTANCE(
                cast Function?(function.root_specialized_from)!,
                TYPE_MAPS.function_map(function, _type_map))

        _call(function: Function, arguments: Collections.List[Value]) is
            if let operation = function.intrinsic_operation then
                if operation.starts_with("host.") then
                    _call_host(operation.substring(5), function, arguments)
                elif operation =~ "array.new" then
                    _new_array(_instance_of(function).specialize(cast Function?(function.root_specialized_from)!.return_type), arguments[0])
                elif operation =~ "array.set" then
                    _store_array_element(arguments[0], arguments[1], arguments[2])
                else
                    _report("the intrinsic {operation}")
                fi

                return
            fi

            let callee = _callee(_instance_of(function))

            if !callee? then
                _report("a call to {function.name}")
                return
            fi

            let values = LIST[LLVM.Value]()
            let parameters = function.arguments

            for i in 0..arguments.count do
                if let value = _value_of(arguments[i]) then
                    values.add(if i < parameters.count then _normalise_for(value, parameters[i]) else value fi)
                else
                    return
                fi
            od

            if let result = _current.call(callee, values.to_array()) then
                _push(result)
            fi
        si

        // A host operation is a function the native runtime defines, named
        // for the operation. A string crosses as the address of its code
        // units and their count, and comes back as a string the runtime made
        // through `ghul_make_string`.
        _call_host(operation: string, function: Function, arguments: Collections.List[Value]) is
            let strings = _strings

            if !strings? then
                _report("the host operation {operation}")
                return
            fi

            let parameter_types = LIST[LLVM.Type]()
            let values = LIST[LLVM.Value]()
            let formals = function.arguments

            for i in 0..arguments.count do
                let formal = if i < formals.count then formals[i] else arguments[i].type fi

                let value = _value_of(arguments[i])

                if !value? then
                    return
                fi

                if let scalar = _scalar(formal) then
                    parameter_types.add(LLVM_TYPES.value_type(scalar))
                    values.add(_normalise_for(value, formal))
                elif _is_string(_specialize(formal)) then
                    parameter_types.add(Types.pointer)
                    parameter_types.add(Types.i32)
                    values.add(strings.chars(_current, value))
                    values.add(strings.length(_current, value))
                else
                    _report("a host operation taking {formal}")
                    return
                fi
            od

            let result_type =
                if LLVM_TYPES.is_void(function.return_type) then
                    LLVM.Type.VOID
                else
                    _held(function.return_type)
                fi

            if !result_type? then
                _report("a host operation answering {function.return_type}")
                return
            fi

            let host = strings.runtime(LLVM_STRINGS.host_name(operation), result_type, parameter_types.to_array())

            if let answer = _current.call(host, values.to_array()) then
                _push(answer)
            fi
        si

        visit(store: Values.Store.SYMBOL) is _report("a store to {store.symbol.name}") si

        visit(store: Values.Store.LOCAL_VARIABLE) is
            if Values.state_machine_field_for(store.symbol)? then
                _report("a generator or asynchronous function")
            elif let variable = cast Semantic.Symbols.Variable?(store.symbol) then
                _store_local(variable.ir_local, _value_of(store.value))
            else
                _report("a store to {store.symbol.name}")
            fi
        si

        visit(store: Values.Store.LOCAL_ARGUMENT) is
            let symbol = store.symbol

            if Values.state_machine_field_for(symbol)? then
                _report("a generator or asynchronous function")
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _store_local(packed_local, _value_of(store.value))
            elif let index = _argument_index(symbol) then
                _store_argument(index, _value_of(store.value), symbol.type)
            else
                _report("a store to an argument of another function")
            fi
        si


        _load_receiver() is
            if _receiver_offset == 0 then
                _report("self outside an instance method")
            else
                _load_argument(0)
            fi
        si

        // The class a member's owner is, at the arguments this body gives
        // it.
        _owner_class(owner: Semantic.Scope?) -> CLASS_INSTANCE? is
            if let objects = _objects then
                if let generic: Semantic.Symbols.GENERIC = owner then
                    return objects.class_of(_specialize(generic.type))
                elif let classy: Semantic.Symbols.Classy = owner then
                    return objects.class_of(classy, _type_map)
                fi
            fi

            return null
        si

        // The instance of the trait a member's owner is, at the arguments
        // this body gives it.
        _trait_instance(owner: Semantic.Scope?) -> CLASS_INSTANCE? is
            if let objects = _objects then
                if let generic: Semantic.Symbols.GENERIC = owner then
                    return objects.trait_of(_specialize(generic.type)!)
                elif let classy: Semantic.Symbols.Classy = owner then
                    return objects.trait_of(classy, _type_map)
                fi
            fi

            return null
        si

        // A type's static constructor runs once, before the type is first
        // used: before a static member is read, written or called, and before
        // an instance is made. Its flag is set before the body runs, so a use
        // of the type from inside it does not run it again.
        _ensure_initialised(owner: Semantic.Scope?) is
            if let objects = _objects, type = _owner_class(owner), (constructor, flag) = objects.static_constructor(type) then
                let callee = _callee(constructor)

                if !callee? then
                    _report("a static constructor of {type}")
                    return
                fi

                let run = _new_block()
                let carry_on = _new_block()
                let state = _current.load(Types.i32, LLVM.Values.global(flag), 4)

                _current.branch(_current.compare(IntegerPredicate.EQ, state, _i32(0)), run, carry_on)

                _start(run)

                _current.store(_i32(1), LLVM.Values.global(flag), 4)
                _current.call(callee, [])
                _current.branch(carry_on)

                _start(carry_on)
            fi
        si

        // Throws where `condition`, an `i1`, holds. Until the target has
        // exception objects, what is thrown carries no type or message.
        _throw_if(condition: LLVM.Value) is
            let thrown = _new_block()
            let carry_on = _new_block()

            _current.branch(condition, thrown, carry_on)

            _start(thrown)

            _current.call(_strings!.runtime("$ghul_throw", LLVM.Type.VOID, [Types.pointer]), [LLVM.Values.null_pointer])
            _current.unreachable()

            _start(carry_on)
        si

        // Throws where `object` is null, as .NET throws on a member reached
        // through a null reference rather than reading through it.
        _check_not_null(object: LLVM.Value) is
            _throw_if(_current.compare(IntegerPredicate.EQ, object, LLVM.Values.null_pointer))
        si

        // The address of the instance field `symbol` of the object `from`
        // answers, or null, reported, where the target does not hold it.
        _field_address(from: Value?, symbol: Semantic.Symbols.Symbol) -> LLVM.Value? is
            let objects = _objects

            if !objects? \/ !from? then
                _report("a field")
                return null
            fi

            if from.is_value_type then
                _report("a field of a value type")
                return null
            fi

            let owner = _owner_class(symbol.owner)
            let position = objects.field_position(symbol)

            if !owner? \/ !position? then
                _report("a field of {symbol.owner}")
                return null
            fi

            let object = _value_of(from)

            if !object? then
                return null
            fi

            _check_not_null(object)

            return _current.element_pointer(objects.struct_type(owner), object, [_i32(0), _i32(position)], true)
        si

        visit(load: Values.Load.INSTANCE_FIELD) is
            let held = _held(load.type)

            if !held? then
                _report("a field of type {load.type}")
                return
            fi

            if let address = _field_address(load.from, load.symbol) then
                _push(_current.load(held, address, 0))
            fi
        si

        visit(store: Values.Store.INSTANCE_FIELD) is
            if let address = _field_address(store.from, store.symbol), value = _value_of(store.value) then
                _current.store(_normalise_for(value, store.type), address, 0)
            fi
        si

        // The global holding a static field, or a namespace-level variable
        // where `owner` is null.
        _global(symbol: Semantic.Symbols.Symbol, is_static: bool) -> (name: string, type: LLVM.Type)? is
            let objects = _objects

            if !objects? then
                _report("a static field")
                return null
            fi

            // A static field of a namespace is a namespace-level variable.
            let is_class_static = is_static /\ !isa Semantic.Symbols.NAMESPACE(symbol.owner)
            let owner = if is_class_static then _owner_class(symbol.owner) else null fi

            if is_class_static then
                if !owner? then
                    _report("a static field of {symbol.owner}")
                    return null
                fi

                _ensure_initialised(symbol.owner)
            fi

            let type = _specialize(cast Semantic.Types.Typed?(symbol)?.type)

            if let global = objects.global_of(symbol, owner, type) then
                return global
            fi

            _report("a static field of type {type}")

            return null
        si

        _load_global(symbol: Semantic.Symbols.Symbol, is_static: bool) is
            if let (name, type) = _global(symbol, is_static) then
                _push(_current.load(type, LLVM.Values.global(name), 0))
            fi
        si

        _store_global(symbol: Semantic.Symbols.Symbol, is_static: bool, value: Value) is
            if let (name, _) = _global(symbol, is_static), stored = _value_of(value) then
                _current.store(_normalise_for(stored, cast Semantic.Types.Typed?(symbol)?.type), LLVM.Values.global(name), 0)
            fi
        si

        visit(load: Values.Load.STATIC_FIELD) is _load_global(load.symbol, true) si
        visit(load: Values.Load.GLOBAL_FIELD) is _load_global(load.symbol, false) si
        visit(store: Values.Store.STATIC_FIELD) is _store_global(store.symbol, true, store.value) si
        visit(store: Values.Store.GLOBAL_FIELD) is _store_global(store.symbol, false, store.value) si

        visit(load: Values.Load.RECEIVER) is _load_receiver() si
        visit(self_load: Values.Load.REFERENCE_SELF) is _load_receiver() si

        /// An object is allocated through the runtime, zeroed, with its
        /// descriptor in place, and its constructor is called on it.
        visit(construction: Values.NEW) is
            let constructor = construction.constructor
            let objects = _objects
            let type = _owner_class(constructor.owner)

            if constructor.intrinsic_operation? \/ !objects? \/ !type? \/ !(objects.is_object_type(type) \/ objects.is_object(type)) then
                _report("constructing a {construction.type}")
                return
            fi

            if type.definition.is_union \/ type.definition.is_variant then
                _report("a union")
                return
            fi

            _ensure_initialised(constructor.owner)

            let object =
                _current.call(
                    _strings!.runtime("$ghul_alloc", Types.pointer, [Types.pointer, Types.i64]),
                    [LLVM.Values.global(objects.descriptor_name(type)), LLVM.Values.i64(cast long(objects.size_of(type)))])!

            if objects.is_object(type) then
                _push(object)
                return
            fi

            let callee = _callee(_instance_of(constructor))

            if !callee? then
                _report("a call to {constructor.name}")
                return
            fi

            if let values = _arguments_for(constructor, construction.arguments) then
                values.insert(0, object)

                _current.call(callee, values.to_array())

                _push(object)
            fi
        si

        // The arguments of a call to `function`, each brought into the
        // range of its parameter's kind, or null where one did not lower.
        _arguments_for(function: Function, arguments: Collections.List[Value]) -> LIST[LLVM.Value]? is
            let values = LIST[LLVM.Value]()
            let parameters = function.arguments

            for i in 0..arguments.count do
                if let value = _value_of(arguments[i]) then
                    values.add(if i < parameters.count then _normalise_for(value, parameters[i]) else value fi)
                else
                    return null
                fi
            od

            return values
        si

        _is_trait_method(function: Function) -> bool =>
            cast Semantic.Symbols.Classy?(function.root_specialized_from.owner)?.is_trait ?? false

        // A call to a method of the root's constructor runs nothing, since
        // the root has no state of its own.
        _is_object_constructor(function: Function) -> bool =>
            function.is_constructor /\ (cast Semantic.Symbols.Classy?(function.owner)?.is_object ?? false)

        _call_instance(call: Values.Call.INSTANCE) is
            let function = call.function
            let dispatch = call.dispatch

            if _is_object_constructor(function) then
                return
            fi

            if !_objects? then
                _report("an instance method")
                return
            fi

            if dispatch == IR.Dispatch.VIRTUAL /\ _is_trait_method(function) \/ dispatch == IR.Dispatch.INTERFACE then
                _call_interface(call)
            elif dispatch == IR.Dispatch.VIRTUAL /\ !function.has_no_overriders then
                _call_virtual(call)
            elif dispatch == IR.Dispatch.DIRECT \/ dispatch == IR.Dispatch.VIRTUAL then
                _call_direct(call, _instance_of(function))
            else
                _report("a {dispatch} call")
            fi
        si

        _call_direct(call: Values.Call.INSTANCE, instance: FUNCTION_INSTANCE) is
            let callee = _callee(instance)

            if !callee? then
                _report("a call to {instance.definition.name}")
                return
            fi

            if let receiver = _value_of(call.from), values = _arguments_for(call.function, call.arguments) then
                _check_not_null(receiver)

                values.insert(0, receiver)

                if let result = _current.call(callee, values.to_array()) then
                    _push(result)
                fi
            fi
        si

        // The function type a call to `instance` through a pointer has: the
        // receiver, then its own arguments, then its result.
        _function_type(instance: FUNCTION_INSTANCE) -> LLVM.Type? is
            let parameters = LIST[LLVM.Type]()

            parameters.add(Types.pointer)

            for argument in instance.definition.arguments do
                if let held = LLVM_TYPES.value_type(instance.specialize(argument)) then
                    parameters.add(held)
                else
                    return null
                fi
            od

            if let result = LLVM_TYPES.result_type(instance.specialize(instance.definition.return_type)) then
                return LLVM.Type.FUNCTION(result, parameters.to_array(), false)
            fi

            return null
        si

        // While discovering, a call through a vtable or the trait table is
        // followed only for what its receiver and arguments reach, and
        // stands for a value of its result type.
        _discover_dispatched_call(call: Values.Call.INSTANCE) is
            gen(call.from)

            for argument in call.arguments do
                gen(argument)
            od

            if let result = _held(call.type) /\ !LLVM_TYPES.is_void(call.type) then
                _push(LLVM_TYPES.zero(result))
            fi
        si

        // Calls through `entry`, the address of a function pointer, with
        // the receiver and the arguments.
        _call_through(call: Values.Call.INSTANCE, receiver: LLVM.Value, values: LIST[LLVM.Value], entry: LLVM.Value) is
            let function_type = _function_type(_instance_of(call.function))

            if !function_type? then
                _report("a call to {call.function.name}")
                return
            fi

            values.insert(0, receiver)

            let target = _current.load(Types.pointer, entry, 8)

            if let result = _current.call(function_type, target, values.to_array()) then
                _push(result)
            fi
        si

        // The receiver's vtable is read from its descriptor, and the
        // method's slot called.
        _call_virtual(call: Values.Call.INSTANCE) is
            let objects = _objects!

            if !objects.is_built then
                objects.note_dispatched(call.function)
                _discover_dispatched_call(call)
                return
            fi

            let slot = objects.slot_of(_instance_of(call.function))

            if !slot? then
                _report("a virtual call to {call.function.name}")
                return
            fi

            if let receiver = _value_of(call.from), values = _arguments_for(call.function, call.arguments) then
                _check_not_null(receiver)

                let descriptor = _current.load(Types.pointer, receiver, 8)
                let entry = _current.element_pointer(Types.i8, descriptor, [_i32(LLVM_OBJECTS.DESCRIPTOR_VTABLE + 8 * slot.index)], true)

                _call_through(call, receiver, values, entry)
            fi
        si

        // The receiver's class number, read from its descriptor, picks the
        // method's entry in its row of the trait table.
        _call_interface(call: Values.Call.INSTANCE) is
            let objects = _objects!
            let function = call.function
            let trait_type = _trait_instance(function.owner)
            let root = cast Function?(function.root_specialized_from)!

            if !objects.is_built then
                objects.note_dispatched(function)

                if let t = trait_type then
                    objects.selector_of(root, t)
                fi

                _discover_dispatched_call(call)
                return
            fi

            let selector = if let t = trait_type then objects.selector_of(root, t) else null fi

            if !selector? then
                _report("a trait call to {function.name}")
                return
            fi

            if let only = objects.only_implementation(selector) then
                _call_direct(call, only)
                return
            fi

            if let receiver = _value_of(call.from), values = _arguments_for(function, call.arguments) then
                _check_not_null(receiver)

                let descriptor = _current.load(Types.pointer, receiver, 8)
                let class_id = _current.load(Types.i32, descriptor, 8)
                let index = _current.binary(BinaryOperator.ADD, IntegerFlags.NONE, class_id, _i32(selector.offset))
                let entry = _current.element_pointer(Types.pointer, LLVM.Values.global(LLVM_OBJECTS.TRAIT_TABLE_NAME), [index], true)

                _call_through(call, receiver, values, entry)
            fi
        si

        // The class numbers a value must have to be a `type`: one range for
        // a class, and the implementors' numbers for a trait. Null where the
        // target cannot test for the type.
        _class_ranges(type: Type?) -> LIST[(first: int, last: int)]? is
            let objects = _objects

            if !objects? \/ !type? then
                return null
            fi

            let result = LIST[(first: int, last: int)]()

            if let array = objects.classes.array_of(type) then
                return objects.array_ranges(array)
            elif let target = objects.class_of(type) ?? objects.box_type(type) then
                result.add(objects.class_range(target))

                return result
            fi

            if type.is_trait then
                if let trait_type = objects.trait_of(type) then
                    if let implementors = objects.implementors(trait_type) then
                        for implementor in implementors do
                            result.add(objects.class_range(implementor))
                        od
                    fi

                    return result
                fi
            fi

            return null
        si

        // The class number of the object `value` points at, or -1 where it
        // is null, which no class has.
        _class_id(value: LLVM.Value) -> LLVM.Value is
            let slot = _entry.alloca(Types.i32, 4)

            _current.store(_i32(-1), slot, 4)

            let present = _new_block()
            let join = _new_block()

            _current.branch(_current.compare(IntegerPredicate.NE, value, LLVM.Values.null_pointer), present, join)

            _start(present)

            let descriptor = _current.load(Types.pointer, value, 8)

            _current.store(_current.load(Types.i32, descriptor, 8), slot, 4)
            _current.branch(join)

            _start(join)

            return _current.load(Types.i32, slot, 4)
        si

        // Whether the class number `id` falls in one of `ranges`, as an `i1`.
        _in_ranges(id: LLVM.Value, ranges: LIST[(first: int, last: int)]) -> LLVM.Value is
            let result mut = LLVM.Values.boolean(false)

            for (first, last) in ranges do
                let from_first = _current.compare(IntegerPredicate.SGE, id, _i32(first))
                let to_last = _current.compare(IntegerPredicate.SLE, id, _i32(last))
                let within = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, from_first, to_last)

                result = _current.binary(BinaryOperator.OR, IntegerFlags.NONE, result, within)
            od

            return result
        si

        visit(test: Values.ISA) is
            let ranges = _class_ranges(_specialize(test.isa_type))

            if !ranges? then
                _report("a type test against {test.isa_type}")
                return
            fi

            if let value = _value_of(Values.TYPE_TEST_OPERAND.operand(test.value)) then
                if !(isa LLVM.Type.POINTER(value.type)) then
                    _report("a type test of {test.value.type}")
                    return
                fi

                _push(_bool(_in_ranges(_class_id(value), ranges)))
            fi
        si

        // A cast between references tests the class number, since a
        // narrowed operand can carry the type it is being tested for: a
        // checked cast throws where the test fails, and one to an optional
        // type answers null. A cast to `object` cannot fail.
        visit(conversion: Values.CAST) is
            let target = _specialize(conversion.type)

            let held = _held(conversion.value.type)

            if !held? \/ !isa LLVM.Type.POINTER(held) then
                _report("a cast")
                return
            fi

            // A cast to a scalar tests for its box and keeps the reference,
            // which is unboxed afterwards.
            let is_box = _objects?.box_type(target)?

            if !target? \/ !(LLVM_TYPES.is_object_reference(target) \/ is_box) then
                _report("a cast to {conversion.type}")
                return
            fi

            let value = _value_of(conversion.value)

            if !value? then
                return
            fi

            if target.is_object then
                _push(value)
                return
            fi

            let ranges = _class_ranges(target)

            if !ranges? then
                _report("a cast to {conversion.type}")
                return
            fi

            let id = _class_id(value)
            let fits = _current.binary(BinaryOperator.OR, IntegerFlags.NONE, _in_ranges(id, ranges), _current.compare(IntegerPredicate.EQ, id, _i32(-1)))

            if conversion.faults_on_failure \/ (conversion.is_checked /\ is_box) then
                _throw_if(_current.compare(IntegerPredicate.EQ, fits, LLVM.Values.boolean(false)))
                _push(value)
            else
                _push(_current.select(fits, value, LLVM.Values.null_pointer))
            fi
        si

        visit(equality: Values.REFERENCE_EQUALITY) is
            if let left = _value_of(equality.left), right = _value_of(equality.right) then
                _push(_bool(_current.compare(IntegerPredicate.EQ, left, right)))
            fi
        si

        visit(check: Values.REFERENCE_NULL_CHECK) is
            if let value = _value_of(check.inner) then
                _check_not_null(value)
                _push(value)
            fi
        si
    si
si
