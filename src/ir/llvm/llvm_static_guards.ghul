namespace IR.LLVMTarget is
    use Collections.LIST
    use Collections.MAP

    use LLVM.BLOCK
    use LLVM.Operation

    partial LLVM_LOWERING is
        // Each test of a type's initialised flag in the function: the block
        // that tests it, the flag, and the block both of its paths go on to.
        _guards: LIST[(test: BLOCK, flag: string, carry_on: BLOCK)]?

        // Records the test of `flag` that ends `test`, going on to
        // `carry_on` once the type is initialised.
        _note_guard(test: BLOCK, flag: string, carry_on: BLOCK) is
            let guards = _guards ?? LIST[(test: BLOCK, flag: string, carry_on: BLOCK)]()

            _guards = guards
            guards.add((test, flag, carry_on))
        si

        // Removes each test of a type's initialised flag that an earlier
        // test of the same flag dominates: once control has passed the
        // earlier test the type is initialised, whatever ran in between, so
        // the later test always goes straight on.
        _elide_dominated_guards() is
            let guards = _guards

            if !guards? \/ guards.count < 2 then
                return
            fi

            let dominators = _dominators()

            for guard in guards do
                for earlier in guards do
                    if earlier.test != guard.test /\ earlier.flag =~ guard.flag /\ _dominates(dominators, earlier.carry_on.name, guard.test.name) then
                        guard.test.replace_terminator(guard.carry_on)
                        break
                    fi
                od
            od
        si

        _dominates(dominators: MAP[string, string], dominator: string, block: string) -> bool is
            let at mut = block

            do
                if at =~ dominator then
                    return true
                fi

                let up: string mut

                if !dominators.try_get_value(at, up ref) \/ up =~ at then
                    return false
                fi

                at = up
            od
        si

        // Each block's immediate dominator, by name; the entry block is its
        // own. Blocks unreachable from the entry have none.
        _dominators() -> MAP[string, string] is
            let blocks = _function.blocks
            let successors = MAP[string, LIST[string]]()
            let predecessors = MAP[string, LIST[string]]()

            for block in blocks do
                successors[block.name] = _successors(block)
                predecessors[block.name] = LIST[string]()
            od

            for block in blocks do
                for target in successors[block.name] do
                    let into: LIST[string] mut

                    if predecessors.try_get_value(target, into ref) then
                        into.add(block.name)
                    fi
                od
            od

            // Reverse postorder from the entry.
            let order = LIST[string]()
            let visited = Collections.SET[string]()
            let stack = LIST[(name: string, next: int)]()
            let entry = blocks[0].name

            visited.add(entry)
            stack.add((entry, 0))

            while stack.count > 0 do
                let top = stack[stack.count - 1]
                let targets = successors[top.name]

                if top.next < targets.count then
                    stack[stack.count - 1] = (top.name, top.next + 1)

                    let target = targets[top.next]

                    if successors.contains_key(target) /\ visited.add(target) then
                        stack.add((target, 0))
                    fi
                else
                    order.add(top.name)
                    stack.remove_at(stack.count - 1)
                fi
            od

            order.reverse()

            let position = MAP[string, int]()

            for i in 0..order.count do
                position[order[i]] = i
            od

            let dominators = MAP[string, string]()
            dominators[entry] = entry

            let changed mut = true

            while changed do
                changed = false

                for name in order do
                    if name =~ entry then
                        continue
                    fi

                    let chosen: string? mut = null

                    for predecessor in predecessors[name] do
                        if dominators.contains_key(predecessor) then
                            chosen = if let c = chosen then _intersect(dominators, position, c, predecessor) else predecessor fi
                        fi
                    od

                    let current: string mut

                    if let c = chosen /\ (!dominators.try_get_value(name, current ref) \/ !(current =~ c)) then
                        dominators[name] = c
                        changed = true
                    fi
                od
            od

            return dominators
        si

        _intersect(dominators: MAP[string, string], position: MAP[string, int], a: string, b: string) -> string is
            let left mut = a
            let right mut = b

            while !(left =~ right) do
                while position[left] > position[right] do
                    left = dominators[left]
                od

                while position[right] > position[left] do
                    right = dominators[right]
                od
            od

            return left
        si

        _successors(block: BLOCK) -> LIST[string] is
            let result = LIST[string]()

            if block.instructions.count == 0 then
                return result
            fi

            let operation = block.last_instruction.operation

            if let branch: Operation.BRANCH = operation then
                result.add(branch.target)
            elif let branch: Operation.CONDITIONAL_BRANCH = operation then
                result.add(branch.if_true)
                result.add(branch.if_false)
            elif let switch: Operation.SWITCH = operation then
                result.add(switch.otherwise)

                for (_, target) in switch.cases do
                    result.add(target)
                od
            elif let invoke: Operation.INVOKE = operation then
                result.add(invoke.normal)
                result.add(invoke.unwind)
            fi

            return result
        si
    si
si
