namespace IR.LLVMTarget is
    use IR.Program

    use Collections.LIST

    use LLVM.FUNCTION
    use LLVM.IntegerPredicate
    use LLVM.MODULE
    use LLVM.PARAMETER
    use LLVM.Types
    use LLVM.Values

    /// The displayers: for each type with no text of its own, a function
    /// that writes a value of it for display through the core library's
    /// display state. A sequence is written as its elements, a tuple as its
    /// parts, and anything else as its type and public members.
    ///
    /// A displayer takes the value and the state, and is reached through
    /// the value's descriptor, only where the program renders values for
    /// display at all.
    class LLVM_DISPLAY is
        _module: MODULE
        _objects: LLVM_OBJECTS
        _plan: DISPLAY_PLAN
        _strings: LLVM_STRINGS
        _callee: (FUNCTION_INSTANCE) -> FUNCTION?

        /// - module: where the displayers are added
        /// - objects: the program's classes, whose descriptors hold the displayers
        /// - plan: which classes get a displayer, and what each calls
        /// - strings: where the names a displayer writes are made
        /// - callee: the compiled function of each instance a displayer calls
        init(module: MODULE, objects: LLVM_OBJECTS, plan: DISPLAY_PLAN, strings: LLVM_STRINGS, callee: (FUNCTION_INSTANCE) -> FUNCTION?) is
            _module = module
            _objects = objects
            _plan = plan
            _strings = strings
            _callee = callee
        si

        /// Adds the displayer of each class that has one, and records it
        /// for the class's descriptor.
        add() is
            let helpers = _plan.helpers

            if !helpers? then
                return
            fi

            for type in _objects.classes.classes_and_arrays do
                if _objects.is_instantiated(type) then
                    if let displayer = _displayer(type, helpers) then
                        _module.add_function(displayer)
                        _objects.set_displayer(type, displayer)
                    fi
                fi
            od
        si

        // The displayer of `type`, or null where it has none, or something
        // it calls was not compiled.
        _displayer(type: CLASS_INSTANCE, helpers: DISPLAY_HELPERS) -> FUNCTION? is
            let calls = _plan.calls(type, helpers)

            if calls.count == 0 then
                return null
            fi

            let functions = LIST[FUNCTION]()

            for call in calls do
                if let function = _callee(call) then
                    functions.add(function)
                else
                    return null
                fi
            od

            let displayer =
                FUNCTION(
                    "$ghul_display_{_objects.numbering.id(type)}",
                    LLVM.Type.VOID,
                    [PARAMETER(Types.pointer, "value"), PARAMETER(Types.pointer, "state")])

            displayer.linkage = LLVM.Linkage.INTERNAL

            let value = displayer.parameter(0)
            let state = displayer.parameter(1)
            let block mut = displayer.add_block("entry")

            // A struct is displayed from its box, which holds the struct after
            // the descriptor, and its methods are given the struct's address.
            let receiver =
                if _objects.is_struct(type) then
                    block.element_pointer(Types.structure([Types.pointer, _objects.struct_type(type)]), value, [Values.i32(0), Values.i32(1)], true)
                else
                    value
                fi

            if _plan.element_type(type)? then
                block.call(functions[0], [state, value])
                block.return_void()

                return displayer
            fi

            if _plan.is_tuple(type) then
                block.call(functions[0], [state])

                for i in 0..type.arguments.count do
                    if let held = _objects.held_type(type.arguments[i]) then
                        let part = block.load(held, block.element_pointer(_objects.struct_type(type), receiver, [Values.i32(0), Values.i32(i)], true), 0)

                        block.call(functions[i + 1], [state, part])
                    else
                        return null
                    fi
                od

                block.call(functions[functions.count - 1], [state])
                block.return_void()

                return displayer
            fi

            block.call(functions[0], [state, _strings.literal(_plan.display_name(type))])

            let done = displayer.add_block("done")

            // The calls after the opening one, in the order the plan gives
            // them.
            let next mut = 1

            for member in _plan.members(type) do
                let read: LLVM.Value mut

                if let _ = member.getter then
                    read = block.call(functions[next], [receiver])!
                    next = next + 1
                elif let `field = member.`field, position = _objects.field_position(`field), held = _objects.held_type(member.type) then
                    let at = block.element_pointer(_objects.struct_type(type), receiver, [Values.i32(0), Values.i32(position)], true)

                    read = block.load(held, at, 0)
                else
                    return null
                fi

                let shown = block.call(functions[next], [state, _strings.literal(member.name), read])!

                next = next + 1

                // The state answers false once its element budget is spent.
                let carry_on = displayer.add_block("member{next}")

                block.branch(block.compare(IntegerPredicate.EQ, shown, Values.i32(0)), done, carry_on)
                block = carry_on
            od

            block.branch(done)

            done.call(functions[functions.count - 1], [state])
            done.return_void()

            return displayer
        si
    si
si
