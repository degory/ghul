namespace IR.LLVMTarget is
    use Semantic.Types.Type

    /// An LLVM value already lowered, standing in the IR where a value of
    /// `type` is expected, so the lowering can hand it to IR it builds.
    class LLVM_VALUE: IR.Values.Value is
        /// The lowered value.
        value: LLVM.Value

        _type: Type

        type: Type? pure => _type

        /// - value: the lowered value
        /// - type: the type of the value it holds
        init(value: LLVM.Value, type: Type) is
            super.init()

            self.value = value
            _type = type
        si

        to_string() -> string => "llvm-value:[{_type}]"
    si
si
