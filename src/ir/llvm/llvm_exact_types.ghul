namespace IR.LLVMTarget is
    use IR.Program

    use Collections.LIST
    use Collections.MAP
    use Collections.SET

    /// Where a lowered value came from, as far as its exact class goes: an
    /// allocation of a class, the result of a call to a function, or a load
    /// of a local of a function.
    class EXACT_SOURCE is
        /// The class allocated, for an allocation.
        type: CLASS_INSTANCE?

        /// The function called, for a call result, or the function whose
        /// local was loaded.
        function: FUNCTION_INSTANCE?

        /// The local loaded, for a load.
        local: LOCAL?

        /// The methods a dispatched call can run, for a dispatched call's
        /// result; asked only once the dispatch plan is built.
        targets: (() -> Collections.Iterable[FUNCTION_INSTANCE]?)?

        init(type: CLASS_INSTANCE?, function: FUNCTION_INSTANCE?, local: LOCAL?) is
            self.type = type
            self.function = function
            self.local = local
        si

        init(targets: () -> Collections.Iterable[FUNCTION_INSTANCE]?) is
            self.targets = targets
        si
    si

    /// The exact runtime class of what functions return and locals hold,
    /// where every value reaching them is one class. Discovery records what
    /// reaches each function's returns and each local's stores; `solve`
    /// settles them once discovery is over. A value of a known exact class
    /// calls the one implementation its class has, whatever its static type.
    class LLVM_EXACT_TYPES is
        _returns: MAP[FUNCTION_INSTANCE, LIST[EXACT_SOURCE?]]
        _locals: MAP[FUNCTION_INSTANCE, MAP[LOCAL, LIST[EXACT_SOURCE?]]]

        _solved_returns: MAP[FUNCTION_INSTANCE, CLASS_INSTANCE]
        _solved_locals: MAP[FUNCTION_INSTANCE, MAP[LOCAL, CLASS_INSTANCE]]

        init() is
            _returns = MAP[FUNCTION_INSTANCE, LIST[EXACT_SOURCE?]]()
            _locals = MAP[FUNCTION_INSTANCE, MAP[LOCAL, LIST[EXACT_SOURCE?]]]()
            _solved_returns = MAP[FUNCTION_INSTANCE, CLASS_INSTANCE]()
            _solved_locals = MAP[FUNCTION_INSTANCE, MAP[LOCAL, CLASS_INSTANCE]]()
        si

        /// Records, while discovering, that `function` returns a value from
        /// `source`, or one of no known source where it is null.
        note_return(function: FUNCTION_INSTANCE, source: EXACT_SOURCE?) is
            let sources: LIST[EXACT_SOURCE?] mut

            if !_returns.try_get_value(function, sources ref) then
                sources = LIST[EXACT_SOURCE?]()
                _returns[function] = sources
            fi

            sources.add(source)
        si

        /// Records, while discovering, that `function` stores a value from
        /// `source` in `local`, or one of no known source, or writes it
        /// through its address, where `source` is null.
        note_store(function: FUNCTION_INSTANCE, local: LOCAL, source: EXACT_SOURCE?) is
            let locals: MAP[LOCAL, LIST[EXACT_SOURCE?]] mut

            if !_locals.try_get_value(function, locals ref) then
                locals = MAP[LOCAL, LIST[EXACT_SOURCE?]](Collections.ReferenceEqualityComparer.instance)
                _locals[function] = locals
            fi

            let sources: LIST[EXACT_SOURCE?] mut

            if !locals.try_get_value(local, sources ref) then
                sources = LIST[EXACT_SOURCE?]()
                locals[local] = sources
            fi

            sources.add(source)
        si

        /// Settles every return and local whose sources all come to one
        /// class. A cycle with no class to start from settles nothing.
        solve() is
            let changed mut = true

            while changed do
                changed = false

                for (function, sources) in _returns do
                    if !_solved_returns.contains_key(function) then
                        if let type = _settle(sources) then
                            _solved_returns[function] = type
                            changed = true
                        fi
                    fi
                od

                for (function, locals) in _locals do
                    let solved: MAP[LOCAL, CLASS_INSTANCE] mut

                    if !_solved_locals.try_get_value(function, solved ref) then
                        solved = MAP[LOCAL, CLASS_INSTANCE](Collections.ReferenceEqualityComparer.instance)
                        _solved_locals[function] = solved
                    fi

                    for (local, sources) in locals do
                        if !solved.contains_key(local) then
                            if let type = _settle(sources) then
                                solved[local] = type
                                changed = true
                            fi
                        fi
                    od
                od
            od

        si

        /// The exact class of a value from `source`, or null where it is not
        /// known to be one class.
        exact(source: EXACT_SOURCE?) -> CLASS_INSTANCE? is
            if !source? then
                return null
            elif let type = source.type then
                return type
            elif let targets = source.targets then
                // A dispatched call is exact where every method it can run
                // returns the one class.
                let found: CLASS_INSTANCE? mut = null

                if let functions = targets() then
                    for function in functions do
                        let type: CLASS_INSTANCE mut

                        if !_solved_returns.try_get_value(function, type ref) \/ (found? /\ !(found! =~ type)) then
                            return null
                        fi

                        found = type
                    od
                fi

                return found
            elif let function = source.function then
                if let local = source.local then
                    let solved: MAP[LOCAL, CLASS_INSTANCE] mut
                    let type: CLASS_INSTANCE mut

                    if _solved_locals.try_get_value(function, solved ref) /\ solved.try_get_value(local, type ref) then
                        return type
                    fi

                    return null
                fi

                let type: CLASS_INSTANCE mut

                if _solved_returns.try_get_value(function, type ref) then
                    return type
                fi
            fi

            return null
        si

        _settle(sources: LIST[EXACT_SOURCE?]) -> CLASS_INSTANCE? is
            let found: CLASS_INSTANCE? mut = null

            for source in sources do
                if let type = exact(source) then
                    if let f = found /\ !(f =~ type) then
                        return null
                    fi

                    found = type
                else
                    return null
                fi
            od

            return found
        si
    si
si
