namespace Driver is
    // The version and requirements a compiler built for a target other than
    // .NET reports, where there is no assembly to carry them. A native build
    // of the compiler compiles a copy of this file with its own values in
    // place of this one, which keeps the values every other build reads.
    @IF.not.dotnet()
    class NATIVE_BUILD is
        version: string static => "0.0.0-local"

        requirements: string static => "{{}}\n"
    si
si
