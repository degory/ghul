namespace Driver is
    use Ghul.Pipes

    // The version, host and requirements the compiler reports, per target.
    //
    // A build for a target other than .NET has no assembly to carry an
    // informational version, so it reports the constants here; a native
    // build of the compiler compiles a copy of this file with its own
    // values in place of this one, which keeps the values every other
    // build reads. On .NET the version comes from the entry assembly and
    // the host from what is running it.
    @IF.dotnet()
    class NATIVE_BUILD is
        version: string static is
            let attribute =
                System.Reflection.Assembly
                    .get_entry_assembly()!
                    .get_custom_attributes(typeof System.Reflection.AssemblyInformationalVersionAttribute, false)
                        |> map(va => cast System.Reflection.AssemblyInformationalVersionAttribute?(va)!)
                        |> first()

            in
                if attribute? then
                    attribute.informational_version
                else
                    "0.0.0-unknown.1"
                fi
        si

        // A .NET build runs either under the JIT or as Native AOT, and
        // which one changes what it is worth blaming for speed or for
        // crashes, so the two are named apart. Dynamic code support is
        // what the JIT has and AOT has not.
        host: string static =>
            if System.Runtime.CompilerServices.RuntimeFeature.is_dynamic_code_supported then
                "dotnet-jit"
            else
                "dotnet-aot"
            fi
    si

    @IF.not.dotnet()
    class NATIVE_BUILD is
        version: string static => "0.0.0-local"

        requirements: string static => "{{}}\n"

        // A non-.NET build is the compiler compiled to the target it
        // compiles for, so the target name is the host's name.
        @IF.wasm()
        host: string static => "wasm"

        @IF.llvm()
        host: string static => "llvm"
    si
si
