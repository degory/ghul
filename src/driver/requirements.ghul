namespace Driver is
    // The oldest ghul-core, ghul-runtime and ghul-llvm releases this
    // compiler works with, as build/requirements.json declares them, for
    // `--requirements`.
    class REQUIREMENTS is
        @IF.dotnet()
        text: string static is
            let assembly = System.Reflection.Assembly.get_executing_assembly()
            let stream = assembly.get_manifest_resource_stream("requirements.json")

            assert stream? else "the requirements are not embedded in the compiler"

            let use reader = IO.StreamReader(stream)

            return reader.read_to_end()
        si

        @IF.not.dotnet()
        text: string static => "{{}}\n"
    si
si
