namespace Logging is
    use Source.LOCATION

    // A listener for every error as it is reported, whichever
    // speculation level it lands in and whether or not it is later
    // rolled back. The inference trace installs one so a body's walks
    // show what each reported, not only what survived.
    class DIAGNOSTIC_TRACE is
        on_error: ((LOCATION, string) -> void)? static public
    si
si
