@@IF.dotnet()

namespace Analysis.Protocol is
    use TYPE = System.Type

    use System.Reflection.BindingFlags
    use System.Reflection.ConstructorInfo
    use System.Reflection.FieldInfo
    use System.Reflection.MemberInfo
    use System.Reflection.PropertyInfo

    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonElement
    use System.Text.Json.JsonValueKind
    use System.Text.Json.Nodes.JsonArray
    use System.Text.Json.Nodes.JsonNode
    use System.Text.Json.Nodes.JsonObject
    use System.Text.Json.Nodes.JsonValue
    use System.Text.Json.Serialization.JsonDerivedTypeAttribute
    use System.Text.Json.Serialization.JsonPolymorphicAttribute

    use Collections.LIST
    use Ghul.Pipes

    // Reads and writes the protocol's types by reflection over their public
    // members, giving the JSON that System.Text.Json gives under
    // JSON_OPTIONS: public properties and fields, none whose name starts
    // with `$`, and the discriminator first wherever the declared type is
    // a polymorphic base. System.Text.Json's own reflection path builds a
    // converter specialised to each constructor's parameter types, which a
    // Native AOT build has no code for.
    class REFLECTION_JSON is
        _members: System.Collections.Concurrent.ConcurrentDictionary[TYPE, MemberInfo[]] static

        init() static is
            _members = System.Collections.Concurrent.ConcurrentDictionary[TYPE, MemberInfo[]]()
        si

        // `value`, written as a value of type `declared`, on one line.
        write(value: object?, declared: TYPE) -> string static is
            if let node: JsonNode = to_node(value, declared) then
                return node.to_json_string(null)
            fi

            return "null"
        si

        // The value of type `type` that one line of JSON holds.
        read(json: string, type: TYPE) -> object? static is
            let document = JsonDocument.parse(json, _)

            try
                return from_element(document.root_element, type)
            finally
                document.dispose()
            yrt
        si

        to_node(value: object?, declared: TYPE) -> JsonNode? static is
            if !value? then
                return null
            fi

            if let text: string = value then
                return JsonValue.create(text, null)
            elif let flag: bool = value then
                return JsonValue.create(flag, null)
            elif let number: int = value then
                return JsonValue.create(number, null)
            elif let number: long = value then
                return JsonValue.create(number, null)
            elif let number: double = value then
                return JsonValue.create(number, null)
            fi

            if let sequence: Collections.NonGenericIterable = value then
                let element_type = element_type_of(declared) ?? element_type_of(value.get_type()) ?? typeof object
                let result = JsonArray(null)

                for element in System.Linq.Enumerable.cast[object](sequence) do
                    result.add(to_node(element, element_type))
                od

                return result
            fi

            let result = JsonObject(null)
            let actual = value.get_type()

            if let polymorphic: JsonPolymorphicAttribute = polymorphic_attribute(declared) then
                result.add(
                    polymorphic.type_discriminator_property_name ?? "$type",
                    JsonValue.create(discriminator_of(declared, actual), null))

                _write_members(result, value, actual)
            elif declared =~ typeof object \/ declared.is_abstract \/ declared.is_interface then
                _write_members(result, value, actual)
            else
                _write_members(result, value, declared)
            fi

            return result
        si

        _write_members(result: JsonObject, value: object, type: TYPE) static is
            for member in members_of(type) do
                if let property: PropertyInfo = member then
                    result.add(property.name, to_node(property.get_value(value), property.property_type))
                elif let slot: FieldInfo = member then
                    result.add(slot.name, to_node(slot.get_value(value), slot.field_type))
                fi
            od
        si

        from_element(element: JsonElement, type: TYPE) -> object? static is
            if element.value_kind == JsonValueKind.NULL then
                return null
            fi

            let target = System.Nullable.get_underlying_type(type) ?? type

            if target =~ typeof string then
                return element.get_string()
            elif target =~ typeof bool then
                return element.get_boolean()
            elif target =~ typeof int then
                return element.get_int32()
            elif target =~ typeof long then
                return element.get_int64()
            elif target =~ typeof double then
                return element.get_double()
            fi

            if let polymorphic: JsonPolymorphicAttribute = polymorphic_attribute(target) then
                let name = polymorphic.type_discriminator_property_name ?? "$type"
                let discriminator: JsonElement mut

                if !element.try_get_property(name, discriminator ref) then
                    throw System.Text.Json.JsonException("no {name} property")
                fi

                return _read_object(element, derived_type_of(target, discriminator.get_string() ?? ""), name)
            fi

            if target.is_array then
                let element_type = target.get_element_type()!
                let result = System.Array.create_instance(element_type, element.get_array_length())
                let index mut = 0

                for item in element.enumerate_array() do
                    result.set_value(from_element(item, element_type), index)
                    index = index + 1
                od

                return result
            fi

            if let element_type: TYPE = element_type_of(target) then
                let list = cast DotNet.NonGeneric.Collections.IList?(
                    System.Activator.create_instance((typeof LIST[_]).make_generic_type([element_type])))!

                for item in element.enumerate_array() do
                    list.add(from_element(item, element_type))
                od

                return list
            fi

            return _read_object(element, target, null)
        si

        _read_object(element: JsonElement, type: TYPE, discriminator: string?) -> object static is
            let constructors = type.get_constructors()

            let chosen mut = constructors |> find(c => c.get_parameters().count == 0)

            if !chosen? then
                if constructors.count != 1 then
                    throw System.Text.Json.JsonException("{type.full_name} has no constructor to deserialize with")
                fi

                chosen = constructors[0]
            fi

            let parameters = chosen.get_parameters()
            let arguments = Collections.LIST[object?]()
            let consumed = Collections.SET[string]()

            for parameter in parameters do
                let found mut = false

                for property in element.enumerate_object() do
                    if !found /\ string.equals(property.name, parameter.name, Ghul.StringComparison.ORDINAL_IGNORE_CASE) then
                        arguments.add(from_element(property.value, parameter.parameter_type))
                        consumed.add(property.name)
                        found = true
                    fi
                od

                if !found then
                    arguments.add(
                        if parameter.parameter_type.is_value_type then
                            System.Activator.create_instance(parameter.parameter_type)
                        else
                            null
                        fi)
                fi
            od

            let result = chosen.invoke(arguments.to_array())

            for property in element.enumerate_object() do
                if !consumed.contains(property.name) /\ property.name !~ (discriminator ?? "") then
                    _set_member(result, type, property.name, property.value)
                fi
            od

            return result
        si

        _set_member(target: object, type: TYPE, name: string, value: JsonElement) static is
            for member in members_of(type) do
                if member.name =~ name then
                    if let property: PropertyInfo = member then
                        if property.get_set_method(false)? then
                            property.set_value(target, from_element(value, property.property_type))
                        fi
                    elif let slot: FieldInfo = member then
                        if !slot.is_init_only then
                            slot.set_value(target, from_element(value, slot.field_type))
                        fi
                    fi

                    return
                fi
            od
        si

        // The members System.Text.Json reads and writes on `type`, in the
        // order it writes them: each type from `type` down to `object`,
        // its properties and then its fields.
        members_of(type: TYPE) -> MemberInfo[] static is
            let cached: MemberInfo[] mut

            if _members.try_get_value(type, cached ref) then
                return cached
            fi

            let result = LIST[MemberInfo]()
            let seen = Collections.SET[string]()
            let flags = cast BindingFlags(2 + 4 + 16)

            let level: TYPE? mut = type

            while level? do
                for property in level.get_properties(flags) do
                    if
                        property.get_index_parameters().count == 0 /\
                        property.get_get_method(false)? /\
                        !property.name.starts_with('$') /\
                        seen.add(property.name)
                    then
                        result.add(property)
                    fi
                od

                for slot in level.get_fields(flags) do
                    if !slot.name.starts_with('$') /\ seen.add(slot.name) then
                        result.add(slot)
                    fi
                od

                level = level.base_type
            od

            let members = result.to_array()

            _members.try_add(type, members)

            return members
        si

        // The element type of a sequence type, or null where `type` is not
        // one or is a string.
        element_type_of(type: TYPE) -> TYPE? static is
            if type =~ typeof string then
                return null
            fi

            if type.is_array then
                return type.get_element_type()
            fi

            if type.is_generic_type /\ type.get_generic_type_definition() =~ typeof Collections.Iterable[_] then
                return type.get_generic_arguments()[0]
            fi

            for candidate in type.get_interfaces() do
                if candidate.is_generic_type /\ candidate.get_generic_type_definition() =~ typeof Collections.Iterable[_] then
                    return candidate.get_generic_arguments()[0]
                fi
            od

            return null
        si

        polymorphic_attribute(type: TYPE) -> JsonPolymorphicAttribute? static is
            for attribute in type.get_custom_attributes(typeof JsonPolymorphicAttribute, false) do
                if let polymorphic: JsonPolymorphicAttribute = attribute then
                    return polymorphic
                fi
            od

            return null
        si

        discriminator_of(base: TYPE, actual: TYPE) -> string static is
            for attribute in base.get_custom_attributes(typeof JsonDerivedTypeAttribute, false) do
                if let derived: JsonDerivedTypeAttribute = attribute /\ derived.derived_type =~ actual then
                    if let name: string = derived.type_discriminator then
                        return name
                    fi
                fi
            od

            throw System.Text.Json.JsonException("{actual.full_name} is not a registered {base.full_name}")
        si

        derived_type_of(base: TYPE, discriminator: string) -> TYPE static is
            for attribute in base.get_custom_attributes(typeof JsonDerivedTypeAttribute, false) do
                if let derived: JsonDerivedTypeAttribute = attribute then
                    if let name: string = derived.type_discriminator /\ name =~ discriminator then
                        return derived.derived_type
                    fi
                fi
            od

            throw System.Text.Json.JsonException("unknown {base.name} {discriminator}")
        si
    si
si
