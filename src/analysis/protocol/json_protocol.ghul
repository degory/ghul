namespace Analysis.Protocol is
    // Wire helper for the JSON analysis protocol. One JSON object per line,
    // newline-terminated; a message never contains a raw newline (JSON escapes
    // them inside strings), so `read_line` is a complete framing primitive.
    //
    // Requests deserialize into the Request union and responses serialize
    // from the Response union, each tagged with its variant's name in lower
    // case under `kind`. Wire field names are the ghūl member names verbatim
    // (snake_case).
    class JSON_PROTOCOL is
        // Deserialize one request line. A malformed line throws; the reader
        // thread catches it and queues a PARSE_ERROR frame, which the
        // despatcher answers with an error response.
        deserialize_request(line: string) -> Request? static =>
            cast Request?(Json.from_json(Json.parse(line), typeof Request))

        // Serialize a response onto a single line and flush. Every response
        // frame is one line; the client splits stdout on '\n'.
        write_response(writer: IO.TextWriter, response: Response) static is
            writer.write(Json.write(Json.to_json(response)))
            writer.write("\n")
            writer.flush()
        si
    si
si
