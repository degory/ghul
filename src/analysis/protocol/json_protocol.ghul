namespace Analysis.Protocol is
    use System.Text.Json.JsonSerializer;
    use System.Text.Json.JsonSerializerOptions;

    // Wire helper for the JSON analysis protocol. One JSON object per line,
    // newline-terminated; a message never contains a raw newline (JSON escapes
    // them inside strings), so `read_line` is a complete framing primitive.
    //
    // Requests deserialize into the REQUEST discriminated union (by the
    // `command` field); responses serialize from the RESPONSE union (tagged
    // with `kind`). Wire field names are the ghūl property names verbatim
    // (snake_case); no `JsonNamingPolicy` is applied.
    class JSON_PROTOCOL is
        _options: JsonSerializerOptions? static;

        options: JsonSerializerOptions static is
            let options mut = _options;

            if !options? then
                options = JsonSerializerOptions();

                // Variant constructor args emit as public CLR fields, not
                // properties — System.Text.Json's default is to skip
                // fields. Required for both the Request union (variants
                // carry path/line/column etc. via fields) and the Response
                // union (every variant body is a constructor field).
                options.include_fields = true;

                _options = options;
            fi

            return options;
        si

        // Read one request line, skipping blank lines. Returns null at
        // end-of-input. A malformed line throws out of JsonSerializer; the
        // despatcher catches and requests a restart.
        read_request(reader: IO.TextReader) -> Request? static is
            do
                let line = reader.read_line();

                if !line? then
                    return null;
                fi

                if string.is_null_or_white_space(line) then
                    continue;
                fi

                return JsonSerializer.deserialize[Request](line, options);
            od
        si

        // As read_request, but gives up after timeout_ms with no line
        // arriving. Waiting for a request is the only point at which the
        // analyser is idle — every other moment is inside a handler — so
        // timing out here needs no separate clock and can never interrupt a
        // response mid-frame.
        //
        // The pending read is abandoned rather than cancelled: TextReader
        // offers no cancellable line read, and the only caller exits the
        // process on TIMED_OUT. A line that lands in the window between the
        // wait expiring and the process going is lost, which reads to the
        // client as a request answered by the pipe closing — the same case
        // it must already handle for a crash or a recycle.
        read_request_or_timeout(reader: IO.TextReader, timeout_ms: int) -> ReadResult static is
            do
                let pending = reader.read_line_async();

                if !pending.wait(timeout_ms) then
                    return ReadResult.TIMED_OUT;
                fi

                let line = pending.result;

                if !line? then
                    return ReadResult.END_OF_INPUT;
                fi

                if string.is_null_or_white_space(line) then
                    continue;
                fi

                return ReadResult.REQUEST(JsonSerializer.deserialize[Request](line, options)!);
            od
        si

        // Serialize a response onto a single line and flush. Every response
        // frame is one line; the client splits stdout on '\n'.
        write_response(writer: IO.TextWriter, response: Response) static is
            writer.write(JsonSerializer.serialize[Response](response, options));
            writer.write("\n");
            writer.flush();
        si
    si

    // Outcome of a timed request read. Distinguishing TIMED_OUT from
    // END_OF_INPUT matters: the first means nobody is asking anything right
    // now, the second that nobody can ask anything ever again.
    union ReadResult is
        REQUEST(request: Request);
        END_OF_INPUT;
        TIMED_OUT;
    si
si
