namespace Analysis is
    use Collections.LIST;
    use Collections.Iterable;

    use Ghul.Pipes;

    use Logging.DiagnosticSeverity;
    use Logging.DIAGNOSTIC_MESSAGE;

    // Drains the analyser's diagnostics store into the given lists,
    // walking the store's retained DIAGNOSTIC_MESSAGE objects directly.
    // Every path the logger currently has a (possibly empty) diagnostics
    // list for joins `checked_paths`, which the client uses to clear
    // stale squiggles for files that came back clean. The lists are
    // mutated rather than returned because every handler ultimately
    // assembles a Response.DIAGNOSTICS variant at the write site, where
    // it also has the per-handler phase / elapsed_ms / compile_needed
    // values to pass to the constructor.
    class DIAGNOSTICS_COLLECTOR is
        collect_into(
            logger: Logging.Logger,
            diagnostics: LIST[Protocol.DIAGNOSTIC],
            checked_paths: LIST[string]
        ) static is
            // A parse error alongside a high total error count is
            // treated as one error cascade rather than many independent
            // problems: only the pre-analysis diagnostics are worth
            // showing, capped at the first 15 per file, on the
            // assumption the rest are downstream noise.
            let cascade = logger.is_possible_error_cascade;

            for path in logger.diagnostic_paths do
                checked_paths.add(path);

                let messages: Iterable[DIAGNOSTIC_MESSAGE] =
                    if cascade then
                        logger.diagnostics_for(path)
                            |> filter(d => !d.is_analysis)
                            |> take(15);
                    else
                        logger.diagnostics_for(path);
                    fi;

                for diagnostic in messages do
                    // Inlay carriers are never published as diagnostics;
                    // they reach the client only through the
                    // INLAY_HINTS query.
                    if diagnostic.is_inlay then
                        continue;
                    fi

                    let location = diagnostic.location;

                    // A fatal/exception frame is downgraded to hint
                    // severity on the wire rather than surfaced as a
                    // blocking error.
                    let severity =
                        if diagnostic.is_fatal then
                            cast int(DiagnosticSeverity.HINT);
                        else
                            cast int(diagnostic.severity);
                        fi;

                    let dto = Protocol.DIAGNOSTIC(
                        path,
                        location.start_line,
                        location.start_column,
                        location.end_line,
                        location.end_column + 1,
                        severity,
                        diagnostic.text.replace('\n', ' '),
                        diagnostic.code ?? ""
                    );

                    if let related_locations = diagnostic.related then
                        let related = LIST[Protocol.RELATED_LOCATION_DTO]();

                        for r in related_locations do
                            related.add(Protocol.RELATED_LOCATION_DTO(_location_dto(r.location), r.message));
                        od

                        dto.related = related;
                    fi

                    diagnostics.add(dto);
                od
            od
        si

        // Same end-column-exclusive convention as the diagnostic's own
        // range (see collect_into), so a related location composes with
        // it under one coordinate system.
        _location_dto(location: Source.LOCATION) -> Protocol.LOCATION_DTO static is
            return Protocol.LOCATION_DTO(
                location.file_name,
                location.start_line,
                location.start_column,
                location.end_line,
                location.end_column + 1
            );
        si
    si
si
