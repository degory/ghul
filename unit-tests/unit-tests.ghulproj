<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>

    <!-- Test names follow the Calling__foo__should_X idiom and the
         MSTest conventions rather than the naming rules. -->
    <GhulNoWarn>non-snake-case-name;non-pascal-case-name;non-upper-snake-case-name</GhulNoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ghul.ghulproj" />
    
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />

    <GhulSources Include="src/**/*.ghul" />

    <!-- Terminator-free sources; an error everywhere so stray `;`
         cannot creep back in. Same arrangement as ghul.ghulproj. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />

  </ItemGroup>
</Project>