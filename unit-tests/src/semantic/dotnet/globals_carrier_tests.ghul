namespace Semantic.DotNet.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.DotNet.GLOBALS_CARRIER;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    @TestClass()
    class GLOBALS_CARRIER_TESTS is
        init() is si

        @Test()
        Marked_type_is_a_carrier() is
            is_true(GLOBALS_CARRIER.is_carrier("ANYTHING", true));
        si

        @Test()
        Carrier_named_type_is_a_carrier_without_the_marker() is
            is_true(GLOBALS_CARRIER.is_carrier(GLOBALS_CARRIER.name, false));
        si

        @Test()
        Unmarked_ordinary_type_is_not_a_carrier() is
            is_false(GLOBALS_CARRIER.is_carrier("SOME_CLASS", false));
        si
    si
si
