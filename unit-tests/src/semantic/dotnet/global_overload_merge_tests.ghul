namespace Semantic.DotNet.UnitTests is
    use Collections.LIST
    use Ghul.Pipes.any

    use Source.LOCATION

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.GLOBAL_VARIABLE
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Symbols.Symbol
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class GLOBAL_OVERLOAD_MERGE_TESTS is
        _owner: Semantic.BLOCK_SCOPE
        _a: Type
        _b: Type

        init() is
            _owner = Semantic.BLOCK_SCOPE()
            _a = CLASS(loc(), loc(), _owner, "A", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _b = CLASS(loc(), loc(), _owner, "B", LIST[string](), Semantic.BLOCK_SCOPE()).type!
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        function(argument: Type) -> GLOBAL_FUNCTION is
            let result = GLOBAL_FUNCTION(loc(), loc(), _owner, "f", Semantic.BLOCK_SCOPE())
            let arguments = LIST[Type]()
            arguments.add(argument)
            result.arguments = arguments
            return result
        si

        group(functions: Collections.Iterable[GLOBAL_FUNCTION]) -> FUNCTION_GROUP is
            let result = FUNCTION_GROUP(loc(), _owner, "f")
            for f in functions do result.add(f); od
            return result
        si

        symbols(found: Collections.Iterable[Symbol]) -> LIST[Symbol] is
            let result = LIST[Symbol]()
            for s in found do result.add(s); od
            return result
        si

        @Test()
        Merging_a_single_symbol_returns_it_unchanged() is
            let f = function(_a)

            are_same(f, GLOBAL_OVERLOAD_MERGE.merge(symbols([f])))
        si

        @Test()
        Merging_two_functions_of_different_signatures_groups_both() is
            let fa = function(_a)
            let fb = function(_b)

            let result = GLOBAL_OVERLOAD_MERGE.merge(symbols([fa, fb]))

            if let merged: FUNCTION_GROUP = result then
                are_equal(2, merged.count)
                is_true(merged.functions |> any(f => f == fa))
                is_true(merged.functions |> any(f => f == fb))
                are_same(_owner, merged.owner)
            else
                fail("expected a function group but got {result}")
            fi
        si

        @Test()
        Merging_a_function_with_a_group_flattens_the_group() is
            let fa = function(_a)
            let fb = function(_b)
            let fab = function(_a)
            let fbb = function(_b)
            let g = group([fa, fb])

            let result = GLOBAL_OVERLOAD_MERGE.merge(symbols([g, fab, fbb]))

            if let merged: FUNCTION_GROUP = result then
                are_equal(2, merged.count)
                is_true(merged.functions |> any(f => f == fa))
                is_true(merged.functions |> any(f => f == fb))
            else
                fail("expected a function group but got {result}")
            fi
        si

        @Test()
        Merging_two_functions_of_the_same_signature_keeps_the_first() is
            let first = function(_a)
            let second = function(_a)

            let result = GLOBAL_OVERLOAD_MERGE.merge(symbols([first, second]))

            if let merged: FUNCTION_GROUP = result then
                are_equal(1, merged.count)
                are_same(first, merged.functions[0])
            else
                fail("expected a function group but got {result}")
            fi
        si

        @Test()
        Merging_functions_with_a_non_function_returns_the_first_symbol() is
            let variable = GLOBAL_VARIABLE(loc(), _owner, "f")
            let f = function(_a)

            are_same(variable, GLOBAL_OVERLOAD_MERGE.merge(symbols([variable, f])))
            are_same(f, GLOBAL_OVERLOAD_MERGE.merge(symbols([f, variable])))
        si
    si
si
