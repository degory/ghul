namespace Semantic.DotNet.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.DEFAULT_TRAIT_METHOD
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.TRAIT

    use Semantic.DotNet.SYMBOL_FACTORY

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins which trait default methods a reflected class inherits: one it
    // does not declare itself, and not one it overrides with the same
    // signature, which would otherwise sit beside the override as a second
    // candidate for the same call.
    @TestClass()
    class DECLARES_OVERRIDE_OF_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        _type(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!

        _shape() -> TRAIT =>
            TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Shape", LIST[string](), Semantic.BLOCK_SCOPE())

        _square() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "SQUARE", LIST[string](), Semantic.BLOCK_SCOPE())

        _taking(argument: Type) -> LIST[Type] =>
            (let arguments = LIST[Type]()

             arguments.add(argument)

             arguments)

        _default_check(shape: TRAIT, argument: Type) -> DEFAULT_TRAIT_METHOD =>
            (let method = DEFAULT_TRAIT_METHOD(loc(), loc(), shape, "check", Semantic.BLOCK_SCOPE())

             method.arguments = _taking(argument)

             method)

        _own_check(square: CLASS, argument: Type) -> INSTANCE_METHOD =>
            (let method = INSTANCE_METHOD(loc(), loc(), square, "check", Semantic.BLOCK_SCOPE())

             method.arguments = _taking(argument)

             square.add_member(method)

             method)

        @Test()
        A_method_with_the_same_signature_overrides_the_default() is
            let text = _type("STRING")
            let square = _square()

            _own_check(square, text)

            is_true(SYMBOL_FACTORY.declares_override_of(square, _default_check(_shape(), text)))
        si

        @Test()
        A_method_taking_a_different_argument_is_an_overload_not_an_override() is
            let square = _square()

            _own_check(square, _type("NUMBER"))

            is_false(SYMBOL_FACTORY.declares_override_of(square, _default_check(_shape(), _type("STRING"))))
        si

        @Test()
        A_class_with_no_method_of_that_name_overrides_nothing() is
            is_false(SYMBOL_FACTORY.declares_override_of(_square(), _default_check(_shape(), _type("STRING"))))
        si

        @Test()
        The_default_already_inherited_does_not_count_as_its_own_override() is
            let square = _square()
            let inherited = _default_check(_shape(), _type("STRING"))

            square.add_member(inherited)

            is_false(SYMBOL_FACTORY.declares_override_of(square, inherited))
        si
    si
si
