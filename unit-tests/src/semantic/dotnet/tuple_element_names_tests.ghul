namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A tuple type specialised from a generic one is built as a
    // Types.TUPLE rather than as the reflected wrapper it came from, and
    // its element names are still what the emitted metadata records.
    @TestClass()
    class TUPLE_ELEMENT_NAMES_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValueTuple", LIST[string](["T1", "T2"]), Semantic.BLOCK_SCOPE())

        named_tuple() -> TUPLE is
            let int = TEST_INNATE_SYMBOL_LOOKUP().get_int_type()

            let names = LIST[string?]()

            names.add("value")
            names.add("log")

            return TUPLE(loc(), owner(), LIST[Type]([int, int]), names)
        si

        @Test()
        Calling__attribute_names_for_type__on_a_named_tuple_type__should_return_its_names() is
            let names = Semantic.DotNet.TUPLE_ELEMENT_NAMES.attribute_names_for_type(named_tuple())

            is_true(names?)
            are_equal("value", names![0])
            are_equal("log", names![1])
        si

        // A tuple nesting a tuple lists its own names first, then the
        // inner tuple's: the pre-order layout the attribute is defined
        // to have.
        @Test()
        Calling__attribute_names_for_type__on_a_tuple_nesting_a_tuple_type__should_flatten_both() is
            let int = TEST_INNATE_SYMBOL_LOOKUP().get_int_type()

            let names = LIST[string?]()

            names.add("count")
            names.add("inner")

            let outer = TUPLE(loc(), owner(), LIST[Type]([int, named_tuple()]), names)

            let flattened = Semantic.DotNet.TUPLE_ELEMENT_NAMES.attribute_names_for_type(outer)!

            are_equal(4, flattened.count)
            are_equal("count", flattened[0])
            are_equal("inner", flattened[1])
            are_equal("value", flattened[2])
            are_equal("log", flattened[3])
        si

        _list_of(element: Type) -> GENERIC =>
            GENERIC(
                loc(),
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "LIST", LIST[string](["T"]), Semantic.BLOCK_SCOPE()),
                LIST[Type]([element]))

        @Test()
        Calling__attribute_names_for_type__on_a_generic_of_a_named_tuple__should_return_the_tuple_names() is
            let flattened = Semantic.DotNet.TUPLE_ELEMENT_NAMES.attribute_names_for_type(_list_of(named_tuple()))!

            are_equal(2, flattened.count)
            are_equal("value", flattened[0])
            are_equal("log", flattened[1])
        si

        // An unnamed tuple still takes its slots, so the names of a
        // tuple after it land at the right offset.
        @Test()
        Calling__attribute_names_for_type__with_an_unnamed_tuple_first__should_count_its_slots() is
            let int = TEST_INNATE_SYMBOL_LOOKUP().get_int_type()
            let unnamed = TUPLE(loc(), owner(), LIST[Type]([int, int]), null)
            let outer = TUPLE(loc(), owner(), LIST[Type]([unnamed, named_tuple()]), null)

            let flattened = Semantic.DotNet.TUPLE_ELEMENT_NAMES.attribute_names_for_type(outer)!

            are_equal(6, flattened.count)
            is_null(flattened[0])
            is_null(flattened[3])
            are_equal("value", flattened[4])
            are_equal("log", flattened[5])
        si

        @Test()
        Calling__attribute_names_for_type__on_an_unnamed_type__should_return_null() is
            let int = TEST_INNATE_SYMBOL_LOOKUP().get_int_type()

            is_null(Semantic.DotNet.TUPLE_ELEMENT_NAMES.attribute_names_for_type(_list_of(TUPLE(loc(), owner(), LIST[Type]([int, int]), null))))
        si

        // Names read back from a flattened array land on the tuple they
        // were written for, however deep it sits.
        @Test()
        Calling__apply__should_name_a_tuple_nested_in_another() is
            let int = TEST_INNATE_SYMBOL_LOOKUP().get_int_type()
            let inner = TUPLE(loc(), owner(), LIST[Type]([int, int]), null)
            let outer = TUPLE(loc(), owner(), LIST[Type]([int, inner]), null)

            let named =
                Semantic.DotNet.TUPLE_ELEMENT_NAMES.apply(
                    outer,
                    LIST[string?](["count", "inner", "value", "log"]))

            let outer_names = named.tuple_element_names!

            are_equal("count", outer_names[0])
            are_equal("inner", outer_names[1])

            let inner_names = named.arguments[1].tuple_element_names!

            are_equal("value", inner_names[0])
            are_equal("log", inner_names[1])
        si
    si
si
