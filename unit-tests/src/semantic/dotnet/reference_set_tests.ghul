namespace Semantic.DotNet.UnitTests is
    use Collections.Iterable
    use Collections.LIST

    use Ghul.Pipes

    use Semantic.DotNet.REFERENCE_SET

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class REFERENCE_SET_TESTS is
        init() is si

        discovered() -> Iterable[string] => ["System.Runtime.dll", "ghul-runtime.dll"]

        described(set: LIST[string]) -> string => set |> join(" ")

        @Test()
        Calling__resolve__with_nothing_named_should_return_the_discovered_set() is
            let set = REFERENCE_SET.resolve(LIST[string](), LIST[string](), () => discovered())

            are_equal("System.Runtime.dll ghul-runtime.dll", described(set))
        si

        @Test()
        Calling__resolve__with_a_null_named_set_should_return_the_discovered_set() is
            let set = REFERENCE_SET.resolve(null, LIST[string](), () => discovered())

            are_equal("System.Runtime.dll ghul-runtime.dll", described(set))
        si

        @Test()
        Calling__resolve__with_an_assembly_named_should_not_discover_any() is
            let discoveries mut = 0

            let set = REFERENCE_SET.resolve(
                ["only.dll"],
                LIST[string](),
                () is
                    discoveries = discoveries + 1
                    return discovered()
                si)

            are_equal("only.dll", described(set))
            are_equal(0, discoveries)
        si

        @Test()
        Calling__resolve__with_an_additional_assembly_should_add_it_to_the_discovered_set() is
            let set = REFERENCE_SET.resolve(LIST[string](), ["cell.dll"], () => discovered())

            are_equal("System.Runtime.dll ghul-runtime.dll cell.dll", described(set))
        si

        @Test()
        Calling__resolve__with_an_additional_assembly_should_add_it_to_a_named_set() is
            let set = REFERENCE_SET.resolve(["only.dll"], ["cell.dll"], () => discovered())

            are_equal("only.dll cell.dll", described(set))
        si

        @Test()
        Calling__resolve__with_an_additional_assembly_already_in_the_set_should_not_repeat_it() is
            let set = REFERENCE_SET.resolve(["only.dll"], ["only.dll", "cell.dll"], () => discovered())

            are_equal("only.dll cell.dll", described(set))
        si
    si
si
