namespace Semantic.DotNet.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.DotNet.REFLECTION_TYPE_NAME;
    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;
    use Semantic.Types.Type;

    // The serializer produces the name a custom-attribute blob carries
    // for a typeof argument, which the runtime parses back with
    // Type.GetType when the attribute is read. These pin each branch's
    // shape; integration-tests/execution/attribute-typeof-arguments
    // round-trips the same shapes through the runtime's own resolution.
    class REFLECTION_TYPE_NAME_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        declared(name: string) -> CLASS =>
            CLASS(loc(), loc(), null, name, LIST[string](), null);

        imported(full_name: string, assembly: string) -> CLASS is
            let symbol = declared("Unused");

            symbol.dotnet_full_name = full_name;
            symbol.il_assembly_name = assembly;

            return symbol;
        si

        named(symbol: CLASS) -> Type => Semantic.Types.NAMED(symbol);

        a_declared_type_is_unqualified() is
            @test()

            Assert.are_equal(
                "Test",
                REFLECTION_TYPE_NAME.try_serialize(named(declared("Test"))));
        si

        an_imported_type_carries_its_reflected_name_and_assembly() is
            @test()

            Assert.are_equal(
                "System.AttributeTargets, System.Runtime",
                REFLECTION_TYPE_NAME.try_serialize(
                    named(imported("System.AttributeTargets", "System.Runtime"))));
        si

        an_imported_nested_type_keeps_its_plus_separator() is
            @test()

            Assert.are_equal(
                "System.Environment+SpecialFolder, System.Runtime",
                REFLECTION_TYPE_NAME.try_serialize(
                    named(imported("System.Environment+SpecialFolder", "System.Runtime"))));
        si

        a_generic_instantiation_brackets_each_qualified_argument() is
            @test()

            let box = CLASS(loc(), loc(), null, "BOX", names_for(["T"]), null);
            let argument = named(imported("System.Int32", "System.Runtime"));

            let generic = Semantic.Types.GENERIC(loc(), box, [argument]);

            Assert.are_equal(
                "BOX[[System.Int32, System.Runtime]]",
                REFLECTION_TYPE_NAME.try_serialize(generic));
        si

        an_array_takes_its_element_name_and_assembly() is
            @test()

            let element = named(imported("System.Int32", "System.Runtime"));

            let carrier = CLASS(loc(), loc(), null, "Array", names_for(["T"]), null);
            let array = Semantic.Types.ARRAY(loc(), carrier, [element]);

            Assert.are_equal(
                "System.Int32[], System.Runtime",
                REFLECTION_TYPE_NAME.try_serialize(array));
        si

        a_type_parameter_has_no_serialized_name() is
            @test()

            let argument = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);

            Assert.is_null(REFLECTION_TYPE_NAME.try_serialize(argument.type!));
        si

        a_generic_over_a_type_parameter_has_no_serialized_name() is
            @test()

            let box = CLASS(loc(), loc(), null, "BOX", names_for(["T"]), null);
            let argument = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);

            let generic = Semantic.Types.GENERIC(loc(), box, [argument.type!]);

            Assert.is_null(REFLECTION_TYPE_NAME.try_serialize(generic));
        si

        names_for(values: Collections.Iterable[string]) -> LIST[string] is
            let result = LIST[string]();

            for v in values do
                result.add(v);
            od

            return result;
        si
    si
si
