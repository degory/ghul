namespace Semantic.DotNet.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use System.Reflection.BindingFlags;
    use System.Reflection.FieldInfo;

    use Semantic.DotNet.REFLECTED_CONSTANTS;
    use Semantic.DotNet.ReflectedConstant;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // `const` is not something ghūl source can declare, so the fields
    // under test are read off types that have them: the scalar types,
    // whose limits are constants, and `System.String`, whose `Empty` is
    // an ordinary static field. The shapes only another language can
    // declare - a constant string, one typed by an enum, one whose value
    // is null - are covered by cross-assembly-tests/cross-asm-const-field
    // against a C# library that declares them.
    @TestClass()
    class REFLECTED_CONSTANTS_TESTS is
        init() is si

        `field(owner: System.Type, name: string) -> FieldInfo static is
            let result =
                owner.get_field(
                    name,
                    cast BindingFlags(8 + 16 + 32)
                );

            assert result? else "no field {name} on {owner}";

            return result;
        si

        // The constant's text, or null when the field is not one - so a
        // test reads as the answer rather than as a walk over a union.
        value_of(owner: System.Type, name: string) -> string? static =>
            if let value: ReflectedConstant.VALUE = REFLECTED_CONSTANTS.value_of(`field(owner, name)) then
                value.text;
            else
                null;
            fi;

        is_none(owner: System.Type, name: string) -> bool static =>
            isa ReflectedConstant.NONE(REFLECTED_CONSTANTS.value_of(`field(owner, name)));

        @Test()
        integer_constant__reads_as_its_value() is
            are_equal("2147483647", value_of(typeof int, "MaxValue"));
            are_equal("-2147483648", value_of(typeof int, "MinValue"));
        si

        // Out of range read as a signed number, so the text has to come
        // from the value's own type rather than from a signed parse.
        @Test()
        unsigned_constant_above_the_signed_maximum__reads_as_its_value() is
            are_equal("18446744073709551615", value_of(typeof ulong, "MaxValue"));
        si

        // Culture decides what separates a real number's parts, and this
        // text is read back by a machine rather than shown to anyone.
        @Test()
        real_constant__reads_in_the_invariant_culture() is
            are_equal("5E-324", value_of(typeof double, "Epsilon"));
            are_equal("NaN", value_of(typeof double, "NaN"));
        si

        // Asserted by code point rather than as a literal, since the
        // character in question has no printable form.
        @Test()
        character_constant__reads_as_the_character() is
            let text = value_of(typeof char, "MaxValue");

            assert text? else "char.MaxValue read as no constant at all";

            are_equal(1, text.length);
            are_equal(65535, cast int(text[0]));
        si

        // Not a constant: `String.Empty` is an ordinary static field with
        // a field to load, and has to be left as one.
        @Test()
        static_field__is_not_a_constant() is
            is_true(is_none(typeof string, "Empty"));
        si

        // A constant string holds whatever a library author wrote, so no
        // spelling is available to stand for something else. The word the
        // argument-default channel uses for an absent value is the one
        // that has to survive: it is a value here like any other, and a
        // constant that is genuinely null is reported as its own case.
        @Test()
        text_of__has_no_reserved_spelling() is
            are_equal("default", REFLECTED_CONSTANTS.text_of("default", typeof string));
        si

        @Test()
        text_of__declines_a_value_it_cannot_describe() is
            is_null(REFLECTED_CONSTANTS.text_of(System.Exception(), typeof System.Exception));
        si
    si
si
