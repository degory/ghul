namespace Semantic.DotNet.UnitTests is
    use Collections.LIST;
    use Collections.List;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.DotNet.IL_ATTRIBUTE_ARGUMENTS;

    // Tests for the ilasm textual argument forms. ilasm encodes the
    // blob from these, so a wrong form is not a wrong byte here but a
    // wrong byte in every assembly the compiler emits.
    class IL_ATTRIBUTE_ARGUMENTS_TESTS is
        @test()

        init() is si

        strings(values: List[string?]) -> List[string?] static => values;

        Calling__string_argument__with_plain_text__should_quote_it() is
            @test()

            Assert.are_equal(
                "string('plain')",
                IL_ATTRIBUTE_ARGUMENTS.string_argument("plain")
            );
        si

        Calling__string_argument__with_null__should_render_nullref() is
            @test()

            Assert.are_equal(
                "string(nullref)",
                IL_ATTRIBUTE_ARGUMENTS.string_argument(null)
            );
        si

        Calling__string_argument__with_quote_and_backslash__should_escape_both() is
            @test()

            Assert.are_equal(
                "string('O\\'Brien c:\\\\path')",
                IL_ATTRIBUTE_ARGUMENTS.string_argument("O'Brien c:\\path")
            );
        si

        Calling__string_argument__with_newline_and_tab__should_escape_them() is
            @test()

            Assert.are_equal(
                "string('one\\ntwo\\tthree')",
                IL_ATTRIBUTE_ARGUMENTS.string_argument("one\ntwo\tthree")
            );
        si

        Calling__string_argument__with_non_ASCII__should_pass_it_through() is
            @test()

            Assert.are_equal(
                "string('ghūl')",
                IL_ATTRIBUTE_ARGUMENTS.string_argument("ghūl")
            );
        si

        Calling__string_array_argument__with_named_elements__should_quote_each() is
            @test()

            Assert.are_equal(
                "string[2]('index' 'value')",
                IL_ATTRIBUTE_ARGUMENTS.string_array_argument(strings(LIST[string?](["index", "value"])))
            );
        si

        // A null entry is the unnamed-element form a TupleElementNames
        // array carries. Nothing on the emit side produces one today —
        // an unnamed source element takes a positional name — so this
        // pins the rendering the importer's shape would need.
        Calling__string_array_argument__with_null_element__should_render_nullref() is
            @test()

            Assert.are_equal(
                "string[2]('index' nullref)",
                IL_ATTRIBUTE_ARGUMENTS.string_array_argument(strings(LIST[string?](["index", cast string?(null)])))
            );
        si

        Calling__string_array_argument__with_no_elements__should_render_empty_list() is
            @test()

            Assert.are_equal(
                "string[0]()",
                IL_ATTRIBUTE_ARGUMENTS.string_array_argument(LIST[string?]())
            );
        si

        Calling__byte_argument__should_render_uint8() is
            @test()

            Assert.are_equal("uint8(2)", IL_ATTRIBUTE_ARGUMENTS.byte_argument(2));
        si

        Calling__byte_argument__with_above_byte_range__should_mask_to_byte() is
            @test()

            Assert.are_equal("uint8(0)", IL_ATTRIBUTE_ARGUMENTS.byte_argument(256));
        si

        Calling__byte_array_argument__should_render_indexed_uint8_list() is
            @test()

            Assert.are_equal(
                "uint8[3](1 2 2)",
                IL_ATTRIBUTE_ARGUMENTS.byte_array_argument(LIST[int]([1, 2, 2]))
            );
        si

        Calling__byte_array_argument__with_no_elements__should_render_empty_list() is
            @test()

            Assert.are_equal(
                "uint8[0]()",
                IL_ATTRIBUTE_ARGUMENTS.byte_array_argument(LIST[int]())
            );
        si
    si
si
