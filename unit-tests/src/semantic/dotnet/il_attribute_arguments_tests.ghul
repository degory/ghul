namespace Semantic.DotNet.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.DotNet.IL_ATTRIBUTE_ARGUMENTS;

    // Tests for the ilasm single-quoted string form `quote` produces,
    // the form ATTRIBUTE_RESOLVER.format_arguments checks an attribute
    // argument against to decide whether it can be expressed at all.
    class IL_ATTRIBUTE_ARGUMENTS_TESTS is
        @test()

        init() is si

        Calling__quote__with_plain_text__should_wrap_it_in_single_quotes() is
            @test()

            Assert.are_equal("'plain'", IL_ATTRIBUTE_ARGUMENTS.quote("plain"));
        si

        Calling__quote__with_quote_and_backslash__should_escape_both() is
            @test()

            Assert.are_equal(
                "'O\\'Brien c:\\\\path'",
                IL_ATTRIBUTE_ARGUMENTS.quote("O'Brien c:\\path")
            );
        si

        Calling__quote__with_newline_and_tab__should_escape_them() is
            @test()

            Assert.are_equal(
                "'one\\ntwo\\tthree'",
                IL_ATTRIBUTE_ARGUMENTS.quote("one\ntwo\tthree")
            );
        si

        Calling__quote__with_non_ASCII__should_pass_it_through() is
            @test()

            Assert.are_equal("'ghūl'", IL_ATTRIBUTE_ARGUMENTS.quote("ghūl"));
        si
    si
si
