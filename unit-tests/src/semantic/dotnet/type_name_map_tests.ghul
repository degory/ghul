namespace Semantic.DotNet.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.DotNet.TYPE_NAME_MAP;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins `TYPE_NAME_MAP.de_camel`, which turns a reflected .NET member
    // name into the name ghūl reads it under. It strips `$`, because that
    // is how the compiler marks the names it synthesises - but `$` is also
    // an operator character, so an operator has to come through untouched.
    @TestClass()
    class TYPE_NAME_MAP_TESTS is
        init() is si

        @Test()
        Camel_case_name_is_split_on_the_upper_case_letters() is
            are_equal("do_something", TYPE_NAME_MAP.de_camel("DoSomething"));
        si

        @Test()
        Dollar_is_stripped_from_an_ordinary_name() is
            are_equal("state", TYPE_NAME_MAP.de_camel("$state"));
        si

        @Test()
        Operator_named_only_dollar_survives() is
            are_equal("$", TYPE_NAME_MAP.de_camel("$"));
        si

        @Test()
        Operator_carrying_a_dollar_survives() is
            are_equal("<$>", TYPE_NAME_MAP.de_camel("<$>"));
        si

        @Test()
        Operator_without_a_dollar_is_unchanged() is
            are_equal("=~", TYPE_NAME_MAP.de_camel("=~"));
        si

        map() -> TYPE_NAME_MAP =>
            TYPE_NAME_MAP(Compiler.GLOBAL_BUILD_FLAGS(), TYPE_DETAILS_LOOKUP());

        @Test()
        Member_name_from_an_unmarked_assembly_is_de_camel_cased() is
            let string_type = "hello".get_type();

            are_equal(
                "to_string",
                map().get_member_name("string", "ToString", false, false, string_type));
        si

        @Test()
        Private_and_special_name_flags_are_applied_after_de_camelling() is
            let string_type = "hello".get_type();
            let names = map();

            are_equal(
                "_to_string",
                names.get_member_name("string", "ToString", true, false, string_type));
            are_equal(
                "$to_string",
                names.get_member_name("string", "ToString", false, true, string_type));
        si

        @Test()
        Constant_name_from_an_unmarked_assembly_is_de_camel_cased_and_upper_cased() is
            let string_type = "hello".get_type();

            are_equal(
                "MAX_VALUE",
                map().get_constant_name("string", "MaxValue", false, string_type));
        si

        @Test()
        Bcl_assembly_is_not_ghul_compiled() is
            is_false(map().is_ghul_compiled("hello".get_type()));
        si
    si
si
