namespace Semantic.DotNet.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Semantic.DotNet.ASSEMBLIES

    // A referenced assembly is known by the name its metadata gives it,
    // not by the name of the file it was found in.
    @TestClass()
    class ASSEMBLY_NAME_OF_TESTS is
        init() is si

        @Test()
        An_assembly_in_a_renamed_file_keeps_its_own_name() is
            let original = (typeof ASSEMBLIES).assembly.location
            let directory = IO.Path.combine(IO.Path.get_temp_path(), IO.Path.get_random_file_name())

            IO.Directory.create_directory(directory)

            let renamed = IO.Path.combine(directory, "not-its-name.dll")

            IO.File.copy(original, renamed)

            try
                are_equal(
                    (typeof ASSEMBLIES).assembly.get_name().name,
                    ASSEMBLIES.assembly_name_of(renamed))
            finally
                IO.Directory.delete(directory, true)
            yrt
        si

        @Test()
        A_file_with_no_readable_metadata_is_known_by_its_file_name() is
            let directory = IO.Path.combine(IO.Path.get_temp_path(), IO.Path.get_random_file_name())

            IO.Directory.create_directory(directory)

            let path = IO.Path.combine(directory, "not-an-assembly.dll")

            IO.File.write_all_text(path, "not an assembly")

            try
                are_equal("not-an-assembly", ASSEMBLIES.assembly_name_of(path))
            finally
                IO.Directory.delete(directory, true)
            yrt
        si
    si
si
