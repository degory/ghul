namespace Semantic.DotNet.UnitTests is
    use System.Reflection.Assembly
    use System.Reflection.AssemblyName
    use System.Reflection.MetadataLoadContext
    use System.Reflection.PathAssemblyResolver

    use Collections.LIST
    use Collections.MAP

    use Semantic.DotNet.LOADED_ASSEMBLY_RESOLVER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins that a reference to an assembly already loaded resolves to it,
    // and that any other goes to the path resolver the context started with.
    @TestClass()
    class LOADED_ASSEMBLY_RESOLVER_TESTS is
        init() is si

        core_path() -> string => (typeof object).assembly.location

        @Test()
        resolve__a_loaded_name__returns_the_loaded_assembly() is
            let loaded = MAP[string, Assembly]()

            let resolver =
                LOADED_ASSEMBLY_RESOLVER(
                    (name: string) -> Assembly? => if loaded.contains_key(name) then loaded[name] else null fi,
                    PathAssemblyResolver(LIST[string]([core_path()])))

            let use context = MetadataLoadContext(resolver, "System.Private.CoreLib")

            let core = context.load_from_assembly_path(core_path())

            loaded.add("cell1", core)

            are_same(core, resolver.resolve(context, AssemblyName("cell1")))
        si

        @Test()
        resolve__any_other_name__goes_to_the_fallback() is
            let resolver = LOADED_ASSEMBLY_RESOLVER((name: string) -> Assembly? => null, PathAssemblyResolver(LIST[string]([core_path()])))

            let use context = MetadataLoadContext(resolver, "System.Private.CoreLib")

            is_null(resolver.resolve(context, AssemblyName("no-such-assembly")))
        si
    si
si
