namespace Semantic.DotNet.UnitTests is
    use Semantic.DotNet.HIDDEN_SYMBOLS
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class HIDDEN_SYMBOLS_TESTS is
        init() is si

        @Test()
        The_internal_namespace_is_hidden() is
            is_true(HIDDEN_SYMBOLS.is_hidden_namespace("Ghul.Internal"))
        si

        @Test()
        The_namespace_it_sits_in_is_not_hidden() is
            is_false(HIDDEN_SYMBOLS.is_hidden_namespace("Ghul"))
        si

        @Test()
        A_namespace_under_it_is_not_hidden() is
            is_false(HIDDEN_SYMBOLS.is_hidden_namespace("Ghul.Internal.Deeper"))
        si

        @Test()
        A_namespace_whose_name_begins_with_it_is_not_hidden() is
            is_false(HIDDEN_SYMBOLS.is_hidden_namespace("Ghul.InternalThing"))
        si

        @Test()
        No_namespace_is_not_hidden() is
            is_false(HIDDEN_SYMBOLS.is_hidden_namespace(null))
        si
    si
si
