namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.Type

    use Semantic.EXPECTED_ARM_JOIN
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class EXPECTED_ARM_JOIN_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        build_hierarchy() -> (animal: CLASS, cat: CLASS, dog: CLASS) is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", empty_names(), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()

            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "animal", empty_names(), Semantic.BLOCK_SCOPE())
            animal.add_ancestor(object_class.type!)

            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "cat", empty_names(), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            let dog = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "dog", empty_names(), Semantic.BLOCK_SCOPE())
            dog.add_ancestor(animal.type!)

            return (animal, cat, dog)
        si

        placeholder() -> Type =>
            INFERRED_VARIABLE_TYPE(INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "p"))

        @Test()
        Calling__result__with_a_placeholder_expected_type__should_return_the_arms_join() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(placeholder())

            join.add(h.cat.type!)
            join.add(h.dog.type!)

            let result = join.result(false)

            is_not_null(result)
            are_same(h.animal, result!.symbol)
        si

        @Test()
        Calling__result__with_no_expected_type__should_return_null() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(null)

            join.add(h.cat.type!)

            is_null(join.result(false))
        si

        @Test()
        Calling__result__with_a_settled_expected_type__should_return_null() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(h.animal.type!)

            join.add(h.cat.type!)

            is_null(join.result(false))
        si

        @Test()
        Calling__result__after_an_untyped_arm__should_return_null() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(placeholder())

            join.add(h.cat.type!)
            join.add_untyped_arm()

            is_null(join.result(false))
        si

        @Test()
        Calling__result__after_a_null_arm__should_return_null() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(placeholder())

            join.add(h.cat.type!)
            join.add(Semantic.Types.NULL())

            is_null(join.result(false))
        si

        @Test()
        Calling__result__after_an_error_arm__should_return_null() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(placeholder())

            join.add(h.cat.type!)
            join.add(Semantic.Types.ERROR())

            is_null(join.result(false))
        si

        @Test()
        Calling__result__when_the_expression_yields_absence__should_return_null() is
            let h = build_hierarchy()
            let join = EXPECTED_ARM_JOIN(placeholder())

            join.add(h.cat.type!)

            is_null(join.result(true))
        si

        @Test()
        Calling__result__when_the_join_is_unsettled__should_return_null() is
            let join = EXPECTED_ARM_JOIN(placeholder())

            join.add(placeholder())

            is_null(join.result(false))
        si

        @Test()
        Calling__result__with_no_arms__should_return_null() is
            let join = EXPECTED_ARM_JOIN(placeholder())

            is_null(join.result(false))
        si
    si
si
