namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GLOBAL_FUNCTION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the shape equivalence the namespace-scope function
    // merge reads: two overloads of one name found in different
    // scopes, each written with its own type parameters, describe the
    // same signature when every formal pair agrees structurally and
    // the type parameters compare by position. That equivalence is
    // what lets a project's own `apply` win against the runtime's
    // instead of every call reporting both.
    @TestClass()
    class FUNCTION_SHAPE_EQUIVALENCE_TESTS is
        _int_type: Type
        _string_type: Type
        _function_owner: CLASS

        init() is
            _int_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _string_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "string", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _function_owner =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Function", LIST[string](["A", "R"]), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        make_function(formals: Collections.List[Type], return_type: Type) -> GLOBAL_FUNCTION is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "apply", Semantic.BLOCK_SCOPE())

            result.arguments = to_list(formals)
            result.argument_names = LIST[string]()
            result.argument_defaults = LIST[string?]()
            result.argument_is_pack = LIST[bool]()
            result.argument_pack_depth = LIST[int]()
            result.return_type = return_type

            return result
        si

        to_list(values: Collections.List[Type]) -> Collections.LIST[Type] is
            let result = LIST[Type]()
            for v in values do result.add(v); od
            return result
        si

        param() -> Type => FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!

        other_param() -> Type => FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "U", 0).type!

        function_type(param_type: Type, return_type: Type) -> Type =>
            Semantic.Types.FUNCTION(loc(), _function_owner, to_list(LIST[Type]([param_type, return_type])))

        // `apply[T.., U](f: T.. -> U, v: T) -> U` beside the same
        // declaration from another assembly: one signature modulo the
        // type parameters' names.
        @Test()
        Same_shape_with_own_type_parameters__is_equivalent() is
            let a = make_function(LIST[Type]([function_type(param(), param()), param()]), param())
            let b = make_function(LIST[Type]([function_type(other_param(), other_param()), other_param()]), other_param())

            is_true(FUNCTION_SHAPE_EQUIVALENCE.are_equivalent(a, b))
        si

        @Test()
        Same_function_with_itself__is_equivalent() is
            let a = make_function(LIST[Type]([param()]), param())

            is_true(FUNCTION_SHAPE_EQUIVALENCE.are_equivalent(a, a))
        si

        @Test()
        Different_concrete_formals__are_not_equivalent() is
            let a = make_function(LIST[Type]([_int_type]), param())
            let b = make_function(LIST[Type]([_string_type]), param())

            is_false(FUNCTION_SHAPE_EQUIVALENCE.are_equivalent(a, b))
        si

        @Test()
        Type_parameter_against_concrete_formal__is_not_equivalent() is
            let a = make_function(LIST[Type]([param()]), param())
            let b = make_function(LIST[Type]([_int_type]), param())

            is_false(FUNCTION_SHAPE_EQUIVALENCE.are_equivalent(a, b))
        si

        @Test()
        Different_arity__is_not_equivalent() is
            let a = make_function(LIST[Type]([param(), param()]), param())
            let b = make_function(LIST[Type]([param()]), param())

            is_false(FUNCTION_SHAPE_EQUIVALENCE.are_equivalent(a, b))
        si

        @Test()
        Different_return_types__are_not_equivalent() is
            let a = make_function(LIST[Type]([param()]), _int_type)
            let b = make_function(LIST[Type]([param()]), _string_type)

            is_false(FUNCTION_SHAPE_EQUIVALENCE.are_equivalent(a, b))
        si
    si
si
