namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.ENCLOSING_TYPE_VARIABLE

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.NAMESPACE

    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins which type variables count as already standing for a
    // definite type at a given point in the source: the ones declared
    // by something that point is written inside. Inference records a
    // bound from those and waits on the rest, so the two answers are
    // the difference between settling a type argument and reporting
    // that it cannot be inferred.
    @TestClass()
    class ENCLOSING_TYPE_VARIABLE_TESTS is
        _subject: ENCLOSING_TYPE_VARIABLE

        init() is
            _subject = ENCLOSING_TYPE_VARIABLE()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        new_generic(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](["T"]), Semantic.BLOCK_SCOPE())

        method_of(owner: CLASS) -> INSTANCE_METHOD =>
            INSTANCE_METHOD(loc(), loc(), owner, "m", Semantic.BLOCK_SCOPE())

        // The type variable of the class a method belongs to.
        class_parameter(owner: CLASS) -> Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), owner, "T", 0).type!

        @Test()
        should_accept_a_type_variable_of_the_enclosing_class() is
            let owner = new_generic("BOX")

            is_true(_subject.is_fixed_in(class_parameter(owner), method_of(owner)))
        si

        @Test()
        should_reject_a_type_variable_of_an_unrelated_class() is
            let owner = new_generic("BOX")
            let other = new_generic("LIST")

            is_false(_subject.is_fixed_in(class_parameter(other), method_of(owner)))
        si

        @Test()
        should_accept_a_type_variable_the_method_itself_declares() is
            let owner = new_generic("BOX")
            let method = method_of(owner)
            let parameter = FUNCTION_GENERIC_ARGUMENT(loc(), method, "U", 0)

            is_true(_subject.is_fixed_in(parameter.type!, method))
        si

        @Test()
        should_reject_a_type_that_is_not_a_type_variable() is
            let owner = new_generic("BOX")
            let plain = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE())

            is_false(_subject.is_fixed_in(plain.type!, method_of(owner)))
        si

        // A namespace owns itself, so the walk up the owner chain has
        // to stop on its own account. Left to the shape of the graph
        // it would circle there, and this runs inside the inference
        // retry loop where that is a hang rather than a wrong answer.
        @Test()
        should_terminate_when_the_owner_chain_closes_on_itself() is
            let space = NAMESPACE(loc(), "Test", Semantic.BLOCK_SCOPE(), "Test", false)
            let owner = CLASS(loc(), loc(), space, "BOX", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
            let other = new_generic("LIST")

            are_same(space, space.owner)

            is_false(_subject.is_fixed_in(class_parameter(other), method_of(owner)))
        si

        @Test()
        should_reject_when_there_is_no_enclosing_function() is
            let owner = new_generic("BOX")

            is_false(_subject.is_fixed_in(class_parameter(owner), null))
        si
    si
si
