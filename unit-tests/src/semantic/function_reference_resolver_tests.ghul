namespace Semantic.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Logging.DIAGNOSTICS_STORE;

    use Semantic.Types.Type;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.STATIC_METHOD;
    use Semantic.Symbols.INSTANCE_METHOD;
    use Semantic.Symbols.FUNCTION_GROUP;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Bare-minimum InnateSymbolLookup: real, distinguishable types for
    // the handful of primitives these tests reference, a real (if
    // simplified) get_function_type so get_full_type can build a
    // function's native call shape, and NotImplementedException for
    // everything else these tests never touch.
    class TEST_INNATE_SYMBOL_LOOKUP: Lookups.InnateSymbolLookup is
        _fn_owner: CLASS;
        _int_type: Type;
        _string_type: Type;
        _void_type: Type;

        init() is
            let loc = LOCATION("test.ghul", 1, 1, 1, 1);
            _fn_owner = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Fn", LIST[string](["T", "U"]), Semantic.BLOCK_SCOPE());
            _int_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Int", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            _string_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "String", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            _void_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Void", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
        si

        get_function_type(types: Collections.List[Type]) -> Type => Semantic.Types.FUNCTION(_fn_owner.location, _fn_owner, types);
        get_function_type(types: Collections.List[Type], is_pure: bool) -> Type =>
            if is_pure then
                Semantic.Types.PURE_FUNCTION(_fn_owner.location, _fn_owner, types);
            else
                get_function_type(types);
            fi;

        get_int_type() -> Type => _int_type;
        get_string_type() -> Type => _string_type;
        get_void_type() -> Type => _void_type;

        get_enum_type() -> Type => throw System.NotImplementedException();
        get_tuple_type(types: Collections.List[Type], names: Collections.List[string?]?) -> Type => throw System.NotImplementedException();
        get_array_type(type: Type) -> Type => throw System.NotImplementedException();
        get_optional_type(type: Type) -> Type => throw System.NotImplementedException();
        get_maybe_type(type: Type) -> Type? => throw System.NotImplementedException();
        get_equality_comparer_type(type: Type) -> Type? => throw System.NotImplementedException();
        get_pointer_type(type: Type) -> Type => throw System.NotImplementedException();
        get_reference_type(type: Type) -> Type => throw System.NotImplementedException();
        get_bool_type() -> Type => throw System.NotImplementedException();
        get_char_type() -> Type => throw System.NotImplementedException();
        get_byte_type() -> Type => throw System.NotImplementedException();
        get_ubyte_type() -> Type => throw System.NotImplementedException();
        get_short_type() -> Type => throw System.NotImplementedException();
        get_ushort_type() -> Type => throw System.NotImplementedException();
        get_uint_type() -> Type => throw System.NotImplementedException();
        get_long_type() -> Type => throw System.NotImplementedException();
        get_ulong_type() -> Type => throw System.NotImplementedException();
        get_word_type() -> Type => throw System.NotImplementedException();
        get_uword_type() -> Type => throw System.NotImplementedException();
        get_single_type() -> Type => throw System.NotImplementedException();
        get_double_type() -> Type => throw System.NotImplementedException();
        get_decimal_type() -> Type => throw System.NotImplementedException();
        get_object_type() -> Type => throw System.NotImplementedException();
        get_value_type() -> Type => throw System.NotImplementedException();
        get_exception_type() -> Type => throw System.NotImplementedException();
        get_type_type() -> Type => throw System.NotImplementedException();
        get_unspecialized_iterable_type() -> Type => throw System.NotImplementedException();
        get_unspecialized_iterator_type() -> Type => throw System.NotImplementedException();
        get_unspecialized_pipe_type() -> Type? => throw System.NotImplementedException();
        get_unspecialized_task_type() -> Type? => throw System.NotImplementedException();
        get_interpolated_string_handler_type() -> Type => throw System.NotImplementedException();
        get_idisposable_type() -> Type => throw System.NotImplementedException();
        get_box_type(type: Type) -> Type => throw System.NotImplementedException();
        get_task_type(type: Type) -> Type? => throw System.NotImplementedException();
        get_void_task_type() -> Type? => throw System.NotImplementedException();
        get_async_task_method_builder_type(type: Type) -> Type? => throw System.NotImplementedException();
        get_async_task_method_builder_void_type() -> Type? => throw System.NotImplementedException();
        get_async_state_machine_interface_type() -> Type? => throw System.NotImplementedException();
        get_task_awaiter_type(type: Type) -> Type? => throw System.NotImplementedException();
        get_task_awaiter_void_type() -> Type? => throw System.NotImplementedException();
        get_unspecialized_async_task_method_builder_type() -> Type? => throw System.NotImplementedException();
        get_unspecialized_task_awaiter_type() -> Type? => throw System.NotImplementedException();
    si

    // Tests for FUNCTION_REFERENCE_RESOLVER — the helper that converts
    // a global function, static/instance method, or an overloaded
    // group member into a function/delegate value in place of a call.
    @TestClass()
    class FUNCTION_REFERENCE_RESOLVER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        // Fresh resolver plus the collaborators a test needs to build
        // fixtures and inspect diagnostics.
        build_resolver() -> (FUNCTION_REFERENCE_RESOLVER, DIAGNOSTICS_STORE, Lookups.InnateSymbolLookup) is
            let logger = DIAGNOSTICS_STORE();
            let symbol_table = SYMBOL_TABLE(logger);
            let innate_symbol_lookup = TEST_INNATE_SYMBOL_LOOKUP();
            let overload_resolver = OVERLOAD_RESOLVER(logger);
            let symbol_loader = SYMBOL_LOADER(logger, symbol_table, FUNCTION_CALLER(symbol_table, IR.VALUE_BOXER(logger)), IR.VALUE_BOXER(logger), innate_symbol_lookup);

            let resolver = FUNCTION_REFERENCE_RESOLVER(logger, symbol_table, symbol_loader, innate_symbol_lookup, overload_resolver);

            return (resolver, logger, innate_symbol_lookup);
        si

        static_method(owner: CLASS, name: string, argument_types: Collections.List[Type], return_type: Type) -> STATIC_METHOD is
            let f = STATIC_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE());
            f.arguments = argument_types;
            f.return_type = return_type;
            return f;
        si

        // A minimal stand-in for a real .NET delegate type: a CLASS
        // whose only ancestor is a "System.MulticastDelegate"-named
        // CLASS (matching what `DELEGATE_SHAPE._inherits_multicast_
        // delegate` checks by qualified name) and whose sole `invoke`
        // member carries the call shape.
        delegate_type(name: string, argument_types: Collections.List[Type], return_type: Type) -> CLASS is
            let multicast = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "System.MulticastDelegate", LIST[string](), Semantic.BLOCK_SCOPE());
            let d = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE());

            d.add_ancestor(multicast.type!);

            let invoke = INSTANCE_METHOD(loc(), loc(), d, "invoke", Semantic.BLOCK_SCOPE());
            invoke.arguments = argument_types;
            invoke.return_type = return_type;
            d.add_member(invoke);

            return d;
        si

        @Test()
        Calling__try_load__on_a_call_target__returns_null() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let f = static_method(owner, "foo", LIST[Type](), innate_symbol_lookup.get_int_type());

            let result = resolver.try_load(loc(), f, null, null, true);

            is_null(result);
        si

        @Test()
        Calling__try_load__on_a_non_function_symbol__returns_null() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let not_a_function = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());

            let result = resolver.try_load(loc(), not_a_function, null, null, false);

            is_null(result);
        si

        // With no target context, a single function reference infers
        // its own native call shape — the same default a bare lambda
        // literal gets.
        @Test()
        Calling__try_load__on_a_single_function_with_no_target__uses_its_own_shape() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let f = static_method(owner, "double_it", LIST[Type]([int_type]), int_type);

            let result = resolver.try_load(loc(), f, null, null, false);

            is_true(result?, "expected a value");
            is_true(result.type!.is_function, "expected a function-shaped value");
            are_equal(0, logger.error_count, "no diagnostic expected");
        si

        // Regression: a pushed target type that is present but isn't
        // itself function/delegate-shaped (a plain non-function class,
        // standing in for `object` / `string`) must not be adopted as
        // the built value's type — that mistagged the DELEGATE value
        // with an unrelated type and produced bad IL with no
        // diagnostic. The function's own native shape is used instead,
        // leaving the ordinary assignability check at the use site to
        // accept or reject it.
        @Test()
        Calling__try_load__with_a_non_callable_target__falls_back_to_the_native_shape() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let f = static_method(owner, "double_it", LIST[Type]([int_type]), int_type);

            let not_callable = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "NotCallable", LIST[string](), Semantic.BLOCK_SCOPE());

            let result = resolver.try_load(loc(), f, null, not_callable.type!, false);

            is_true(result?, "expected a value");
            is_true(result.type!.is_function, "expected the function's own native shape, not the pushed non-callable target");
            are_equal(0, logger.error_count, "no diagnostic expected — falling back silently is correct here");
        si

        // A pushed target that IS function-shaped but incompatible
        // (wrong arity) is a genuine mismatch: one diagnostic, not a
        // silently mistyped value.
        @Test()
        Calling__try_load__with_an_incompatible_function_target__logs_one_error() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let f = static_method(owner, "double_it", LIST[Type]([int_type]), int_type);

            let target_shape = innate_symbol_lookup.get_function_type(LIST[Type]([int_type, int_type, int_type]));

            let result = resolver.try_load(loc(), f, null, target_shape, false);

            is_true(result?, "expected a poison value, not null");
            are_equal(1, logger.error_count, "expected exactly one compatibility diagnostic");
        si

        // A target whose return slot is a free type variable of the
        // enclosing generic callee can't be checked by assignability —
        // the function's own return type is what should flow into that
        // slot. The value carries the function's native shape and no
        // mismatch is reported here; the use site binds the slot from
        // the value it receives.
        @Test()
        Calling__try_load__with_a_free_type_variable_return_target__builds_at_the_native_shape() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let f = static_method(owner, "double_it", LIST[Type]([int_type]), int_type);

            // (int) -> S, with S a free type variable of the callee
            let free = Semantic.Types.FUNCTION_GENERIC_ARGUMENT(owner);
            let target_shape = innate_symbol_lookup.get_function_type(LIST[Type]([int_type, free]));

            let result = resolver.try_load(loc(), f, null, target_shape, false);

            is_true(result?, "expected a value");
            are_equal(
                int_type,
                result.type!.arguments[result.type!.arguments.count - 1],
                "the return slot should be the function's own, not the free variable");
            are_equal(0, logger.error_count, "an open return slot is not a mismatch");
        si

        // An overloaded name with no target shape in scope to pick a
        // member by is left alone — the caller falls back to its
        // ordinary "value" diagnostic rather than a guess.
        @Test()
        Calling__try_load__on_an_overloaded_group_with_no_target__returns_null() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let string_type = innate_symbol_lookup.get_string_type();

            let group = FUNCTION_GROUP(loc(), owner, "describe");
            group.add(static_method(owner, "describe", LIST[Type]([int_type]), string_type));
            group.add(static_method(owner, "describe", LIST[Type]([string_type]), string_type));

            let result = resolver.try_load(loc(), group, null, null, false);

            is_null(result);
            are_equal(0, logger.error_count, "left alone means no diagnostic here either — the caller's own path reports it");
        si

        // With a target shape in scope, the group is resolved through
        // the ordinary OVERLOAD_RESOLVER, the same as a call site.
        @Test()
        Calling__try_load__on_an_overloaded_group_with_a_matching_target__resolves_it() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let string_type = innate_symbol_lookup.get_string_type();

            let group = FUNCTION_GROUP(loc(), owner, "describe");
            group.add(static_method(owner, "describe", LIST[Type]([int_type]), string_type));
            group.add(static_method(owner, "describe", LIST[Type]([string_type]), string_type));

            let target_shape = innate_symbol_lookup.get_function_type(LIST[Type]([int_type, string_type]));

            let result = resolver.try_load(loc(), group, null, target_shape, false);

            is_true(result?, "expected an overload to resolve");
            are_equal(0, logger.error_count, "a matching overload should not log a diagnostic");
        si

        // An instance method's receiver comes from the supplied `from`
        // value directly — `load_self` (which needs a live enclosing
        // function context) is never reached when a receiver is
        // already in hand.
        @Test()
        Calling__try_load__on_an_instance_method_with_a_receiver__uses_it() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();

            let f = INSTANCE_METHOD(loc(), loc(), owner, "scale", Semantic.BLOCK_SCOPE());
            f.arguments = LIST[Type]([int_type]);
            f.return_type = int_type;

            let receiver = IR.Values.NULL(owner.type!);

            let result = resolver.try_load(loc(), f, receiver, null, false);

            is_true(result?, "expected a value");
            are_equal(0, logger.error_count, "no diagnostic expected");
        si

        // Regression: a plain `ldftn` always captures the statically-
        // resolved implementation, so a virtual instance method bound
        // to a live receiver must dispatch through `ldvirtftn`
        // instead — otherwise a function value and a direct call
        // through the same reference can disagree on an overridden
        // method.
        @Test()
        Calling__try_load__on_a_virtual_instance_method__dispatches_virtually() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();

            let f = INSTANCE_METHOD(loc(), loc(), owner, "scale", Semantic.BLOCK_SCOPE());
            f.arguments = LIST[Type]([int_type]);
            f.return_type = int_type;

            let receiver = IR.Values.NULL(owner.type!);

            let result = resolver.try_load(loc(), f, receiver, null, false);
            let delegate = cast IR.Values.Load.DELEGATE(result!);

            is_true(delegate.function.is_virtual_dispatch, "a virtual instance method should dispatch through ldvirtftn");
        si

        // A method that isn't virtual in the first place (a private
        // instance method resolves statically) should not pay for -
        // or accidentally trigger - the ldvirtftn/dup sequence.
        @Test()
        Calling__try_load__on_a_non_virtual_instance_method__does_not_dispatch_virtually() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();

            let f = Semantic.Symbols.PRIVATE_METHOD(loc(), loc(), owner, "scale", Semantic.BLOCK_SCOPE());
            f.arguments = LIST[Type]([int_type]);
            f.return_type = int_type;

            let receiver = IR.Values.NULL(owner.type!);

            let result = resolver.try_load(loc(), f, receiver, null, false);
            let delegate = cast IR.Values.Load.DELEGATE(result!);

            is_false(delegate.function.is_virtual_dispatch, "a non-virtual method should not dispatch through ldvirtftn");
        si

        // Pushing a real named-delegate target type must build a
        // value typed at the delegate itself, not at the invoke shape
        // used for the assignability check - `Load.DELEGATE.gen`
        // needs the concrete delegate type to emit `newobj` against
        // the right `.ctor`. The fixture's invoke shape and delegate
        // type agree on arity/types, so only the value's `type`
        // distinguishes the two.
        @Test()
        Calling__try_load__with_a_named_delegate_target__builds_a_value_typed_at_the_delegate() is
            let (resolver, logger, innate_symbol_lookup) = build_resolver();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE());
            let int_type = innate_symbol_lookup.get_int_type();
            let f = static_method(owner, "compare_descending", LIST[Type]([int_type, int_type]), int_type);

            let comparison = delegate_type("Comparison", LIST[Type]([int_type, int_type]), int_type);

            let result = resolver.try_load(loc(), f, null, comparison.type!, false);

            is_true(result?, "expected a value");
            are_same(comparison.type!, result.type!, "expected the value typed at the delegate itself, not its invoke shape");
            are_equal(0, logger.error_count, "no diagnostic expected");
        si
    si
si
