namespace Semantic.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use NSubstitute.SubstituteExtensions.returns;

    use Source.LOCATION;

    use Semantic.POINTER_SIZED_DECIMAL_BRIDGE;
    use Semantic.Lookups.InnateSymbolLookup;
    use Semantic.Symbols.CLASS;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for POINTER_SIZED_DECIMAL_BRIDGE - the rule that a cast
    // between a pointer-sized integer and decimal goes through the
    // 64-bit integer of the same signedness.
    //
    // Pinned here rather than through a cast, because an execution test
    // cannot tell a bridged conversion from a direct one: both produce
    // the right number. What matters and is invisible from outside is
    // which pairs answer null. TYPE_CASTER consults this rule twice, to
    // decide a cast is legal and then to perform it, and a pair the two
    // disagreed about would either reject a cast it goes on to build or
    // accept one it cannot. Answering null on a pair that is already one
    // step is also what stops the two-step reapplying to its own halves.
    @TestClass()
    class POINTER_SIZED_DECIMAL_BRIDGE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        // Distinct stand-in types, since the rule compares identity
        // rather than reading anything off them.
        build() -> (
            bridge: POINTER_SIZED_DECIMAL_BRIDGE,
            decimal_type: Type,
            word_type: Type,
            uword_type: Type,
            long_type: Type,
            ulong_type: Type,
            int_type: Type
        ) is
            let arguments = System.Array.empty`[object]();
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments);

            let decimal_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "decimal", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            let word_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "word", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            let uword_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "uword", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            let long_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "long", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            let ulong_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ulong", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            let int_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!;

            lookup.get_decimal_type() |> returns(decimal_type, null);
            lookup.get_word_type() |> returns(word_type, null);
            lookup.get_uword_type() |> returns(uword_type, null);
            lookup.get_long_type() |> returns(long_type, null);
            lookup.get_ulong_type() |> returns(ulong_type, null);

            return (
                POINTER_SIZED_DECIMAL_BRIDGE(lookup),
                decimal_type,
                word_type,
                uword_type,
                long_type,
                ulong_type,
                int_type
            );
        si

        @Test()
        Calling__find__word_to_decimal__bridges_through_long() is
            let b = build();

            are_same(b.long_type, b.bridge.find(b.word_type, b.decimal_type));
        si

        @Test()
        Calling__find__decimal_to_word__bridges_through_long() is
            let b = build();

            are_same(b.long_type, b.bridge.find(b.decimal_type, b.word_type));
        si

        // Signedness is carried across, so an unsigned pointer-sized
        // value never routes through a signed intermediate.
        @Test()
        Calling__find__uword_to_decimal__bridges_through_ulong() is
            let b = build();

            are_same(b.ulong_type, b.bridge.find(b.uword_type, b.decimal_type));
        si

        @Test()
        Calling__find__decimal_to_uword__bridges_through_ulong() is
            let b = build();

            are_same(b.ulong_type, b.bridge.find(b.decimal_type, b.uword_type));
        si

        // Decimal reaches a fixed-width integer in one step, so there is
        // nothing to bridge.
        @Test()
        Calling__find__decimal_to_a_fixed_width_integer__does_not_bridge() is
            let b = build();

            is_null(b.bridge.find(b.decimal_type, b.int_type));
            is_null(b.bridge.find(b.int_type, b.decimal_type));
        si

        // A `conv` opcode reaches a pointer-sized integer from another
        // integer directly.
        @Test()
        Calling__find__word_to_a_fixed_width_integer__does_not_bridge() is
            let b = build();

            is_null(b.bridge.find(b.word_type, b.int_type));
            is_null(b.bridge.find(b.uword_type, b.long_type));
        si

        // Neither side is decimal, so the pair is not this rule's.
        @Test()
        Calling__find__two_pointer_sized_types__does_not_bridge() is
            let b = build();

            is_null(b.bridge.find(b.word_type, b.uword_type));
            is_null(b.bridge.find(b.word_type, b.word_type));
        si

        // The recursion's terminating case: each half of a bridged cast
        // is asked again, and has to answer null.
        @Test()
        Calling__find__on_the_halves_of_a_bridged_cast__does_not_bridge_again() is
            let b = build();

            let bridge_type = b.bridge.find(b.word_type, b.decimal_type)!;

            is_null(b.bridge.find(b.word_type, bridge_type));
            is_null(b.bridge.find(bridge_type, b.decimal_type));
        si

        @Test()
        Calling__find__decimal_to_decimal__does_not_bridge() is
            let b = build();

            is_null(b.bridge.find(b.decimal_type, b.decimal_type));
        si
    si
si
