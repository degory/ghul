namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.PACK_TUPLE_SOURCE
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Types.GENERIC
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class PACK_TUPLE_SOURCE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        placeholder(name: string) -> Type =>
            INFERRED_VARIABLE_TYPE(INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), name))

        generic(name: string, argument: Type) -> Type =>
            GENERIC(
                loc(),
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](["T"]), Semantic.BLOCK_SCOPE()),
                LIST[Type]([argument])
            )

        plain(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!

        @Test()
        Calling__is_decided_by_another_formal__when_a_sibling_formal_holds_the_pack_placeholder__should_return_true() is
            let t = placeholder("T")
            let formals = LIST[Type]([generic("Iterable", t), generic("Action", t)])

            is_true(PACK_TUPLE_SOURCE().is_decided_by_another_formal(formals, 1, t))
        si

        @Test()
        Calling__is_decided_by_another_formal__when_only_the_pack_formal_holds_it__should_return_false() is
            let t = placeholder("T")
            let formals = LIST[Type]([generic("Action", t)])

            is_false(PACK_TUPLE_SOURCE().is_decided_by_another_formal(formals, 0, t))
        si

        @Test()
        Calling__is_decided_by_another_formal__when_a_sibling_holds_a_different_placeholder__should_return_false() is
            let t = placeholder("T")
            let u = placeholder("U")
            let formals = LIST[Type]([generic("Iterable", u), generic("Action", t)])

            is_false(PACK_TUPLE_SOURCE().is_decided_by_another_formal(formals, 1, t))
        si

        @Test()
        Calling__is_decided_by_another_formal__when_the_sibling_placeholder_is_inside_the_pack_tuple__should_return_true() is
            let t = placeholder("T")
            let formals = LIST[Type]([generic("Iterable", t), plain("int")])

            is_true(PACK_TUPLE_SOURCE().is_decided_by_another_formal(formals, 1, generic("Pair", t)))
        si
    si
si
