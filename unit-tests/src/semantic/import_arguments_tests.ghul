namespace Semantic.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.INSTANCE_METHOD;
    use Semantic.Symbols.NAMESPACE;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    @TestClass()
    class IMPORT_ARGUMENTS_TESTS is
        init() is si

        loc() -> LOCATION is
            if !LOCATION.reflected? then
                LOCATION.init_static();
            fi

            return LOCATION.reflected;
        si

        // A reflected member of the named owner. A member called
        // `init` takes the `.ctor` IL name and so reads as a
        // constructor. The fixture declares no parameters, which is
        // the case the trust turns on and which needs no innate
        // lookup to answer; the argument classification itself is
        // covered by integration-tests/semantic/import-construction-keeps-narrow
        // against the real imported signatures.
        reflected_member(namespace_name: string, class_name: string, member_name: string) -> INSTANCE_METHOD is
            let ns = NAMESPACE(loc(), namespace_name, null, ".{namespace_name}", false);
            let owner = CLASS(loc(), loc(), ns, class_name, LIST[string](), Semantic.BLOCK_SCOPE());

            return INSTANCE_METHOD(loc(), loc(), owner, member_name, Semantic.BLOCK_SCOPE());
        si

        @Test()
        Reflected_parameterless_constructor__constructs_store_free() is
            is_true(reflected_member("Collections", "MAP", "init").constructs_store_free);
            is_true(reflected_member("Collections", "SET", "init").constructs_store_free);
            is_true(reflected_member("System.Text", "StringBuilder", "init").constructs_store_free);
        si

        @Test()
        Reflected_constructor__is_still_not_store_free() is
            // The trust holds only where the receiver is fresh. A
            // constructor reached any other way — a chained
            // `super.init` on an object that already exists — must
            // stay outside it, so the stronger bit is unchanged.
            is_false(reflected_member("Collections", "MAP", "init").is_store_free);
        si

        @Test()
        Reflected_method__does_not_construct_store_free() is
            // Nothing about the argument test is specific to
            // constructors, but the fresh-receiver half of the
            // argument is, so an ordinary imported member is left
            // where it was.
            is_false(reflected_member("Collections", "LIST", "add").constructs_store_free);
        si

        @Test()
        Constructor_declared_in_source__is_left_to_the_solve() is
            let source_location = LOCATION("test.ghul", 1, 1, 1, 1);
            let ns = NAMESPACE(loc(), "Example", null, ".Example", false);
            let owner = CLASS(loc(), loc(), ns, "THING", LIST[string](), Semantic.BLOCK_SCOPE());

            let declared =
                INSTANCE_METHOD(source_location, source_location, owner, "init", Semantic.BLOCK_SCOPE());

            is_false(declared.constructs_store_free);
        si
    si
si
