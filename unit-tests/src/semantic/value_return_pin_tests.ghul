namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Types.Type
    use Semantic.VALUE_RETURN_PIN

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins VALUE_RETURN_PIN, which decides where a function literal's
    // inferred return settles. A body producing a value type cannot reach
    // a reference-typed slot by the delegate assignment alone - that needs
    // return covariance, which a value-type instantiation does not have -
    // so the conversion is made inside the literal and the return settles
    // at the slot's type. A body producing a reference type is left alone
    // and keeps the more precise type it produced.
    @TestClass()
    class VALUE_RETURN_PIN_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, System.Array.empty[string](), Semantic.BLOCK_SCOPE()).type!

        a_struct(name: string) -> Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, System.Array.empty[string](), Semantic.BLOCK_SCOPE()).type!

        @Test()
        Calling__applies_to_slot__for_a_class_slot__returns_true() is
            is_true(VALUE_RETURN_PIN.applies_to_slot(a_class("SLOT")))
        si

        @Test()
        Calling__applies_to_slot__for_a_struct_slot__returns_false() is
            // A value-typed slot takes the body's value as it stands:
            // there is no reference for it to be converted to.
            is_false(VALUE_RETURN_PIN.applies_to_slot(a_struct("SLOT")))
        si

        @Test()
        Calling__applies_to_slot__with_no_slot__returns_false() is
            is_false(VALUE_RETURN_PIN.applies_to_slot(null))
        si

        @Test()
        Calling__of__with_no_slot__returns_null() is
            is_null(VALUE_RETURN_PIN.of(null, a_struct("PRODUCED")))
        si

        @Test()
        Calling__of__with_no_produced_type__returns_null() is
            is_null(VALUE_RETURN_PIN.of(a_class("SLOT"), null))
        si

        @Test()
        Calling__of__for_a_reference_body__returns_null() is
            // The body's own type is the more precise one and converts to
            // the slot's by assignment, which is sound for a reference.
            is_null(VALUE_RETURN_PIN.of(a_class("SLOT"), a_class("PRODUCED")))
        si

        @Test()
        Calling__of__for_a_value_body_that_does_not_implement_the_slot__returns_null() is
            // Nothing to settle at: the question of how to convert is the
            // assignability check's, and it reports where it always did.
            is_null(VALUE_RETURN_PIN.of(a_class("SLOT"), a_struct("PRODUCED")))
        si
    si
si
