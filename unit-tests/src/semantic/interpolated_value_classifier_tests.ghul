namespace Semantic.UnitTests is
    use Collections.LIST

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.INTERPOLATED_VALUE_CLASSIFIER
    use Semantic.InterpolatedValueRendering
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins which rendering an interpolated value gets from its static
    // type. What each rendering emits, and what the runtime's `$` prints,
    // is covered by the `interpolation-*` integration tests.
    @TestClass()
    class INTERPOLATED_VALUE_CLASSIFIER_TESTS is
        _object: CLASS
        _value_type: CLASS
        _string: CLASS
        _bool: CLASS
        _number: CLASS
        _classifier: INTERPOLATED_VALUE_CLASSIFIER

        init() is
            _object = new_class("object")
            add_to_string(_object)

            _value_type = new_class("ValueType")
            _value_type.add_ancestor(_object.type!)
            add_to_string(_value_type)

            _string = new_class("string")
            _string.add_ancestor(_object.type!)
            add_to_string(_string)

            _bool = new_class("bool")
            _bool.add_ancestor(_value_type.type!)
            add_to_string(_bool)

            _number = new_class("int")
            _number.add_ancestor(_value_type.type!)
            add_to_string(_number)

            let arguments = System.Array.empty`[object]()
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments)
            lookup.get_object_type() |> returns(_object.type!, null)
            lookup.get_value_type() |> returns(_value_type.type!, null)
            lookup.get_string_type() |> returns(_string.type!, null)
            lookup.get_bool_type() |> returns(_bool.type!, null)
            lookup.get_unspecialized_iterable_type() |> returns(new_class("Iterable").type!, null)

            _classifier = INTERPOLATED_VALUE_CLASSIFIER(lookup)
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        new_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        add_to_string(owner: CLASS) is
            let f = INSTANCE_METHOD(loc(), loc(), owner, "to_string", Semantic.BLOCK_SCOPE())
            f.arguments = LIST[Type]()
            f.return_type = null
            owner.add_member(f)
        si

        derived(name: string, base: CLASS) -> CLASS is
            let result = new_class(name)
            result.add_ancestor(base.type!)
            return result
        si

        type_parameter() -> Type is
            let names = LIST[string]()
            names.add("T")

            return
                CLASSY_GENERIC_ARGUMENT(
                    loc(),
                    CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", names, Semantic.BLOCK_SCOPE()),
                    "T",
                    0
                ).type!
        si

        classify(type: Type) -> InterpolatedValueRendering => _classifier.classify(type, false)

        @Test()
        classify__formats_a_string_as_itself() is
            are_equal(InterpolatedValueRendering.FORMATTED, classify(_string.type!))
        si

        @Test()
        classify__formats_a_value_whose_type_declares_to_string() is
            are_equal(InterpolatedValueRendering.FORMATTED, classify(_number.type!))
        si

        @Test()
        classify__spells_a_bool_as_ghul_does() is
            are_equal(InterpolatedValueRendering.BOOL, classify(_bool.type!))
        si

        @Test()
        classify__renders_an_optional_as_what_it_holds_or_null() is
            are_equal(InterpolatedValueRendering.OPTIONAL, classify(derived("THING", _object).type!.as_optional()))
        si

        // Only object's to_string, which gives the .NET type name.
        @Test()
        classify__displays_a_class_that_declares_no_to_string() is
            are_equal(InterpolatedValueRendering.DISPLAYED, classify(derived("THING", _object).type!))
        si

        // Only ValueType's to_string, which gives the .NET type name.
        @Test()
        classify__displays_a_struct_that_declares_no_to_string() is
            are_equal(InterpolatedValueRendering.DISPLAYED, classify(derived("PAIR", _value_type).type!))
        si

        // The type argument could be anything, so what it says of itself
        // is only known once it is rendered.
        @Test()
        classify__displays_a_type_parameter() is
            are_equal(InterpolatedValueRendering.DISPLAYED, classify(type_parameter()))
        si

        // A format or an alignment selects .NET's formatting whatever the
        // value is.
        @Test()
        classify__formats_any_value_given_a_format() is
            are_equal(InterpolatedValueRendering.FORMATTED, _classifier.classify(derived("THING", _object).type!, true))
            are_equal(InterpolatedValueRendering.FORMATTED, _classifier.classify(_bool.type!, true))
        si
    si
si
