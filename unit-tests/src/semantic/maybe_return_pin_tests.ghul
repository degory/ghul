namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.STRUCT
    use Semantic.Types.MAYBE
    use Semantic.Types.NAMED
    use Semantic.Types.NULLABLE
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions
    use NSubstitute.SubstituteExtensions.returns_for_any_args

    // MAYBE_RETURN_PIN settles a literal's inferred return as `MAYBE`
    // over what its body produced, but only for a literal whose slot
    // asked for `U?`, and only over a settled non-MAYBE type: the
    // inner type of an optional of either carrier, or a bare value.
    @TestClass()
    class MAYBE_RETURN_PIN_TESTS is
        _maybe_symbol: CLASS

        init() is
            _maybe_symbol = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "MAYBE", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_reference_class() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Cat", LIST[string](), Semantic.BLOCK_SCOPE())

        a_value_struct() -> STRUCT =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Pixel", LIST[string](), Semantic.BLOCK_SCOPE())

        a_function(wrap: bool) -> GLOBAL_FUNCTION is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "literal", Semantic.BLOCK_SCOPE())
            result.wrap_inferred_return_as_maybe = wrap
            return result
        si

        maybe_over(inner: Type) -> MAYBE => MAYBE(loc(), _maybe_symbol, LIST[Type]([inner]))

        nullable_over(inner: Type) -> NULLABLE is
            let symbol = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Nullable", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
            return NULLABLE(loc(), symbol, LIST[Type]([inner]))
        si

        // A lookup that answers `get_maybe_type` with a MAYBE over
        // whatever it is asked for, and records the inner type asked.
        a_lookup() -> InnateSymbolLookup is
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](System.Array.empty`[object]())

            lookup.get_maybe_type(a_reference_class().type!) |> returns_for_any_args(
                (call: NSubstitute.Core.CallInfo) -> Type? => maybe_over(call.arg`[Type]()),
                null
            )

            return lookup
        si

        @Test()
        of__unmarked_function__leaves_the_type_alone() is
            let cat = a_reference_class().type!

            are_same(cat, MAYBE_RETURN_PIN.of(a_function(false), cat, a_lookup()))
        si

        @Test()
        of__bare_value__pins_MAYBE_over_it() is
            let cat = a_reference_class().type!

            let pinned = MAYBE_RETURN_PIN.of(a_function(true), cat, a_lookup())

            is_true(pinned.is_maybe)
            are_same(cat, pinned.optional_inner_type)
        si

        @Test()
        of__reference_optional__pins_MAYBE_over_its_inner_type() is
            let cat = cast NAMED(a_reference_class().type)

            let pinned = MAYBE_RETURN_PIN.of(a_function(true), cat.as_optional(), a_lookup())

            is_true(pinned.is_maybe)
            is_true(cat.is_equivalent_to(pinned.optional_inner_type!))
        si

        @Test()
        of__value_optional__pins_MAYBE_over_its_inner_type() is
            let pixel = a_value_struct().type!

            let pinned = MAYBE_RETURN_PIN.of(a_function(true), nullable_over(pixel), a_lookup())

            is_true(pinned.is_maybe)
            are_same(pixel, pinned.optional_inner_type)
        si

        @Test()
        of__already_MAYBE__leaves_the_type_alone() is
            let already = maybe_over(a_reference_class().type!)

            are_same(already, MAYBE_RETURN_PIN.of(a_function(true), already, a_lookup()))
        si

        @Test()
        of__MAYBE_written_out_by_name__leaves_the_type_alone() is
            let plain = Semantic.Types.GENERIC(loc(), _maybe_symbol, LIST[Type]([a_reference_class().type!]))

            are_same(plain, MAYBE_RETURN_PIN.of(a_function(true), plain, a_lookup()))
        si

        @Test()
        of__null__leaves_the_type_alone() is
            let null_type = Semantic.Types.NULL()

            are_same(null_type, MAYBE_RETURN_PIN.of(a_function(true), null_type, a_lookup()))
        si

        @Test()
        of__unsettled_value__leaves_the_type_alone() is
            let unsettled = Semantic.Types.INFERRED_RETURN_TYPE()

            are_same(unsettled, MAYBE_RETURN_PIN.of(a_function(true), unsettled, a_lookup()))
        si
    si
si
