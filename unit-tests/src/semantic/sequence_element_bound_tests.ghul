namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Types.GENERIC
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // SEQUENCE_ELEMENT_BOUND picks the upper bound a resolved formal's
    // element type puts on an array literal element still being inferred.
    @TestClass()
    class SEQUENCE_ELEMENT_BOUND_TESTS is
        init() is
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi

            IoC.CONTAINER.instance.local_id_generator.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        int_type() -> Type => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

        list_of(element: Type) -> Type is
            let list = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "LIST", LIST[string](["T"]), Semantic.BLOCK_SCOPE())

            return GENERIC(loc(), list, LIST[Type]([element]))
        si

        type_parameter() -> Type => FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!

        @Test()
        Calling__for_element_type__with_a_concrete_type__should_return_it() is
            let element = list_of(int_type())

            are_same(element, SEQUENCE_ELEMENT_BOUND.for_element_type(element))
        si

        @Test()
        Calling__for_element_type__with_no_element_type__should_return_null() is
            is_null(SEQUENCE_ELEMENT_BOUND.for_element_type(null))
        si

        @Test()
        Calling__for_element_type__with_a_placeholder__should_return_null() is
            is_null(SEQUENCE_ELEMENT_BOUND.for_element_type(INFERRED_VARIABLE_TYPE(LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), "x"))))
        si

        // A candidate's own unbound type parameter names a binding still
        // to be made, whether it is the element type or inside it.
        @Test()
        Calling__for_element_type__over_an_unbound_type_parameter__should_return_null() is
            is_null(SEQUENCE_ELEMENT_BOUND.for_element_type(type_parameter()))
            is_null(SEQUENCE_ELEMENT_BOUND.for_element_type(list_of(type_parameter())))
        si
    si
si
