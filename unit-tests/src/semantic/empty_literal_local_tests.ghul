namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Types.GENERIC
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // EMPTY_LITERAL_LOCAL decides, once per walk, whether an untyped local
    // initialized with `[]` is typed from its uses or waits for them. The
    // object element type is a default and so is the fixing step's to
    // take, which is why no walk answers with one.
    @TestClass()
    class EMPTY_LITERAL_LOCAL_TESTS is
        init() is
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi

            IoC.CONTAINER.instance.local_id_generator.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        int_type() -> Type => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

        list_of_int() -> Type is
            let list = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "LIST", LIST[string](["T"]), Semantic.BLOCK_SCOPE())

            return GENERIC(loc(), list, LIST[Type]([int_type()]))
        si

        placeholder() -> Type => INFERRED_VARIABLE_TYPE(LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), "empty"))

        @Test()
        Calling__decide__with_a_settled_element_bearing_type__should_type_from_use() is
            are_equal(EmptyLiteralLocal.TYPE_FROM_USE, EMPTY_LITERAL_LOCAL.decide(list_of_int()))
        si

        @Test()
        Calling__decide__with_nothing_inferred__should_await() is
            are_equal(EmptyLiteralLocal.AWAIT, EMPTY_LITERAL_LOCAL.decide(null))
        si

        @Test()
        Calling__decide__with_a_placeholder__should_await() is
            are_equal(EmptyLiteralLocal.AWAIT, EMPTY_LITERAL_LOCAL.decide(placeholder()))
        si

        // A settled type with no element type - a use that bounded the
        // local by `int` - has nothing to type the literal with.
        @Test()
        Calling__decide__with_a_settled_type_without_elements__should_not_type_from_use() is
            are_equal(EmptyLiteralLocal.AWAIT, EMPTY_LITERAL_LOCAL.decide(int_type()))
        si
    si
si
