namespace Semantic.UnitTests is
    use Collections.LIST;

    use NSubstitute.SubstituteExtensions.returns;

    use Source.LOCATION;

    use Semantic.RANGE_SLICE_RESOLVER;
    use Semantic.Lookups.InnateSymbolLookup;
    use Semantic.Symbols.CLASS;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for RANGE_SLICE_RESOLVER - the rule that an index whose
    // argument is a `System.Range` takes a slice of the source rather
    // than an element.
    //
    // The guards are pinned here rather than end to end because from
    // outside a declined index and a resolved one look the same: both end
    // in a diagnostic the caller writes. What matters and is invisible
    // from there is which indexes are declined before resolution is
    // attempted at all - an index by anything but a range, and a project
    // whose runtime supplies no `slice` to call.
    @TestClass()
    class RANGE_SLICE_RESOLVER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        named_type(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!;

        build() -> (
            resolver: RANGE_SLICE_RESOLVER,
            range_type: Type,
            other_type: Type,
            int_range_type: Type,
            int_range_inclusive_type: Type
        ) is
            let arguments = System.Array.empty`[object]();
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments);

            let range_type = named_type("Range");
            let other_type = named_type("int");
            let int_range_type = named_type("INT_RANGE");
            let int_range_inclusive_type = named_type("INT_RANGE_INCLUSIVE");

            lookup.get_range_type() |> returns(range_type, null);
            lookup.get_int_range_type() |> returns(int_range_type, null);
            lookup.get_int_range_inclusive_type() |> returns(int_range_inclusive_type, null);

            // No `slice` in scope: a project whose runtime does not supply
            // one has nothing for a range index to reach.
            lookup.get_slice_functions() |> returns(null, null);

            return (
                RANGE_SLICE_RESOLVER(
                    lookup,
                    IoC.CONTAINER.instance.overload_resolver,
                    IoC.CONTAINER.instance.function_caller,
                    IoC.CONTAINER.instance.logger
                ),
                range_type,
                other_type,
                int_range_type,
                int_range_inclusive_type
            );
        si

        @Test()
        Calling__is_range__with_a_range__is_true() is
            let b = build();

            is_true(b.resolver.is_range(b.range_type));
        si

        @Test()
        Calling__is_range__with_another_type__is_false() is
            let b = build();

            is_false(b.resolver.is_range(b.other_type));
        si

        @Test()
        Calling__is_range__with_an_int_range__is_true() is
            let b = build();

            is_true(b.resolver.is_range(b.int_range_type));
        si

        @Test()
        Calling__is_range__with_an_int_range_inclusive__is_true() is
            let b = build();

            is_true(b.resolver.is_range(b.int_range_inclusive_type));
        si

        @Test()
        Calling__try_resolve__with_a_non_range_index__declines() is
            let b = build();

            is_null(
                b.resolver.try_resolve(
                    loc(),
                    IR.Values.DUMMY(b.other_type, loc()),
                    b.other_type));
        si

        @Test()
        Calling__try_resolve__with_no_slice_in_scope__declines() is
            let b = build();

            is_null(
                b.resolver.try_resolve(
                    loc(),
                    IR.Values.DUMMY(b.other_type, loc()),
                    b.range_type));
        si
    si
si
