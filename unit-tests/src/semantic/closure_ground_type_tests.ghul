namespace Semantic.UnitTests is
    use Collections.Iterable
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.Closure
    use Semantic.Symbols.Symbol

    use Semantic.Types.NAMED
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins `Closure._is_ground_type`, the predicate under the
    // delegate-memoization gate. A memoized delegate's cache field
    // bakes its type into one static signature shared by every use,
    // so the type must be ground: no type parameter, and no open
    // generic. The open-generic rule exists because a pack wrapper
    // whose callee is generic takes its type from the callee's
    // not-yet-bound return - a plain NAMED over the callee's own
    // variant or class symbol, with no arguments for the
    // type-argument walk to find.
    @TestClass()
    class CLOSURE_GROUND_TYPE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        closure_in(host: CLASS) -> Closure is
            return Semantic.Symbols.STATIC_CLOSURE(loc(), host, "$anon_0", host, false)
        si

        build_class(name: string, parameters: LIST[string]) -> CLASS is
            let klass = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, parameters, Semantic.BLOCK_SCOPE())

            for p in parameters do
                let t = CLASSY_GENERIC_ARGUMENT(loc(), klass, p, 0)

                klass.declare(loc(), t, null)
            od

            return klass
        si

        int_type() -> Type is
            return build_class("int", LIST[string]()).type!
        si

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]()

            for v in values do
                result.add(v)
            od

            return result
        si

        @Test()
        Calling__is_ground_type__with_a_class_type__returns_true() is
            let host = build_class("Host", LIST[string]())
            let closure = closure_in(host)

            is_true(closure._is_ground_type(int_type()))
        si

        @Test()
        Calling__is_ground_type__with_a_type_parameter_type__returns_false() is
            let host = build_class("Host", LIST[string]())
            let closure = closure_in(host)
            let generic_class = build_class("Thing", names_for(["T"]))

            let t = generic_class.find_direct("T")

            is_false(closure._is_ground_type(cast Symbols.Symbol?(t)!.type!))
        si

        @Test()
        Calling__is_ground_type__with_a_named_over_a_generic_type_symbol__returns_false() is
            let host = build_class("Host", LIST[string]())
            let closure = closure_in(host)
            let generic_class = build_class("Thing", names_for(["T"]))

            is_false(closure._is_ground_type(NAMED(generic_class)))
        si

        @Test()
        Calling__is_ground_type__with_a_named_over_a_nongeneric_type_symbol__returns_true() is
            let host = build_class("Host", LIST[string]())
            let closure = closure_in(host)

            is_true(closure._is_ground_type(NAMED(build_class("Plain", LIST[string]()))))
        si
    si
si
