namespace Semantic.UnitTests is
    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Logging.DIAGNOSTICS_STORE;

    use Semantic.SYMBOL_TABLE;
    use Semantic.TYPE_ARG_PLACEHOLDER_REGISTRY;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.INSTANCE_METHOD;
    use Semantic.Symbols.Variable;

    use Semantic.Types.Type;

    use Syntax.Trees.Node;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for TYPE_ARG_PLACEHOLDER_REGISTRY — the stateful cache
    // that backs iterative-inference at constructor expressions.
    //
    // The cache's correctness rests on two properties:
    //
    //   - Stability: re-asking for the same cache_key returns the
    //     SAME LIST instance with the SAME phantom Variables. Body-
    //     retry depends on this — constraints pushed into a phantom's
    //     _lub_map on iteration N must be visible to the LUB lookup
    //     on iteration N+1.
    //
    //   - Width: get_or_create produces exactly one phantom per
    //     argument_name on the type symbol. Phantom_origins lists
    //     consumed by OWNER_TYPE_ARG_SPECIALIZER align positionally
    //     with argument_names; a too-short list would silently leave
    //     slots unbound.
    //
    // specialize_with_placeholders is the entry consumed by
    // resolve_constructor — bail-out branches are tested directly;
    // the positive path (which calls GENERIC.try_create_from +
    // find_specialized_function) is integration-test territory.
    @TestClass()
    class TYPE_ARG_PLACEHOLDER_REGISTRY_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        empty_names() -> LIST[string] => LIST[string]();
        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]();
            for v in values do result.add(v); od
            return result;
        si

        build_registry() -> TYPE_ARG_PLACEHOLDER_REGISTRY is
            let logger = DIAGNOSTICS_STORE();
            let symbol_table = SYMBOL_TABLE(logger);

            // A phantom is owned by the function whose call site is
            // being resolved, so the table needs one on its stack.
            let scope = Semantic.BLOCK_SCOPE();
            let owner = CLASS(loc(), loc(), scope, "Owner", empty_names(), Semantic.BLOCK_SCOPE());

            symbol_table.enter_scope(INSTANCE_METHOD(loc(), loc(), owner, "resolving", Semantic.BLOCK_SCOPE()));

            return TYPE_ARG_PLACEHOLDER_REGISTRY(symbol_table);
        si

        // === get_or_create ===

        @Test()
        Calling__get_or_create__on_one_arg_classy__produces_one_phantom() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let origins = registry.get_or_create(key, loc(), box);

            is_not_null(origins);
            are_equal(1, origins.count);
            is_not_null(origins[0]);
        si

        @Test()
        Calling__get_or_create__on_two_arg_classy__produces_two_phantoms() is
            let registry = build_registry();
            let pair = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Pair", names_for(["T", "U"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let origins = registry.get_or_create(key, loc(), pair);

            are_equal(2, origins.count);
            is_not_null(origins[0]);
            is_not_null(origins[1]);
        si

        // Stability: re-asking the same cache_key returns the SAME
        // list instance (not just one equal in content). Body-retry's
        // constraint accumulation depends on this — iter N+1 reads
        // the same phantom-_lub_map iter N wrote to.
        @Test()
        Calling__get_or_create__with_same_cache_key__returns_same_list() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let first = registry.get_or_create(key, loc(), box);
            let second = registry.get_or_create(key, loc(), box);

            are_same(first, second);
            are_same(first[0], second[0]);
        si

        // Distinct cache_keys produce distinct phantom lists. Each
        // call expression in the source gets its own phantoms so
        // match propagation at one call site doesn't bleed into another.
        @Test()
        Calling__get_or_create__with_distinct_cache_keys__returns_distinct_lists() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let key_a = Syntax.Trees.Identifiers.Identifier(loc(), "key");
            let key_b = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let a = registry.get_or_create(key_a, loc(), box);
            let b = registry.get_or_create(key_b, loc(), box);

            are_not_same(a, b);
            are_not_same(a[0], b[0]);
        si

        // Same cache_key but distinct container symbols must produce
        // distinct phantom lists. This is the operator-path shape:
        // visit_binary issues two retries from the same BINARY node,
        // one against the free-function `$$` group and one against
        // any member operator of the LHS type — the two retries' phantoms
        // stand in for the type-args of different functions and must
        // not share storage.
        @Test()
        Calling__get_or_create__with_same_key_distinct_classy__returns_distinct_lists() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let pair = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Pair", names_for(["T", "U"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let box_origins = registry.get_or_create(key, loc(), box);
            let pair_origins = registry.get_or_create(key, loc(), pair);

            are_not_same(box_origins, pair_origins);
            are_equal(1, box_origins.count);
            are_equal(2, pair_origins.count);
            are_not_same(box_origins[0], pair_origins[0]);
        si

        // Same cache_key, same container — repeated calls still return
        // the same instance (regression guard for the two-level cache).
        @Test()
        Calling__get_or_create__with_same_key_same_classy__keeps_stability() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let first = registry.get_or_create(key, loc(), box);
            let second = registry.get_or_create(key, loc(), box);

            are_same(first, second);
            are_same(first[0], second[0]);
        si

        // Same cache_key but distinct Function symbols must produce
        // distinct phantom lists — the function-own-arg variant of
        // the previous test.
        @Test()
        Calling__get_or_create_for_function__with_same_key_distinct_functions__returns_distinct_lists() is
            let registry = build_registry();
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", empty_names(), Semantic.BLOCK_SCOPE());

            let foo = Semantic.Symbols.STATIC_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE());
            foo.generic_argument_names = names_for(["T"]);

            let bar = Semantic.Symbols.STATIC_METHOD(loc(), loc(), owner, "bar", Semantic.BLOCK_SCOPE());
            bar.generic_argument_names = names_for(["U", "V"]);

            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let foo_origins = registry.get_or_create_for_function(key, loc(), foo);
            let bar_origins = registry.get_or_create_for_function(key, loc(), bar);

            are_not_same(foo_origins, bar_origins);
            are_equal(1, foo_origins.count);
            are_equal(2, bar_origins.count);
        si

        // === clear ===

        // After clear(), a previously-cached key triggers a fresh
        // create — i.e. the cache is genuinely empty. Pinned because
        // apply()-boundary clear() is the only thing keeping a
        // recompile of the same file from reusing phantoms that
        // reference Type instances from the now-wiped symbol table.
        @Test()
        Calling__clear__discards_cached_entries() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let before = registry.get_or_create(key, loc(), box);
            registry.clear();
            let after = registry.get_or_create(key, loc(), box);

            are_not_same(before, after);
        si

        // === specialize_with_placeholders: bail-out branches ===

        @Test()
        Calling__specialize_with_placeholders__with_null_cache_key__returns_candidate() is
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let init = INSTANCE_METHOD(loc(), loc(), box, "init", Semantic.BLOCK_SCOPE());

            let result = registry.specialize_with_placeholders(loc(), init, null);

            are_same(init, result);
        si

        @Test()
        Calling__specialize_with_placeholders__on_non_generic_owner__returns_candidate() is
            let registry = build_registry();
            let plain = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Plain", empty_names(), Semantic.BLOCK_SCOPE());
            let init = INSTANCE_METHOD(loc(), loc(), plain, "init", Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let result = registry.specialize_with_placeholders(loc(), init, key);

            are_same(init, result);
        si

        // === report_unresolved ===

        // Empty registry: nothing to report.
        @Test()
        Calling__report_unresolved__on_empty_registry__reports_nothing() is
            let logger = DIAGNOSTICS_STORE();
            let registry = build_registry();

            registry.report_unresolved(logger);

            is_false(logger.any_errors);
        si

        // An unresolved phantom is a construction whose type-args
        // nothing ever pinned - one error per construction site,
        // however many slots are open.
        @Test()
        Calling__report_unresolved__with_unresolved_phantoms__reports_one_error() is
            let logger = DIAGNOSTICS_STORE();
            let registry = build_registry();
            let pair = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Pair", names_for(["T", "U"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            registry.get_or_create(key, loc(), pair);

            registry.report_unresolved(logger);

            are_equal(1, logger.error_count);
        si

        // A construction reported once stays reported: the visitor
        // sweeps the registry after every function body, and a
        // phantom unresolved at the end of its own function's walk
        // stays unresolved.
        @Test()
        Calling__report_unresolved__twice__reports_once() is
            let logger = DIAGNOSTICS_STORE();
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            registry.get_or_create(key, loc(), box);

            registry.report_unresolved(logger);
            registry.report_unresolved(logger);

            are_equal(1, logger.error_count);
        si

        // A phantom whose origin settled is not an error - the
        // construction's type-arg was pinned by usage.
        @Test()
        Calling__report_unresolved__with_settled_phantoms__reports_nothing() is
            let logger = DIAGNOSTICS_STORE();
            let registry = build_registry();
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let int_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", empty_names(), Semantic.BLOCK_SCOPE());
            let key = Syntax.Trees.Identifiers.Identifier(loc(), "key");

            let origins = registry.get_or_create(key, loc(), box);
            origins[0].add_lower_bound(int_class.type!);

            registry.report_unresolved(logger);

            is_false(logger.any_errors);
        si
    si
si
