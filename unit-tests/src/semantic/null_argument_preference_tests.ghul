namespace Semantic.UnitTests is
    use Collections.LIST;
    use Collections.List;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.NULL_ARGUMENT_PREFERENCE;
    use Semantic.Symbols.CLASS;
    use Semantic.Types.ERROR;
    use Semantic.Types.INFERRED_RETURN_TYPE;
    use Semantic.Types.NAMED;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Which candidate a written `null` prefers when several score
    // alike. The distinction the predicate turns on is a `null`
    // literal against a type the compiler has not settled yet: both
    // answer `is_null`, and treating the second as the first resolves
    // ambiguities that inference needs left open.
    @TestClass()
    class NULL_ARGUMENT_PREFERENCE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        empty_names() -> LIST[string] => LIST[string]();

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE());

        bare(name: string) -> Type => a_class(name).type!;

        optional(name: string) -> Type =>
            cast NAMED(a_class(name).type!).as_optional();

        a_null() -> Type => Semantic.Types.NULL();

        list_of(types: Type[]) -> List[Type] is
            let result = LIST[Type]();

            for t in types do
                result.add(t);
            od

            return result;
        si

        @Test()
        given_null_against_an_optional_formal__accepts() is
            is_true(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([optional("object")]),
                    list_of([a_null()])));
        si

        @Test()
        given_null_against_a_non_optional_formal__declines() is
            is_false(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([bare("string")]),
                    list_of([a_null()])));
        si

        // Every `null` has to land safely, not just one of them.
        @Test()
        given_one_null_of_several_against_a_non_optional_formal__declines() is
            is_false(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([optional("object"), bare("string")]),
                    list_of([a_null(), a_null()])));
        si

        // Without a written `null` the predicate says nothing, so a
        // call that has none keeps its full field of candidates.
        @Test()
        given_no_null_argument__accepts_whatever_the_formals_are() is
            is_true(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([bare("string")]),
                    list_of([bare("string")])));
        si

        // An error type answers `is_null` as well. Reading one as a
        // written `null` would decline a candidate over a type the
        // compiler never settled.
        @Test()
        given_an_error_argument__is_not_read_as_a_written_null() is
            is_true(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([bare("string")]),
                    list_of([ERROR()])));
        si

        // The case the predicate is built around: a type inference has
        // not settled yet answers `is_null` as readily as a written
        // `null`. Declining a candidate over one collapses an
        // ambiguity the retry loop needs left open, and the call that
        // should have failed to infer quietly resolves instead.
        @Test()
        given_a_not_yet_inferred_argument__is_not_read_as_a_written_null() is
            is_true(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([bare("string")]),
                    list_of([INFERRED_RETURN_TYPE()])));
        si

        @Test()
        given_differing_arities__ignores_the_positions_beyond_the_shorter() is
            is_true(
                NULL_ARGUMENT_PREFERENCE.accepts_every_null_argument(
                    list_of([optional("object")]),
                    list_of([a_null(), a_null()])));
        si
    si
si
