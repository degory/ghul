namespace Semantic.UnitTests is
    use Collections.LIST

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns
    use NSubstitute.SubstituteExtensions.returns_for_any_args

    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Types.Type
    use Semantic.Types.GENERIC
    use Semantic.Types.NULL
    use Semantic.Types.ERROR

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the per-position least upper bound TUPLE_ELEMENT_LUB
    // builds across several tuple-literal types — the element LUB an
    // array literal's tuple elements settle at. A position where one
    // contributor is a value and another is `null` has to widen to the
    // value's optional carrier rather than settle at `null` itself,
    // which no back end can encode as a field or local's static type.
    // ARM_NULL_JOIN's own tests pin the widening decision in isolation;
    // these pin how `combine` feeds it and builds the result from it.
    @TestClass()
    class TUPLE_ELEMENT_LUB_TESTS is
        _pair_symbol: STRUCT
        _captured_element_types: LIST[Type]?

        init() is
            _pair_symbol = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Pair", LIST[string](["0", "1"]), Semantic.BLOCK_SCOPE())
            _captured_element_types = null
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        // A concrete reference type, standing in for a tuple element
        // like `string`.
        ref_type(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE()).type!

        // A concrete value type, standing in for a tuple element like
        // `double`.
        val_type(name: string) -> Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE()).type!

        type_var_type() -> Type is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
            return CLASSY_GENERIC_ARGUMENT(loc(), owner, "T", 0).type!
        si

        pair(a: Type, b: Type) -> Type =>
            GENERIC(loc(), _pair_symbol, LIST[Type]([a, b]))

        // A lookup whose `get_object_type`/`get_optional_type` build
        // observable results and whose `get_tuple_type` records the
        // per-position element types `combine` settled on, rather than
        // building a real tuple type — `combine`'s only remaining job
        // after computing those is to hand them to the lookup.
        build_lookup() -> InnateSymbolLookup is
            let lookup = Substitute.`for`[InnateSymbolLookup](System.Array.empty`[object]())
            let object_type = ref_type("Object")

            lookup.get_object_type() |> returns(object_type, null)

            lookup.get_optional_type(object_type) |> returns_for_any_args(
                (call: NSubstitute.Core.CallInfo) -> Type => call.arg`[Type]().as_optional(),
                null
            )

            lookup.get_tuple_type(LIST[Type](), null) |> returns_for_any_args(
                (call: NSubstitute.Core.CallInfo) -> Type is
                    _captured_element_types = call.arg`[LIST[Type]]()
                    return object_type
                si,
                null
            )

            return lookup
        si

        @Test()
        combine__matching_positions_with_no_null__keep_their_type() is
            let key = ref_type("Key")
            let score = val_type("Score")

            TUPLE_ELEMENT_LUB(build_lookup()).combine(
                LIST[Type]([pair(key, score), pair(key, score)]),
                null
            )

            are_same(key, _captured_element_types![0])
            are_same(score, _captured_element_types![1])
        si

        @Test()
        combine__value_position_with_a_genuine_null_sibling__widens_to_value_optional() is
            let key = ref_type("Key")
            let score = val_type("Score")

            TUPLE_ELEMENT_LUB(build_lookup()).combine(
                LIST[Type]([pair(key, score), pair(key, NULL())]),
                null
            )

            // The widened type is score.as_optional() — get_optional_type
            // is stubbed to answer exactly that for any argument.
            are_same(score.as_optional(), _captured_element_types![1])
        si

        @Test()
        combine__reference_position_with_a_genuine_null_sibling__widens_to_reference_optional() is
            let key = ref_type("Key")
            let label = ref_type("Label")

            TUPLE_ELEMENT_LUB(build_lookup()).combine(
                LIST[Type]([pair(key, label), pair(key, NULL())]),
                null
            )

            is_true(_captured_element_types![1].is_optional)
        si

        @Test()
        combine__position_where_every_contributor_is_null__settles_at_object_optional() is
            // Deliberate corner case, not chased down here: with no
            // non-null contributor at a position, `get_result()` is
            // null, so the position falls back to the object type and
            // then widens it, settling at `Object?` rather than at
            // `null`. A later change to what an all-null position
            // infers should flip this test on purpose.
            let key = ref_type("Key")

            TUPLE_ELEMENT_LUB(build_lookup()).combine(
                LIST[Type]([pair(key, NULL()), pair(key, NULL())]),
                null
            )

            is_true(_captured_element_types![1].is_optional)
        si

        @Test()
        combine__type_variable_position_with_a_genuine_null_sibling__is_left_unwidened() is
            // Deliberate corner case, not chased down here: ARM_NULL_JOIN
            // answers INCOMPATIBLE for a type-variable LUB against a
            // genuine null (NULLABLE[T] is the wrong carrier for it, see
            // ARM_NULL_JOIN_TESTS), and `combine` has no diagnostic path
            // to report that the way the if/case arm caller does — the
            // position is silently left at its unwidened type-variable
            // type. A later change to report this should flip this test
            // on purpose.
            let key = ref_type("Key")
            let element = type_var_type()

            TUPLE_ELEMENT_LUB(build_lookup()).combine(
                LIST[Type]([pair(key, element), pair(key, NULL())]),
                null
            )

            are_same(element, _captured_element_types![1])
        si

        @Test()
        combine__value_position_with_only_a_sentinel_null_sibling__is_left_unwidened() is
            // Deliberate corner case, not chased down here: an unsettled
            // (non-genuine) null — an in-progress inferred sentinel, or
            // ERROR — must not widen a value-type position (see
            // ARM_NULL_JOIN_TESTS' sentinel-null cases), and here too
            // `combine` has no diagnostic path for it: the position is
            // silently left at its unwidened value type. A later change
            // to report this should flip this test on purpose.
            let key = ref_type("Key")
            let score = val_type("Score")

            TUPLE_ELEMENT_LUB(build_lookup()).combine(
                LIST[Type]([pair(key, score), pair(key, ERROR())]),
                null
            )

            are_same(score, _captured_element_types![1])
        si
    si
si
