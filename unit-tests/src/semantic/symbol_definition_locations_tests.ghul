namespace Semantic.UnitTests is
    use Semantic.Symbols.GLOBAL_FUNCTION

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Across a rebuild, an unedited file re-declares the same symbols
    // in the same order, and each adopts the id its predecessor had;
    // an edited file, or a file whose sequence diverges, gets fresh ids.
    @TestClass()
    class SYMBOL_DEFINITION_LOCATIONS_TESTS is
        init() is si

        at(file: string, line: int) -> LOCATION => LOCATION(file, line, 1, line, 5)

        function(name: string) -> GLOBAL_FUNCTION =>
            GLOBAL_FUNCTION(LOCATION.internal, LOCATION.internal, Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())

        @Test()
        An_unedited_file_replays_its_ids_in_order() is
            let locations = SYMBOL_DEFINITION_LOCATIONS(SYMBOL_USE_LOCATIONS())

            let f = function("f")
            let g = function("g")

            locations.add_symbol_definition(at("a.ghul", 1), f)
            locations.add_symbol_definition(at("a.ghul", 2), g)

            locations.clear_and_replay_ids([])

            let f2 = function("f")
            let g2 = function("g")

            locations.add_symbol_definition(at("a.ghul", 1), f2)
            locations.add_symbol_definition(at("a.ghul", 2), g2)

            are_equal(f.id, f2.id)
            are_equal(g.id, g2.id)
        si

        @Test()
        An_edited_file_gets_fresh_ids() is
            let locations = SYMBOL_DEFINITION_LOCATIONS(SYMBOL_USE_LOCATIONS())

            let f = function("f")

            locations.add_symbol_definition(at("a.ghul", 1), f)

            locations.clear_and_replay_ids(["a.ghul"])

            let f2 = function("f")

            locations.add_symbol_definition(at("a.ghul", 1), f2)

            are_not_equal(f.id, f2.id)
        si

        @Test()
        A_diverging_sequence_stops_adopting() is
            let locations = SYMBOL_DEFINITION_LOCATIONS(SYMBOL_USE_LOCATIONS())

            let f = function("f")
            let g = function("g")
            let h = function("h")

            locations.add_symbol_definition(at("a.ghul", 1), f)
            locations.add_symbol_definition(at("a.ghul", 2), g)
            locations.add_symbol_definition(at("a.ghul", 3), h)

            locations.clear_and_replay_ids([])

            let f2 = function("f")
            let other = function("other")
            let h2 = function("h")

            locations.add_symbol_definition(at("a.ghul", 1), f2)
            locations.add_symbol_definition(at("a.ghul", 2), other)
            locations.add_symbol_definition(at("a.ghul", 3), h2)

            are_equal(f.id, f2.id)
            are_not_equal(g.id, other.id)
            are_not_equal(h.id, h2.id)
        si
    si
si
