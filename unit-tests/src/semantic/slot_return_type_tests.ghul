namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.SLOT_RETURN_TYPE

    use Semantic.Symbols.CLASS

    use Semantic.Types.ACTION
    use Semantic.Types.ACTION_0
    use Semantic.Types.FUNCTION
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins for SLOT_RETURN_TYPE.of - what return type a function-typed
    // call slot asks a literal for.
    //
    // The load-bearing case is the Action slot. Its void return is
    // stripped from `arguments`, so reading the last entry there takes
    // an input type for the return, and skipping the read altogether
    // leaves the slot looking as though it named no return at all -
    // which lets a literal keep the type its body inferred and miss the
    // only formal on offer.
    @TestClass()
    class SLOT_RETURN_TYPE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        named(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

        // A GENERIC's symbol has to be generic, with one argument name
        // per type argument, or its constructor asserts.
        generic_named(name: string, arity: int) -> CLASS is
            let names = LIST[string]()
            for i in 0..arity do names.add("T{i}"); od
            return CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, names, Semantic.BLOCK_SCOPE())
        si

        int_type() -> Type => named("int").type!
        string_type() -> Type => named("string").type!
        void_type() -> Type => named("void").type!

        types(values: Collections.Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]()
            for v in values do result.add(v); od
            return result
        si

        // `(int) -> string`: inputs then the return, last entry.
        func_int_to_string() -> Type =>
            FUNCTION(loc(), generic_named("Func", 2), types([int_type(), string_type()]))

        // `() -> string`: the return is the only entry.
        func_to_string() -> Type =>
            FUNCTION(loc(), generic_named("Func", 1), types([string_type()]))

        // `(int) -> void`: the void return is not in `arguments`, so the
        // one entry is the input type.
        action_of_int() -> Type =>
            ACTION(loc(), generic_named("Action", 1), types([int_type()]))

        @Test()
        Calling__of__with_func_slot__returns_the_last_argument() is
            are_equal(string_type().to_string(), SLOT_RETURN_TYPE.of(func_int_to_string(), void_type())!.to_string())
        si

        @Test()
        Calling__of__with_nullary_func_slot__returns_its_only_argument() is
            are_equal(string_type().to_string(), SLOT_RETURN_TYPE.of(func_to_string(), void_type())!.to_string())
        si

        // The whole point: an Action's return is void, not its last
        // input type.
        @Test()
        Calling__of__with_action_slot__returns_void() is
            are_equal(void_type().to_string(), SLOT_RETURN_TYPE.of(action_of_int(), void_type())!.to_string())
        si

        @Test()
        Calling__of__with_nullary_action_slot__returns_void() is
            are_equal(void_type().to_string(), SLOT_RETURN_TYPE.of(cast Type(ACTION_0(named("Action"))), void_type())!.to_string())
        si

        // Void is only ever the innate type the caller supplies: with
        // none to hand there is nothing to report, and the slot names
        // no return rather than a wrong one.
        @Test()
        Calling__of__with_action_slot_and_no_void_type__returns_null() is
            is_null(SLOT_RETURN_TYPE.of(action_of_int(), null))
        si
    si
si
