namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // OBLIGATIONS is the queue of rules that could not fire on a walk of
    // a function body because an input was still an inference
    // placeholder. These tests pin what recording one does, what a new
    // walk keeps, and what the fixing step reports once the body's loop
    // has stopped.
    @TestClass()
    class OBLIGATIONS_TESTS is
        init() is
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi

            IoC.CONTAINER.instance.local_id_generator.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        local(name: string) -> LOCAL_VARIABLE => LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), name)

        object_type() -> Semantic.Types.Type is
            let c = Semantic.Symbols.CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            c.mark_is_object()
            return c.type!
        si

        @Test()
        Calling__defer__should_mark_the_logger_as_having_consumed_an_unresolved_type() is
            let logger = DIAGNOSTICS_STORE()
            IoC.CONTAINER.instance.logger = logger

            OBLIGATIONS.begin_body()
            OBLIGATIONS.defer("join", INFERRED_VARIABLE_TYPE(local("a")), null)

            is_true(logger.has_consumed_any)

            OBLIGATIONS.end_body()
        si

        @Test()
        Calling__begin_walk__should_drop_the_previous_walks_obligations() is
            IoC.CONTAINER.instance.logger = DIAGNOSTICS_STORE()

            OBLIGATIONS.begin_body()
            OBLIGATIONS.defer("join", INFERRED_VARIABLE_TYPE(local("a")), null)
            OBLIGATIONS.begin_walk()

            are_equal(0, OBLIGATIONS.standing.count)

            OBLIGATIONS.end_body()
        si

        @Test()
        Calling__fix__should_report_an_unsettled_origin_once() is
            IoC.CONTAINER.instance.logger = DIAGNOSTICS_STORE()
            let logger = DIAGNOSTICS_STORE()
            let a = local("a")

            OBLIGATIONS.begin_body()
            OBLIGATIONS.defer("join", INFERRED_VARIABLE_TYPE(a), null)
            OBLIGATIONS.defer("join", INFERRED_VARIABLE_TYPE(a), loc())
            OBLIGATIONS.fix(logger)
            OBLIGATIONS.end_body()

            are_equal(1, logger.error_count)
        si

        @Test()
        Calling__fix__should_skip_an_origin_whose_type_has_settled() is
            IoC.CONTAINER.instance.logger = DIAGNOSTICS_STORE()
            let logger = DIAGNOSTICS_STORE()
            let a = local("a")
            let placeholder = INFERRED_VARIABLE_TYPE(a)

            OBLIGATIONS.begin_body()
            OBLIGATIONS.defer("join", placeholder, null)

            a.set_type(object_type())

            OBLIGATIONS.fix(logger)
            OBLIGATIONS.end_body()

            is_false(logger.any_errors)
        si

        @Test()
        Calling__fix__should_leave_a_type_argument_phantom_to_the_registry() is
            IoC.CONTAINER.instance.logger = DIAGNOSTICS_STORE()
            let logger = DIAGNOSTICS_STORE()
            let phantom = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")

            OBLIGATIONS.begin_body()
            OBLIGATIONS.defer("join", INFERRED_VARIABLE_TYPE(phantom), null)
            OBLIGATIONS.fix(logger)
            OBLIGATIONS.end_body()

            is_false(logger.any_errors)
        si
    si
si
