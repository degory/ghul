namespace Semantic.Types.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;

    // Reuses TEST_INNATE_SYMBOL_LOOKUP from
    // Semantic.UnitTests.FUNCTION_REFERENCE_RESOLVER_TESTS's file.
    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP;

    // Tests for PURE_FUNCTION_SHAPE — the pure counterpart of a
    // function/action type that a store-free lambda literal (direct
    // or via a recursive self-reference) is re-typed as.
    class PURE_FUNCTION_SHAPE_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        lookup() -> Semantic.Lookups.InnateSymbolLookup => TEST_INNATE_SYMBOL_LOOKUP();

        fn_owner() -> CLASS => CLASS(loc(), loc(), null, "Fn", LIST[string](["T", "U"]), null);

        Calling__pure_shape_of__with_a_plain_function_type__should_return_a_pure_function_type_of_the_same_shape() is
            @test()

            let l = lookup();
            let arguments = LIST[Type]([l.get_int_type(), l.get_int_type()]);

            // Built via the same lookup as pure_shape_of uses
            // internally, so the two share the same owner symbol —
            // compare() keys on symbol identity, and a fixture-only
            // owner mismatch would fail this for a reason unrelated
            // to purity.
            let plain = l.get_function_type(arguments);
            let pure = PURE_FUNCTION_SHAPE.pure_shape_of(plain, l);

            Assert.is_true(pure?);
            Assert.is_true(pure!.is_pure_function);
            Assert.are_equal(plain.compare(pure!), MATCH.SAME);
        si

        Calling__pure_shape_of__with_an_already_pure_function_type__should_return_null() is
            @test()

            let l = lookup();
            let arguments = LIST[Type]([l.get_int_type(), l.get_int_type()]);
            let pure_already = Semantic.Types.PURE_FUNCTION(loc(), fn_owner(), arguments);

            Assert.is_null(PURE_FUNCTION_SHAPE.pure_shape_of(pure_already, l));
        si

        Calling__pure_shape_of__with_a_non_function_type__should_return_null() is
            @test()

            let l = lookup();

            Assert.is_null(PURE_FUNCTION_SHAPE.pure_shape_of(l.get_int_type(), l));
        si

        Calling__pure_shape_of__with_an_action_type__should_append_void_to_the_pure_shapes_arguments() is
            @test()

            let l = lookup();
            let action = Semantic.Types.ACTION(loc(), fn_owner(), LIST[Type]([l.get_int_type()]));

            let pure = PURE_FUNCTION_SHAPE.pure_shape_of(action, l);

            Assert.is_true(pure?);
            Assert.is_true(pure!.is_pure_function);
            Assert.are_equal(pure!.arguments.count, 2);
        si
    si
si
