namespace Semantic.Types.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A pointer answers `is_value_type` like any other value type, so
    // the decisions that must not treat one as boxable — the boxing
    // boundary, and the comparison that would otherwise box to reconcile
    // a value type with a reference — ask `is_pointer` instead.
    @TestClass()
    class POINTER_TYPE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);
        empty_names() -> LIST[string] => LIST[string]();

        make_class_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE());
            c.set_type(Semantic.Types.NAMED(c));
            return c.type!;
        si

        names_for(values: Collections.Iterable[string]) -> LIST[string] is
            let result = LIST[string]();

            for v in values do
                result.add(v);
            od

            return result;
        si

        // The pointer's own symbol has to be generic: a pointer is a
        // one-argument generic over what it points at.
        make_pointer(pointee: Type) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "POINTER", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let arguments = LIST[Type]();

            arguments.add(pointee);

            return Semantic.Types.POINTER(loc(), c, arguments);
        si

        @Test()
        is_pointer__on_a_pointer__is_true() is
            let pointee = make_class_type("int");

            is_true(make_pointer(pointee).is_pointer);
        si

        @Test()
        is_pointer__on_a_class__is_false() is
            is_false(make_class_type("Animal").is_pointer);
        si

        // The reason the flag exists rather than the boxing decision
        // reading `is_value_type`: a pointer answers true to that, and
        // the CLI has no boxed form for one.
        @Test()
        is_value_type__on_a_pointer__does_not_distinguish_it() is
            let pointee = make_class_type("int");
            let pointer = make_pointer(pointee);

            is_true(pointer.is_pointer);
            is_false(pointee.is_pointer);
        si
    si
si
