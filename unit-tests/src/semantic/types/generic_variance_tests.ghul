namespace Semantic.Types.UnitTests is
    use Collections.LIST;
    use Collections.List;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.Classy;
    use Semantic.Symbols.STRUCT;
    use Semantic.Types.GENERIC;
    use Semantic.Types.MATCH;
    use Semantic.Types.TypeVariance;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for variance lookup on Types.GENERIC. ghūl reads per-parameter
    // variance from .NET reflection metadata and stores it on
    // Symbols.Classy.argument_variances; Types.GENERIC.get_argument_type_variance
    // returns that declared variance — whether a position is co/contra/
    // invariant — with no awareness of value types. GENERIC.
    // effective_argument_variance applies the CLR rule that a variant
    // conversion additionally requires the actual type argument at that
    // position to be a reference type on both sides of the comparison,
    // downgrading to invariant otherwise.
    @TestClass()
    class GENERIC_VARIANCE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        empty_names() -> LIST[string] => LIST[string]();

        // Build a minimal {object, animal, cat} hierarchy plus an int-like
        // STRUCT (for value-type tests).
        build_hierarchy() -> (object_class: CLASS, animal: CLASS, cat: CLASS, int_struct: STRUCT) is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", empty_names(), Semantic.BLOCK_SCOPE());
            object_class.mark_is_object();

            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "animal", empty_names(), Semantic.BLOCK_SCOPE());
            animal.add_ancestor(object_class.type!);

            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "cat", empty_names(), Semantic.BLOCK_SCOPE());
            cat.add_ancestor(animal.type!);

            let int_struct = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", empty_names(), Semantic.BLOCK_SCOPE());
            int_struct.add_ancestor(object_class.type!);

            return (object_class, animal, cat, int_struct);
        si

        @Test()
        Get_argument_variance__on_classy_with_no_variances_set__returns_INVARIANT() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "owner", ["T"], Semantic.BLOCK_SCOPE());

            are_equal(TypeVariance.INVARIANT, owner.get_argument_variance(0));
        si

        @Test()
        Get_argument_variance__on_classy_with_variances_set__returns_declared() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "owner", ["T", "U"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT, TypeVariance.CONTRAVARIANT];

            are_equal(TypeVariance.COVARIANT, owner.get_argument_variance(0));
            are_equal(TypeVariance.CONTRAVARIANT, owner.get_argument_variance(1));
        si

        @Test()
        Get_argument_variance__with_out_of_range_index__returns_INVARIANT() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "owner", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            are_equal(TypeVariance.INVARIANT, owner.get_argument_variance(-1));
            are_equal(TypeVariance.INVARIANT, owner.get_argument_variance(5));
        si

        @Test()
        Generic_type__get_argument_type_variance__with_reference_arg__returns_declared() is
            let h = build_hierarchy();

            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let args = LIST[Type]();
            args.add(h.cat.type!);

            let g = GENERIC(loc(), owner, args);

            are_equal(TypeVariance.COVARIANT, g.get_argument_type_variance(0));
        si

        @Test()
        Generic_type__get_argument_type_variance__with_value_type_arg__still_returns_declared() is
            let h = build_hierarchy();

            // get_argument_type_variance returns the declared shape of
            // the position regardless of the argument's own type.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let args = LIST[Type]();
            args.add(h.int_struct.type!);

            let g = GENERIC(loc(), owner, args);

            are_equal(TypeVariance.COVARIANT, g.get_argument_type_variance(0));
        si

        @Test()
        Generic_type__effective_argument_variance__with_reference_args__returns_declared() is
            let h = build_hierarchy();

            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let target = GENERIC(loc(), owner, LIST[Type]([h.animal.type!]));
            let source = GENERIC(loc(), owner, LIST[Type]([h.cat.type!]));

            are_equal(TypeVariance.COVARIANT, target.effective_argument_variance(source, 0));
        si

        @Test()
        Generic_type__effective_argument_variance__with_value_type_arg_on_source_side__is_invariant() is
            let h = build_hierarchy();

            // Iterable[int] does not satisfy Iterable[object]: even though
            // the parameter is declared covariant, C#'s IEnumerable<int>
            // does not satisfy IEnumerable<object> because variance only
            // applies to reference type arguments.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let target = GENERIC(loc(), owner, LIST[Type]([h.object_class.type!]));
            let source = GENERIC(loc(), owner, LIST[Type]([h.int_struct.type!]));

            are_equal(TypeVariance.INVARIANT, target.effective_argument_variance(source, 0));
        si

        @Test()
        Generic_type__effective_argument_variance__with_value_type_arg_on_target_side__is_invariant() is
            let h = build_hierarchy();

            // The other direction of the same restriction: a value type
            // landing on the target side must suppress variance too.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let target = GENERIC(loc(), owner, LIST[Type]([h.int_struct.type!]));
            let source = GENERIC(loc(), owner, LIST[Type]([h.object_class.type!]));

            are_equal(TypeVariance.INVARIANT, target.effective_argument_variance(source, 0));
        si

        @Test()
        Generic_type__compare__with_value_type_arg_on_source_side__is_invariant() is
            let h = build_hierarchy();

            // Iterable[int] does not satisfy Iterable[object]: even though
            // the parameter is declared covariant, C#'s IEnumerable<int>
            // does not satisfy IEnumerable<object> because variance only
            // applies to reference type arguments.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let target = GENERIC(loc(), owner, LIST[Type]([h.object_class.type!]));
            let source = GENERIC(loc(), owner, LIST[Type]([h.int_struct.type!]));

            are_equal(MATCH.DIFFERENT, target.compare(source));
        si

        @Test()
        Generic_type__compare__with_value_type_arg_on_target_side__is_invariant() is
            let h = build_hierarchy();

            // The other direction of the same restriction: Iterable[object]
            // does not satisfy Iterable[int] either, even structurally
            // (the actual argument types differ), so the value type
            // landing on the target side must suppress variance too.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "iterable_like", ["T"], Semantic.BLOCK_SCOPE());
            owner.argument_variances = [TypeVariance.COVARIANT];

            let target = GENERIC(loc(), owner, LIST[Type]([h.int_struct.type!]));
            let source = GENERIC(loc(), owner, LIST[Type]([h.object_class.type!]));

            are_equal(MATCH.DIFFERENT, target.compare(source));
        si

        @Test()
        Generic_type__get_argument_type_variance__with_unset_variances__returns_INVARIANT() is
            let h = build_hierarchy();

            // Source-defined ghūl classes have no variance metadata;
            // they default to INVARIANT.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ghul_generic", ["T"], Semantic.BLOCK_SCOPE());

            let args = LIST[Type]();
            args.add(h.cat.type!);

            let g = GENERIC(loc(), owner, args);

            are_equal(TypeVariance.INVARIANT, g.get_argument_type_variance(0));
        si
    si
si
