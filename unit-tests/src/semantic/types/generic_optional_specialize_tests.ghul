namespace Semantic.Types.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Types.GENERIC
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins that specialising a generic instantiation keeps its
    // optionality: `BOX[T]?` with `T := cat` is `BOX[cat]?`, not the
    // non-optional `BOX[cat]` a rebuild from the new arguments gives.
    @TestClass()
    class GENERIC_OPTIONAL_SPECIALIZE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class(name: string, parameters: LIST[string]) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, parameters, Semantic.BLOCK_SCOPE())

        // BOX[T] over a type parameter T of BOX, plus a map from T to cat.
        setup() -> (box_of_t: GENERIC, cat: Type, map: MAP[Symbols.Symbol, Type]) is
            let box = a_class("BOX", LIST[string](["T"]))
            let cat = a_class("cat", LIST[string]()).type!
            let t = CLASSY_GENERIC_ARGUMENT(loc(), box, "T", 0)

            let map = MAP[Symbols.Symbol, Type]()
            map.add(t, cat)

            return (GENERIC(loc(), box, LIST[Type]([t.type!])), cat, map)
        si

        @Test()
        specialize__on_an_optional_generic__keeps_it_optional() is
            let (box_of_t, cat, map) = setup()

            let specialized = cast GENERIC(box_of_t.as_optional().specialize(map))

            is_true(specialized.is_optional)
            are_same(cat, specialized.arguments[0])
        si

        @Test()
        specialize__on_a_non_optional_generic__leaves_it_non_optional() is
            let (box_of_t, cat, map) = setup()

            let specialized = cast GENERIC(box_of_t.specialize(map))

            is_false(specialized.is_optional)
            are_same(cat, specialized.arguments[0])
        si
    si
si
