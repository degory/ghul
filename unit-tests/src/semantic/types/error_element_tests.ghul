namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Semantic.Types.ERROR
    use Semantic.Types.ERROR_ELEMENT
    use Semantic.Types.FUNCTION
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // ERROR_ELEMENT answers whether a composite type holds ERROR inside it.
    // ERROR on its own is a sentinel, tested by is_sentinel rather than here.
    @TestClass()
    class ERROR_ELEMENT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        names(count: int) -> LIST[string] is
            let result = LIST[string]()

            for i in 0..count do
                result.add("T{i}")
            od

            return result
        si

        int_type() -> Type => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

        function_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "function", names(2), Semantic.BLOCK_SCOPE())

        function_of(argument: Type, result: Type) -> Type => FUNCTION(loc(), function_class(), LIST[Type]([argument, result]))

        @Test()
        Calling__within__on_a_generic_with_an_error_argument__should_be_true() is
            is_true(ERROR_ELEMENT.within(function_of(int_type(), ERROR())))
        si

        @Test()
        Calling__within__on_a_generic_with_an_error_argument_nested_inside_another__should_be_true() is
            is_true(ERROR_ELEMENT.within(function_of(int_type(), function_of(ERROR(), int_type()))))
        si

        @Test()
        Calling__within__on_a_generic_without_an_error_argument__should_be_false() is
            is_false(ERROR_ELEMENT.within(function_of(int_type(), int_type())))
        si

        @Test()
        Calling__within__on_error_itself__should_be_false() is
            is_false(ERROR_ELEMENT.within(ERROR()))
        si
    si
si
