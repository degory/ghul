namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A tuple type specialised from a generic one is built as a
    // Types.TUPLE rather than as the reflected wrapper it came from, and
    // is still a value tuple: its element names are what the emitted
    // metadata records.
    @TestClass()
    class TUPLE_VALUE_TUPLE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValueTuple", LIST[string](["T1", "T2"]), Semantic.BLOCK_SCOPE())

        named_tuple() -> TUPLE is
            let int = TEST_INNATE_SYMBOL_LOOKUP().get_int_type()

            let names = LIST[string?]()

            names.add("value")
            names.add("log")

            return TUPLE(loc(), owner(), LIST[Type]([int, int]), names)
        si

        @Test()
        Reading__is_value_tuple__of_a_tuple_type__should_be_true() is
            is_true(named_tuple().is_value_tuple)
        si

        @Test()
        Calling__attribute_names_for_type__on_a_named_tuple_type__should_return_its_names() is
            let names = Semantic.DotNet.TUPLE_ELEMENT_NAMES.attribute_names_for_type(named_tuple())

            is_true(names?)
            are_equal("value", names![0])
            are_equal("log", names![1])
        si
    si
si
