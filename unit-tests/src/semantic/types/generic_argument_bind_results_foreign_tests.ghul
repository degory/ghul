namespace Semantic.Types.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT;
    use Semantic.Types.GENERIC;
    use Semantic.Types.GENERIC_ARGUMENT_BIND_RESULTS;
    use Semantic.Types.GenericArgument;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A bind result whose actuals carry another function's method-level
    // type parameter must not be committed as a call-site specialization:
    // the !!N index has no meaning outside that function.
    @TestClass()
    class GENERIC_ARGUMENT_BIND_RESULTS_FOREIGN_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);
        empty_names() -> LIST[string] => LIST[string]();

        make_owner(name: string) -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE());

        make_fga_type(owner: CLASS, name: string) -> Type is
            let arg = FUNCTION_GENERIC_ARGUMENT(loc(), owner, name, 0);
            return arg.type!;
        si

        make_fga_slot(owner: CLASS, name: string) -> GenericArgument is
            let arg = FUNCTION_GENERIC_ARGUMENT(loc(), owner, name, 0);
            return cast GenericArgument(arg.type!);
        si

        @Test()
        foreign_actual_is_detected() is
            let declaring = make_owner("declaring");
            let compiling = make_owner("compiling");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            is_true(results.bind(make_fga_slot(compiling, "A"), make_fga_type(declaring, "E")));
            is_true(results.contains_function_generic_argument_foreign_to(compiling));
        si

        @Test()
        own_actual_is_not_foreign() is
            let compiling = make_owner("compiling");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            is_true(results.bind(make_fga_slot(compiling, "A"), make_fga_type(compiling, "U")));
            is_false(results.contains_function_generic_argument_foreign_to(compiling));
        si

        @Test()
        nested_foreign_actual_is_detected() is
            let declaring = make_owner("declaring");
            let compiling = make_owner("compiling");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            let foreign = make_fga_type(declaring, "E");
            let iterable = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Iterable", ["T"], Semantic.BLOCK_SCOPE());
            let nested = GENERIC(loc(), iterable, LIST[Type]([foreign]));

            is_true(results.bind(make_fga_slot(compiling, "A"), nested));
            is_true(results.contains_function_generic_argument_foreign_to(compiling));
        si

        @Test()
        empty_bindings_are_never_foreign() is
            let compiling = make_owner("compiling");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            is_false(results.contains_function_generic_argument_foreign_to(compiling));
            is_false(results.contains_function_generic_argument_foreign_to(null));
        si
    si
si
