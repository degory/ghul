namespace Semantic.Types.UnitTests is
    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Types.NAMED;
    use Semantic.Types.Type;

    // `null` is a value of optional types alone, so a slot declared
    // non-optional rejects one. Two predicates carry that between them and
    // they answer different questions, which is why both are pinned here.
    //
    // `Type.accepts_null` is asked of the slot: it admits a pointer, whose
    // null is the zero address rather than a wrapper around one, and refuses
    // a `ref`, which is only ever formed by taking the address of a variable
    // and so has no null to write. `NULL.compare` is asked of the literal
    // and admits neither, because a written `null` reaches a pointer or a
    // `ref` slot through the slot's own comparison rather than through this
    // one.
    //
    // `NULL.compare` admits a type variable where the named and generic
    // sides route type variables elsewhere: an unconstrained `T` can still
    // be instantiated at an optional type, so the literal cannot be refused
    // against one on the strength of the parameter alone.
    class NULL_ASSIGNABILITY_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        scope() -> Semantic.Scope => Semantic.BLOCK_SCOPE();

        empty_names() -> LIST[string] => LIST[string]();

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]();

            for v in values do
                result.add(v);
            od

            return result;
        si

        make_class_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), scope(), name, empty_names(), scope());

            c.set_type(NAMED(c));

            return c.type!;
        si

        // A one-argument generic over what it points at, which is the shape
        // both POINTER and REFERENCE are built from.
        make_wrapper_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), scope(), name, names_for(["T"]), scope());

        make_pointer(pointee: Type) -> Type is
            let arguments = LIST[Type]();

            arguments.add(pointee);

            return Semantic.Types.POINTER(loc(), make_wrapper_class("POINTER"), arguments);
        si

        make_ref(pointee: Type) -> Type is
            let arguments = LIST[Type]();

            arguments.add(pointee);

            return Semantic.Types.REFERENCE(loc(), make_wrapper_class("REFERENCE"), arguments);
        si

        make_type_variable(name: string) -> Type is
            let a = Semantic.Symbols.CLASSY_GENERIC_ARGUMENT(loc(), scope(), name, 0);

            return a.type!;
        si

        // accepts_null — asked of the slot

        accepts_null__on_an_optional_named_type__is_true() is
            @test()

            Assert.is_true(make_class_type("Animal").as_optional().accepts_null);
        si

        accepts_null__on_a_non_optional_named_type__is_false() is
            @test()

            Assert.is_false(make_class_type("Animal").accepts_null);
        si

        // A pointer's absent value is the null pointer. `T ptr?` would be a
        // `Nullable[T ptr]`, which is a different thing, so there is no
        // spelling that would carry this if the flag did not.
        accepts_null__on_a_pointer__is_true() is
            @test()

            Assert.is_true(make_pointer(make_class_type("int")).accepts_null);
        si

        // A `ref` is only ever formed by taking the address of a variable.
        // Admitting one let `f(null)` compile against a `ref` parameter and
        // fault when the callee wrote through it.
        accepts_null__on_a_ref__is_false() is
            @test()

            Assert.is_false(make_ref(make_class_type("int")).accepts_null);
        si

        // NULL.compare — asked of the literal

        compare__against_an_optional_named_type__is_ASSIGNABLE() is
            @test()

            let target = make_class_type("Animal").as_optional();

            Assert.are_equal(Types.MATCH.ASSIGNABLE, Types.NULL().compare(target));
        si

        compare__against_a_non_optional_named_type__is_DIFFERENT() is
            @test()

            let target = make_class_type("Animal");

            Assert.are_equal(Types.MATCH.DIFFERENT, Types.NULL().compare(target));
        si

        // An unconstrained `T` can still be instantiated at an optional
        // type, so the literal is not refused against the parameter itself.
        compare__against_a_type_variable__is_ASSIGNABLE() is
            @test()

            Assert.are_equal(Types.MATCH.ASSIGNABLE, Types.NULL().compare(make_type_variable("T")));
        si

        // A type that is already broken draws its own diagnostic; refusing
        // it here would put a second one on top.
        compare__against_an_error__is_ASSIGNABLE() is
            @test()

            Assert.are_equal(Types.MATCH.ASSIGNABLE, Types.NULL().compare(Types.ERROR()));
        si

        compare__against_a_type_still_being_inferred__is_ASSIGNABLE() is
            @test()

            let origin = Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN(loc(), scope(), "p");
            let inferred = Types.INFERRED_VARIABLE_TYPE(origin);

            Assert.are_equal(Types.MATCH.ASSIGNABLE, Types.NULL().compare(inferred));
        si

        // The literal reaches a pointer slot through the slot's own
        // comparison, not through this one - so the two predicates
        // deliberately disagree here.
        compare__against_a_pointer__is_DIFFERENT() is
            @test()

            let target = make_pointer(make_class_type("int"));

            Assert.are_equal(Types.MATCH.DIFFERENT, Types.NULL().compare(target));
        si

        // The slot side

        named_compare__of_a_non_optional_class_against_null__is_DIFFERENT() is
            @test()

            let target = make_class_type("Animal");

            Assert.are_equal(Types.MATCH.DIFFERENT, target.compare(Types.NULL()));
        si

        named_compare__of_an_optional_class_against_null__is_ASSIGNABLE() is
            @test()

            let target = make_class_type("Animal").as_optional();

            Assert.are_equal(Types.MATCH.ASSIGNABLE, target.compare(Types.NULL()));
        si

        generic_compare__of_a_pointer_against_null__is_ASSIGNABLE() is
            @test()

            let target = make_pointer(make_class_type("int"));

            Assert.are_equal(Types.MATCH.ASSIGNABLE, target.compare(Types.NULL()));
        si

        generic_compare__of_a_ref_against_null__is_DIFFERENT() is
            @test()

            let target = make_ref(make_class_type("int"));

            Assert.are_equal(Types.MATCH.DIFFERENT, target.compare(Types.NULL()));
        si

        // An error answers `is_null` as well as a written null does, so the
        // sentinel test in GENERIC.compare has to run before the null test.
        // Reordering them makes a construction reject an already-broken
        // argument and report a second diagnostic over the first; nothing
        // else in the suite states this.
        generic_compare__of_a_non_optional_generic_against_an_error__is_ASSIGNABLE() is
            @test()

            let target = make_pointer(make_class_type("int"));

            Assert.are_equal(Types.MATCH.ASSIGNABLE, target.compare(Types.ERROR()));
        si

        generic_compare__of_a_ref_against_an_error__is_ASSIGNABLE() is
            @test()

            let target = make_ref(make_class_type("int"));

            Assert.are_equal(Types.MATCH.ASSIGNABLE, target.compare(Types.ERROR()));
        si
    si
si
