namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Types.INTERSECTION
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Type.type_variable_side names the type variable a value is loaded
    // as, so `box` and `constrained.` can reach it through a narrowed
    // view that composed the variable with what it was tested against.
    @TestClass()
    class TYPE_VARIABLE_SIDE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        make_owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", empty_names(), Semantic.BLOCK_SCOPE())

        make_trait_type(name: string) -> Type is
            let t = Semantic.Symbols.TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            t.set_type(Semantic.Types.NAMED(t))
            return t.type!
        si

        make_variable_type(name: string) -> Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), make_owner(), name, 0).type!

        @Test()
        type_variable_side_is_the_variable_itself() is
            let t = make_variable_type("T")

            are_same(t, t.type_variable_side)
        si

        @Test()
        type_variable_side_is_null_for_a_plain_type() is
            is_null(make_trait_type("Named").type_variable_side)
        si

        @Test()
        type_variable_side_reaches_through_a_composed_narrow() is
            let t = make_variable_type("T")
            let named = make_trait_type("Named")
            let composed = INTERSECTION.create(t, named)

            is_true(isa INTERSECTION(composed))
            are_same(t, composed.type_variable_side)
        si

        @Test()
        type_variable_side_is_null_for_a_composed_narrow_of_plain_types() is
            let composed = INTERSECTION.create(make_trait_type("Named"), make_trait_type("Sized"))

            is_true(isa INTERSECTION(composed))
            is_null(composed.type_variable_side)
        si
    si
si
