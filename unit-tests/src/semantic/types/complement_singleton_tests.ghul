namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The mark a narrowing carries when it reached a single concrete
    // type by eliminating the alternatives rather than by testing the
    // value. A use of such a type is unchecked, and under --submission a
    // later cell can add an alternative the elimination never saw.
    //
    // What these pin is that the mark is invisible to everything that
    // asks about the type, and that it goes where it has to go and
    // nowhere else. The type must compare, hash and assign exactly as
    // the unmarked one does, or overload resolution, joins and the
    // editor would start telling the two apart.
    @TestClass()
    class COMPLEMENT_SINGLETON_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        no_arguments() -> LIST[string] => LIST[string]()

        a_class(name: string) -> Symbols.CLASS =>
            Symbols.CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, no_arguments(), Semantic.BLOCK_SCOPE())

        // A root with two alternatives, of which one is eliminated.
        complement_of_two() -> NAMED? is
            let root = a_class("Animal")
            let cat = a_class("CAT")
            let dog = a_class("DOG")

            let remaining = LIST[Symbols.Classy]()

            remaining.add(dog)

            return ONE_OF.create(NAMED(root), remaining)
        si

        complement_of_three_leaving_two() -> NAMED? is
            let root = a_class("Beast")
            let dog = a_class("BDOG")
            let fox = a_class("BFOX")

            let remaining = LIST[Symbols.Classy]()

            remaining.add(dog)
            remaining.add(fox)

            return ONE_OF.create(NAMED(root), remaining)
        si

        marks() -> COMPLEMENT_SINGLETONS => IoC.CONTAINER.instance.complement_singletons

        in_a_submission(body: () -> void) is
            let flags = IoC.CONTAINER.instance.build_flags
            let was = flags.submission_name

            flags.submission_name = "cell"

            try
                body()
            finally
                flags.submission_name = was
            yrt
        si

        @Test()
        a_complement_that_collapses_to_one__is_marked() is
            let narrowed: NAMED? mut = null

            in_a_submission(() -> void is narrowed = complement_of_two(); si)

            assert narrowed? else "eliminating one of two leaves a type"

            is_true(marks().contains(narrowed))
        si

        // Only the root's own members are reachable through a
        // multi-member complement, so a use of it is already safe and
        // there is nothing to guard.
        @Test()
        a_complement_that_leaves_several__is_not_marked() is
            let narrowed: NAMED? mut = null

            in_a_submission(() -> void is narrowed = complement_of_three_leaving_two(); si)

            assert narrowed? else "eliminating one of three leaves a type"

            is_false(marks().contains(narrowed))
        si

        // The type a positive test produces is the same type, and it
        // was checked, so it must not carry the mark.
        @Test()
        a_positive_narrow__is_not_marked() is
            let root = a_class("Animal")
            let cat = a_class("CAT")

            let narrowed: NAMED? mut = null

            in_a_submission(() -> void is narrowed = ONE_OF.build_singleton_subtype(NAMED(root), cat); si)

            assert narrowed? else "a positive narrow produces a type"

            is_false(marks().contains(narrowed))
        si

        // A plain type of the same symbol carries nothing, which is
        // what makes the mark worth having.
        @Test()
        a_plain_type__is_not_marked() is
            is_false(marks().contains(NAMED(a_class("DOG"))))
        si

        // The whole mechanism is inert outside a session: an ordinary
        // build never records anything, so the loads it emits never
        // consult a non-empty set and never carry a check.
        @Test()
        an_ordinary_build__marks_nothing() is
            let narrowed = complement_of_two()

            assert narrowed? else "eliminating one of two leaves a type"

            is_false(marks().contains(narrowed))
        si

        // Viewing the narrowed value as optional does not check it, so
        // the mark has to survive: the clone as_optional takes keeps it.
        @Test()
        marking_survives_becoming_optional() is
            let narrowed: NAMED? mut = null

            in_a_submission(() -> void is narrowed = complement_of_two(); si)

            assert narrowed? else "eliminating one of two leaves a type"

            let optional = narrowed!.as_optional()

            marks().carry(narrowed, optional)

            is_true(marks().contains(optional), "an optional view was not checked either")
        si

        // The mark says how the type was reached, not what it is, so
        // nothing that asks about the type may see it.
        @Test()
        a_marked_type__is_the_same_type_as_an_unmarked_one() is
            let root = a_class("Animal")
            let dog = a_class("DOG")

            let remaining = LIST[Symbols.Classy]()

            remaining.add(dog)

            let marked: NAMED? mut = null

            in_a_submission(() -> void is marked = ONE_OF.create(NAMED(root), remaining); si)

            assert marked? else "eliminating one of two leaves a type"

            let marked_type = marked!
            let plain = NAMED(dog)

            are_equal(
                Types.MATCH.SAME,
                marked_type.compare(plain),
                "a marked type compares the same as the plain one"
            )

            are_equal(
                Types.MATCH.SAME,
                plain.compare(marked_type),
                "and the comparison is symmetric"
            )

            is_true(plain.is_assignable_from(marked_type), "a marked value goes where the plain type is wanted")
            is_true(marked_type.is_assignable_from(plain), "and the plain value goes where the marked one is")
        si
    si
si
