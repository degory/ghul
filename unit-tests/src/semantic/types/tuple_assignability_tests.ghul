namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Types.Type
    use Semantic.Types.TUPLE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class TUPLE_ASSIGNABILITY_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        build() -> (object_type: Type, animal: Type, cat: Type, value: Type, value_tuple: CLASS) is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()

            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "animal", LIST[string](), Semantic.BLOCK_SCOPE())
            animal.add_ancestor(object_class.type!)

            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "cat", LIST[string](), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            let value = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "value", LIST[string](), Semantic.BLOCK_SCOPE())
            value.add_ancestor(object_class.type!)

            let value_tuple = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValueTuple", LIST[string](["T1", "T2"]), Semantic.BLOCK_SCOPE())

            return (object_class.type!, animal.type!, cat.type!, value.type!, value_tuple)
        si

        tuple(value_tuple: CLASS, first: Type, second: Type) -> Type =>
            TUPLE(loc(), value_tuple, LIST[Type]([first, second]), null)

        @Test()
        Calling__is_assignable_from__with_narrower_reference_elements__should_return_true() is
            let h = build()

            is_true(tuple(h.value_tuple, h.animal, h.animal).is_assignable_from(tuple(h.value_tuple, h.cat, h.animal)))
        si

        @Test()
        Calling__is_assignable_from__with_wider_reference_elements__should_return_false() is
            let h = build()

            is_false(tuple(h.value_tuple, h.cat, h.animal).is_assignable_from(tuple(h.value_tuple, h.animal, h.animal)))
        si

        @Test()
        Calling__is_assignable_from__with_a_value_type_element_widening_to_object__should_return_true() is
            let h = build()

            is_true(tuple(h.value_tuple, h.object_type, h.animal).is_assignable_from(tuple(h.value_tuple, h.value, h.cat)))
        si
    si
si
