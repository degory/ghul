namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The class marked as the root of every array accepts an array
    // type of any element, which the array's own ancestors cannot
    // express: they are traits, and the root is a class.
    @TestClass()
    class ROOT_ARRAY_TYPE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        the_root_array_class() -> CLASS is
            let result = a_class("Array")

            result.mark_is_root_array_type()

            return result
        si

        array_of(element: Type) -> Type =>
            Semantic.Types.ARRAY(
                loc(),
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ARRAY", LIST[string](["T"]), Semantic.BLOCK_SCOPE()),
                [element]
            )

        @Test()
        Calling__compare__on_the_root_array_type_with_an_array__should_return_assignable() is
            let root = the_root_array_class().type!
            let array = array_of(a_class("Element").type!)

            are_equal(MATCH.ASSIGNABLE, root.compare(array))
            is_true(root.is_assignable_from(array))
        si

        @Test()
        Calling__compare__on_an_unmarked_class_with_an_array__should_return_different() is
            let other = a_class("Array").type!
            let array = array_of(a_class("Element").type!)

            are_equal(MATCH.DIFFERENT, other.compare(array))
        si

        @Test()
        Calling__compare__on_the_root_array_type_with_a_class__should_return_different() is
            let root = the_root_array_class().type!

            are_equal(MATCH.DIFFERENT, root.compare(a_class("Element").type!))
        si

        @Test()
        Calling__compare__on_an_array_with_the_root_array_type__should_return_different() is
            let root = the_root_array_class().type!
            let array = array_of(a_class("Element").type!)

            are_equal(MATCH.DIFFERENT, array.compare(root))
        si
    si
si
