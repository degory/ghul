namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for ARGUMENT_PACK - the shape rules deciding when an N-ary
    // function is adapted into a formal declared to take an argument
    // pack spread out. Whether a formal was declared that way is
    // recorded on its owning function and is not asked here.
    @TestClass()
    class ARGUMENT_PACK_TESTS is
        _int_type: Type
        _function_owner: CLASS
        _action_owner: CLASS
        _scope: Semantic.BLOCK_SCOPE

        init() is
            _scope = Semantic.BLOCK_SCOPE()

            _int_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _function_owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Function", LIST[string](["A", "R"]), Semantic.BLOCK_SCOPE())
            _action_owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Action", LIST[string](["A"]), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        type_parameter(name: string) -> Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), _scope, name, 0).type!

        // `(a0, .., an) -> r`
        function_type(arity: int, return_type: Type) -> Type is
            let arguments = LIST[Type]()

            for i in 0..arity do
                arguments.add(_int_type)
            od

            arguments.add(return_type)

            return Semantic.Types.FUNCTION(loc(), _function_owner, arguments)
        si

        // `(a0, .., an) -> void`
        action_type(arity: int) -> Type is
            let arguments = LIST[Type]()

            for i in 0..arity do
                arguments.add(_int_type)
            od

            return Semantic.Types.ACTION(loc(), _action_owner, arguments)
        si

        // `T -> r` - the shape a spread formal presents
        slot() -> Type =>
            Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([type_parameter("T"), _int_type]))

        // === parameter_count ===

        // An action's type arguments are its parameters alone; every
        // other function type carries its return as the last of them.
        @Test()
        Calling__parameter_count__on_an_action__counts_every_type_argument() is
            are_equal(2, Semantic.ARGUMENT_PACK.parameter_count(action_type(2)))
        si

        @Test()
        Calling__parameter_count__on_a_function__discounts_the_return() is
            are_equal(2, Semantic.ARGUMENT_PACK.parameter_count(function_type(2, _int_type)))
        si

        // === is_pack_slot ===

        @Test()
        Calling__is_pack_slot__on_a_one_parameter_function__returns_true() is
            is_true(Semantic.ARGUMENT_PACK.is_pack_slot(slot()))
        si

        // Two parameters is not the shape a spread formal presents: the
        // pack binds to one tuple, so the formal takes one value.
        @Test()
        Calling__is_pack_slot__on_a_two_parameter_function__returns_false() is
            let s =
                Semantic.Types.FUNCTION(
                    loc(),
                    _function_owner,
                    LIST[Type]([type_parameter("T"), _int_type, _int_type])
                )

            is_false(Semantic.ARGUMENT_PACK.is_pack_slot(s))
        si

        @Test()
        Calling__is_pack_slot__on_a_non_function__returns_false() is
            is_false(Semantic.ARGUMENT_PACK.is_pack_slot(_int_type))
        si

        // === marked_slot ===

        // Depth zero is the formal's own type, which is where every
        // marker sat before it could be written deeper.
        @Test()
        Calling__marked_slot__at_depth_zero__returns_the_formals_own_type() is
            let s = slot()

            are_same(s, Semantic.ARGUMENT_PACK.marked_slot(s, 0))
        si

        // `X -> T -> r`: one return in, which is where the marker on
        // `f: X -> T.. -> r` sits.
        @Test()
        Calling__marked_slot__at_depth_one__returns_the_functions_own_return() is
            let inner = slot()

            let outer =
                Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, inner]))

            are_same(inner, Semantic.ARGUMENT_PACK.marked_slot(outer, 1))
        si

        @Test()
        Calling__marked_slot__at_depth_two__walks_two_returns() is
            let inner = slot()

            let middle =
                Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, inner]))

            let outer =
                Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, middle]))

            are_same(inner, Semantic.ARGUMENT_PACK.marked_slot(outer, 2))
        si

        // A spine shorter than the depth arrives at something that is
        // not a function, so there is no slot to answer with.
        @Test()
        Calling__marked_slot__past_the_end_of_the_spine__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.marked_slot(slot(), 1))
        si

        // What the walk arrives at still has to be the one-parameter
        // shape a pack presents.
        @Test()
        Calling__marked_slot__on_a_two_parameter_return__returns_null() is
            let inner = function_type(2, _int_type)

            let outer =
                Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, inner]))

            is_null(Semantic.ARGUMENT_PACK.marked_slot(outer, 1))
        si

        // An action returns nothing, so nothing on the spine follows it.
        @Test()
        Calling__marked_slot__through_an_action__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.marked_slot(action_type(1), 1))
        si

        // === adaptation_arity ===

        @Test()
        Calling__adaptation_arity__with_a_two_ary_actual__returns_two() is
            are_equal(2, Semantic.ARGUMENT_PACK.adaptation_arity(slot(), function_type(2, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__with_a_void_returning_actual__counts_its_parameters() is
            are_equal(3, Semantic.ARGUMENT_PACK.adaptation_arity(slot(), action_type(3)))
        si

        // Arity one is not a pack use - the parameter binds to that one
        // parameter's type, tuple or not, exactly as it did before.
        @Test()
        Calling__adaptation_arity__with_a_one_ary_actual__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(), function_type(1, _int_type)))
        si

        // Past the tuple limit there is no tuple for the pack to bind
        // to, so the call is left to be reported as it stands.
        @Test()
        Calling__adaptation_arity__past_the_tuple_limit__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(), function_type(8, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__at_the_tuple_limit__returns_that_arity() is
            are_equal(7, Semantic.ARGUMENT_PACK.adaptation_arity(slot(), function_type(7, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__with_a_non_function_actual__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(), _int_type))
        si

        // A spread formal collects everything written after the formals
        // before it, so the count is what the call supplies beyond them.
        @Test()
        Calling__spread_arity__with_arguments_after_the_formal__returns_their_count() is
            are_equal(2, Semantic.ARGUMENT_PACK.spread_arity(1, 3))
            are_equal(3, Semantic.ARGUMENT_PACK.spread_arity(1, 4))
            are_equal(5, Semantic.ARGUMENT_PACK.spread_arity(0, 5))
        si

        // One argument is the value the pack binds to rather than a
        // tuple of one, so there is nothing to collect.
        @Test()
        Calling__spread_arity__with_one_argument_to_collect__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.spread_arity(1, 2))
        si

        // The formal is past the end of what the call supplied.
        @Test()
        Calling__spread_arity__with_no_argument_to_collect__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.spread_arity(2, 2))
            is_null(Semantic.ARGUMENT_PACK.spread_arity(3, 2))
        si

        // The formal is not one the call has, so the shape says nothing.
        @Test()
        Calling__spread_arity__with_no_spread_formal__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.spread_arity(-1, 4))
        si

        @Test()
        Calling__spread_arity__at_the_tuple_limit__returns_that_arity() is
            are_equal(7, Semantic.ARGUMENT_PACK.spread_arity(1, 8))
        si

        // Past the tuple limit there is no tuple for the collected
        // arguments to become.
        @Test()
        Calling__spread_arity__past_the_tuple_limit__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.spread_arity(1, 9))
        si
    si
si
