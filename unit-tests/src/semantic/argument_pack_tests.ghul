namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for ARGUMENT_PACK - the shape rules deciding when an N-ary
    // function is adapted into a slot whose parameter is a type
    // parameter declared `[T..]`.
    @TestClass()
    class ARGUMENT_PACK_TESTS is
        _int_type: Type
        _function_owner: CLASS
        _action_owner: CLASS
        _scope: Semantic.BLOCK_SCOPE

        init() is
            _scope = Semantic.BLOCK_SCOPE()

            _int_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _function_owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Function", LIST[string](["A", "R"]), Semantic.BLOCK_SCOPE())
            _action_owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Action", LIST[string](["A"]), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        type_parameter(name: string, is_pack: bool) -> Type is
            let symbol = CLASSY_GENERIC_ARGUMENT(loc(), _scope, name, 0)

            symbol.set_is_argument_pack(is_pack)

            return symbol.type!
        si

        // `(a0, .., an) -> r`
        function_type(arity: int, return_type: Type) -> Type is
            let arguments = LIST[Type]()

            for i in 0..arity do
                arguments.add(_int_type)
            od

            arguments.add(return_type)

            return Semantic.Types.FUNCTION(loc(), _function_owner, arguments)
        si

        // `(a0, .., an) -> void`
        action_type(arity: int) -> Type is
            let arguments = LIST[Type]()

            for i in 0..arity do
                arguments.add(_int_type)
            od

            return Semantic.Types.ACTION(loc(), _action_owner, arguments)
        si

        // `T -> r`, over a type parameter that is or is not a pack
        slot(is_pack: bool) -> Type =>
            Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([type_parameter("T", is_pack), _int_type]))

        // === parameter_count ===

        // An action's type arguments are its parameters alone; every
        // other function type carries its return as the last of them.
        @Test()
        Calling__parameter_count__on_an_action__counts_every_type_argument() is
            are_equal(2, Semantic.ARGUMENT_PACK.parameter_count(action_type(2)))
        si

        @Test()
        Calling__parameter_count__on_a_function__discounts_the_return() is
            are_equal(2, Semantic.ARGUMENT_PACK.parameter_count(function_type(2, _int_type)))
        si

        // === is_pack_slot ===

        @Test()
        Calling__is_pack_slot__on_a_one_parameter_slot_over_a_pack__returns_true() is
            is_true(Semantic.ARGUMENT_PACK.is_pack_slot(slot(true)))
        si

        @Test()
        Calling__is_pack_slot__on_a_one_parameter_slot_over_a_plain_parameter__returns_false() is
            is_false(Semantic.ARGUMENT_PACK.is_pack_slot(slot(false)))
        si

        // Two parameters is not the shape a pack fills: a pack binds to
        // one tuple, so the slot it fills takes one value.
        @Test()
        Calling__is_pack_slot__on_a_two_parameter_slot__returns_false() is
            let s =
                Semantic.Types.FUNCTION(
                    loc(),
                    _function_owner,
                    LIST[Type]([type_parameter("T", true), _int_type, _int_type])
                )

            is_false(Semantic.ARGUMENT_PACK.is_pack_slot(s))
        si

        @Test()
        Calling__is_pack_slot__on_a_non_function__returns_false() is
            is_false(Semantic.ARGUMENT_PACK.is_pack_slot(_int_type))
        si

        // === adaptation_arity ===

        @Test()
        Calling__adaptation_arity__with_a_two_ary_actual__returns_two() is
            are_equal(2, Semantic.ARGUMENT_PACK.adaptation_arity(slot(true), function_type(2, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__with_a_void_returning_actual__counts_its_parameters() is
            are_equal(3, Semantic.ARGUMENT_PACK.adaptation_arity(slot(true), action_type(3)))
        si

        // Arity one is not a pack use - the parameter binds to that one
        // parameter's type, tuple or not, exactly as it did before.
        @Test()
        Calling__adaptation_arity__with_a_one_ary_actual__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(true), function_type(1, _int_type)))
        si

        // Past the tuple limit there is no tuple for the pack to bind
        // to, so the call is left to be reported as it stands.
        @Test()
        Calling__adaptation_arity__past_the_tuple_limit__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(true), function_type(8, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__at_the_tuple_limit__returns_that_arity() is
            are_equal(7, Semantic.ARGUMENT_PACK.adaptation_arity(slot(true), function_type(7, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__on_a_plain_type_parameter_slot__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(false), function_type(2, _int_type)))
        si

        @Test()
        Calling__adaptation_arity__with_a_non_function_actual__returns_null() is
            is_null(Semantic.ARGUMENT_PACK.adaptation_arity(slot(true), _int_type))
        si
    si
si
