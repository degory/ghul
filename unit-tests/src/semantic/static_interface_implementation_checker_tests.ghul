namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STATIC_METHOD
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.STATIC_PROPERTY
    use Semantic.Symbols.STATIC_INTERFACE_IMPLEMENTATION_CHECKER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class STATIC_INTERFACE_IMPLEMENTATION_CHECKER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](), Semantic.BLOCK_SCOPE())

        static_method(name: string, is_slot: bool) -> STATIC_METHOD is
            let f = STATIC_METHOD(loc(), loc(), owner(), name, Semantic.BLOCK_SCOPE())

            f.is_static_interface_virtual = is_slot

            return f
        si

        @Test()
        A_static_virtual_member_is_a_slot() is
            is_true(
                STATIC_INTERFACE_IMPLEMENTATION_CHECKER.is_static_slot(
                    static_method("parse", true)))
        si

        @Test()
        An_ordinary_static_member_is_not_a_slot() is
            is_false(
                STATIC_INTERFACE_IMPLEMENTATION_CHECKER.is_static_slot(
                    static_method("helper", false)))
        si

        @Test()
        An_instance_member_is_not_a_slot() is
            is_false(
                STATIC_INTERFACE_IMPLEMENTATION_CHECKER.is_static_slot(
                    INSTANCE_METHOD(loc(), loc(), owner(), "greet", Semantic.BLOCK_SCOPE())))
        si

        // The property itself carries no marker - its accessor does - so
        // a checker that looked only at the member would miss every
        // static property, which is the shape the generic-math
        // interfaces use.
        @Test()
        A_property_whose_getter_is_static_virtual_is_a_slot() is
            let property = STATIC_PROPERTY(loc(), loc(), owner(), "additive_identity", false, false)

            property.read_function = static_method("get_additive_identity", true)

            is_true(STATIC_INTERFACE_IMPLEMENTATION_CHECKER.is_static_slot(property))
        si

        @Test()
        A_property_whose_getter_is_an_ordinary_static_is_not_a_slot() is
            let property = STATIC_PROPERTY(loc(), loc(), owner(), "count", false, false)

            property.read_function = static_method("get_count", false)

            is_false(STATIC_INTERFACE_IMPLEMENTATION_CHECKER.is_static_slot(property))
        si
    si
si
