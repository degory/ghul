namespace Semantic.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.STATIC_METHOD;
    use Semantic.Types.Type;

    use Semantic.USER_DEFINED_CONVERSION_LOOKUP;

    class USER_DEFINED_CONVERSION_LOOKUP_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        class_type(name: string) -> Type =>
            CLASS(loc(), loc(), null, name, LIST[string](), null).type!;

        // A conversion operator declared as a member of the target
        // type - the shape reflection produces for something like
        // `System.Half`'s `implicit operator Half(byte)`.
        add_conversion(owner: Type, name: string, parameter: Type, return_type: Type) is
            let method = STATIC_METHOD(loc(), loc(), owner.symbol, name, owner.symbol);

            method.arguments = LIST[Type]([parameter]);
            method.return_type = return_type;

            owner.symbol.add_member(method);
        si

        find__op_implicit_declared_on_target__is_found() is
            @test()

            let source = class_type("SOURCE");
            let target = class_type("TARGET");

            add_conversion(target, "$op_implicit", source, target);

            let lookup = USER_DEFINED_CONVERSION_LOOKUP();
            let found = lookup.find(source, target);

            Assert.is_true(found?);
        si

        // Half's own explicit-to-Int128 operator, for example, is
        // declared as a member of the *source* type rather than the
        // target.
        find__op_explicit_declared_on_source__is_found() is
            @test()

            let source = class_type("SOURCE");
            let target = class_type("TARGET");

            add_conversion(source, "$op_explicit", source, target);

            let lookup = USER_DEFINED_CONVERSION_LOOKUP();
            let found = lookup.find(source, target);

            Assert.is_true(found?);
        si

        find__no_matching_operator__returns_null() is
            @test()

            let source = class_type("SOURCE");
            let target = class_type("TARGET");
            let other = class_type("OTHER");

            add_conversion(target, "$op_implicit", other, target);

            let lookup = USER_DEFINED_CONVERSION_LOOKUP();

            Assert.is_false(lookup.find(source, target)?);
        si

        // Several overloads share the `$op_implicit` name and differ
        // only by return type - the shape reflection produces for a
        // type with more than one conversion operator. The one whose
        // return type matches the requested target must win.
        find__several_return_type_only_overloads__picks_matching_return_type() is
            @test()

            let source = class_type("SOURCE");
            let target = class_type("TARGET");
            let other_target = class_type("OTHER_TARGET");

            add_conversion(source, "$op_implicit", source, other_target);
            add_conversion(source, "$op_implicit", source, target);

            let lookup = USER_DEFINED_CONVERSION_LOOKUP();
            let found = lookup.find(source, target);

            Assert.is_true(found?);
            Assert.are_same(target, found!.return_type);
        si

        // `cast T?(...)` still looks the operator up by the bare
        // (non-optional) target - the operator itself always returns
        // the non-optional T.
        find__optional_target__matches_against_non_optional_inner_type() is
            @test()

            let source = class_type("SOURCE");
            let target = class_type("TARGET");
            let optional_target = target.as_optional();

            add_conversion(target, "$op_implicit", source, target);

            let lookup = USER_DEFINED_CONVERSION_LOOKUP();
            let found = lookup.find(source, optional_target);

            Assert.is_true(found?);
        si
    si
si
