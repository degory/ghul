namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for the two places a symbol name is turned into an IL
    // identifier: the escape applied when a name is wrapped in quotes
    // for rendering, and the `=~` -> `Equals` rename, which is a
    // member-only interop mapping.
    @TestClass()
    class SYMBOL_IL_NAME_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        classy_owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](0), Semantic.BLOCK_SCOPE());

        namespace_owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false);

        @Test()
        Calling__escape_il_quoted_identifier__should_leave_an_ordinary_name_alone() is
            are_equal("do_thing", Symbol.escape_il_quoted_identifier("do_thing"));
        si

        @Test()
        Calling__escape_il_quoted_identifier__should_double_a_backslash() is
            are_equal("/\\\\", Symbol.escape_il_quoted_identifier("/\\"));
        si

        @Test()
        Calling__escape_il_quoted_identifier__should_escape_a_quote() is
            are_equal("a\\'b", Symbol.escape_il_quoted_identifier("a'b"));
        si

        // The backslash has to be doubled before the quote is escaped. The
        // other order would turn `'` into `\'` and then re-escape that
        // backslash, yielding `\\'` — a closing quote ilasm would honour.
        @Test()
        Calling__escape_il_quoted_identifier__should_double_backslashes_before_escaping_quotes() is
            are_equal("\\\\\\'", Symbol.escape_il_quoted_identifier("\\'"));
        si

        // The name a symbol carries is bare, and the quoting is applied
        // by the renderer, so the escape shows up in what `gen_name`
        // writes rather than in the name itself.
        @Test()
        Calling__il_name__should_answer_a_bare_name() is
            let function = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "\\", Semantic.BLOCK_SCOPE());

            are_equal("\\", function.il_name);
        si
        @Test()
        Calling__init__should_rename_a_member_equality_operator_to_Equals() is
            let function = INSTANCE_METHOD(loc(), loc(), classy_owner(), "=~", Semantic.BLOCK_SCOPE());

            are_equal("Equals", function.il_name_override);
        si

        @Test()
        Calling__init__should_keep_a_global_equality_operator_name() is
            let function = INSTANCE_METHOD(loc(), loc(), namespace_owner(), "=~", Semantic.BLOCK_SCOPE());

            is_null(function.il_name_override);
        si
    si
si
