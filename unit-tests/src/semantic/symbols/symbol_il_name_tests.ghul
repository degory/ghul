namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    // Tests for the two places a symbol's name is turned into an ilasm
    // identifier: the escape applied when a raw name is wrapped in quotes,
    // and the `=~` -> `Equals` rename, which is a member-only interop
    // mapping.
    class SYMBOL_IL_NAME_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        classy_owner() -> CLASS => CLASS(loc(), loc(), null, "OWNER", LIST[string](0), null);

        namespace_owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false);

        Calling__escape_il_quoted_identifier__should_leave_an_ordinary_name_alone() is
            @test()

            Assert.are_equal("do_thing", Symbol.escape_il_quoted_identifier("do_thing"));
        si

        Calling__escape_il_quoted_identifier__should_double_a_backslash() is
            @test()

            Assert.are_equal("/\\\\", Symbol.escape_il_quoted_identifier("/\\"));
        si

        Calling__escape_il_quoted_identifier__should_escape_a_quote() is
            @test()

            Assert.are_equal("a\\'b", Symbol.escape_il_quoted_identifier("a'b"));
        si

        // The backslash has to be doubled before the quote is escaped. The
        // other order would turn `'` into `\'` and then re-escape that
        // backslash, yielding `\\'` — a closing quote ilasm would honour.
        Calling__escape_il_quoted_identifier__should_double_backslashes_before_escaping_quotes() is
            @test()

            Assert.are_equal("\\\\\\'", Symbol.escape_il_quoted_identifier("\\'"));
        si

        Calling__il_name__should_quote_and_escape_a_backslash_name() is
            @test()

            let function = INSTANCE_METHOD(loc(), loc(), null, "\\", null);

            Assert.are_equal("'\\\\'", function.il_name);
        si

        Calling__init__should_rename_a_member_equality_operator_to_Equals() is
            @test()

            let function = INSTANCE_METHOD(loc(), loc(), classy_owner(), "=~", null);

            Assert.are_equal("Equals", function.il_name_override);
        si

        Calling__init__should_keep_a_global_equality_operator_name() is
            @test()

            let function = INSTANCE_METHOD(loc(), loc(), namespace_owner(), "=~", null);

            Assert.is_null(function.il_name_override);
        si
    si
si
