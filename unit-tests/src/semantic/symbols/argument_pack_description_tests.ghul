namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for how a formal declared to take an argument pack spread
    // out is described. The marker sits on the parameter of the formal's
    // own function type, which the type's rendering knows nothing about,
    // so the halves are written out by the function - and whatever else
    // the type says about itself, its purity included, has to survive
    // that.
    @TestClass()
    class ARGUMENT_PACK_DESCRIPTION_TESTS is
        _int_type: Type
        _string_type: Type
        _function_owner: CLASS

        init() is
            _int_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _string_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "string", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _function_owner =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Function", LIST[string](["A", "R"]), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        function_type() -> Type =>
            Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, _string_type]))

        pure_function_type() -> Type =>
            Semantic.Types.PURE_FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, _string_type]))

        make_function(argument_type: Type, is_pack: bool) -> GLOBAL_FUNCTION is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "apply", Semantic.BLOCK_SCOPE())

            result.arguments = LIST[Type]([argument_type])
            result.argument_names = LIST[string](["f"])
            let defaults = LIST[string?]()

            defaults.add(null)

            result.argument_defaults = defaults
            result.argument_is_pack = LIST[bool]([is_pack])

            return result
        si

        @Test()
        Describing__a_pack_formal__writes_the_marker() is
            are_equal(
                "f: int.. -> string",
                make_function(function_type(), true).get_argument_description(0))
        si

        // The purity of the formal's function type is part of what the
        // formal says, and is not the marker's to drop.
        @Test()
        Describing__a_pure_pack_formal__keeps_pure() is
            are_equal(
                "f: int.. -> string pure",
                make_function(pure_function_type(), true).get_argument_description(0))
        si

        @Test()
        Describing__an_unmarked_formal__writes_the_type_alone() is
            are_equal(
                "f: int -> string",
                make_function(function_type(), false).get_argument_description(0))
        si

        @Test()
        Describing__an_unmarked_pure_formal__keeps_pure() is
            are_equal(
                "f: int -> string pure",
                make_function(pure_function_type(), false).get_argument_description(0))
        si
    si
si
