namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.Symbol;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins `Symbol.is_positional_member_name`, the shared recognizer for
    // auto-generated positional tuple/destructure member names (a bare
    // decimal index). Used by the least-upper-bound element-name merge,
    // the primary-constructor deconstruct rewrite, and the destructure
    // backward-compatibility retry.
    @TestClass()
    class SYMBOL_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        // A class carrying a single positional member spelled the legacy
        // way (a backtick-prefixed index), as it would arrive by
        // reflection from an assembly built by an older compiler.
        legacy_positional_class() -> CLASS is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "PAIR", LIST[string](), Semantic.BLOCK_SCOPE());
            c.declare_variable(loc(), "`0", false, null);
            return c;
        si

        @Test()
        find_destructure_member_retries_legacy_backtick_name() is
            // get_destructure_member_name(0) is the bare index "0"; no
            // member has that name, so the retry falls back to the
            // legacy "`0" spelling and resolves it.
            let t = legacy_positional_class().type;

            is_not_null(t.find_destructure_member(0));
        si

        @Test()
        bare_index_is_positional() is
            is_true(Symbol.is_positional_member_name("0"));
            is_true(Symbol.is_positional_member_name("12"));
        si

        @Test()
        empty_name_is_not_positional() is
            is_false(Symbol.is_positional_member_name(""));
        si

        @Test()
        name_with_non_digit_is_not_positional() is
            is_false(Symbol.is_positional_member_name("1a"));
            is_false(Symbol.is_positional_member_name("abc"));
        si

        @Test()
        backtick_prefixed_index_is_not_positional() is
            // The legacy spelling carries the backtick; the recognizer
            // matches the bare index only.
            is_false(Symbol.is_positional_member_name("`0"));
        si

        // A symbol declared at a source location, named as the caller asks.
        named_variable(name: string) -> Symbol is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "HOLDER", LIST[string](), Semantic.BLOCK_SCOPE());
            c.declare_variable(loc(), name, false, null);

            return c.find_member(name)!;
        si

        // Whether a symbol is internal is recorded directly by
        // mark_synthesized, not re-derived from its name — a `$`-prefixed
        // name is only a naming convention now, not a signal `is_internal`
        // reads back.
        @Test()
        dollar_prefixed_name_is_not_internal_unless_marked() is
            is_false(named_variable("$state").is_internal);
        si

        @Test()
        dollar_operator_is_not_internal() is
            // `$` marks the names the compiler synthesises by convention,
            // but on its own it is the user-declared display operator -
            // and either way, is_internal no longer looks at the name.
            is_false(named_variable("$").is_internal);
        si

        @Test()
        multi_character_operator_beginning_with_dollar_is_not_internal() is
            is_false(named_variable("$>").is_internal);
            is_false(named_variable("$$").is_internal);
        si

        @Test()
        ordinary_name_is_not_internal() is
            is_false(named_variable("count").is_internal);
        si

        @Test()
        mark_synthesized_makes_a_symbol_internal_regardless_of_name() is
            let dollar = named_variable("$state");
            let ordinary = named_variable("count");

            dollar.mark_synthesized();
            ordinary.mark_synthesized();

            is_true(dollar.is_internal);
            is_true(ordinary.is_internal);
        si

        // A symbol declared at LOCATION.internal is internal without
        // needing mark_synthesized - most synthesised symbols reach
        // is_internal this way (see the comment on Symbol.is_internal).
        @Test()
        symbol_at_internal_location_is_internal_unmarked() is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "HOLDER", LIST[string](), Semantic.BLOCK_SCOPE());
            c.declare_variable(LOCATION.internal, "count", false, null);

            is_true(c.find_member("count")!.is_internal);
        si
    si
si
