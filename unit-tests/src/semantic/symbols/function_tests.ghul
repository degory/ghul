namespace Semantic.Symbols.UnitTests is
    use System.Text.StringBuilder;

    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Types.Type;

    // Tests for Function.gen_actual_arguments_list — the methodref-signature
    // emitter that bug #987 turned out to depend on. The fix relied on the
    // emitter preferring `unspecialized_arguments` over `arguments` when
    // both are populated, so that loader-supplied open-generic forms (`!0`,
    // `!!0`) reach the IL even though `arguments` carries the substituted
    // concrete types. These tests pin that preference, plus the fall-through
    // to `arguments` when no unspecialized form has been recorded.
    class FUNCTION_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        types_of(a: Symbols.GenericArgument, b: Symbols.GenericArgument) -> LIST[Type] is
            let result = LIST[Type]();
            result.add(a.type!);
            result.add(b.type!);
            return result;
        si

        types_of_one(a: Symbols.GenericArgument) -> LIST[Type] is
            let result = LIST[Type]();
            result.add(a.type!);
            return result;
        si

        Calling__gen_actual_arguments_list__should_walk_arguments_when_no_unspecialized_set() is
            @test()

            let t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);
            let u = CLASSY_GENERIC_ARGUMENT(loc(), null, "U", 1);

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.arguments = types_of(t, u);

            let buffer = StringBuilder();
            function.gen_actual_arguments_list(buffer);

            Assert.are_equal("!0 ,!1 ", buffer.to_string());
        si

        Calling__gen_actual_arguments_list__should_prefer_unspecialized_arguments_when_both_are_set() is
            @test()

            // Open form: `T`, `U` (the original parameter symbols).
            let open_t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);
            let open_u = CLASSY_GENERIC_ARGUMENT(loc(), null, "U", 1);

            // Substituted form: pretend T = some_other and U = some_other_2,
            // emitted via unrelated parameter symbols just so we can tell
            // which list the emitter walked.
            let sub_a = CLASSY_GENERIC_ARGUMENT(loc(), null, "A", 7);
            let sub_b = CLASSY_GENERIC_ARGUMENT(loc(), null, "B", 8);

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.arguments = types_of(sub_a, sub_b);
            function.unspecialized_arguments = types_of(open_t, open_u);

            let buffer = StringBuilder();
            function.gen_actual_arguments_list(buffer);

            // If gen_actual_arguments_list ever stops preferring unspecialized,
            // this test catches it: with the preference, the emitter produces
            // `!0,!1` (the open-form indices), not `!7,!8` (the substituted).
            Assert.are_equal("!0 ,!1 ", buffer.to_string());
        si

        Calling__gen_actual_arguments_list__on_a_function_with_no_arguments__should_emit_nothing() is
            @test()

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.arguments = LIST[Type]();

            let buffer = StringBuilder();
            function.gen_actual_arguments_list(buffer);

            Assert.are_equal("", buffer.to_string());
        si

        // The bug fix relied on specialize_function correctly preserving
        // the open-form arguments. These two tests pin that contract.

        Calling__specialize_function__should_record_arguments_as_unspecialized_when_no_unspecialized_was_set() is
            @test()

            let t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);
            let u = CLASSY_GENERIC_ARGUMENT(loc(), null, "U", 1);

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.arguments = types_of(t, u);
            function.return_type = t.type;

            let empty_map = Collections.MAP[string,Type]();
            let specialized = function.specialize_function(empty_map, null);

            // After specialization, the original `arguments` becomes the
            // recorded `unspecialized_arguments` — which is what allows the
            // emitter to recover the open form when emitting the methodref.
            Assert.are_equal(2, specialized.unspecialized_arguments.count);
            Assert.are_same(t.type, specialized.unspecialized_arguments[0]);
            Assert.are_same(u.type, specialized.unspecialized_arguments[1]);
        si

        Calling__specialize_function__should_keep_existing_unspecialized_when_re_specializing() is
            @test()

            let t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);
            let u = CLASSY_GENERIC_ARGUMENT(loc(), null, "U", 1);
            let already_substituted = CLASSY_GENERIC_ARGUMENT(loc(), null, "X", 9);

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.arguments = types_of(already_substituted, already_substituted);
            function.unspecialized_arguments = types_of(t, u);
            function.return_type = t.type;

            let empty_map = Collections.MAP[string,Type]();
            let specialized = function.specialize_function(empty_map, null);

            // Re-specializing must not lose the original open form. Without
            // this guarantee, double-specialization (which happens during
            // override resolution and inheritance pull-down) would erase the
            // open-form arguments and the IL would regress to substituted.
            Assert.are_equal(2, specialized.unspecialized_arguments.count);
            Assert.are_same(t.type, specialized.unspecialized_arguments[0]);
            Assert.are_same(u.type, specialized.unspecialized_arguments[1]);
        si

        // gen_generic_arguments_names emits a method's own generic
        // parameter clause. A type bound needs a CLR-visible constraint
        // there, not only substituted at each call site - .NET's
        // generic-math interfaces declare a self-referential constraint
        // on their own type parameter, checked against the declared
        // parameter rather than the instantiation. ILAsm's constraint
        // order is [class|valuetype] [.ctor] (bound-type-list) name.

        make_bound_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), null, name, LIST[string](), null);
            c.set_type(Semantic.Types.NAMED(c));
            return c.type!;
        si

        Calling__gen_generic_arguments_names__on_an_unbounded_argument__should_emit_the_bare_name() is
            @test()

            let t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.generic_arguments = types_of_one(t);
            function.generic_argument_names = LIST(["T"]);

            let buffer = StringBuilder();
            function.gen_generic_arguments_names(buffer);

            Assert.are_equal("T", buffer.to_string());
        si

        Calling__gen_generic_arguments_names__on_a_bounded_argument__should_emit_the_bound_before_the_name() is
            @test()

            let t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);
            let bound = make_bound_type("IParsable");

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.generic_arguments = types_of_one(t);
            function.generic_argument_names = LIST(["T"]);
            function.generic_argument_type_bounds = LIST[Type?]([bound]);

            let buffer = StringBuilder();
            function.gen_generic_arguments_names(buffer);

            Assert.are_equal("({bound.get_il_type()})T", buffer.to_string());
        si

        Calling__gen_generic_arguments_names__with_a_reference_and_ctor_constraint_plus_a_bound__should_order_flags_before_the_bound() is
            @test()

            let t = CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0);
            let bound = make_bound_type("IParsable");

            let function = INSTANCE_METHOD(loc(), loc(), null, "do_thing", null);
            function.generic_arguments = types_of_one(t);
            function.generic_argument_names = LIST(["T"]);
            function.generic_argument_constraint_kinds = LIST([Semantic.Symbols.TypeParameterConstraintKind.REFERENCE]);
            function.generic_argument_has_constructor_constraint = LIST([true]);
            function.generic_argument_type_bounds = LIST[Type?]([bound]);

            let buffer = StringBuilder();
            function.gen_generic_arguments_names(buffer);

            // ilasm rejects "(bound)class T" — the class/valuetype and
            // .ctor flags have to come first, the parenthesized bound
            // list last, right before the name.
            Assert.are_equal("class .ctor ({bound.get_il_type()})T", buffer.to_string());
        si

        // Being store-free is a property of the function, so the value
        // type built for a reference to it has to carry it. Recorded
        // rather than inspected: the shared test lookup builds a plain
        // FUNCTION either way, so the flag it is asked for is what
        // pins the contract.
        build_lookup_and_function(is_declared_pure: bool) -> (RECORDING_INNATE_SYMBOL_LOOKUP, Function) is
            let lookup = RECORDING_INNATE_SYMBOL_LOOKUP();
            let function = STATIC_METHOD(loc(), loc(), null, "do_thing", null);

            function.arguments = LIST[Type]();
            function.return_type = lookup.get_int_type();

            if is_declared_pure then
                function.mark_declared_pure();
            fi

            return (lookup, function);
        si

        Calling__get_full_type__on_a_declared_pure_function__should_ask_for_the_pure_shape() is
            @test()

            let (lookup, function) = build_lookup_and_function(true);

            function.get_full_type(lookup);

            Assert.is_true(lookup.was_asked);
            Assert.is_true(lookup.asked_for_pure);
        si

        Calling__get_full_type__on_a_function_that_is_not_store_free__should_not_ask_for_the_pure_shape() is
            @test()

            let (lookup, function) = build_lookup_and_function(false);

            function.get_full_type(lookup);

            Assert.is_true(lookup.was_asked);
            Assert.is_false(lookup.asked_for_pure);
        si

        // An indexer's accessors are synthesised under the CLR-required
        // names `get_Item` and `set_Item`, which no ghūl source can spell.
        // Every surface that shows a signature to a reader - signature
        // help, hover, workspace symbol search - renders
        // short_description, so it takes the declaration's own shape
        // rather than reading as a call to a member the language does not
        // have.

        indexer_accessor(name: string, owner: CLASS, index: Type, value: Type) -> INSTANCE_METHOD is
            let accessor = INSTANCE_METHOD(loc(), loc(), owner, name, null);

            let arguments = LIST[Type]();
            let names = LIST[string]();

            arguments.add(index);
            names.add("row");

            if name =~ "set_Item" then
                arguments.add(value);
                names.add("value");
            else
                accessor.return_type = value;
            fi

            accessor.arguments = arguments;
            accessor.argument_names = names;

            return accessor;
        si

        make_owner(name: string) -> CLASS is
            let c = CLASS(loc(), loc(), null, name, LIST[string](), null);
            c.set_type(Semantic.Types.NAMED(c));
            return c;
        si

        Reading__short_description__on_a_read_indexer__should_render_the_indexer_shape() is
            @test()

            let owner = make_owner("GRID");

            let getter =
                indexer_accessor(
                    "get_Item",
                    owner,
                    make_bound_type("INDEX"),
                    make_bound_type("ELEMENT")
                );

            Assert.are_equal("GRID[row: INDEX]: ELEMENT", getter.short_description);
        si

        Reading__short_description__on_a_write_indexer__should_report_the_value_parameter_type() is
            @test()

            let owner = make_owner("GRID");

            // The write accessor returns void, so the element type has to
            // come from its value parameter rather than its return type.
            let setter =
                indexer_accessor(
                    "set_Item",
                    owner,
                    make_bound_type("INDEX"),
                    make_bound_type("ELEMENT")
                );

            Assert.are_equal("GRID[row: INDEX]: ELEMENT = value", setter.short_description);
        si

        Reading__short_description__on_an_ordinary_method__should_render_a_call() is
            @test()

            let method = INSTANCE_METHOD(loc(), loc(), make_owner("GRID"), "at", null);

            method.arguments = LIST[Type]();
            method.argument_names = LIST[string]();
            method.return_type = make_bound_type("ELEMENT");

            Assert.are_equal("at() -> ELEMENT", method.short_description);
        si
    si

    // Records the purity flag get_full_type asks for, over the shared
    // minimal lookup the semantic tests use.
    class RECORDING_INNATE_SYMBOL_LOOKUP: Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP is
        was_asked: bool public;
        asked_for_pure: bool public;

        init() is
            super.init();
        si

        get_function_type(types: Collections.List[Type], is_pure: bool) -> Type is
            was_asked = true;
            asked_for_pure = is_pure;

            return get_function_type(types);
        si
    si
si
