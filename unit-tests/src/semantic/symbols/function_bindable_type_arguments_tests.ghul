namespace Semantic.Symbols.UnitTests is
    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT;
    use Semantic.Symbols.GENERIC;
    use Semantic.Symbols.INSTANCE_METHOD;

    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Which type arguments a call may pin when binding a generic
    // function's own type arguments from its actuals.
    //
    // Two kinds of type variable can appear in a candidate's formals
    // and they must be treated differently. The declaring type's are
    // open when the method is reached through the declaring class, so
    // one argument list can settle both halves. Anything else is
    // someone else's - most often the caller's own, arriving through a
    // receiver such as `Box[T]` written inside a generic function -
    // and pinning one of those substitutes a variable the call site
    // fixed, handing it a formal it never declared.
    @TestClass()
    class FUNCTION_BINDABLE_TYPE_ARGUMENTS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        empty_names() -> LIST[string] => LIST[string]();

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]();
            for v in values do result.add(v); od
            return result;
        si

        types(values: Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]();
            for v in values do result.add(v); od
            return result;
        si

        concrete(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE()).type!;

        // `Box[B].make[R](b: B, r: R)` reached through the declaring
        // class, so both `B` and `R` are still open.
        build_method_on_declaring_class() -> INSTANCE_METHOD is
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["B"]), Semantic.BLOCK_SCOPE());
            let b = box.declare_type(loc(), "B", 0, null);
            let method = INSTANCE_METHOD(loc(), loc(), box, "make", Semantic.BLOCK_SCOPE());
            let r = FUNCTION_GENERIC_ARGUMENT(loc(), method, "R", 0);

            method.generic_argument_names = names_for(["R"]);
            method.generic_arguments = types([r.type!]);
            method.is_generic = true;
            method.arguments = types([b.type!, r.type!]);

            return method;
        si

        // The same method reached through `Box[T]`, where `T` belongs
        // to whoever wrote the call. The declaring half is already
        // supplied, so the only variable left in the formals is one
        // the call has no business pinning.
        build_method_on_constructed_owner() -> (method: INSTANCE_METHOD, caller_variable: Type) is
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", names_for(["B"]), Semantic.BLOCK_SCOPE());
            box.declare_type(loc(), "B", 0, null);

            let caller = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Caller", names_for(["T"]), Semantic.BLOCK_SCOPE());
            let t = CLASSY_GENERIC_ARGUMENT(loc(), caller, "T", 0);

            let owner = GENERIC(loc(), box, types([t.type!]));
            let method = INSTANCE_METHOD(loc(), loc(), owner, "make", Semantic.BLOCK_SCOPE());
            let r = FUNCTION_GENERIC_ARGUMENT(loc(), method, "R", 0);

            method.generic_argument_names = names_for(["R"]);
            method.generic_arguments = types([r.type!]);
            method.is_generic = true;
            method.arguments = types([t.type!, r.type!]);

            return (method, t.type!);
        si

        @Test()
        Calling__try_bind_generic_arguments__on_the_declaring_class__binds_the_declaring_types_argument() is
            let method = build_method_on_declaring_class();

            let cat = concrete("cat");
            let dog = concrete("dog");

            let results = method.try_bind_generic_arguments(loc(), types([cat, dog]));

            is_not_null(results);
            are_same(cat, results.map["B"]);
            are_same(dog, results.map["R"]);
        si

        @Test()
        Calling__try_bind_generic_arguments__through_a_constructed_owner__leaves_the_callers_variable_alone() is
            let f = build_method_on_constructed_owner();

            let cat = concrete("cat");
            let dog = concrete("dog");

            let results = f.method.try_bind_generic_arguments(loc(), types([cat, dog]));

            is_not_null(results);
            is_false(results.map.contains_key("T"));
            are_same(dog, results.map["R"]);
        si
    si
si
