namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.ENUM_STRUCT;
    use Semantic.Symbols.ENUM_STRUCT_MEMBER;
    use Semantic.Symbols.NAMESPACE;

    // Pins `ENUM_STRUCT_MEMBER.numeric_value`, the number an enum member
    // denotes.
    //
    // `value` is the initializer's token exactly as it was written, so it
    // still carries whatever digit grouping, radix prefix and type suffix
    // the lexer accepts on an integer literal. Neither back end can use
    // any of that: ilasm rejects `int32(200l)` and a Constant row needs an
    // actual integer, so both read this instead.
    //
    // A value it cannot read yields zero and says nothing. Every such
    // input has already been reported — an out-of-range literal by the
    // numeric literal classifier, an incomplete declaration by the parser
    // — and neither produces an assembly, so a second diagnostic would
    // only report the same literal twice.
    class ENUM_STRUCT_MEMBER_VALUE_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        member(value: string) -> ENUM_STRUCT_MEMBER is
            let owner = NAMESPACE(loc(), "Test", null, ".Test", false);
            let `enum = ENUM_STRUCT(loc(), loc(), owner, "Level", owner);

            return ENUM_STRUCT_MEMBER(loc(), `enum, "MEMBER", value);
        si

        A_plain_decimal_literal_is_its_own_value() is
            @test()

            Assert.are_equal(200, member("200").numeric_value);
        si

        A_type_suffix_is_not_part_of_the_value() is
            @test()

            Assert.are_equal(200, member("200l").numeric_value);
            Assert.are_equal(7, member("7uS").numeric_value);
        si

        Digit_grouping_is_not_part_of_the_value() is
            @test()

            Assert.are_equal(1000000, member("1_000_000").numeric_value);
        si

        A_hexadecimal_literal_is_read_in_base_sixteen() is
            @test()

            Assert.are_equal(500, member("0x1F4").numeric_value);
            Assert.are_equal(500, member("0x1_F4").numeric_value);
        si

        // In base sixteen the suffix letters overlap the digits, so only
        // the letters that cannot be digits may end the number.
        A_hexadecimal_literal_keeps_digits_that_look_like_suffixes() is
            @test()

            Assert.are_equal(3054, member("0xBEE").numeric_value);
        si

        A_value_that_cannot_be_read_is_zero() is
            @test()

            // Reported already: by the parser for an incomplete
            // declaration, and by the literal check for one that does not
            // fit. Neither reaches emission.
            Assert.are_equal(0, member("").numeric_value);
            Assert.are_equal(0, member("si").numeric_value);
            Assert.are_equal(0, member("99999999999").numeric_value);
        si
    si
si
