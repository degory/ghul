namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for Classy.is_implicitly_abstract — whether a class is
    // abstract because a body-less instance method was found in it,
    // rather than because `abstract` was written on it.
    //
    // `is_abstract` deliberately folds the two together, since every
    // consumer that asks whether the type can be constructed wants the
    // same answer either way. This predicate is the one place that has to
    // tell them apart: what is written at the declaration needs no
    // announcing to a reader looking straight at it, and what was
    // inferred does. A predicate that answered `is_abstract` would
    // annotate every explicitly-abstract class with a fact its own header
    // already states.
    @TestClass()
    class CLASSY_IMPLICIT_ABSTRACT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        no_arguments() -> LIST[string] => LIST[string]()

        source_class() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Test", no_arguments(), Semantic.BLOCK_SCOPE())

        source_trait() -> TRAIT =>
            TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Test", no_arguments(), Semantic.BLOCK_SCOPE())

        @Test()
        is_implicitly_abstract__should_be_false_for_a_plain_class() is
            is_false(source_class().is_implicitly_abstract)
        si

        @Test()
        is_implicitly_abstract__should_be_true_for_a_class_with_a_bodyless_method() is
            let `class = source_class()

            `class.mark_has_bodyless_method()

            is_true(`class.is_implicitly_abstract)
        si

        @Test()
        is_implicitly_abstract__should_be_false_for_a_class_declared_abstract() is
            let `class = source_class()

            `class.mark_abstract()

            is_true(`class.is_abstract, "should still be abstract")
            is_false(`class.is_implicitly_abstract, "abstractness was written, not inferred")
        si

        // The modifier wins whichever order the two arrive in: a class
        // that says `abstract` is not told so a second time just because
        // it also happens to hold a body-less method.
        @Test()
        is_implicitly_abstract__should_be_false_when_declared_abstract_and_bodyless() is
            let `class = source_class()

            `class.mark_abstract()
            `class.mark_has_bodyless_method()

            is_false(`class.is_implicitly_abstract)
        si

        // Only a class infers abstractness. A trait's members are
        // body-less by nature, and a trait is abstract by being a trait.
        @Test()
        is_implicitly_abstract__should_be_false_for_a_trait() is
            is_false(source_trait().is_implicitly_abstract)
        si

        // A class counts its body-less methods rather than remembering
        // that it has one, because a method that turns out to override
        // an implemented member stops being a reason to be abstract.
        @Test()
        is_abstract__should_hold_while_a_second_bodyless_method_remains() is
            let `class = source_class()

            `class.mark_has_bodyless_method()
            `class.mark_has_bodyless_method()

            `class.unmark_has_bodyless_method()

            is_true(`class.is_abstract, "one body-less method is still enough")

            `class.unmark_has_bodyless_method()

            is_false(`class.is_abstract)
            is_false(`class.is_implicitly_abstract)
        si

        // Unmarking is driven by override resolution rather than by the
        // declaration walk that marks, so nothing pairs the two calls up.
        // A class that was never marked must not count below zero and
        // come out abstract on the next mark.
        @Test()
        unmark_has_bodyless_method__should_do_nothing_when_none_was_marked() is
            let `class = source_class()

            `class.unmark_has_bodyless_method()

            is_false(`class.is_abstract)

            `class.mark_has_bodyless_method()

            is_true(`class.is_abstract)
        si

        // What a class is written to do with a body-less member: hold it
        // as a contract. An accessor is not one - a body-less accessor
        // reads or writes the backing field - so it stays an ordinary
        // method, and a write-only property does not make its class
        // abstract.
        @Test()
        declare_function__should_make_a_bodyless_method_abstract() is
            let `class = source_class()

            let declared =
                `class.declare_function(
                    loc(), loc(), "contract", false, false, false, false, Semantic.BLOCK_SCOPE(), null)

            is_true(isa ABSTRACT_METHOD(only_function(declared)))
        si

        @Test()
        declare_function__should_leave_a_bodyless_accessor_concrete() is
            let `class = source_class()

            let declared =
                `class.declare_function(
                    loc(), loc(), "$get_x", false, false, false, true, Semantic.BLOCK_SCOPE(), null)

            let declared_function = only_function(declared)

            is_false(isa ABSTRACT_METHOD(declared_function))
            is_false(declared_function.is_abstract)
        si

        @Test()
        declare_function__should_leave_a_method_with_a_body_concrete() is
            let `class = source_class()

            let declared =
                `class.declare_function(
                    loc(), loc(), "implemented", false, false, true, false, Semantic.BLOCK_SCOPE(), null)

            is_false(isa ABSTRACT_METHOD(only_function(declared)))
        si

        // A member that overrides an implemented one has a slot to fill,
        // so it carries a throwing body: it is not abstract, and it is
        // not what makes its class abstract either.
        @Test()
        mark_throws_unimplemented__should_stop_the_method_being_abstract() is
            let `class = source_class()

            `class.mark_has_bodyless_method()

            let declared =
                `class.declare_function(
                    loc(), loc(), "contract", false, false, false, false, Semantic.BLOCK_SCOPE(), null)

            let declared_function = only_function(declared)

            is_true(declared_function.is_abstract, "abstract until it is known to override")

            declared_function.mark_throws_unimplemented()

            is_false(declared_function.is_abstract)
            is_true(declared_function.throws_unimplemented)
            is_false(`class.is_abstract, "and no longer a reason for the class to be")
        si

        // declare_function answers the function it built, before the
        // group the name is stored under is assembled around it.
        only_function(declared: Symbol) -> Function => cast Function?(declared)!
    si
si
