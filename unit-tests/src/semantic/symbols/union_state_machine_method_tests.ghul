namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A union (and a variant reopened with `partial`) is a reference
    // type, so a generator or async method declared on it needs no
    // special state-machine form the way a trait default method does —
    // it's the same virtual INSTANCE_GENERATOR_METHOD / INSTANCE_ASYNC_METHOD
    // a class gets. This pins that both UNION and VARIANT route there
    // rather than falling through to the base "cannot declare ... here"
    // rejection.
    @TestClass()
    class UNION_STATE_MACHINE_METHOD_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        a_union() -> UNION => UNION(loc(), loc(), Semantic.BLOCK_SCOPE(), "Tree", LIST[string](), Semantic.BLOCK_SCOPE());

        a_variant() -> VARIANT => VARIANT(loc(), loc(), a_union(), "LEAF", LIST[string](), Semantic.BLOCK_SCOPE());

        @Test()
        Declaring__a_generator__in_a_union__should_produce_an_instance_generator_method() is
            let owner = a_union();

            let symbol = owner.declare_generator_function(loc(), loc(), "upto", false, false, true, owner, null);

            is_true(isa INSTANCE_GENERATOR_METHOD(symbol));

            let function = cast Function(symbol);

            is_true(function.is_instance);
        si

        @Test()
        Declaring__an_async_method__in_a_union__should_produce_an_instance_async_method() is
            let owner = a_union();

            let symbol = owner.declare_async_function(loc(), loc(), "later", false, false, true, owner, null);

            is_true(isa INSTANCE_ASYNC_METHOD(symbol));

            let function = cast Function(symbol);

            is_true(function.is_instance);
        si

        @Test()
        Declaring__a_generator__in_a_variant__should_produce_an_instance_generator_method() is
            let owner = a_variant();

            let symbol = owner.declare_generator_function(loc(), loc(), "upto", false, false, true, owner, null);

            is_true(isa INSTANCE_GENERATOR_METHOD(symbol));

            let function = cast Function(symbol);

            is_true(function.is_instance);
        si

        @Test()
        Declaring__an_async_method__in_a_variant__should_produce_an_instance_async_method() is
            let owner = a_variant();

            let symbol = owner.declare_async_function(loc(), loc(), "later", false, false, true, owner, null);

            is_true(isa INSTANCE_ASYNC_METHOD(symbol));

            let function = cast Function(symbol);

            is_true(function.is_instance);
        si
    si
si
