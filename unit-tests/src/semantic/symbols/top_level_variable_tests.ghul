namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for TOP_LEVEL_VARIABLE's store and load gating: a bare `let`
    // rejects every store except the entry's own initialising one, and
    // the use-before-declaration report fires only for a use that runs in
    // textual order — inside the synthesised entry, in the same file,
    // above the declaration. Uses inside other functions and function
    // literals run when called, and a use in another file is not ordered
    // against the declaration at all, so those stay silent.
    @TestClass()
    class TOP_LEVEL_VARIABLE_TESTS is
        init() is si

        loc(file_name: string, line: int) -> LOCATION => LOCATION(file_name, line, 1, line, 10)

        // The variable's own declaration sits at script.ghul line 5.
        declaration_location() -> LOCATION => loc("script.ghul", 5)

        make_variable() -> TOP_LEVEL_VARIABLE is
            let result = TOP_LEVEL_VARIABLE(declaration_location(), Semantic.BLOCK_SCOPE(), "shared")

            let owner = CLASS(loc("script.ghul", 1), loc("script.ghul", 1), Semantic.BLOCK_SCOPE(), "PAYLOAD", LIST[string](), Semantic.BLOCK_SCOPE())
            result.set_type(Types.NAMED(owner))

            return result;
        si

        // Installs a fresh symbol table with `function` as the current
        // function, and returns a loader over it.
        enter(function: Function) -> SYMBOL_LOADER is
            let logger = DIAGNOSTICS_STORE()
            let symbol_table = SYMBOL_TABLE(logger)

            IoC.CONTAINER.instance.symbol_table = symbol_table
            symbol_table.enter_scope(function)

            return SYMBOL_LOADER(
                logger,
                symbol_table,
                FUNCTION_CALLER(symbol_table, IR.VALUE_BOXER(logger)),
                IR.VALUE_BOXER(logger),
                Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP());
        si

        entry_function() -> Function is
            let result = GLOBAL_FUNCTION(loc("script.ghul", 1), loc("script.ghul", 1), Semantic.BLOCK_SCOPE(), "entry", Semantic.BLOCK_SCOPE())

            result.is_top_level_entry = true

            return result;
        si

        plain_function() -> Function =>
            GLOBAL_FUNCTION(loc("script.ghul", 2), loc("script.ghul", 2), Semantic.BLOCK_SCOPE(), "helper", Semantic.BLOCK_SCOPE())

        closure() -> Function =>
            GLOBAL_CLOSURE(loc("script.ghul", 3), Semantic.BLOCK_SCOPE(), "$anon_0", Semantic.BLOCK_SCOPE(), false)

        errors() -> int => IoC.CONTAINER.instance.logger.error_count

        value_for(variable: TOP_LEVEL_VARIABLE) -> IR.Values.Value =>
            IR.Values.DUMMY(variable.type!, loc("script.ghul", 9))

        @Test()
        given_a_bare_let__the_initialising_store__should_not_report() is
            let variable = make_variable()
            let loader = enter(entry_function())

            let before = errors()
            variable.store(declaration_location(), null, value_for(variable), loader, true)

            are_equal(before, errors());
        si

        @Test()
        given_a_bare_let__a_reassignment__should_report() is
            let variable = make_variable()
            let loader = enter(entry_function())

            let before = errors()
            variable.store(loc("script.ghul", 8), null, value_for(variable), loader, false)

            are_equal(before + 1, errors());
        si

        @Test()
        given_a_mut_let__a_reassignment_below_the_declaration__should_not_report() is
            let variable = make_variable()
            variable.is_mutable_marked = true

            let loader = enter(entry_function())

            let before = errors()
            variable.store(loc("script.ghul", 8), null, value_for(variable), loader, false)

            are_equal(before, errors());
        si

        @Test()
        given_a_mut_let__a_reassignment_above_the_declaration_in_the_entry__should_report() is
            let variable = make_variable()
            variable.is_mutable_marked = true

            let loader = enter(entry_function())

            let before = errors()
            variable.store(loc("script.ghul", 2), null, value_for(variable), loader, false)

            are_equal(before + 1, errors());
        si

        @Test()
        given_a_use_above_the_declaration_in_the_entry__load__should_report() is
            let variable = make_variable()
            let loader = enter(entry_function())

            let before = errors()
            variable.load(loc("script.ghul", 2), null, loader)

            are_equal(before + 1, errors());
        si

        @Test()
        given_a_use_below_the_declaration_in_the_entry__load__should_not_report() is
            let variable = make_variable()
            let loader = enter(entry_function())

            let before = errors()
            variable.load(loc("script.ghul", 8), null, loader)

            are_equal(before, errors());
        si

        @Test()
        given_a_use_above_the_declaration_in_another_function__load__should_not_report() is
            let variable = make_variable()
            let loader = enter(plain_function())

            let before = errors()
            variable.load(loc("script.ghul", 2), null, loader)

            are_equal(before, errors());
        si

        @Test()
        given_a_use_above_the_declaration_in_a_function_literal__load__should_not_report() is
            let variable = make_variable()
            let loader = enter(closure())

            let before = errors()
            variable.load(loc("script.ghul", 2), null, loader)

            are_equal(before, errors());
        si

        @Test()
        given_a_use_in_another_file__load__should_not_report() is
            let variable = make_variable()
            let loader = enter(entry_function())

            let before = errors()
            variable.load(loc("other.ghul", 2), null, loader)

            are_equal(before, errors());
        si
    si
si
