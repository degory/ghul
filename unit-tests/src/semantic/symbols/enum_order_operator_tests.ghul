namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Collections.LIST;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.ENUM_ORDER_OPERATOR;
    use Semantic.Symbols.ENUM_STRUCT;
    use Semantic.Symbols.FUNCTION_GROUP;
    use Semantic.Symbols.Function;
    use Semantic.Types.Type;

    // An enum's ordering is the same opcode comparison the numeric
    // primitives use, supplied per enum type because each enum is its
    // own type. The operator's shape is what the comparison lowering
    // and the store-free walk both read, so it is pinned here.
    class ENUM_ORDER_OPERATOR_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        int_type() -> Type =>
            CLASS(loc(), loc(), null, "int", LIST[string](), null).type!;

        an_enum() -> ENUM_STRUCT =>
            ENUM_STRUCT(loc(), loc(), null, "Level", null);

        order_operator_of(owner: ENUM_STRUCT) -> Function? is
            let member = owner.find_member("<>");

            if !member? then
                return null;
            fi

            if isa FUNCTION_GROUP(member) then
                for f in (cast FUNCTION_GROUP(member)).functions do
                    return f;
                od

                return null;
            fi

            if isa Function(member) then
                return cast Function(member);
            fi

            return null;
        si

        Registering__adds_an_order_operator() is
            @test()

            let owner = an_enum();

            ENUM_ORDER_OPERATOR.register(owner, int_type());

            Assert.is_true(order_operator_of(owner)?);
        si

        Registered_operator__takes_one_argument_of_the_enum_type() is
            @test()

            let owner = an_enum();

            ENUM_ORDER_OPERATOR.register(owner, int_type());

            let operator = order_operator_of(owner)!;

            Assert.are_equal(1, operator.arguments.count);
            Assert.are_same(owner.type!, operator.arguments[0]);
        si

        Registered_operator__returns_the_int_type() is
            @test()

            let owner = an_enum();
            let int = int_type();

            ENUM_ORDER_OPERATOR.register(owner, int);

            Assert.are_same(int, order_operator_of(owner)!.return_type!);
        si

        // infer-store-free classifies an innate by walking its body, and
        // this one has none, so the bit is declared rather than inferred.
        // Without it a comparison drops every narrowing at its call site.
        Registered_operator__is_declared_pure() is
            @test()

            let owner = an_enum();

            ENUM_ORDER_OPERATOR.register(owner, int_type());

            Assert.is_true(order_operator_of(owner)!.is_declared_pure);
        si

        Registered_operator__lowers_to_the_order_comparison() is
            @test()

            let owner = an_enum();

            ENUM_ORDER_OPERATOR.register(owner, int_type());

            Assert.is_true(order_operator_of(owner)!.is_innate);
        si
    si
si
