namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GENERIC_CONSTRAINT_CHECKER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A call may name more type arguments than the generic declares. The
    // arity is reported where it is checked, and these checks run anyway,
    // so they walk the two lists together and stop with the shorter.
    @TestClass()
    class GENERIC_CONSTRAINT_ARITY_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        names(count: int) -> LIST[string] is
            let result = LIST[string]()

            for i in 0..count do
                result.add("T{i}")
            od

            return result
        si

        types(count: int) -> LIST[Semantic.Types.Type] is
            let result = LIST[Semantic.Types.Type]()

            for i in 0..count do
                result.add(Semantic.Types.NAMED(a_class("A{i}")))
            od

            return result
        si

        check(declared: int, supplied: int) is
            let owner = a_class("OWNER")
            let logger = Logging.DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_arguments(
                loc(), logger, owner, names(declared), types(supplied))

            are_equal(0, logger.error_count)
        si

        @Test()
        more_arguments_than_the_generic_declares_is_not_an_error_here() is
            check(1, 3)
        si

        @Test()
        fewer_arguments_than_the_generic_declares_is_not_an_error_here() is
            check(3, 1)
        si

        @Test()
        matching_counts_are_unchanged() is
            check(2, 2)
        si
    si
si
