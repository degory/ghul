namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.STATIC_CLOSURE
    use Semantic.Symbols.TYPE_PARAMETER_POSITION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins that a closure's type-argument bracket survives being entered
    // while one of its own is already open.
    //
    // That happens whenever a signature is encoded inside a body already
    // bracketed for the same closure. Saving one position per parameter
    // lets the inner entry record the closure's own position over what
    // the outer entry saved, and the pair of exits then leaves the
    // parameter with no position rather than the one installed before
    // the outermost entry.
    @TestClass()
    class CLOSURE_EMITTED_POSITION_NESTING_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false)

        closure(owner: NAMESPACE) -> STATIC_CLOSURE =>
            STATIC_CLOSURE(loc(), owner, "$anon", owner, false)

        @Test()
        Nested_brackets_should_restore_the_enclosing_position() is
            let shared_owner = owner()
            let subject = closure(shared_owner)
            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 0)

            subject.add_type_argument_reference(a)

            let enclosing = () => TYPE_PARAMETER_POSITION(true, 3)

            a.set_emitted_position(enclosing)

            subject.map_type_arguments()
            subject.map_type_arguments()
            subject.unmap_type_arguments()
            subject.unmap_type_arguments()

            are_same(enclosing, a.current_emitted_position!)
        si

        @Test()
        Nested_brackets_should_install_the_closures_own_position_while_open() is
            let shared_owner = owner()
            let subject = closure(shared_owner)
            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 0)

            subject.add_type_argument_reference(a)

            a.set_emitted_position(() => TYPE_PARAMETER_POSITION(true, 3))

            subject.map_type_arguments()
            subject.map_type_arguments()

            are_equal(0, a.emitted_position!.index)

            subject.unmap_type_arguments()

            are_equal(0, a.emitted_position!.index)

            subject.unmap_type_arguments()

            are_equal(3, a.emitted_position!.index)
        si

        @Test()
        Nested_brackets_over_no_enclosing_position_should_leave_none() is
            let shared_owner = owner()
            let subject = closure(shared_owner)
            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 0)

            subject.add_type_argument_reference(a)

            subject.map_type_arguments()
            subject.map_type_arguments()
            subject.unmap_type_arguments()
            subject.unmap_type_arguments()

            is_null(a.current_emitted_position)
        si
    si
si
