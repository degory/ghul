namespace Semantic.UnitTests is
    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT;
    use Semantic.Symbols.GENERIC;
    use Semantic.Symbols.INSTANCE_METHOD;
    use Semantic.Symbols.OWNER_INSTANTIATION_BINDER;

    use Semantic.Types.GENERIC_ARGUMENT_BIND_RESULTS;
    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for OWNER_INSTANTIATION_BINDER — the step that binds an
    // owner type argument no formal mentions, from an actual whose
    // bound instantiates that owner.
    //
    // The shape it exists for is .NET's generic math:
    // `IAdditionOperators[TSelf, TOther, TResult].op_Addition` declares
    // TResult only in the return type, so pairing formals with actuals
    // leaves it unbound and the candidate is discarded before it can be
    // specialised. A `[T: INumber[T]]` actual carries the answer,
    // because the bound instantiates IAdditionOperators[T, T, T].
    //
    // Pinned here because each of the three guards is load-bearing and
    // fails quietly: overwriting a formal-derived binding would let a
    // declaration-site type argument beat one inferred at the call
    // site; binding from an unrelated actual would specialise a
    // candidate on a type the call never mentioned; and running when
    // nothing is unbound would put an ancestor walk on the resolver's
    // hot path for no result.
    @TestClass()
    class OWNER_INSTANTIATION_BINDER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]();
            for v in values do result.add(v); od
            return result;
        si

        // A class's own type parameter, as the bind results key on it.
        type_arg(argument: CLASSY_GENERIC_ARGUMENT) -> Semantic.Types.GenericArgument =>
            cast Semantic.Types.GenericArgument(argument.type!);

        types(values: Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]();
            for v in values do result.add(v); od
            return result;
        si

        // `trait Adds[TSelf, TOther, TResult] is +(left: TSelf, right: TOther) -> TResult si`
        // — the generic-math shape, with the third argument reachable
        // from the return type alone.
        build_adds() -> (adds: CLASS, self_arg: CLASSY_GENERIC_ARGUMENT, other: CLASSY_GENERIC_ARGUMENT, result: CLASSY_GENERIC_ARGUMENT) is
            let adds = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Adds", names_for(["TSelf", "TOther", "TResult"]), Semantic.BLOCK_SCOPE());

            // Through declare_type, as declare-symbols does, so the
            // parameters are in the class's own scope and reachable by
            // name.
            let self_arg = cast CLASSY_GENERIC_ARGUMENT(adds.declare_type(loc(), "TSelf", 0, null));
            let other = cast CLASSY_GENERIC_ARGUMENT(adds.declare_type(loc(), "TOther", 1, null));
            let result = cast CLASSY_GENERIC_ARGUMENT(adds.declare_type(loc(), "TResult", 2, null));

            return (adds, self_arg, other, result);
        si

        // A type variable bounded by `Adds[itself, itself, itself]`,
        // standing for `[T: INumber[T]]`.
        build_bounded_variable(adds: CLASS, name: string) -> FUNCTION_GENERIC_ARGUMENT is
            let holder = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "total", Semantic.BLOCK_SCOPE());
            let t = FUNCTION_GENERIC_ARGUMENT(loc(), holder, name, 0);

            t.set_ancestor_type(GENERIC(loc(), adds, types([t.type!, t.type!, t.type!])).type);

            return t;
        si

        // An unrelated type variable with no bound at all.
        build_unbounded_variable(name: string) -> FUNCTION_GENERIC_ARGUMENT is
            let holder = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "other", Semantic.BLOCK_SCOPE());

            return FUNCTION_GENERIC_ARGUMENT(loc(), holder, name, 0);
        si

        // The formals bind TSelf and TOther and can never reach
        // TResult. The actual's own bound supplies it.
        @Test()
        Calling__bind_unbound__with_a_bounded_actual__binds_the_return_only_argument() is
            let a = build_adds();
            let t = build_bounded_variable(a.adds, "T");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            results.bind(type_arg(a.self_arg), t.type!);
            results.bind(type_arg(a.other), t.type!);

            is_false(results.bindings.contains_key("TResult"));

            OWNER_INSTANTIATION_BINDER.bind_unbound_from_actual_instantiations(a.adds, types([t.type!, t.type!]), results);

            is_true(results.bindings.contains_key("TResult"));
            are_same(t.type!, results.bindings["TResult"].actual_type);
        si

        // A binding the formals already made stands. The instantiation
        // is a declaration-site fact and the formal-derived binding is
        // what the call site actually supplied, so the latter wins.
        @Test()
        Calling__bind_unbound__does_not_overwrite_a_binding_made_from_the_formals() is
            let a = build_adds();
            let t = build_bounded_variable(a.adds, "T");
            let other = build_unbounded_variable("U");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            results.bind(type_arg(a.self_arg), other.type!);

            OWNER_INSTANTIATION_BINDER.bind_unbound_from_actual_instantiations(a.adds, types([t.type!, t.type!]), results);

            are_same(other.type!, results.bindings["TSelf"].actual_type);
            are_same(t.type!, results.bindings["TResult"].actual_type);
        si

        // No actual instantiates the owner, so there is nothing to read
        // and nothing is bound. Specialising on a type the call never
        // mentioned would be worse than declining.
        @Test()
        Calling__bind_unbound__with_no_actual_instantiating_the_owner__binds_nothing() is
            let a = build_adds();
            let unrelated = build_unbounded_variable("U");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            OWNER_INSTANTIATION_BINDER.bind_unbound_from_actual_instantiations(a.adds, types([unrelated.type!]), results);

            is_false(results.bindings.contains_key("TSelf"));
            is_false(results.bindings.contains_key("TResult"));
        si

        // Every argument already bound: the ancestor walk must not run.
        // Observable as the pre-existing bindings surviving untouched,
        // including one the instantiation would otherwise disagree with.
        @Test()
        Calling__bind_unbound__with_every_argument_already_bound__leaves_them_alone() is
            let a = build_adds();
            let t = build_bounded_variable(a.adds, "T");
            let other = build_unbounded_variable("U");
            let results = GENERIC_ARGUMENT_BIND_RESULTS();

            results.bind(type_arg(a.self_arg), other.type!);
            results.bind(type_arg(a.other), other.type!);
            results.bind(type_arg(a.result), other.type!);

            OWNER_INSTANTIATION_BINDER.bind_unbound_from_actual_instantiations(a.adds, types([t.type!, t.type!]), results);

            are_same(other.type!, results.bindings["TSelf"].actual_type);
            are_same(other.type!, results.bindings["TOther"].actual_type);
            are_same(other.type!, results.bindings["TResult"].actual_type);
        si
    si
si
