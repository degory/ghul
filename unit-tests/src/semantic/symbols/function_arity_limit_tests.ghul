namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins Function.set_return_type / Function.get_full_type reporting an
    // error, rather than building a function type, once the parameter
    // count exceeds what the innate function-type shapes can represent.
    @TestClass()
    class FUNCTION_ARITY_LIMIT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        int_types(count: int) -> LIST[Type] is
            let result = LIST[Type]();

            for i in 0..count do
                result.add(Semantic.Types.ERROR());
            od

            return result;
        si

        @Test()
        Calling__set_return_type__should_error_rather_than_build_a_function_type_over_the_parameter_limit() is
            IoC.CONTAINER.instance.logger = Logging.DIAGNOSTICS_STORE();

            let function = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "do_thing", Semantic.BLOCK_SCOPE());
            function.arguments = int_types(17);

            function.set_return_type(Semantic.Types.ERROR());

            is_true(function.type.is_error);
            is_true(IoC.CONTAINER.instance.logger.any_errors);
        si

        @Test()
        Calling__get_full_type__should_error_rather_than_build_a_function_type_over_the_parameter_limit() is
            IoC.CONTAINER.instance.logger = Logging.DIAGNOSTICS_STORE();

            let function = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "do_thing", Semantic.BLOCK_SCOPE());
            function.arguments = int_types(17);
            function.return_type = Semantic.Types.ERROR();

            let full_type = function.get_full_type(IoC.CONTAINER.instance.innate_symbol_lookup);

            is_true(full_type.is_error);
            is_true(IoC.CONTAINER.instance.logger.any_errors);
        si
    si
si
