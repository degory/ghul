namespace Semantic.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.METHOD_OVERRIDE_CLASS;

    use Semantic.Types.Type;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins the generic-argument-count dimension of METHOD_OVERRIDE_CLASS
    // equality. Two functions whose arguments lists match but whose
    // generic-argument counts differ must hash and compare unequal —
    // that's what lets `foo()` (no generic arguments) coexist with
    // `foo[T]()` (one generic argument) without the duplicate-method
    // checker flagging them.
    @TestClass()
    class METHOD_OVERRIDE_CLASS_GENERIC_ARGUMENTS_COUNT_TESTS is
        init() is si

        empty_args() -> LIST[Type] => LIST[Type]();

        @Test()
        Two_override_classes_with_same_args_and_count_are_equal() is
            let a = METHOD_OVERRIDE_CLASS(empty_args(), 0);
            let b = METHOD_OVERRIDE_CLASS(empty_args(), 0);

            is_true(a.equals(b));
        si

        @Test()
        Two_override_classes_with_same_args_but_different_count_are_not_equal() is
            let a = METHOD_OVERRIDE_CLASS(empty_args(), 0);
            let b = METHOD_OVERRIDE_CLASS(empty_args(), 1);

            is_false(a.equals(b));
        si

        @Test()
        Two_override_classes_with_counts_at_one_and_two_are_not_equal() is
            let a = METHOD_OVERRIDE_CLASS(empty_args(), 1);
            let b = METHOD_OVERRIDE_CLASS(empty_args(), 2);

            is_false(a.equals(b));
        si

        @Test()
        Hash_codes_for_distinct_counts_should_typically_differ() is
            let a = METHOD_OVERRIDE_CLASS(empty_args(), 0);
            let b = METHOD_OVERRIDE_CLASS(empty_args(), 1);

            are_not_equal(a.get_hash_code(), b.get_hash_code());
        si

        @Test()
        Default_init_overload_keeps_count_at_zero() is
            let a = METHOD_OVERRIDE_CLASS(empty_args());

            are_equal(0, a.generic_arguments_count);
        si
    si
si
