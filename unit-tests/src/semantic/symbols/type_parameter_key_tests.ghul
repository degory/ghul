namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT;
    use Semantic.Symbols.GenericArgument;
    use Semantic.Symbols.NAMESPACE;
    use Semantic.Symbols.TYPE_PARAMETER_KEY;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins the key that identifies a type parameter across every symbol
    // standing for it.
    //
    // The parameter does not have one symbol: `freeze` is a memberwise
    // clone, and `make_specialized` builds a copy owned by the parameter it
    // came from. Emission installs the position a captured parameter is
    // reached at against one of those symbols and reads it back through
    // another, so the two have to agree on a key or the read misses and the
    // parameter encodes at its declared index in a frame method that has no
    // method type parameters — metadata the runtime refuses to load.
    //
    // What the key must therefore do: collapse every copy of a parameter
    // onto one entry, keep sibling parameters of the same owner apart, and
    // keep same-index parameters of different owners apart. It is built
    // from an owner reference and an index, so none of that depends on how
    // a parameter is spelled.
    @TestClass()
    class TYPE_PARAMETER_KEY_TESTS is
        // MSTest instantiates the fixture, and skips the whole class
        // without one — silently, and still reporting a pass.
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false);

        parameter(owner: NAMESPACE, name: string, index: int) -> FUNCTION_GENERIC_ARGUMENT =>
            FUNCTION_GENERIC_ARGUMENT(loc(), owner, name, index);

        @Test()
        Calling__of__on_the_same_symbol_twice_should_give_equal_keys() is
            let a = parameter(owner(), "A", 0);

            are_equal(TYPE_PARAMETER_KEY.of(a), TYPE_PARAMETER_KEY.of(a));
        si

        @Test()
        Calling__of__on_a_frozen_copy_should_give_the_key_of_its_source() is
            // The clone freeze produces keeps the owner and the declared
            // index, which is what makes it indistinguishable from its
            // source here — the property the fix depends on.
            let a = parameter(owner(), "A", 0);
            let frozen = cast GenericArgument(a.freeze());

            are_not_same(a, frozen);
            are_equal(TYPE_PARAMETER_KEY.of(a), TYPE_PARAMETER_KEY.of(frozen));
        si

        @Test()
        Calling__of__on_a_frozen_copy_of_a_frozen_copy_should_give_the_key_of_the_source() is
            let a = parameter(owner(), "A", 0);
            let once = cast GenericArgument(a.freeze());
            let twice = cast GenericArgument(once.freeze());

            are_equal(TYPE_PARAMETER_KEY.of(a), TYPE_PARAMETER_KEY.of(twice));
        si

        @Test()
        Calling__of__on_sibling_parameters_of_one_owner_should_give_different_keys() is
            // The case that separates a real translation from one that only
            // corrects the class-versus-method distinction: a captured
            // parameter's index on its frame need not be the index it was
            // declared at, so the two must not collapse together.
            let shared_owner = owner();

            let x = parameter(shared_owner, "X", 0);
            let a = parameter(shared_owner, "A", 1);

            are_not_equal(TYPE_PARAMETER_KEY.of(x), TYPE_PARAMETER_KEY.of(a));
        si

        @Test()
        Calling__of__on_same_index_parameters_of_different_owners_should_give_different_keys() is
            let a = parameter(owner(), "A", 0);
            let b = parameter(owner(), "A", 0);

            are_not_equal(TYPE_PARAMETER_KEY.of(a), TYPE_PARAMETER_KEY.of(b));
        si

        @Test()
        Calling__of__should_ignore_the_parameter_name() is
            // Two parameters that differ only in name are still distinct
            // here because they have distinct owners; the point is that the
            // name is not consulted either way.
            let shared_owner = owner();

            let a = parameter(shared_owner, "A", 0);
            let renamed = parameter(shared_owner, "Element", 0);

            are_equal(TYPE_PARAMETER_KEY.of(a), TYPE_PARAMETER_KEY.of(renamed));
        si

        @Test()
        Calling__of__on_a_classy_parameter_should_key_on_owner_and_index() is
            let shared_owner = owner();

            let first = CLASSY_GENERIC_ARGUMENT(loc(), shared_owner, "T", 0);
            let second = CLASSY_GENERIC_ARGUMENT(loc(), shared_owner, "U", 1);

            are_equal(
                TYPE_PARAMETER_KEY.of(first),
                TYPE_PARAMETER_KEY.of(cast GenericArgument(first.freeze())));

            are_not_equal(TYPE_PARAMETER_KEY.of(first), TYPE_PARAMETER_KEY.of(second));
        si

        @Test()
        Equal_keys_should_hash_alike() is
            let a = parameter(owner(), "A", 0);
            let frozen = cast GenericArgument(a.freeze());

            are_equal(
                TYPE_PARAMETER_KEY.of(a).get_hash_code(),
                TYPE_PARAMETER_KEY.of(frozen).get_hash_code());
        si
    si
si
