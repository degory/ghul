namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the record a pack marker in a declared return type
    // leaves on the function - `-> T.. -> U`. The declared return type
    // still names the tuple-in shape; the depth says how far into it
    // the marked function type sits, and is what a call reads to
    // present the result as the N-ary function of the bound tuple.
    @TestClass()
    class FUNCTION_RETURN_PACK_TESTS is
        _int_type: Type
        _function_owner: CLASS
        _scope: Semantic.BLOCK_SCOPE

        init() is
            _scope = Semantic.BLOCK_SCOPE()

            _int_type =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            _function_owner =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Function", LIST[string](["A", "R"]), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        make_function(return_type: Type) -> GLOBAL_FUNCTION is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "retry", _scope)

            result.arguments = LIST[Type]()
            result.argument_names = LIST[string]()
            result.argument_defaults = LIST[string?]()
            result.argument_is_pack = LIST[bool]()
            result.argument_pack_depth = LIST[int]()
            result.return_type = return_type

            return result
        si

        // `(t0, .., tn) -> r`, the tuple-in shape a pack-marked declared
        // return type names.
        tuple_in_function_type() -> Type =>
            Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, _int_type]))

        @Test()
        Return_pack_depth__is_absent_by_default() is
            are_equal(-1, make_function(_int_type).return_pack_depth)
        si

        @Test()
        Return_pack_depth__survives_specialisation() is
            let function = make_function(tuple_in_function_type())

            function.return_pack_depth = 0

            let specialized = function.specialize_function(Collections.MAP[Symbol,Type](), null)

            are_equal(0, specialized.return_pack_depth)
        si

        @Test()
        Return_pack_depth__of_a_plain_function_is_absent_after_specialisation() is
            let function = make_function(_int_type)

            let specialized = function.specialize_function(Collections.MAP[Symbol,Type](), null)

            are_equal(-1, specialized.return_pack_depth)
        si
    si
si
