namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.ENUM_NOT_OPERATOR
    use Semantic.Symbols.ENUM_STRUCT
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Symbols.Function
    use Semantic.Symbols.INNATE_METHOD
    use Semantic.Symbols.InnateFunction
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Unlike `&`/`|`/`^`, `\` is unary, so it is built as an
    // `INNATE_FUNCTION` (a static member, argument explicit) rather
    // than an `INNATE_METHOD` (receiver-taking): unary operator
    // resolution only considers static operators, so a member `\`
    // would never be found. See the rationale comment on
    // `ENUM_NOT_OPERATOR` itself.
    @TestClass()
    class ENUM_NOT_OPERATOR_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        an_enum() -> ENUM_STRUCT =>
            ENUM_STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Flags", Semantic.BLOCK_SCOPE())

        not_operator_of(owner: ENUM_STRUCT) -> Function? is
            let member = owner.find_member("\\")

            if !member? then
                return null
            fi

            if isa FUNCTION_GROUP(member) then
                for f in (cast FUNCTION_GROUP(member)).functions do
                    return f
                od

                return null
            fi

            if isa Function(member) then
                return cast Function(member)
            fi

            return null
        si

        @Test()
        Registering__adds_a_not_operator() is
            let owner = an_enum()

            ENUM_NOT_OPERATOR.register(owner)

            is_true(not_operator_of(owner)?)
        si

        @Test()
        Registered_operator__takes_one_argument_of_the_enum_type() is
            let owner = an_enum()

            ENUM_NOT_OPERATOR.register(owner)

            let operator = not_operator_of(owner)!

            are_equal(1, operator.arguments.count)
            are_same(owner.type!, operator.arguments[0])
        si

        @Test()
        Registered_operator__returns_the_enum_type() is
            let owner = an_enum()

            ENUM_NOT_OPERATOR.register(owner)

            are_same(owner.type!, not_operator_of(owner)!.return_type!)
        si

        @Test()
        Registered_operator__is_declared_pure() is
            let owner = an_enum()

            ENUM_NOT_OPERATOR.register(owner)

            is_true(not_operator_of(owner)!.is_declared_pure)
        si

        @Test()
        Registered_operator__lowers_to_the_not_arithmetic_innate() is
            let owner = an_enum()

            ENUM_NOT_OPERATOR.register(owner)

            let operator = not_operator_of(owner)!
            let innate_op = cast InnateFunction?(operator)

            is_true(innate_op?)
            are_equal("arithmetic.not", innate_op!.innate_name)
        si

        // Unary operator resolution excludes receiver-taking operators
        // — see `_takes_receiver` in `compile_operators.ghul` — so this
        // has to be an INNATE_FUNCTION rather than an INNATE_METHOD, or
        // `\Flags.READ` would never resolve.
        @Test()
        Registered_operator__is_not_an_innate_method() is
            let owner = an_enum()

            ENUM_NOT_OPERATOR.register(owner)

            let operator = not_operator_of(owner)!

            is_false(isa INNATE_METHOD(operator))
        si
    si
si
