namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.ENUM_AND_OPERATOR
    use Semantic.Symbols.ENUM_STRUCT
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Symbols.Function
    use Semantic.Symbols.InnateFunction
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Unlike `<>`/`=~`, `&` takes and returns the enum's own type - no
    // int or bool to derive from IoC - so a single `register(owner)`
    // is enough. Mirrors `enum_equality_operator_tests`.
    @TestClass()
    class ENUM_AND_OPERATOR_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        an_enum() -> ENUM_STRUCT =>
            ENUM_STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Flags", Semantic.BLOCK_SCOPE())

        and_operator_of(owner: ENUM_STRUCT) -> Function? is
            let member = owner.find_member("&")

            if !member? then
                return null
            fi

            if isa FUNCTION_GROUP(member) then
                for f in (cast FUNCTION_GROUP(member)).functions do
                    return f
                od

                return null
            fi

            if isa Function(member) then
                return cast Function(member)
            fi

            return null
        si

        @Test()
        Registering__adds_an_and_operator() is
            let owner = an_enum()

            ENUM_AND_OPERATOR.register(owner)

            is_true(and_operator_of(owner)?)
        si

        @Test()
        Registered_operator__takes_one_argument_of_the_enum_type() is
            let owner = an_enum()

            ENUM_AND_OPERATOR.register(owner)

            let operator = and_operator_of(owner)!

            are_equal(1, operator.arguments.count)
            are_same(owner.type!, operator.arguments[0])
        si

        @Test()
        Registered_operator__returns_the_enum_type() is
            let owner = an_enum()

            ENUM_AND_OPERATOR.register(owner)

            are_same(owner.type!, and_operator_of(owner)!.return_type!)
        si

        // infer-store-free classifies an innate by walking its body, and
        // this one has none, so the bit is declared rather than inferred.
        // Without it a combination drops every narrowing at its call site.
        @Test()
        Registered_operator__is_declared_pure() is
            let owner = an_enum()

            ENUM_AND_OPERATOR.register(owner)

            is_true(and_operator_of(owner)!.is_declared_pure)
        si

        // `&` lowers through the same `arithmetic.and` innate the scalar
        // integer types use; the innate name is what selects the
        // lowering, so a change to the innate this operator is built
        // with fails here.
        @Test()
        Registered_operator__lowers_to_the_and_arithmetic_innate() is
            let owner = an_enum()

            ENUM_AND_OPERATOR.register(owner)

            let operator = and_operator_of(owner)!
            let innate_op = cast InnateFunction?(operator)

            is_true(innate_op?)
            are_equal("arithmetic.and", innate_op!.innate_name)
        si
    si
si
