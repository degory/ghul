namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Types.NULL

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class VARIABLE_NULL_BOUND_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        origin() -> INFERRED_TYPE_ARG_ORIGIN =>
            INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "v")

        @Test()
        Calling__try_get_inferred_type__after_null_then_a_class__should_return_the_optional_class() is
            let cat = a_class("cat")
            let variable = origin()

            variable.add_lower_bound(NULL())
            variable.add_lower_bound(cat.type!)

            let result = variable.try_get_inferred_type()

            assert result? else "no inferred type"
            is_true(result.is_optional)
            are_same(cat, result.symbol)
        si

        @Test()
        Calling__try_get_inferred_type__after_a_class_then_null__should_return_the_optional_class() is
            let cat = a_class("cat")
            let variable = origin()

            variable.add_lower_bound(cat.type!)
            variable.add_lower_bound(NULL())

            let result = variable.try_get_inferred_type()

            assert result? else "no inferred type"
            is_true(result.is_optional)
        si

        @Test()
        Calling__try_get_inferred_type__after_only_null__should_return_null() is
            let variable = origin()

            variable.add_lower_bound(NULL())

            is_null(variable.try_get_inferred_type())
        si

        @Test()
        Calling__add_lower_bound__with_null_twice__should_report_progress_only_once() is
            let variable = origin()

            is_true(variable.add_lower_bound(NULL()))
            is_false(variable.add_lower_bound(NULL()))
            is_true(variable.has_seen_null)
        si
    si
si
