namespace Semantic.Symbols.UnitTests is
    use System.Text.StringBuilder;

    use Collections.LIST;

    use Semantic.Types.Type;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins the emission and access-policy contract of the underscore method
    // kinds chosen by Classy._make_instance_method / _make_static_method:
    // both private and protected emit assembly (the policy distinction is a
    // compile-time rule, not an IL keyword), private methods are non-virtual,
    // and is_accessible_to encodes declaring-class (private) vs owner-or-
    // subclass (protected). access_prefix drives the hover text.
    @TestClass()
    class UNDERSCORE_METHOD_ACCESS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        a_class(name: string) -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE());
        @Test()
        private_method_reachable_only_from_declaring_class() is
            let owner = a_class("A");
            let m = PRIVATE_METHOD(loc(), loc(), owner, "_helper", owner);

            is_true(m.is_accessible_to(owner));
            is_false(m.is_accessible_to(a_class("Other")));
            is_false(m.is_accessible_to(null));
        si

        @Test()
        private_member_reached_through_a_specialization_is_accessible_to_the_declaring_type() is
            // A member read on a second instance of the same generic -
            // the equality/comparison pattern - is reached through the
            // GENERIC for the constructed type, which carries that
            // GENERIC as its owner rather than the declaring class.
            let g = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "G", LIST[string](["T"]), Semantic.BLOCK_SCOPE());
            let args = LIST[Type]();
            args.add(a_class("int").type!);
            let spec = GENERIC(loc(), g, args);

            // A private field reached through the specialization.
            let f = INSTANCE_FIELD(loc(), spec, "_v");
            is_true(f.is_accessible_to(g));
            is_false(f.is_accessible_to(a_class("Other")));

            // A private method reached through the specialization - the
            // method analogue of the same peer-instance access.
            let m = PRIVATE_METHOD(loc(), loc(), spec, "_peer", g);
            is_true(m.is_accessible_to(g));
            is_false(m.is_accessible_to(a_class("Other")));
        si
    si
si
