namespace Semantic.Symbols.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.Symbols.INDEXER_NAMES;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins the names an indexer's accessors are declared under. Indexing
    // resolves `x[i]` by looking a member up by name, and the reflected
    // loader declares an imported accessor under the same name, so the two
    // sides agree only as long as they agree on these strings. A change
    // here that looks cosmetic silently stops `x[i]` resolving.
    @TestClass()
    class INDEXER_NAMES_TESTS is
        init() is si

        @Test()
        Read_accessor__is_named_for_the_indexer_property() is
            are_equal("get_Item", INDEXER_NAMES.read);
        si

        @Test()
        Assign_accessor__is_named_for_the_indexer_property() is
            are_equal("set_Item", INDEXER_NAMES.assign);
        si

        // A getter is anything not spelled `set_`: metadata names it after
        // the property, which is `Chars` on string and StringBuilder and
        // anything at all under [IndexerName].
        @Test()
        Getter_of_any_metadata_name__maps_to_the_read_accessor() is
            are_equal(INDEXER_NAMES.read, INDEXER_NAMES.accessor("get_Item"));
            are_equal(INDEXER_NAMES.read, INDEXER_NAMES.accessor("get_Chars"));
            are_equal(INDEXER_NAMES.read, INDEXER_NAMES.accessor("get_Frobnicate"));
        si

        @Test()
        Setter_of_any_metadata_name__maps_to_the_assign_accessor() is
            are_equal(INDEXER_NAMES.assign, INDEXER_NAMES.accessor("set_Item"));
            are_equal(INDEXER_NAMES.assign, INDEXER_NAMES.accessor("set_Chars"));
        si

        // Canonical means metadata already names the accessor the way it is
        // declared, so the loader adds no second name for it. `get_Chars`
        // is not, which is what earns string's accessor its alias.
        @Test()
        Accessor_already_named_for_the_indexer__is_canonical() is
            is_true(INDEXER_NAMES.is_canonical("get_Item"));
            is_true(INDEXER_NAMES.is_canonical("set_Item"));
        si

        @Test()
        Accessor_named_anything_else__is_not_canonical() is
            is_false(INDEXER_NAMES.is_canonical("get_Chars"));
            is_false(INDEXER_NAMES.is_canonical("set_Chars"));
        si

        // The de-camelled spelling a reader would write is not the declared
        // name, so it must not be mistaken for one.
        @Test()
        De_camelled_spelling__is_not_canonical() is
            is_false(INDEXER_NAMES.is_canonical("get_item"));
            is_false(INDEXER_NAMES.is_canonical("get_chars"));
        si
    si
si
