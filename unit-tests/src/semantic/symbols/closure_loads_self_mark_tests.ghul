namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.Closure

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The loads-self mark gates delegate memoisation and is answered per
    // walk of the literal's body: entering the body clears what an
    // earlier walk left, and a load during the walk sets it again.
    @TestClass()
    class CLOSURE_LOADS_SELF_MARK_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        closure() -> Closure is
            let host = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "HOST", LIST[string](), Semantic.BLOCK_SCOPE())

            return Semantic.Symbols.STATIC_CLOSURE(loc(), host, "$anon_0", host, false)
        si

        @Test()
        Calling__enter_literal_body__should_clear_a_mark_an_earlier_walk_left() is
            let c = closure()

            c.note_delegate_body_loads_self()
            is_true(c.delegate_body_loads_self)

            c.enter_literal_body()
            is_false(c.delegate_body_loads_self)
        si

        @Test()
        Calling__note_delegate_body_loads_self__during_a_walk__should_mark_the_closure() is
            let c = closure()

            c.enter_literal_body()
            c.note_delegate_body_loads_self()
            c.leave_literal_body()

            is_true(c.delegate_body_loads_self)
        si
    si
si
