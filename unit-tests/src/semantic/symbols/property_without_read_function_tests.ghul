namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Error recovery can declare a property that never gets accessor
    // functions. Reading one loads an ERROR value, so the read degrades
    // to the error already reported rather than failing an internal
    // assertion at every use.
    @TestClass()
    class PROPERTY_WITHOUT_READ_FUNCTION_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 10)

        loader() -> SYMBOL_LOADER is
            let logger = DIAGNOSTICS_STORE()
            let symbol_table = SYMBOL_TABLE(logger)

            IoC.CONTAINER.instance.symbol_table = symbol_table

            return SYMBOL_LOADER(
                logger,
                symbol_table,
                FUNCTION_CALLER(symbol_table, IR.VALUE_BOXER(logger)),
                IR.VALUE_BOXER(logger),
                Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP())
        si

        @Test()
        load_global_property__without_a_read_function__loads_an_error_value() is
            let property = GLOBAL_PROPERTY(loc(), loc(), Semantic.BLOCK_SCOPE(), "n", false)

            let result = loader().load_global_property(loc(), property)

            is_true(result.type!.is_error)
        si

        @Test()
        load_static_property__without_a_read_function__loads_an_error_value() is
            let property = STATIC_PROPERTY(loc(), loc(), Semantic.BLOCK_SCOPE(), "n", false, false)

            let result = loader().load_static_property(loc(), property)

            is_true(result.type!.is_error)
        si
    si
si
