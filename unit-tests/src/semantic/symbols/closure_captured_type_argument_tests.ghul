namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.GenericArgument
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.STATIC_CLOSURE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins that a closure gives one frame slot to each captured type
    // parameter, however many symbols stand for that parameter.
    //
    // A captured type can arrive as the parameter's own symbol or as a
    // frozen copy of it, which are different objects. Numbering them
    // separately would give one parameter two frame indices, and since the
    // position a parameter is reached at is held against the parameter
    // rather than against the symbol, the second slot's install would
    // overwrite the first and leave one of the indices unreachable.
    @TestClass()
    class CLOSURE_CAPTURED_TYPE_ARGUMENT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false)

        closure(owner: NAMESPACE) -> STATIC_CLOSURE =>
            STATIC_CLOSURE(loc(), owner, "$anon", owner, false)

        @Test()
        Capturing_a_parameter_owned_by_a_block_scope_should_take_no_slot() is
            // A type variable is emitted as an index into the type
            // parameters of whatever declares it, and a block scope
            // declares none. Recording one made the frame generic in a
            // parameter nothing binds, and the assembly would not load.
            let subject = closure(owner())

            let orphan =
                FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0)

            subject.add_type_argument_reference(orphan)

            is_false(subject.captured_type_arguments?)
        si

        @Test()
        Capturing_one_parameter_twice_should_take_one_slot() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 0)

            subject.add_type_argument_reference(a)
            subject.add_type_argument_reference(a)

            are_equal(1, subject.captured_type_arguments!.count)
        si

        @Test()
        Capturing_a_parameter_and_a_frozen_copy_should_take_one_slot() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 0)
            let frozen = cast GenericArgument(a.freeze())

            are_not_same(a, frozen)

            subject.add_type_argument_reference(a)
            subject.add_type_argument_reference(frozen)

            are_equal(1, subject.captured_type_arguments!.count)
        si

        @Test()
        Capturing_a_frozen_copy_first_should_still_take_one_slot() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 0)
            let frozen = cast GenericArgument(a.freeze())

            subject.add_type_argument_reference(frozen)
            subject.add_type_argument_reference(a)

            are_equal(1, subject.captured_type_arguments!.count)
        si

        @Test()
        Capturing_sibling_parameters_should_take_a_slot_each() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let x = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "X", 0)
            let a = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "A", 1)

            subject.add_type_argument_reference(x)
            subject.add_type_argument_reference(a)

            are_equal(2, subject.captured_type_arguments!.count)
        si
    si
si
