namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Semantic.Symbols.GLOBAL_FUNCTION;

    use Source.LOCATION;

    // Symbol ids are the transferable identity that id-keyed fact
    // tables survive symbol re-creation through: unique at creation,
    // adoptable by a replacement.
    class SYMBOL_IDENTITY_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION.internal;

        Symbols_get_distinct_ids() is
            @test()

            let first = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "f", Semantic.BLOCK_SCOPE());
            let second = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "g", Semantic.BLOCK_SCOPE());

            Assert.are_not_equal(first.id, second.id);
        si

        Adopting_transfers_the_predecessors_id() is
            @test()

            let predecessor = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "f", Semantic.BLOCK_SCOPE());
            let replacement = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "f", Semantic.BLOCK_SCOPE());

            replacement.adopt_id(predecessor);

            Assert.are_equal(predecessor.id, replacement.id);
        si

    si
si
