namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    // A generator or async method declared in a trait body is a default
    // trait method: it always has a body, and implementing types inherit
    // it the same way they inherit a plain default method. That last part
    // hangs on `is_default_trait_method`, which is what pulls the member
    // down onto each implementor — a generator or async method reporting
    // false there is simply invisible to them.
    class TRAIT_STATE_MACHINE_METHOD_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        a_trait() -> TRAIT => TRAIT(loc(), loc(), null, "Test", LIST[string](), null);

        Declaring__a_generator__in_a_trait__should_produce_a_default_trait_method() is
            @test()

            let owner = a_trait();

            let symbol = owner.declare_generator_function(loc(), loc(), "repeat", false, false, true, owner, null);

            Assert.is_true(isa DEFAULT_TRAIT_GENERATOR_METHOD(symbol));

            let function = cast Function(symbol);

            Assert.is_true(function.is_default_trait_method);
            Assert.is_true(function.is_instance);
        si

        Declaring__an_async_method__in_a_trait__should_produce_a_default_trait_method() is
            @test()

            let owner = a_trait();

            let symbol = owner.declare_async_function(loc(), loc(), "later", false, false, true, owner, null);

            Assert.is_true(isa DEFAULT_TRAIT_ASYNC_METHOD(symbol));

            let function = cast Function(symbol);

            Assert.is_true(function.is_default_trait_method);
            Assert.is_true(function.is_instance);
        si

        Declaring__a_generator__in_a_class__should_not_produce_a_default_trait_method() is
            @test()

            let owner = CLASS(loc(), loc(), null, "TEST", LIST[string](), null);

            let symbol = owner.declare_generator_function(loc(), loc(), "repeat", false, false, true, owner, null);

            let function = cast Function(symbol);

            Assert.is_false(function.is_default_trait_method);
        si
    si
si
