namespace Semantic.Symbols.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Logging.DIAGNOSTICS_STORE;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // load_self is what supplies `self` when an instance member is
    // called without an explicit receiver from inside a method body.
    // It has to hand back the type applied to its own type parameters
    // (own_instantiation) rather than the open, uninstantiated type
    // (Classy.type) — the open form names no type at run time, so a
    // caller that boxes this receiver (e.g. to call an inherited
    // Object member like get_type()) would emit a type token the
    // runtime cannot load.
    @TestClass()
    class METHOD_LOAD_SELF_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        names_for(values: Collections.Iterable[string]) -> LIST[string] is
            let result = LIST[string]();
            for v in values do result.add(v); od
            return result;
        si

        // Pushes `owner` as the current instance context so
        // Method.load_self's IoC.CONTAINER lookup finds it.
        enter(owner: Classy) is
            IoC.CONTAINER.instance.symbol_table = SYMBOL_TABLE(DIAGNOSTICS_STORE());
            IoC.CONTAINER.instance.symbol_table.enter_scope(owner);
        si

        struct_loader() -> SYMBOL_LOADER is
            let logger = DIAGNOSTICS_STORE();
            let symbol_table = IoC.CONTAINER.instance.symbol_table;
            let innate_symbol_lookup = Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP();

            return SYMBOL_LOADER(
                logger,
                symbol_table,
                FUNCTION_CALLER(symbol_table, IR.VALUE_BOXER(logger)),
                IR.VALUE_BOXER(logger),
                innate_symbol_lookup);
        si

        @Test()
        Calling__load_self__on_a_struct_method__inside_a_non_generic_struct__uses_own_instantiation() is
            let owner = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Plain", LIST[string](), Semantic.BLOCK_SCOPE());
            owner.set_type(Types.NAMED(owner));

            enter(owner);

            let method = STRUCT_METHOD(loc(), loc(), owner, "item", Semantic.BLOCK_SCOPE());
            let self_value = method.load_self(loc(), struct_loader());

            are_same(owner.own_instantiation, self_value.type);
            are_same(owner.type!, self_value.type);
        si

        // A generic owner: self_value.type must be GEN applied to its
        // own T, not the open GEN type — the open form has no type
        // arguments and names nothing loadable at run time.
        @Test()
        Calling__load_self__on_a_struct_method__inside_a_generic_struct__uses_own_instantiation() is
            let owner = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "GEN", names_for(["T"]), Semantic.BLOCK_SCOPE());
            owner.set_type(Types.NAMED(owner));
            owner.declare_type(loc(), "T", 0, null);

            enter(owner);

            let method = STRUCT_METHOD(loc(), loc(), owner, "item", Semantic.BLOCK_SCOPE());
            let self_value = method.load_self(loc(), struct_loader());

            // own_instantiation builds a fresh GENERIC on each call
            // (see Classy.own_instantiation), so compare shape rather
            // than reference: the wrapped symbol is `owner` and the
            // sole argument is `owner`'s own declared T.
            let constructed = cast Semantic.Symbols.GENERIC?(self_value.type!.symbol);

            is_true(constructed?);
            are_same(cast Symbol(owner), cast Symbol(constructed!.symbol));
            are_equal(1, self_value.type!.arguments.count);
            are_same(owner.find_direct("T")!.type!, self_value.type!.arguments[0]);
        si

        @Test()
        Calling__load_self__on_an_instance_method__inside_a_generic_class__uses_own_instantiation() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "GEN", names_for(["T"]), Semantic.BLOCK_SCOPE());
            owner.set_type(Types.NAMED(owner));
            owner.declare_type(loc(), "T", 0, null);

            enter(owner);

            let method = INSTANCE_METHOD(loc(), loc(), owner, "item", Semantic.BLOCK_SCOPE());
            let self_value = method.load_self(loc(), struct_loader());

            let constructed = cast Semantic.Symbols.GENERIC?(self_value.type!.symbol);

            is_true(constructed?);
            are_same(cast Symbol(owner), cast Symbol(constructed!.symbol));
            are_equal(1, self_value.type!.arguments.count);
            are_same(owner.find_direct("T")!.type!, self_value.type!.arguments[0]);
        si
    si
si
