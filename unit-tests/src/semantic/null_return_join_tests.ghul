namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.STRUCT
    use Semantic.NULL_RETURN_JOIN
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // What an inferred return type settles at once one of the function's
    // returns produced null: the null says the return can be absent
    // without saying what it holds, so it widens whatever the other
    // returns settled on rather than settling anything itself.
    @TestClass()
    class NULL_RETURN_JOIN_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        names_t() -> LIST[string] is
            let names = LIST[string]()

            names.add("T")

            return names
        si

        ref_type() -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Ref", empty_names(), Semantic.BLOCK_SCOPE()).type!

        val_type() -> Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Val", empty_names(), Semantic.BLOCK_SCOPE()).type!

        type_var_type() -> Type =>
            CLASSY_GENERIC_ARGUMENT(
                loc(),
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", names_t(), Semantic.BLOCK_SCOPE()),
                "T",
                0
            ).type!

        lookup() -> Semantic.Lookups.InnateSymbolLookup =>
            IoC.CONTAINER.instance.innate_symbol_lookup

        // No null among the returns: the pin is what the returns said.
        @Test()
        of__leaves_a_return_alone_where_no_return_produced_null() is
            let pinned = ref_type()

            are_same(pinned, NULL_RETURN_JOIN.of(pinned, false, lookup()))
        si

        @Test()
        of__widens_a_reference_return_to_its_optional() is
            let widened = NULL_RETURN_JOIN.of(ref_type(), true, lookup())

            is_true(widened.is_optional)
        si

        // Already able to be absent, so the null adds nothing: widening
        // again would make an optional of an optional.
        @Test()
        of__leaves_a_return_that_can_already_be_absent_alone() is
            let optional = ref_type().as_optional()

            are_same(optional, NULL_RETURN_JOIN.of(optional, true, lookup()))
        si

        // A type variable has no optional carrier to widen into - the
        // same verdict an if or case arm reaches against a null.
        @Test()
        of__leaves_a_type_variable_alone() is
            let pinned = type_var_type()

            are_same(pinned, NULL_RETURN_JOIN.of(pinned, true, lookup()))
        si
    si
si
