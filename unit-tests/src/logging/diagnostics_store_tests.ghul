namespace Logging.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use System.Text.RegularExpressions.Regex;

    use Logging.DIAGNOSTIC_MESSAGE;
    use Logging.DIAGNOSTICS_STORE;
    use Logging.HUMAN_READABLE_DIAGNOSTIC_FORMATTER;
    use Logging.MSBUILD_DIAGNOSTIC_FORMATTER;
    use Logging.TAB_DELIMITED_DIAGNOSTIC_FORMATTER;

    class DIAGNOSTICS_STORE_TESTS is
        @test()

        init() is si

        loc(path: string, line: int) -> LOCATION => LOCATION(path, line, 1, line, 10);

        // Log `count` pre-analysis warnings into the store — the shape the
        // check-name-conventions post-parse pass produces, spread across
        // several files.
        add_pre_analysis_warnings(store: DIAGNOSTICS_STORE, count: int) is
            for i in 0..count do
                store.warn(loc("warnings{i % 3}.ghul", i + 1), "some-warning-code", "warning number {i}");
            od
        si

        write_diagnostics(store: DIAGNOSTICS_STORE) -> string is
            let buffer = IO.StringWriter();
            store.write_all_diagnostics(buffer, TAB_DELIMITED_DIAGNOSTIC_FORMATTER());
            return buffer.to_string();
        si

        many_standing_warnings_do_not_arm_the_cascade_filter() is
            @test()

            let store = DIAGNOSTICS_STORE();

            add_pre_analysis_warnings(store, 40);

            store.start_analysis();
            store.error(loc("broken.ghul", 3), "Ghul.string is not assignable to Ghul.int");
            store.end_analysis();

            Assert.is_false(store.only.is_possible_error_cascade);

            let written = write_diagnostics(store);

            Assert.is_true(
                written.contains("not assignable"),
                "semantic error missing from diagnostics output:\n{written}"
            );
        si

        many_syntax_errors_arm_the_cascade_filter() is
            @test()

            let store = DIAGNOSTICS_STORE();

            for i in 0..31 do
                store.error(loc("broken.ghul", i + 1), "syntax error number {i}");
            od

            store.start_analysis();
            store.error(loc("broken.ghul", 40), "downstream semantic error");
            store.end_analysis();

            Assert.is_true(store.only.is_possible_error_cascade);

            let written = write_diagnostics(store);

            Assert.is_false(
                written.contains("downstream semantic error"),
                "cascade-filtered output should hold back analysis diagnostics:\n{written}"
            );

            Assert.is_true(
                written.contains("syntax error number 0"),
                "cascade-filtered output should still carry the leading syntax errors:\n{written}"
            );
        si

        warnings_do_not_count_towards_the_cascade_error_threshold() is
            @test()

            let store = DIAGNOSTICS_STORE();

            add_pre_analysis_warnings(store, 40);

            // One genuine syntax error, but nowhere near 30 errors in
            // total — the standing warnings must not tip the threshold.
            store.error(loc("broken.ghul", 1), "expected identifier");

            store.start_analysis();
            store.error(loc("broken.ghul", 3), "downstream semantic error");
            store.end_analysis();

            Assert.is_false(store.only.is_possible_error_cascade);

            let written = write_diagnostics(store);

            Assert.is_true(
                written.contains("downstream semantic error"),
                "semantic error missing from diagnostics output:\n{written}"
            );
        si

        // The changed set drives which files get their expression walk
        // redone, so what matters is not only that a change was seen but
        // which paths it names: a swap has to report both the path that
        // left the set and the one that joined it.
        changed(store: DIAGNOSTICS_STORE, paths: Collections.Iterable[string]) -> string static is
            let names = Collections.LIST[string](store.set_open_files(paths));

            names.sort();

            return string.join(",", names);
        si

        set_open_files__reports_the_path_when_first_populated() is
            @test()

            let store = DIAGNOSTICS_STORE();

            Assert.are_equal(
                "a.ghul",
                changed(store, ["a.ghul"]),
                "populating an empty open-file set must report the path it gained"
            );
        si

        set_open_files__reports_nothing_on_identical_replacement() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul", "b.ghul"]);

            Assert.are_equal(
                "",
                changed(store, ["a.ghul", "b.ghul"]),
                "replacing the open-file set with an identical one must report no change"
            );
        si

        set_open_files__reports_nothing_on_reorder() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul", "b.ghul"]);

            Assert.are_equal(
                "",
                changed(store, ["b.ghul", "a.ghul"]),
                "set membership is order-insensitive"
            );
        si

        set_open_files__reports_nothing_on_duplicates() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);

            Assert.are_equal(
                "",
                changed(store, ["a.ghul", "a.ghul"]),
                "duplicate paths collapse in a set"
            );
        si

        set_open_files__reports_only_the_added_path() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);

            Assert.are_equal(
                "b.ghul",
                changed(store, ["a.ghul", "b.ghul"]),
                "adding a path must report that path and leave the others alone"
            );
        si

        set_open_files__reports_the_removed_path() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul", "b.ghul"]);

            Assert.are_equal(
                "b.ghul",
                changed(store, ["a.ghul"]),
                "dropping a path must report that path"
            );
        si

        set_open_files__reports_both_sides_of_a_swap() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);

            Assert.are_equal(
                "a.ghul,b.ghul",
                changed(store, ["b.ghul"]),
                "a swap changes the gating of the path that left as well as the one that joined"
            );
        si

        set_open_files__reports_every_path_on_clear() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul", "b.ghul"]);

            Assert.are_equal(
                "a.ghul,b.ghul",
                changed(store, Collections.LIST[string]()),
                "clearing a non-empty open-file set must report every path it held"
            );
        si

        set_open_files__reports_nothing_on_empty_to_empty() is
            @test()

            let store = DIAGNOSTICS_STORE();

            Assert.are_equal(
                "",
                changed(store, Collections.LIST[string]()),
                "empty-to-empty must report no change"
            );
        si

        demote_to_hint__drops_the_warning_in_batch_compilation() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.demote_to_hint("cast-may-throw");

            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");

            Assert.is_false(store.any_warnings, "a demoted warning must not count as a warning");
            Assert.are_equal(0, store.only.count, "a demoted warning must not be recorded in batch compilation");

            let written = write_diagnostics(store);

            Assert.is_false(
                written.contains("cast may throw here"),
                "a demoted warning must not reach batch output:\n{written}"
            );
        si

        demote_to_hint__surfaces_as_a_hint_for_an_open_file_in_analysis() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);
            store.demote_to_hint("cast-may-throw");

            store.start_analysis();
            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");
            store.end_analysis();

            Assert.is_false(store.any_warnings, "a demoted warning is a hint, not a warning");
            Assert.is_false(store.any_errors, "a demoted warning is a hint, not an error");

            let written = write_diagnostics(store);

            Assert.is_true(
                written.contains("cast may throw here"),
                "a demoted warning must surface as a hint for an open file in analysis:\n{written}"
            );

            // Tab-delimited severity column: HINT is 4.
            Assert.is_true(
                written.contains("\t4\t"),
                "a demoted warning must carry HINT severity:\n{written}"
            );
        si

        demote_to_hint__drops_the_hint_for_a_file_the_client_is_not_viewing() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["other.ghul"]);
            store.demote_to_hint("cast-may-throw");

            store.start_analysis();
            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");
            store.end_analysis();

            Assert.are_equal(0, store.only.count, "a demoted hint must be dropped for a file that is not open");
        si

        suppress_wins_over_demote_to_hint() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);
            store.demote_to_hint("cast-may-throw");
            store.suppress("cast-may-throw");

            store.start_analysis();
            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");
            store.end_analysis();

            Assert.are_equal(0, store.only.count, "suppression must win over demotion to hint");
        si

        demote_to_hint__wins_over_promote_to_error() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);
            store.demote_to_hint("cast-may-throw");
            store.promote_to_error("cast-may-throw");

            store.start_analysis();
            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");
            store.end_analysis();

            Assert.is_false(store.any_errors, "demotion to hint must win over promotion to error");
        si

        demote_to_info__keeps_the_diagnostic_visible_in_batch_as_info() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.demote_to_info("cast-may-throw");

            // Batch compilation: not analysis, no open files.
            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");

            Assert.is_false(store.any_warnings, "a demoted warning is info, not a warning");
            Assert.is_false(store.any_errors, "a demoted warning is info, not an error");
            Assert.are_equal(1, store.only.count, "info stays a batch-visible diagnostic");

            // Tab-delimited severity column: INFO is 3.
            let written = write_diagnostics(store);

            Assert.is_true(
                written.contains("\t3\t"),
                "a warning demoted to info must carry INFO severity:\n{written}"
            );
        si

        suppress_wins_over_demote_to_info() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.demote_to_info("cast-may-throw");
            store.suppress("cast-may-throw");

            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");

            Assert.are_equal(0, store.only.count, "suppression must win over demotion to info");
        si

        demote_to_hint_wins_over_demote_to_info() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.demote_to_hint("cast-may-throw");
            store.demote_to_info("cast-may-throw");

            // Batch: a hint is gated away, an info would remain. If hint
            // wins, nothing is recorded in batch.
            store.warn(loc("a.ghul", 1), "cast-may-throw", "cast may throw here");

            Assert.are_equal(0, store.only.count, "demotion to hint must take precedence over demotion to info");
        si

        want_hint_for__in_analysis_gates_on_the_open_file_set() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);
            store.start_analysis();

            Assert.is_true(store.want_hint_for(loc("a.ghul", 1)), "an open file wants hints in analysis");
            Assert.is_false(store.want_hint_for(loc("b.ghul", 1)), "a file the client is not viewing does not");

            store.end_analysis();

            Assert.is_false(store.want_hint_for(loc("a.ghul", 1)), "outside analysis, hints are off again");
        si

        error_with_related_location_carries_it_on_the_message() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(loc("a.ghul", 5), "redefining symbol X", loc("a.ghul", 1), "originally defined here");

            let messages = LIST[DIAGNOSTIC_MESSAGE](store.diagnostics_for("a.ghul"));

            Assert.are_equal(1, messages.count);
            Assert.is_true(messages[0].related?, "expected a related location to be recorded");
            Assert.are_equal(1, messages[0].related!.count);
            Assert.are_equal("originally defined here", messages[0].related![0].message);
            Assert.are_equal(1, messages[0].related![0].location.start_line);
        si

        warn_with_related_location_carries_it_through() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.warn(loc("a.ghul", 5), "hides-inherited", "hides Base.foo", loc("base.ghul", 3), "hidden declaration");

            let messages = LIST[DIAGNOSTIC_MESSAGE](store.diagnostics_for("a.ghul"));

            Assert.are_equal(1, messages.count);
            Assert.is_true(messages[0].related?, "expected a related location to be recorded");
            Assert.are_equal("hidden declaration", messages[0].related![0].message);
            Assert.are_equal("base.ghul", messages[0].related![0].location.file_name);
        si

        warn_with_related_location_still_respects_suppression() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.suppress("hides-inherited");
            store.warn(loc("a.ghul", 5), "hides-inherited", "hides Base.foo", loc("base.ghul", 3), "hidden declaration");

            Assert.are_equal(0, store.only.count, "a suppressed code must drop the diagnostic even with a related location");
        si

        warn_with_several_related_locations_carries_all_of_them() is
            @test()

            let store = DIAGNOSTICS_STORE();
            let related = LIST[Logging.RELATED_LOCATION]();

            related.add(Logging.RELATED_LOCATION(loc("a.ghul", 1), "first declared here"));
            related.add(Logging.RELATED_LOCATION(loc("a.ghul", 2), "second declared here"));

            store.warn(loc("a.ghul", 5), "field-definite-assignment", "first, second are not assigned on every path out of this constructor", related);

            let messages = LIST[DIAGNOSTIC_MESSAGE](store.diagnostics_for("a.ghul"));

            Assert.are_equal(1, messages.count);
            Assert.is_true(messages[0].related?, "expected related locations to be recorded");
            Assert.are_equal(2, messages[0].related!.count);
            Assert.are_equal("first declared here", messages[0].related![0].message);
            Assert.are_equal("second declared here", messages[0].related![1].message);
        si

        warn_with_several_related_locations_still_respects_suppression() is
            @test()

            let store = DIAGNOSTICS_STORE();
            let related = LIST[Logging.RELATED_LOCATION]();

            related.add(Logging.RELATED_LOCATION(loc("a.ghul", 1), "first declared here"));

            store.suppress("field-definite-assignment");
            store.warn(loc("a.ghul", 5), "field-definite-assignment", "first is not assigned on every path out of this constructor", related);

            Assert.are_equal(0, store.only.count, "a suppressed code must drop the diagnostic even with several related locations");
        si

        error_with_several_related_locations_carries_all_of_them() is
            @test()

            let store = DIAGNOSTICS_STORE();
            let related = LIST[Logging.RELATED_LOCATION]();

            related.add(Logging.RELATED_LOCATION(loc("a.ghul", 1), "first declared here"));
            related.add(Logging.RELATED_LOCATION(loc("a.ghul", 2), "second declared here"));

            store.error(loc("a.ghul", 5), "redefining symbol X", related);

            let messages = LIST[DIAGNOSTIC_MESSAGE](store.diagnostics_for("a.ghul"));

            Assert.are_equal(1, messages.count);
            Assert.is_true(messages[0].related?, "expected related locations to be recorded");
            Assert.are_equal(2, messages[0].related!.count);
            Assert.are_equal("first declared here", messages[0].related![0].message);
            Assert.are_equal("second declared here", messages[0].related![1].message);
        si

        human_readable_formatter_appends_related_locations() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(
                loc("a.ghul", 5),
                "redefining symbol X",
                loc("a.ghul", 1),
                "also declared here");

            let buffer = IO.StringWriter();

            store.write_all_diagnostics(buffer, HUMAN_READABLE_DIAGNOSTIC_FORMATTER());

            let written = buffer.to_string();

            Assert.is_true(
                written.contains("[also declared here: a.ghul: 1,1..1,11]"),
                "the human-readable output must carry the related location textually:\n{written}"
            );
        si

        msbuild_formatter_appends_related_locations() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(
                loc("a.ghul", 5),
                "redefining symbol X",
                loc("a.ghul", 1),
                "also declared here");

            let buffer = IO.StringWriter();

            store.write_all_diagnostics(buffer, MSBUILD_DIAGNOSTIC_FORMATTER());

            let written = buffer.to_string();

            Assert.is_true(
                written.contains("[also declared here: a.ghul(1,1)]"),
                "the MSBuild output must carry the related location textually:\n{written}"
            );
        si

        // Advice is carried as a related location on the diagnostic's own
        // position, which is not somewhere to navigate to - so the message
        // renders without a location suffix. LOCATION is a class, so this
        // has to compare by value: an equal location built separately from
        // the diagnostic's own is still the diagnostic's own position.
        human_readable_formatter_omits_the_location_of_a_same_position_related_entry() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(
                loc("a.ghul", 5),
                "== cannot be applied to values of type PAIR",
                loc("a.ghul", 5),
                "help: use =~ to compare by value");

            let buffer = IO.StringWriter();

            store.write_all_diagnostics(buffer, HUMAN_READABLE_DIAGNOSTIC_FORMATTER());

            let written = buffer.to_string();

            Assert.is_true(
                written.contains("[help: use =~ to compare by value]"),
                "advice on the diagnostic's own position must render without a location:\n{written}"
            );
        si

        msbuild_format(store: DIAGNOSTICS_STORE) -> string is
            let buffer = IO.StringWriter();
            store.write_all_diagnostics(buffer, MSBUILD_DIAGNOSTIC_FORMATTER());
            return buffer.to_string();
        si

        // MSBuild parses its canonical shape and nothing else, so these
        // pin the exact rendering rather than just that something came out.
        msbuild_formatter_writes_an_error_in_canonical_form() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(LOCATION("a.ghul", 2, 9, 2, 37), "string is not assignable to int");

            Assert.is_true(
                msbuild_format(store).contains("a.ghul(2,9,2,38): error: string is not assignable to int"),
                "expected canonical error form:\n{msbuild_format(store)}"
            );
        si

        // The severity's own name is WARN, which MSBuild does not recognise
        // as a category - it has to be spelled "warning".
        msbuild_formatter_writes_a_warning_as_the_warning_category() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.warn(LOCATION("a.ghul", 11, 13, 11, 23), "cast-may-throw", "cast to non-optional CAT may throw");

            let written = msbuild_format(store);

            Assert.is_true(
                written.contains("a.ghul(11,13,11,24): warning cast-may-throw: cast to non-optional CAT may throw"),
                "expected canonical warning form carrying the slug as the code:\n{written}"
            );

            Assert.is_false(
                written.contains("WARN"),
                "the severity's own name is not an MSBuild category:\n{written}"
            );
        si

        msbuild_formatter_writes_an_error_code_when_the_diagnostic_carries_a_slug() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.promote_to_error("cast-may-throw");
            store.warn(LOCATION("a.ghul", 4, 1, 4, 9), "cast-may-throw", "cast may throw here");

            Assert.is_true(
                msbuild_format(store).contains("a.ghul(4,1,4,10): error cast-may-throw: cast may throw here"),
                "a promoted warning keeps its slug in the code slot:\n{msbuild_format(store)}"
            );
        si

        msbuild_formatter_maps_fatal_to_the_error_category() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.fatal(LOCATION("a.ghul", 7, 2, 7, 5), "internal compiler failure");

            let written = msbuild_format(store);

            Assert.is_true(
                written.contains("a.ghul(7,2,7,6): error: internal compiler failure"),
                "a fatal diagnostic must reach MSBuild as an error:\n{written}"
            );

            Assert.is_false(
                written.contains("FATAL"),
                "the severity's own name is not an MSBuild category:\n{written}"
            );
        si

        // MSBuild has no informational category, so an info diagnostic is
        // written as plain text rather than inflating the warning count.
        msbuild_formatter_writes_info_without_a_category() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.info(loc("a.ghul", 3), "just so you know");

            let written = msbuild_format(store);

            Assert.is_true(
                written.contains("just so you know"),
                "an info diagnostic should still be written:\n{written}"
            );

            Assert.is_false(
                written.contains("warning") \/ written.contains("error"),
                "info must not be miscategorised as a warning or an error:\n{written}"
            );
        si

        msbuild_formatter_drops_editor_only_hints() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);
            store.start_analysis();
            store.hint(loc("a.ghul", 5), "some-hint", "an editor-only hint");
            store.end_analysis();

            Assert.is_false(
                msbuild_format(store).contains("an editor-only hint"),
                "an editor-only hint must not reach a build log:\n{msbuild_format(store)}"
            );
        si

        msbuild_formatter_drops_inlay_carriers() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.set_open_files(["a.ghul"]);
            store.start_analysis();
            store.inlay(loc("a.ghul", 5), "narrowing-isa", "CAT", "narrowed to CAT");
            store.end_analysis();

            Assert.is_false(
                msbuild_format(store).contains("CAT"),
                "an inlay carrier is never published as a diagnostic:\n{msbuild_format(store)}"
            );
        si

        // Advice rides on a related location at the diagnostic's own
        // position, which is not somewhere to navigate to.
        msbuild_formatter_omits_the_location_of_a_same_position_related_entry() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(
                loc("a.ghul", 5),
                "== cannot be applied to values of type PAIR",
                loc("a.ghul", 5),
                "help: use =~ to compare by value");

            Assert.is_true(
                msbuild_format(store).contains("[help: use =~ to compare by value]"),
                "advice on the diagnostic's own position must render without a location:\n{msbuild_format(store)}"
            );
        si

        // The point of the format: MSBuild parses this shape and no other.
        // A line that does not match is logged as untyped message text, so
        // the build reports no error at the source position and counts no
        // warnings. Mirrors the grammar MSBuild's own parser accepts.
        msbuild_formatter_output_parses_as_msbuild_canonical() is
            @test()

            let canonical = "^[^(]+\\(\\d+,\\d+,\\d+,\\d+\\): (error|warning)( [a-z][a-z0-9-]*)?: .+$";

            let store = DIAGNOSTICS_STORE();

            store.error(LOCATION("a.ghul", 2, 9, 2, 37), "string is not assignable to int");
            store.warn(LOCATION("b.ghul", 11, 13, 11, 23), "cast-may-throw", "cast to non-optional CAT may throw");

            for line in msbuild_format(store).split(['\n']) do
                if line.length == 0 then
                    continue;
                fi

                Assert.is_true(
                    Regex.is_match(line, canonical),
                    "not in MSBuild canonical form, so MSBuild would log it as plain text: {line}"
                );
            od
        si

        related_locations_on_sentinel_locations_are_dropped() is
            @test()

            let store = DIAGNOSTICS_STORE();

            store.error(loc("a.ghul", 5), "redefining symbol X", LOCATION.reflected, "member declared here");
            store.warn(loc("a.ghul", 6), "some-code", "some message", LOCATION.unknown, "declared here");
            store.error(loc("a.ghul", 7), "must implement X", LOCATION.internal, "member declared here");

            let messages = LIST[DIAGNOSTIC_MESSAGE](store.diagnostics_for("a.ghul"));

            Assert.are_equal(3, messages.count);
            Assert.is_false(messages[0].related?, "a reflected related location must be dropped, not recorded");
            Assert.is_false(messages[1].related?, "an unknown related location must be dropped, not recorded");
            Assert.is_false(messages[2].related?, "an internal related location must be dropped, not recorded");
        si
    si
si
