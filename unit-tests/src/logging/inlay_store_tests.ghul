namespace Logging.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Ghul.Pipes

    use Logging.DIAGNOSTICS_STORE
    use Logging.INLAY_KINDS
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class INLAY_STORE_TESTS is
        init() is si

        loc(line: int) -> LOCATION => LOCATION("test.ghul", line, 1, line, 10)

        count_code(store: DIAGNOSTICS_STORE, code: string) -> int =>
            store.inlays_for("test.ghul") |> filter(i => i.code? /\ i.code!.starts_with(code)) |> count()

        // The kind gate and terminator recording sit on the Logger trait
        // with defaults, so the concrete store carries both its own
        // implementation and the default; a call on the concrete type is
        // ambiguous between them, so these tests go through the trait
        // view the way every production caller does.
        as_logger(store: DIAGNOSTICS_STORE) -> Logging.Logger => store

        @Test()
        inlays_live_outside_the_diagnostics_list() is
            let store = DIAGNOSTICS_STORE()

            store.inlay(loc(3), "narrowing-isa", "►", "CAT")

            are_equal(1, count_code(store, "narrowing"))
            are_equal(
                0,
                store.only.diagnostics_for("test.ghul") |> count(),
                "an inlay must not appear among the file's diagnostics"
            )
        si

        @Test()
        disabled_kind_is_never_recorded() is
            let store = DIAGNOSTICS_STORE()

            as_logger(store).disable_inlay_kind(INLAY_KINDS.NARROWING)

            store.inlay(loc(3), "narrowing-isa", "►", "CAT")
            store.inlay(loc(4), "definition-virtuality-get", "▪", "getter")
            store.inlay(loc(5), "some-unknown-code", "x", null)

            are_equal(0, count_code(store, "narrowing"), "a disabled kind is not collected")
            are_equal(1, count_code(store, "definition-virtuality"), "other kinds are unaffected")
            are_equal(1, count_code(store, "some-unknown-code"), "an ungated code is always collected")
        si

        @Test()
        terminator_boundaries_record_only_when_the_kind_is_enabled() is
            let store = DIAGNOSTICS_STORE()

            as_logger(store).note_inferred_terminator(loc(2))

            are_equal(0, as_logger(store).inferred_terminators_for("test.ghul").count, "the terminator kind is off by default")

            as_logger(store).enable_inlay_kind(INLAY_KINDS.TERMINATOR)
            as_logger(store).note_inferred_terminator(loc(2))

            let positions = as_logger(store).inferred_terminators_for("test.ghul")

            are_equal(1, positions.count)
            are_equal(2, LOCATION.line_of(positions[0]), "the packed position decodes back to the boundary's line")

            // A LOCATION's end column is inclusive, so the hint belongs one
            // to the right of the construct's last character - where the
            // `;` would have been written. loc() ends at column 10.
            are_equal(11, LOCATION.column_of(positions[0]), "the hint sits one past the construct's end")
        si

        @Test()
        reparse_clear_wipes_terminators_but_analysis_clear_keeps_them() is
            let store = DIAGNOSTICS_STORE()

            as_logger(store).enable_inlay_kind(INLAY_KINDS.TERMINATOR)
            as_logger(store).note_inferred_terminator(loc(2))
            as_logger(store).note_inferred_terminator(loc(5))

            // An analysis round clears only its own output; parse-time
            // records survive it, exactly as parse diagnostics do.
            store.start_analysis()
            store.clear("test.ghul", true)
            store.end_analysis()

            are_equal(2, as_logger(store).inferred_terminators_for("test.ghul").count)

            // The re-parse wipe clears everything for the path, and the
            // re-parse that always follows regenerates the boundaries.
            store.clear("test.ghul", false)

            are_equal(0, as_logger(store).inferred_terminators_for("test.ghul").count)
        si

        @Test()
        speculation_rolls_back_inlays_and_terminators_together() is
            let store = DIAGNOSTICS_STORE()

            as_logger(store).enable_inlay_kind(INLAY_KINDS.TERMINATOR)

            store.speculate()
            store.inlay(loc(3), "narrowing-isa", "►", "CAT")
            as_logger(store).note_inferred_terminator(loc(4))
            let discarded = store.roll_back()

            is_false(discarded.is_poisoned)
            are_equal(0, count_code(store, "narrowing"), "a backtracked parse leaves no inlays behind")
            are_equal(0, as_logger(store).inferred_terminators_for("test.ghul").count, "a backtracked parse leaves no boundaries behind")

            store.speculate()
            store.inlay(loc(6), "narrowing-isa", "►", "CAT")
            as_logger(store).note_inferred_terminator(loc(7))
            store.commit()

            are_equal(1, count_code(store, "narrowing"), "a committed speculation keeps its inlays")
            are_equal(1, as_logger(store).inferred_terminators_for("test.ghul").count, "a committed speculation keeps its boundaries")
        si

    si
si
