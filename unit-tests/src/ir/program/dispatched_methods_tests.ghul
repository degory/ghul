namespace IR.Program.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.TRAIT
    use Semantic.Symbols.Classy
    use Semantic.Symbols.INSTANCE_METHOD

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class DISPATCHED_METHODS_TESTS is
        // A trait `Sequence` with an `items` member, a trait `Stream` whose
        // own `items` overrides it, and a class implementing only
        // `Sequence`'s, as a generator's frame does. Separately, a class
        // method `speak` overridden in a subclass.
        _sequence_items: INSTANCE_METHOD
        _stream_items: INSTANCE_METHOD
        _frame_items: INSTANCE_METHOD

        _animal_speak: INSTANCE_METHOD
        _cat_speak: INSTANCE_METHOD

        init() is
            let sequence = _trait("Sequence")
            let stream = _trait("Stream")
            let frame = _class("FRAME")
            let animal = _class("ANIMAL")
            let cat = _class("CAT")

            _sequence_items = _method(sequence, "items")
            _stream_items = _method(stream, "items")
            _frame_items = _method(frame, "items")

            _stream_items.add_overridee(_sequence_items)
            _frame_items.add_overridee(_sequence_items)

            _animal_speak = _method(animal, "speak")
            _cat_speak = _method(cat, "speak")

            _cat_speak.add_overridee(_animal_speak)
        si

        _loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        _trait(name: string) -> TRAIT =>
            TRAIT(_loc(), _loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        _class(name: string) -> CLASS =>
            CLASS(_loc(), _loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        _method(owner: Classy, name: string) -> INSTANCE_METHOD =>
            INSTANCE_METHOD(_loc(), _loc(), owner, name, Semantic.BLOCK_SCOPE())

        @Test()
        note__a_trait_method__reaches_implementations_of_the_trait_method_it_overrides() is
            let dispatched = DISPATCHED_METHODS()

            dispatched.note(_stream_items)

            is_true(dispatched.is_dispatched_to(_frame_items))
        si

        @Test()
        note__a_trait_method__still_marks_itself_dispatched() is
            let dispatched = DISPATCHED_METHODS()

            dispatched.note(_stream_items)

            is_true(dispatched.is_dispatched_to(_stream_items))
            is_true(dispatched.is_dispatched_to(_sequence_items))
        si

        @Test()
        note__a_class_method__does_not_reach_the_method_it_overrides() is
            let dispatched = DISPATCHED_METHODS()

            dispatched.note(_cat_speak)

            is_true(dispatched.is_dispatched_to(_cat_speak))
            is_false(dispatched.is_dispatched_to(_animal_speak))
        si
    si
si
