namespace IR.Program.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.Symbol

    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins TYPE_MAPS.hash against TYPE_MAPS.same, and the instance hashes
    // built on it: maps that are the same hash alike, and instances of one
    // definition at different arguments do not share a hash.
    @TestClass()
    class TYPE_MAPS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        class_named(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        type_named(name: string) -> Type => class_named(name).type!

        @Test()
        hash__of_the_same_bindings_in_a_different_order__is_the_same() is
            let t = class_named("T")
            let u = class_named("U")
            let a = type_named("A")
            let b = type_named("B")

            let first = MAP[Symbol, Type]()
            first[t] = a
            first[u] = b

            let second = MAP[Symbol, Type]()
            second[u] = b
            second[t] = a

            is_true(TYPE_MAPS.same(first, second))
            are_equal(TYPE_MAPS.hash(first), TYPE_MAPS.hash(second))
        si

        @Test()
        hash__of_an_optional_argument__matches_the_non_optional_one_same_accepts() is
            let t = class_named("T")
            let a = type_named("A")

            let plain = MAP[Symbol, Type]()
            plain[t] = a

            let optional = MAP[Symbol, Type]()
            optional[t] = a.as_optional()

            is_true(TYPE_MAPS.same(plain, optional))
            are_equal(TYPE_MAPS.hash(plain), TYPE_MAPS.hash(optional))
        si

        @Test()
        hash__of_one_generic_specialized_twice_at_the_same_arguments__is_the_same() is
            let t = class_named("T")
            let list = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "LIST", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
            let a = type_named("A")

            let first_list = Semantic.Symbols.GENERIC(loc(), list, LIST[Type]([a])).type
            let second_list = Semantic.Symbols.GENERIC(loc(), list, LIST[Type]([a])).type

            is_false(first_list.symbol == second_list.symbol)

            let first = MAP[Symbol, Type]()
            first[t] = first_list

            let second = MAP[Symbol, Type]()
            second[t] = second_list

            is_true(TYPE_MAPS.same(first, second))
            are_equal(TYPE_MAPS.hash(first), TYPE_MAPS.hash(second))
        si

        @Test()
        class_instances__of_one_definition_at_different_arguments__hash_differently() is
            let definition = class_named("BOX")
            let t = class_named("T")
            let a = type_named("A")
            let b = type_named("B")

            let at_a = MAP[Symbol, Type]()
            at_a[t] = a

            let at_b = MAP[Symbol, Type]()
            at_b[t] = b

            let first = CLASS_INSTANCE(definition, LIST[Type]([a]), at_a)
            let second = CLASS_INSTANCE(definition, LIST[Type]([b]), at_b)

            is_false(first =~ second)
            are_not_equal(first.get_hash_code(), second.get_hash_code())
        si

        @Test()
        class_instances__that_are_equal__hash_alike() is
            let definition = class_named("BOX")
            let t = class_named("T")
            let a = type_named("A")

            let one = MAP[Symbol, Type]()
            one[t] = a

            let other = MAP[Symbol, Type]()
            other[t] = a

            let first = CLASS_INSTANCE(definition, LIST[Type]([a]), one)
            let second = CLASS_INSTANCE(definition, LIST[Type]([a]), other)

            is_true(first =~ second)
            are_equal(first.get_hash_code(), second.get_hash_code())
        si
    si
si
