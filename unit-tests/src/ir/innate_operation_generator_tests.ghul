namespace IR.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use System.Reflection.Metadata.ILOpCode;

    // The intrinsic operation name carries the signedness of the shift,
    // rather than it being re-derived from the operand types, matching
    // how `compare.order` and `compare.uorder` separate signed from
    // unsigned comparison. A right shift that reaches the signed opcode
    // on an unsigned operand propagates the sign bit and silently
    // returns a wrong value, so the two names are pinned here.
    class INNATE_OPERATION_GENERATOR_TESTS is
        @test()

        init() is si

        Calling__arithmetic_op_code__with_shr__gives_the_signed_shift() is
            @test()

            Assert.are_equal(ILOpCode.SHR, INNATE_OPERATION_GENERATOR._arithmetic_op_code("shr"));
        si

        Calling__arithmetic_op_code__with_ushr__gives_the_unsigned_shift() is
            @test()

            Assert.are_equal(ILOpCode.SHR_UN, INNATE_OPERATION_GENERATOR._arithmetic_op_code("ushr"));
        si

        Calling__arithmetic_op_code__with_shl__gives_the_left_shift() is
            @test()

            Assert.are_equal(ILOpCode.SHL, INNATE_OPERATION_GENERATOR._arithmetic_op_code("shl"));
        si
    si
si
