namespace IR.LLVMTarget.UnitTests is
    use LLVM.FUNCTION
    use LLVM.MODULE
    use LLVM.WRITER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class LLVM_STRINGS_TESTS is
        init() is si

        // FNV-1a over the code units, as string.get_hash_code computes it.
        @Test()
        hash__should_be_the_hash_string_get_hash_code_computes() is
            are_equal(1335831723, LLVM_STRINGS.hash("hello"))
            are_equal(-2128831035, LLVM_STRINGS.hash(""))
        si

        @Test()
        literal__the_same_text_twice__should_be_the_same_global() is
            let strings = LLVM_STRINGS(MODULE())

            are_equal(strings.literal("a"), strings.literal("a"))
            are_not_equal(strings.literal("a"), strings.literal("b"))
        si

        @Test()
        literal__should_hold_the_descriptor_hash_length_and_code_units() is
            let module = MODULE()
            let strings = LLVM_STRINGS(module)

            strings.literal("hé")

            let text = WRITER.module_text(module)

            is_true(text.contains("ptr @{LLVM_STRINGS.DESCRIPTOR_NAME}, i32 {LLVM_STRINGS.hash("hé")}, i32 2, [2 x i16] [i16 104, i16 233]"))
        si

        @Test()
        add_exports__should_define_the_functions_the_runtime_calls() is
            let module = MODULE()

            LLVM_STRINGS(module).add_exports()

            for name in [LLVM_STRINGS.MAKE_STRING_NAME] do
                let function = module.function_named(name)

                is_true(function?)
                is_false(function!.is_declaration)

                function.check()
            od
        si
    si
si
