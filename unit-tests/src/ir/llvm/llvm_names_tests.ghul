namespace IR.LLVMTarget.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.Function
    use Semantic.Symbols.STATIC_METHOD

    use IR.Program.FUNCTION_INSTANCE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class LLVM_NAMES_TESTS is
        _owner: CLASS

        init() is
            _owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](), Semantic.BLOCK_SCOPE())
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        method(name: string) -> Function =>
            STATIC_METHOD(loc(), loc(), _owner, name, Semantic.BLOCK_SCOPE())

        @Test()
        name_of__the_same_instance_twice__should_give_the_same_name() is
            let names = LLVM_NAMES()
            let a = method("a")

            are_equal(names.name_of(FUNCTION_INSTANCE.of(a)), names.name_of(FUNCTION_INSTANCE.of(a)))
        si

        @Test()
        name_of__two_instances_that_render_alike__should_give_the_second_a_suffix() is
            let names = LLVM_NAMES()

            let first = names.name_of(FUNCTION_INSTANCE.of(method("a")))
            let second = names.name_of(FUNCTION_INSTANCE.of(method("a")))

            are_not_equal(first, second)
            are_equal("{first}.1", second)
        si

        @Test()
        name_of__a_reserved_label__should_give_a_suffix() is
            let names = LLVM_NAMES()
            let a = FUNCTION_INSTANCE.of(method("a"))

            names.reserve(a.to_string())

            are_equal("{a}.1", names.name_of(a))
        si

        @Test()
        unique__a_label_asked_for_twice__should_give_the_second_a_suffix() is
            let names = LLVM_NAMES()

            are_equal("OWNER.$descriptor", names.unique("OWNER.$descriptor"))
            are_equal("OWNER.$descriptor.1", names.unique("OWNER.$descriptor"))
        si

        @Test()
        unique__a_function_name_already_given__should_not_give_it_again() is
            let names = LLVM_NAMES()
            let a = FUNCTION_INSTANCE.of(method("a"))
            let name = names.name_of(a)

            are_equal("{name}.1", names.unique(name))
        si

        @Test()
        unique__a_long_label__should_be_cut_before_the_suffix_is_added() is
            let names = LLVM_NAMES()
            let label = string('x', 200)
            let cut = string('x', LLVM_NAMES.MAX_LABEL_LENGTH)

            are_equal(cut, names.unique(label))
            are_equal("{cut}.1", names.unique(label))
        si

        @Test()
        shortened__should_not_split_a_surrogate_pair() is
            let label = "{string('x', LLVM_NAMES.MAX_LABEL_LENGTH - 1)}\uD83D\uDE00"

            are_equal(string('x', LLVM_NAMES.MAX_LABEL_LENGTH - 1), LLVM_NAMES.shortened(label))
        si

        @Test()
        literal_label__should_keep_letters_and_digits_and_write_anything_else_as_underscore() is
            are_equal("$literal.hello__world_42", LLVM_STRINGS.literal_label("hello, world 42"))
        si

        @Test()
        literal_label__a_long_literal__should_keep_its_first_24_code_units() is
            are_equal("$literal.abcdefghijklmnopqrstuvwx", LLVM_STRINGS.literal_label("abcdefghijklmnopqrstuvwxyz"))
        si
    si
si
