namespace IR.LLVMTarget.UnitTests is
    use LLVM.Types

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class LLVM_TYPES_TESTS is
        init() is si

        @Test()
        holds_pointer__should_find_a_pointer_however_deep_it_sits() is
            is_true(LLVM_TYPES.holds_pointer(Types.pointer))
            is_true(LLVM_TYPES.holds_pointer(Types.structure([Types.i32, Types.pointer])))
            is_true(LLVM_TYPES.holds_pointer(Types.structure([Types.i1, Types.structure([Types.i64, Types.pointer])])))
            is_true(LLVM_TYPES.holds_pointer(LLVM.Type.ARRAY(4, Types.structure([Types.pointer, Types.i32]))))
            is_true(LLVM_TYPES.holds_pointer(LLVM.Type.NAMED("opaque")))
        si

        @Test()
        holds_pointer__should_be_false_for_scalars_and_aggregates_of_them() is
            is_false(LLVM_TYPES.holds_pointer(Types.i32))
            is_false(LLVM_TYPES.holds_pointer(LLVM.Type.DOUBLE))
            is_false(LLVM_TYPES.holds_pointer(Types.structure([Types.i1, Types.i32])))
            is_false(LLVM_TYPES.holds_pointer(LLVM.Type.ARRAY(8, Types.i16)))
        si

        @Test()
        size_of__should_lay_fields_out_at_their_natural_alignment() is
            are_equal(1, LLVM_TYPES.size_of(Types.i1))
            are_equal(2, LLVM_TYPES.size_of(Types.i16))
            are_equal(8, LLVM_TYPES.size_of(Types.pointer))
            are_equal(8, LLVM_TYPES.size_of(Types.structure([Types.i1, Types.i32])))
            are_equal(16, LLVM_TYPES.size_of(Types.structure([Types.pointer, Types.i32])))
            are_equal(24, LLVM_TYPES.size_of(Types.structure([Types.i1, Types.pointer, Types.i16])))
            are_equal(12, LLVM_TYPES.size_of(LLVM.Type.ARRAY(3, Types.i32)))
        si
    si
si
