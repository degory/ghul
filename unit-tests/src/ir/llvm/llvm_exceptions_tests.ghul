namespace IR.LLVMTarget.UnitTests is
    use LLVM.FUNCTION
    use LLVM.MODULE
    use LLVM.PARAMETER
    use LLVM.Types
    use LLVM.WRITER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class LLVM_EXCEPTIONS_TESTS is
        init() is si

        @Test()
        add_report_unhandled__with_no_message_getter__should_write_the_type_name_alone() is
            let module = MODULE()

            LLVM_EXCEPTIONS.add_report_unhandled(module, LLVM_STRINGS(module), null)

            let function = module.function_named(LLVM_STRINGS.REPORT_UNHANDLED_NAME)

            is_true(function?)
            is_false(function!.is_declaration)

            function.check()

            is_false(WRITER.module_text(module).contains("call ptr @get_message"))
        si

        @Test()
        add_report_unhandled__with_a_message_getter__should_call_it_on_the_exception() is
            let module = MODULE()
            let getter = FUNCTION("get_message", Types.pointer, [PARAMETER(Types.pointer, "self")])

            LLVM_EXCEPTIONS.add_report_unhandled(module, LLVM_STRINGS(module), getter)

            module.function_named(LLVM_STRINGS.REPORT_UNHANDLED_NAME)!.check()

            is_true(WRITER.module_text(module).contains("call ptr @get_message(ptr %exception)"))
        si
    si
si
