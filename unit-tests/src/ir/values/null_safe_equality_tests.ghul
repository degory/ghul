namespace IR.Values.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use IR.RAW;
    use IR.Values.NULL_SAFE_EQUALITY;

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;

    // Tests for the IL lowering of `a =~ b` over optional references.
    // The three arms are the contract: two absent operands are equal,
    // one absent operand is not, and only two present ones reach the
    // operator's own call. Each operand is read more than once, so the
    // values handed in have to be repeatable loads rather than the
    // expressions themselves - the shape below is what makes that a
    // requirement rather than a preference.
    //
    // A regression here answers wrongly rather than crashing, and the
    // integration test can only reach one arm per comparison, so the
    // whole emitted shape is pinned in one place.
    class NULL_SAFE_EQUALITY_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        type_bool() -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), null, "bool", 0).type!;

        gen_to_string(value: IR.Values.Value) -> string is
            IR.LABEL.reset_id();

            let context = IR.CONTEXT(null, null);
            context.enter_buffer(false);
            value.gen(context);
            return context.leave_buffer();
        si

        make_value() -> NULL_SAFE_EQUALITY =>
            NULL_SAFE_EQUALITY(
                RAW("// left"),
                RAW("// right"),
                RAW("// equals"),
                type_bool()
            );

        Calling__gen__should_emit_the_three_presence_arms() is
            @test()

            // left absent  -> whether right is absent too
            // right absent -> false
            // both present -> the operator's own call
            Assert.are_equal(
                "// left\n"
                "brtrue L0\n"
                "// right\n"
                "ldnull\n"
                "ceq\n"
                "br L2\n"
                "L0:\n"
                "// right\n"
                "brtrue L1\n"
                "ldc.i4.0\n"
                "br L2\n"
                "L1:\n"
                "// equals\n"
                "L2:\n",
                gen_to_string(make_value())
            );
        si

        Calling__gen__should_read_each_operand_more_than_once() is
            @test()

            // Both operands are read by the presence tests and again by
            // the call, so COMPILE_OPERATORS spills anything that is not
            // already a repeatable load. Pinning the count here is what
            // makes dropping that spill a test failure rather than a
            // silently re-evaluated operand.
            let emitted = gen_to_string(make_value());

            Assert.are_equal(2, count_occurrences(emitted, "// right"));
            Assert.are_equal(1, count_occurrences(emitted, "// left"));
            Assert.are_equal(1, count_occurrences(emitted, "// equals"));
        si

        Calling__gen__should_branch_long_rather_than_short() is
            @test()

            // The call arm carries an arbitrary user body, so a short
            // branch offset could not always reach past it.
            let emitted = gen_to_string(make_value());

            Assert.are_equal(0, count_occurrences(emitted, "brtrue.s"));
            Assert.are_equal(0, count_occurrences(emitted, "br.s"));
        si

        NULL_SAFE_EQUALITY_should_type_as_bool() is
            @test()

            let bool_type = type_bool();

            let value =
                NULL_SAFE_EQUALITY(
                    RAW("// left"),
                    RAW("// right"),
                    RAW("// equals"),
                    bool_type
                );

            Assert.is_true(value.type?);
            Assert.are_same(bool_type, value.type);
        si

        NULL_SAFE_EQUALITY_should_not_be_lightweight_pure() is
            @test()

            // Composes a branching sequence, so a caller that gates on
            // is_lightweight_pure must not fold it away or re-evaluate
            // it.
            Assert.is_false(make_value().is_lightweight_pure);
        si

        count_occurrences(text: string, needle: string) -> int is
            let result mut = 0;
            let index mut = text.index_of(needle);

            while index >= 0 do
                result = result + 1;
                index = text.index_of(needle, index + needle.length);
            od

            return result;
        si
    si
si
