namespace IR.Values.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use IR.RAW;
    use IR.Values.NULL_SAFE_EQUALITY;

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;

    // Tests for the IL lowering of `a =~ b` over optional references.
    // The three arms are the contract: two absent operands are equal,
    // one absent operand is not, and only two present ones reach the
    // operator's own call. Each operand is read more than once, so the
    // values handed in have to be repeatable loads rather than the
    // expressions themselves - the shape below is what makes that a
    // requirement rather than a preference.
    //
    // A regression here answers wrongly rather than crashing, and the
    // integration test can only reach one arm per comparison, so the
    // whole emitted shape is pinned in one place.
    class NULL_SAFE_EQUALITY_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        type_bool() -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), null, "bool", 0).type!;

        gen_to_string(value: IR.Values.Value) -> string is
            IR.LABEL.reset_id();

            let context = IR.CONTEXT(null, null);
            context.enter_buffer(false);
            value.gen(context);
            return context.leave_buffer();
        si

        make_value(guards_argument: bool) -> NULL_SAFE_EQUALITY =>
            NULL_SAFE_EQUALITY(
                RAW("// left"),
                RAW("// right"),
                RAW("// equals"),
                guards_argument,
                type_bool()
            );

        // A presence child is absent when its operand is not optional,
        // which the value reads as always present.
        make_value(left_presence: IR.Values.Value?, right_presence: IR.Values.Value?) ->
            NULL_SAFE_EQUALITY =>
            NULL_SAFE_EQUALITY(
                left_presence,
                right_presence,
                RAW("// equals"),
                true,
                type_bool()
            );

        Calling__gen__when_guarding_the_argument_should_emit_three_arms() is
            @test()

            // left absent  -> whether right is absent too
            // right absent -> false
            // both present -> the operator's own call
            Assert.are_equal(
                "// left\n"
                "brtrue L0\n"
                "// right\n"
                "ldc.i4.0\n"
                "ceq\n"
                "br L2\n"
                "L0:\n"
                "// right\n"
                "brtrue L1\n"
                "ldc.i4.0\n"
                "br L2\n"
                "L1:\n"
                "// equals\n"
                "L2:\n",
                gen_to_string(make_value(true))
            );
        si

        Calling__gen__when_not_guarding_the_argument_should_only_test_the_left() is
            @test()

            // An operator declaring its parameter optional answers for
            // an absent argument itself, so the argument arm is not
            // emitted and the call is reached with the right operand as
            // it stands. The left arm stays: an absent receiver has
            // nothing to dispatch on, so it can never be the operator's
            // decision.
            Assert.are_equal(
                "// left\n"
                "brtrue L0\n"
                "// right\n"
                "ldc.i4.0\n"
                "ceq\n"
                "br L2\n"
                "L0:\n"
                "// equals\n"
                "L2:\n",
                gen_to_string(make_value(false))
            );
        si

        Calling__gen__when_guarding_the_argument_should_emit_the_right_operand_twice() is
            @test()

            // Why the caller has to hand over repeatable loads rather
            // than the operand expressions: this value emits its right
            // child once for the argument arm and once inside the call.
            // Whether the caller actually spills is not observable from
            // here, since these children are stand-ins - the
            // integration test covers that end.
            let emitted = gen_to_string(make_value(true));

            Assert.are_equal(2, count_occurrences(emitted, "// right"));
            Assert.are_equal(1, count_occurrences(emitted, "// left"));
            Assert.are_equal(1, count_occurrences(emitted, "// equals"));
        si

        Calling__gen__should_branch_long_rather_than_short() is
            @test()

            // The call arm carries an arbitrary user body, so a short
            // branch offset could not always reach past it.
            let emitted = gen_to_string(make_value(true));

            Assert.are_equal(0, count_occurrences(emitted, "brtrue.s"));
            Assert.are_equal(0, count_occurrences(emitted, "br.s"));
        si

        Calling__gen__with_a_non_optional_left_should_omit_the_receiver_arm() is
            @test()

            // Nothing to test on the left, so the comparison starts at
            // the argument arm.
            Assert.are_equal(
                "// right\n"
                "brtrue L1\n"
                "ldc.i4.0\n"
                "br L2\n"
                "L1:\n"
                "// equals\n"
                "L2:\n",
                gen_to_string(make_value(null, RAW("// right")))
            );
        si

        Calling__gen__with_a_non_optional_right_should_answer_false_for_an_absent_left() is
            @test()

            // A right operand that can never be absent does not match
            // an absent left one, so that arm is the constant rather
            // than a test.
            Assert.are_equal(
                "// left\n"
                "brtrue L0\n"
                "ldc.i4.0\n"
                "br L2\n"
                "L0:\n"
                "// equals\n"
                "L2:\n",
                gen_to_string(make_value(RAW("// left"), null))
            );
        si

        NULL_SAFE_EQUALITY_should_type_as_bool() is
            @test()

            let bool_type = type_bool();

            let value =
                NULL_SAFE_EQUALITY(
                    RAW("// left"),
                    RAW("// right"),
                    RAW("// equals"),
                    true,
                    bool_type
                );

            Assert.is_true(value.type?);
            Assert.are_same(bool_type, value.type);
        si

        NULL_SAFE_EQUALITY_should_not_be_lightweight_pure() is
            @test()

            // Composes a branching sequence, so a caller that gates on
            // is_lightweight_pure must not fold it away or re-evaluate
            // it.
            Assert.is_false(make_value(true).is_lightweight_pure);
        si

        count_occurrences(text: string, needle: string) -> int is
            let result mut = 0;
            let index mut = text.index_of(needle);

            while index >= 0 do
                result = result + 1;
                index = text.index_of(needle, index + needle.length);
            od

            return result;
        si
    si
si
