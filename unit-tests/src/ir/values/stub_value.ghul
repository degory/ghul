namespace IR.UnitTests.Support is
    use Semantic.Types.Type;
    use TypeTyped = Semantic.Types.Typed;

    // A `Value` standing in for an operand a test does not care about.
    //
    // Tests that assert how a composite value types itself need operands
    // to build it from, and nothing more: the operand's own type is read,
    // its encoding never is. Constructing a real value of the right shape
    // would tie the test to how that shape is built.
    @suppress("non-snake-case-name")
    STUB_VALUE(type: Type) -> Values.Value => Values.DUMMY(type, Source.LOCATION.internal);

    @suppress("non-snake-case-name")
    STUB_VALUE() -> Values.Value => STUB_VALUE(Semantic.Types.ERROR());
si
