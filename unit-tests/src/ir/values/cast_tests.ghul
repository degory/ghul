namespace IR.Values.UnitTests is
    use IR.UnitTests.Support.STUB_VALUE;
    use System.Reflection.Metadata.ILOpCode;

    use IR.UnitTests.EMITTED_IL;
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use IR.Values.CAST;

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // RAW always types as Semantic.Types.ERROR (a reference type), so testing
    @TestClass()
    class CAST_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        type_named(name: string, index: int) -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), name, index).type!;

        // A class rather than a type parameter: a type variable can be
        // instantiated at a value type, so a checked cast to one still
        // declines and would not tell the two apart.
        class_type(name: string) -> Semantic.Types.Type is
            let c =
                Semantic.Symbols.CLASS(
                    loc(),
                    loc(),
                    Semantic.BLOCK_SCOPE(),
                    name,
                    Collections.LIST[string](),
                    Semantic.BLOCK_SCOPE());

            c.set_type(Semantic.Types.NAMED(c));

            return c.type!;
        si

        // CAST's branches key on the inner value's is_value_type,
        // which a DUMMY derives from its type: a class-typed dummy is
        // a reference inner, and a type-parameter-typed one a value
        // inner - a GenericArgument reports is_value_type
        // unconditionally, and encodes as an index rather than
        // needing a resolvable type reference.
        reference_inner(name: string) -> IR.Values.Value =>
            IR.Values.DUMMY(class_type(name), loc());

        value_inner(name: string) -> IR.Values.Value =>
            IR.Values.DUMMY(type_named(name, 0), loc());


        @Test()
        Calling__gen__on_reference_inner__should_emit_isinst_only_no_box() is
            let inner = reference_inner("R");
            let value = CAST(type_named("T", 1), inner, false);

            // Reference inner: emit value, then `isinst T`. No pre-box —
            // `box` on a reference produces invalid IL.
            EMITTED_IL.assert_emits_token_instructions([ILOpCode.ISINST], value);
        si

        @Test()
        Calling__gen__on_value_type_inner__should_emit_box_then_isinst() is
            let inner = value_inner("V");
            let value = CAST(type_named("T", 1), inner, false);

            // Value-type inner: must box before `isinst`. The conditional
            // pre-box is the contract worth pinning — a refactor that
            // unconditionally emits or unconditionally skips it produces
            // invalid IL on one side or the other.
            EMITTED_IL.assert_emits_token_instructions([ILOpCode.BOX, ILOpCode.ISINST], value);
        si

        // A cast the program wrote faults when it fails, so it emits
        // `castclass` where a compiler-synthesised coercion emits `isinst`
        // and declines. Everything that reads the result of a refutable
        // test — `if let`, a `case` arm, the narrowing branch, the union
        // equality bridge — depends on being on the declining side, so the
        // two are pinned against each other rather than singly.
        @Test()
        faults_on_failure__on_a_checked_cast_to_a_reference__is_true() is
            let inner = reference_inner("R");

            is_true(CAST(class_type("T"), inner, true).faults_on_failure);
        si

        @Test()
        faults_on_failure__on_an_unchecked_cast_to_a_reference__is_false() is
            let inner = reference_inner("R");

            is_false(CAST(class_type("T"), inner, false).faults_on_failure);
        si

        // `cast T?(v)` is how a cast that is allowed to fail is written, so
        // an optional target declines however the cast was written.
        @Test()
        faults_on_failure__on_a_checked_cast_to_an_optional__is_false() is
            let inner = reference_inner("R");

            is_false(CAST(class_type("T").as_optional(), inner, true).faults_on_failure);
        si

        // A type variable can be instantiated at a value type, and a
        // value-type target's unbox is conditional on the result being
        // absent - so neither can fault however the cast was written.
        @Test()
        faults_on_failure__on_a_checked_cast_to_a_type_variable__is_false() is
            let inner = reference_inner("R");

            is_false(CAST(type_named("T", 1), inner, true).faults_on_failure);
        si
    si
si
