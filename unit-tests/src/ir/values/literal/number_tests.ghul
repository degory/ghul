namespace IR.Values.Literal.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use IR.Values.Literal.NUMBER;
    use IR.Values.Literal.CONSTANT;
    use System.Reflection.Metadata.ILOpCode;

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;

    class NUMBER_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        type_int() -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), null, "int", 0).type!;

        Calling__constant__on_an_int_literal__carries_it_at_int32_width() is
            @test()

            let value = NUMBER(42, type_int());

            Assert.is_true(isa CONSTANT.I4(value.constant));
            Assert.are_equal(42, (cast CONSTANT.I4(value.constant)).value);
            Assert.is_null(value.conv);
        si

        Calling__conv__when_one_is_given__narrows_the_loaded_constant() is
            @test()

            // The load width and the literal's declared type need not
            // agree: a word literal loads at int64 and is narrowed to
            // the platform width by the conversion carried here.
            let value = NUMBER(CONSTANT.I8(42L), type_int(), ILOpCode.CONV_I);

            Assert.are_equal(ILOpCode.CONV_I, value.conv);
        si

        Calling__is_real__distinguishes_the_float_variants() is
            @test()

            Assert.is_false(NUMBER(42, type_int()).is_real);
            Assert.is_false(NUMBER(42L, type_int()).is_real);
            Assert.is_true(NUMBER(cast single(1.5), type_int()).is_real);
            Assert.is_true(NUMBER(1.5D, type_int()).is_real);
        si

        is_lightweight_pure__should_be_true() is
            @test()

            // Number literals are pure — no side effects, no shared state.
            // Value.get_temp_copier uses this to avoid materialising a TEMP
            // for the same literal, returning the literal directly instead.
            // A regression to false would emit redundant locals.
            let value = NUMBER(42, type_int());

            Assert.is_true(value.is_lightweight_pure);
        si
    si
si
