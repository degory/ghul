namespace IR.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    class CONTEXT_TESTS is
        @test()

        init() is si

        loc(start_line: int, start_column: int, end_line: int, end_column: int) -> LOCATION =>
            LOCATION("test.ghul", start_line, start_column, end_line, end_column);

        line_directive_count(text: string) -> int =>
            text.split(['\n']) | .filter(l => l.starts_with(".line")) .count();

        Calling__mark_location__twice_with_same_line_and_column__should_emit_one_directive() is
            @test()

            let flags = IoC.CONTAINER.instance.build_flags;
            let previous = flags.want_debug;
            flags.want_debug = true;

            try
                let context = IR.CONTEXT(null, null);
                context.enter_buffer(false);

                context.mark_location(loc(4, 5, 4, 10));
                context.mark_location(loc(4, 5, 4, 10));

                Assert.are_equal(1, line_directive_count(context.leave_buffer()));
            finally
                flags.want_debug = previous;
            yrt
        si

        Calling__mark_location__twice_on_same_line_different_column__should_emit_both_directives() is
            @test()

            // Two distinct constructs sharing a source line (e.g. both
            // arms of `if c then a else b fi` written on one line) each
            // need their own sequence point — a dedup keyed on line
            // alone would silently drop the second.
            let flags = IoC.CONTAINER.instance.build_flags;
            let previous = flags.want_debug;
            flags.want_debug = true;

            try
                let context = IR.CONTEXT(null, null);
                context.enter_buffer(false);

                context.mark_location(loc(4, 5, 4, 10));
                context.mark_location(loc(4, 15, 4, 20));

                Assert.are_equal(2, line_directive_count(context.leave_buffer()));
            finally
                flags.want_debug = previous;
            yrt
        si

        Calling__reset_line_tracking__should_re_emit_same_position() is
            @test()

            // The first statement of a new method body must always get
            // its own `.line`, even when it sits at the exact source
            // position the previous method's last mark left behind.
            let flags = IoC.CONTAINER.instance.build_flags;
            let previous = flags.want_debug;
            flags.want_debug = true;

            try
                let context = IR.CONTEXT(null, null);
                context.enter_buffer(false);

                context.mark_location(loc(4, 5, 4, 10));
                context.reset_line_tracking();
                context.mark_location(loc(4, 5, 4, 10));

                Assert.are_equal(2, line_directive_count(context.leave_buffer()));
            finally
                flags.want_debug = previous;
            yrt
        si
    si
si
