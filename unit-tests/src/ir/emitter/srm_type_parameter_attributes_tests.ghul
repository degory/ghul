namespace IR.Emitter.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use System.Reflection.GenericParameterAttributes;

    use IR.Emitter.SRM_FLAGS;
    use Semantic.Types.TypeVariance;
    use Semantic.Symbols.TypeParameterConstraintKind;

    // Tests for the flags a GenericParam row carries.
    //
    // Asserted here rather than through an emitted assembly because
    // most of what they say has no in-language consequence to observe:
    // a dropped variance flag only shows when a *consumer* assigns
    // across the parameter, and ghul cannot construct from a type
    // parameter at all, so the constructor flag is read back by an
    // importing compiler and by nothing else. A flag left off is
    // therefore silent in this assembly and wrong in the next one.
    class SRM_TYPE_PARAMETER_ATTRIBUTES_TESTS is
        @test()

        init() is si

        _attributes(
            variance: TypeVariance,
            kind: TypeParameterConstraintKind,
            has_constructor_constraint: bool
        ) -> int static =>
            cast int(
                SRM_FLAGS.type_parameter_attributes(
                    variance, kind, has_constructor_constraint));

        An_unconstrained_invariant_parameter_carries_no_flags() is
            @test()

            Assert.are_equal(
                0,
                _attributes(
                    TypeVariance.INVARIANT, TypeParameterConstraintKind.NONE, false));
        si

        Variance_is_carried() is
            @test()

            Assert.are_equal(
                1,
                _attributes(
                    TypeVariance.COVARIANT, TypeParameterConstraintKind.NONE, false));

            Assert.are_equal(
                2,
                _attributes(
                    TypeVariance.CONTRAVARIANT, TypeParameterConstraintKind.NONE, false));
        si

        A_kind_constraint_is_carried() is
            @test()

            Assert.are_equal(
                4,
                _attributes(
                    TypeVariance.INVARIANT, TypeParameterConstraintKind.REFERENCE, false));

            Assert.are_equal(
                8,
                _attributes(
                    TypeVariance.INVARIANT, TypeParameterConstraintKind.VALUE, false));
        si

        // OPTIONAL says what the parameter can hold rather than which
        // kind of type it is, and the CLR has nothing to say it with.
        An_optional_constraint_is_not_carried() is
            @test()

            Assert.are_equal(
                0,
                _attributes(
                    TypeVariance.INVARIANT, TypeParameterConstraintKind.OPTIONAL, false));
        si

        An_init_constraint_is_carried() is
            @test()

            Assert.are_equal(
                16,
                _attributes(
                    TypeVariance.INVARIANT, TypeParameterConstraintKind.NONE, true));
        si

        // `[T: class init]` and the variance of a trait's own parameter
        // occupy different bits and combine.
        Flags_combine() is
            @test()

            Assert.are_equal(
                4 | 16,
                _attributes(
                    TypeVariance.INVARIANT, TypeParameterConstraintKind.REFERENCE, true));

            Assert.are_equal(
                1 | 8,
                _attributes(
                    TypeVariance.COVARIANT, TypeParameterConstraintKind.VALUE, false));
        si
    si
si
