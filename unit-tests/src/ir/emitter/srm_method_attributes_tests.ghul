namespace IR.Emitter.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use IR.Emitter.SRM_FLAGS;
    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.INSTANCE_METHOD;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for the flags a MethodDef row carries, and specifically for
    // the one fact that a constructor is never virtual.
    //
    // The symbol answers `is_virtual` for a constructor as it does for
    // any other instance method - ghul has no non-virtual instance
    // method to distinguish it from - so anything asking "could this be
    // overridden?" has to know that a constructor is the exception. It
    // is reached through the type it constructs, so there is no slot for
    // a subclass to take over, and the runtime rejects the combination.
    // Asserted here because the emitted flag word is where that becomes
    // true, and a caller reasoning about overridability is trusting it.
    @TestClass()
    class SRM_METHOD_ATTRIBUTES_TESTS is
        init() is si

        _VIRTUAL: int static => 64;

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        make_method(name: string) -> INSTANCE_METHOD is
            let owner =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](), Semantic.BLOCK_SCOPE());

            return INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE());
        si

        _is_virtual(name: string) -> bool is
            let flags = cast int(SRM_FLAGS.method_attributes(make_method(name)));

            return (flags & _VIRTUAL) == _VIRTUAL;
        si

        @Test()
        An_ordinary_instance_method_is_emitted_virtual() is
            is_true(_is_virtual("do_something"));
        si

        @Test()
        A_constructor_is_not_emitted_virtual() is
            is_false(_is_virtual("init"));
        si

        @Test()
        A_constructor_reports_itself_virtual_as_a_symbol() is
            let ctor = make_method("init");

            is_true(ctor.is_constructor);

            // The symbol-level answer, which is why a caller asking
            // about overridability cannot read `is_virtual` alone.
            is_true(ctor.is_virtual);
        si
    si
si
