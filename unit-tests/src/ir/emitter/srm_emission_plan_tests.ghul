namespace IR.Emitter.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.Field;
    use Semantic.Symbols.Function;
    use Semantic.Symbols.INSTANCE_FIELD;

    use IR.Emitter.SRM_EMISSION_PLAN;
    use IR.Emitter.SRM_EMITTED_TYPE;

    // The plan exists so the pass that writes rows replays the pass
    // that numbered them, rather than deriving the same sequence a
    // second time from a symbol table that has changed in between.
    // What it therefore has to guarantee is that what comes out is
    // exactly what went in, in the order it went in: a plan that
    // reordered or deduplicated its entries would hand the writing
    // pass a sequence the numbering pass never used, which run-style
    // tables accept without complaint and load with members reparented
    // onto the wrong type.
    class SRM_EMISSION_PLAN_TESTS is
        @test()

        init() is si

        at(line: int) -> LOCATION => LOCATION("test.ghul", line, 1, line, 8);

        a_class(line: int, name: string) -> CLASS =>
            CLASS(at(line), at(line), null, name, Collections.LIST[string](), null);

        no_methods() -> Collections.List[Function] => Collections.LIST[Function]();

        Types__are_handed_back_in_the_order_they_were_added() is
            @test()

            let plan = SRM_EMISSION_PLAN();

            // Added last-declared-first, so an implementation that
            // sorted by anything at all would disagree.
            let later = a_class(20, "LATER");
            let earlier = a_class(10, "EARLIER");

            plan.add(SRM_EMITTED_TYPE(later), Collections.LIST[Field](), no_methods());
            plan.add(SRM_EMITTED_TYPE(earlier), Collections.LIST[Field](), no_methods());

            Assert.are_equal(2, plan.types.count);
            Assert.are_same(later, plan.types[0].type.declared);
            Assert.are_same(earlier, plan.types[1].type.declared);
        si

        Members__are_the_ones_the_type_was_numbered_for() is
            @test()

            let owner = a_class(1, "OWNER");

            let first = INSTANCE_FIELD(at(10), owner, "first");
            let second = INSTANCE_FIELD(at(20), owner, "second");

            let fields = Collections.LIST[Field]();
            fields.add(first);
            fields.add(second);

            let plan = SRM_EMISSION_PLAN();
            plan.add(SRM_EMITTED_TYPE(owner), fields, no_methods());

            let planned = plan.types[0];

            Assert.are_equal(2, planned.fields.count);
            Assert.are_same(first, planned.fields[0]);
            Assert.are_same(second, planned.fields[1]);
        si

        // Two entries for one type is not a shape the walk produces,
        // but a plan that collapsed them would drop a member run the
        // numbering pass had already counted.
        Types__added_twice__are_two_entries() is
            @test()

            let owner = a_class(1, "OWNER");

            let plan = SRM_EMISSION_PLAN();

            plan.add(SRM_EMITTED_TYPE(owner), Collections.LIST[Field](), no_methods());
            plan.add(SRM_EMITTED_TYPE(owner), Collections.LIST[Field](), no_methods());

            Assert.are_equal(2, plan.types.count);
        si

        Types__on_a_fresh_plan__is_empty() is
            @test()

            Assert.are_equal(0, SRM_EMISSION_PLAN().types.count);
        si
    si
si
