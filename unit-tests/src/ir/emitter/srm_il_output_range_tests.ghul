namespace IR.Emitter.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use IR.Emitter.SRM_METHOD_BODY_EMITTER;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for the instruction ranges an `@IL.output` region records.
    //
    // The offsets are asserted against the body's own encoded length
    // rather than against literal byte positions, so the tests say "the
    // range covers exactly the instructions emitted inside it" rather
    // than restating how wide any particular instruction happens to
    // encode - which is a property of the encoder, not of this.
    @TestClass()
    class SRM_IL_OUTPUT_RANGE_TESTS is
        init() is si

        @Test()
        Calling__end_il_output__should_record_the_range_the_region_emitted() is
            let body = SRM_METHOD_BODY_EMITTER();

            // Something ahead of the region, so a range that started at
            // zero regardless would be caught.
            body.ldc_i4(1);

            let start = body.encoded.count;

            body.begin_il_output("il.out", 7);

            body.ldc_i4(2);
            body.ldc_i4(3);

            body.end_il_output();

            let end = body.encoded.count;

            let outputs = body.il_outputs;

            is_true(outputs?, "expected a recorded range");

            let ranges = outputs!;

            are_equal(1, ranges.count);

            are_equal(start, ranges[0].start_offset);
            are_equal(end, ranges[0].end_offset);
            are_equal(7, ranges[0].sequence);
            are_equal("il.out", ranges[0].path);
        si

        @Test()
        Calling__end_il_output__on_consecutive_regions__should_record_each() is
            let body = SRM_METHOD_BODY_EMITTER();

            body.begin_il_output("il.out", 1);
            body.ldc_i4(1);
            body.end_il_output();

            let between = body.encoded.count;

            body.begin_il_output("il.out", 2);
            body.ldc_i4(2);
            body.end_il_output();

            let outputs = body.il_outputs!;

            are_equal(2, outputs.count);

            // The second region starts where the first ended: a range
            // that reset, or that swallowed its predecessor, would not.
            are_equal(0, outputs[0].start_offset);
            are_equal(between, outputs[0].end_offset);
            are_equal(between, outputs[1].start_offset);
            are_equal(body.encoded.count, outputs[1].end_offset);
        si

        @Test()
        Calling__end_il_output__on_nested_regions__should_close_innermost_first() is
            let body = SRM_METHOD_BODY_EMITTER();

            body.begin_il_output("outer.out", 1);
            body.ldc_i4(1);

            let inner_start = body.encoded.count;

            body.begin_il_output("inner.out", 2);
            body.ldc_i4(2);
            body.end_il_output();

            let inner_end = body.encoded.count;

            body.ldc_i4(3);
            body.end_il_output();

            let outputs = body.il_outputs!;

            are_equal(2, outputs.count);

            // The inner region closes first, so it is recorded first,
            // and the outer one still spans the whole of it.
            are_equal("inner.out", outputs[0].path);
            are_equal(inner_start, outputs[0].start_offset);
            are_equal(inner_end, outputs[0].end_offset);

            are_equal("outer.out", outputs[1].path);
            are_equal(0, outputs[1].start_offset);
            are_equal(body.encoded.count, outputs[1].end_offset);
        si

        @Test()
        Reading__il_outputs__with_no_region__should_be_absent() is
            let body = SRM_METHOD_BODY_EMITTER();

            body.ldc_i4(1);

            // A method marking nothing carries no attribute, which is
            // what the absent list means to the structure walk.
            is_false(body.il_outputs?);
        si
    si
si
