namespace Driver.UnitTests is
    use Collections.LIST
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class NEXT_FLAG_VALUE_TESTS is
        init() is si

        @Test()
        Calling__next_flag_value__should_return_the_next_argument_trimmed() is
            let arguments = LIST[string](["--version", " 1.2.3 "]).iterator

            arguments.move_next()

            are_equal("1.2.3", Driver.MAIN.next_flag_value(arguments, "--version"))
        si

        // A flag given last has no value to take; that is reported as bad
        // input naming the flag, not a null dereference.
        @Test()
        Calling__next_flag_value__with_nothing_left__should_report_the_flag() is
            let arguments = LIST[string](["--version"]).iterator

            arguments.move_next()

            try
                Driver.MAIN.next_flag_value(arguments, "--version")

                fail("expected an INPUT_EXCEPTION")
            catch e: Driver.INPUT_EXCEPTION
                are_equal("--version needs a value", e.message)
            yrt
        si
    si
si
