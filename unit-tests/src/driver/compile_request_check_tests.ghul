namespace Driver.UnitTests is
    use Collections.LIST

    use IO.File
    use IO.Path

    use Analysis.Protocol.COMPILE_REQUEST
    use Driver.COMPILE_REQUEST_CHECK

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins what a compile request must carry before the compile server
    // acts on it, and the file name its diagnostics use.
    @TestClass()
    class COMPILE_REQUEST_CHECK_TESTS is
        init() is si

        existing_file() -> string is
            let path = Path.get_temp_file_name()

            File.write_all_text(path, "let x = 1\n")

            return path
        si

        request(name: string, source: string?, text: string?, output: string, references: LIST[string]) -> COMPILE_REQUEST =>
            COMPILE_REQUEST(name, source, text, output, references)

        @Test()
        problem_with__a_complete_request__is_none() is
            is_null(COMPILE_REQUEST_CHECK.problem_with(request("cell1", existing_file(), null, "cell1.dll", LIST[string]())))
        si

        @Test()
        problem_with__inline_text__needs_no_source_file() is
            is_null(COMPILE_REQUEST_CHECK.problem_with(request("cell1", null, "let x = 1\n", "cell1.dll", LIST[string]())))
        si

        @Test()
        problem_with__no_name__is_reported() is
            is_not_null(COMPILE_REQUEST_CHECK.problem_with(request("", existing_file(), null, "cell1.dll", LIST[string]())))
        si

        @Test()
        problem_with__no_output__is_reported() is
            is_not_null(COMPILE_REQUEST_CHECK.problem_with(request("cell1", existing_file(), null, "", LIST[string]())))
        si

        @Test()
        problem_with__neither_source_nor_text__is_reported() is
            is_not_null(COMPILE_REQUEST_CHECK.problem_with(request("cell1", null, null, "cell1.dll", LIST[string]())))
        si

        @Test()
        problem_with__a_missing_source_file__is_reported() is
            is_not_null(COMPILE_REQUEST_CHECK.problem_with(request("cell1", "/no/such/file.ghul", null, "cell1.dll", LIST[string]())))
        si

        @Test()
        problem_with__a_missing_reference__is_reported() is
            is_not_null(COMPILE_REQUEST_CHECK.problem_with(request("cell1", existing_file(), null, "cell1.dll", LIST[string](["/no/such/reference.dll"]))))
        si

        @Test()
        source_path__for_inline_text__is_named_after_the_cell() is
            are_equal("cell7.ghul", COMPILE_REQUEST_CHECK.source_path(request("cell7", null, "let x = 1\n", "cell7.dll", LIST[string]())))
        si

        @Test()
        source_path__for_a_source_file__is_that_file() is
            are_equal("/work/cell7.ghul", COMPILE_REQUEST_CHECK.source_path(request("cell7", "/work/cell7.ghul", null, "cell7.dll", LIST[string]())))
        si
    si
si
