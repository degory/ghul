namespace Driver.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pins SDK_REFERENCE_PATH_RESOLVER's contract: the target-framework moniker
    // it will and won't derive a pack version from, the walk from the runtime
    // directory up to the install root, and an end-to-end resolution against
    // the SDK this test is running on.
    @TestClass()
    class SDK_REFERENCE_PATH_RESOLVER_TESTS is
        init() is si

        resolver() -> Driver.SDK_REFERENCE_PATH_RESOLVER =>
            Driver.SDK_REFERENCE_PATH_RESOLVER();

        separator() -> char => IO.Path.directory_separator_char;

        @Test()
        framework_version_strips_the_net_prefix() is
            are_equal("10.0", resolver().framework_version("net10.0"));
        si

        @Test()
        framework_version_rejects_a_moniker_that_is_not_net_plus_a_version() is
            // "netstandard2.1" would otherwise glob for "standard2.1.*"
            is_null(resolver().framework_version("netstandard2.1"));
            is_null(resolver().framework_version("netcoreapp3.1"));
        si

        @Test()
        framework_version_rejects_a_moniker_too_short_to_slice() is
            // shorter than the prefix: substring would throw rather than answer
            is_null(resolver().framework_version("net"));
            is_null(resolver().framework_version(""));
        si

        @Test()
        is_separator_accepts_both_of_the_platforms_separators() is
            is_true(resolver().is_separator(IO.Path.directory_separator_char));
            is_true(resolver().is_separator(IO.Path.alt_directory_separator_char));
            is_false(resolver().is_separator('x'));
        si

        @Test()
        strip_trailing_separators_removes_every_trailing_separator() is
            let sep = separator();

            are_equal("{sep}a{sep}b", resolver().strip_trailing_separators("{sep}a{sep}b{sep}{sep}"));
            are_equal("{sep}a{sep}b", resolver().strip_trailing_separators("{sep}a{sep}b"));
            are_equal("", resolver().strip_trailing_separators("{sep}{sep}"));
        si

        @Test()
        install_root_goes_up_three_levels_from_the_runtime_directory() is
            let sep = separator();

            let runtime_directory =
                "{sep}usr{sep}lib{sep}dotnet{sep}shared{sep}Microsoft.NETCore.App{sep}10.0.10";

            are_equal(
                "{sep}usr{sep}lib{sep}dotnet",
                resolver().install_root_from_runtime_directory(runtime_directory));
        si

        @Test()
        install_root_ignores_a_trailing_separator() is
            let sep = separator();

            // the runtime directory arrives with one; left in place it costs a level
            let runtime_directory =
                "{sep}usr{sep}lib{sep}dotnet{sep}shared{sep}Microsoft.NETCore.App{sep}10.0.10{sep}";

            are_equal(
                "{sep}usr{sep}lib{sep}dotnet",
                resolver().install_root_from_runtime_directory(runtime_directory));
        si

        @Test()
        install_root_is_null_above_the_filesystem_root() is
            let sep = separator();

            is_null(resolver().install_root_from_runtime_directory("{sep}"));
            is_null(resolver().install_root_from_runtime_directory(""));
        si

        @Test()
        resolve_under_is_null_for_a_root_with_no_packs() is
            let empty = IO.Path.join(IO.Path.get_temp_path(), System.Guid.new_guid().to_string());

            IO.Directory.create_directory(empty);

            try
                is_null(resolver().resolve_under(empty, "net10.0"));
            finally
                IO.Directory.delete(empty, true);
            yrt
        si

        // The whole path the bare-invocation feature depends on, against the
        // SDK this test is running on: the reference directory has to exist and
        // hold the assemblies the compiler loads by default.
        @Test()
        resolve_finds_the_reference_assemblies_of_the_running_sdk() is
            let reference_path = resolver().resolve("net10.0");

            is_not_null(reference_path);
            is_true(IO.Directory.exists(reference_path!));
            is_true(IO.File.exists(IO.Path.join(reference_path, "System.Runtime.dll")));
            is_true(IO.File.exists(IO.Path.join(reference_path, "System.Console.dll")));
        si

        @Test()
        resolve_is_null_for_a_moniker_with_no_pack_layout() is
            is_null(resolver().resolve("netstandard2.1"));
        si
    si
si
