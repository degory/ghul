namespace Driver.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // Pins SDK_REFERENCE_PATH_RESOLVER's contract: the target-framework moniker
    // it will and won't derive a pack version from, the walk from the runtime
    // directory up to the install root, and an end-to-end resolution against
    // the SDK this test is running on.
    class SDK_REFERENCE_PATH_RESOLVER_TESTS is
        @test()

        init() is si

        resolver() -> Driver.SDK_REFERENCE_PATH_RESOLVER =>
            Driver.SDK_REFERENCE_PATH_RESOLVER();

        separator() -> char => IO.Path.directory_separator_char;

        Calling__framework_version__should_strip_the_net_prefix() is
            @test()

            Assert.are_equal("10.0", resolver().framework_version("net10.0"));
        si

        Calling__framework_version__should_reject_a_moniker_that_is_not_net_plus_a_version() is
            @test()

            // "netstandard2.1" would otherwise glob for "standard2.1.*"
            Assert.is_null(resolver().framework_version("netstandard2.1"));
            Assert.is_null(resolver().framework_version("netcoreapp3.1"));
        si

        Calling__framework_version__should_reject_a_moniker_too_short_to_slice() is
            @test()

            // shorter than the prefix: substring would throw rather than answer
            Assert.is_null(resolver().framework_version("net"));
            Assert.is_null(resolver().framework_version(""));
        si

        Calling__is_separator__should_accept_both_of_the_platforms_separators() is
            @test()

            Assert.is_true(resolver().is_separator(IO.Path.directory_separator_char));
            Assert.is_true(resolver().is_separator(IO.Path.alt_directory_separator_char));
            Assert.is_false(resolver().is_separator('x'));
        si

        Calling__strip_trailing_separators__should_remove_every_trailing_separator() is
            @test()

            let sep = separator();

            Assert.are_equal("{sep}a{sep}b", resolver().strip_trailing_separators("{sep}a{sep}b{sep}{sep}"));
            Assert.are_equal("{sep}a{sep}b", resolver().strip_trailing_separators("{sep}a{sep}b"));
            Assert.are_equal("", resolver().strip_trailing_separators("{sep}{sep}"));
        si

        Calling__install_root_from_runtime_directory__should_go_up_three_levels() is
            @test()

            let sep = separator();

            let runtime_directory =
                "{sep}usr{sep}lib{sep}dotnet{sep}shared{sep}Microsoft.NETCore.App{sep}10.0.10";

            Assert.are_equal(
                "{sep}usr{sep}lib{sep}dotnet",
                resolver().install_root_from_runtime_directory(runtime_directory));
        si

        Calling__install_root_from_runtime_directory__should_ignore_a_trailing_separator() is
            @test()

            let sep = separator();

            // the runtime directory arrives with one; left in place it costs a level
            let runtime_directory =
                "{sep}usr{sep}lib{sep}dotnet{sep}shared{sep}Microsoft.NETCore.App{sep}10.0.10{sep}";

            Assert.are_equal(
                "{sep}usr{sep}lib{sep}dotnet",
                resolver().install_root_from_runtime_directory(runtime_directory));
        si

        Calling__install_root_from_runtime_directory__should_answer_null_above_the_root() is
            @test()

            let sep = separator();

            Assert.is_null(resolver().install_root_from_runtime_directory("{sep}"));
            Assert.is_null(resolver().install_root_from_runtime_directory(""));
        si

        Calling__resolve_under__should_answer_null_for_a_root_with_no_packs() is
            @test()

            let empty = IO.Path.join(IO.Path.get_temp_path(), System.Guid.new_guid().to_string());

            IO.Directory.create_directory(empty);

            try
                Assert.is_null(resolver().resolve_under(empty, "net10.0"));
            finally
                IO.Directory.delete(empty, true);
            yrt
        si

        // The whole path the bare-invocation feature depends on, against the
        // SDK this test is running on: the reference directory has to exist and
        // hold the assemblies the compiler loads by default.
        Calling__resolve__should_find_the_reference_assemblies_of_the_running_sdk() is
            @test()

            let reference_path = resolver().resolve("net10.0");

            Assert.is_not_null(reference_path);
            Assert.is_true(IO.Directory.exists(reference_path!));
            Assert.is_true(IO.File.exists(IO.Path.join(reference_path!, "System.Runtime.dll")));
            Assert.is_true(IO.File.exists(IO.Path.join(reference_path!, "System.Console.dll")));
        si

        Calling__resolve__should_answer_null_for_a_moniker_with_no_pack_layout() is
            @test()

            Assert.is_null(resolver().resolve("netstandard2.1"));
        si
    si
si
