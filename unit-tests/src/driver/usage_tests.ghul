namespace Driver.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Collections.LIST;

    class USAGE_TESTS is
        @test()

        init() is si

        arguments(values: string[]) -> LIST[string] is
            let result = LIST[string]();

            for value in values do
                result.add(value);
            od

            return result;
        si

        long_form_is_recognised() is
            @test()

            Assert.is_true(Driver.USAGE.is_requested(arguments(["--help"])));
        si

        short_forms_are_recognised() is
            @test()

            Assert.is_true(Driver.USAGE.is_requested(arguments(["-h"])));
            Assert.is_true(Driver.USAGE.is_requested(arguments(["-?"])));
        si

        request_is_recognised_after_other_arguments() is
            @test()

            // help wins wherever it appears, including behind sources
            Assert.is_true(Driver.USAGE.is_requested(arguments(["a.ghul", "-o", "out.exe", "--help"])));
        si

        ordinary_arguments_are_not_a_request() is
            @test()

            Assert.is_false(Driver.USAGE.is_requested(arguments(["a.ghul"])));
            Assert.is_false(Driver.USAGE.is_requested(arguments([])));
        si

        // `--help` must not be confused with the flags it shares a prefix with,
        // nor `-?` with the presence-test operator appearing in a source name
        similar_arguments_are_not_a_request() is
            @test()

            Assert.is_false(Driver.USAGE.is_requested(arguments(["--helpful"])));
            Assert.is_false(Driver.USAGE.is_requested(arguments(["-help"])));
            Assert.is_false(Driver.USAGE.is_requested(arguments(["help"])));
        si

        text_describes_the_invocation_and_the_help_flag() is
            @test()

            let text = Driver.USAGE.text;

            Assert.is_true(text.contains("usage: ghul-compiler"));
            Assert.is_true(text.contains("--help"));
            Assert.is_true(text.contains("hello.ghul"));
        si

        // the flag that most needs saying, since --version means something else
        text_explains_how_to_get_the_compiler_version() is
            @test()

            Assert.is_true(Driver.USAGE.text.contains("prints its version"));
        si
    si
si
