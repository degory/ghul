namespace Driver.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // What --requirements prints comes from the requirements embedded in
    // the compiler: they have to be there, and name all three floors.
    @TestClass()
    class REQUIREMENTS_TESTS is
        init() is si

        _floor(json: System.Text.Json.JsonElement, name: string) -> string? is
            let value: System.Text.Json.JsonElement mut

            if json.try_get_property(name, value ref) then
                return value.get_string()
            fi

            return null
        si

        @Test()
        The_embedded_requirements__should_name_a_floor_for_each_library_and_ghul_llvm() is
            let root = System.Text.Json.JsonDocument.parse(Driver.REQUIREMENTS.text, _).root_element

            for name in ["ghul-core", "ghul-runtime", "ghul-llvm"] do
                let floor = _floor(root, name)

                is_true(floor?, "no floor for {name}")

                let version: System.Version? mut

                is_true(System.Version.try_parse(floor!, version ref), "{name}'s floor {floor} is not a version")
            od
        si

        @Test()
        The_embedded_requirements__should_be_the_ones_in_the_build_directory() is
            let file = IO.Path.join([System.AppContext.base_directory, "requirements.json"])

            is_true(IO.File.exists(file), "requirements.json is not beside the compiler")
            are_equal(IO.File.read_all_text(file), Driver.REQUIREMENTS.text)
        si
    si
si
