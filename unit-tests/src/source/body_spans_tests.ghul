namespace Source.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;
    use Source.BODY_SPANS;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // BODY_SPANS holds the pre-edit spans of the function bodies an
    // incremental EDIT re-walks. `contains` answers whether a recorded
    // symbol-use / definition position falls inside one — such an entry is
    // re-recorded by the re-walk, so reconciliation drops it.
    @TestClass()
    class BODY_SPANS_TESTS is
        init() is si

        // A body spanning the given lines, full-width.
        span(start_line: int, end_line: int) -> LOCATION =>
            LOCATION("test.ghul", start_line, 0, end_line, 80);

        // A packed position at the given line, column 4.
        at(line: int) -> int => LOCATION.pair(line, 4);

        @Test()
        position_inside_a_span_is_contained() is
            let spans = BODY_SPANS();
            spans.add(span(5, 8));

            is_true(spans.contains(at(5)), "body start line");
            is_true(spans.contains(at(7)), "line within body");
            is_true(spans.contains(at(8)), "body end line");
        si

        @Test()
        position_outside_every_span_is_not_contained() is
            let spans = BODY_SPANS();
            spans.add(span(5, 8));

            is_false(spans.contains(at(3)), "line above the body");
            is_false(spans.contains(at(12)), "line below the body");
        si

        // Spans may be registered out of source order; the set sorts them
        // before answering.
        @Test()
        spans_registered_out_of_order_are_still_found() is
            let spans = BODY_SPANS();
            spans.add(span(20, 25));
            spans.add(span(5, 8));

            is_true(spans.contains(at(6)), "first body by line, added second");
            is_true(spans.contains(at(22)), "second body by line, added first");
            is_false(spans.contains(at(15)), "the gap between the two bodies");
        si

        @Test()
        empty_spans_contain_nothing() is
            let spans = BODY_SPANS();

            is_false(spans.contains(at(5)));
        si

        // `LOCATION.internal` packs to position (1, 1). `contains` compares
        // packed positions without checking file_name, so without this
        // skip every real top-level symbol declared at line 1 column 1
        // would be matched and dropped from the symbol-definition map.
        @Test()
        internal_spans_are_skipped() is
            let spans = BODY_SPANS();
            spans.add(LOCATION.internal);

            is_false(spans.contains(LOCATION.pair(1, 1)), "(1,1) — same packed position as LOCATION.internal");
            is_false(spans.contains(at(5)), "any other position");
        si
    si
si
