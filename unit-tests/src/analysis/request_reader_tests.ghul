namespace Analysis.UnitTests is
    use Analysis.QueuedFrame;
    use Analysis.REQUEST_READER;

    use Collections.LIST;

    use Analysis.Protocol.Request;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    @TestClass()
    class REQUEST_READER_TESTS is
        init() is si

        edit_line: string static => "{{\"command\":\"edit\",\"files\":[{{\"path\":\"a.ghul\",\"source\":\"namespace A is si\"}}]}}";

        // A delta whose files list is empty still parses as an EDIT_DELTA
        // request, which is all these tests need of it.
        edit_delta_line: string static => "{{\"command\":\"edit_delta\",\"files\":[]}}";

        hover_line: string static => "{{\"command\":\"hover\",\"path\":\"a.ghul\",\"line\":1,\"column\":1}}";

        stats_line: string static => "{{\"command\":\"stats\"}}";

        lines_of(first: string, second: string, third: string?) -> LIST[string] static is
            let lines = LIST[string]();

            lines.add(first);
            lines.add(second);

            if third? then
                lines.add(third);
            fi

            return lines;
        si

        reader_over(lines: LIST[string]) -> REQUEST_READER static is
            let text mut = "";

            for line in lines do
                text = "{text}{line}\n";
            od

            return REQUEST_READER(IO.StringReader(text));
        si

        _is_edit_like(request: Request) -> bool =>
            isa Request.EDIT(request) \/ isa Request.EDIT_DELTA(request);

        _is_query(request: Request) -> bool =>
            isa Request.HOVER(request) \/ isa Request.STATS(request);

        // Whether the queue holds anything the predicate accepts. Used as
        // a gate: waiting for the LAST of several frames guarantees the
        // earlier ones are queued too, since the reader thread parses
        // strictly in order.
        _await(reader: REQUEST_READER, wanted: (Request) -> bool) is
            let deadline = System.DateTime.now.add_seconds(10.0D);

            do
                if reader.has_pending(wanted) then
                    return;
                fi

                if System.DateTime.now.subtract(deadline).total_milliseconds > 0.0D then
                    fail("the reader never queued the awaited frame");
                fi

                System.Threading.Thread.sleep(10);
            od
        si

        // Every frame the reader lifts off the input, in order, ending when
        // the reader reports end of input. Consumes the queue.
        _drain(reader: REQUEST_READER) -> LIST[QueuedFrame] is
            let collected = LIST[QueuedFrame]();

            let deadline = System.DateTime.now.add_seconds(10.0D);

            do
                let frame = reader.take(50);

                if isa QueuedFrame.END_OF_INPUT(frame) then
                    return collected;
                fi

                if !isa QueuedFrame.TIMED_OUT(frame) then
                    collected.add(frame);
                fi

                if System.DateTime.now.subtract(deadline).total_milliseconds > 0.0D then
                    fail("the reader never reached end of input");
                fi
            od
        si

        _requests(frames: LIST[QueuedFrame]) -> LIST[Request] static is
            let result = LIST[Request]();

            for frame in frames do
                if let queued: QueuedFrame.REQUEST = frame then
                    result.add(queued.request);
                fi
            od

            return result;
        si

        @Test()
        given_an_edit_queued_behind_a_query__has_pending__should_find_it() is
            let reader = reader_over(lines_of(hover_line, edit_line, null));

            reader.start();

            // Waiting for the edit guarantees the hover ahead of it is
            // queued too: the reader parses strictly in send order.
            _await(reader, r => isa Request.EDIT(r));

            is_true(reader.has_pending(_is_edit_like), "the edit should be found");
            is_true(reader.has_pending(_is_query), "the query ahead of it should be found");
        si

        @Test()
        given_an_edit_delta_queued_behind_a_query__has_pending__should_find_it() is
            let reader = reader_over(lines_of(hover_line, edit_delta_line, null));

            reader.start();

            _await(reader, r => isa Request.EDIT_DELTA(r));

            is_true(reader.has_pending(_is_edit_like), "the edit delta should be found");
        si

        @Test()
        given_only_queries_queued__has_pending__should_find_no_edit() is
            let reader = reader_over(lines_of(hover_line, stats_line, null));

            reader.start();

            // The stats line is last: once it is queued, every line has
            // been parsed and none of them was an edit.
            _await(reader, r => isa Request.STATS(r));

            is_false(reader.has_pending(_is_edit_like), "no edit should be found");
        si

        @Test()
        given_a_frame_that_fails_to_parse__the_reader__should_queue_a_parse_error_and_continue() is
            let reader = reader_over(lines_of("this is not json", edit_line, null));

            reader.start();

            let frames = _drain(reader);

            are_equal(2, frames.count, "both lines should produce a frame each");

            is_true(isa QueuedFrame.PARSE_ERROR(frames[0]), "the malformed line should queue a parse error");
            is_true(isa QueuedFrame.REQUEST(frames[1]), "the well-formed line after it should still parse");
        si

        @Test()
        given_mixed_frames__take__should_return_them_in_the_order_sent() is
            let reader = reader_over(lines_of(hover_line, edit_line, stats_line));

            reader.start();

            let sent = _requests(_drain(reader));

            are_equal(3, sent.count, "every request line should come back exactly once");

            is_true(isa Request.HOVER(sent[0]), "the first frame should be the first line sent");
            is_true(isa Request.EDIT(sent[1]), "the second frame should be the second line sent");
            is_true(isa Request.STATS(sent[2]), "the third frame should be the third line sent");
        si

        @Test()
        given_a_query_at_the_head__take_if__should_not_reach_past_it_to_the_edit() is
            let reader = reader_over(lines_of(hover_line, edit_line, null));

            reader.start();

            _await(reader, r => isa Request.EDIT(r));

            // Queries are served from the head only, in send order: the
            // hover comes off, the edit behind it stays put.
            let taken = reader.take_if(r => _is_query(r));

            is_true(taken? /\ isa Request.HOVER(taken), "the head query should be taken");

            is_false(
                reader.take_if(r => _is_query(r))?,
                "nothing query-shaped should remain at the head"
            );

            is_true(reader.has_pending(_is_edit_like), "the edit should still be queued");
        si

        @Test()
        given_an_edit_at_the_head__take_if__should_leave_it_for_its_own_handler() is
            let reader = reader_over(lines_of(edit_line, hover_line, null));

            reader.start();

            _await(reader, r => isa Request.HOVER(r));

            // An interleavable-query scan stops at the edit: requests stay
            // in send order, so the query behind it waits.
            is_false(
                reader.take_if(r => _is_query(r))?,
                "the query behind the edit should not be taken"
            );

            is_true(reader.has_pending(_is_edit_like), "the edit should still be queued");
        si

        @Test()
        given_the_input_is_exhausted__take__should_keep_reporting_end_of_input() is
            let lines = LIST[string]();

            lines.add(edit_line);

            let reader = reader_over(lines);

            reader.start();

            _drain(reader);

            is_true(isa QueuedFrame.END_OF_INPUT(reader.take(50)), "end of input should be reported");
            is_true(isa QueuedFrame.END_OF_INPUT(reader.take(50)), "end of input should keep being reported");
        si
    si
si
