namespace Analysis.UnitTests is
    use TYPE = System.Type

    use Collections.LIST
    use Collections.SET

    use Ghul.Pipes

    use Analysis.Protocol.Request

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The compiler reads requests by reflection, which builds each generic
    // collection a request carries through Activator. Native AOT compiles
    // only the generic instantiations it can see, so every one a request
    // can hold has to be named in native-aot.rd.xml, or a published
    // compiler fails to read that request where a JIT build reads it fine.
    @TestClass()
    class NATIVE_AOT_ROOTS_TESTS is
        init() is si

        @Test()
        every_generic_type_a_request_holds__is_rooted_for_native_aot() is
            let directives = IO.File.read_all_text(_directives_path())
            let found = SET[TYPE]()

            for variant in (typeof Request).assembly.get_types() do
                if variant.base_type =~ typeof Request then
                    _collect(variant, found, SET[TYPE]())
                fi
            od

            is_true(found.count > 0, "found no generic types in any request")

            for type in found do
                let name = _directive_name(type)

                is_true(directives.contains(name), "{name} is not rooted in native-aot.rd.xml")
            od
        si

        // Every constructed generic type, other than an optional, that
        // `type` holds in a constructor parameter, a property or a field,
        // and those its members' types hold in turn.
        _collect(type: TYPE, found: SET[TYPE], visited: SET[TYPE]) is
            if !visited.add(type) then
                return
            fi

            if type.is_generic_type /\ !type.is_generic_type_definition then
                if !(type.get_generic_type_definition() =~ typeof System.Nullable[_]) then
                    found.add(type)
                fi

                for argument in type.get_generic_arguments() do
                    _collect(argument, found, visited)
                od

                return
            fi

            if type.assembly != (typeof Request).assembly then
                return
            fi

            for constructor in type.get_constructors() do
                for parameter in constructor.get_parameters() do
                    _collect(parameter.parameter_type, found, visited)
                od
            od

            for property in type.get_properties() do
                _collect(property.property_type, found, visited)
            od

            for `field in type.get_fields() do
                _collect(`field.field_type, found, visited)
            od
        si

        // How native-aot.rd.xml names `type`: the generic definition's
        // full name, each argument in double brackets with its assembly.
        _directive_name(type: TYPE) -> string =>
            "{type.get_generic_type_definition().full_name}[{type.get_generic_arguments() |> map(a => "[{a.full_name},{a.assembly.get_name().name}]") |> join(",")}]"

        _directives_path() -> string is
            let directory: IO.DirectoryInfo? mut = IO.DirectoryInfo(System.AppContext.base_directory)

            while let current = directory do
                let candidate = IO.Path.combine(current.full_name, "native-aot.rd.xml")

                if IO.File.exists(candidate) then
                    return candidate
                fi

                directory = current.parent
            od

            throw Ghul.Exception("native-aot.rd.xml not found above {System.AppContext.base_directory}")
        si
    si
si
