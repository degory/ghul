namespace Analysis.UnitTests is
    use TYPE = System.Type

    use System.Text.Json.JsonSerializer

    use Collections.LIST

    use Analysis.Protocol.COMPILE_REPLY
    use Analysis.Protocol.COMPILE_REQUEST
    use Analysis.Protocol.JSON_OPTIONS
    use Analysis.Protocol.Request
    use Analysis.Protocol.Response

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The compiler writes with the runtime's Json and clients read with
    // System.Text.Json under JSON_OPTIONS, so for every message the two
    // have to write the same JSON, and each has to read what the other
    // writes. The two escape differently - System.Text.Json escapes HTML
    // characters and non-ASCII - so text is compared after a round trip
    // through the runtime's parser and writer, which keeps every name,
    // value and its order.
    @TestClass()
    class PROTOCOL_JSON_TESTS is
        init() is si

        @Test()
        every_response__is_written_as_system_text_json_writes_it() is
            for value in _variants(typeof Response) do
                _writes_alike(value, typeof Response)
            od
        si

        @Test()
        every_request__is_written_as_system_text_json_writes_it() is
            for value in _variants(typeof Request) do
                _writes_alike(value, typeof Request)
            od
        si

        @Test()
        every_request__reads_back_what_system_text_json_wrote() is
            for value in _variants(typeof Request) do
                _reads_back(value, typeof Request)
            od
        si

        @Test()
        every_response__reads_back_what_system_text_json_wrote() is
            for value in _variants(typeof Response) do
                _reads_back(value, typeof Response)
            od
        si

        @Test()
        compile_server_messages__are_written_and_read_alike() is
            let request = _sample(typeof COMPILE_REQUEST)!
            let reply = _sample(typeof COMPILE_REPLY)!

            _writes_alike(request, typeof COMPILE_REQUEST)
            _reads_back(request, typeof COMPILE_REQUEST)
            _writes_alike(reply, typeof COMPILE_REPLY)
            _reads_back(reply, typeof COMPILE_REPLY)
        si

        @Test()
        a_missing_member__reads_as_its_default() is
            let request = cast Request.HOVER?(Json.from_json(Json.parse("{{\"kind\":\"hover\",\"path\":\"a.ghul\"}}"), typeof Request))

            assert request?
            are_equal("a.ghul", request.path)
            are_equal(0, request.line)
        si

        @Test()
        an_unknown_kind__is_an_error() is
            let thrown mut = false

            try
                Json.from_json(Json.parse("{{\"kind\":\"no_such_command\"}}"), typeof Request)
            catch e: Ghul.Exception
                thrown = true
            yrt

            is_true(thrown)
        si

        _writes_alike(value: object, declared: TYPE) is
            let expected = JsonSerializer.serialize(value, declared, JSON_OPTIONS.create())

            are_equal(_normalised(expected), Json.write(Json.to_json(value)), value.get_type().name)
        si

        _reads_back(value: object, declared: TYPE) is
            let options = JSON_OPTIONS.create()
            let expected = JsonSerializer.serialize(value, declared, options)
            let read = Json.from_json(Json.parse(expected), declared)

            are_equal(expected, JsonSerializer.serialize(read, declared, options), value.get_type().name)
        si

        // `json` as the runtime's writer writes it.
        _normalised(json: string) -> string => Json.write(Json.parse(json))

        _variants(base: TYPE) -> LIST[object] is
            let result = LIST[object]()

            for variant in base.assembly.get_types() do
                if variant.base_type =~ base then
                    result.add(_sample(variant)!)
                fi
            od

            is_true(result.count > 10, "found {result.count} variants of {base.name}")

            return result
        si

        // A value of `type` with every member given something other than
        // its default, so a member either end drops shows up in the text.
        _sample(type: TYPE) -> object? is
            let target = System.Nullable.get_underlying_type(type) ?? type

            if target =~ typeof string then
                return "text ū \"quoted\""
            elif target =~ typeof int then
                return 7
            elif target =~ typeof long then
                return 9L
            elif target =~ typeof double then
                return 1.5
            elif target =~ typeof bool then
                return true
            fi

            if target.is_generic_type /\ target.get_generic_arguments().count == 1 then
                let element = target.get_generic_arguments()[0]
                let list = cast DotNet.NonGeneric.Collections.IList?(
                    System.Activator.create_instance((typeof LIST[_]).make_generic_type([element])))!

                list.add(_sample(element))

                return list
            fi

            let constructors = target.get_constructors()
            let widest mut = constructors[0]

            for constructor in constructors do
                if constructor.get_parameters().count > widest.get_parameters().count then
                    widest = constructor
                fi
            od

            let arguments = LIST[object?]()

            for parameter in widest.get_parameters() do
                arguments.add(_sample(parameter.parameter_type))
            od

            return widest.invoke(arguments.to_array())
        si
    si
si
