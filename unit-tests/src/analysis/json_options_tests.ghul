namespace Analysis.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use System.Text.Json.JsonSerializer;

    use Analysis.Protocol.JSON_OPTIONS;
    use Analysis.Protocol.SEMANTIC_TOKEN;

    class JSON_OPTIONS_TESTS is
        @test()

        init() is si

        // Fields are included so a union variant's constructor arguments
        // serialize, which also reaches the hidden field behind every
        // auto-property. Those carry the property's name with a `$` in
        // front, and writing them doubles the size of every message.
        serializing__writes_no_backing_fields() is
            @test()

            let json = JsonSerializer.serialize[SEMANTIC_TOKEN](
                SEMANTIC_TOKEN(4, 11, 4, 35, "class", ""),
                JSON_OPTIONS.create()
            );

            Assert.is_false(json.contains('$'), "backing field reached the wire: {json}");
        si

        serializing__writes_the_declared_members() is
            @test()

            let json = JsonSerializer.serialize[SEMANTIC_TOKEN](
                SEMANTIC_TOKEN(4, 11, 4, 35, "class", ""),
                JSON_OPTIONS.create()
            );

            Assert.are_equal(
                "{{\"start_line\":4,\"start_column\":11,\"end_line\":4,\"end_column\":35,\"token_type\":\"class\",\"modifiers\":\"\"}}",
                json
            );
        si

        // Both ends share these settings, so what one writes the other has
        // to be able to read back.
        round_trip__restores_every_member() is
            @test()

            let options = JSON_OPTIONS.create();

            let json = JsonSerializer.serialize[SEMANTIC_TOKEN](
                SEMANTIC_TOKEN(4, 11, 6, 35, "interface", "static"),
                options
            );

            let restored = JsonSerializer.deserialize[SEMANTIC_TOKEN](json, options);

            Assert.are_equal(4, restored.start_line);
            Assert.are_equal(11, restored.start_column);
            Assert.are_equal(6, restored.end_line);
            Assert.are_equal(35, restored.end_column);
            Assert.are_equal("interface", restored.token_type);
            Assert.are_equal("static", restored.modifiers);
        si
    si
si
