namespace Lexical.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Logging
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A string literal is terminated by its closing quote, and nothing after
    // that quote can retroactively unterminate it - not a newline, not end
    // of file, and not the lookahead that checks for an adjacent literal to
    // chain, which can reach the end of the file while peeking past a
    // literal that already closed. CANCEL_STRING is only for a newline or
    // end of file reached inside the literal, before its closing quote.
    @TestClass()
    class TOKENIZER_STRING_EOF_TESTS is
        init() is si

        tokenizer_for(source: string) -> TOKENIZER is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            return TOKENIZER(logger, "dummy.ghul", IO.StringReader(source), false)
        si

        @Test()
        a_closed_string_at_end_of_file_is_a_string_literal() is
            let tokenizer = tokenizer_for("\"ok\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ok", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        a_closed_string_before_a_trailing_newline_at_end_of_file_is_a_string_literal() is
            let tokenizer = tokenizer_for("\"ok\"\n")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ok", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        adjacent_closed_strings_at_end_of_file_chain_into_one_literal() is
            let tokenizer = tokenizer_for("\"a\" \"b\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ab", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        a_closed_interpolated_string_at_end_of_file_exits_cleanly() is
            let tokenizer = tokenizer_for("\"{{x}}\"")

            are_equal(TOKEN.ENTER_STRING, tokenizer.read_token().token)
            are_equal(TOKEN.IDENTIFIER, tokenizer.read_token().token)
            are_equal(TOKEN.EXIT_STRING, tokenizer.read_token().token)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        an_unterminated_string_at_end_of_file_is_cancelled() is
            let tokenizer = tokenizer_for("\"abc")

            are_equal(TOKEN.CANCEL_STRING, tokenizer.read_token().token)
        si

        @Test()
        an_unterminated_string_at_a_newline_is_cancelled() is
            let tokenizer = tokenizer_for("\"abc\nnext")

            are_equal(TOKEN.CANCEL_STRING, tokenizer.read_token().token)
        si

        @Test()
        an_interpolation_whose_trailing_fragment_never_closes_is_cancelled() is
            let tokenizer = tokenizer_for("\"{{x}} tail")

            are_equal(TOKEN.ENTER_STRING, tokenizer.read_token().token)
            are_equal(TOKEN.IDENTIFIER, tokenizer.read_token().token)
            are_equal(TOKEN.CANCEL_STRING, tokenizer.read_token().token)
        si

        @Test()
        a_chain_whose_last_fragment_never_closes_is_cancelled() is
            let tokenizer = tokenizer_for("\"a\" \"b")

            are_equal(TOKEN.CANCEL_STRING, tokenizer.read_token().token)
        si

        @Test()
        a_closed_string_followed_by_more_tokens_is_unchanged() is
            let tokenizer = tokenizer_for("\"ok\"\nnext")

            are_equal(TOKEN.STRING_LITERAL, tokenizer.read_token().token)
            are_equal(TOKEN.IDENTIFIER, tokenizer.read_token().token)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si
    si
si
