namespace Lexical.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Logging
    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Comments are invisible to the grammar: stripping every comment from a
    // program never changes its meaning. Adjacent string literals therefore
    // chain across comments exactly as they chain across whitespace, and a
    // written `;` is the one thing that separates two otherwise-adjacent
    // literals. A `/` that does not open a comment still ends the chain and
    // is handed on as the operator it is.
    @TestClass()
    class TOKENIZER_COMMENT_CHAIN_TESTS is
        init() is si

        tokenizer_for(source: string) -> TOKENIZER is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            return TOKENIZER(logger, "dummy.ghul", IO.StringReader(source), false)
        si

        @Test()
        fragments_chain_across_a_line_comment() is
            let tokenizer = tokenizer_for("\"a\" // explanation\n\"b\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ab", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        fragments_chain_across_a_block_comment_on_one_line() is
            let tokenizer = tokenizer_for("\"a\" /* between */ \"b\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ab", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        fragments_chain_across_a_block_comment_spanning_lines() is
            let tokenizer = tokenizer_for("\"a\" /* one\ntwo */ \"b\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ab", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        fragments_chain_across_several_comment_lines() is
            let tokenizer = tokenizer_for("\"a\"\n// one\n\n// two\n\"b\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("ab", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        an_interpolated_exit_chains_across_a_line_comment() is
            let tokenizer = tokenizer_for("\"{{x}}a\" // explanation\n\"b\"")

            are_equal(TOKEN.ENTER_STRING, tokenizer.read_token().token)
            are_equal(TOKEN.IDENTIFIER, tokenizer.read_token().token)

            let result = tokenizer.read_token()

            are_equal(TOKEN.EXIT_STRING, result.token)
            are_equal("ab", result.value_string)
            are_equal(TOKEN.END_OF_INPUT, tokenizer.read_token().token)
        si

        @Test()
        a_semicolon_still_separates_fragments() is
            let tokenizer = tokenizer_for("\"a\" // explanation\n;\n\"b\"")

            are_equal(TOKEN.STRING_LITERAL, tokenizer.read_token().token)
            are_equal(TOKEN.SEMICOLON, tokenizer.read_token().token)

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("b", result.value_string)
        si

        @Test()
        a_slash_that_is_not_a_comment_ends_the_chain() is
            let tokenizer = tokenizer_for("\"a\" / x")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            are_equal("a", result.value_string)

            let operator = tokenizer.read_token()

            are_equal(TOKEN.OPERATOR, operator.token)
            are_equal("/", operator.value_string)
            are_equal(TOKEN.IDENTIFIER, tokenizer.read_token().token)
        si

        @Test()
        a_comment_between_fragments_is_kept_as_trivia() is
            let tokenizer = tokenizer_for("\"a\" // explanation\n\"b\"")

            let result = tokenizer.read_token()

            are_equal(TOKEN.STRING_LITERAL, result.token)
            is_true(
                tokenizer.trivia |> any(t =>
                    if let c: TRIVIA.LINE_COMMENT = t then
                        c.text.contains("explanation")
                    else
                        false
                    fi),
                "expected the chained-over comment in trivia"
            )
        si
    si
si
