namespace Lexical.UnitTests is
    use Collections
    use Ghul.Pipes

    use Logging
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A `///` comment that is the first thing on its line is recorded as a
    // doc comment; every other line comment stays an ordinary one.
    @TestClass()
    class TOKENIZER_DOC_COMMENT_TESTS is
        init() is si

        trivia_of(source: string) -> LIST[TRIVIA] is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let tokenizer = TOKENIZER(logger, "dummy.ghul", IO.StringReader(source), false)

            while tokenizer.read_token().token != TOKEN.END_OF_INPUT do
            od

            let result = LIST[TRIVIA]()

            for t in tokenizer.trivia do
                if !isa TRIVIA.BLANK_LINE(t) then
                    result.add(t)
                fi
            od

            return result
        si

        is_doc(t: TRIVIA) -> bool => isa TRIVIA.DOC_COMMENT(t)

        @Test()
        three_slashes_at_the_start_of_a_line_are_a_doc_comment() is
            let trivia = trivia_of("/// Adds one.\nf() is si")

            are_equal(1, trivia.count)
            is_true(is_doc(trivia[0]))

            if let dc: TRIVIA.DOC_COMMENT = trivia[0] then
                are_equal("/// Adds one.", dc.text)
            fi
        si

        @Test()
        an_indented_doc_comment_is_still_a_doc_comment() is
            let trivia = trivia_of("class C is\n    /// A member.\n    f() is si\nsi")

            are_equal(1, trivia.count)
            is_true(is_doc(trivia[0]))
        si

        @Test()
        four_slashes_are_an_ordinary_comment() is
            let trivia = trivia_of("//// divider\nf() is si")

            are_equal(1, trivia.count)
            is_false(is_doc(trivia[0]))
        si

        @Test()
        two_slashes_are_an_ordinary_comment() is
            let trivia = trivia_of("// plain\nf() is si")

            are_equal(1, trivia.count)
            is_false(is_doc(trivia[0]))
        si

        @Test()
        three_slashes_after_code_on_the_same_line_are_an_ordinary_comment() is
            let trivia = trivia_of("x: int /// trailing\ny: int")

            are_equal(1, trivia.count)
            is_false(is_doc(trivia[0]))
        si

        @Test()
        a_bare_three_slash_line_is_a_doc_comment() is
            let trivia = trivia_of("/// first\n///\n/// second\nf() is si")

            are_equal(3, trivia.count)
            is_true(trivia |> all(t => is_doc(t)))
        si
    si
si
