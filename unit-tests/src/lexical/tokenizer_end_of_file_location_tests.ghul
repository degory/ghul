namespace Lexical.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Logging
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // An identifier that ends the input spans the same columns whether or
    // not a newline follows it.
    @TestClass()
    class TOKENIZER_END_OF_FILE_LOCATION_TESTS is
        init() is si

        tokenizer_for(source: string) -> TOKENIZER is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            return TOKENIZER(logger, "dummy.ghul", IO.StringReader(source), false)
        si

        // The location of the token `count` tokens into `source`.
        location_of(source: string, count: int) -> Source.LOCATION is
            let tokenizer = tokenizer_for(source)
            let token mut = tokenizer.read_token()

            for _ in 1..count do
                token = tokenizer.read_token()
            od

            return token.location
        si

        same_span(a: Source.LOCATION, b: Source.LOCATION) is
            are_equal(a.start_line, b.start_line)
            are_equal(a.start_column, b.start_column)
            are_equal(a.end_line, b.end_line)
            are_equal(a.end_column, b.end_column)
        si

        @Test()
        an_identifier_that_ends_the_input_keeps_its_last_character() is
            same_span(location_of("words.co\n", 2), location_of("words.co", 2))
        si
    si
si
