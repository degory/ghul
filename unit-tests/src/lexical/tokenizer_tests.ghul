namespace Lexical.UnitTests is
    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Logging
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class TOKENIZER_TESTS is
        init() is si

        split_at_white_space(source_string: string) -> Iterable[string]
            => source_string.split([' ', '\t', '\r', '\n'], System.StringSplitOptions.REMOVE_EMPTY_ENTRIES)

        @Test()
        Given_a_list_of_space_separated_identifiers__next__should_return_one_non_eof_token_for_each_identifier() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @Test()
        Given_a_list_of_multi_white_space_separated_identifiers__next__should_return_one_non_eof_token_for_each_identifier() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let source_string = "a    list  \n of \r\n identifier tokens    "

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @Test()
        Given_a_list_of_space_separated_identifiers__next__should_return_eof_after_the_last_identifier() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @Test()
        Given_a_list_of_multi_white_space_separated_identifiers__next__should_return_eof_after_the_last_identifier() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let source_string = "\t\ta \t\t\tlist of \r\n identifier\n tokens\n\t\t"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si


        @Test()
        Given_a_list_of_space_separated_identifiers__current_token__should_be_IDENTIFIER_for_each_identifier() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()

                assert result.token == TOKEN.IDENTIFIER
            od
        si

        @Test()
        Given_a_list_of_space_separated_identifiers__current_value_string__should_be_each_identifier_in_turn() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in source_string.split([' ']) do
                let result = tokenizer.read_token()

                assert result.value_string =~ expected_identifier
            od
        si

        @Test()
        Given_a_list_of_space_separated_identifiers__current__should_be_IDENTIFIER_for_each_identifier() is
            let logger = NSubstitute.Substitute.`for`[Logger]([])

            let reader = IO.StringReader("a list of identifier tokens")

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            let expected_tokens = [TOKEN.IDENTIFIER, TOKEN.IDENTIFIER, TOKEN.IDENTIFIER, TOKEN.IDENTIFIER, TOKEN.IDENTIFIER].iterator

            do
                let result = tokenizer.read_token()

                if result.token == TOKEN.END_OF_INPUT then
                    break
                fi

                is_true(expected_tokens.move_next())

                are_equal(result.token, expected_tokens.current)
            od

            is_false(expected_tokens.move_next())
        si

        @Test()
        is_reserved_word__is_true_for_a_keyword() is
            is_true(TOKENIZER.is_reserved_word("class"))
            is_true(TOKENIZER.is_reserved_word("field"))
        si

        @Test()
        is_reserved_word__is_false_for_a_plain_identifier() is
            is_false(TOKENIZER.is_reserved_word("value"))
            is_false(TOKENIZER.is_reserved_word("field_count"))
        si

        @Test()
        is_reserved_word__is_false_for_null_or_empty() is
            is_false(TOKENIZER.is_reserved_word(null))
            is_false(TOKENIZER.is_reserved_word(""))
        si

        @Test()
        is_numeric_identifier__is_true_for_a_digit_led_word() is
            is_true(TOKENIZER.is_numeric_identifier("123"))
            is_true(TOKENIZER.is_numeric_identifier("1st"))
        si

        @Test()
        is_numeric_identifier__is_false_for_a_letter_led_name() is
            is_false(TOKENIZER.is_numeric_identifier("v1"))
            is_false(TOKENIZER.is_numeric_identifier("field"))
        si

        @Test()
        is_numeric_identifier__is_false_when_escaping_would_not_round_trip() is
            // A dotted or symbol-bearing name cannot survive a backtick escape
            // (the escape consumes only identifier characters), so it must not
            // be reported as escapable.
            is_false(TOKENIZER.is_numeric_identifier("12.5"))
            is_false(TOKENIZER.is_numeric_identifier(""))
        si

        @Test()
        is_operator_name__is_true_for_operator_character_runs() is
            is_true(TOKENIZER.is_operator_name("+"))
            is_true(TOKENIZER.is_operator_name("##"))
            is_true(TOKENIZER.is_operator_name("=~"))
        si

        @Test()
        is_operator_name__is_false_for_names_and_empty() is
            is_false(TOKENIZER.is_operator_name("plus"))
            is_false(TOKENIZER.is_operator_name("a+b"))
            is_false(TOKENIZER.is_operator_name(""))
        si
    si
si
