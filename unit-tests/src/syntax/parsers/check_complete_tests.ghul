namespace Syntax.Parsers.UnitTests is
    use Syntax.Parsers.COMPLETENESS
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // What COMPILER.check_complete answers for the shapes a line-at-a-time
    // front end meets: input that stops inside a construct, value or
    // literal is incomplete; the same input finished is complete; input
    // with a mistake more input cannot repair is invalid.
    @TestClass()
    class CHECK_COMPLETE_TESTS is
        init() is si

        check(source: string) -> COMPLETENESS =>
            Compiler.COMPILER().check_complete("cell.ghul", IO.StringReader(source))

        incomplete(source: string) is
            are_equal(COMPLETENESS.INCOMPLETE, check(source), source)
        si

        complete(source: string) is
            are_equal(COMPLETENESS.COMPLETE, check(source), source)
        si

        invalid(source: string) is
            are_equal(COMPLETENESS.INVALID, check(source), source)
        si

        @Test()
        an_if_with_no_fi__is_incomplete() is
            incomplete("if true then\n    write_line(1)\n")
            complete("if true then\n    write_line(1)\nfi\n")
        si

        @Test()
        a_body_with_no_si__is_incomplete() is
            incomplete("f(n: int) -> int is\n    n + 1\n")
            complete("f(n: int) -> int is\n    n + 1\nsi\n")
        si

        @Test()
        a_class_with_no_si__is_incomplete() is
            incomplete("class POINT(x: int) is\n    y: int\n")
            complete("class POINT(x: int) is\n    y: int\nsi\n")
        si

        @Test()
        a_union_with_no_si__is_incomplete() is
            incomplete("union Shape is\n    DOT;\n")
            complete("union Shape is\n    DOT;\nsi\n")
        si

        @Test()
        an_open_call__is_incomplete() is
            incomplete("write_line(1,\n")
            complete("write_line(1)\n")
        si

        @Test()
        an_open_array__is_incomplete() is
            incomplete("let xs = [1, 2,\n")
            complete("let xs = [1, 2]\n")
        si

        @Test()
        an_open_string__is_incomplete() is
            incomplete("let s = \"abc")
            complete("let s = \"abc\"\n")
        si

        @Test()
        an_open_interpolation__is_incomplete() is
            incomplete("let s = \"abc {{1 + ")
            complete("let s = \"abc {{1 + 2}}\"\n")
        si

        @Test()
        a_let_with_no_value__is_incomplete() is
            incomplete("let x =\n")
            complete("let x = 1\n")
        si

        @Test()
        a_trailing_operator__is_incomplete() is
            incomplete("let x = 1 +\n")
            complete("let x = 1 + 2\n")
        si

        @Test()
        a_trailing_pipe__is_incomplete() is
            incomplete("let n = [1, 2] |>\n")
        si

        @Test()
        empty_input__is_complete() is
            complete("")
        si

        @Test()
        a_stray_closer__is_invalid() is
            invalid("let x = 1\nfi\n")
        si

        @Test()
        a_let_with_no_name__is_invalid() is
            invalid("let = 3\n")
        si

        @Test()
        a_misspelt_keyword__is_invalid() is
            invalid("if x thn y fi\n")
            invalid("whle x do\n    x = 1\nod\n")
        si

        // A string cannot span lines, so one that meets a newline is wrong
        // however much follows.
        @Test()
        a_string_broken_by_a_newline__is_invalid() is
            invalid("let s = \"abc\nlet t = 1\n")
        si

        // Incomplete at the end but wrong before it: more input cannot
        // repair the earlier mistake.
        @Test()
        an_open_construct_after_a_mistake__is_invalid() is
            invalid("let = 3\nif true then\n")
        si

        last(source: string) -> string? =>
            Compiler.COMPILER().check("cell.ghul", IO.StringReader(source)).last_statement

        @Test()
        check__names_an_expression_last() is
            are_equal("expression", last("x * 2\n"))
            are_equal("expression", last("write_line(\"hi\")\n"))
            are_equal("expression", last("let x = 1\nx\n"))
        si

        @Test()
        check__names_an_if_or_case_last_as_an_expression() is
            are_equal("expression", last("if c then 1 else 2 fi\n"))
            are_equal("expression", last("case x\nwhen 1 then 2\nelse 3\nesac\n"))
        si

        @Test()
        check__names_a_loop_last() is
            are_equal("loop", last("for i in xs do write_line(i) od\n"))
            are_equal("loop", last("while c do f() od\n"))
            are_equal("loop", last("outer: for i in xs do od\n"))
        si

        @Test()
        check__names_a_let_or_an_assignment_last() is
            are_equal("let", last("let x = 123\n"))
            are_equal("assignment", last("let x mut = 1\nx = 2\n"))
        si

        @Test()
        check__names_a_definition_last() is
            are_equal("definition", last("f(n: int) -> int => n\n"))
            are_equal("definition", last("class A is si\n"))
            are_equal("definition", last("use IO.Std.write_line\n"))
            are_equal("definition", last("x * 2\nunion U is A; si\n"))
        si

        @Test()
        check__names_another_statement_last() is
            are_equal("statement", last("assert true\n"))
        si

        @Test()
        check__names_nothing_for_text_that_is_not_complete() is
            is_null(last("if c then\n"))
            is_null(last(""))
        si
    si
si
