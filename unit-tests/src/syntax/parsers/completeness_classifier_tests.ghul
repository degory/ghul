namespace Syntax.Parsers.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Syntax.Parsers.COMPLETENESS
    use Syntax.Parsers.COMPLETENESS_CLASSIFIER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins how the errors a parse left behind decide whether the input is
    // complete: none is complete, all of them at end of input is
    // incomplete, and any one anywhere else is invalid.
    @TestClass()
    class COMPLETENESS_CLASSIFIER_TESTS is
        init() is si

        at(line: int) -> LOCATION => LOCATION("cell.ghul", line, 1, line, 2)

        classify(errors: LIST[LOCATION], at_end: LIST[LOCATION]) -> COMPLETENESS =>
            COMPLETENESS_CLASSIFIER().classify(errors, at_end)

        @Test()
        classify__with_no_errors__is_complete() is
            are_equal(COMPLETENESS.COMPLETE, classify(LIST[LOCATION](), LIST[LOCATION]([at(3)])))
        si

        @Test()
        classify__with_every_error_at_end_of_input__is_incomplete() is
            are_equal(COMPLETENESS.INCOMPLETE, classify(LIST[LOCATION]([at(3), at(4)]), LIST[LOCATION]([at(3), at(4)])))
        si

        @Test()
        classify__with_one_error_away_from_end_of_input__is_invalid() is
            are_equal(COMPLETENESS.INVALID, classify(LIST[LOCATION]([at(3), at(1)]), LIST[LOCATION]([at(3)])))
        si

        // An error recorded at end of input but rolled back by a speculative
        // parse leaves its location behind; it decides nothing unless the
        // parse that stood reported it too.
        @Test()
        classify__with_extra_end_of_input_locations__ignores_them() is
            are_equal(COMPLETENESS.INVALID, classify(LIST[LOCATION]([at(1)]), LIST[LOCATION]([at(3), at(5)])))
        si

        // Locations are compared by position, not by identity: the report
        // and the record are separate LOCATION values.
        @Test()
        classify__matches_locations_by_position() is
            are_equal(COMPLETENESS.INCOMPLETE, classify(LIST[LOCATION]([at(7)]), LIST[LOCATION]([at(7)])))
        si
    si
si
