namespace Syntax.UnitTests is
    use Collections.LIST;
    use Collections.MAP;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The reliance judge's answer for every IR value kind must be
    // deliberate: each concrete kind under IR.Values is either
    // dispatched in JUDGE_RELIANCES._judge_shallow or listed here as
    // exempt with the reason no narrowing fact can lean through it.
    // A new value kind fails this test until it is classified, so
    // nothing silently joins the unjudged set.
    @TestClass()
    class JUDGE_RELIANCES_COVERAGE_TESTS is
        init() is si

        // Kinds the dispatch in _judge_shallow handles explicitly.
        // Mirrors that dispatch chain - keep the two in step.
        // Store.SYMBOL's subclasses reach the same branch by subtype
        // dispatch and are listed with it.
        _judged_kinds() -> MAP[string, string] is
            let kinds = MAP[string, string]();

            kinds["IR.Values.Call.INSTANCE"] = "arguments against the formals, receiver against the member's owner";
            kinds["IR.Values.Call.STRUCT"] = "arguments against the formals, receiver against the member's owner";
            kinds["IR.Values.Call.STATIC"] = "arguments against the formals";
            kinds["IR.Values.Call.GLOBAL"] = "arguments against the formals";
            kinds["IR.Values.Call.CLOSURE"] = "the invocation's receiver and the function type's parameter slots";
            kinds["IR.Values.NEW"] = "constructor arguments against the formals";
            kinds["IR.Values.Store.SYMBOL"] = "the stored value against the symbol's declared type; subclasses GLOBAL_FIELD, INSTANCE_FIELD, STATIC_FIELD, LOCAL_VARIABLE and LOCAL_ARGUMENT dispatch here too";
            kinds["IR.Values.Store.GLOBAL_FIELD"] = "store of a subclass of Store.SYMBOL";
            kinds["IR.Values.Store.INSTANCE_FIELD"] = "store of a subclass of Store.SYMBOL";
            kinds["IR.Values.Store.STATIC_FIELD"] = "store of a subclass of Store.SYMBOL";
            kinds["IR.Values.Store.LOCAL_VARIABLE"] = "store of a subclass of Store.SYMBOL";
            kinds["IR.Values.Store.LOCAL_ARGUMENT"] = "store of a subclass of Store.SYMBOL";
            kinds["IR.Values.Store.INDIRECT"] = "the stored value against the slot type";
            kinds["IR.Values.SEQUENCE"] = "each element against the element type";
            kinds["IR.Values.Load.INSTANCE_FIELD"] = "the load's receiver against the member's owner";
            kinds["IR.Values.TUPLE"] = "each element against the tuple's element types";

            return kinds;
        si

        // Kinds no fact can lean through, each with the reason. A
        // re-checking construct proves its fact at runtime; a
        // constant, function value or local cannot hold a heap fact;
        // a wrapper or lowering node is judged at the edge that
        // produces it or never carries a compiled expression's value.
        _exempt_kinds() -> MAP[string, string] is
            let kinds = MAP[string, string]();

            kinds["IR.Values.Call.INNATE"] = "intrinsic operations are identity comparisons and scalar operations, valid at any type and null-tolerant";
            kinds["IR.Values.CAST"] = "casts the program wrote are judged at the CAST tree node; compiler-synthesised unchecked casts decline rather than trust";

            kinds["IR.Values.Load.LOCAL_VARIABLE"] = "a local is unreachable to callees, so its facts cannot be crossed";
            kinds["IR.Values.Load.LOCAL_ARGUMENT"] = "an argument is unreachable to callees, so its facts cannot be crossed";
            kinds["IR.Values.Load.ARGUMENT_SLOT"] = "an argument slot is unreachable to callees, so its facts cannot be crossed";
            kinds["IR.Values.Load.TEMP"] = "a compiler temporary is unreachable to callees, so its facts cannot be crossed";
            kinds["IR.Values.Load.SYMBOL"] = "base of the concrete load kinds, classified here individually";
            kinds["IR.Values.Load.GLOBAL_FIELD"] = "only consumed through member loads and call arguments, which are judged at their own dispatch";
            kinds["IR.Values.Load.STATIC_FIELD"] = "only consumed through member loads and call arguments, which are judged at their own dispatch";
            kinds["IR.Values.Load.REFERENCE_SELF"] = "self is judged as the receiver at every dispatched call site";
            kinds["IR.Values.Load.OUTER_SELF"] = "self is judged as the receiver at every dispatched call site";
            kinds["IR.Values.Load.VALUE_SELF"] = "self is judged as the receiver at every dispatched call site";
            kinds["IR.Values.Load.SUPER"] = "self is judged as the receiver at every dispatched call site";
            kinds["IR.Values.Load.DELEGATE"] = "function values are judged by the purity-slot machinery, not narrowing facts";
            kinds["IR.Values.Load.FUNCTION_POINTER"] = "function values are judged by the purity-slot machinery, not narrowing facts";
            kinds["IR.Values.Load.GLOBAL_ANONYMOUS_FUNCTION"] = "function values are judged by the purity-slot machinery, not narrowing facts";
            kinds["IR.Values.Load.INSTANCE_ANONYMOUS_FUNCTION"] = "function values are judged by the purity-slot machinery, not narrowing facts";
            kinds["IR.Values.Load.STATIC_ANONYMOUS_FUNCTION"] = "function values are judged by the purity-slot machinery, not narrowing facts";

            kinds["IR.Values.Literal.NUMBER"] = "a literal carries no provenance";
            kinds["IR.Values.Literal.STRING"] = "a literal carries no provenance";
            kinds["IR.Values.Literal.DECIMAL"] = "a literal carries no provenance";
            kinds["IR.Values.NULL"] = "the absent value carries no provenance";
            kinds["IR.Values.DEFAULT"] = "a default-value placeholder carries no provenance";
            kinds["IR.Values.DUMMY"] = "an error placeholder carries no provenance";
            kinds["IR.Values.TYPE_EXPRESSION"] = "a type token carries no provenance";
            kinds["IR.Values.TYPEOF"] = "a type token carries no provenance";

            kinds["IR.Values.ISA"] = "a runtime type test re-checks the fact";
            kinds["IR.Values.HAS_VALUE"] = "a presence test re-checks the fact";
            kinds["IR.Values.COALESCE_LOAD"] = "a coalescing read re-checks presence";
            kinds["IR.Values.STACK_TOP"] = "a coalescing read re-checks presence";
            kinds["IR.Values.STACK_TOP_ADDRESS"] = "a coalescing read re-checks presence";
            kinds["IR.Values.NULL_COALESCE"] = "the ?? operator re-checks presence";
            kinds["IR.Values.NULL_COALESCE_VALUE"] = "the ?? operator re-checks presence";
            kinds["IR.Values.REFERENCE_NULL_CHECK"] = "a null check re-checks presence";
            kinds["IR.Values.DEREF"] = "an unwrap re-checks presence";
            kinds["IR.Values.NARROW_VIEW"] = "a narrowing projection re-checks at every read";
            kinds["IR.Values.NARROW_PROJECT"] = "a narrowing projection re-checks at every read";

            kinds["IR.Values.EQUALITY_COMPARISON"] = "a comparison is valid at the wide type; an underlying operator call is judged at its own dispatch";
            kinds["IR.Values.NULL_SAFE_EQUALITY"] = "a comparison is valid at the wide type; an underlying operator call is judged at its own dispatch";
            kinds["IR.Values.COMPARE_ORDER_TO_ZERO"] = "an ordering comparison is valid at the wide type";
            kinds["IR.Values.NOT"] = "negation is valid at the wide type";

            kinds["IR.Values.BOX"] = "a reshaping wrapper; the wrapped value is judged at the edge that produces it";
            kinds["IR.Values.UNBOX"] = "a reshaping wrapper; the wrapped value is judged at the edge that produces it";
            kinds["IR.Values.CONVERT"] = "a synthesised conversion declines rather than trusts";
            kinds["IR.Values.DECIMAL_CONVERT"] = "a synthesised conversion declines rather than trusts";
            kinds["IR.Values.DECIMAL_CALL"] = "a synthesised conversion declines rather than trusts";
            kinds["IR.Values.TYPE_WRAPPER"] = "a reshaping wrapper; the wrapped value is judged at the edge that produces it";
            kinds["IR.Values.WRAPPER"] = "a reshaping wrapper; the wrapped value is judged at the edge that produces it";
            kinds["IR.Values.WRAP_OPTIONAL"] = "widening into an optional leans on no fact";
            kinds["IR.Values.CONSTRAINED"] = "a constrained-call marker; the call itself is judged at its own dispatch";
            kinds["IR.Values.MEMOIZED_DELEGATE"] = "a delegate cache; the function value is judged by the purity-slot machinery";
            kinds["IR.Values.ADDRESS"] = "an address-taken marker; the value is judged at the edge that produces it";

            kinds["IR.Values.BLOCK"] = "an IL block; no value flows through it to a typed slot";
            kinds["IR.Values.DUMMY_BLOCK"] = "an IL block; no value flows through it to a typed slot";
            kinds["IR.Values.INSTRUCTION"] = "a raw IL instruction produced by lowering";
            kinds["IR.Values.NEW_RANGE"] = "a range-construction lowering";
            kinds["IR.Values.MAX_STACK"] = "an IL bookkeeping node";
            kinds["IR.Values.MARK_LABEL"] = "an IL bookkeeping node";
            kinds["IR.Values.BRANCH_TO"] = "an IL bookkeeping node";
            kinds["IR.Values.TRY_START"] = "an IL bookkeeping node";
            kinds["IR.Values.TRY_END"] = "an IL bookkeeping node";
            kinds["IR.Values.TRY_EXTENT"] = "an IL bookkeeping node";
            kinds["IR.Values.HANDLER_START"] = "an IL bookkeeping node";
            kinds["IR.Values.HANDLER_END"] = "an IL bookkeeping node";
            kinds["IR.Values.PROTECTED_REGION"] = "an IL bookkeeping node";
            kinds["IR.Values.ENTER_FILE"] = "a diagnostic bookkeeping node";
            kinds["IR.Values.LEAVE_FILE"] = "a diagnostic bookkeeping node";
            kinds["IR.Values.RET"] = "a return lowering; the returned value is judged at the RETURN statement";
            kinds["IR.Values.DEFAULT_RETURN"] = "a default-value return carries no provenance";
            kinds["IR.Values.DECLARE_LOCAL"] = "a local-slot declaration carries no value";
            kinds["IR.Values.STORE_TEMP"] = "a temporary's store; the consuming edge is judged at its own dispatch";
            kinds["IR.Values.SKIP"] = "a no-op lowering";
            kinds["IR.Values.ASYNC_METHOD_LAUNCH"] = "an async lowering; the launched call is judged at its own dispatch";
            kinds["IR.Values.AWAIT_SUSPEND"] = "an async lowering; the awaited task is judged at its own dispatch";
            kinds["IR.Values.POST_INCREMENT"] = "a scalar in-place operation; no narrowing fact applies";
            kinds["IR.Values.PRE_DECREMENT"] = "a scalar in-place operation; no narrowing fact applies";
            kinds["IR.Values.CALL_STRING_CONCAT"] = "an assert-message lowering; interpolation leans on no fact";
            kinds["IR.Values.CALL_STRING_EQUALITY"] = "an assert-message lowering";
            kinds["IR.Values.NEW_ASSERT_FAILED_EXCEPTION"] = "an assert lowering carries no provenance";
            kinds["IR.Values.Need.STORE"] = "a compile-time expectation marker, never a runtime value";
            kinds["IR.Values.FUSED_CONSUMER"] = "a pipe-fusion container; the reads and calls of the fused chain are judged at their own dispatch";
            kinds["IR.Values.FUSED_CONSUMER_STAGE"] = "a pipe-fusion stage; the reads and calls of the fused chain are judged at their own dispatch";

            return kinds;
        si

        @Test()
        every_value_kind_is_classified() is
            let value_type = typeof(IR.Values.Value);
            let classified = _judged_kinds();

            for entry in _exempt_kinds() do
                classified[entry.key] = entry.value;
            od

            let unclassified = LIST[string]();

            for type in value_type.assembly.get_types() do
                if type.is_abstract \/ !type.is_subclass_of(value_type) then
                    continue;
                fi

                if let name = type.full_name then
                    if !classified.contains_key(name) then
                        unclassified.add(name);
                    fi
                fi
            od

            are_equal(0, unclassified.count, "unclassified IR value kinds: {unclassified}");
        si

        @Test()
        classifications_name_real_kinds() is
            let value_type = typeof(IR.Values.Value);
            let names = Collections.SET[string]();

            for type in value_type.assembly.get_types() do
                if let name = type.full_name then
                    names.add(name);
                fi
            od

            let stale = LIST[string]();

            for entry in _judged_kinds() do
                if !names.contains(entry.key) then
                    stale.add(entry.key);
                fi
            od

            for entry in _exempt_kinds() do
                if !names.contains(entry.key) then
                    stale.add(entry.key);
                fi
            od

            are_equal(0, stale.count, "classifications that name no IR value kind: {stale}");
        si
    si
si
