namespace Syntax.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Source.LOCATION

    use Syntax.Process.ALLOCATION_FREE_FIXPOINT
    use Syntax.Process.STORE_FREE_FACTS

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.INSTANCE_METHOD

    use Function = Semantic.Symbols.Function

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins the allocation-free solve: a function is allocation-free only
    // when its own body allocates nothing, the walk bounded it, nothing
    // outside the compilation can override it, and every callee and
    // override is allocation-free in turn.
    @TestClass()
    class ALLOCATION_FREE_FIXPOINT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        global_function(name: string) -> GLOBAL_FUNCTION =>
            GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())

        method(name: string, owner: CLASS) -> INSTANCE_METHOD =>
            INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())

        closed_class(name: string) -> CLASS is
            let result = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())
            result.mark_closed()
            return result
        si

        open_class(name: string) -> CLASS is
            let result = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())
            result.mark_open()
            return result
        si

        facts_for(functions: Collections.Iterable[Function]) -> MAP[Function, STORE_FREE_FACTS] is
            let result = MAP[Function, STORE_FREE_FACTS]()
            for f in functions do
                result[f] = STORE_FREE_FACTS()
            od
            return result
        si

        free(facts: MAP[Function, STORE_FREE_FACTS], f: Function) -> bool =>
            ALLOCATION_FREE_FIXPOINT().solve(facts).contains(f)

        @Test()
        Clean_body_with_no_callees__is_allocation_free() is
            let f = global_function("f")
            let facts = facts_for([cast Function(f)])

            is_true(free(facts, f))
        si

        @Test()
        Body_that_allocates__is_not_allocation_free() is
            let f = global_function("f")
            let facts = facts_for([cast Function(f)])
            facts[f].allocates = true

            is_false(free(facts, f))
        si

        @Test()
        Disqualified_body__is_not_allocation_free() is
            let f = global_function("f")
            let facts = facts_for([cast Function(f)])
            facts[f].is_disqualified = true

            is_false(free(facts, f))
        si

        @Test()
        Allocating_callee__makes_its_caller_allocate() is
            let caller = global_function("caller")
            let middle = global_function("middle")
            let leaf = global_function("leaf")
            let facts = facts_for([cast Function(caller), cast Function(middle), cast Function(leaf)])
            facts[caller].add_callee(middle)
            facts[middle].add_callee(leaf)
            facts[leaf].allocates = true

            let solved = ALLOCATION_FREE_FIXPOINT().solve(facts)

            is_false(solved.contains(caller))
            is_false(solved.contains(middle))
        si

        @Test()
        Callee_without_facts__makes_its_caller_allocate() is
            let caller = global_function("caller")
            let unwalked = global_function("unwalked")
            let facts = facts_for([cast Function(caller)])
            facts[caller].add_callee(unwalked)

            is_false(free(facts, caller))
        si

        @Test()
        Constructor_run_by_a_construction__is_a_dependency() is
            let caller = global_function("caller")
            let constructor = method("init", closed_class("THING"))
            let facts = facts_for([cast Function(caller), cast Function(constructor)])
            facts[caller].add_construction_callee(constructor)
            facts[constructor].allocates = true

            is_false(free(facts, caller))
        si

        @Test()
        Allocating_override__makes_the_overridden_method_allocate() is
            let base = method("sides", closed_class("SHAPE"))
            let overrider = method("sides", closed_class("SQUARE"))
            base.add_overrider(overrider)

            let facts = facts_for([cast Function(base), cast Function(overrider)])
            facts[overrider].allocates = true

            is_false(free(facts, base))
            is_false(free(facts, overrider))
        si

        @Test()
        Clean_override__leaves_the_overridden_method_allocation_free() is
            let base = method("sides", closed_class("SHAPE"))
            let overrider = method("sides", closed_class("SQUARE"))
            base.add_overrider(overrider)

            let facts = facts_for([cast Function(base), cast Function(overrider)])

            is_true(free(facts, base))
        si

        @Test()
        Method_of_an_open_class__is_not_allocation_free() is
            let f = method("sides", open_class("SHAPE"))
            let facts = facts_for([cast Function(f)])

            is_false(free(facts, f))
        si

        @Test()
        Indexer_accessor__is_not_allocation_free() is
            let f = method("get_Item", closed_class("GRID"))
            let facts = facts_for([cast Function(f)])
            facts[f].is_indexer_accessor = true

            is_false(free(facts, f))
        si

        @Test()
        Mutual_recursion_between_clean_bodies__is_allocation_free() is
            let even = global_function("even")
            let odd = global_function("odd")
            let facts = facts_for([cast Function(even), cast Function(odd)])
            facts[even].add_callee(odd)
            facts[odd].add_callee(even)

            let solved = ALLOCATION_FREE_FIXPOINT().solve(facts)

            is_true(solved.contains(even))
            is_true(solved.contains(odd))
        si
    si
si
