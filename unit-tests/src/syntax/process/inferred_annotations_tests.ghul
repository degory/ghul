namespace Syntax.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.Classy
    use Semantic.Symbols.UNION
    use Semantic.Symbols.VARIANT
    use Semantic.Types.NAMED
    use Semantic.Types.ONE_OF
    use Semantic.Types.Type

    use Syntax.Process.INFERRED_ANNOTATIONS

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The type the annotator writes for a closed-hierarchy narrowing is
    // the type narrowed, and it is optional exactly when the narrowing is.
    @TestClass()
    class INFERRED_ANNOTATIONS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        narrowing() -> ONE_OF is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()

            let the_union = UNION(loc(), loc(), Semantic.BLOCK_SCOPE(), "U", LIST[string](), Semantic.BLOCK_SCOPE())
            the_union.add_ancestor(object_class.type!)

            let variants = LIST[Classy]()

            variants.add(cast VARIANT(the_union.declare_variant(loc(), loc(), "A", Semantic.BLOCK_SCOPE(), null)))
            variants.add(cast VARIANT(the_union.declare_variant(loc(), loc(), "B", Semantic.BLOCK_SCOPE(), null)))

            return cast ONE_OF(ONE_OF.create(cast NAMED(the_union.type!), variants)!)
        si

        @Test()
        Calling__writable_type__on_a_narrowing__should_give_the_type_narrowed() is
            let one_of = narrowing()

            let written = INFERRED_ANNOTATIONS.writable_type(one_of)

            is_false(isa ONE_OF(written))
            are_same(one_of.underlying_type.symbol, (cast NAMED(written)).symbol)
            is_false(written.is_optional)
        si

        @Test()
        Calling__writable_type__on_an_optional_narrowing__should_keep_it_optional() is
            let one_of = narrowing()

            let written = INFERRED_ANNOTATIONS.writable_type(one_of.as_optional())

            is_false(isa ONE_OF(written))
            is_true(written.is_optional)
        si
    si
si
