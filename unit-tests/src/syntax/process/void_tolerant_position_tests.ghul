namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Types.Type
    use Semantic.Types.ERROR

    use Syntax.Process.VOID_TOLERANT_POSITION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins the decision VOID_TOLERANT_POSITION factors out of the `if` /
    // `case` value formation: whether a composite in a void-tolerant
    // position - the body of a function literal whose return type is
    // still being inferred, or a function body's implicit tail - should
    // produce no value at all. The visitor orchestration that supplies
    // the arm values is covered by the integration tests.
    @TestClass()
    class VOID_TOLERANT_POSITION_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        settled_type() -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Settled", LIST[string](), Semantic.BLOCK_SCOPE()).type!

        // --- declines_value ----------------------------------------------

        @Test()
        declines_value__when_no_arm_yields_a_value__is_true() is
            // Void arms, diverging arms, or a mix: the composite is the
            // statement it is, and a void-tolerant consumer (an implicit
            // function tail, or an inferred-return literal body) takes no
            // value from it.
            is_true(VOID_TOLERANT_POSITION.declines_value(true, false))
        si

        @Test()
        declines_value__when_an_arm_yields_a_value__is_false() is
            // Mixed arms keep the value form, so the void arm is reported
            // where it cannot be consumed rather than silently dropped.
            is_false(VOID_TOLERANT_POSITION.declines_value(true, true))
        si

        @Test()
        declines_value__when_the_position_is_not_void_tolerant__is_false() is
            // `let x = if ... fi` over void arms stays an error.
            is_false(VOID_TOLERANT_POSITION.declines_value(false, false))
        si

        // --- arm classification ------------------------------------------

        @Test()
        counts_as_non_void__for_a_settled_type__is_true() is
            is_true(VOID_TOLERANT_POSITION.counts_as_non_void(settled_type()))
        si

        @Test()
        counts_as_non_void__for_an_error_type__is_false() is
            // An arm already reported is neither: forcing the value form
            // from it would pile a second diagnostic onto the same arm.
            is_false(VOID_TOLERANT_POSITION.counts_as_non_void(ERROR()))
        si
    si
si
