namespace Syntax.Process.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Types.Type;
    use Semantic.Types.ERROR;

    use Syntax.Process.VOID_TOLERANT_POSITION;

    // Pins the decision VOID_TOLERANT_POSITION factors out of the `if` /
    // `case` value formation: whether a composite in the body of a
    // function literal whose return type is still being inferred should
    // produce no value at all. The visitor orchestration that supplies
    // the arm values is covered by the integration tests.
    class VOID_TOLERANT_POSITION_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        settled_type() -> Type =>
            CLASS(loc(), loc(), null, "Settled", LIST[string](), null).type!;

        // --- declines_value ----------------------------------------------

        declines_value__when_every_arm_is_void__is_true() is
            @test()

            Assert.is_true(VOID_TOLERANT_POSITION.declines_value(true, false, true, false));
        si

        declines_value__when_an_arm_yields_a_value__is_false() is
            @test()

            // Mixed arms keep the value form, so the void arm is reported
            // where it cannot be consumed rather than silently dropped.
            Assert.is_false(VOID_TOLERANT_POSITION.declines_value(true, false, true, true));
        si

        declines_value__when_the_position_is_not_void_tolerant__is_false() is
            @test()

            // `let x = if ... fi` over void arms stays an error.
            Assert.is_false(VOID_TOLERANT_POSITION.declines_value(false, false, true, false));
        si

        declines_value__when_an_expected_type_was_pushed_down__is_false() is
            @test()

            // A written-out return type already settled what the position
            // wants, including a written-out void.
            Assert.is_false(VOID_TOLERANT_POSITION.declines_value(true, true, true, false));
        si

        declines_value__when_no_arm_supplied_a_value__is_false() is
            @test()

            // Every arm diverging is the DIVERGING_VALUE_POSITION case,
            // which settles the return type by its own route.
            Assert.is_false(VOID_TOLERANT_POSITION.declines_value(true, false, false, false));
        si

        // --- arm classification ------------------------------------------

        counts_as_void__for_an_absent_type__is_false() is
            @test()

            Assert.is_false(VOID_TOLERANT_POSITION.counts_as_void(null));
        si

        counts_as_non_void__for_a_settled_type__is_true() is
            @test()

            Assert.is_true(VOID_TOLERANT_POSITION.counts_as_non_void(settled_type()));
        si

        counts_as_non_void__for_an_error_type__is_false() is
            @test()

            // An arm already reported is neither: forcing the value form
            // from it would pile a second diagnostic onto the same arm.
            Assert.is_false(VOID_TOLERANT_POSITION.counts_as_non_void(ERROR()));
        si

        counts_as_void__for_an_error_type__is_false() is
            @test()

            Assert.is_false(VOID_TOLERANT_POSITION.counts_as_void(ERROR()));
        si
    si
si
