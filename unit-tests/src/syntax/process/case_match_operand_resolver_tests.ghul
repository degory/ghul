namespace Syntax.Process.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Collections.LIST;

    use Source.LOCATION;

    use Logging.DIAGNOSTICS_STORE;

    use Semantic.OVERLOAD_RESOLVER;

    use Semantic.Symbols.Classy;
    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.ENUM_STRUCT;
    use Semantic.Symbols.INSTANCE_METHOD;
    use Semantic.Types.Type;

    // Pins how CASE_MATCH_OPERAND_RESOLVER picks the operator a
    // `case`'s `when` labels are tested against: prefer `=~`, fall
    // back to `<>`, resolve nothing for a value type or an optional
    // scrutinee (both keep IL generation's original identity/value
    // compare). See generate_il.gen_case_match_test and CASE_STATE.
    class CASE_MATCH_OPERAND_RESOLVER_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        bool_type() -> Type =>
            CLASS(loc(), loc(), null, "bool", LIST[string](), null).type!;

        int_type() -> Type =>
            CLASS(loc(), loc(), null, "int", LIST[string](), null).type!;

        a_class() -> CLASS =>
            CLASS(loc(), loc(), null, "Owner", LIST[string](), null);

        resolver() -> CASE_MATCH_OPERAND_RESOLVER =>
            CASE_MATCH_OPERAND_RESOLVER(OVERLOAD_RESOLVER(DIAGNOSTICS_STORE()));

        add_equality(owner: Classy) -> INSTANCE_METHOD is
            let operator = INSTANCE_METHOD(loc(), loc(), owner, "=~", null);

            operator.arguments = LIST[Type]([owner.type!]);
            operator.return_type = bool_type();

            owner.add_member(operator);

            return operator;
        si

        add_order(owner: Classy) -> INSTANCE_METHOD is
            let operator = INSTANCE_METHOD(loc(), loc(), owner, "<>", null);

            operator.arguments = LIST[Type]([owner.type!]);
            operator.return_type = int_type();

            owner.add_member(operator);

            return operator;
        si

        Resolving__prefers_equality_operator_when_both_are_declared() is
            @test()

            let owner = a_class();
            let equality = add_equality(owner);

            add_order(owner);

            let (equality_operator, order_operator) = resolver().resolve(owner.type, loc());

            Assert.are_same(equality, equality_operator);
            Assert.is_null(order_operator);
        si

        Resolving__falls_back_to_order_operator_when_equality_is_undeclared() is
            @test()

            let owner = a_class();
            let order = add_order(owner);

            let (equality_operator, order_operator) = resolver().resolve(owner.type, loc());

            Assert.is_null(equality_operator);
            Assert.are_same(order, order_operator);
        si

        Resolving__resolves_nothing_when_neither_operator_is_declared() is
            @test()

            let owner = a_class();

            let (equality_operator, order_operator) = resolver().resolve(owner.type, loc());

            Assert.is_null(equality_operator);
            Assert.is_null(order_operator);
        si

        Resolving__skips_a_value_type_even_with_equality_declared() is
            @test()

            let owner = ENUM_STRUCT(loc(), loc(), null, "Level", null);

            add_equality(owner);

            let (equality_operator, order_operator) = resolver().resolve(owner.type, loc());

            Assert.is_null(equality_operator);
            Assert.is_null(order_operator);
        si

        Resolving__skips_an_optional_scrutinee_even_with_equality_declared() is
            @test()

            let owner = a_class();

            add_equality(owner);

            let (equality_operator, order_operator) = resolver().resolve(owner.type!.as_optional(), loc());

            Assert.is_null(equality_operator);
            Assert.is_null(order_operator);
        si

        Resolving__resolves_nothing_for_a_null_scrutinee_type() is
            @test()

            let (equality_operator, order_operator) = resolver().resolve(null, loc());

            Assert.is_null(equality_operator);
            Assert.is_null(order_operator);
        si
    si
si
