namespace Syntax.Process.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use IR.Values.DUMMY;
    use IR.Values.Value;

    use Semantic.Symbols.CLASS;
    use Semantic.Types.ERROR;

    use Syntax.Process.COMPILE_CALLS;

    use Trees.Expressions.DEFAULT;
    use Trees.Expressions.Expression;
    use Trees.Expressions.IDENTIFIER;
    use Trees.Identifiers.Identifier;
    use Trees.TypeExpressions.INFER;

    // Tests for COMPILE_CALLS.is_unresolved_default_argument and
    // has_unresolved_default_argument — the gates that decide whether
    // a call's argument walk needs a retry to give a bare `_` its
    // callee-supplied type. A `_` only ever counts as unresolved when
    // it carries no explicit `_[T]` type argument and its first-walk
    // value is missing or ERROR-typed; `_[T]` is never retried, and
    // an already-resolved `_` (a synthesised one filling an omitted
    // named argument, or a second walk that already succeeded) is
    // left alone.
    class DEFAULT_CALL_ARGUMENT_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        int_class() -> CLASS => CLASS(loc(), loc(), null, "int", LIST[string](), null);

        make_identifier(name: string) -> IDENTIFIER =>
            IDENTIFIER(loc(), Identifier(loc(), name));

        make_bare_default() -> DEFAULT => DEFAULT(loc(), null);

        make_explicit_default() -> DEFAULT => DEFAULT(loc(), INFER(loc()));

        resolve_with_error(`default: DEFAULT) is
            `default.compile_expressions_state.value = DUMMY(cast Semantic.Types.Type(ERROR()), loc());
        si

        resolve_with_concrete_type(`default: DEFAULT) is
            `default.compile_expressions_state.value = DUMMY(int_class().type!, loc());
        si

        Calling__is_unresolved_default_argument__with_a_non_default_expression__returns_false() is
            @test()

            Assert.is_false(COMPILE_CALLS.is_unresolved_default_argument(make_identifier("x")));
        si

        Calling__is_unresolved_default_argument__with_an_unwalked_bare_default__returns_true() is
            @test()

            Assert.is_true(COMPILE_CALLS.is_unresolved_default_argument(make_bare_default()));
        si

        Calling__is_unresolved_default_argument__with_an_error_typed_bare_default__returns_true() is
            @test()

            let `default = make_bare_default();
            resolve_with_error(`default);

            Assert.is_true(COMPILE_CALLS.is_unresolved_default_argument(`default));
        si

        Calling__is_unresolved_default_argument__with_a_resolved_bare_default__returns_false() is
            @test()

            let `default = make_bare_default();
            resolve_with_concrete_type(`default);

            Assert.is_false(COMPILE_CALLS.is_unresolved_default_argument(`default));
        si

        // `default[T]` always means the literal `default(T)` - never
        // retried, regardless of whether it has been walked yet.
        Calling__is_unresolved_default_argument__with_an_unwalked_explicit_default__returns_false() is
            @test()

            Assert.is_false(COMPILE_CALLS.is_unresolved_default_argument(make_explicit_default()));
        si

        Calling__is_unresolved_default_argument__with_an_error_typed_explicit_default__returns_false() is
            @test()

            let `default = make_explicit_default();
            resolve_with_error(`default);

            Assert.is_false(COMPILE_CALLS.is_unresolved_default_argument(`default));
        si

        Calling__has_unresolved_default_argument__with_only_identifiers__returns_false() is
            @test()

            let args = LIST[Expression]();
            args.add(make_identifier("a"));
            args.add(make_identifier("b"));

            Assert.is_false(COMPILE_CALLS.has_unresolved_default_argument(args));
        si

        Calling__has_unresolved_default_argument__with_empty_list__returns_false() is
            @test()

            Assert.is_false(COMPILE_CALLS.has_unresolved_default_argument(LIST[Expression]()));
        si

        Calling__has_unresolved_default_argument__with_a_resolved_default_only__returns_false() is
            @test()

            let `default = make_bare_default();
            resolve_with_concrete_type(`default);

            let args = LIST[Expression]();
            args.add(make_identifier("a"));
            args.add(`default);

            Assert.is_false(COMPILE_CALLS.has_unresolved_default_argument(args));
        si

        Calling__has_unresolved_default_argument__with_one_unresolved_default__returns_true() is
            @test()

            let args = LIST[Expression]();
            args.add(make_identifier("a"));
            args.add(make_bare_default());

            Assert.is_true(COMPILE_CALLS.has_unresolved_default_argument(args));
        si
    si
si
