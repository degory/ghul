namespace Syntax.Process.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Types.Type;

    use Syntax.Process.NULL_ARGUMENT_CHECK;

    // Tests for the rule behind the non-optional-by-default warning at
    // a call argument. The decision has two halves: whether the formal
    // is a slot that cannot hold null, and whether the argument as
    // written is a bare `null` that has not already been reported by
    // its own visit.
    class NULL_ARGUMENT_CHECK_TESTS is
        @test()

        _scope: Semantic.BLOCK_SCOPE;

        init() is
            _scope = Semantic.BLOCK_SCOPE();
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        a_reference_type() -> Type =>
            CLASS(loc(), loc(), _scope, "Thing", LIST[string](), null).type!;

        a_null_argument() -> Trees.Expressions.NULL =>
            Trees.Expressions.NULL(loc());

        Reporting_a_null_argument_against_a_reference_formal() is
            @test()

            Assert.is_true(NULL_ARGUMENT_CHECK().should_report(a_null_argument(), a_reference_type()));
        si

        Reporting_a_null_argument_against_an_optional_formal() is
            @test()

            Assert.is_false(
                NULL_ARGUMENT_CHECK().should_report(a_null_argument(), a_reference_type().as_optional())
            );
        si

        // A literal walked with the formal already pushed onto it has
        // been reported by its own visit; reporting again would double
        // up on the same location.
        Reporting_a_null_argument_that_already_carries_the_constraint() is
            @test()

            let argument = a_null_argument();

            argument.set_expected_type(a_reference_type(), "");

            Assert.is_false(NULL_ARGUMENT_CHECK().should_report(argument, a_reference_type()));
        si

        Reporting_an_argument_that_is_not_a_null_literal() is
            @test()

            let argument = Trees.Expressions.Literals.STRING(loc(), "text");

            Assert.is_false(NULL_ARGUMENT_CHECK().should_report(argument, a_reference_type()));
        si

        Treating_a_reference_type_as_a_slot_that_cannot_hold_null() is
            @test()

            Assert.is_true(NULL_ARGUMENT_CHECK().is_non_optional_reference(a_reference_type()));
        si

        Treating_an_absent_type_as_no_constraint() is
            @test()

            Assert.is_false(NULL_ARGUMENT_CHECK().is_non_optional_reference(null));
        si
    si
si
