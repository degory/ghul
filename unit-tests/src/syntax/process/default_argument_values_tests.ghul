namespace Syntax.Process.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use NSubstitute;
    use NSubstitute.SubstituteExtensions.returns;

    use Source.LOCATION;

    use Semantic.Lookups.InnateSymbolLookup;
    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.ENUM_STRUCT;
    use Semantic.Symbols.NAMESPACE;
    use Semantic.Types.Type;

    use Syntax.Process.DEFAULT_ARGUMENT_VALUES;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for the stored-default-string -> IR value dispatch shared by
    // an omitted call argument and an omitted attribute constructor
    // argument. Each `get_*_type()` mock returns a distinct Type
    // instance so a build() result's type can be identity-compared
    // back against the fixture.
    @TestClass()
    class DEFAULT_ARGUMENT_VALUES_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        type_named(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!;

        // An enum whose recorded underlying type is the one given -
        // null for the ghūl-declared shape, which records nothing.
        enum_type_backed_by(underlying: Type?) -> Type is
            let owner = NAMESPACE(loc(), "Test", null, ".Test", false);
            let `enum = ENUM_STRUCT(loc(), loc(), owner, "Level", owner);

            `enum.underlying_type = underlying;

            return `enum.type!;
        si

        build_lookup() -> InnateSymbolLookup is
            let arguments = System.Array.empty`[object]();
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments);

            lookup.get_string_type() |> returns(type_named("string"), null);
            lookup.get_bool_type() |> returns(type_named("bool"), null);
            lookup.get_char_type() |> returns(type_named("char"), null);
            lookup.get_byte_type() |> returns(type_named("byte"), null);
            lookup.get_ubyte_type() |> returns(type_named("ubyte"), null);
            lookup.get_short_type() |> returns(type_named("short"), null);
            lookup.get_ushort_type() |> returns(type_named("ushort"), null);
            lookup.get_int_type() |> returns(type_named("int"), null);
            lookup.get_uint_type() |> returns(type_named("uint"), null);
            lookup.get_long_type() |> returns(type_named("long"), null);
            lookup.get_ulong_type() |> returns(type_named("ulong"), null);
            lookup.get_single_type() |> returns(type_named("single"), null);
            lookup.get_double_type() |> returns(type_named("double"), null);

            return lookup;
        si

        @Test()
        Calling__build__with_null_stored__should_return_default() is
            let lookup = build_lookup();
            let int_type = lookup.get_int_type();

            let result = DEFAULT_ARGUMENT_VALUES.build(null, int_type, lookup);

            is_true(isa IR.Values.DEFAULT(result));
        si

        @Test()
        Calling__build__with_default_sentinel__should_return_default() is
            let lookup = build_lookup();
            let int_type = lookup.get_int_type();

            let result = DEFAULT_ARGUMENT_VALUES.build("default", int_type, lookup);

            is_true(isa IR.Values.DEFAULT(result));
        si

        // The sentinel belongs to the argument-default channel, not to
        // the conversion. A constant's value is whatever a library author
        // wrote, so a caller coming in through `build_value` gets the
        // word back as the string it is.
        @Test()
        Calling__build_value__with_default_sentinel__should_return_string_literal() is
            let lookup = build_lookup();
            let string_type = lookup.get_string_type();

            let result = cast IR.Values.Literal.STRING(DEFAULT_ARGUMENT_VALUES.build_value("default", string_type, lookup));

            are_equal("default", result.value);
        si

        // A value is rendered into metadata in the invariant culture, so
        // it has to be read back in that one. Read where `.` groups
        // digits instead of separating the fraction, the largest double
        // does not fail to parse - it parses to infinity.
        @Test()
        Calling__build_value__under_a_comma_decimal_culture__should_read_the_invariant_form() is
            let lookup = build_lookup();
            let double_type = lookup.get_double_type();

            let previous = System.Globalization.CultureInfo.current_culture;

            try
                System.Globalization.CultureInfo.current_culture =
                    System.Globalization.CultureInfo("de-DE");

                let result =
                    cast IR.Values.Literal.NUMBER(
                        DEFAULT_ARGUMENT_VALUES.build_value("1.7976931348623157E+308", double_type, lookup)
                    );

                // Asserted on the constant itself: rendering it back to
                // text would go through the very culture under test.
                if let r8: IR.Values.Literal.CONSTANT.R8 = result.constant then
                    are_equal(
                        9218868437227405311L,
                        System.BitConverter.double_to_int64_bits(r8.value)
                    );
                else
                    is_true(false, "expected a double constant");
                fi
            finally
                System.Globalization.CultureInfo.current_culture = previous;
            yrt
        si

        @Test()
        Calling__build_value__with_int_type__should_return_the_number() is
            let lookup = build_lookup();
            let int_type = lookup.get_int_type();

            let result = cast IR.Values.Literal.NUMBER(DEFAULT_ARGUMENT_VALUES.build_value("42", int_type, lookup));

            are_equal("42", result.rendered);
        si

        @Test()
        Calling__build__with_string_type__should_return_string_literal() is
            let lookup = build_lookup();
            let string_type = lookup.get_string_type();

            let result = cast IR.Values.Literal.STRING(DEFAULT_ARGUMENT_VALUES.build("hello", string_type, lookup));

            are_equal("hello", result.value);
        si

        @Test()
        Calling__build__with_bool_type_true__should_return_one() is
            let lookup = build_lookup();
            let bool_type = lookup.get_bool_type();

            let result = cast IR.Values.Literal.NUMBER(DEFAULT_ARGUMENT_VALUES.build("True", bool_type, lookup));

            are_equal("1", result.rendered);
        si

        @Test()
        Calling__build__with_bool_type_false__should_return_zero() is
            let lookup = build_lookup();
            let bool_type = lookup.get_bool_type();

            let result = cast IR.Values.Literal.NUMBER(DEFAULT_ARGUMENT_VALUES.build("False", bool_type, lookup));

            are_equal("0", result.rendered);
        si

        @Test()
        Calling__build__with_int_type__should_return_number_literal() is
            let lookup = build_lookup();
            let int_type = lookup.get_int_type();

            let result = cast IR.Values.Literal.NUMBER(DEFAULT_ARGUMENT_VALUES.build("-1", int_type, lookup));

            are_equal("-1", result.rendered);
            is_true(isa IR.Values.Literal.CONSTANT.I4(result.constant));
        si

        @Test()
        Calling__build__with_long_type__should_use_i8_suffix() is
            let lookup = build_lookup();
            let long_type = lookup.get_long_type();

            let result = cast IR.Values.Literal.NUMBER(DEFAULT_ARGUMENT_VALUES.build("9000000000", long_type, lookup));

            is_true(isa IR.Values.Literal.CONSTANT.I8(result.constant));
        si

        @Test()
        Calling__build__with_ulong_above_long_max__should_keep_the_stored_value() is
            // An ordinary .NET default that no signed parse can read.
            // Reading it as signed and falling back to zero would emit
            // a wrong default with nothing to show for it, so the value
            // is checked rather than just the suffix.
            let lookup = build_lookup();
            let ulong_type = lookup.get_ulong_type();

            let result =
                cast IR.Values.Literal.NUMBER(
                    DEFAULT_ARGUMENT_VALUES.build("18446744073709551615", ulong_type, lookup));

            are_equal(cast long(18446744073709551615UL), (cast IR.Values.Literal.CONSTANT.I8(result.constant)).value);
        si

        @Test()
        Calling__build__with_char_type_and_nonempty_string__should_return_char_code() is
            let lookup = build_lookup();
            let char_type = lookup.get_char_type();

            let result = cast IR.Values.Literal.NUMBER(DEFAULT_ARGUMENT_VALUES.build("A", char_type, lookup));

            are_equal("{cast int('A')}", result.rendered);
        si

        // An enum is read at the width it was declared over, which only
        // an import records. A value that does not fit int32 keeps its
        // full bit pattern rather than answering its low 32 bits.
        @Test()
        Calling__build_value__with_an_enum_backed_by_long__should_return_the_full_pattern() is
            let lookup = build_lookup();

            let result =
                cast IR.Values.Literal.NUMBER(
                    DEFAULT_ARGUMENT_VALUES.build_value(
                        "4294967296",
                        enum_type_backed_by(lookup.get_long_type()),
                        lookup));

            if let i8: IR.Values.Literal.CONSTANT.I8 = result.constant then
                are_equal(4294967296L, i8.value);
            else
                is_true(false, "expected an int64 constant");
            fi
        si

        @Test()
        Calling__build_value__with_an_enum_backed_by_ulong__should_return_the_full_pattern() is
            let lookup = build_lookup();

            let result =
                cast IR.Values.Literal.NUMBER(
                    DEFAULT_ARGUMENT_VALUES.build_value(
                        "18446744073709551615",
                        enum_type_backed_by(lookup.get_ulong_type()),
                        lookup));

            if let i8: IR.Values.Literal.CONSTANT.I8 = result.constant then
                are_equal(cast long(18446744073709551615UL), i8.value);
            else
                is_true(false, "expected an int64 constant");
            fi
        si

        @Test()
        Calling__build_value__with_an_enum_backed_by_int__should_return_the_number() is
            let lookup = build_lookup();

            let result =
                cast IR.Values.Literal.NUMBER(
                    DEFAULT_ARGUMENT_VALUES.build_value(
                        "42",
                        enum_type_backed_by(lookup.get_int_type()),
                        lookup));

            if let i4: IR.Values.Literal.CONSTANT.I4 = result.constant then
                are_equal(42, i4.value);
            else
                is_true(false, "expected an int32 constant");
            fi
        si

        // A ghūl-declared enum is always int32-backed and records no
        // underlying type, so it keeps the int32 path - the case every
        // enum in a ghūl source program takes.
        @Test()
        Calling__build_value__with_an_enum_that_records_no_underlying_type__should_return_the_number() is
            let lookup = build_lookup();

            let result =
                cast IR.Values.Literal.NUMBER(
                    DEFAULT_ARGUMENT_VALUES.build_value("7", enum_type_backed_by(null), lookup));

            if let i4: IR.Values.Literal.CONSTANT.I4 = result.constant then
                are_equal(7, i4.value);
            else
                is_true(false, "expected an int32 constant");
            fi
        si
    si
si
