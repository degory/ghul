namespace Syntax.Process.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Types.NAMED
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins the missing-else decision for value-consuming ifs: absence
    // needs somewhere to go. A body with no completing arm has nothing
    // to be absent from; a non-optional expected type has no slot for
    // it. Everything else yields.
    @TestClass()
    class IF_MISSING_ELSE_DECIDER_TESTS is
        init() is
            super.init()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> Collections.LIST[string] => Collections.LIST[string]()

        a_reference_class() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Cat", empty_names(), Semantic.BLOCK_SCOPE())

        a_reference_optional() -> Semantic.Types.Type is
            let cat = cast NAMED(a_reference_class().type)
            return cat.as_optional()
        si

        the_decider() -> IF_MISSING_ELSE_DECIDER => IF_MISSING_ELSE_DECIDER()

        @Test()
        no_expected_type_with_value_arms__yields_absence() is
            is_true(the_decider().decide(null, true) == IfMissingElseDecision.YIELD_ABSENCE)
        si

        @Test()
        no_expected_type_without_value_arms__requires_else() is
            is_true(the_decider().decide(null, false) == IfMissingElseDecision.REQUIRE_ELSE)
        si

        @Test()
        non_optional_expected_type__requires_else() is
            let cat = cast NAMED(a_reference_class().type)

            is_true(the_decider().decide(cat, true) == IfMissingElseDecision.REQUIRE_ELSE)
        si

        @Test()
        optional_reference_expected_type__yields_absence() is
            is_true(the_decider().decide(a_reference_optional(), true) == IfMissingElseDecision.YIELD_ABSENCE)
        si
    si
si
