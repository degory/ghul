namespace Syntax.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Syntax.Process.RETURN_PACK_STATE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The wrapper a walk declares for a pack-marked return survives the
    // clearing between walks as the node's spare, taken up by the next
    // walk at the same arity so one wrapper closure serves every walk;
    // a full clear, and a spare of another arity, leave nothing to take.
    @TestClass()
    class RETURN_PACK_STATE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        literal(arity: int) -> Trees.Expressions.FUNCTION is
            let parameters = LIST[Trees.Expressions.Expression]()

            for i in 0..arity do
                parameters.add(
                    Trees.Expressions.VARIABLE(
                        loc(),
                        Trees.Identifiers.Identifier(loc(), "p{i}"),
                        Trees.TypeExpressions.INFER(loc()),
                        null
                    )
                )
            od

            return
                Trees.Expressions.FUNCTION(
                    loc(),
                    Trees.Expressions.LIST(loc(), parameters),
                    Trees.TypeExpressions.INFER(loc()),
                    Trees.Bodies.EXPRESSION(loc(), Trees.Expressions.Literals.INTEGER(loc(), "42")),
                    false
                )
        si

        hoist() -> Semantic.Symbols.Symbol =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "HOIST", LIST[string](), Semantic.BLOCK_SCOPE())

        @Test()
        Calling__clear_outputs__then__take_spare__at_the_same_arity__should_hand_back_the_wrapper() is
            let state = RETURN_PACK_STATE()
            let wrapper = literal(2)
            let local = hoist()

            state.literal = wrapper
            state.hoist = local

            state.clear_outputs()

            is_null(state.literal)

            let spare = state.take_spare(2)

            is_true(spare?)
            are_same(wrapper, spare!.`1)
            are_same(local, spare!.`0)
            is_null(state.take_spare(2))
        si

        @Test()
        Calling__take_spare__at_another_arity__should_leave_the_spare_untaken() is
            let state = RETURN_PACK_STATE()

            state.literal = literal(2)
            state.hoist = hoist()

            state.clear_outputs()

            is_null(state.take_spare(3))
            is_true(state.take_spare(2)?)
        si

        @Test()
        Calling__clear__should_drop_the_spare_too() is
            let state = RETURN_PACK_STATE()

            state.literal = literal(2)
            state.hoist = hoist()

            state.clear_outputs()
            state.clear()

            is_null(state.take_spare(2))
        si
    si
si
