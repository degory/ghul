namespace Syntax.Process.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.STRUCT;
    use Semantic.Types.Type;

    // Tests for PATTERN_CHECKER's value-type narrow gating logic, split
    // across two gates:
    //
    // - `should_emit_value_type_narrow_error` fires the "cannot narrow
    //   {T}" error for an explicit `: T` ascription onto a non-optional
    //   value type — casting to one never fails, it silently yields the
    //   default value instead, so there is no way to tell whether the
    //   source actually had that shape.
    // - `should_emit_irrefutable_destructure_warning` fires the
    //   "irrefutable-destructure" warning for a *bare* form (no
    //   ascription anywhere) over a non-optional value type when the
    //   caller demands the bare form be refutable on its own — `if
    //   let`'s contract. `case`-when patterns pass
    //   `bare_form_requires_refutability = false`, so the same bare
    //   destructure there draws neither diagnostic: it is a valid arm
    //   that simply always matches.
    //
    // The behaviour is also pinned end-to-end by
    // `integration-tests/semantic/case-when-pattern-errors` (target
    // ascription rejected), `integration-tests/semantic/if-let-errors`
    // (bare-form irrefutable destructure warned, ascribed mismatch
    // still errors), and
    // `integration-tests/execution/case-when-pattern-non-optional-destructure`
    // (bare destructure of non-nullable tuple accepted). These unit
    // tests pin each gate's contract directly so a future caller can
    // pick the right arguments without running the full pipeline.
    class PATTERN_CHECKER_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);
        empty_names() -> LIST[string] => LIST[string]();

        make_value_type() -> Type is
            // STRUCT.is_value_type = true; with no `has_value`/`value`
            // members it is the non-option-shape value type both gates
            // are concerned with.
            let s = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestStruct", empty_names(), Semantic.BLOCK_SCOPE());
            return s.type!;
        si

        make_reference_type() -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestClass", empty_names(), Semantic.BLOCK_SCOPE());
            return c.type!;
        si

        // should_emit_value_type_narrow_error

        Narrow_error_returns_false_when_effective_type_is_null() is
            @test()

            Assert.is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(null, null));
            Assert.is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(null, make_reference_type()));
        si

        Narrow_error_returns_false_when_effective_type_is_a_reference_type() is
            @test()

            let ref_type = make_reference_type();

            Assert.is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(ref_type, null));
            Assert.is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(ref_type, ref_type));
        si

        Narrow_error_returns_true_for_value_type_with_ascription() is
            @test()

            // `if let i: int = o` / `case o when i: int then` — an
            // explicit ascription onto a non-optional value type
            // always fires, whatever the source was.
            let v = make_value_type();

            Assert.is_true(PATTERN_CHECKER.should_emit_value_type_narrow_error(v, v));
        si

        Narrow_error_returns_false_for_bare_value_type() is
            @test()

            // No ascription — nothing here for this gate to reject;
            // that is `should_emit_irrefutable_destructure_warning`'s
            // job instead.
            let v = make_value_type();

            Assert.is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(v, null));
        si

        // should_emit_irrefutable_destructure_warning

        Irrefutable_warning_returns_false_when_effective_type_is_null() is
            @test()

            Assert.is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(null, null, true));
        si

        Irrefutable_warning_returns_false_when_effective_type_is_a_reference_type() is
            @test()

            let ref_type = make_reference_type();

            Assert.is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(ref_type, null, true));
        si

        Irrefutable_warning_returns_false_when_an_ascription_is_present() is
            @test()

            // An ascribed narrow is the other gate's concern —
            // `should_emit_value_type_narrow_error` — even when it
            // happens to be refutability-free too.
            let v = make_value_type();

            Assert.is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(v, v, true));
        si

        Irrefutable_warning_returns_true_for_bare_value_type_when_refutability_required() is
            @test()

            // `if let v = some_int` / `if let (a, b) = pair` — no
            // ascription anywhere, but `if let` requires the bare form
            // be refutable on its own.
            let v = make_value_type();

            Assert.is_true(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(v, null, true));
        si

        Irrefutable_warning_returns_false_for_bare_value_type_when_refutability_not_required() is
            @test()

            // `case y when (a, b) then ...` on a non-nullable tuple —
            // no ascription, caller does not require refutability, so
            // the arm is accepted silently rather than warned about.
            let v = make_value_type();

            Assert.is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(v, null, false));
        si
    si
si
