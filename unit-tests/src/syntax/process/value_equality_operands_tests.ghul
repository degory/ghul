namespace Syntax.Process.UnitTests is
    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT;
    use Semantic.Symbols.ENUM_STRUCT;
    use Semantic.Symbols.STRUCT;
    use Semantic.Types.NULLABLE;
    use Semantic.Types.Type;

    use Syntax.Process.VALUE_EQUALITY_OPERANDS;

    // Pins each arm of VALUE_EQUALITY_OPERANDS.can_compare, the
    // classifier that decides which operand types keep == / != on
    // the compare.value innate. The predicate ordering is
    // load-bearing in two places: the type-variable arm must run
    // before the value-type arm, because every GenericArgument
    // reports is_value_type spuriously; and the reference arm must
    // run before the optional arm, because a reference optional
    // compares by identity and stays accepted while a value-type
    // optional is a Nullable struct and is rejected.
    class VALUE_EQUALITY_OPERANDS_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        empty_names() -> LIST[string] => LIST[string]();

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]();
            for v in values do result.add(v); od
            return result;
        si

        a_class_type() -> Type =>
            CLASS(loc(), loc(), null, "Box", empty_names(), null).type!;

        a_struct_type() -> Type =>
            STRUCT(loc(), loc(), null, "Pair", empty_names(), null).type!;

        a_primitive_type() -> Type is
            let symbol = STRUCT(loc(), loc(), null, "int", empty_names(), null);

            symbol.il_is_primitive_type = true;

            return symbol.type!;
        si

        an_enum_type() -> Type =>
            ENUM_STRUCT(loc(), loc(), null, "Suit", null).type!;

        a_type_variable() -> Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), null, "T", 0).type!;

        a_nullable_over(inner: Type) -> Type is
            let arguments = LIST[Type]();

            arguments.add(inner);

            // the container must be a struct, as System.Nullable is -
            // the value-type-optional arm keys on is_value_type
            return NULLABLE(loc(), STRUCT(loc(), loc(), null, "Nullable", names_for(["T"]), null), arguments);
        si

        a_tuple_type() -> Type is
            let arguments = LIST[Type]();

            arguments.add(a_primitive_type());
            arguments.add(a_primitive_type());

            return Semantic.Types.TUPLE(loc(), CLASS(loc(), loc(), null, "ValueTuple", names_for(["T1", "T2"]), null), arguments, null);
        si

        can_compare__reference_class__is_true() is
            @test()

            Assert.is_true(VALUE_EQUALITY_OPERANDS.can_compare(a_class_type()));
        si

        can_compare__plain_struct__is_false() is
            @test()

            Assert.is_false(VALUE_EQUALITY_OPERANDS.can_compare(a_struct_type()));
        si

        can_compare__primitive_struct__is_true() is
            @test()

            Assert.is_true(VALUE_EQUALITY_OPERANDS.can_compare(a_primitive_type()));
        si

        can_compare__enum__is_true() is
            @test()

            Assert.is_true(VALUE_EQUALITY_OPERANDS.can_compare(an_enum_type()));
        si

        // The ordering guard: a GenericArgument reports
        // is_value_type but not il_is_primitive_type, so if the
        // value-type arm ran first a bare T would be rejected as a
        // non-primitive struct instead of keeping the operators.
        can_compare__type_variable_reports_value_type__still_true() is
            @test()

            let t = a_type_variable();

            Assert.is_true(t.is_value_type);
            Assert.is_true(VALUE_EQUALITY_OPERANDS.can_compare(t));
        si

        can_compare__value_type_optional__is_false() is
            @test()

            Assert.is_false(VALUE_EQUALITY_OPERANDS.can_compare(a_nullable_over(a_primitive_type())));
        si

        can_compare__reference_optional__is_true() is
            @test()

            let optional_class = a_class_type().as_optional();

            Assert.is_true(optional_class.is_optional);
            Assert.is_true(VALUE_EQUALITY_OPERANDS.can_compare(optional_class));
        si

        can_compare__tuple__is_true() is
            @test()

            Assert.is_true(VALUE_EQUALITY_OPERANDS.can_compare(a_tuple_type()));
        si
    si
si
