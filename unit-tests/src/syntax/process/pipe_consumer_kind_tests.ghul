namespace Syntax.Process.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Syntax.Process.PIPE_CONSUMER_KIND;

    // The fusible consumers are matched by their source-level name, so
    // renaming one in the runtime library takes it out of the fused
    // lowering without breaking anything visible: the chain still
    // compiles, and still produces identical results through the
    // unfused Pipe objects. These pin the names themselves, so that
    // drift fails here rather than going unnoticed as lost fusion.
    class PIPE_CONSUMER_KIND_TESTS is
        @test()

        init() is si

        Each_is_the_void_consumer() is
            @test()

            Assert.are_equal("each", PIPE_CONSUMER_KIND.of("each", 1));
            Assert.is_true(PIPE_CONSUMER_KIND.is_void("each"));
            Assert.is_true(PIPE_CONSUMER_KIND.takes_function("each"));
        si

        Consumers_taking_a_function_are_recognized() is
            @test()

            Assert.are_equal("any", PIPE_CONSUMER_KIND.of("any", 1));
            Assert.are_equal("all", PIPE_CONSUMER_KIND.of("all", 1));
            Assert.are_equal("find", PIPE_CONSUMER_KIND.of("find", 1));

            Assert.is_true(PIPE_CONSUMER_KIND.takes_function("any"));
            Assert.is_true(PIPE_CONSUMER_KIND.takes_function("all"));
            Assert.is_true(PIPE_CONSUMER_KIND.takes_function("find"));
        si

        Consumers_taking_no_function_are_recognized() is
            @test()

            Assert.are_equal("count", PIPE_CONSUMER_KIND.of("count", 0));
            Assert.are_equal("first", PIPE_CONSUMER_KIND.of("first", 0));
            Assert.are_equal("reduce", PIPE_CONSUMER_KIND.of("reduce", 2));

            Assert.is_false(PIPE_CONSUMER_KIND.takes_function("count"));
            Assert.is_false(PIPE_CONSUMER_KIND.takes_function("reduce"));
        si

        Collect_list_fuses_under_a_different_kind() is
            @test()

            Assert.are_equal("collect", PIPE_CONSUMER_KIND.of("collect_list", 0));
        si

        Only_the_declared_argument_count_matches() is
            @test()

            Assert.is_null(PIPE_CONSUMER_KIND.of("each", 0));
            Assert.is_null(PIPE_CONSUMER_KIND.of("count", 1));
            Assert.is_null(PIPE_CONSUMER_KIND.of("reduce", 1));
        si

        An_unrelated_name_is_not_a_consumer() is
            @test()

            Assert.is_null(PIPE_CONSUMER_KIND.of("map", 1));
            Assert.is_null(PIPE_CONSUMER_KIND.of("for_each", 1));
            Assert.is_null(PIPE_CONSUMER_KIND.of(null, 1));
        si

        Nothing_but_each_is_void() is
            @test()

            Assert.is_false(PIPE_CONSUMER_KIND.is_void("count"));
            Assert.is_false(PIPE_CONSUMER_KIND.is_void("collect"));
            Assert.is_false(PIPE_CONSUMER_KIND.is_void(null));
        si
    si
si
