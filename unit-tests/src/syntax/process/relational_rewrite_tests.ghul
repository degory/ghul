namespace Syntax.Process.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Syntax.Process.RELATIONAL_REWRITE;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The four relational tokens parse into a call to `<>`, so by the
    // time an expression is compiled only the token actually written
    // distinguishes them from a `<>` written directly. What hangs on
    // it: a rewritten token's ordering value is reduced to the bool the
    // surface syntax promised, where a literal `<>` keeps the int.
    @TestClass()
    class RELATIONAL_REWRITE_TESTS is
        init() is si

        @Test()
        Relational_tokens_are_rewrites() is
            is_true(RELATIONAL_REWRITE.is_relational_rewrite("<>", "<"));
            is_true(RELATIONAL_REWRITE.is_relational_rewrite("<>", "<="));
            is_true(RELATIONAL_REWRITE.is_relational_rewrite("<>", ">"));
            is_true(RELATIONAL_REWRITE.is_relational_rewrite("<>", ">="));
        si

        @Test()
        A_literal_order_operator_is_not_a_rewrite() is
            is_false(RELATIONAL_REWRITE.is_relational_rewrite("<>", "<>"));
        si

        @Test()
        Another_operator_is_not_a_rewrite() is
            is_false(RELATIONAL_REWRITE.is_relational_rewrite("=~", "=~"));
            is_false(RELATIONAL_REWRITE.is_relational_rewrite("==", "!="));
            is_false(RELATIONAL_REWRITE.is_relational_rewrite("+", "+"));
        si

        @Test()
        A_missing_operation_is_not_a_rewrite() is
            is_false(RELATIONAL_REWRITE.is_relational_rewrite(null, "<"));
            is_false(RELATIONAL_REWRITE.is_relational_rewrite("<>", null));
        si
    si
si
