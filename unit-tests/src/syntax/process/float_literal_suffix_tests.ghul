namespace Syntax.Process.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Syntax.Process.FLOAT_LITERAL_SUFFIX
    use Syntax.Process.FloatLiteralKind

    @TestClass()
    class FLOAT_LITERAL_SUFFIX_TESTS is
        init() is si

        @Test()
        Calling__kind__with_no_suffix_should_answer_double() is
            are_equal(FloatLiteralKind.DOUBLE, FLOAT_LITERAL_SUFFIX.kind("1.5"))
        si

        @Test()
        Calling__kind__with_an_exponent_and_no_suffix_should_answer_double() is
            are_equal(FloatLiteralKind.DOUBLE, FLOAT_LITERAL_SUFFIX.kind("1.5e3"))
            are_equal(FloatLiteralKind.DOUBLE, FLOAT_LITERAL_SUFFIX.kind("1.5E-3"))
        si

        @Test()
        Calling__kind__with_an_s_suffix_should_answer_single() is
            are_equal(FloatLiteralKind.SINGLE, FLOAT_LITERAL_SUFFIX.kind("1.5s"))
            are_equal(FloatLiteralKind.SINGLE, FLOAT_LITERAL_SUFFIX.kind("1.5S"))
        si

        @Test()
        Calling__kind__with_a_d_suffix_should_answer_double() is
            are_equal(FloatLiteralKind.DOUBLE, FLOAT_LITERAL_SUFFIX.kind("1.5d"))
            are_equal(FloatLiteralKind.DOUBLE, FLOAT_LITERAL_SUFFIX.kind("1.5D"))
        si

        @Test()
        Calling__kind__with_an_m_suffix_should_answer_decimal() is
            are_equal(FloatLiteralKind.DECIMAL, FLOAT_LITERAL_SUFFIX.kind("1.5m"))
            are_equal(FloatLiteralKind.DECIMAL, FLOAT_LITERAL_SUFFIX.kind("1.5M"))
        si

        @Test()
        Calling__kind__with_an_empty_string_should_answer_double() is
            are_equal(FloatLiteralKind.DOUBLE, FLOAT_LITERAL_SUFFIX.kind(""))
        si

        @Test()
        Calling__strip__should_remove_a_suffix_and_leave_an_unsuffixed_literal_alone() is
            are_equal("1.5", FLOAT_LITERAL_SUFFIX.strip("1.5"))
            are_equal("1.5", FLOAT_LITERAL_SUFFIX.strip("1.5s"))
            are_equal("1.5", FLOAT_LITERAL_SUFFIX.strip("1.5D"))
            are_equal("1.5", FLOAT_LITERAL_SUFFIX.strip("1.5m"))
            are_equal("1.5e3", FLOAT_LITERAL_SUFFIX.strip("1.5e3"))
        si
    si
si
