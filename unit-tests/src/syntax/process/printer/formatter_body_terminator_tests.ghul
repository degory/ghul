namespace Syntax.Process.Printer.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Syntax.Process.Printer.FORMATTER;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A body-less function, property accessor or indexer accessor parses
    // to a `Bodies.NULL` body rather than an absent one, so both its own
    // visit and the caller's `after_body` must not both write the
    // terminating `;`. And a destructure leaf's own `: T` ascription is
    // carried on the `VariableLeft` node, not on any wrapping VARIABLE, so
    // every leaf visitor has to render it explicitly.
    @TestClass()
    class FORMATTER_BODY_TERMINATOR_TESTS is
        init() is si

        loc: Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1);

        format(node: Trees.Node) -> string =>
            FORMATTER(Collections.LIST[Lexical.TRIVIA](), 100).format(node);

        identifier(name: string) -> Trees.Identifiers.Identifier =>
            Trees.Identifiers.Identifier(loc, name);

        named_type(name: string) -> Trees.TypeExpressions.TypeExpression =>
            Trees.TypeExpressions.NAMED(loc, identifier(name));

        simple_pattern(name: string) -> Trees.Variables.VariableLeft =>
            Trees.Variables.SIMPLE_VARIABLE_LEFT(loc, identifier(name));

        bodyless_function(name: string, return_type: Trees.TypeExpressions.TypeExpression) -> Trees.Definitions.FUNCTION =>
            Trees.Definitions.FUNCTION(
                loc,
                identifier(name),
                Trees.TypeExpressions.LIST(loc, Collections.LIST[Trees.TypeExpressions.TypeExpression]()),
                Trees.Variables.LIST(loc, Collections.LIST[Trees.Variables.VARIABLE]()),
                return_type,
                Trees.Modifiers.LIST(loc, null, null),
                Trees.Bodies.NULL(loc)
            );

        @Test()
        a_bodyless_function_terminates_with_exactly_one_semicolon() is
            are_equal(
                "area() -> double;\n",
                format(bodyless_function("area", named_type("double")))
            );
        si

        @Test()
        a_bodyless_void_function_terminates_with_exactly_one_semicolon() is
            are_equal(
                "run();\n",
                format(bodyless_function("run", Trees.TypeExpressions.INFER(loc)))
            );
        si

        @Test()
        a_leaf_type_ascription_round_trips() is
            let leaf = simple_pattern("a");
            leaf.set_type_expression(named_type("int"));

            are_equal("a: int\n", format(leaf));
        si

        @Test()
        a_nested_group_type_ascription_round_trips() is
            let elements = Collections.LIST[Trees.Variables.VariableLeft]();
            elements.add(simple_pattern("a"));
            elements.add(simple_pattern("b"));

            let group = Trees.Variables.DESTRUCTURING_VARIABLE_LEFT(loc, elements);
            group.set_type_expression(named_type("NODE"));

            let outer = Collections.LIST[Trees.Variables.VariableLeft]();
            outer.add(group);
            outer.add(simple_pattern("c"));

            are_equal(
                "((a, b): NODE, c)\n",
                format(Trees.Variables.DESTRUCTURING_VARIABLE_LEFT(loc, outer))
            );
        si

        // emit_modifiers (the FORMATTER's own modifier renderer, used for
        // class/struct/trait headers) dropped `abstract` entirely - it
        // checked access_modifier, storage_class, is_pure and is_stable,
        // but never is_abstract.
        @Test()
        an_abstract_class_header_keeps_the_abstract_modifier() is
            let modifiers = Trees.Modifiers.LIST(loc, null, null);
            modifiers.is_abstract = true;

            let empty_body = Trees.Definitions.LIST(loc, Collections.LIST[Trees.Definitions.Definition]());

            let `class =
                Trees.Definitions.CLASS(loc, identifier("SHAPE"), null, null, modifiers, empty_body);

            are_equal("class SHAPE abstract is\nsi\n", format(`class));
        si
    si
si
