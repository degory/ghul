namespace Syntax.Process.Printer.UnitTests is
    use Syntax.Process.Printer.FORMATTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A block expression keeps the spelling it was written in: the
    // parenthesised form `(statement; value)` must not round-trip into
    // `val ... lav`, nor the other way around.
    @TestClass()
    class FORMATTER_PAREN_BLOCK_TESTS is
        init() is si

        loc: Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1)

        format(node: Trees.Node) -> string =>
            FORMATTER(Collections.LIST[Lexical.TRIVIA](), 100).format(node)

        identifier_expression(name: string) -> Trees.Expressions.Expression =>
            Trees.Expressions.IDENTIFIER(loc, Trees.Identifiers.Identifier(loc, name))

        block(is_parenthesised: bool) -> Trees.Expressions.VAL_BLOCK is
            let statements = Collections.LIST[Trees.Statements.Statement]()

            statements.add(Trees.Statements.EXPRESSION(loc, identifier_expression("effect")))
            statements.add(Trees.Statements.EXPRESSION(loc, identifier_expression("tail")))

            let body = Trees.Statements.LIST(loc, statements)

            let result = Trees.Expressions.VAL_BLOCK(loc, body)
            result.is_parenthesised = is_parenthesised

            return result
        si

        @Test()
        val_spelling_formats_as_val_lav() is
            are_equal(
                "val\n    effect\n    tail\nlav\n",
                format(block(false))
            )
        si

        @Test()
        parenthesised_spelling_formats_with_parens() is
            are_equal(
                "(\n    effect\n    tail\n)\n",
                format(block(true))
            )
        si
    si
si
