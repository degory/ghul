namespace Syntax.Process.Printer.UnitTests is
    use Source.LOCATION

    use Syntax.Process.Printer.FORMATTER
    use Syntax.Process.Printer.InferredAnnotations
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use NSubstitute.SubstituteExtensions.returns_for_any_args

    // The formatter writes a call's inferred type arguments after its
    // callee, and leaves a callee that already has them as written.
    @TestClass()
    class FORMATTER_TYPE_ARGUMENT_ANNOTATION_TESTS is
        init() is si

        // Answers type arguments for the callee starting at one position,
        // and nothing else.
        type_arguments_at(line: int, column: int, arguments: string) -> InferredAnnotations is
            let annotations = NSubstitute.Substitute.`for`[InferredAnnotations](System.Array.empty`[object]())

            annotations.type_arguments(LOCATION("annotate.ghul", 1, 1, 1, 1)) |> returns_for_any_args(
                (call: NSubstitute.Core.CallInfo) -> string? is
                    let callee = call.arg`[LOCATION]()

                    return if callee.start_line == line /\ callee.start_column == column then arguments else null fi
                si,
                System.Array.empty`[(NSubstitute.Core.CallInfo) -> string?]()
            )

            return annotations
        si

        format(source: string, annotations: InferredAnnotations) -> string is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_file =
                Compiler.COMPILER().parse(
                    "annotate.ghul",
                    IO.StringReader(source),
                    false,
                    false,
                    false,
                    logger
                )

            is_false(logger.any_errors, "fixture did not parse")

            let formatter = FORMATTER(source_file.trivia, 100)

            formatter.annotations = annotations

            return formatter.format(source_file.definition)
        si

        @Test()
        Formatting__a_call_with_inferred_type_arguments__should_write_them_after_the_callee() is
            let text = format("namespace Test is\n    f() -> int => identity(3)\nsi\n", type_arguments_at(2, 19, "int"))

            is_true(text.contains("identity[int](3)"), text)
        si

        @Test()
        Formatting__a_thread_first_call_with_inferred_type_arguments__should_write_them_after_the_callee() is
            let text = format("namespace Test is\n    f() -> int => 3 |> identity()\nsi\n", type_arguments_at(2, 24, "int"))

            is_true(text.contains("3 |> identity[int]()"), text)
        si

        @Test()
        Formatting__a_call_that_writes_its_type_arguments__should_leave_them_as_written() is
            let text = format("namespace Test is\n    f() -> int => identity[int](3)\nsi\n", type_arguments_at(2, 19, "long"))

            is_true(text.contains("identity[int](3)"), text)
            is_false(text.contains("long"), text)
        si
    si
si
