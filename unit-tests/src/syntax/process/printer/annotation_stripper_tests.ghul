namespace Syntax.Process.Printer.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Process.Printer.ANNOTATION_STRIPPER
    use Syntax.Process.Printer.FORMATTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class ANNOTATION_STRIPPER_TESTS is
        init() is si

        location() -> Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1)

        @Test()
        Stripping__with_all__should_take_every_site_and_number_them() is
            let stripper = ANNOTATION_STRIPPER("all")

            is_true(stripper.strip("local", location()))
            is_true(stripper.strip("parameter", location()))
            are_equal(2, stripper.sites.count)
            is_true(stripper.sites[1].starts_with("1 parameter "))
        si

        @Test()
        Stripping__with_list__should_number_every_site_and_take_none() is
            let stripper = ANNOTATION_STRIPPER("list")

            is_false(stripper.strip("local", location()))
            is_false(stripper.strip("return", location()))
            are_equal(2, stripper.sites.count)
        si

        @Test()
        Stripping__with_numbers_and_a_range__should_take_only_those_sites() is
            let stripper = ANNOTATION_STRIPPER("0,2-3")

            is_true(stripper.strip("local", location()))
            is_false(stripper.strip("local", location()))
            is_true(stripper.strip("local", location()))
            is_true(stripper.strip("local", location()))
            is_false(stripper.strip("local", location()))
        si

        // A lambda parameter written with a type prints without it when
        // the stripper takes the site, and with it otherwise.
        parameter() -> Trees.Node =>
            Trees.Expressions.VARIABLE(
                location(),
                Trees.Identifiers.Identifier(location(), "x"),
                Trees.TypeExpressions.NAMED(location(), Trees.Identifiers.Identifier(location(), "int")),
                null
            )

        format(node: Trees.Node, selection: string?) -> string is
            let formatter = FORMATTER(Collections.LIST[Lexical.TRIVIA](), 100)

            if let s = selection then
                formatter.stripper = ANNOTATION_STRIPPER(s)
            fi

            formatter.format(node).trim()
        si

        @Test()
        Formatting__a_typed_parameter_with_no_stripper__should_keep_its_type() is
            are_equal("x: int", format(parameter(), null))
        si

        @Test()
        Formatting__a_typed_parameter_stripping_all__should_leave_the_type_out() is
            are_equal("x", format(parameter(), "all"))
        si

        @Test()
        Formatting__a_typed_parameter_stripping_another_site__should_keep_its_type() is
            are_equal("x: int", format(parameter(), "5"))
        si
    si
si
