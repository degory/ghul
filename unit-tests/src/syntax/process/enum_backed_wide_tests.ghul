namespace Syntax.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Collections.LIST;

    use Semantic.Types.Type;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.ENUM_STRUCT;
    use Semantic.Symbols.NAMESPACE;

    use Syntax.Process.DEFAULT_ARGUMENT_VALUES;

    // The primitive types `enum_backed_wide` asks about, each one
    // instance shared between the enum's recorded underlying type and
    // the lookup's answer — the position holds in the compiler too,
    // where both sides of the comparison come from one type mapper's
    // cache. Everything else is the stub lookup's
    // NotImplementedException, which these tests never reach.
    class WIDE_ENUM_TEST_LOOKUP: Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP is
        _long_type: Type;
        _ulong_type: Type;

        init() is
            super.init();

            let loc = LOCATION("test.ghul", 1, 1, 1, 1);

            _long_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Long", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
            _ulong_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "ULong", LIST[string](), Semantic.BLOCK_SCOPE()).type!;
        si

        get_long_type() -> Type => _long_type;
        get_ulong_type() -> Type => _ulong_type;
    si

    // Pins `DEFAULT_ARGUMENT_VALUES.enum_backed_wide`, the shared
    // decision an enum-typed value is read at the width the enum was
    // declared over rather than always at int32.
    //
    // Only an imported enum can be wider than int32 — a ghūl-declared
    // one is always int32-backed and records no underlying type, which
    // is the absent-record case below answering false.
    class ENUM_BACKED_WIDE_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        wide_enum(underlying: Type?) -> Type is
            let owner = NAMESPACE(loc(), "Test", null, ".Test", false);
            let `enum = ENUM_STRUCT(loc(), loc(), owner, "Wide", owner);

            `enum.underlying_type = underlying;

            return `enum.type!;
        si

        An_enum_that_records_no_underlying_type_is_not_wide() is
            @test()

            Assert.is_false(DEFAULT_ARGUMENT_VALUES.enum_backed_wide(wide_enum(null), WIDE_ENUM_TEST_LOOKUP()));
        si

        An_enum_backed_by_long_is_wide() is
            @test()

            let lookup = WIDE_ENUM_TEST_LOOKUP();

            Assert.is_true(DEFAULT_ARGUMENT_VALUES.enum_backed_wide(wide_enum(lookup.get_long_type()), lookup));
        si

        An_enum_backed_by_ulong_is_wide() is
            @test()

            let lookup = WIDE_ENUM_TEST_LOOKUP();

            Assert.is_true(DEFAULT_ARGUMENT_VALUES.enum_backed_wide(wide_enum(lookup.get_ulong_type()), lookup));
        si
    si
si
