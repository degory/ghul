namespace Syntax.Process.UnitTests is
    use Collections.Iterable;
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Lookups.InnateSymbolLookup;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.STRUCT;
    use Semantic.Symbols.NAMESPACE;
    use Semantic.Symbols.GLOBAL_FUNCTION;

    use Semantic.Types.Type;
    use Semantic.Types.GENERIC;

    use Syntax.Process.PIPE_FUSION_RECOGNIZER;

    use Syntax.Trees.Expressions.Expression;
    use Syntax.Trees.Expressions.CALL;
    use Syntax.Trees.Expressions.Literals.BOOLEAN;
    use ExpressionList = Syntax.Trees.Expressions.LIST;

    use GlobalCall = IR.Values.Call.GLOBAL;
    use TempLoad = IR.Values.Load.TEMP;
    use IR.Values.Value;

    // Pins PIPE_FUSION_RECOGNIZER.classify_source_type - the guard / no-guard
    // decision the whole soundness argument rests on. The end-to-end fusion
    // is covered by the execution tests under
    // integration-tests/execution/pipe-fusion-*; this fixture pins the base
    // classification against stand-in types so the three outcomes (do not
    // fuse / fuse unconditionally / fuse behind the runtime guard) can't
    // silently drift.
    class PIPE_FUSION_RECOGNIZER_TESTS is
        @test()

        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);

        empty_names() -> LIST[string] => LIST[string]();

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]();
            for v in values do result.add(v); od
            return result;
        si

        types(values: Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]();
            for v in values do result.add(v); od
            return result;
        si

        // classify_source_type takes the pipe type as a parameter and never
        // consults the lookup, but the recognizer ctor requires one.
        build_lookup() -> InnateSymbolLookup =>
            NSubstitute.Substitute.`for`[InnateSymbolLookup](System.Array.empty`[object]());

        recognizer() -> PIPE_FUSION_RECOGNIZER => PIPE_FUSION_RECOGNIZER(build_lookup());

        pipe_class() -> CLASS => CLASS(loc(), loc(), null, "Pipe", names_for(["T"]), null);
        int_class() -> CLASS => CLASS(loc(), loc(), null, "int", empty_names(), null);
        collection_class() -> CLASS => CLASS(loc(), loc(), null, "MyList", empty_names(), null);
        value_struct() -> STRUCT => STRUCT(loc(), loc(), null, "Point", empty_names(), null);

        // A statically-Pipe source: pipe() would short-circuit to it, so the
        // chain must not be fused at all.
        Calling__classify_source_type__with_pipe_source__does_not_fuse() is
            @test()

            let pipe = pipe_class();
            let pipe_type = pipe.type!;
            let source = GENERIC(loc(), pipe, types([int_class().type!]));

            Assert.is_null(recognizer().classify_source_type(source, pipe_type));
        si

        // A value-type source is sealed and cannot dynamically be a Pipe, so
        // it fuses unconditionally (no guard).
        Calling__classify_source_type__with_value_type_source__fuses_unguarded() is
            @test()

            let result = recognizer().classify_source_type(value_struct().type!, pipe_class().type!);

            Assert.is_true(result?);
            Assert.is_false(result!);
        si

        // A plain collection source is only statically not a Pipe, so it
        // fuses behind the runtime guard.
        Calling__classify_source_type__with_collection_source__fuses_guarded() is
            @test()

            let result = recognizer().classify_source_type(collection_class().type!, pipe_class().type!);

            Assert.is_true(result?);
            Assert.is_true(result!);
        si

        // The tests below pin recognize_free_function_chain - the peel loop
        // over a `|>`-desugared Ghul.Pipes call chain. `|>` inserts the
        // threaded value as argument 0 and resolves the call like any other
        // before this pass runs, so the recognizer never sees a receiver or
        // a `pipe()` wrap - only a CALL whose compiled `.value` is an
        // IR.Values.Call.GLOBAL naming the resolved function. These fixtures
        // fake that post-compile state directly (compile_expressions_state
        // is a settable field) rather than compiling real source, the same
        // way the classify_source_type fixtures above fake a resolved type
        // without a real symbol table.
        placeholder() -> Expression => BOOLEAN(loc(), "true");

        pipes_namespace() -> NAMESPACE => NAMESPACE(loc(), "Pipes", null, ".Ghul.Pipes", false);

        // A resolved call to Ghul.Pipes.<name>(args...), as `|>` desugaring
        // and overload resolution would leave it - a plain global-function
        // call, never a MEMBER, regardless of what `name` is.
        pipes_call(name: string, arguments: Iterable[Expression]) -> CALL is
            let call = CALL(loc(), placeholder(), ExpressionList(loc(), arguments));
            let function = GLOBAL_FUNCTION(loc(), loc(), pipes_namespace(), name, pipes_namespace());

            call.compile_expressions_state.value = GlobalCall(function, LIST[Value](), int_class().type!);

            return call;
        si

        // A chain's base: a plain value with a resolved, non-optional type -
        // stands in for a variable holding an array/list/Iterable.
        source_expression() -> Expression is
            let e = placeholder();

            e.compile_expressions_state.value = TempLoad("source", int_class().type!);

            return e;
        si

        // A single covered stage (map) peels to one non-filter, non-guarded
        // fusion rooted at the source.
        Calling__recognize_free_function_chain__with_single_map_call__builds_one_stage() is
            @test()

            let source = source_expression();
            let call = pipes_call("map", [source, placeholder()]);

            let fusion = recognizer().recognize_free_function_chain(call);

            Assert.is_true(fusion?);
            Assert.is_false(fusion!.needs_guard);
            Assert.are_same(source, fusion!.source);
            Assert.are_equal(1, fusion!.stages_outermost_first.count);
            Assert.is_false(fusion!.stages_outermost_first[0].is_filter);
        si

        // `xs |> filter(p) |> map(f)` desugars to map(filter(xs, p), f) - the
        // peel loop must walk more than one layer, outermost first.
        Calling__recognize_free_function_chain__with_filter_then_map__peels_both_stages() is
            @test()

            let source = source_expression();
            let filter_call = pipes_call("filter", [source, placeholder()]);
            let map_call = pipes_call("map", [filter_call, placeholder()]);

            let fusion = recognizer().recognize_free_function_chain(map_call);

            Assert.is_true(fusion?);
            Assert.are_same(source, fusion!.source);
            Assert.are_equal(2, fusion!.stages_outermost_first.count);
            Assert.is_false(fusion!.stages_outermost_first[0].is_filter);
            Assert.is_true(fusion!.stages_outermost_first[1].is_filter);
        si

        // take/skip carry a running counter rather than a lambda - a
        // distinct PIPE_FUSION_STAGE shape from map/filter that still needs
        // pinning on the free-function path.
        Calling__recognize_free_function_chain__with_take_call__builds_countdown_stage() is
            @test()

            let source = source_expression();
            let call = pipes_call("take", [source, placeholder()]);

            let fusion = recognizer().recognize_free_function_chain(call);

            Assert.is_true(fusion?);
            Assert.are_equal(1, fusion!.stages_outermost_first.count);
            Assert.is_true(fusion!.stages_outermost_first[0].is_countdown);
        si

        // `zip` is a real Ghul.Pipes function but not one the free-function
        // recognizer covers (a two-source stage) - the peel loop must stop
        // and decline rather than misclassify it, leaving the call to fall
        // back to its ordinary, unfused lowering.
        Calling__recognize_free_function_chain__with_uncovered_pipes_function__returns_null() is
            @test()

            let source = source_expression();
            let call = pipes_call("zip", [source, placeholder()]);

            Assert.is_null(recognizer().recognize_free_function_chain(call));
        si

        // A call whose resolved value isn't a global-function call at all
        // (e.g. an instance method call) must never be mistaken for a
        // fusible stage.
        Calling__recognize_free_function_chain__with_non_global_call__returns_null() is
            @test()

            let call = CALL(loc(), placeholder(), ExpressionList(loc(), [placeholder()]));

            call.compile_expressions_state.value = TempLoad("not-a-call", int_class().type!);

            Assert.is_null(recognizer().recognize_free_function_chain(call));
        si
    si
si
