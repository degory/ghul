namespace Syntax.Process.UnitTests is
    use Source.LOCATION;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Tests for TOP_LEVEL_LOCALS — the per-file record of top-level `let`
    // locals consulted when a name fails to resolve inside a function, so
    // the failure can point back at the invisible declaration.
    @TestClass()
    class TOP_LEVEL_LOCALS_TESTS is
        init() is si

        identifier(file_name: string, name: string, line: int, column: int) -> Trees.Identifiers.Identifier =>
            Trees.Identifiers.Identifier(
                LOCATION(file_name, line, column, line, column + name.length),
                name
            );

        @Test()
        given_a_recorded_local__find__should_return_its_location() is
            let locals = TOP_LEVEL_LOCALS();

            locals.record(identifier("script.ghul", "greeting", 1, 5));

            let found = locals.find("script.ghul", "greeting");

            is_true(found?);
            are_equal("script.ghul", found.file_name);
        si

        @Test()
        given_no_recorded_local__find__should_return_null() is
            let locals = TOP_LEVEL_LOCALS();

            is_false(locals.find("script.ghul", "greeting")?);
        si

        @Test()
        given_a_local_recorded_in_another_file__find__should_return_null() is
            let locals = TOP_LEVEL_LOCALS();

            locals.record(identifier("other.ghul", "greeting", 1, 5));

            is_false(locals.find("script.ghul", "greeting")?);
        si

        @Test()
        given_a_cleared_file__find__should_return_null() is
            let locals = TOP_LEVEL_LOCALS();

            locals.record(identifier("script.ghul", "greeting", 1, 5));
            locals.clear_file("script.ghul");

            is_false(locals.find("script.ghul", "greeting")?);
        si

        @Test()
        given_a_name_recorded_twice__find__should_return_the_first_location() is
            let locals = TOP_LEVEL_LOCALS();

            locals.record(identifier("script.ghul", "greeting", 1, 5));
            locals.record(identifier("script.ghul", "greeting", 7, 5));

            let found = locals.find("script.ghul", "greeting");

            is_true(found?);
            are_equal(1, found.start_line);
        si

        @Test()
        given_a_cleared_file__a_local_in_another_file__should_survive() is
            let locals = TOP_LEVEL_LOCALS();

            locals.record(identifier("script.ghul", "greeting", 1, 5));
            locals.record(identifier("other.ghul", "farewell", 3, 5));

            locals.clear_file("script.ghul");

            is_true(locals.find("other.ghul", "farewell")?);
        si
    si
si
