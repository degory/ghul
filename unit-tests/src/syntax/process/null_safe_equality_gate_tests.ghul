namespace Syntax.Process.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Semantic.Symbols.CLASS;
    use Semantic.Symbols.STRUCT;
    use Semantic.Symbols.INSTANCE_METHOD;
    use Semantic.Symbols.STATIC_METHOD;
    use Semantic.Types.Type;

    use Syntax.Process.NULL_SAFE_EQUALITY_GATE;
    use Syntax.Process.OPTIONAL_OPERAND;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Every decline here leaves `a =~ b` resolving exactly as it did
    // before the null checks existed, so getting one wrong does not
    // fail to compile - it answers from the wrong place. The optional-
    // parameter decline is the one that has already been got wrong:
    // resolving against the operands' non-optional types matches a
    // member declaring `T?` too, and wrapping that member skipped a
    // body written to decide for itself what an absent operand means.
    @TestClass()
    class NULL_SAFE_EQUALITY_GATE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1);
        no_names() -> LIST[string] => LIST[string]();

        reference_type() -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "BOX", no_names(), Semantic.BLOCK_SCOPE()).type!;

        optional_reference_type() -> Type => reference_type().as_optional();

        value_type() -> Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "POINT", no_names(), Semantic.BLOCK_SCOPE()).type!;

        // A value type's `T?` — `Nullable[T]`, itself a value type
        // carrying the optional flag.
        optional_value_type() -> Type is
            let container = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Nullable", ["T"], Semantic.BLOCK_SCOPE());
            let inner = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Inner", no_names(), Semantic.BLOCK_SCOPE());
            let arguments = LIST[Type]();
            arguments.add(inner.type!);
            return Semantic.Types.NULLABLE(loc(), container, arguments);
        si

        error_type() -> Type => Semantic.Types.ERROR();

        _bool_type: Type;

        // One instance reused, so a return type built from it matches
        // the one the gate is handed.
        bool_type() -> Type is
            if !_bool_type? then
                _bool_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "bool", no_names(), Semantic.BLOCK_SCOPE()).type!;
            fi

            return _bool_type;
        si

        make_operator(argument: Type?) -> INSTANCE_METHOD =>
            make_operator(argument, bool_type());

        make_operator(argument: Type?, return_type: Type) -> INSTANCE_METHOD is
            let result = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "=~", Semantic.BLOCK_SCOPE());
            let arguments = LIST[Type]();

            if argument? then
                arguments.add(argument);
            fi

            result.arguments = arguments;
            result.return_type = return_type;

            return result;
        si

        accepts(function: Semantic.Symbols.Function?) -> bool =>
            NULL_SAFE_EQUALITY_GATE.accepts_operator(function, bool_type());

        // ===== operands =====

        @Test()
        An_optional_operand_is_what_the_null_checks_are_for() is
            is_true(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    optional_reference_type(), reference_type()));

            is_true(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    reference_type(), optional_reference_type()));

            is_true(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    optional_reference_type(), optional_reference_type()));
        si

        @Test()
        Two_present_operands_need_no_null_checks() is
            is_false(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    reference_type(), reference_type()));
        si

        @Test()
        A_value_shape_optional_is_accepted_too() is
            // `NULLABLE[T]` and `MAYBE[T]` carry presence in a member
            // rather than in the reference, but which lowering an
            // operand uses is settled per operand when its presence
            // test is built, not here.
            let value_optional = optional_value_type();

            is_true(value_optional.is_optional);
            is_true(value_optional.is_value_type);

            is_true(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    value_optional, value_optional));

            is_true(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    value_optional, reference_type()));

            is_true(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    optional_reference_type(), value_type()));
        si

        @Test()
        Two_present_value_operands_need_no_null_checks() is
            is_false(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    value_type(), value_type()));
        si

        @Test()
        A_value_shape_operand_is_always_guarded() is
            // Its parameter is a bare value at IL however its
            // optionality is declared, so there is no absent value to
            // hand a body - the null checks answer for it whatever the
            // operator says. A reference optional can be handed null,
            // so it is only guarded when the operator asks to be.
            is_true(
                OPTIONAL_OPERAND.must_be_guarded(
                    IR.Values.STACK_TOP(optional_value_type())));

            is_false(
                OPTIONAL_OPERAND.must_be_guarded(
                    IR.Values.STACK_TOP(optional_reference_type())));

            is_false(
                OPTIONAL_OPERAND.must_be_guarded(
                    IR.Values.STACK_TOP(reference_type())));
        si

        @Test()
        An_absent_or_error_operand_type_is_declined() is
            is_false(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(null, reference_type()));

            is_false(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(reference_type(), null));

            is_false(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    error_type(), optional_reference_type()));

            is_false(
                NULL_SAFE_EQUALITY_GATE.accepts_operands(
                    optional_reference_type(), error_type()));
        si

        // ===== the operator =====

        @Test()
        An_operator_taking_one_non_optional_argument_is_accepted() is
            is_true(
                accepts(make_operator(reference_type())));
        si

        @Test()
        An_operator_declaring_an_optional_argument_is_still_wrapped() is
            // It is accepted, because an absent receiver has nothing to
            // dispatch on however the parameter is declared - that arm
            // can never be the operator's decision. What it does not
            // get is the argument arm, so the body keeps deciding what
            // an absent argument means. This is the shape GHUL.md's own
            // interop example uses.
            let takes_optional = make_operator(optional_reference_type());

            is_true(accepts(takes_optional));
            is_false(NULL_SAFE_EQUALITY_GATE.guards_argument(takes_optional));
        si

        @Test()
        An_operator_declaring_a_non_optional_argument_guards_it() is
            // It could not have been handed an absent argument at all,
            // so that arm is answered here.
            is_true(
                NULL_SAFE_EQUALITY_GATE.guards_argument(
                    make_operator(reference_type())));
        si

        @Test()
        Guarding_the_argument_answers_only_about_the_argument() is
            // It says whether the argument arm applies, not whether the
            // operator is wrapped at all - that is `accepts_operator`,
            // which the caller asks first. A hidden operator is never
            // reached, so what this answers for one does not arise.
            let hidden = make_operator(reference_type());
            hidden.is_hidden_from_operator_resolution = true;

            is_false(accepts(hidden));
            is_true(NULL_SAFE_EQUALITY_GATE.guards_argument(hidden));

            // Shapes it cannot answer for at all.
            is_false(NULL_SAFE_EQUALITY_GATE.guards_argument(null));
            is_false(NULL_SAFE_EQUALITY_GATE.guards_argument(make_operator(null)));
        si

        @Test()
        A_member_hidden_from_operator_resolution_is_declined() is
            // Not what the expression calls in the first place — the
            // scalars and `string` keep their innate operator.
            let hidden = make_operator(reference_type());
            hidden.is_hidden_from_operator_resolution = true;

            is_false(accepts(hidden));
        si

        @Test()
        A_static_operator_is_declined() is
            // The lowering calls through a receiver, so only an
            // instance member qualifies.
            let static_operator = STATIC_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "=~", Semantic.BLOCK_SCOPE());
            let arguments = LIST[Type]();
            arguments.add(reference_type());
            arguments.add(reference_type());
            static_operator.arguments = arguments;

            is_false(accepts(static_operator));
        si

        @Test()
        An_operator_of_the_wrong_arity_is_declined() is
            let two_arguments = make_operator(reference_type());
            let arguments = LIST[Type]();
            arguments.add(reference_type());
            arguments.add(reference_type());
            two_arguments.arguments = arguments;

            is_false(accepts(two_arguments));
            is_false(accepts(make_operator(null)));
        si

        @Test()
        An_absent_operator_is_declined() is
            is_false(accepts(null));
        si

        @Test()
        An_operator_answering_something_other_than_bool_is_declined() is
            // Nothing requires `=~` to answer bool the way `<>` is
            // required to answer int, and the null arms have no value
            // to produce for one that answers otherwise. Declining
            // leaves the comparison erroring as it did rather than
            // reinterpreting an int result as a bool.
            let answers_int = make_operator(reference_type(), value_type());

            is_false(accepts(answers_int));
        si

        @Test()
        An_operator_with_no_return_type_is_declined() is
            let no_return = INSTANCE_METHOD(loc(), loc(), Semantic.BLOCK_SCOPE(), "=~", Semantic.BLOCK_SCOPE());
            let arguments = LIST[Type]();
            arguments.add(reference_type());
            no_return.arguments = arguments;

            is_false(accepts(no_return));
        si
    si
si
