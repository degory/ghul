namespace Syntax.Process.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Syntax.Process.REFUTABLE_LEAF_RETYPE;

    // Tests for the gate that decides whether COMPILE_EXPRESSIONS must
    // discard a refutable leaf's already-settled symbol type and re-derive
    // it — from the ascription (an ascribed narrow target) or from
    // `right_value` (a destructure element's per-field type). Must never
    // fire for a non-refutable leaf, since a plain `let` has no earlier
    // mistyping to correct.
    class REFUTABLE_LEAF_RETYPE_TESTS is
        @test()

        init() is si

        Calling__needs_retype__not_refutable__returns_false_regardless_of_state() is
            @test()

            Assert.is_false(REFUTABLE_LEAF_RETYPE.needs_retype(false, false, false));
            Assert.is_false(REFUTABLE_LEAF_RETYPE.needs_retype(false, true, false));
            Assert.is_false(REFUTABLE_LEAF_RETYPE.needs_retype(false, false, true));
            Assert.is_false(REFUTABLE_LEAF_RETYPE.needs_retype(false, true, true));
        si

        Calling__needs_retype__refutable_with_neither_explicit_type_nor_right_value__returns_false() is
            @test()

            Assert.is_false(REFUTABLE_LEAF_RETYPE.needs_retype(true, false, false));
        si

        Calling__needs_retype__refutable_with_explicit_type_only__returns_true() is
            @test()

            Assert.is_true(REFUTABLE_LEAF_RETYPE.needs_retype(true, true, false));
        si

        Calling__needs_retype__refutable_with_right_value_only__returns_true() is
            @test()

            Assert.is_true(REFUTABLE_LEAF_RETYPE.needs_retype(true, false, true));
        si

        Calling__needs_retype__refutable_with_both__returns_true() is
            @test()

            Assert.is_true(REFUTABLE_LEAF_RETYPE.needs_retype(true, true, true));
        si
    si
si
