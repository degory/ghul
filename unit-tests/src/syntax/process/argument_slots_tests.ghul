namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for ARGUMENT_SLOTS - the view of a call's written arguments
    // as the callee's formals see them, where the trailing arguments of
    // a call written with its pack spread out fill one formal between
    // them.
    @TestClass()
    class ARGUMENT_SLOTS_TESTS is
        init() is si

        loc(line: int) -> LOCATION => LOCATION("test.ghul", line, 1, line, 5)

        ident(name: string, line: int) -> Trees.Expressions.Expression =>
            Trees.Expressions.IDENTIFIER(loc(line), Trees.Identifiers.Identifier(loc(line), name))

        // `f, a, b, c` as written
        written() -> LIST[Trees.Expressions.Expression] =>
            LIST[Trees.Expressions.Expression]([ident("f", 1), ident("a", 2), ident("b", 3), ident("c", 4)])

        @Test()
        Calling__plain__gives_one_slot_per_written_argument() is
            let slots = ARGUMENT_SLOTS.plain(written())

            is_false(slots.has_spread)
            are_equal(4, slots.count)
            is_false(slots.is_spread(1))
            are_same(slots.written[3], slots.expression(3)!)
            are_equal(0, slots.elements.count)
        si

        @Test()
        Spread_at_the_second_formal__counts_the_formals_rather_than_the_arguments() is
            let slots = ARGUMENT_SLOTS(written(), 1)

            is_true(slots.has_spread)
            are_equal(2, slots.count)
            is_false(slots.is_spread(0))
            is_true(slots.is_spread(1))
        si

        // The spread slot has no expression of its own; the formals
        // before it keep theirs.
        @Test()
        The_spread_slot__has_no_expression() is
            let slots = ARGUMENT_SLOTS(written(), 1)

            are_same(slots.written[0], slots.expression(0)!)
            is_null(slots.expression(1))

            let expressions = slots.expressions

            are_equal(2, expressions.count)
            is_null(expressions[1])
        si

        @Test()
        Calling__elements__gives_the_spread_arguments_in_order() is
            let elements = ARGUMENT_SLOTS(written(), 1).elements

            are_equal(3, elements.count)
            are_equal(2, elements[0].location.start_line)
            are_equal(4, elements[2].location.start_line)
        si

        // The spread slot is located from the first spread argument to
        // the last.
        @Test()
        Calling__location__on_the_spread_slot__spans_every_spread_argument() is
            let location = ARGUMENT_SLOTS(written(), 1).location(1)

            are_equal(2, location.start_line)
            are_equal(4, location.end_line)
        si

        @Test()
        Calling__location__on_a_plain_slot__is_its_expressions_own() is
            let location = ARGUMENT_SLOTS(written(), 1).location(0)

            are_equal(1, location.start_line)
            are_equal(1, location.end_line)
        si
    si
si
