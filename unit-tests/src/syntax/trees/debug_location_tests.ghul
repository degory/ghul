namespace Syntax.Trees.UnitTests is
    use Collections.LIST;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Source.LOCATION;

    use Trees.Expressions.STATEMENT;
    use Trees.Statements.Statement;
    use StatementList = Trees.Statements.LIST;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Pin Node.debug_location for the compound statements that
    // override it. The sequence point a compound statement carries
    // must stop at the end of its header: a span running on to the
    // closing keyword makes every comment and blank line in the body
    // executable as far as a coverage tool is concerned, and leaves a
    // debugger highlighting the whole construct while it evaluates
    // the condition.
    @TestClass()
    class DEBUG_LOCATION_TESTS is
        init() is si

        // A construct opening at 1,1 and closing at 10,5, with a
        // header expression on the opening line.
        whole() -> LOCATION => LOCATION("test.ghul", 1, 1, 10, 5);

        header() -> LOCATION => LOCATION("test.ghul", 1, 10, 1, 20);

        empty_list() -> StatementList
            => StatementList(whole(), LIST[Statement]());

        head_expression() -> STATEMENT
            => STATEMENT(header(), empty_list());

        assert_covers_header_only(location: LOCATION) is
            are_equal(1, location.start_line);
            are_equal(1, location.start_column);
            are_equal(1, location.end_line);
            are_equal(20, location.end_column);
        si

        assert_covers_keyword_only(location: LOCATION) is
            are_equal(1, location.start_line);
            are_equal(1, location.start_column);
            are_equal(1, location.end_line);
            are_equal(1, location.end_column);
        si

        @Test()
        Node__debug_location__defaults_to_the_whole_node() is
            // Every non-compound statement keeps its full span: a
            // simple statement's extent is the code it runs.
            let e = Trees.Statements.EXPRESSION(whole(), head_expression());

            are_equal(10, e.debug_location.end_line);
        si

        @Test()
        FOR__debug_location__stops_at_the_iterated_expression() is
            let f = Trees.Statements.FOR(whole(), null, head_expression(), empty_list());

            assert_covers_header_only(f.debug_location);
        si

        @Test()
        DO__debug_location__stops_at_the_condition() is
            let d = Trees.Statements.DO(whole(), head_expression(), empty_list());

            assert_covers_header_only(d.debug_location);
        si

        @Test()
        DO__debug_location__covers_the_keyword_when_there_is_no_condition() is
            // A bare `do ... od` has no header to run to, so the
            // sequence point sits on the keyword itself.
            let d = Trees.Statements.DO(whole(), null, empty_list());

            assert_covers_keyword_only(d.debug_location);
        si

        @Test()
        IF__debug_location__stops_at_the_first_branch_condition() is
            let branches = LIST[Trees.Statements.IF_BRANCH]();

            branches.add(
                Trees.Statements.IF_BRANCH(whole(), head_expression(), empty_list())
            );

            let i = Trees.Statements.IF(whole(), branches);

            assert_covers_header_only(i.debug_location);
        si

        @Test()
        CASE__debug_location__stops_at_the_scrutinee() is
            let c =
                Trees.Statements.CASE(
                    whole(),
                    head_expression(),
                    LIST[Trees.Statements.CASE_MATCH]()
                );

            assert_covers_header_only(c.debug_location);
        si

        @Test()
        CASE_MATCH__debug_location__stops_at_the_matched_expressions() is
            let expressions =
                Trees.Expressions.LIST(
                    header(),
                    LIST[Trees.Expressions.Expression]()
                );

            let m = Trees.Statements.CASE_MATCH(whole(), expressions, empty_list());

            assert_covers_header_only(m.debug_location);
        si

        @Test()
        TRY__debug_location__covers_the_keyword_only() is
            // `try` has no header expression, and its body, catches
            // and finally all carry their own statements' spans.
            let t =
                Trees.Statements.TRY(
                    whole(),
                    empty_list(),
                    LIST[Trees.Statements.CATCH](),
                    null
                );

            assert_covers_keyword_only(t.debug_location);
        si

        @Test()
        LABELLED__debug_location__runs_from_the_label_to_the_inner_header() is
            let inner = Trees.Statements.FOR(whole(), null, head_expression(), empty_list());

            let l =
                Trees.Statements.LABELLED(
                    whole(),
                    Trees.Identifiers.Identifier(LOCATION("test.ghul", 1, 1, 1, 5), "outer"),
                    inner
                );

            assert_covers_header_only(l.debug_location);
        si
    si
si
