namespace Test is
    use IO.Std.write_line;
    use ProtectedCrossAssemblyAccess;

    // A subclass in another assembly is entitled to `protected` and
    // `protected internal` members, and to a `protected` nested type.
    class SUB: BASE is
        init() is super.init(); si

        protected_method() -> int => helper();

        protected_internal_method() -> int => shared_helper();

        protected_nested_type() -> int => make_nested().value;
    si

    class Main is
        entry() static is
            let s = SUB();

            write_line("protected: {s.protected_method()}");
            write_line("protected internal: {s.protected_internal_method()}");
            write_line("protected nested: {s.protected_nested_type()}");
        si
    si
si
