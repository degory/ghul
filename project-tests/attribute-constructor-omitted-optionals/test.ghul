namespace Test is
    use IO.Std.write_line;

    use OmittedOptionals;

    // ghūl cannot omit an optional argument in an ordinary call, but
    // an attribute pragma may still omit trailing constructor
    // arguments that carry a reflected literal default — MarkAttribute
    // mirrors MSTest 4's TestMethodAttribute shape.
    class HOLDER is
        init() is si

        @Mark()
        no_arguments() is si

        @Mark("only label")
        one_argument() is si

        @Mark("both", 42)
        both_arguments() is si
    si

    class Main is
        show(name: string) static is
            let ty = typeof HOLDER;
            let method = ty.get_method(name)!;

            for a in method.get_custom_attributes(false) do
                let mark = cast MarkAttribute?(a);

                if mark? then
                    write_line("{name}: label={mark.label} line={mark.line}");
                fi
            od
        si

        entry() static is
            show("no_arguments");
            show("one_argument");
            show("both_arguments");

            return;
        si
    si
si
