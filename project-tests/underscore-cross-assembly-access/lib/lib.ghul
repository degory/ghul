namespace UnderscoreCrossAssemblyAccess is
    // Emitted with `assembly` IL accessibility under the default
    // --underscore-access policy, so a consumer in another assembly must not
    // be able to bind to them: doing so compiles clean and then fails the
    // CLR access check at run time.
    _secret_fn(v: int) -> int => v * 100;

    class _SECRET is
        init() is si
    si

    class WIDGET is
        init() is si

        _helper() -> int => 42;

        public_method() -> int => 1;
    si

    public_fn(v: int) -> int => v + 1;

    entry() is si
si
