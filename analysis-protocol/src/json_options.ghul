namespace Analysis.Protocol is
    use System.Text.Json.JsonSerializerOptions;
    use System.Text.Json.Serialization.Metadata.DefaultJsonTypeInfoResolver;
    use System.Text.Json.Serialization.Metadata.JsonTypeInfo;

    // The serializer settings both ends of the protocol read and write
    // with. Shared so the two cannot drift: a member one end emits and
    // the other does not expect is silently dropped rather than reported.
    class JSON_OPTIONS is
        create() -> JsonSerializerOptions static is
            let options = JsonSerializerOptions();

            // A union variant's constructor arguments emit as public CLR
            // fields rather than properties, and the serializer skips
            // fields by default. Both unions need this: a request carries
            // its path and position that way, and every response body is
            // a variant field.
            options.include_fields = true;

            // Including fields also reaches the hidden field behind every
            // auto-property, which carries the property's name with a `$`
            // in front. Left in, each of those writes the value a second
            // time under a name no reader on either end looks for, which
            // for a whole file's semantic tokens is most of the message.
            let resolver = DefaultJsonTypeInfoResolver();

            resolver.modifiers.add(
                (type_info: JsonTypeInfo) is
                    let i mut = type_info.properties.count - 1;

                    while i >= 0 do
                        if type_info.properties[i].name.starts_with('$') then
                            type_info.properties.remove_at(i);
                        fi

                        i = i - 1;
                    od
                si
            );

            options.type_info_resolver = resolver;

            return options;
        si
    si
si
