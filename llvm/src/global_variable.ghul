namespace LLVM is
    /// A global variable. With an initialiser it is a definition; without
    /// one it declares a variable another module defines.
    class GLOBAL_VARIABLE is
        /// The name it is written with, without the `@`.
        name: string

        /// The type of the value the variable holds. The variable itself is
        /// a pointer to it.
        type: Type

        /// The value it starts with, or absent for a declaration.
        initializer: Value?

        /// Whether the value can never be written, written `constant`
        /// rather than `global`.
        is_constant: bool

        /// How far outside its module the variable can be seen.
        linkage: Linkage public

        /// Whether the variable's address is significant.
        unnamed_address: UnnamedAddress public

        /// Whether the variable is known to resolve within the linked
        /// executable, written `dso_local`.
        dso_local: bool public

        /// The variable's alignment in bytes, or zero to leave it to the
        /// target.
        alignment: int public

        /// A reference to the variable, as an operand or an initialiser
        /// names it.
        reference: Value => Values.global(name)

        /// - name: the name it is written with, without the `@`
        /// - type: the type of the value it holds
        /// - initializer: the value it starts with, or absent for a declaration
        /// - is_constant: whether the value can never be written
        init(name: string, type: Type, initializer: Value?, is_constant: bool) is
            self.name = name
            self.type = type
            self.initializer = initializer
            self.is_constant = is_constant
        si
    si
si
