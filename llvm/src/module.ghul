namespace LLVM is
    use Collections.LIST
    use Collections.List
    use Collections.MAP

    /// An LLVM module: the named types, global variables and functions one
    /// `.ll` file holds, in the order they were added.
    class MODULE is
        _types: LIST[TYPE_DEFINITION]
        _type_names: MAP[string, TYPE_DEFINITION]
        _globals: LIST[GLOBAL_VARIABLE]
        _functions: LIST[FUNCTION]
        _global_names: MAP[string, object]

        /// The name of the source the module was compiled from, written
        /// `source_filename = "..."`.
        source_filename: string? public

        /// The target's data layout string, written
        /// `target datalayout = "..."`.
        data_layout: string? public

        /// The target triple, written `target triple = "..."`.
        target_triple: string? public

        /// The named struct types, in the order they were added.
        types: List[TYPE_DEFINITION] => _types

        /// The global variables, in the order they were added.
        globals: List[GLOBAL_VARIABLE] => _globals

        /// The functions, declarations and definitions alike, in the order
        /// they were added.
        functions: List[FUNCTION] => _functions

        init() is
            _types = LIST[TYPE_DEFINITION]()
            _type_names = MAP[string, TYPE_DEFINITION]()
            _globals = LIST[GLOBAL_VARIABLE]()
            _functions = LIST[FUNCTION]()
            _global_names = MAP[string, object]()
        si

        /// Gives a struct type a name. Throws if the name is already taken.
        /// - name: the name it is written with, without the `%`
        /// - body: the struct the name stands for, or absent for an opaque type
        add_type(name: string, body: Type?) -> TYPE_DEFINITION is
            if _type_names.contains_key(name) then
                throw Ghul.ArgumentException("type %{name} is already defined")
            fi

            let definition = TYPE_DEFINITION(name, body)

            _types.add(definition)
            _type_names[name] = definition

            return definition
        si

        /// The named type called `name`, or absent if there is none.
        type_named(name: string) -> TYPE_DEFINITION? is
            let definition: TYPE_DEFINITION mut

            if _type_names.try_get_value(name, definition ref) then
                return definition
            fi

            return null
        si

        /// Adds a global variable. Throws if a global or a function already
        /// has its name.
        add_global(global: GLOBAL_VARIABLE) -> GLOBAL_VARIABLE is
            _claim(global.name, global)

            _globals.add(global)

            return global
        si

        /// Adds a function. Throws if a global or a function already has its
        /// name.
        add_function(function: FUNCTION) -> FUNCTION is
            _claim(function.name, function)

            _functions.add(function)

            return function
        si

        /// The function called `name`, or absent if there is none.
        function_named(name: string) -> FUNCTION? is
            let found: object mut

            if _global_names.try_get_value(name, found ref) then
                return cast FUNCTION?(found)
            fi

            return null
        si

        /// Adds a declaration of an intrinsic unless the module already
        /// declares it, and returns the module's declaration either way.
        /// - intrinsic: a declaration, as `Intrinsics` makes one
        declare_intrinsic(intrinsic: FUNCTION) -> FUNCTION is
            if let existing = function_named(intrinsic.name) then
                return existing
            fi

            return add_function(intrinsic)
        si

        _claim(name: string, owner: object) is
            if _global_names.contains_key(name) then
                throw Ghul.ArgumentException("@{name} is already defined")
            fi

            _global_names[name] = owner
        si
    si
si
