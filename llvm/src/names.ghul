namespace LLVM is
    /// How names and quoted strings are spelled in LLVM IR text.
    class Names is
        /// A local name with its `%`, quoted if it needs to be.
        local(name: string) -> string static => "%{identifier(name)}"

        /// A global name with its `@`, quoted if it needs to be.
        global(name: string) -> string static => "@{identifier(name)}"

        /// A name as written after its sigil. A name made only of letters,
        /// digits and `-$._`, not starting with a digit, is written as it
        /// stands; any other is quoted. A name starting with a digit is
        /// quoted so that it can never be read as one of LLVM's implicit
        /// numbers.
        /// - name: the name, which must not be empty or contain a zero character
        identifier(name: string) -> string static is
            if name.length == 0 then
                throw Ghul.ArgumentException("a name cannot be empty")
            fi

            if name.contains('\u0000') then
                throw Ghul.ArgumentException("a name cannot contain a zero character")
            fi

            if _is_bare(name) then
                return name
            fi

            return quoted(System.Text.Encoding.utf8.get_bytes(name))
        si

        /// Bytes as a quoted string, `"..."`. A printable ASCII character
        /// other than `"` and `\` stands for itself; any other byte is
        /// written `\XX` in hexadecimal.
        quoted(bytes: ubyte[]) -> string static is
            let result = Text.STRING_BUILDER()

            result.append('"')

            for b in bytes do
                if b >= 0x20ub /\ b <= 0x7Eub /\ b != 0x22ub /\ b != 0x5Cub then
                    result.append(cast char(b))
                else
                    result.append('\\')
                    result.append(b.to_string("X2"))
                fi
            od

            result.append('"')

            return result.to_string()
        si

        /// A string as a quoted string, encoded as UTF-8.
        quoted(text: string) -> string static => quoted(System.Text.Encoding.utf8.get_bytes(text))

        _is_bare(name: string) -> bool static is
            if name[0] >= '0' /\ name[0] <= '9' then
                return false
            fi

            for c in name do
                let letter = (c >= 'a' /\ c <= 'z') \/ (c >= 'A' /\ c <= 'Z')
                let digit = c >= '0' /\ c <= '9'

                if !letter /\ !digit /\ c != '-' /\ c != '$' /\ c != '.' /\ c != '_' then
                    return false
                fi
            od

            return true
        si
    si
si
