namespace LLVM is
    use Collections.LIST

    /// A metadata operand: what a metadata node, a named metadata entry or
    /// an attachment holds.
    union Metadata is
        /// A string, written `!"..."`.
        STRING(text: string)

        /// A typed value, such as `i32 3`.
        VALUE(value: Value)

        /// A node defined in the module, written `!N`.
        NODE(index: int)

        /// An absent operand, written `null`.
        NULL
    si

    /// A metadata node, defined in the module as `!N = ...`.
    union MetadataNode is
        /// A plain node: a list of operands, written `!{...}`.
        TUPLE(elements: Metadata[])

        /// A source file, `!DIFile`.
        FILE(filename: string, directory: string)

        /// A compilation unit, `!DICompileUnit`. The language is written as
        /// given, such as `DW_LANG_C99`.
        COMPILE_UNIT(language: string, file: Metadata, producer: string, is_optimized: bool, emission: DebugEmission)

        /// The type of a subprogram, `!DISubroutineType`. `types` is a
        /// tuple of the result type and then the parameter types, any of
        /// which may be `null`.
        SUBROUTINE_TYPE(types: Metadata)

        /// A function, `!DISubprogram`. A definition names the compile unit
        /// it belongs to.
        SUBPROGRAM(
            name: string,
            linkage_name: string?,
            scope: Metadata,
            file: Metadata,
            line: int,
            type: Metadata,
            scope_line: int,
            is_definition: bool,
            unit: Metadata?)

        /// A source location, `!DILocation`: a line and column within a
        /// scope.
        LOCATION(line: int, column: int, scope: Metadata, inlined_at: Metadata?)
    si

    /// How much debug information a compile unit carries.
    enum DebugEmission is
        NO_DEBUG,
        FULL_DEBUG,
        LINE_TABLES_ONLY
    si

    /// What the linker does when two modules give the same module flag
    /// different values.
    enum ModuleFlagBehavior is
        ERROR = 1,
        WARNING = 2,
        REQUIRE = 3,
        OVERRIDE = 4,
        APPEND = 5,
        APPEND_UNIQUE = 6,
        MAX = 7,
        MIN = 8
    si

    /// A metadata node defined in a module: its number, its content, and
    /// whether it is `distinct`, so never merged with an equal node.
    class METADATA_DEFINITION is
        /// The number it is written with, `!N`.
        index: int

        /// What the node holds.
        node: MetadataNode

        /// Whether the node is written `distinct`.
        is_distinct: bool

        /// - index: the number it is written with
        /// - node: what it holds
        /// - is_distinct: whether it is written `distinct`
        init(index: int, node: MetadataNode, is_distinct: bool) is
            self.index = index
            self.node = node
            self.is_distinct = is_distinct
        si
    si

    /// A named metadata entry, written `!name = !{...}`, whose operands
    /// are references to numbered nodes.
    class NAMED_METADATA is
        /// The name it is written with, without the `!`.
        name: string

        /// The nodes it lists, in order.
        operands: LIST[Metadata]

        /// - name: the name it is written with, without the `!`
        init(name: string) is
            self.name = name
            operands = LIST[Metadata]()
        si
    si
si
