namespace LLVM is
    /// A struct type given a name in the module, written
    /// `%name = type { ... }`. Without a body it is opaque. The body can
    /// be set after the definition is made, so a type can be named before
    /// its fields are known.
    class TYPE_DEFINITION is
        /// The name it is written with, without the `%`.
        name: string

        /// The struct the name stands for, which must be a `Type.STRUCT`,
        /// or absent for an opaque type.
        body: Type? public

        /// The type as an operand or a field names it.
        type: Type => Type.NAMED(name)

        /// - name: the name it is written with, without the `%`
        /// - body: the struct it stands for, or absent for an opaque type
        init(name: string, body: Type?) is
            self.name = name
            self.body = body
        si
    si
si
