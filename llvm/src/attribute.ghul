namespace LLVM is
    /// An attribute on a function, its result, a parameter or a call. The
    /// attribute's own name is written as given, so any attribute the
    /// LLVM in use understands can be named.
    union Attribute is
        /// An attribute that is only a keyword, such as `nounwind`.
        FLAG(name: string)

        /// An attribute taking an integer in parentheses, such as
        /// `dereferenceable(8)`.
        INTEGER(name: string, value: long)

        /// The alignment of a pointer parameter or result, written
        /// `align N`.
        ALIGN(bytes: int)

        /// An attribute taking a type in parentheses, such as `sret(%T)`.
        TYPED(name: string, type: Type)

        /// A target-dependent attribute, written `"key"` or
        /// `"key"="value"`.
        STRING(key: string, value: string?)
    si

    /// How far outside its module a global or a function can be seen.
    enum Linkage is
        EXTERNAL,
        PRIVATE,
        INTERNAL,
        AVAILABLE_EXTERNALLY,
        LINKONCE,
        LINKONCE_ODR,
        WEAK,
        WEAK_ODR,
        COMMON,
        APPENDING,
        EXTERN_WEAK
    si

    /// Whether a global's address is significant.
    enum UnnamedAddress is
        NONE,
        LOCAL,
        GLOBAL
    si

    /// The calling convention of a function and of the calls to it.
    enum CallingConvention is
        C,
        FAST,
        COLD,
        TAIL
    si
si
