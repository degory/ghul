namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class VALUE_TESTS is
        init() is si

        @Test()
        integer__is_written_as_the_signed_value_of_its_bits() is
            are_equal("i32 42", WRITER.operand_text(Values.i32(42)))
            are_equal("i32 -1", WRITER.operand_text(Values.i32(-1)))
            are_equal("i8 -1", WRITER.operand_text(Values.integer(Types.i8, bigint(255))))
            are_equal("i8 127", WRITER.operand_text(Values.integer(Types.i8, bigint(127))))
            are_equal("i8 -128", WRITER.operand_text(Values.integer(Types.i8, bigint(128))))
            are_equal("i64 -9223372036854775808", WRITER.operand_text(Values.i64(long.min_value)))
            are_equal("i17 -1", WRITER.operand_text(Values.integer(Type.INTEGER(17), bigint(131071))))
        si

        @Test()
        integer__of_one_bit_is_true_or_false() is
            are_equal("i1 true", WRITER.operand_text(Values.boolean(true)))
            are_equal("i1 false", WRITER.operand_text(Values.boolean(false)))
            are_equal("i1 true", WRITER.operand_text(Values.integer(Types.i1, bigint(-1))))
        si

        @Test()
        integer__that_does_not_fit__is_refused() is
            throws(() => Values.integer(Types.i8, bigint(256)))
            throws(() => Values.integer(Types.i8, bigint(-129)))
            throws(() => Values.integer(Type.DOUBLE, bigint(1)))
        si

        @Test()
        double__is_written_as_the_hexadecimal_of_its_bits() is
            are_equal("double 0x3FF0000000000000", WRITER.operand_text(Values.of_double(1.0)))
            are_equal("double 0x3FB999999999999A", WRITER.operand_text(Values.of_double(0.1)))
            are_equal("double 0x8000000000000000", WRITER.operand_text(Values.of_double(-0.0)))
            are_equal("double 0x7FF0000000000000", WRITER.operand_text(Values.of_double(double.positive_infinity)))
        si

        @Test()
        float__is_written_as_the_double_of_the_same_value() is
            are_equal("float 0x3FB99999A0000000", WRITER.operand_text(Values.of_single(0.1s)))
            are_equal("float 0x3FF0000000000000", WRITER.operand_text(Values.of_single(1.0s)))
            are_equal("float 0xFFF0000000000000", WRITER.operand_text(Values.of_single(single.negative_infinity)))
        si

        @Test()
        float__subnormal__is_normalised_into_the_double() is
            // The smallest positive float, 2^-149.
            are_equal("float 0x36A0000000000000", WRITER.operand_text(Value.FLOATING(1ul, Type.FLOAT)))

            // The largest float subnormal, (1 - 2^-23) * 2^-126.
            are_equal("float 0x380FFFFFC0000000", WRITER.operand_text(Value.FLOATING(0x7F_FFFFul, Type.FLOAT)))
        si

        @Test()
        float__nan_keeps_its_payload_and_its_signalling_bit() is
            are_equal("float 0x7FF0000020000000", WRITER.operand_text(Value.FLOATING(0x7F80_0001ul, Type.FLOAT)))
            are_equal("float 0x7FF8000000000000", WRITER.operand_text(Value.FLOATING(0x7FC0_0000ul, Type.FLOAT)))
        si

        @Test()
        half__is_written_with_its_own_sixteen_bits() is
            are_equal("half 0xH3C00", WRITER.operand_text(Values.of_half(0x3C00us)))
            are_equal("half 0xH0001", WRITER.operand_text(Values.of_half(1us)))
        si

        @Test()
        keywords__are_written_for_the_special_constants() is
            are_equal("ptr null", WRITER.operand_text(Values.null_pointer))
            are_equal("[2 x i32] zeroinitializer", WRITER.operand_text(Values.zero(Type.ARRAY(2, Types.i32))))
            are_equal("i32 undef", WRITER.operand_text(Values.undef(Types.i32)))
            are_equal("i64 poison", WRITER.operand_text(Values.poison(Types.i64)))
        si

        @Test()
        local_and_global__are_written_by_name() is
            are_equal("i32 %x", WRITER.operand_text(Values.local(Types.i32, "x")))
            are_equal("ptr @main", WRITER.operand_text(Values.global("main")))
            are_equal("ptr @\"a b\"", WRITER.operand_text(Values.global("a b")))
        si

        @Test()
        aggregate__is_written_by_its_type() is
            are_equal(
                "[2 x i32] [i32 1, i32 2]",
                WRITER.operand_text(Value.AGGREGATE([Values.i32(1), Values.i32(2)], Type.ARRAY(2, Types.i32))))
            are_equal(
                "<2 x i32> <i32 1, i32 2>",
                WRITER.operand_text(Value.AGGREGATE([Values.i32(1), Values.i32(2)], Type.VECTOR(2, Types.i32))))
            are_equal(
                "{{ i32, ptr }} {{ i32 1, ptr null }}",
                WRITER.operand_text(Value.AGGREGATE([Values.i32(1), Values.null_pointer], Types.structure([Types.i32, Types.pointer]))))
            are_equal(
                "<{{ i8 }}> <{{ i8 1 }}>",
                WRITER.operand_text(Value.AGGREGATE([Values.integer(Types.i8, bigint(1))], Type.STRUCT([Types.i8], true))))
            are_equal("[0 x i32] []", WRITER.operand_text(Value.AGGREGATE([], Type.ARRAY(0, Types.i32))))
            are_equal("{{}} {{}}", WRITER.operand_text(Value.AGGREGATE([], Types.structure([]))))
        si

        @Test()
        string__escapes_quotes_backslashes_and_unprintable_bytes() is
            are_equal(
                "[9 x i8] c\"a\\22b\\5Cc\\0A\\00\\C3\\A9\"",
                WRITER.operand_text(Values.c_string("a\"b\\c\n\u0000é", false)))
        si

        @Test()
        string__terminated__ends_in_a_zero_byte() is
            are_equal("[3 x i8] c\"hi\\00\"", WRITER.operand_text(Values.c_string("hi", true)))
        si

        @Test()
        values__compare_by_structure() is
            is_true(Values.i32(1) =~ Values.i32(1))
            is_false(Values.i32(1) =~ Values.i64(1L))
            is_true(Values.c_string("x", true) =~ Values.c_string("x", true))
        si
    si
si
