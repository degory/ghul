namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class FUNCTION_TESTS is
        init() is si

        _text(function: FUNCTION) -> string is
            let writer = WRITER()

            writer.write(function)

            return writer.text
        si

        @Test()
        declaration__lists_parameter_types_without_names() is
            let f = FUNCTION("f", Types.i32, [PARAMETER(Types.i32, "x"), PARAMETER(Types.pointer, "p")])

            are_equal("declare i32 @f(i32, ptr)\n", _text(f))
        si

        @Test()
        variadic__ends_its_parameters_with_an_ellipsis() is
            let printf = FUNCTION("printf", Types.i32, [PARAMETER(Types.pointer, "format")])
            printf.is_variadic = true

            let only = FUNCTION("only", Type.VOID, [])
            only.is_variadic = true

            are_equal("declare i32 @printf(ptr, ...)\n", _text(printf))
            are_equal("declare void @only(...)\n", _text(only))
        si

        @Test()
        definition__names_its_parameters_and_writes_its_blocks() is
            let f = FUNCTION("identity", Types.i32, [PARAMETER(Types.i32, "x")])

            f.add_block("entry").return_value(f.parameter(0))

            are_equal("define i32 @identity(i32 %x) {{\nentry:\n  ret i32 %x\n}}\n", _text(f))
        si

        @Test()
        blocks__are_separated_by_a_blank_line() is
            let f = FUNCTION("f", Type.VOID, [])
            let entry = f.add_block("entry")
            let next = f.add_block("next")

            entry.branch(next)
            next.return_void()

            are_equal("define void @f() {{\nentry:\n  br label %next\n\nnext:\n  ret void\n}}\n", _text(f))
        si

        @Test()
        everything__is_written_in_llvm_order() is
            let f = FUNCTION("f", Types.pointer, [PARAMETER(Types.pointer, "p")])

            f.linkage = Linkage.INTERNAL
            f.dso_local = true
            f.calling_convention = CallingConvention.FAST
            f.result_attributes.add(Attribute.FLAG("nonnull"))
            f.parameters[0].attributes.add(Attribute.FLAG("noundef"))
            f.unnamed_address = UnnamedAddress.GLOBAL
            f.attributes.add(Attribute.FLAG("nounwind"))
            f.personality = Values.global("personality")
            f.attach("dbg", Metadata.NODE(3))

            f.add_block("entry").return_value(f.parameter(0))

            are_equal(
                "define internal dso_local fastcc nonnull ptr @f(ptr noundef %p) unnamed_addr nounwind personality ptr @personality !dbg !3 {{\nentry:\n  ret ptr %p\n}}\n",
                _text(f))
        si

        @Test()
        declaration__with_a_linkage_needing_a_body__is_refused() is
            let f = FUNCTION("f", Type.VOID, [])
            f.linkage = Linkage.INTERNAL

            throws(() => _text(f))
        si

        @Test()
        declaration__with_attachments__is_refused() is
            let f = FUNCTION("f", Type.VOID, [])
            f.attach("dbg", Metadata.NODE(0))

            throws(() => _text(f))
        si

        @Test()
        type__is_built_from_the_parameters() is
            let f = FUNCTION("f", Types.i32, [PARAMETER(Types.i32, "x"), PARAMETER(Types.pointer, "p")])
            f.is_variadic = true

            are_equal("i32 (i32, ptr, ...)", WRITER.type_text(f.type))
        si

        @Test()
        fresh_name__counts_up_from_t0() is
            let f = FUNCTION("f", Type.VOID, [])

            are_equal("t0", f.fresh_name())
            are_equal("t1", f.fresh_name())
        si

        @Test()
        check__refuses_an_empty_block() is
            let f = FUNCTION("f", Type.VOID, [])
            f.add_block("entry")

            are_equal("block %entry in @f is empty", throws(() => f.check()))
        si

        @Test()
        check__refuses_a_block_with_no_terminator() is
            let f = FUNCTION("f", Types.i32, [PARAMETER(Types.i32, "x")])
            f.add_block("entry").binary(BinaryOperator.ADD, IntegerFlags.NONE, f.parameter(0), f.parameter(0))

            are_equal("block %entry in @f does not end in a terminator", throws(() => f.check()))
        si

        @Test()
        check__refuses_a_terminator_before_the_end() is
            let f = FUNCTION("f", Type.VOID, [])
            let entry = f.add_block("entry")

            entry.return_void()
            entry.return_void()

            are_equal("block %entry in @f has a terminator before its end", throws(() => f.check()))
        si

        @Test()
        check__refuses_a_name_used_twice() is
            let f = FUNCTION("f", Type.VOID, [PARAMETER(Types.i32, "entry")])
            f.add_block("entry").return_void()

            are_equal("%entry is defined more than once in @f", throws(() => f.check()))
        si

        @Test()
        check__refuses_a_result_named_like_a_parameter() is
            let f = FUNCTION("f", Types.i32, [PARAMETER(Types.i32, "t0")])
            let entry = f.add_block("entry")

            entry.return_value(entry.binary(BinaryOperator.ADD, IntegerFlags.NONE, f.parameter(0), f.parameter(0)))

            are_equal("%t0 is defined more than once in @f", throws(() => f.check()))
        si

        @Test()
        check__refuses_a_branch_to_another_function_s_block() is
            let other = FUNCTION("other", Type.VOID, [])
            let elsewhere = other.add_block("elsewhere")

            let f = FUNCTION("f", Type.VOID, [])
            f.add_block("entry").branch(elsewhere)

            are_equal("@f branches to %elsewhere, which is not one of its blocks", throws(() => f.check()))
        si

        @Test()
        check__accepts_a_well_formed_definition() is
            let f = FUNCTION("f", Type.VOID, [PARAMETER(Types.i1, "c")])
            let entry = f.add_block("entry")
            let yes = f.add_block("yes")
            let no = f.add_block("no")

            entry.branch(f.parameter(0), yes, no)
            yes.return_void()
            no.unreachable()

            f.check()
        si
    si
si
