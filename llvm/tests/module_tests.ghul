namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class MODULE_TESTS is
        init() is si

        @Test()
        empty_module__is_written_as_nothing() is
            are_equal("", WRITER.module_text(MODULE()))
        si

        @Test()
        header__is_written_one_line_each() is
            let module = MODULE()

            module.source_filename = "a.ghul"
            module.data_layout = "e-m:e"
            module.target_triple = "x86_64-unknown-linux-musl"

            are_equal(
                "source_filename = \"a.ghul\"\ntarget datalayout = \"e-m:e\"\ntarget triple = \"x86_64-unknown-linux-musl\"\n",
                WRITER.module_text(module))
        si

        @Test()
        sections__are_separated_by_one_blank_line() is
            let module = MODULE()

            module.target_triple = "x86_64-unknown-linux-musl"
            module.add_type("pair", Types.structure([Types.i32, Types.i32]))
            module.add_type("hidden", null)
            module.add_global(GLOBAL_VARIABLE("g", Types.i32, Values.i32(1), false))
            module.add_function(FUNCTION("external", Type.VOID, []))

            let f = module.add_function(FUNCTION("f", Type.VOID, []))
            f.add_block("entry").return_void()

            module.named("ghul.notes").operands.add(module.add_metadata(MetadataNode.TUPLE([]), false))

            are_equal(
                "target triple = \"x86_64-unknown-linux-musl\"\n"
                "\n"
                "%pair = type {{ i32, i32 }}\n"
                "%hidden = type opaque\n"
                "\n"
                "@g = global i32 1\n"
                "\n"
                "declare void @external()\n"
                "\n"
                "define void @f() {{\n"
                "entry:\n"
                "  ret void\n"
                "}}\n"
                "\n"
                "!ghul.notes = !{{!0}}\n"
                "\n"
                "!0 = !{{}}\n",
                WRITER.module_text(module))
        si

        @Test()
        named_struct_constant__is_written_packed_when_its_definition_is() is
            let module = MODULE()

            let tight = module.add_type("tight", Type.STRUCT([Types.i8, Types.i8], true))
            let one = Values.integer(Types.i8, bigint(1))

            module.add_global(GLOBAL_VARIABLE("t", tight.type, Value.AGGREGATE([one, one], tight.type), true))

            are_equal(
                "%tight = type <{{ i8, i8 }}>\n\n@t = constant %tight <{{ i8 1, i8 1 }}>\n",
                WRITER.module_text(module))
        si

        @Test()
        named_type__whose_body_is_not_a_struct__is_refused() is
            let module = MODULE()

            module.add_type("wrong", Types.i32)

            throws(() => WRITER.module_text(module))
        si

        @Test()
        names__cannot_be_defined_twice() is
            let module = MODULE()

            module.add_type("t", null)
            module.add_global(GLOBAL_VARIABLE("g", Types.i32, null, false))

            are_equal("type %t is already defined", throws(() => module.add_type("t", null)))
            are_equal("@g is already defined", throws(() => module.add_function(FUNCTION("g", Type.VOID, []))))
        si

        @Test()
        type_named_and_function_named__find_what_was_added() is
            let module = MODULE()

            let definition = module.add_type("t", null)
            let function = module.add_function(FUNCTION("f", Type.VOID, []))
            module.add_global(GLOBAL_VARIABLE("g", Types.i32, null, false))

            is_true(module.type_named("t") == definition)
            is_false(module.type_named("u")?)
            is_true(module.function_named("f") == function)
            is_false(module.function_named("g")?)
        si

        @Test()
        declare_intrinsic__adds_each_intrinsic_once() is
            let module = MODULE()

            let first = module.declare_intrinsic(Intrinsics.trap())
            let second = module.declare_intrinsic(Intrinsics.trap())

            is_true(first == second)
            are_equal(1, module.functions.count)
        si

        @Test()
        add_metadata__numbers_nodes_in_the_order_they_are_added() is
            let module = MODULE()

            are_equal("!0", _metadata_text(module.add_metadata(MetadataNode.TUPLE([]), false)))
            are_equal("!1", _metadata_text(module.add_metadata(MetadataNode.TUPLE([]), true)))
        si

        @Test()
        empty_metadata__is_defined_once_and_shared() is
            let module = MODULE()

            module.add_metadata(MetadataNode.TUPLE([]), true)

            are_equal("!1", _metadata_text(module.empty_metadata()))
            are_equal("!1", _metadata_text(module.empty_metadata()))
            are_equal(2, module.metadata.count)
        si

        @Test()
        replace_metadata__redefines_a_node_keeping_its_number_and_distinctness() is
            let module = MODULE()
            let first = module.add_metadata(MetadataNode.TUPLE([]), true)
            let second = module.add_metadata(MetadataNode.TUPLE([first]), false)

            module.replace_metadata(first, MetadataNode.TUPLE([second]))

            are_equal(0, module.metadata[0].index)
            is_true(module.metadata[0].is_distinct)
            let writer = WRITER()

            writer.write(module.metadata[0].node)

            are_equal("!{{!1}}", writer.text)
        si

        @Test()
        add_module_flag__adds_a_node_to_llvm_module_flags() is
            let module = MODULE()

            module.add_module_flag(ModuleFlagBehavior.WARNING, "Debug Info Version", Values.i32(3))
            module.add_module_flag(ModuleFlagBehavior.MAX, "Dwarf Version", Values.i32(5))

            are_equal(
                "!llvm.module.flags = !{{!0, !1}}\n\n"
                "!0 = !{{i32 2, !\"Debug Info Version\", i32 3}}\n"
                "!1 = !{{i32 7, !\"Dwarf Version\", i32 5}}\n",
                WRITER.module_text(module))
        si

        @Test()
        named__returns_the_same_entry_for_the_same_name() is
            let module = MODULE()

            is_true(module.named("x") == module.named("x"))
            are_equal(1, module.named_metadata.count)
        si

        _metadata_text(metadata: Metadata) -> string is
            let writer = WRITER()

            writer.write(metadata)

            return writer.text
        si
    si
si
