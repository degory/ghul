namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class INTRINSICS_TESTS is
        init() is si

        _text(function: FUNCTION) -> string is
            let writer = WRITER()

            writer.write(function)

            return writer.text
        si

        @Test()
        memory_intrinsics__take_pointers_a_length_and_a_volatile_flag() is
            are_equal("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n", _text(Intrinsics.memcpy()))
            are_equal("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n", _text(Intrinsics.memset()))
        si

        @Test()
        trap__takes_nothing() is
            are_equal("declare void @llvm.trap()\n", _text(Intrinsics.trap()))
        si

        @Test()
        saturating_conversions__are_named_for_both_types() is
            are_equal(
                "declare i32 @llvm.fptosi.sat.i32.f64(double)\n",
                _text(Intrinsics.float_to_signed_saturating(Types.i32, Type.DOUBLE)))
            are_equal(
                "declare i8 @llvm.fptoui.sat.i8.f16(half)\n",
                _text(Intrinsics.float_to_unsigned_saturating(Types.i8, Type.HALF)))
        si

        @Test()
        with_overflow__returns_the_value_and_a_flag() is
            let expected = [
                (Overflow.SIGNED_ADD, "sadd"),
                (Overflow.UNSIGNED_ADD, "uadd"),
                (Overflow.SIGNED_SUB, "ssub"),
                (Overflow.UNSIGNED_SUB, "usub"),
                (Overflow.SIGNED_MUL, "smul"),
                (Overflow.UNSIGNED_MUL, "umul")
            ]

            for (operation, name) in expected do
                are_equal(
                    "declare {{ i64, i1 }} @llvm.{name}.with.overflow.i64(i64, i64)\n",
                    _text(Intrinsics.with_overflow(operation, Types.i64)))
            od
        si

        @Test()
        suffix__names_each_type_as_llvm_mangles_it() is
            are_equal("i1", Intrinsics.suffix(Types.i1))
            are_equal("f16", Intrinsics.suffix(Type.HALF))
            are_equal("f32", Intrinsics.suffix(Type.FLOAT))
            are_equal("f64", Intrinsics.suffix(Type.DOUBLE))
            are_equal("p0", Intrinsics.suffix(Types.pointer))
            are_equal("p1", Intrinsics.suffix(Type.POINTER(1)))
            are_equal("v4f32", Intrinsics.suffix(Type.VECTOR(4, Type.FLOAT)))
            throws(() => Intrinsics.suffix(Types.structure([])))
        si
    si
si
