namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class GLOBAL_VARIABLE_TESTS is
        init() is si

        _text(global: GLOBAL_VARIABLE) -> string is
            let writer = WRITER()

            writer.write(global)

            return writer.text
        si

        @Test()
        definition__is_written_with_its_initializer() is
            are_equal("@g = global i32 7", _text(GLOBAL_VARIABLE("g", Types.i32, Values.i32(7), false)))
            are_equal("@c = constant i64 0", _text(GLOBAL_VARIABLE("c", Types.i64, Values.i64(0L), true)))
        si

        @Test()
        declaration__is_written_external() is
            are_equal("@e = external global i32", _text(GLOBAL_VARIABLE("e", Types.i32, null, false)))

            let weak = GLOBAL_VARIABLE("w", Types.pointer, null, true)
            weak.linkage = Linkage.EXTERN_WEAK

            are_equal("@w = extern_weak constant ptr", _text(weak))
        si

        @Test()
        declaration__with_a_linkage_needing_a_definition__is_refused() is
            let global = GLOBAL_VARIABLE("p", Types.i32, null, false)
            global.linkage = Linkage.PRIVATE

            throws(() => _text(global))
        si

        @Test()
        everything__is_written_in_llvm_order() is
            let global = GLOBAL_VARIABLE("s", Type.ARRAY(3, Types.i8), Values.c_string("hi", true), true)

            global.linkage = Linkage.PRIVATE
            global.dso_local = true
            global.unnamed_address = UnnamedAddress.GLOBAL
            global.alignment = 1

            are_equal("@s = private dso_local unnamed_addr constant [3 x i8] c\"hi\\00\", align 1", _text(global))
        si

        @Test()
        each_linkage__has_its_keyword() is
            let expected = [
                (Linkage.PRIVATE, "private"),
                (Linkage.INTERNAL, "internal"),
                (Linkage.AVAILABLE_EXTERNALLY, "available_externally"),
                (Linkage.LINKONCE, "linkonce"),
                (Linkage.LINKONCE_ODR, "linkonce_odr"),
                (Linkage.WEAK, "weak"),
                (Linkage.WEAK_ODR, "weak_odr"),
                (Linkage.COMMON, "common"),
                (Linkage.APPENDING, "appending")
            ]

            for (linkage, keyword) in expected do
                let global = GLOBAL_VARIABLE("g", Types.i32, Values.zero(Types.i32), false)
                global.linkage = linkage

                are_equal("@g = {keyword} global i32 zeroinitializer", _text(global))
            od
        si

        @Test()
        local_unnamed_address__is_written_local_unnamed_addr() is
            let global = GLOBAL_VARIABLE("g", Types.i32, Values.i32(1), false)
            global.unnamed_address = UnnamedAddress.LOCAL

            are_equal("@g = local_unnamed_addr global i32 1", _text(global))
        si

        @Test()
        reference__is_a_pointer_to_the_global() is
            are_equal("ptr @g", WRITER.operand_text(GLOBAL_VARIABLE("g", Types.i32, null, false).reference))
        si
    si
si
