namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class BLOCK_TESTS is
        init() is si

        _texts(block: BLOCK) -> string is
            let lines = Collections.LIST[string]()

            for instruction in block.instructions do
                lines.add(WRITER.instruction_text(instruction))
            od

            return string.join("\n", lines)
        si

        @Test()
        each_result__takes_the_function_s_next_name() is
            let f = FUNCTION("f", Types.i32, [PARAMETER(Types.i32, "a")])
            let block = f.add_block("entry")

            let first = block.binary(BinaryOperator.ADD, IntegerFlags.NONE, f.parameter(0), Values.i32(1))
            let second = block.binary(BinaryOperator.MUL, IntegerFlags.NONE, first, first)

            are_equal("i32 %t0", WRITER.operand_text(first))
            are_equal("i32 %t1", WRITER.operand_text(second))
        si

        @Test()
        names__run_on_across_the_function_s_blocks() is
            let f = FUNCTION("f", Types.i32, [PARAMETER(Types.i32, "a")])
            let one = f.add_block("one")
            let two = f.add_block("two")

            one.binary(BinaryOperator.ADD, IntegerFlags.NONE, f.parameter(0), f.parameter(0))

            are_equal("i32 %t1", WRITER.operand_text(two.binary(BinaryOperator.ADD, IntegerFlags.NONE, f.parameter(0), f.parameter(0))))
        si

        @Test()
        results__have_the_type_their_operation_produces() is
            let f = FUNCTION("f", Type.VOID, [PARAMETER(Types.i32, "a"), PARAMETER(Type.DOUBLE, "x")])
            let block = f.add_block("entry")

            are_equal("ptr %t0", WRITER.operand_text(block.alloca(Types.i64, 8)))
            are_equal("i64 %t1", WRITER.operand_text(block.load(Types.i64, Values.global("g"), 8)))
            are_equal("ptr %t2", WRITER.operand_text(block.element_pointer(Types.i64, Values.global("g"), [Values.i32(1)], true)))
            are_equal("i1 %t3", WRITER.operand_text(block.compare(IntegerPredicate.EQ, f.parameter(0), Values.i32(0))))
            are_equal("i1 %t4", WRITER.operand_text(block.compare(FloatPredicate.OLT, f.parameter(1), Values.of_double(0.0))))
            are_equal("float %t5", WRITER.operand_text(block.convert(Conversion.FLOAT_TRUNCATE, f.parameter(1), Type.FLOAT)))
            are_equal("double %t6", WRITER.operand_text(block.negate(f.parameter(1))))
            are_equal("double %t7", WRITER.operand_text(block.select(Values.boolean(true), f.parameter(1), f.parameter(1))))
        si

        @Test()
        call__returns_the_result_or_absent_for_void() is
            let f = FUNCTION("f", Type.VOID, [])
            let block = f.add_block("entry")

            let returns = FUNCTION("returns", Types.i32, [])
            let nothing = FUNCTION("nothing", Type.VOID, [])

            are_equal("i32 %t0", WRITER.operand_text(block.call(returns, [])!))
            is_false(block.call(nothing, [])?)

            are_equal("%t0 = call i32 @returns()\ncall void @nothing()", _texts(block))
        si

        @Test()
        call__of_something_that_is_not_a_function_type__is_refused() is
            let f = FUNCTION("f", Type.VOID, [])
            let block = f.add_block("entry")

            throws(() => block.call(Types.i32, Values.global("g"), []))
        si

        @Test()
        switch__names_its_blocks() is
            let f = FUNCTION("f", Type.VOID, [PARAMETER(Types.i8, "n")])
            let entry = f.add_block("entry")
            let one = f.add_block("one")
            let other = f.add_block("other")

            entry.switch(f.parameter(0), other, [(Values.integer(Types.i8, bigint(1)), one)])

            are_equal("switch i8 %n, label %other [\n    i8 1, label %one\n  ]", _texts(entry))
        si

        @Test()
        invoke__of_a_void_function__produces_no_value() is
            let f = FUNCTION("f", Type.VOID, [])
            let entry = f.add_block("entry")
            let normal = f.add_block("normal")
            let landing = f.add_block("landing")

            is_false(entry.invoke(Types.function(Type.VOID, []), Values.global("g"), [], normal, landing)?)

            are_equal("invoke void @g() to label %normal unwind label %landing", _texts(entry))
        si

        @Test()
        debug_location__is_attached_to_every_instruction_added_while_it_is_set() is
            let f = FUNCTION("f", Type.VOID, [])
            let block = f.add_block("entry")

            block.call(FUNCTION("g", Type.VOID, []), [])

            block.debug_location = Metadata.NODE(7)
            block.call(FUNCTION("g", Type.VOID, []), [])

            block.debug_location = null
            block.return_void()

            are_equal("call void @g()\ncall void @g(), !dbg !7\nret void", _texts(block))
        si

        @Test()
        label__is_the_block_as_a_branch_names_it() is
            are_equal("label %entry", WRITER.operand_text(FUNCTION("f", Type.VOID, []).add_block("entry").label))
        si
    si
si
