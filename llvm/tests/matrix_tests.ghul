namespace LLVM.UnitTests is
    use LLVM.WRITER
    use LLVM.Tests.MODULE_MATRIX

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Every module of the matrix is written here, so that a module the
    // writer refuses is caught by the suite rather than by the LLVM run
    // that follows it. Whether LLVM accepts the text is llvm-check.sh's
    // question.
    @TestClass()
    class MODULE_MATRIX_TESTS is
        init() is si

        @Test()
        every_module_in_the_matrix__is_written() is
            for name in MODULE_MATRIX.names() do
                let text = WRITER.module_text(MODULE_MATRIX.by_name(name))

                is_true(name =~ "empty" \/ text.length > 0)
            od
        si
    si
si
