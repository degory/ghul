namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class METADATA_TESTS is
        init() is si

        _text(metadata: Metadata) -> string is
            let writer = WRITER()

            writer.write(metadata)

            return writer.text
        si

        _text(node: MetadataNode) -> string is
            let writer = WRITER()

            writer.write(node)

            return writer.text
        si

        @Test()
        operands__are_written_as_llvm_spells_them() is
            are_equal("!\"a \\22b\\22\"", _text(Metadata.STRING("a \"b\"")))
            are_equal("i32 3", _text(Metadata.VALUE(Values.i32(3))))
            are_equal("!12", _text(Metadata.NODE(12)))
            are_equal("null", _text(Metadata.NULL))
        si

        @Test()
        tuple__lists_its_operands_in_braces() is
            are_equal("!{{}}", _text(MetadataNode.TUPLE([])))
            are_equal(
                "!{{!\"x\", i64 1, null, !0}}",
                _text(MetadataNode.TUPLE([Metadata.STRING("x"), Metadata.VALUE(Values.i64(1L)), Metadata.NULL, Metadata.NODE(0)])))
        si

        @Test()
        file__names_the_file_and_its_directory() is
            are_equal(
                "!DIFile(filename: \"a.ghul\", directory: \"/src\")",
                _text(MetadataNode.FILE("a.ghul", "/src")))
        si

        @Test()
        compile_unit__writes_its_language_producer_and_emission() is
            are_equal(
                "!DICompileUnit(language: DW_LANG_C99, file: !1, producer: \"ghul\", isOptimized: true, emissionKind: LineTablesOnly)",
                _text(MetadataNode.COMPILE_UNIT("DW_LANG_C99", Metadata.NODE(1), "ghul", true, DebugEmission.LINE_TABLES_ONLY)))
            are_equal(
                "!DICompileUnit(language: DW_LANG_C99, file: !1, producer: \"ghul\", isOptimized: false, emissionKind: FullDebug)",
                _text(MetadataNode.COMPILE_UNIT("DW_LANG_C99", Metadata.NODE(1), "ghul", false, DebugEmission.FULL_DEBUG)))
            are_equal(
                "!DICompileUnit(language: DW_LANG_C99, file: !1, producer: \"ghul\", isOptimized: false, emissionKind: NoDebug)",
                _text(MetadataNode.COMPILE_UNIT("DW_LANG_C99", Metadata.NODE(1), "ghul", false, DebugEmission.NO_DEBUG)))
        si

        @Test()
        subroutine_type__names_its_types() is
            are_equal("!DISubroutineType(types: !4)", _text(MetadataNode.SUBROUTINE_TYPE(Metadata.NODE(4))))
        si

        @Test()
        subprogram__definition_writes_its_flags_and_unit() is
            are_equal(
                "!DISubprogram(name: \"f\", linkageName: \"N.f\", scope: !0, file: !0, line: 3, type: !2, scopeLine: 4, spFlags: DISPFlagDefinition, unit: !1)",
                _text(
                    MetadataNode.SUBPROGRAM(
                        "f", "N.f", Metadata.NODE(0), Metadata.NODE(0), 3, Metadata.NODE(2), 4, true, Metadata.NODE(1))))
        si

        @Test()
        subprogram__declaration_says_so_with_zero_flags() is
            are_equal(
                "!DISubprogram(name: \"f\", scope: !0, file: !0, line: 3, type: !2, scopeLine: 3, spFlags: 0)",
                _text(MetadataNode.SUBPROGRAM("f", null, Metadata.NODE(0), Metadata.NODE(0), 3, Metadata.NODE(2), 3, false, null)))
        si

        @Test()
        location__writes_where_it_was_inlined_when_it_was() is
            are_equal("!DILocation(line: 7, column: 2, scope: !5)", _text(MetadataNode.LOCATION(7, 2, Metadata.NODE(5), null)))
            are_equal(
                "!DILocation(line: 7, column: 2, scope: !5, inlinedAt: !9)",
                _text(MetadataNode.LOCATION(7, 2, Metadata.NODE(5), Metadata.NODE(9))))
        si

        @Test()
        definition__is_written_distinct_when_it_is() is
            let module = MODULE()

            module.add_metadata(MetadataNode.TUPLE([]), true)

            are_equal("!0 = distinct !{{}}\n", WRITER.module_text(module))
        si
    si
si
