namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class ATTRIBUTE_TESTS is
        init() is si

        @Test()
        each_form__is_written_as_llvm_spells_it() is
            are_equal("nounwind", WRITER.attribute_text(Attribute.FLAG("nounwind")))
            are_equal("dereferenceable(16)", WRITER.attribute_text(Attribute.INTEGER("dereferenceable", 16L)))
            are_equal("align 8", WRITER.attribute_text(Attribute.ALIGN(8)))
            are_equal("sret(%pair)", WRITER.attribute_text(Attribute.TYPED("sret", Type.NAMED("pair"))))
            are_equal("\"frame-pointer\"=\"all\"", WRITER.attribute_text(Attribute.STRING("frame-pointer", "all")))
            are_equal("\"no-trapping-math\"", WRITER.attribute_text(Attribute.STRING("no-trapping-math", null)))
        si
    si
si
