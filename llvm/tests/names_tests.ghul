namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class NAMES_TESTS is
        init() is si

        @Test()
        identifier__of_letters_digits_and_punctuation__is_bare() is
            are_equal("x", Names.identifier("x"))
            are_equal("t12", Names.identifier("t12"))
            are_equal("Ghul.Pipes.map", Names.identifier("Ghul.Pipes.map"))
            are_equal("$a-b_c.d", Names.identifier("$a-b_c.d"))
            are_equal("-1", Names.identifier("-1"))
        si

        @Test()
        identifier__starting_with_a_digit__is_quoted() is
            are_equal("\"12\"", Names.identifier("12"))
            are_equal("\"0entry\"", Names.identifier("0entry"))
        si

        @Test()
        identifier__with_other_characters__is_quoted_and_escaped() is
            are_equal("\"a b\"", Names.identifier("a b"))
            are_equal("\"map[int]\"", Names.identifier("map[int]"))
            are_equal("\"\\22q\\22\"", Names.identifier("\"q\""))
            are_equal("\"a\\5Cb\"", Names.identifier("a\\b"))
            are_equal("\"\\C3\\A9\"", Names.identifier("é"))
        si

        @Test()
        identifier__empty_or_with_a_zero_character__is_refused() is
            throws(() => Names.identifier(""))
            throws(() => Names.identifier("a\u0000b"))
        si

        @Test()
        local_and_global__carry_their_sigils() is
            are_equal("%x", Names.local("x"))
            are_equal("@\"a b\"", Names.global("a b"))
        si

        @Test()
        metadata__escapes_without_quoting() is
            are_equal("!dbg", Names.metadata("dbg"))
            are_equal("!llvm.module.flags", Names.metadata("llvm.module.flags"))
            are_equal("!\\31x", Names.metadata("1x"))
            are_equal("!a\\20b", Names.metadata("a b"))
            are_equal("!x1", Names.metadata("x1"))
        si
    si
si
