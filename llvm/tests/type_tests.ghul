namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class TYPE_TESTS is
        init() is si

        @Test()
        integer__is_written_with_its_width() is
            are_equal("i1", WRITER.type_text(Types.i1))
            are_equal("i32", WRITER.type_text(Types.i32))
            are_equal("i17", WRITER.type_text(Type.INTEGER(17)))
            are_equal("i128", WRITER.type_text(Type.INTEGER(128)))
        si

        @Test()
        floating_point_and_other_keywords__are_written_by_name() is
            are_equal("half", WRITER.type_text(Type.HALF))
            are_equal("float", WRITER.type_text(Type.FLOAT))
            are_equal("double", WRITER.type_text(Type.DOUBLE))
            are_equal("void", WRITER.type_text(Type.VOID))
            are_equal("label", WRITER.type_text(Type.LABEL))
            are_equal("metadata", WRITER.type_text(Type.METADATA))
        si

        @Test()
        pointer__names_its_address_space_only_when_not_zero() is
            are_equal("ptr", WRITER.type_text(Types.pointer))
            are_equal("ptr addrspace(3)", WRITER.type_text(Type.POINTER(3)))
        si

        @Test()
        array_and_vector__are_written_with_their_counts() is
            are_equal("[4 x i32]", WRITER.type_text(Type.ARRAY(4, Types.i32)))
            are_equal("[0 x i8]", WRITER.type_text(Type.ARRAY(0, Types.i8)))
            are_equal("<4 x float>", WRITER.type_text(Type.VECTOR(4, Type.FLOAT)))
            are_equal("[2 x [3 x ptr]]", WRITER.type_text(Type.ARRAY(2, Type.ARRAY(3, Types.pointer))))
        si

        @Test()
        struct__is_written_in_braces_and_packed_in_angle_brackets() is
            are_equal("{{ i32, ptr }}", WRITER.type_text(Types.structure([Types.i32, Types.pointer])))
            are_equal("<{{ i8, i32 }}>", WRITER.type_text(Type.STRUCT([Types.i8, Types.i32], true)))
            are_equal("{{}}", WRITER.type_text(Types.structure([])))
            are_equal("<{{}}>", WRITER.type_text(Type.STRUCT([], true)))
            are_equal("{{ {{ i64 }} }}", WRITER.type_text(Types.structure([Types.structure([Types.i64])])))
        si

        @Test()
        named__is_written_as_a_local_name() is
            are_equal("%node", WRITER.type_text(Type.NAMED("node")))
            are_equal("%\"my type\"", WRITER.type_text(Type.NAMED("my type")))
        si

        @Test()
        function__is_written_with_its_parameters() is
            are_equal("i32 (i32, ptr)", WRITER.type_text(Types.function(Types.i32, [Types.i32, Types.pointer])))
            are_equal("void ()", WRITER.type_text(Types.function(Type.VOID, [])))
            are_equal("i32 (ptr, ...)", WRITER.type_text(Type.FUNCTION(Types.i32, [Types.pointer], true)))
            are_equal("void (...)", WRITER.type_text(Type.FUNCTION(Type.VOID, [], true)))
        si

        @Test()
        types__compare_by_structure() is
            is_true(Types.structure([Types.i32, Types.pointer]) =~ Types.structure([Type.INTEGER(32), Type.POINTER(0)]))
            is_false(Types.structure([Types.i32]) =~ Type.STRUCT([Types.i32], true))
            is_false(Type.NAMED("a") =~ Type.NAMED("b"))
        si
    si
si
