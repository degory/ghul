namespace Assertions is
    use MSTEST = Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    // MSTest's assertion overloads all carry trailing optional
    // caller-expression parameters, which a call cannot omit, so
    // these wrappers supply them. Copied from unit-tests/src rather
    // than shared, so this project stands on its own.
    are_equal[T](expected: T, actual: T) is
        MSTEST.are_equal[T](expected, actual, "", "", "")
    si

    is_true(condition: bool) is
        MSTEST.is_true(condition, "", "")
    si

    is_false(condition: bool) is
        MSTEST.is_false(condition, "", "")
    si

    // Runs `action` and returns the message of the exception it throws,
    // failing the test if it throws none.
    throws(action: () -> void) -> string is
        try
            action()
        catch e: Ghul.Exception
            return e.message
        yrt

        MSTEST.fail("expected an exception")

        return ""
    si
si
