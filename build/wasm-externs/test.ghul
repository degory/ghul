namespace Test is
    use IO.Std.write_line;

    // A function declared extern on the wasm target is an import the
    // loader's caller supplies by name, taking numbers and strings and
    // answering either. run.mjs supplies these.

    @extern("", "host_add")
    add(a: int, b: int) -> int;

    @extern("", "host_scale")
    scale(value: double, by: double) -> double;

    @extern("", "host_shout")
    shout(text: string) -> string;

    @extern("", "host_big")
    big(value: long) -> long;

    @extern("", "host_log")
    log(text: string);

    entry() is
        write_line("{add(2, 3)}");
        write_line("{scale(1.5, 4.0)}");
        write_line(shout("hello"));
        write_line("{big(9_000_000_000L)}");
        log("logged");
    si
si
