namespace LambdaSelfCaptureAccess is
    use Collections.Iterable;

    // Fixture for private-member access from a lambda that captures
    // nothing but self. An assembler build recompiles such a literal as
    // a receiver-bound delegate, which hides a stale accessor; analysis
    // mode does not, so the accessor is only observable here.
    class HOLDER is
        _n: int;

        init(n: int) is
            _n = n;
        si

        _double() -> int => _n * 2;

        has_match(xs: Iterable[int]) -> bool =>
            xs | .any(x => x == _n);

        any_doubled(xs: Iterable[int]) -> bool =>
            xs | .any(x => x == _double());
    si
si
