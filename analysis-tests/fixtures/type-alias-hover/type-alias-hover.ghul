namespace TypeAliasHover is
    use IO.Std;

    use IndexedString = (index: int, value: string);
    use Pair[A, B] = (first: A, second: B);

    // Hover on a name that resolves to an alias reports the type the
    // alias stands for, since that is what the name means here.
    describe(entry: IndexedString) -> int is
        return entry.index;
    si

    combine(p: Pair[int, string]) -> string is
        return p.second;
    si
si
