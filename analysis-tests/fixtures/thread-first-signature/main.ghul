namespace ThreadFirstSignature is
    scale(value: int, factor: int, offset: int) -> int => value * factor + offset;

    entry() is
        let threaded = 3 |> scale(4, 5);
        let empty = 3 |> scale();
        let plain = scale(3, 4, 5);
        let plain_empty = scale();
        let chained = 3 |> scale(4, 5) |> scale(6, 7);
        let plain_comma = scale(3,);
        let threaded_comma = 3 |> scale(4,);
    si
si
