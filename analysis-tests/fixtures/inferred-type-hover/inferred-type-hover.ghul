namespace InferredTypeHover is
    takes_a_double(d: double) -> double => d;

    // `cast(v)` and a bare `_` name no type at all, so hover is the
    // only place a reader can see what the context settled on. The
    // written-out forms alongside them already say it.
    conversions(count: int, average: double) -> double is
        let from_let: double = cast(count);
        let from_operator = cast(count) + average;
        let from_argument = takes_a_double(cast(count));

        let written = cast double(count);

        let flag: bool = _;
        let pinned = _[int];

        return from_let + from_operator + from_argument + written;
    si
si
