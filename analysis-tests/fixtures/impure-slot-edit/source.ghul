namespace ImpureSlotEdit is
    counter: int;

    bump() -> int is
        counter = counter + 1;
        return counter;
    si

    trigger() -> int is
        let xs = [1, 2, 3];
        let ys = xs | .map(x => bump());
        return (ys | .reduce(0, (a, b) => a + b)) + LIB.helper(0);
    si
si
