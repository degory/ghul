namespace Ghul.Internal is
    // The magic types the compiler resolves by name. The runtime declares
    // them like this; every other project reaches the reflected copies.
    struct REFERENCE[E] is
        value: E => throw System.NotImplementedException(), = value is si
    si

    trait ARRAY[E]: Collections.List[E] is
    si

    struct POINTER[E] is
        value: E => throw System.NotImplementedException(), = value is si
    si
si
