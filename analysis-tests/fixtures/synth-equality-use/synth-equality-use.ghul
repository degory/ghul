namespace SynthEqualityUse is
    use IO.Std;

    describe(status: int) -> string is
        case status
        when 200 then
            return "ok";
        when 500, 501 then
            return "server error";
        else
            return "other";
        esac
    si

    label(name: string?) -> string is
        case name
        when "ready" then
            return "ready now";
        else
            return "unknown";
        esac
    si

    entry() is
        let pair = (1, "one");
        let text: string? = describe(200);

        if let (1, name) = pair then
            Std.write_line(name);
        fi

        let same = 200 =~ 200;
        let matched = text =~ "ok";

        Std.write_line("{describe(200)} {label("ready")} {same} {matched}");
    si
si
