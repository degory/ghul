namespace IndexerSignature is
    use Collections.LIST;
    use Collections.MAP;

    class GRID is
        _cells: LIST[int];

        init() is
            _cells = LIST[int]([1, 2, 3]);
        si

        [row: int]: int => _cells[row], = v is _cells[row] = v; si
    si

    entry() is
        let grid = GRID();
        let list = LIST[int]([1, 2, 3]);
        let map = MAP[string, int]();

        let a = grid[0];
        let b = list[1];
        let c = map["key"];
    si
si
