namespace OperatorMembers is
    class BOX is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: BOX) -> bool => v == other.v;
        <>(other: BOX) -> int => v - other.v;
        get_hash_code() -> int => v;
    si

    run() is
        let b = BOX(1);
        b.
    si
si
