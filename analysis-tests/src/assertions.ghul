namespace Assertions is
    use MSTEST = Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // MSTest's assertion overloads all carry trailing optional
    // caller-expression parameters, which a call cannot omit, so
    // these wrappers supply them.
    are_equal[T](expected: T, actual: T) is
        MSTEST.are_equal[T](expected, actual, "", "", "");
    si

    are_equal[T](expected: T, actual: T, message: string) is
        MSTEST.are_equal[T](expected, actual, message, "", "");
    si

    are_not_equal[T](expected: T, actual: T) is
        MSTEST.are_not_equal[T](expected, actual, "", "", "");
    si

    are_not_equal[T](expected: T, actual: T, message: string) is
        MSTEST.are_not_equal[T](expected, actual, message, "", "");
    si

    are_same[T](expected: T, actual: T) is
        MSTEST.are_same[T](expected, actual, "", "", "");
    si

    are_same[T](expected: T, actual: T, message: string) is
        MSTEST.are_same[T](expected, actual, message, "", "");
    si

    are_not_same[T](expected: T, actual: T) is
        MSTEST.are_not_same[T](expected, actual, "", "", "");
    si

    are_not_same[T](expected: T, actual: T, message: string) is
        MSTEST.are_not_same[T](expected, actual, message, "", "");
    si

    is_true(condition: bool) is
        MSTEST.is_true(condition, "", "");
    si

    is_true(condition: bool, message: string) is
        MSTEST.is_true(condition, message, "");
    si

    is_false(condition: bool) is
        MSTEST.is_false(condition, "", "");
    si

    is_false(condition: bool, message: string) is
        MSTEST.is_false(condition, message, "");
    si

    is_null(value: object?) is
        MSTEST.is_null(value, "", "");
    si

    is_null(value: object?, message: string) is
        MSTEST.is_null(value, message, "");
    si

    is_not_null(value: object?) is
        MSTEST.is_not_null(value, "", "");
    si

    is_not_null(value: object?, message: string) is
        MSTEST.is_not_null(value, message, "");
    si

    fail() is
        MSTEST.fail("");
    si

    fail(message: string) is
        MSTEST.fail(message);
    si

    is_instance_of_type(value: object?, type: System.Type) is
        MSTEST.is_instance_of_type(value, type, "", "");
    si

    is_instance_of_type(value: object?, type: System.Type, message: string) is
        MSTEST.is_instance_of_type(value, type, message, "");
    si
si
