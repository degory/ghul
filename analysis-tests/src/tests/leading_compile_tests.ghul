namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A COMPILE arriving before any EDIT has registered a source file. The
    // analyser is edit-fed - the first EDIT parses the whole project from
    // disk - so a leading COMPILE finds no source files. The effects pass
    // it used to run assumed the symbol tables existed: on a fresh analyser
    // the Ghul namespace (created only by a build) was missing, and
    // materializing a reflected type with a by-ref parameter (System.Boolean
    // via TryParse) crashed with a NullReferenceException. The crash was
    // caught and answered with empty diagnostics, leaving the session
    // half-built.
    @TestClass()
    class LEADING_COMPILE_TESTS is
        init() is si

        @Test()
        a_compile_before_any_edit_must_answer_cleanly_and_not_crash() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_compile();

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected diagnostics response after COMPILE, got '{response.get_type().name}'";
            are_equal("full", response.phase);

            let stderr = analyser.stderr_capture;
            is_false(
                stderr.contains("caught"),
                "a leading COMPILE crashed the analyser; it must answer from the empty state instead\n--- analyser stderr ---\n{stderr}"
            );
        si

        // The session must stay usable after a leading COMPILE: an EDIT
        // still performs the initial build and compiles clean.
        @Test()
        an_edit_after_a_leading_compile_still_builds_cleanly() is
            let source =
                "namespace LeadingCompile is\n"
                "    checked(flag: bool) -> bool => flag;\n"
                "si\n";

            let use analyser = ANALYSER_PROCESS();

            analyser.send_compile();
            analyser.read_response();

            analyser.send_edit("leading-compile.ghul", source);

            let edit_response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit_response) else "expected diagnostics response after EDIT, got '{edit_response.get_type().name}'";
            are_equal("partial", edit_response.phase);

            let edit_user = LIST[DIAGNOSTIC](user_diagnostics_of(edit_response));
            are_equal(
                0,
                edit_user.count,
                "EDIT after a leading COMPILE had unexpected user diagnostics\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            analyser.send_compile();

            let compile_response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile_response) else "expected diagnostics response after COMPILE, got '{compile_response.get_type().name}'";
            are_equal("full", compile_response.phase);

            let compile_user = LIST[DIAGNOSTIC](user_diagnostics_of(compile_response));
            are_equal(
                0,
                compile_user.count,
                "COMPILE after a leading COMPILE and an EDIT had unexpected user diagnostics\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
