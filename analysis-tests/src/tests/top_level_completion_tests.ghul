namespace Analysis.Tests is
    use Collections.LIST

    use Analysis.Protocol.ANALYSER_PROCESS
    use Analysis.Protocol.Response

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The entry the compiler synthesises for top-level statements, and the
    // wrapper it writes around that entry, carry the location of the
    // statements. Completion in the statements has to come from the
    // statements, not from those synthesised pieces.
    @TestClass()
    class TOP_LEVEL_COMPLETION_TESTS is
        init() is si

        completions_at(arguments: LIST[string], text: string, line: int, column: int) -> LIST[string] is
            let use analyser = ANALYSER_PROCESS(arguments)

            analyser.send_edit("statements.ghul", text)
            analyser.read_response()

            analyser.send_completion("statements.ghul", line, column)

            let names = LIST[string]()

            do
                let response = analyser.read_response()

                if let completion: Response.COMPLETION = response then
                    for item in completion.items do
                        names.add(item.name)
                    od

                    return names
                elif !isa Response.DIAGNOSTICS(response) then
                    return names
                fi
            od
        si

        @Test()
        complete__offers_locals_and_imports_in_top_level_statements() is
            let offered = completions_at(LIST[string](), "use IO.Std.write_line\nlet a = 1\nlet b = a + \n", 3, 13)

            is_true(offered.contains("a") /\ offered.contains("write_line"), "{offered |> Ghul.Pipes.join(", ")}")
        si

        @Test()
        complete__offers_locals_and_imports_in_a_submission() is
            let offered = completions_at(LIST[string](["--submission", "cell1"]), "use IO.Std.write_line\nlet a = 1\nlet b = a + \n", 3, 13)

            is_true(offered.contains("a") /\ offered.contains("write_line"), "{offered |> Ghul.Pipes.join(", ")}")
        si

        // Completing a name as it is typed at the very end of the file,
        // which is where an interactive session completes.
        @Test()
        complete__offers_names_just_past_the_last_statement() is
            let offered = completions_at(LIST[string](["--submission", "cell1"]), "let answer = 1\nans", 2, 4)

            is_true(offered.contains("answer"), "{offered |> Ghul.Pipes.join(", ")}")
        si

        // A statement that is a bare name spans exactly what the entry's
        // synthesised formals would span at the statements' location.
        @Test()
        hover__on_a_statement_that_is_a_name_describes_the_name() is
            let use analyser = ANALYSER_PROCESS(["--submission", "cell1"])

            analyser.send_edit("statements.ghul", "let answer = 1\nanswer\n")
            analyser.read_response()

            analyser.send_hover("statements.ghul", 2, 3)

            let signature mut = ""

            do
                let response = analyser.read_response()

                if let hover: Response.HOVER = response then
                    signature = hover.signature
                    break
                elif !isa Response.DIAGNOSTICS(response) then
                    break
                fi
            od

            is_true(signature.contains("answer"), "hover gave: {signature}")
        si

        // Nothing the compiler writes around top-level statements answers
        // a hover inside them: a name that resolves to nothing has no
        // description at all.
        @Test()
        hover__on_an_unresolved_name_describes_nothing() is
            let use analyser = ANALYSER_PROCESS(["--submission", "cell1"])

            analyser.send_edit("statements.ghul", "use default\nanswer\n")
            analyser.read_response()

            analyser.send_hover("statements.ghul", 2, 3)

            let signature mut = ""

            do
                let response = analyser.read_response()

                if let hover: Response.HOVER = response then
                    signature = hover.signature
                    break
                elif !isa Response.DIAGNOSTICS(response) then
                    break
                fi
            od

            are_equal("", signature)
        si
    si
si
