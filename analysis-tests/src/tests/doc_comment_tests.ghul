namespace Analysis.Tests is
    use Analysis.Protocol.ANALYSER_PROCESS
    use Analysis.Protocol.Response

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A `///` block directly above a declaration, or above its pragmas,
    // reaches hover and completion as Markdown.
    @TestClass()
    class DOC_COMMENT_TESTS is
        init() is si

        source(class_doc: string) -> string => source(class_doc, "Adds one.", "The red one.")

        source(class_doc: string, method_doc: string, member_doc: string) -> string =>
            "/// {class_doc}\n"
            "///\n"
            "/// Counts things.\n"
            "class COUNTER is\n"
            "    /// How many so far.\n"
            "    count: int\n"
            "\n"
            "    init() is si\n"
            "\n"
            "    /// {method_doc}\n"
            "    @suppress(\"non-snake-case-name\")\n"
            "    Bump() is count = count + 1; si\n"
            "si\n"
            "\n"
            "/// Detached by the blank line.\n"
            "\n"
            "undocumented() is si\n"
            "\n"
            "//// Not a doc comment.\n"
            "divider() is si\n"
            "\n"
            "/// Colours.\n"
            "enum Colour is\n"
            "    /// {member_doc}\n"
            "    RED,\n"
            "    GREEN\n"
            "si\n"
            "\n"
            "use_them() is\n"
            "    let c = COUNTER()\n"
            "    c.Bump()\n"
            "    let n = c.count\n"
            "    undocumented()\n"
            "    divider()\n"
            "    let r = Colour.RED\n"
            "si\n"

        prime(class_doc: string) -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS()

            analyser.send_edit("doc-comments.ghul", source(class_doc))

            let diagnostics = analyser.read_response()
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response"

            return analyser
        si

        hover_doc(analyser: ANALYSER_PROCESS, line: int, column: int) -> string? is
            analyser.send_hover("doc-comments.ghul", line, column)

            let response = analyser.read_query_response()
            assert isa Response.HOVER(response) else "expected HOVER response"

            return (cast Response.HOVER(response)).doc
        si

        @Test()
        a_class_doc_keeps_its_paragraph_break() is
            let use analyser = prime("A counter.")

            are_equal("A counter.\n\nCounts things.", hover_doc(analyser, 30, 13))
        si

        @Test()
        a_doc_above_a_pragma_documents_the_method_it_wraps() is
            let use analyser = prime("A counter.")

            are_equal("Adds one.", hover_doc(analyser, 31, 7))
        si

        @Test()
        a_property_and_an_enum_member_carry_their_docs() is
            let use analyser = prime("A counter.")

            are_equal("How many so far.", hover_doc(analyser, 32, 15))
            are_equal("The red one.", hover_doc(analyser, 35, 20))
        si

        @Test()
        a_blank_line_detaches_a_doc_block() is
            let use analyser = prime("A counter.")

            is_null(hover_doc(analyser, 33, 5))
        si

        @Test()
        four_slashes_are_an_ordinary_comment() is
            let use analyser = prime("A counter.")

            is_null(hover_doc(analyser, 34, 5))
        si

        @Test()
        editing_a_doc_comment_updates_the_hover() is
            let use analyser = prime("A counter.")

            are_equal("A counter.\n\nCounts things.", hover_doc(analyser, 30, 13))

            analyser.send_edit("doc-comments.ghul", source("A tally."))

            let diagnostics = analyser.read_response()
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response"

            are_equal("A tally.\n\nCounts things.", hover_doc(analyser, 30, 13))
        si

        @Test()
        editing_a_method_or_enum_member_doc_updates_the_hover() is
            let use analyser = prime("A counter.")

            are_equal("Adds one.", hover_doc(analyser, 31, 7))

            analyser.send_edit("doc-comments.ghul", source("A counter.", "Adds one to the count.", "The red one."))

            let first = analyser.read_response()
            assert isa Response.DIAGNOSTICS(first) else "expected DIAGNOSTICS response"

            are_equal("Adds one to the count.", hover_doc(analyser, 31, 7))

            analyser.send_edit("doc-comments.ghul", source("A counter.", "Adds one to the count.", "Warm."))

            let second = analyser.read_response()
            assert isa Response.DIAGNOSTICS(second) else "expected DIAGNOSTICS response"

            are_equal("Warm.", hover_doc(analyser, 35, 20))
        si

        @Test()
        a_member_completion_carries_the_member_doc() is
            let use analyser = prime("A counter.")

            analyser.send_completion("doc-comments.ghul", 31, 7)

            let response = analyser.read_query_response()
            assert isa Response.COMPLETION(response) else "expected COMPLETION response"

            let completion = cast Response.COMPLETION(response)

            let found mut = false

            for item in completion.items do
                if item.name =~ "Bump" then
                    are_equal("Adds one.", item.doc)
                    found = true
                fi
            od

            is_true(found, "expected Bump among the completions")
        si
    si
si
