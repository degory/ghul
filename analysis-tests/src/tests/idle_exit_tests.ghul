namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // An analyser left with nothing to do exits rather than holding its
    // retained symbol table indefinitely, announcing it with an EXIT frame so
    // a client knows to wait for real work before spawning a replacement —
    // as against the RESTART frame, which asks to be relaunched at once.
    //
    // The timeout is armed only while waiting for a request, so these drive
    // it by staying silent; a test that asserted a *slow* request survives
    // the timeout would be asserting something the design makes impossible.
    class IDLE_EXIT_TESTS is
        @test()

        init() is si

        idle_timeout_seconds: int static => 2;

        start_idle_analyser() -> ANALYSER_PROCESS static =>
            ANALYSER_PROCESS(LIST(["--analysis-idle-timeout", "{idle_timeout_seconds}"]));

        silence_should_produce_an_exit_frame_then_a_clean_exit() is
            @test()

            let use analyser = start_idle_analyser();

            let response = analyser.read_response();

            assert isa Response.EXIT(response) else "an idle analyser should announce an exit frame\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";

            Assert.is_true(
                analyser.wait_for_exit(idle_timeout_seconds * 4000),
                "analyser did not exit after the EXIT frame\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            // Zero is what separates "I am done, leave me alone" from the
            // watchdog's recycle, which exits 1 to ask for a relaunch. A
            // client that missed the frame reads the intent from this.
            Assert.are_equal(
                0,
                analyser.exit_code,
                "an idle exit should be a clean one\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        requests_should_keep_the_analyser_alive() is
            @test()

            let use analyser = start_idle_analyser();

            // Three rounds of work spread over more than the timeout: if the
            // clock ran against wall time rather than against silence, the
            // analyser would be gone before the last one is answered.
            for i in 0..3 do
                System.Threading.Thread.sleep(idle_timeout_seconds * 700);

                analyser.send_heap_check();

                let response = analyser.read_response();

                assert isa Response.HEAP_CHECK(response) else "analyser stopped answering after {i} rounds of work\n"
                    "--- analyser stderr ---\n{analyser.stderr_capture}";
            od

            // ...and it still goes once the work stops.
            let final_response = analyser.read_response();

            assert isa Response.EXIT(final_response) else "an analyser that has gone quiet should still exit\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";
        si
    si
si
