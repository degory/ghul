namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A lambda that reads a private member of the class it is written in
    // is loaded through a capture frame, and the frame becomes the
    // closure's owner so that IL emission names the method inside it.
    // Every later walk of the same body derives the underscore-policy
    // accessor from that owner, so the frame must not be taken for the
    // accessing type - the member is the enclosing class's own.
    //
    // A build that emits IL recompiles a self-only capture as a
    // receiver-bound delegate, which discards the frame and hides the
    // question; analysis mode emits nothing and so keeps the frame.
    @TestClass()
    class LAMBDA_SELF_CAPTURE_ACCESS_TESTS is
        init() is si

        @Test()
        private_member_read_from_a_lambda__is_accessible() is
            let path = fixture_path("lambda-self-capture-access/lambda-self-capture-access.ghul");

            assert File.exists(path) else "fixture missing: {path}";

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("lambda-self-capture-access.ghul", File.read_all_text(path));

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            let diagnostics = LIST(user_diagnostics_of(response));

            are_equal(
                0,
                diagnostics.count,
                "{diagnostics_summary(
                    "reading a private member from a lambda in the declaring "
                    "class was reported as inaccessible",
                    diagnostics)}"
                "\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
