namespace Analysis.Tests is
    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A .NET `const` imports as its own kind of field rather than as a
    // static one, so anything deciding what a symbol is from the kind of
    // field it holds has to account for it. The editor colours a static
    // member differently from an instance one, and a constant is reached
    // through its type exactly as a static field is.
    @TestClass()
    class CONSTANT_SEMANTIC_TOKEN_TESTS is
        init() is si

        source() -> string =>
            "namespace ConstToken is\n"
            "    class WIDGET is\n"
            "        init() is si\n"
            "        headroom() -> int => int.max_value;\n"
            "    si\n"
            "si\n";

        // The modifiers on the token covering `max_value`, or null when
        // nothing covers it.
        modifiers_on_constant(analyser: ANALYSER_PROCESS) -> string? is
            analyser.send_semantic_tokens("consttoken.ghul");

            let response = analyser.read_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            // `int.max_value` sits on line 4; the constant's own name
            // starts after the `int.`.
            for token in response.tokens do
                if token.start_line == 4 /\ token.start_column == 34 then
                    return token.modifiers;
                fi
            od

            return null;
        si

        @Test()
        constant_read__carries_the_static_modifier() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("consttoken.ghul", source());

            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();

            let compiled = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compiled) else "expected DIAGNOSTICS after COMPILE";

            let modifiers = modifiers_on_constant(analyser);

            assert modifiers? else
                "no semantic token covers the constant\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";

            are_equal(
                "static",
                modifiers,
                "a constant is reached through its type, so its token carries `static`, got "
                "'{modifiers}'.\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
