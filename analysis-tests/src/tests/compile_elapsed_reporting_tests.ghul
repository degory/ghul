namespace Analysis.Tests is
    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // A COMPILE reports how long it took in its DIAGNOSTICS response, and
    // a client shows that to the user. The reading comes from a timer
    // named in one place and recorded in another, so it can go quiet
    // without anything failing: nothing recorded the name, the timer read
    // as never having run, and every compile - a whole-project rebuild
    // included - reported taking no time at all.
    class COMPILE_ELAPSED_REPORTING_TESTS is
        @test()

        init() is si

        source() -> string =>
            "namespace CompileElapsed is\n"
            "    class WIDGET is\n"
            "        init() is si\n"
            "        value: int => 42;\n"
            "    si\n"
            "si\n";

        compile_reports_a_non_zero_elapsed_time() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("compileelapsed.ghul", source());

            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();

            let compiled = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compiled) else "expected DIAGNOSTICS after COMPILE";

            Assert.are_equal("full", compiled.phase);

            Assert.is_true(
                compiled.elapsed_ms > 0.0D,
                "a COMPILE must report the time it took, got {compiled.elapsed_ms} ms"
            );
        si
    si
si
