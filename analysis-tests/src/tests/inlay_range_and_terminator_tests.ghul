namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.INLAY_HINT;
    use Analysis.Protocol.Response;

    use Ghul.Pipes;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Range-limited inlay serving and the inferred-terminator boundary
    // kind. The terminator kind is off by default and enabled with
    // `--inlay terminator`, which is also the flag a client (the VS Code
    // extension, via its launch arguments) uses - so these tests drive
    // the flag exactly as a client would.
    //
    // The line map in the comment is what the assertions count against.
    // A boundary is inferred only where the grammar would have accepted
    // a `;` - the same sites the missing-semicolon warning reports - so
    // lines 7, 8, 14 and 15 carry one, while line 4's terminator is
    // written, `return c` (9) and the last statement of h's body (16)
    // are ended by their closing keyword rather than an inferred
    // boundary, and the bodyless `class POINT` (12) is accepted with
    // neither.
    @TestClass()
    class INLAY_RANGE_AND_TERMINATOR_TESTS is
        init() is si

        //  1 namespace Terminators is
        //  2     use IO.Std.write_line;
        //  3
        //  4     f(a: int) -> int => a + 1;
        //  5
        //  6     g(a: int) -> int is
        //  7         let b = a * 2
        //  8         let c = b + 1
        //  9         return c
        // 10     si
        // 11
        // 12     class POINT(x: int, y: int)
        // 13
        // 14     h() is
        // 15         write_line("hello")
        // 16         write_line("bye")
        // 17     si
        // 18 si
        source() -> string =>
            "namespace Terminators is\n"
            "    use IO.Std.write_line;\n"
            "\n"
            "    f(a: int) -> int => a + 1;\n"
            "\n"
            "    g(a: int) -> int is\n"
            "        let b = a * 2\n"
            "        let c = b + 1\n"
            "        return c\n"
            "    si\n"
            "\n"
            "    class POINT(x: int, y: int)\n"
            "\n"
            "    h() is\n"
            "        write_line(\"hello\")\n"
            "        write_line(\"bye\")\n"
            "    si\n"
            "si\n";

        fresh_session(extra_arguments: LIST[string], text: string) -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS(extra_arguments);

            analyser.send_open_files(["terms.ghul"]);
            analyser.send_edit("terms.ghul", text);
            analyser.read_response();
            analyser.send_compile();
            analyser.read_response();

            return analyser
        si

        hints(
            analyser: ANALYSER_PROCESS,
            path: string,
            range: (int, int, int, int)?
        ) -> LIST[INLAY_HINT] is
            analyser.send_inlay_hints(path, range);
            let response = analyser.read_response();
            assert isa Response.INLAY_HINTS(response) else "expected INLAY_HINTS response";

            return LIST[INLAY_HINT](response.hints)
        si

        terminators_on(hints: Collections.Iterable[INLAY_HINT]) -> LIST[int] is
            let lines = LIST[int]();

            for h in hints do
                if h.code =~ "terminator" then
                    lines.add(h.line)
                fi
            od

            return lines
        si

        // The kind is off unless asked for, and a disabled kind is never
        // collected, so a default analyser serves none.
        @Test()
        terminator_kind_is_off_by_default() is
            let use analyser = fresh_session(LIST[string](), source());

            are_equal(0, terminators_on(hints(analyser, "terms.ghul", null)).count)
        si

        @Test()
        terminator_kind_enabled_serves_one_hint_per_inferred_boundary() is
            let use analyser = fresh_session(LIST(["--inlay", "terminator"]), source());

            let lines = terminators_on(hints(analyser, "terms.ghul", null));

            are_equal(4, lines.count, "one per inferred boundary, got: {lines}");

            for expected in [7, 8, 14, 15] do
                is_true(
                    lines |> any(l => l == expected),
                    "expected a boundary hint on line {expected}, got: {lines}"
                )
            od

            for h in hints(analyser, "terms.ghul", null) do
                if h.code =~ "terminator" then
                    are_equal("∘︎", h.label, "every boundary hint is the same ring glyph")
                fi
            od
        si

        // A range limits the answer to the hints inside it: lines 7 and 8
        // are g's two body statements, and the range holds exactly them.
        @Test()
        range_limits_the_terminator_hints_served() is
            let use analyser = fresh_session(LIST(["--inlay", "terminator"]), source());

            let lines = terminators_on(hints(analyser, "terms.ghul", (7, 1, 9, 1)));

            are_equal(2, lines.count, "only the boundaries inside the range, got: {lines}");
            are_equal(7, lines[0]);
            are_equal(8, lines[1])
        si

        // The end position itself is outside the range, so a boundary
        // sitting exactly at it belongs to the next viewport - getting
        // this wrong makes hints flicker at the viewport edge.
        @Test()
        range_end_is_exclusive() is
            let use analyser = fresh_session(LIST(["--inlay", "terminator"]), source());

            let lines = terminators_on(hints(analyser, "terms.ghul", (1, 1, 8, 1)));

            are_equal(1, lines.count, "line 8's boundary sits at the range's end, got: {lines}")
        si

        // The range applies to the text-carrying kinds too, not just the
        // boundary list: the window's answer is the whole answer minus
        // whatever sits outside the range.
        @Test()
        range_limits_the_text_kinds_served() is
            let use analyser = fresh_session(LIST[string](), source());

            let whole = hints(analyser, "terms.ghul", null);
            let window = hints(analyser, "terms.ghul", (1, 1, 9, 1));

            for h in window do
                is_true(h.line < 9, "a hint outside the range was served: line {h.line}")
            od

            let outside = whole |> filter(h => h.line >= 9) |> count();

            are_equal(
                whole.count - outside,
                window.count,
                "the window answer is the whole answer minus what sits outside"
            )
        si

        // The invalidation property for the boundary list: after an incremental
        // (body-splice) edit, the boundary set must equal what a full
        // rebuild of the same text produces. The incremental path
        // re-parses the edited file, which regenerates the list; a
        // regression that left the pre-edit boundaries in place, or
        // dropped them without regenerating, would answer differently
        // from the fresh session.
        @Test()
        boundaries_after_an_incremental_edit_match_a_full_rebuild() is
            let edited = source().replace("let b = a * 2", "let b = a * 3 + 1");

            let use incremental = ANALYSER_PROCESS(LIST(["--inlay", "terminator"]));

            incremental.send_open_files(["terms.ghul"]);
            incremental.send_edit("terms.ghul", source());
            incremental.read_response();
            incremental.send_compile();
            incremental.read_response();

            // Body-only edit: takes the incremental splice path.
            incremental.send_edit("terms.ghul", edited);
            incremental.read_response();
            incremental.send_compile();
            incremental.read_response();

            let after_edit = terminators_on(hints(incremental, "terms.ghul", null));

            let use rebuilt = fresh_session(LIST(["--inlay", "terminator"]), edited);
            let fresh = terminators_on(hints(rebuilt, "terms.ghul", null));

            are_equal(fresh.count, after_edit.count, "incremental: {after_edit}, rebuild: {fresh}");

            for i in 0..fresh.count do
                are_equal(
                    fresh[i],
                    after_edit[i],
                    "boundary {i} differs: incremental {after_edit}, rebuild {fresh}"
                )
            od
        si
    si
si
