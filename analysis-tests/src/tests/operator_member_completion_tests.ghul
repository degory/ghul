namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.COMPLETION_ITEM;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // An operator is an ordinary member, so it belongs in the member
    // completion list - but inserting its bare name after the `.` would
    // put its characters straight against the dot, where the tokenizer
    // scans them as one operator token rather than a member access. The
    // item carries the backtick spelling as its insert text, and the
    // operator kind so the client renders it as one.
    class OPERATOR_MEMBER_COMPLETION_TESTS is
        @test()

        // LSP CompletionItemKind.Operator
        OPERATOR_KIND: int static => 24;

        init() is si

        load(name: string) -> string is
            let path = fixture_path("member-completion-incomplete/{name}");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, name: string) is
            analyser.send_edit(name, load(name));

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
        si

        find(response: Response.COMPLETION, name: string) -> COMPLETION_ITEM? is
            for item in response.items do
                if item.name =~ name then
                    return item;
                fi
            od

            return null;
        si

        has_completion(response: Response.COMPLETION, name: string) -> bool =>
            find(response, name)?;

        // Line 14 is `        b.` - the members of BOX, operators
        // included, each carrying the spelling that actually lexes.
        operator_members_are_offered_with_a_backtick_insert_text() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            prime(analyser, "operator-members.ghul");

            analyser.send_member_completion("operator-members.ghul", 14, 11);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            let equality = find(response, "=~");

            assert equality?
            else
                "expected `=~` among BOX's member completions.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";

            Assert.are_equal(
                "`=~",
                equality.insert_text,
                "an operator member must be inserted in its backtick form: "
                "the bare name would lex as one operator token with the dot"
            );

            Assert.are_equal(
                OPERATOR_KIND,
                equality.kind,
                "an operator member should be reported as an operator"
            );

            let comparison = find(response, "<>");

            assert comparison? else "expected `<>` among member completions";

            Assert.are_equal("`<>", comparison.insert_text);

            // an ordinary member is unaffected: no insert text, so the
            // client inserts the name as it stands
            let hash = find(response, "get_hash_code");

            assert hash? else "expected `get_hash_code`";

            Assert.are_equal("", hash.insert_text);
            Assert.are_not_equal(OPERATOR_KIND, hash.kind);
        si

        // A completion the user triggered by typing `.` can only be
        // answered with the members of what precedes it. When the
        // analyser's text is a keystroke behind the client's there is no
        // member access at that position, and the enclosing scope - every
        // local, global, root namespace and statement keyword - is not an
        // answer to what was asked.
        member_trigger_against_stale_text_offers_nothing() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            // line 10 holds `        b`: the text as it stood before
            // the user typed the `.` the client is asking about
            prime(analyser, "stale-member-access.ghul");

            analyser.send_member_completion("stale-member-access.ghul", 10, 11);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            Assert.are_equal(
                0,
                response.items.count,
                "a member-triggered completion with no member access at the "
                "position must offer nothing rather than the enclosing scope.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // The same position asked without the member trigger is an
        // ordinary completion request and still answers from scope.
        plain_completion_against_the_same_text_still_offers_scope() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            prime(analyser, "stale-member-access.ghul");

            analyser.send_completion("stale-member-access.ghul", 10, 11);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            Assert.is_true(
                has_completion(response, "b"),
                "expected the local `b` from a plain completion request.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // A member trigger that does land on a member access is answered
        // as it always was - the guard is about the analyser's text being
        // behind, not about the trigger itself.
        member_trigger_on_a_real_member_access_answers_normally() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            prime(analyser, "operator-members.ghul");

            analyser.send_member_completion("operator-members.ghul", 14, 11);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            Assert.is_true(
                has_completion(response, "get_hash_code"),
                "expected BOX's members from a member-triggered completion.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            Assert.is_false(
                has_completion(response, "b"),
                "a member completion must not include the enclosing scope's locals"
            );
        si
    si
si
