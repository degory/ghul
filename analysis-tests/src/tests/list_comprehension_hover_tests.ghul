namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A list comprehension's clause variables are locals of scopes the
    // comprehension opens, so hover reaches them where the element reads
    // them, with the type the source gave them and any narrowing an `if`
    // clause applied. An edit to the body that keeps the interface
    // re-walks it incrementally, which has to leave them just as visible.
    @TestClass()
    class LIST_COMPREHENSION_HOVER_TESTS is
        init() is si

        load_fixture() -> string is
            let path = fixture_path("list-comprehension/list-comprehension.ghul");

            assert File.exists(path) else "fixture missing: {path}";

            return File.read_all_text(path);
        si

        edit(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("list-comprehension.ghul", source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            let user_diagnostics = LIST(user_diagnostics_of(diagnostics));
            are_equal(
                0,
                user_diagnostics.count,
                diagnostics_summary("EDIT had unexpected diagnostics", user_diagnostics)
            );
        si

        hover(analyser: ANALYSER_PROCESS, line: int, column: int) -> string is
            analyser.send_hover("list-comprehension.ghul", line, column);
            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            return response.signature ?? "";
        si

        assert_contains(actual: string, expected: string, where: string, analyser: ANALYSER_PROCESS) is
            is_true(
                actual.contains(expected),
                "{where}: expected HOVER to contain '{expected}', got '{actual}'.\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        @Test()
        hover_on_clause_variable_in_element__shows_its_type() is
            let use analyser = ANALYSER_PROCESS();
            edit(analyser, load_fixture());

            assert_contains(hover(analyser, 5, 10), "value: int", "hover on `value` in the element", analyser);
        si

        @Test()
        hover_on_clause_variable_after_if__shows_it_narrowed() is
            let use analyser = ANALYSER_PROCESS();
            edit(analyser, load_fixture());

            assert_contains(hover(analyser, 8, 10), "item: string", "hover on `item` in the element", analyser);
        si

        @Test()
        hover_after_body_edit__still_reaches_clause_variable() is
            let use analyser = ANALYSER_PROCESS();
            let source = load_fixture();
            edit(analyser, source);

            edit(analyser, source.replace("value > 0", "value > 1"));

            assert_contains(hover(analyser, 5, 10), "value: int", "hover on `value` after a body edit", analyser);
        si
    si
si
