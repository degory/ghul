namespace Analysis.Tests is
    use System.Diagnostics.Process;
    use System.Diagnostics.ProcessStartInfo;
    use System.Text.UTF8Encoding;

    use Analysis.Protocol.ANALYSER_PROCESS;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Batch-mode coverage for --format-width, driven through the compiler's
    // own argument loop rather than by constructing a FORMATTER directly:
    // the flag being recognised, the garbled-value and clamp warnings, and
    // an out-of-range value both land on the same path.
    @TestClass()
    class FORMAT_WIDTH_DRIVER_TESTS is
        init() is si

        // Runs `dotnet <ghul.dll> --format --format-width <width> <source>`
        // to completion and returns (stdout, stderr, exit code).
        run_format(width: string?, source: string) -> (stdout: string, stderr: string, exit_code: int) is
            let project_directory = ANALYSER_PROCESS.find_project_directory();
            let compiler_dll = ANALYSER_PROCESS.resolve_compiler_dll();
            let source_path = IO.Path.combine(IO.Path.get_temp_path(), "format-width-{System.Guid.new_guid()}.ghul");

            IO.File.write_all_text(source_path, source);

            try
                let width_flag = if let w: string = width then " --format-width {w}" else "" fi;
                let arguments = "\"{compiler_dll}\" --format{width_flag} \"{source_path}\"";

                let start_info = ProcessStartInfo();

                start_info.file_name = "dotnet";
                start_info.arguments = arguments;
                start_info.working_directory = project_directory;
                start_info.use_shell_execute = false;
                start_info.redirect_standard_output = true;
                start_info.redirect_standard_error = true;
                start_info.standard_output_encoding = UTF8Encoding();
                start_info.standard_error_encoding = UTF8Encoding();

                let started = Process.start(start_info);

                assert started? else "failed to start ghul-compiler";

                let stdout = started.standard_output.read_to_end();
                let stderr = started.standard_error.read_to_end();

                started.wait_for_exit(30000);

                return (stdout, stderr, started.exit_code);
            finally
                IO.File.delete(source_path);
            yrt
        si

        @Test()
        format_width_wraps_at_the_requested_column() is
            let source = "namespace Test is\n    add(a: int, b: int, c: int, d: int) -> int => a + b + c + d;\nsi\n";

            let (stdout, stderr, exit_code) = run_format("20", source);

            are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");
            is_true(stdout.contains("\n"), "expected the call to wrap at width 20, got: {stdout}");
        si

        @Test()
        a_garbled_format_width_warns_and_keeps_the_default() is
            let source = "namespace Test is\n    entry() is si\nsi\n";

            let (stdout, stderr, exit_code) = run_format("not-a-number", source);

            are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");
            is_true(
                stderr.contains("--format-width expects a number"),
                "expected a garbled-value warning, got: {stderr}"
            );
        si

        @Test()
        an_out_of_range_format_width_warns_instead_of_crashing() is
            let source = "namespace Test is\n    entry() is si\nsi\n";

            let (stdout, stderr, exit_code) = run_format("99999999999999", source);

            are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");
            is_true(
                stderr.contains("--format-width expects a number"),
                "expected the overflow to degrade to the garbled-value warning, got: {stderr}"
            );
        si

        @Test()
        a_format_width_below_20_clamps_with_a_warning() is
            let source = "namespace Test is\n    entry() is si\nsi\n";

            let (stdout, stderr, exit_code) = run_format("5", source);

            are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");
            is_true(
                stderr.contains("too narrow to lay anything out; using 20"),
                "expected the below-20 clamp warning, got: {stderr}"
            );
        si
    si
si
