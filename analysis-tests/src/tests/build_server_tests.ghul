namespace Analysis.Tests is
    use System.Diagnostics.Process
    use System.Diagnostics.ProcessStartInfo

    use IO.Directory
    use IO.File
    use IO.Path

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A build server must answer each build as a process of its own would:
    // a build that fails leaves nothing behind for the next, and the server
    // carries on after it.
    @TestClass()
    class BUILD_SERVER_TESTS is
        _directory: string

        init() is
            _directory = Path.combine(Path.get_temp_path(), "ghul-build-server-{System.Guid.new_guid()}")

            Directory.create_directory(_directory)
        si

        // The path of a response file that builds `source` as a library.
        request(name: string, source: string) -> string is
            let source_path = Path.combine(_directory, "{name}.ghul")
            let response = Path.combine(_directory, "{name}.rsp")

            File.write_all_text(source_path, source)
            File.write_all_text(response, "--library\n-o\n{Path.combine(_directory, name)}.dll\n{source_path}\n")

            return response
        si

        // Sends a build to the server and reads its diagnostics through to
        // the line saying how it ended, which is returned.
        build(process: Process, response: string, diagnostics: Text.STRING_BUILDER) -> int is
            process.standard_input.write_line(response)
            process.standard_input.flush()

            do
                let line = process.standard_error.read_line()

                if !line? then
                    return -1
                fi

                if line.starts_with("\u0001build-done ") then
                    return int.parse(line.substring("\u0001build-done ".length))
                fi

                diagnostics.append_line(line)
            od
        si

        @Test()
        failed_build__leaves_the_next_build_unaffected() is
            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.argument_list.add(Protocol.ANALYSER_PROCESS.resolve_compiler_dll())
            start_info.argument_list.add("--build-server")
            start_info.use_shell_execute = false
            start_info.redirect_standard_input = true
            start_info.redirect_standard_error = true

            let use process = Process.start(start_info)!

            let broken = Text.STRING_BUILDER()
            let good = Text.STRING_BUILDER()
            let again = Text.STRING_BUILDER()

            let bad_status = build(process, request("bad", "namespace Bad is f() -> int => \"x\"; si"), broken)
            let good_status = build(process, request("good", "namespace Good is f() -> int => 1; si"), good)
            let repeat_status = build(process, request("good2", "namespace Good is f() -> int => 1; si"), again)

            process.standard_input.write_line("quit")
            process.wait_for_exit()

            are_equal(1, bad_status, broken.to_string())
            is_true(broken.to_string().contains("error"), broken.to_string())
            are_equal(0, good_status, good.to_string())
            are_equal(0, repeat_status, again.to_string())
            is_false(good.to_string().contains("error"), good.to_string())
        si

        @Test()
        unknown_option__ends_the_build_naming_it() is
            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.argument_list.add(Protocol.ANALYSER_PROCESS.resolve_compiler_dll())
            start_info.argument_list.add("--build-server")
            start_info.use_shell_execute = false
            start_info.redirect_standard_input = true
            start_info.redirect_standard_error = true

            let use process = Process.start(start_info)!

            let diagnostics = Text.STRING_BUILDER()

            let source_path = Path.combine(_directory, "flags.ghul")
            let response = Path.combine(_directory, "flags.rsp")

            File.write_all_text(source_path, "namespace Flags is f() -> int => 1; si")
            File.write_all_text(response, "--library\n--no-such-option\n-o\n{Path.combine(_directory, "flags")}.dll\n{source_path}\nstray\n")

            let status = build(process, response, diagnostics)

            process.standard_input.write_line("quit")
            process.wait_for_exit()

            are_equal(2, status, diagnostics.to_string())
            is_true(diagnostics.to_string().contains("unknown option: --no-such-option"), diagnostics.to_string())
            is_true(diagnostics.to_string().contains("unrecognized argument: stray"), diagnostics.to_string())
        si
    si
si
