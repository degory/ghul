namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Regression marker for the EDIT-after-EDIT phantom-placeholder leak.
    // The incremental body re-walk drives COMPILE_EXPRESSIONS directly
    // rather than through its apply(), so the state apply() drops at a
    // walk boundary — the TYPE_ARG_PLACEHOLDER_REGISTRY above all — had
    // to be dropped by the re-walk instead, and wasn't. The registry
    // therefore carried the previous walk's phantoms, and the first
    // function whose body-retry loop failed to converge swept the whole
    // registry and reported them.
    //
    // Symptom on ghul-examples' functional.ghul: three "cannot infer type
    // here" errors on the `stream(...)` calls that appear on the second
    // EDIT and never clear, whatever the edit was — including an edit
    // that restores the original text exactly.
    //
    // The sibling ITERATIVE_INFERENCE_STATE_LEAK_TESTS covers the
    // COMPILE-after-EDIT half of the same hazard.
    @TestClass()
    class REWALK_PLACEHOLDER_LEAK_TESTS is
        init() is si

        load_source() -> string is
            let path = fixture_path("rewalk-placeholder-leak/rewalk-placeholder-leak.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        send_edit_and_assert_clean(analyser: ANALYSER_PROCESS, source: string, label: string) is
            analyser.send_edit("rewalk-placeholder-leak.ghul", source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            let user = LIST[DIAGNOSTIC](user_diagnostics_of(diagnostics));

            are_equal(
                0,
                user.count,
                "{diagnostics_summary(label, user)}\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // The trigger is a second walk, not the content of the edit: an
        // EDIT re-sending byte-identical text reaches the incremental body
        // re-walk like any other interface-preserving edit.
        @Test()
        repeated_identical_edits_should_stay_clean() is
            let source = load_source();
            let use analyser = ANALYSER_PROCESS();

            for i in 0..4 do
                send_edit_and_assert_clean(
                    analyser,
                    source,
                    "EDIT #{i + 1} of unchanged source had spurious diagnostics"
                );
            od
        si

        // The editor case: an in-body edit somewhere unrelated to the
        // reported sites, then an edit restoring the original text. Both
        // the edited and the restored source are clean on their own, so
        // any diagnostic here is leaked state rather than a verdict on
        // what was sent.
        @Test()
        unrelated_body_edit_and_undo_should_stay_clean() is
            let source = load_source();

            let edited =
                source.replace(
                    "Std.write_line(\"{{counter}}\");",
                    "Std.write_line(\"probe\");\n        Std.write_line(\"{{counter}}\");"
                );

            are_not_equal(source, edited, "fixture no longer contains the anchor the edit is applied to");

            let use analyser = ANALYSER_PROCESS();

            send_edit_and_assert_clean(analyser, source, "initial EDIT had unexpected diagnostics");
            send_edit_and_assert_clean(analyser, edited, "EDIT inserting an unrelated statement had spurious diagnostics");
            send_edit_and_assert_clean(analyser, source, "EDIT restoring the original text had spurious diagnostics");
        si
    si
si
