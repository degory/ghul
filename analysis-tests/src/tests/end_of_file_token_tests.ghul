namespace Analysis.Tests is
    use IO.File;
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.user_diagnostics_of;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A name that ends a file with no newline after it is answered for
    // across its whole span, as it would be anywhere else in a file.
    @TestClass()
    class END_OF_FILE_TOKEN_TESTS is
        init() is si

        _edit(analyser: ANALYSER_PROCESS, file: string) -> Response.DIAGNOSTICS is
            let path = fixture_path("end-of-file-token/{file}");
            assert File.exists(path) else "fixture not copied to test output: {path}";

            analyser.send_edit(file, File.read_all_text(path));

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            return diagnostics;
        si

        // The last line is `let doubled = answer`; column 20 is the last
        // character of `answer`.
        @Test()
        hover_on_the_last_character_of_a_name_that_ends_the_file_describes_it() is
            let use analyser = ANALYSER_PROCESS();

            _edit(analyser, "hover-at-end.ghul");

            analyser.send_hover("hover-at-end.ghul", 2, 20);

            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            is_true(response.signature.contains("answer"), "expected the hover to describe `answer`; got: {response.signature}");
        si

        @Test()
        a_diagnostic_on_a_name_that_ends_the_file_spans_the_whole_name() is
            let at_end = _only_diagnostic("diagnostic-at-end.ghul");
            let before_newline = _only_diagnostic("diagnostic-before-newline.ghul");

            are_equal(before_newline.start_column, at_end.start_column);
            are_equal(before_newline.end_column, at_end.end_column);
        si

        _only_diagnostic(file: string) -> DIAGNOSTIC is
            let use analyser = ANALYSER_PROCESS();

            let diagnostics = LIST[DIAGNOSTIC](user_diagnostics_of(_edit(analyser, file)));

            are_equal(1, diagnostics.count);

            return diagnostics[0];
        si
    si
si
