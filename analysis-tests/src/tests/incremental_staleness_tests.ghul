namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // Tests for the accepted staleness budget — transient imprecisions
    // the incremental paths trade for latency. Each is defensible; these
    // tests pin each as deliberate, bounded behaviour that corrects on
    // the next COMPILE or full rebuild.
    //
    // Item 2 (store-free bits stale between EDIT and COMPILE) is covered
    // by STORE_FREE_FLIP_GATE_TESTS and STORE_FREE_TARGETED_RECOMPILE_TESTS.
    class INCREMENTAL_STALENESS_TESTS is
        @test()

        init() is si

        // ──────────────────────────────────────────────────────────────
        // Item 3: appended functions carry no store-free bit
        //
        // A function added via the incremental interface path carries no
        // store-free bit until the debounced COMPILE re-derives it. The
        // "not proven" default is conservative (safe), but callers'
        // narrowing across calls to it stays killed until the COMPILE
        // trues it up. Observed through the hover kind label, which
        // renders "pure" exactly when the store-free bit is set.
        // ──────────────────────────────────────────────────────────────

        append_baseline() -> string =>
            "namespace StaleAppend is\n"
            "    class PROBE is\n"
            "        s: int static public;\n"
            "        init() is si\n"
            "\n"
            "        reader() -> int is\n"
            "            let w = s;\n"
            "            return w;\n"
            "        si\n"
            "\n"
            "        caller() -> int is\n"
            "            return reader();\n"
            "        si\n"
            "    si\n"
            "si\n";

        // Appends a new top-level namespace with a store-free function
        // `scanner()`, and changes `caller()` to call it. The append is
        // at the top-level definition level (1 → 2), so the incremental
        // interface append path handles it.
        append_with_new_store_free_function() -> string =>
            "namespace StaleAppend is\n"
            "    class PROBE is\n"
            "        s: int static public;\n"
            "        init() is si\n"
            "\n"
            "        reader() -> int is\n"
            "            let w = s;\n"
            "            return w;\n"
            "        si\n"
            "\n"
            "        caller() -> int is\n"
            "            return StaleScanned.scanner();\n"
            "        si\n"
            "    si\n"
            "si\n"
            "\n"
            "namespace StaleScanned is\n"
            "    scanner() -> int is\n"
            "        let x = StaleAppend.PROBE.s;\n"
            "        return x;\n"
            "    si\n"
            "si\n";

        // ──────────────────────────────────────────────────────────────
        // Item 1: new name capture stays bounded
        //
        // A name added by an incremental interface edit can in principle
        // capture a use in another file that previously resolved
        // elsewhere. That stale resolution survives until the next full
        // rebuild. The test pins that the staleness is bounded: no errors
        // appear after the incremental edit, and none appear after the
        // full rebuild that corrects the resolution.
        // ──────────────────────────────────────────────────────────────

        capture_defs() -> string =>
            "namespace StaleCapture is\n"
            "    existing() -> int => 1;\n"
            "si\n";

        // Appends `helper()` to `StaleCapture` — one top-level
        // definition changed, so the incremental interface path
        // handles it. In principle, `StaleCapture.helper` could now
        // capture the unqualified `helper()` call in capture-client.ghul
        // that previously resolved to the imported `StaleOther.helper`.
        capture_defs_with_new_name() -> string =>
            "namespace StaleCapture is\n"
            "    existing() -> int => 1;\n"
            "\n"
            "    helper() -> int => 42;\n"
            "si\n";

        capture_client() -> string =>
            "namespace StaleCapture is\n"
            "    use StaleOther;\n"
            "\n"
            "    caller() -> int => helper();\n"
            "si\n"
            "\n"
            "namespace StaleOther is\n"
            "    helper() -> int => 99;\n"
            "si\n";

        // ──────────────────────────────────────────────────────────────
        // Item 4: error files are deferred, not silently lost
        //
        // A body that failed to bind recorded no reference, so the
        // reference scan cannot see it as a dependent. Files holding
        // errors are cleared and deferred to the debounced compile. The
        // test pins that an error in one file survives an incremental
        // edit to another file — it is not silently dropped.
        // ──────────────────────────────────────────────────────────────

        error_defs() -> string =>
            "namespace StaleError is\n"
            "    broken() -> int is\n"
            "        return undefined_name;\n"
            "    si\n"
            "si\n";

        error_defs_fixed() -> string =>
            "namespace StaleError is\n"
            "    broken() -> int is\n"
            "        return 42;\n"
            "    si\n"
            "si\n";

        error_other_file() -> string =>
            "namespace StaleError is\n"
            "    caller() -> int is\n"
            "        let x = 1;\n"
            "        return x;\n"
            "    si\n"
            "si\n";

        error_other_file_edited() -> string =>
            "namespace StaleError is\n"
            "    caller() -> int is\n"
            "        let x = 2;\n"
            "        return x;\n"
            "    si\n"
            "si\n";

        // ──────────────────────────────────────────────────────────────
        // Item 5: cross-file query after single-file edit
        //
        // After a single-file incremental rebuild, other files sit at
        // up-to-expressions with no expression-position use-map entries.
        // Cross-file queries must still return correct results despite
        // the absent use-map entries.
        // ──────────────────────────────────────────────────────────────

        cross_file_defs() -> string =>
            "namespace StaleCross is\n"
            "    class HOLDER is\n"
            "        value: int public;\n"
            "        init() is si\n"
            "\n"
            "        compute() -> int is\n"
            "            let v = value;\n"
            "            return v + 1;\n"
            "        si\n"
            "    si\n"
            "si\n";

        cross_file_defs_edited() -> string =>
            "namespace StaleCross is\n"
            "    class HOLDER is\n"
            "        value: int public;\n"
            "        init() is si\n"
            "\n"
            "        compute() -> int is\n"
            "            let v = value;\n"
            "            return v + 2;\n"
            "        si\n"
            "    si\n"
            "si\n";

        cross_file_client() -> string =>
            "namespace StaleCross is\n"
            "    query() -> int is\n"
            "        let h = HOLDER();\n"
            "        return h.compute();\n"
            "    si\n"
            "si\n";

        // ══════════════════════════════════════════════════════════════
        // Test methods
        // ══════════════════════════════════════════════════════════════

        // Item 3: after an incremental append, the new function carries
        // no store-free bit. After COMPILE, the refresh derives it.
        appended_function_lacks_store_free_bit_until_compile() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            // Cold start — first edit takes the full rebuild.
            analyser.send_edit("stale-append.ghul", append_baseline());
            assert_clean_response(analyser, "baseline");

            // Incremental append — the interface incremental path runs.
            assert_work(
                analyser,
                "appending a store-free function",
                [
                    exactly(edit_path_interface_incremental, 1),
                    exactly(edit_path_body_rewalk, 0),
                    exactly(edit_path_full_rebuild, 0)
                ],
                () is
                    analyser.send_edit("stale-append.ghul", append_with_new_store_free_function());
                    drain_response(analyser, "append edit");
                si
            );

            // Before COMPILE: scanner has no store-free bit (the "not
            // proven" default). Hover on the call to scanner() inside
            // caller() — line 12, inside the call name.
            let before_label = scanner_hover_label(analyser);
            Assert.is_true(
                !before_label.contains("pure"),
                "before COMPILE: expected scanner to lack the store-free bit (no 'pure' in kind label), got '{before_label}'\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            // COMPILE re-derives all store-free bits.
            analyser.send_compile();
            let compile_response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile_response) else "expected DIAGNOSTICS response after COMPILE";

            // After COMPILE: scanner now has the store-free bit.
            let after_label = scanner_hover_label(analyser);
            Assert.is_true(
                after_label.contains("pure"),
                "after COMPILE: expected scanner to have the store-free bit ('pure' in kind label), got '{after_label}'\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Item 1: a new name added by an incremental interface edit does
        // not cascade errors. The stale resolution is bounded — it
        // corrects on the next full rebuild.
        new_name_does_not_cascade_errors_until_rebuild() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            // Load both files: client resolves helper() to StaleOther.helper.
            analyser.send_edit_files([
                EDIT_FILE("capture-defs.ghul", capture_defs()),
                EDIT_FILE("capture-client.ghul", capture_client())
            ]);
            assert_clean_response(analyser, "initial load");

            // Incrementally append helper() to StaleCapture namespace.
            // In principle, StaleCapture.helper could now capture the
            // use in client.ghul, but the incremental path does not
            // re-resolve client's uses. The stale resolution is bounded —
            // no errors should appear.
            assert_work(
                analyser,
                "appending a name that could capture a cross-file use",
                [
                    exactly(edit_path_interface_incremental, 1),
                    exactly(edit_path_body_rewalk, 0),
                    exactly(edit_path_full_rebuild, 0)
                ],
                () is
                    analyser.send_edit("capture-defs.ghul", capture_defs_with_new_name());
                    drain_response(analyser, "append edit");
                si
            );

            // Force a full rebuild with a multi-file EDIT — the
            // incremental paths require paths.count == 1, so editing
            // both files (even one unchanged) takes the full rebuild.
            assert_work(
                analyser,
                "forcing a full rebuild with a multi-file edit",
                [
                    exactly(edit_path_full_rebuild, 1),
                    exactly(edit_path_body_rewalk, 0),
                    exactly(edit_path_interface_incremental, 0)
                ],
                () is
                    analyser.send_edit_files([
                        EDIT_FILE("capture-defs.ghul", capture_defs_with_new_name()),
                        EDIT_FILE("capture-client.ghul", capture_client())
                    ]);
                    drain_response(analyser, "multi-file edit");
                si
            );

            // assert_work consumed the EDIT response, so the rebuilt
            // state is observed via a fresh COMPILE.
            analyser.send_compile();
            assert_clean_response(analyser, "after full rebuild");
        si

        // Item 4: an error in one file survives an incremental edit to
        // another file. It is not silently dropped — it is retained and
        // re-appears after a COMPILE.
        error_in_other_file_survives_incremental_edit() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            // Load both files: one has a broken body, one is clean.
            analyser.send_edit_files([
                EDIT_FILE("error-defs.ghul", error_defs()),
                EDIT_FILE("error-other.ghul", error_other_file())
            ]);

            let initial = analyser.read_response();
            assert isa Response.DIAGNOSTICS(initial) else "expected DIAGNOSTICS response";
            let initial_user = LIST[DIAGNOSTIC](user_diagnostics_of(initial));
            Assert.is_true(
                initial_user.count > 0,
                "the broken file should produce at least one diagnostic on initial load\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            // Body-only edit to the other file — interface-preserving,
            // takes the incremental body re-walk.
            assert_work(
                analyser,
                "body edit to a different file than the one with errors",
                [
                    exactly(edit_path_body_rewalk, 1),
                    exactly(edit_path_interface_incremental, 0),
                    exactly(edit_path_full_rebuild, 0)
                ],
                () is
                    analyser.send_edit("error-other.ghul", error_other_file_edited());
                    drain_response(analyser, "body edit");
                si
            );

            // assert_work consumed the EDIT response, so the retained
            // error is observed via a fresh COMPILE.
            analyser.send_compile();
            let compile_response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile_response) else "expected DIAGNOSTICS response after COMPILE";
            let compile_user = LIST[DIAGNOSTIC](user_diagnostics_of(compile_response));
            Assert.is_true(
                compile_user.count > 0,
                "the broken file's error should survive COMPILE — it was silently dropped\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            // Fix the broken file — the error should clear.
            analyser.send_edit("error-defs.ghul", error_defs_fixed());
            let fixed = analyser.read_response();
            assert isa Response.DIAGNOSTICS(fixed) else "expected DIAGNOSTICS response";
            let fixed_user = LIST[DIAGNOSTIC](user_diagnostics_of(fixed));
            Assert.are_equal(
                0,
                fixed_user.count,
                "the fixed file should be diagnostic-clean; got {fixed_user.count} diagnostics:\n{diagnostics_summary("edit", fixed_user)}--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Item 5: a cross-file hover after a single-file incremental edit
        // returns a correct result despite the non-edited file having no
        // expression-position use-map entries.
        cross_file_hover_correct_after_single_file_edit() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            // Load both files.
            analyser.send_edit_files([
                EDIT_FILE("cross-defs.ghul", cross_file_defs()),
                EDIT_FILE("cross-client.ghul", cross_file_client())
            ]);
            assert_clean_response(analyser, "initial load");

            // Interface-preserving body edit to cross-defs.ghul.
            assert_work(
                analyser,
                "body edit to defs",
                [
                    exactly(edit_path_body_rewalk, 1),
                    exactly(edit_path_interface_incremental, 0),
                    exactly(edit_path_full_rebuild, 0)
                ],
                () is
                    analyser.send_edit("cross-defs.ghul", cross_file_defs_edited());
                    drain_response(analyser, "body edit");
                si
            );

            // Hover on `compute()` call in client.ghul — a cross-file
            // query against a file that was not just incrementally edited.
            // client.ghul's expression uses are not in the use-map, but
            // the query must still resolve correctly.
            // Line 4: `        return h.compute();`
            // `compute` starts at column 18 (1-based).
            analyser.send_hover("cross-client.ghul", 4, 22);

            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            // The hover should carry the function's signature — proving
            // the cross-file query resolved against the non-edited file's
            // retained state.
            Assert.is_true(
                response.signature.contains("compute"),
                "hover on cross-file compute() call should carry the function's signature, got: {response.signature}\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // ──────────────────────────────────────────────────────────────
        // Helpers
        // ──────────────────────────────────────────────────────────────

        // Read and discard a response, asserting it is DIAGNOSTICS.
        drain_response(analyser: ANALYSER_PROCESS, context: string) is
            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS on {context}, got '{response.get_type().name}'";
        si

        // Read a response and assert zero user-facing diagnostics.
        assert_clean_response(analyser: ANALYSER_PROCESS, context: string) is
            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS on {context}, got '{response.get_type().name}'";

            let user_diags = LIST[DIAGNOSTIC](user_diagnostics_of(response));
            Assert.are_equal(
                0,
                user_diags.count,
                "{context} had {user_diags.count} unexpected diagnostics:\n{diagnostics_summary(context, user_diags)}--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Hover on the call to `scanner()` inside `caller()` and return
        // the kind label. Line 12 is `            return StaleScanned.scanner();`
        // and `scanner` starts at column 34 (1-based).
        scanner_hover_label(analyser: ANALYSER_PROCESS) -> string is
            analyser.send_hover("stale-append.ghul", 12, 37);

            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            if response.kind_label? then
                return response.kind_label;
            fi

            return "";
        si
    si
si
