namespace Analysis.Tests is
    use Collections.Iterable;
    use Collections.LIST;
    use Collections.MutableMap;

    use System.Text.StringBuilder;

    use Analysis.Protocol.ANALYSER_PROCESS;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // Asserting on how much compilation an action caused.
    //
    // The incremental paths exist to do less work, and they produce the
    // same answers as the whole-project rebuild by construction - so a
    // test that only checks the answer cannot tell whether the work was
    // skipped. These assertions read the analyser's counters either side
    // of an action and check the deltas, which is what makes a silent
    // fall back to the full rebuild a failing test rather than an
    // invisible loss.
    //
    // Counters are cumulative for the life of the process, so an
    // expectation is always about a delta and no reset is needed.

    // One expectation about one counter's delta over an action.
    struct WORK_EXPECTATION(counter: string, bound: int, is_upper_bound: bool);

    // The counter must move by exactly this much. Use for the edit-path
    // tally - the path that handled the edit is a fact, not a budget.
    exactly(counter: string, count: int) -> WORK_EXPECTATION =>
        WORK_EXPECTATION(counter, count, false);

    // The counter must not move by more than this much. Use for work
    // counters: the assertion is a ceiling, so a path that gets cheaper
    // still passes and only a path that gets more expensive fails.
    at_most(counter: string, count: int) -> WORK_EXPECTATION =>
        WORK_EXPECTATION(counter, count, true);

    // Counter names. Kept here rather than spelled at each call site so a
    // rename in the compiler's vocabulary breaks in one place.
    EDIT_PATH_BODY_REWALK: string => "edit-path-body-rewalk";
    EDIT_PATH_INTERFACE_INCREMENTAL: string => "edit-path-interface-incremental";
    EDIT_PATH_FULL_REBUILD: string => "edit-path-full-rebuild";

    // One file taken through one pass of the ordinary build loop.
    file_pass(pass: string) -> string => "file-pass:{pass}";

    // One file's bodies taken through one pass by the incremental re-walk.
    file_rewalk(pass: string) -> string => "file-rewalk:{pass}";

    // One changed or appended subtree taken through one pass.
    subtree_pass(pass: string) -> string => "subtree-pass:{pass}";

    // Why an incremental path handed the edit back to the full rebuild.
    declined(reason: string) -> string => "edit-declined-{reason}";

    // Run `action` and assert every expectation about the counter deltas
    // it produced. `action` must both send its requests and read their
    // responses: the snapshot afterwards is itself a request, and would
    // otherwise read a response the action left in the stream.
    //
    // `description` names what the action was, so a failure says which
    // edit misbehaved rather than only which counter did.
    assert_work(
        analyser: ANALYSER_PROCESS,
        description: string,
        expectations: Iterable[WORK_EXPECTATION],
        action: () -> void
    ) is
        let before = analyser.stat_counts();

        action();

        let after = analyser.stat_counts();

        let failures = LIST[string]();

        for expectation in expectations do
            let delta = _count(after, expectation.counter) - _count(before, expectation.counter);

            if expectation.is_upper_bound then
                if delta > expectation.bound then
                    failures.add(
                        "  {expectation.counter}: expected at most {expectation.bound}, got {delta}"
                    );
                fi
            elif delta != expectation.bound then
                failures.add(
                    "  {expectation.counter}: expected exactly {expectation.bound}, got {delta}"
                );
            fi
        od

        if failures.count == 0 then
            return;
        fi

        let message = StringBuilder();

        message.append("unexpected compilation work for {description}:\n");

        for failure in failures do
            message.append(failure).append('\n');
        od

        message.append(_moved_counters(before, after));

        Assert.fail(message.to_string());
    si

    _count(counts: MutableMap[string,int], name: string) -> int =>
        if counts.contains_key(name) then counts[name] else 0 fi;

    // Every counter that moved, so a failure shows what the action
    // actually did and not only which expectation it broke - the work
    // that appeared instead is usually the diagnosis.
    _moved_counters(before: MutableMap[string,int], after: MutableMap[string,int]) -> string is
        let result = StringBuilder();

        result.append("counters that moved:\n");

        for name in after.keys do
            let delta = _count(after, name) - _count(before, name);

            if delta != 0 then
                result.append("  {name}: +{delta}\n");
            fi
        od

        return result.to_string();
    si
si
