namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.HOVER_ENTRY;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A named function piped into a pack-formal generic (`map(double)`) is
    // wrapped in a presenting literal at the call. The wrapping walk once
    // suppressed the symbol uses the declaration pass had yet to record, so
    // every global's definition-site hover and token vanished from the file
    // while use-site entries survived. Recorded as ghul#3624.
    @TestClass()
    class PACK_PIPE_HOVER_TESTS is
        init() is si

        load_source() -> string is
            let path = fixture_path("pack-pipe-hover/pack-pipe-hover.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("pack-pipe-hover.ghul", source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
        si

        hover_entries(analyser: ANALYSER_PROCESS) -> LIST[HOVER_ENTRY] is
            analyser.send_hover_map("pack-pipe-hover.ghul");

            let response = analyser.read_query_response();
            assert isa Response.HOVER_MAP(response) else "expected HOVER_MAP response";

            return LIST[HOVER_ENTRY](response.entries);
        si

        // The definition sites of `triple` (line 4) and `double` (line 6)
        // carry hover entries: `triple: int -> int pure` at 4:5 and
        // `double(n: int) -> int` at 6:1.
        @Test()
        definition_sites_keep_their_hovers() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_source());

            let entries = hover_entries(analyser);

            let saw_triple mut = false;
            let saw_double mut = false;

            for entry in entries do
                if entry.start_line == 4 /\ entry.start_column == 5 then
                    saw_triple = true;
                fi

                if entry.start_line == 6 /\ entry.start_column == 1 then
                    saw_double = true;
                fi
            od

            is_true(saw_triple, "no hover entry at triple's definition (4:5)");
            is_true(saw_double, "no hover entry at double's definition (6:1)");
        si

        // The same loss reaches semantic tokens: the `function` token for
        // double's definition (6:1) and the `property` token for triple's
        // (4:5) must be present.
        @Test()
        definition_sites_keep_their_tokens() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_source());

            analyser.send_semantic_tokens("pack-pipe-hover.ghul");

            let response = analyser.read_query_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            let saw_triple mut = false;
            let saw_double mut = false;

            for token in response.tokens do
                if token.start_line == 4 /\ token.start_column == 5 then
                    saw_triple = true;
                fi

                if token.start_line == 6 /\ token.start_column == 1 then
                    saw_double = true;
                fi
            od

            is_true(saw_triple, "no semantic token at triple's definition (4:5)");
            is_true(saw_double, "no semantic token at double's definition (6:1)");
        si
    si
si
