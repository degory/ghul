namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A synthesized member answers wherever the location it was built
    // with reaches, which is why both what it is stamped with and how
    // far that reaches matter. The union's equality and hash bodies
    // carried the union's own location, so a position anywhere in a
    // union body reported the `/\` the object-equals body is built
    // from. A variant's constructor and the call synthesized from a
    // `super(...)` declaration are stamped with the declaration they
    // belong to, so each reached into the line below whenever that
    // declaration carried no terminator.
    //
    // The fixture is, by line:
    //
    //   3   UVA
    //   4                            (blank)
    //   5   UVB
    //   ...
    //   11  super(tag)               (no terminator)
    //   12                           (blank)
    @TestClass()
    class SYNTHESIZED_MEMBER_HOVER_TESTS is
        init() is si

        load() -> string is
            let path = fixture_path("synthesized-member-hover/synthesized-member-hover.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        hover(analyser: ANALYSER_PROCESS, line: int, column: int) -> string is
            analyser.send_hover("synthesized-member-hover.ghul", line, column);

            let response = analyser.read_query_response();

            assert isa Response.HOVER(response) else "expected HOVER response";

            if !response.signature? \/ response.signature.length == 0 then
                return "<none>";
            fi

            return response.signature;
        si

        opened() -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS();

            analyser.send_edit("synthesized-member-hover.ghul", load());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            return analyser;
        si

        @Test()
        a_position_in_a_union_body_reports_no_synthesized_member() is
            let use analyser = opened();

            are_equal(
                "<none>",
                hover(analyser, 4, 9),
                "a position between two variants belongs to neither, and to no "
                "member synthesized for the union around them\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        @Test()
        a_position_below_a_super_call_reports_no_constructor_call() is
            let use analyser = opened();

            are_equal(
                "<none>",
                hover(analyser, 12, 9),
                "a position below a `super` declaration is outside it, and "
                "outside the constructor call synthesized from it\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
