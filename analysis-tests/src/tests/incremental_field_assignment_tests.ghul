namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // FIELD_ASSIGNMENT_CHECKER.report() - which turns recorded per-method
    // summaries into field-definite-assignment warnings - is called from a
    // whole-project build and from the on-demand query-miss recompile, but
    // was not called from Compiler.rewalk_bodies: the incremental body
    // re-walk that handles an interface-preserving single-file edit, which
    // is the default path analysis mode takes for an ordinary keystroke.
    // So the warning tracked the source correctly only up to the first
    // full build - after that, editing a constructor to drop the only
    // assignment to a field never brought the warning back, and editing it
    // to add one never cleared a warning either, because the check simply
    // never ran again. This pins the return case: the pass this warning's
    // own name-only location and field-declaration companion warning both
    // rest on.
    @TestClass()
    class INCREMENTAL_FIELD_ASSIGNMENT_TESTS is
        init() is si

        assigned_baseline() -> string =>
            "namespace IncFieldAssign is\n"
            "    class THING is\n"
            "        init() is si\n"
            "    si\n"
            "\n"
            "    class HOLDER is\n"
            "        thing: THING;\n"
            "\n"
            "        init() is\n"
            "            thing = THING();\n"
            "        si\n"
            "    si\n"
            "si\n";

        // Interface-preserving relative to the baseline - `init()` keeps
        // its signature, only its body changes - so this edit takes the
        // incremental body re-walk path rather than a whole-project
        // rebuild.
        unassigned_edit() -> string =>
            "namespace IncFieldAssign is\n"
            "    class THING is\n"
            "        init() is si\n"
            "    si\n"
            "\n"
            "    class HOLDER is\n"
            "        thing: THING;\n"
            "\n"
            "        init() is\n"
            "        si\n"
            "    si\n"
            "si\n";

        @Test()
        warning_returns_after_an_incremental_edit_drops_the_only_assignment() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("field-assign.ghul", assigned_baseline());
            let baseline = field_assignment_diagnostics(analyser, "field-assign.ghul");
            are_equal(
                0,
                baseline.count,
                "the constructor assigns `thing` - no warning expected.\n"
                "{diagnostics_summary("field-assign.ghul baseline EDIT", baseline)}"
                "\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            analyser.send_edit("field-assign.ghul", unassigned_edit());
            let edited = field_assignment_diagnostics(analyser, "field-assign.ghul");
            is_true(
                edited.count > 0,
                "the edit removed the only assignment to `thing` - the "
                "warning must come back through the incremental body "
                "re-walk path, not only through a whole-project build.\n"
                "{diagnostics_summary("field-assign.ghul after edit", edited)}"
                "\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            analyser.send_edit("field-assign.ghul", assigned_baseline());
            let restored = field_assignment_diagnostics(analyser, "field-assign.ghul");
            are_equal(
                0,
                restored.count,
                "restoring the assignment must clear the warning again "
                "through the same incremental path.\n"
                "{diagnostics_summary("field-assign.ghul after restoring the assignment", restored)}"
                "\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // The field-definite-assignment diagnostics from one EDIT's
        // response, for one file.
        field_assignment_diagnostics(analyser: ANALYSER_PROCESS, file_name: string) -> LIST[DIAGNOSTIC] is
            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
            are_equal("partial", diagnostics.phase);

            let result = LIST[DIAGNOSTIC]();

            for d in user_diagnostics_of(diagnostics) do
                if d.path.ends_with(file_name) /\ d.code =~ "field-definite-assignment" then
                    result.add(d);
                fi
            od

            return result;
        si
    si
si
