namespace Analysis.Tests is
    use System.Diagnostics.Process;
    use System.Diagnostics.ProcessStartInfo;
    use System.Text.UTF8Encoding;

    use Analysis.Protocol.ANALYSER_PROCESS;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Batch-mode coverage for --format-in-place and for a directory argument
    // under --format, driven through the compiler's own argument loop rather
    // than by reading the formatter's output: what is being checked is where
    // the result lands - the source file itself, one file per source beneath
    // a directory - and that nothing temporary is left behind.
    @TestClass()
    class FORMAT_IN_PLACE_DRIVER_TESTS is
        init() is si

        // Runs `dotnet <ghul.dll> <arguments>` to completion and returns
        // (stdout, stderr, exit code). Relative paths in `arguments` resolve
        // against `working_directory`.
        run_compiler(arguments: string, working_directory: string) -> (stdout: string, stderr: string, exit_code: int) is
            let compiler_dll = ANALYSER_PROCESS.resolve_compiler_dll();

            let start_info = ProcessStartInfo();

            start_info.file_name = "dotnet";
            start_info.arguments = "\"{compiler_dll}\" {arguments}";
            start_info.working_directory = working_directory;
            start_info.use_shell_execute = false;
            start_info.redirect_standard_output = true;
            start_info.redirect_standard_error = true;
            start_info.standard_output_encoding = UTF8Encoding();
            start_info.standard_error_encoding = UTF8Encoding();

            let started = Process.start(start_info);

            assert started? else "failed to start ghul-compiler";

            let stdout = started.standard_output.read_to_end();
            let stderr = started.standard_error.read_to_end();

            started.wait_for_exit(30000);

            return (stdout, stderr, started.exit_code);
        si

        // A directory holding one flat source file and one nested source
        // file, so a recursive walk finds both.
        make_tree(root: string) is
            IO.Directory.create_directory(IO.Path.combine(root, "nested"));

            IO.File.write_all_text(
                IO.Path.combine(root, "outer.ghul"),
                "namespace Test is\n    entry() is\n        if true then\n            assert true;\n            // stays inside\n        fi\n    si\nsi\n"
            );

            IO.File.write_all_text(
                IO.Path.combine(root, "nested", "inner.ghul"),
                "namespace Test is\n    f(aaaaaaaaaa: int, bbbbbbbbbb: int, cccccccccc: int, dddddddddd: int) -> int => 0;\nsi\n"
            );
        si

        @Test()
        format_in_place_rewrites_the_source_file_and_leaves_no_temporary() is
            let root = IO.Path.combine(IO.Path.get_temp_path(), "format-in-place-{System.Guid.new_guid()}");
            let source_path = IO.Path.combine(root, "source.ghul");

            IO.Directory.create_directory(root);
            IO.File.write_all_text(
                source_path,
                "namespace Test is\n    entry() is\n        if true then\n            assert true;\n            // stays inside\n        fi\n    si\nsi\n"
            );

            try
                let (stdout, stderr, exit_code) = run_compiler("--format-in-place \"{source_path}\"", root);

                are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");
                are_equal("", stdout, "in-place formatting should print nothing\n--- stdout ---\n{stdout}");

                let formatted = IO.File.read_all_text(source_path);

                is_true(
                    formatted.contains("            // stays inside\n        fi"),
                    "expected the trailing comment to stay inside the if, got: {formatted}"
                );

                is_false(
                    IO.File.exists("{source_path}.tmp"),
                    "the temporary file should be renamed away, not left behind"
                );
            finally
                IO.Directory.delete(root, true);
            yrt
        si

        @Test()
        a_directory_argument_formats_every_source_beneath_it() is
            let root = IO.Path.combine(IO.Path.get_temp_path(), "format-tree-{System.Guid.new_guid()}");

            make_tree(root);

            try
                let (stdout, stderr, exit_code) = run_compiler("--format --format-width 40 \"{root}\"", root);

                are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");

                let outer = IO.File.read_all_text(IO.Path.combine(root, "outer.ghul"));

                is_true(
                    outer.contains("// stays inside"),
                    "expected the flat source file to be formatted, got: {stdout}"
                );

                // --format prints rather than rewrites, so the nested file
                // reaches standard output too - wrapped at the requested
                // column.
                is_true(
                    stdout.contains("aaaaaaaaaa: int,"),
                    "expected the nested source file to be formatted onto its own lines at width 40, got: {stdout}"
                );
            finally
                IO.Directory.delete(root, true);
            yrt
        si

        @Test()
        a_directory_argument_under_format_in_place_rewrites_every_source_beneath_it() is
            let root = IO.Path.combine(IO.Path.get_temp_path(), "format-tree-in-place-{System.Guid.new_guid()}");

            make_tree(root);

            try
                let (stdout, stderr, exit_code) = run_compiler("--format-in-place --format-width 40 \"{root}\"", root);

                are_equal(0, exit_code, "unexpected failure\n--- stderr ---\n{stderr}");

                let inner = IO.File.read_all_text(IO.Path.combine(root, "nested", "inner.ghul"));

                is_true(
                    inner.contains("aaaaaaaaaa: int,"),
                    "expected the nested source file to be rewritten wrapped at width 40, got: {inner}"
                );

                is_false(
                    IO.File.exists(IO.Path.combine(root, "nested", "inner.ghul.tmp")),
                    "the temporary file should be renamed away, not left behind"
                );
            finally
                IO.Directory.delete(root, true);
            yrt
        si

        @Test()
        a_missing_source_is_reported_and_cannot_truncate_anything() is
            let root = IO.Path.combine(IO.Path.get_temp_path(), "format-missing-{System.Guid.new_guid()}");
            let source_path = IO.Path.combine(root, "absent.ghul");

            IO.Directory.create_directory(root);

            try
                let (stdout, stderr, exit_code) = run_compiler("--format-in-place \"{source_path}\"", root);

                is_true(
                    stderr.contains("could not format"),
                    "expected an error naming the missing source, got: {stderr}"
                );

                is_false(
                    IO.File.exists("{source_path}.tmp"),
                    "a failed format should not leave a temporary file behind"
                );
            finally
                IO.Directory.delete(root, true);
            yrt
        si
    si
si
