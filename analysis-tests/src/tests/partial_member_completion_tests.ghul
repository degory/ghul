namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A cursor just after part of a member name completes against the
    // receiver's members, whatever the receiver is and wherever the
    // member access sits, including as the last thing in a file.
    @TestClass()
    class PARTIAL_MEMBER_COMPLETION_TESTS is
        init() is si

        _names(file: string, line: int, column: int) -> Collections.LIST[string] is
            let path = fixture_path("partial-member-completion/{file}");
            assert File.exists(path) else "fixture not copied to test output: {path}";

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit(file, File.read_all_text(path));

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            analyser.send_completion(file, line, column);

            let response = analyser.read_query_response();
            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            let names = Collections.LIST[string]();

            for item in response.items do
                names.add(item.name);
            od

            return names;
        si

        _check(file: string, line: int, column: int, member: string) is
            let names = _names(file, line, column);
            let summary = string.join(", ", names);

            is_true(names.contains(member), "expected {member} among the members for {file}; got: {summary}");
            is_false(names.contains("while"), "a statement keyword was offered for {file}; got: {summary}");
            is_false(names.contains("continue"), "a statement keyword was offered for {file}; got: {summary}");
        si

        @Test()
        a_partial_member_followed_by_a_newline_at_the_end_of_the_file_completes_against_its_receiver() is
            _check("end-with-newline.ghul", 5, 9, "contains");
        si

        @Test()
        a_whole_member_name_that_ends_the_file_completes_against_its_receiver() is
            _check("end-with-whole-name.ghul", 5, 12, "count");
        si

        @Test()
        a_partial_member_that_ends_the_file_inside_a_function_completes_against_its_receiver() is
            _check("end-inside-function.ghul", 7, 17, "contains");
        si

        @Test()
        a_partial_member_that_ends_the_file_completes_against_its_receiver() is
            _check("top-level-last.ghul", 5, 9, "contains");
        si

        @Test()
        a_partial_member_among_top_level_statements_completes_against_its_receiver() is
            _check("top-level-middle.ghul", 5, 9, "contains");
        si

        @Test()
        a_partial_member_of_a_string_literal_completes_against_string() is
            _check("string-literal.ghul", 3, 17, "length");
        si

        @Test()
        a_partial_member_after_a_coalescing_dot_completes_against_the_receiver() is
            _check("coalescing.ghul", 3, 18, "length");
        si

        @Test()
        a_partial_name_in_a_namespace_completes_against_the_namespace() is
            _check("qualified-namespace.ghul", 3, 14, "File");
        si

        @Test()
        a_partial_member_of_a_call_result_completes_against_its_type() is
            _check("call-result.ghul", 10, 18, "greet");
        si
    si
si
