namespace Analysis.Tests is
    use Collections.LIST;

    use Ghul.Pipes;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;
    use Analysis.Protocol.user_diagnostics_of;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // An edit to a file of top-level statements takes the body re-walk,
    // and answers what a build of the edited source from nothing answers.
    //
    // A top-level `let` is declared into the file's namespace from inside
    // the synthesised entry's body, so an edit among the statements can
    // add, remove, rename or retype one with no definition's signature
    // changing. Each test here makes one such edit and compares the
    // incremental answer with a fresh analyser's, which is the only
    // oracle that does not repeat the re-walk's own assumptions.
    @TestClass()
    class TOP_LEVEL_INCREMENTAL_EDIT_TESTS is
        init() is si

        baseline() -> string =>
            "let count = 1;\n"
            "\n"
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "IO.Std.write_line(\"{{show()}}\");\n";

        // A statement edited, every `let` as it was.
        statement_edited() -> string =>
            "let count = 1;\n"
            "\n"
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "IO.Std.write_line(\"{{show() + 1}}\");\n";

        // A `let` added, and read by the function below it.
        let_added() -> string =>
            "let count = 1;\n"
            "let step = 2;\n"
            "\n"
            "show() -> int is\n"
            "    return count + step;\n"
            "si\n"
            "\n"
            "IO.Std.write_line(\"{{show()}}\");\n";

        // The `let` the function reads is gone: the read has to be
        // reported, not resolved against the variable the previous build
        // left behind.
        let_removed() -> string =>
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "IO.Std.write_line(\"{{show()}}\");\n";

        // The `let` renamed and the reader left alone.
        let_renamed() -> string =>
            "let total = 1;\n"
            "\n"
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "IO.Std.write_line(\"{{show()}}\");\n";

        // The `let`'s inferred type changed under a reader that needs the
        // old one.
        let_retyped() -> string =>
            "let count = \"one\";\n"
            "\n"
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "IO.Std.write_line(\"{{show()}}\");\n";

        // The `let` moved below the function that reads it, which is an
        // error the variable's position decides.
        let_moved_below_reader() -> string =>
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "let count = 1;\n"
            "\n"
            "IO.Std.write_line(\"{{show()}}\");\n";

        @Test()
        a_statement_edit_takes_the_body_rewalk() is
            assert_rewalks_and_matches_a_fresh_build("a statement edited", statement_edited());
        si

        @Test()
        an_added_let_is_visible_to_the_function_below_it() is
            assert_rewalks_and_matches_a_fresh_build("a let added", let_added());
        si

        @Test()
        a_removed_let_is_reported_at_its_reader() is
            assert_rewalks_and_matches_a_fresh_build("a let removed", let_removed());
        si

        @Test()
        a_renamed_let_is_reported_at_its_reader() is
            assert_rewalks_and_matches_a_fresh_build("a let renamed", let_renamed());
        si

        @Test()
        a_retyped_let_is_reported_at_its_reader() is
            assert_rewalks_and_matches_a_fresh_build("a let retyped", let_retyped());
        si

        @Test()
        a_let_moved_below_its_reader_is_reported() is
            assert_rewalks_and_matches_a_fresh_build("a let moved below its reader", let_moved_below_reader());
        si

        // An edit and then its reverse leaves nothing behind.
        @Test()
        an_edit_reverted_answers_as_the_baseline_does() is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "script.ghul", baseline());
            edit_and_drain(analyser, "script.ghul", let_retyped());

            are_equal(
                described(diagnostics_of_fresh_build(baseline())),
                described(edit_and_collect(analyser, "script.ghul", baseline())),
                "reverting an edit"
            );
        si

        // A second file's own top-level variable of the same name is not
        // touched by an edit to the first.
        @Test()
        an_edit_leaves_another_files_top_level_variables_alone() is
            let use analyser = ANALYSER_PROCESS(["--suppress", "top-level-statements-not-run"]);

            edit_and_drain(analyser, "other.ghul", baseline());
            edit_and_drain(analyser, "script.ghul", baseline());
            edit_and_drain(analyser, "script.ghul", let_removed());

            are_equal(
                described(diagnostics_of_fresh_build(statement_edited())),
                described(edit_and_collect(analyser, "other.ghul", statement_edited()) |> filter(d => d.path.ends_with("other.ghul"))),
                "the other file's variable"
            );
        si

        assert_rewalks_and_matches_a_fresh_build(description: string, edited_source: string) is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "script.ghul", baseline());

            let incremental = LIST[DIAGNOSTIC]();

            assert_work(
                analyser,
                description,
                [
                    exactly(edit_path_body_rewalk, 1),
                    exactly(edit_path_full_rebuild, 0)
                ],
                () is
                    incremental.add_range(edit_and_collect(analyser, "script.ghul", edited_source));
                si
            );

            are_equal(
                described(diagnostics_of_fresh_build(edited_source)),
                described(incremental),
                description
            );
        si

        diagnostics_of_fresh_build(source: string) -> Collections.Iterable[DIAGNOSTIC] is
            let use analyser = ANALYSER_PROCESS();

            return LIST[DIAGNOSTIC](edit_and_collect(analyser, "script.ghul", source));
        si

        edit_and_collect(analyser: ANALYSER_PROCESS, path: string, source: string) -> Collections.Iterable[DIAGNOSTIC] is
            analyser.send_edit(path, source);

            let response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response after EDIT";

            return LIST[DIAGNOSTIC](user_diagnostics_of(response));
        si

        // Position, severity and message of each diagnostic, ordered, with
        // the file name left out so two files' answers compare.
        described(diagnostics: Collections.Iterable[DIAGNOSTIC]) -> string =>
            diagnostics
                |> map(d => "{d.start_line},{d.start_column}..{d.end_line},{d.end_column} {d.severity} {d.message}")
                |> sort()
                |> join("\n");
    si
si
