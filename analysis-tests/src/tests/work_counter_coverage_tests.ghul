namespace Analysis.Tests is
    use Collections.Iterable;
    use Collections.LIST;
    use Collections.SET;

    use System.Text.StringBuilder;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // The coverage gate.
    //
    // The incremental paths produce the same answers as the whole-project
    // rebuild, so a path that stops being taken costs latency and nothing
    // else - it fails no assertion about a diagnostic or a hover. The only
    // client with the incremental paths enabled is the VS Code extension,
    // and one person uses it, not heavily enough to reliably notice
    // completions getting slower rather than the project getting bigger.
    // So the guard has to be mechanical.
    //
    // The analyser declares its whole counter vocabulary at startup, so a
    // STATS snapshot from a fresh process lists every disposition and
    // decline reason the build knows about, whether or not it has fired.
    // This test reads that list and requires each name to be accounted
    // for: either claimed by a test below, or waived here with a reason.
    //
    // Adding a decline reason in the compiler therefore fails this test
    // until someone either covers it or waives it deliberately. That is
    // the whole point - the failure mode being designed out is a guard
    // that quietly starts firing with nothing watching.
    class WORK_COUNTER_COVERAGE_TESTS is
        @test()

        init() is si

        // Counter name -> the test that asserts it. Kept as one list
        // rather than a `covers` member on each test class: a registry
        // that must be edited cannot pass vacuously, where a reflective
        // scan that silently matched nothing would.
        claimed: Iterable[COUNTER_CLAIM] =>
            [
                CLAIM(EDIT_PATH_BODY_REWALK, "WORK_COUNTER_TESTS.a_body_edit_re_walks_bodies..."),
                CLAIM(EDIT_PATH_INTERFACE_INCREMENTAL, "WORK_COUNTER_TESTS.appending_a_member_builds_a_subtree..."),
                CLAIM(EDIT_PATH_FULL_REBUILD, "WORK_COUNTER_TESTS.the_first_edit_takes_the_full_rebuild..."),

                CLAIM(declined("not-eligible"), "WORK_COUNTER_TESTS.the_first_edit_takes_the_full_rebuild..."),

                CLAIM(declined("multiple-changed-definitions"), "EDIT_DECLINE_TESTS.two_changed_declarations..."),
                CLAIM(declined("fewer-definitions"), "EDIT_DECLINE_TESTS.deleting_a_declaration..."),
                CLAIM(declined("retained-prefix-mismatch"), "EDIT_DECLINE_TESTS.inserting_a_declaration_before..."),
                CLAIM(declined("namespace-name-mismatch"), "EDIT_DECLINE_TESTS.renaming_the_namespace..."),
                CLAIM(declined("class-header-mismatch"), "EDIT_DECLINE_TESTS.changing_a_class_header..."),
                CLAIM(declined("outgoing-has-overriders"), "EDIT_DECLINE_TESTS.editing_an_overridden_method..."),
                CLAIM(declined("incoming-not-a-function"), "EDIT_DECLINE_TESTS.replacing_a_function_with_a_class..."),
                CLAIM(declined("outgoing-not-a-function"), "EDIT_DECLINE_TESTS.changing_a_property...")
            ];

        // Names with no test, each with the reason. Several are guards
        // against a state the caller has already excluded, kept because
        // the guard is cheap and the invariant is not local; those cannot
        // be provoked from the protocol at all, and saying so here is more
        // honest than a test that pretends to reach them.
        waived: Iterable[COUNTER_CLAIM] =>
            [
                CLAIM(declined("no-retained-parse"),
                    "unreachable from EDIT: the handler's eligibility check already "
                    "requires a retained parse before either incremental path is "
                    "entered. Defensive guard"),

                CLAIM(declined("missing-interface-signature"),
                    "unreachable from EDIT: eligibility requires the retained "
                    "signature, and parse_and_add_file always folds the donor's. "
                    "Defensive guard"),

                CLAIM(declined("file-root-not-a-list"),
                    "unreachable: the parser's file root is always a definition "
                    "list. Defensive guard"),

                CLAIM(declined("file-level-change"),
                    "whole-file signature differing while no top-level definition's "
                    "does. No edit is known to produce it; the counter is how we "
                    "would find out that one can"),

                CLAIM(declined("function-pairing-desync"),
                    "needs two parses that agree on the interface signature but "
                    "disagree structurally - i.e. a signature-fold blind spot. "
                    "Not constructible on purpose; the counter is the detector"),

                CLAIM(declined("location-refresh-desync"),
                    "same as function-pairing-desync: the lockstep walk's "
                    "disagreement is a symptom of a fold blind spot, not an "
                    "edit shape a test can ask for"),

                CLAIM(declined("no-class-symbol"),
                    "the edited class absent from the symbol table, which needs a "
                    "failed preceding build. Defensive guard"),

                CLAIM(declined("outgoing-has-overridees"),
                    "checked on the namespace-level branch, where the member is a "
                    "global function and so has no overridees. Defensive guard"),

                CLAIM(declined("unresettable-closure"),
                    "needs a subclass or trait implementor whose ancestry runs "
                    "through a constructed generic. Worth covering; the fixture is "
                    "fiddly enough to be its own change"),

                CLAIM(declined("cross-file-namespace-reference"),
                    "the behaviour is covered by CROSS_FILE_DEPENDENT_RECOMPILE_TESTS' "
                    "namespace case; only the counter assertion is outstanding"),

                CLAIM(declined("cross-file-unknown-file"),
                    "a reference from a file the analyser does not hold. Library "
                    "files are held, so this needs a stale reference record")
            ];

        // Every declared counter is either claimed or waived, and nothing
        // is both. A name that is neither is a new counter whose author
        // has not said who watches it.
        every_declared_counter_is_claimed_or_waived() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            let declared = _declared_counter_names(analyser);

            Assert.is_true(
                declared.count > 0,
                "the analyser declared no edit-path or edit-declined counters at all. "
                "Either WORK_COUNTERS.declare_all stopped running at startup, or the "
                "counter naming changed - this test cannot pass vacuously"
            );

            let accounted = SET[string]();
            let both = LIST[string]();

            for claim in claimed do
                accounted.add(claim.counter);
            od

            for waiver in waived do
                if accounted.contains(waiver.counter) then
                    both.add(waiver.counter);
                fi

                accounted.add(waiver.counter);
            od

            let unaccounted = LIST[string]();

            for name in declared do
                if !accounted.contains(name) then
                    unaccounted.add(name);
                fi
            od

            let message = StringBuilder();

            if unaccounted.count > 0 then
                message.append(
                    "these counters are declared by the compiler but no test claims "
                    "them and no waiver explains them. Add a test asserting the "
                    "counter, or a waiver in `waived` saying why not:\n"
                );

                for name in unaccounted do
                    message.append("  ").append(name).append('\n');
                od
            fi

            if both.count > 0 then
                message.append("these counters are both claimed and waived:\n");

                for name in both do
                    message.append("  ").append(name).append('\n');
                od
            fi

            Assert.are_equal(0, message.length, message.to_string());
        si

        // A claim or waiver naming a counter the compiler no longer
        // declares is stale - the counter was renamed or removed and this
        // registry was not updated, so the entry is now watching nothing.
        no_claim_or_waiver_names_an_unknown_counter() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            let declared = SET[string]();

            for name in _declared_counter_names(analyser) do
                declared.add(name);
            od

            let stale = LIST[string]();

            for claim in claimed do
                if !declared.contains(claim.counter) then
                    stale.add("claimed: {claim.counter} ({claim.note})");
                fi
            od

            for waiver in waived do
                if !declared.contains(waiver.counter) then
                    stale.add("waived: {waiver.counter}");
                fi
            od

            let message = StringBuilder();

            if stale.count > 0 then
                message.append(
                    "these registry entries name a counter the analyser does not "
                    "declare - renamed or removed without updating the registry:\n"
                );

                for entry in stale do
                    message.append("  ").append(entry).append('\n');
                od
            fi

            Assert.are_equal(0, message.length, message.to_string());
        si

        // The disposition and decline names a freshly-started analyser
        // declares. Startup registration is what makes a name visible at
        // count zero, so this is the full vocabulary rather than the
        // counters that happen to have fired.
        _declared_counter_names(analyser: ANALYSER_PROCESS) -> LIST[string] is
            let result = LIST[string]();

            for name in analyser.stat_counts().keys do
                if name.starts_with("edit-path-") \/ name.starts_with("edit-declined-") then
                    result.add(name);
                fi
            od

            return result;
        si
    si

    // One registry entry: a counter name plus the test that asserts it,
    // or the reason no test does.
    struct COUNTER_CLAIM(counter: string, note: string);

    CLAIM(counter: string, note: string) -> COUNTER_CLAIM =>
        COUNTER_CLAIM(counter, note);
si
