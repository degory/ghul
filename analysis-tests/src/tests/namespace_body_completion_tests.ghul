namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A namespace body is a completion context of its own: the keywords
    // that lead a definition, plus every name in scope. It is reached
    // between definitions and on the line after a `use`.
    //
    // The fixture is, by line:
    //
    //   2   use IO;
    //   3                            (blank)
    //   4   class WIDGET is
    //   ...
    //   7                            (blank)
    @TestClass()
    class NAMESPACE_BODY_COMPLETION_TESTS is
        init() is si

        load() -> string is
            let path = fixture_path("namespace-body-completion/namespace-body-completion.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        complete(analyser: ANALYSER_PROCESS, line: int, column: int) -> Collections.SET[string] is
            analyser.send_completion("namespace-body-completion.ghul", line, column);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            let names = Collections.SET[string]();

            for item in response.items do
                names.add(item.name);
            od

            return names;
        si

        opened() -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS();

            analyser.send_edit("namespace-body-completion.ghul", load());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            return analyser;
        si

        @Test()
        the_line_after_a_use_offers_definition_keywords() is
            let use analyser = opened();

            let names = complete(analyser, 3, 5);

            is_true(
                names.contains("class"),
                "expected `class` among the completions on the line after a `use`.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        @Test()
        a_namespace_body_offers_the_types_it_declares() is
            let use analyser = opened();

            let names = complete(analyser, 7, 5);

            is_true(
                names.contains("WIDGET"),
                "expected `WIDGET` among the completions in the namespace body "
                "below it.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
