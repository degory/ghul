namespace Analysis.Tests is
    use Collections.MutableMap;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // Which edit path handles an edit that leaves a syntax error in a body.
    //
    // A body-level syntax error does not change the file's interface: the
    // signature walk skips body interiors, so the declaration structure
    // other files resolve against is identical before and after. Such an
    // edit should therefore take the body re-walk like any other body edit.
    // It is also the commonest state a file is in while being typed in —
    // an expression is incomplete for as long as it takes to finish it —
    // so an edit that rebuilds the project instead pays whole-project cost
    // for most keystrokes of a session.
    class SYNTAX_ERROR_PATH_TESTS is
        @test()

        init() is si

        baseline() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A binary operator with no right operand. The parser reports it;
        // the declaration structure is untouched.
        incomplete_expression() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1 + ;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A trailing dot: what a file looks like the instant before a
        // member name is typed.
        trailing_member_access() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1 .;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // The error repaired.
        repaired() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1 + 3;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // An unresolved name: a semantic error rather than a syntax one,
        // and the case that certainly re-walks. Included as the control —
        // if this differs from the syntax-error cases, the difference is
        // about parse failure specifically.
        unresolved_name() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return no_such_name;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        an_edit_introducing_a_syntax_error_in_a_body_re_walks() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(baseline(), incomplete_expression()),
                "an incomplete expression in a body leaves every declaration "
                "signature alone, so the edit is interface-preserving"
            );
        si

        an_edit_leaving_a_trailing_member_access_re_walks() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(baseline(), trailing_member_access()),
                "a trailing dot in a body leaves every declaration signature "
                "alone, so the edit is interface-preserving"
            );
        si

        an_edit_repairing_a_syntax_error_re_walks() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(incomplete_expression(), repaired()),
                "repairing a body leaves every declaration signature alone"
            );
        si

        an_edit_made_while_a_syntax_error_stands_re_walks() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(incomplete_expression(), unresolved_name()),
                "an edit to a file already holding a syntax error is still "
                "interface-preserving"
            );
        si

        // An unclosed `if`: the body's `fi` is missing, so the parser may
        // consume the enclosing `si` looking for it and take the following
        // declaration with it.
        unclosed_if() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        if true then\n"
            "            return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A missing `si` on the first function.
        missing_function_end() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // An unterminated string literal: everything after it on the line
        // is swallowed into the literal.
        unterminated_string() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> string is\n"
            "        return \"unterminated;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        an_edit_leaving_an_unclosed_if_re_walks() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(baseline(), unclosed_if()),
                "an unclosed if inside a body"
            );
        si

        an_edit_leaving_a_function_unterminated_re_walks() is
            @test()

            Assert.are_equal(
                "interface-incremental",
                disposition(baseline(), missing_function_end()),
                "a function missing its si"
            );
        si

        an_edit_leaving_an_unterminated_string_re_walks() is
            @test()

            Assert.are_equal(
                "interface-incremental",
                disposition(baseline(), unterminated_string()),
                "an unterminated string literal in a body"
            );
        si

        // Once a function is missing its `si`, the following declaration
        // has been swallowed into it. Typing again in that state is the
        // case that matters: it is what a user does continuously while
        // completing the construct.
        missing_function_end_edited() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 11;\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        unterminated_string_edited() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> string is\n"
            "        return \"unterminated more;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        an_edit_while_a_function_is_unterminated() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(missing_function_end(), missing_function_end_edited()),
                "typing in a body while the function is missing its si"
            );
        si

        an_edit_while_a_string_is_unterminated() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(unterminated_string(), unterminated_string_edited()),
                "typing in a body while a string literal is unterminated"
            );
        si

        // Typing a new member, keystroke by keystroke. Each intermediate
        // state is a different declaration structure, so each edit is
        // interface-affecting - the question is whether the incremental
        // interface path takes them or the project rebuilds.
        typing_member_1() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "\n"
            "    g\n"
            "si\n";

        typing_member_2() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "\n"
            "    gamma(\n"
            "si\n";

        typing_member_3() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "\n"
            "    gamma() -> int is\n"
            "si\n";

        a_bare_identifier_at_member_position() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(baseline(), typing_member_1()),
                "a bare identifier where a member is being typed"
            );
        si

        an_unclosed_parameter_list_at_member_position() is
            @test()

            Assert.are_equal(
                "interface-incremental",
                disposition(typing_member_1(), typing_member_2()),
                "an unclosed parameter list while typing a member"
            );
        si

        a_member_header_without_a_body() is
            @test()

            Assert.are_equal(
                "interface-incremental",
                disposition(typing_member_2(), typing_member_3()),
                "a member header whose body has not been typed yet"
            );
        si

        an_edit_introducing_a_semantic_error_in_a_body_re_walks() is
            @test()

            Assert.are_equal(
                "body-rewalk",
                disposition(baseline(), unresolved_name()),
                "an unresolved name in a body leaves every declaration "
                "signature alone"
            );
        si

        // Prime an analyser with `baseline`, apply `edited`, and name how
        // the second edit was handled: the incremental path that took it,
        // or the rebuild together with the guard that caused it.
        disposition(baseline_source: string, edited_source: string) -> string is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "syntax_error.ghul", baseline_source);

            let before = analyser.stat_counts();

            edit_and_drain(analyser, "syntax_error.ghul", edited_source);

            let after = analyser.stat_counts();

            if _moved(before, after, edit_path_body_rewalk) then
                return "body-rewalk";
            fi

            if _moved(before, after, edit_path_interface_incremental) then
                return "interface-incremental";
            fi

            if !_moved(before, after, edit_path_full_rebuild) then
                return "no-edit-path-reported";
            fi

            for name in after.keys do
                if name.starts_with("edit-declined-") /\ _moved(before, after, name) then
                    return "full-rebuild:{name.substring("edit-declined-".length)}";
                fi
            od

            return "full-rebuild:no-reason-reported";
        si

        _moved(before: MutableMap[string,int], after: MutableMap[string,int], name: string) -> bool =>
            _at(after, name) > _at(before, name);

        _at(counts: MutableMap[string,int], name: string) -> int =>
            if counts.contains_key(name) then counts[name] else 0 fi;

        edit_and_drain(analyser: ANALYSER_PROCESS, path: string, source: string) is
            analyser.send_edit(path, source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response after EDIT";
        si
    si
si
