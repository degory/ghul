namespace Analysis.Tests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Which edit path handles an edit that leaves a syntax error in the
    // file. This is the state a file spends most of a typing session in —
    // an expression is incomplete for as long as it takes to finish it —
    // so the answer decides what most keystrokes cost.
    //
    // An error the parser recovers from within a body leaves every
    // declaration signature alone, because the signature walk skips body
    // interiors, and takes the body re-walk like any other body edit.
    //
    // An error whose recovery consumes the declaration that follows it
    // does not: a function missing its `si` swallows the next one, which
    // moves a signature and makes the edit interface-affecting in fact as
    // well as in classification, so it takes the incremental interface
    // path. How far recovery reaches is what decides this, and it is not
    // predictable from how broken the text looks — an unterminated string
    // literal ends at the newline and reaches no further than its own
    // line, so it re-walks like any body edit.
    //
    // Neither shape rebuilds the project, and an edit made while the
    // construct is still open re-walks as usual, so a broken construct
    // costs one non-rewalk edit rather than one per keystroke.
    @TestClass()
    class SYNTAX_ERROR_PATH_TESTS is
        init() is si

        baseline() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A binary operator with no right operand. The parser reports it;
        // the declaration structure is untouched.
        incomplete_expression() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1 + ;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A trailing dot: what a file looks like the instant before a
        // member name is typed.
        trailing_member_access() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1 .;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // The error repaired.
        repaired() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1 + 3;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // An unresolved name: a semantic error rather than a syntax one,
        // and the case that certainly re-walks. Included as the control —
        // if this differs from the syntax-error cases, the difference is
        // about parse failure specifically.
        unresolved_name() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return no_such_name;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        @Test()
        an_edit_introducing_a_syntax_error_in_a_body_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", baseline(), incomplete_expression()),
                "an incomplete expression in a body leaves every declaration "
                "signature alone, so the edit is interface-preserving"
            );
        si

        @Test()
        an_edit_leaving_a_trailing_member_access_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", baseline(), trailing_member_access()),
                "a trailing dot in a body leaves every declaration signature "
                "alone, so the edit is interface-preserving"
            );
        si

        @Test()
        an_edit_repairing_a_syntax_error_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", incomplete_expression(), repaired()),
                "repairing a body leaves every declaration signature alone"
            );
        si

        @Test()
        an_edit_made_while_a_syntax_error_stands_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", incomplete_expression(), unresolved_name()),
                "an edit to a file already holding a syntax error is still "
                "interface-preserving"
            );
        si

        // An unclosed `if`: the body's `fi` is missing. Recovery stays
        // inside the body, so `beta` survives and every signature is
        // unchanged — the contrast with `missing_function_end` below,
        // where recovery does consume the following declaration.
        unclosed_if() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        if true then\n"
            "            return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A missing `si` on the first function.
        missing_function_end() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // An unterminated string literal. The tokenizer ends the fragment
        // at the newline, so it swallows the rest of its own line and
        // nothing beyond: every declaration after it still parses.
        unterminated_string() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return \"unterminated;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        @Test()
        an_edit_leaving_an_unclosed_if_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", baseline(), unclosed_if()),
                "an unclosed if inside a body"
            );
        si

        @Test()
        an_edit_leaving_a_function_unterminated_takes_the_interface_path() is
            are_equal(
                "interface-incremental",
                disposition("syntax_error.ghul", baseline(), missing_function_end()),
                "a function missing its si"
            );
        si

        @Test()
        an_edit_leaving_an_unterminated_string_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", baseline(), unterminated_string()),
                "an unterminated string literal in a body"
            );
        si

        // Once a function is missing its `si`, the following declaration
        // has been swallowed into it. Typing again in that state is the
        // case that matters: it is what a user does continuously while
        // completing the construct.
        missing_function_end_edited() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 11;\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        unterminated_string_edited() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return \"unterminated more;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        @Test()
        an_edit_while_a_function_is_unterminated() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", missing_function_end(), missing_function_end_edited()),
                "typing in a body while the function is missing its si"
            );
        si

        @Test()
        an_edit_while_a_string_is_unterminated() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", unterminated_string(), unterminated_string_edited()),
                "typing in a body while a string literal is unterminated"
            );
        si

        // Typing a new member, keystroke by keystroke. Whether an
        // intermediate state is interface-affecting depends on what the
        // parser makes of it: a bare identifier is not yet a declaration
        // and leaves the signature alone, where a parameter list or a
        // member header is one and moves it.
        typing_member_1() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "\n"
            "    g\n"
            "si\n";

        typing_member_2() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "\n"
            "    gamma(\n"
            "si\n";

        typing_member_3() -> string =>
            "namespace SyntaxError is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "\n"
            "    gamma() -> int is\n"
            "si\n";

        @Test()
        a_bare_identifier_at_member_position() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", baseline(), typing_member_1()),
                "a bare identifier where a member is being typed"
            );
        si

        @Test()
        an_unclosed_parameter_list_at_member_position() is
            are_equal(
                "interface-incremental",
                disposition("syntax_error.ghul", typing_member_1(), typing_member_2()),
                "an unclosed parameter list while typing a member"
            );
        si

        @Test()
        a_member_header_without_a_body() is
            are_equal(
                "interface-incremental",
                disposition("syntax_error.ghul", typing_member_2(), typing_member_3()),
                "a member header whose body has not been typed yet"
            );
        si

        @Test()
        an_edit_introducing_a_semantic_error_in_a_body_re_walks() is
            are_equal(
                "body-rewalk",
                disposition("syntax_error.ghul", baseline(), unresolved_name()),
                "an unresolved name in a body leaves every declaration "
                "signature alone"
            );
        si

    si
si
