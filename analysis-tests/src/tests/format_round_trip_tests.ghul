namespace Analysis.Tests is
    use Ghul.Pipes
    use Collections.Iterable;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // End-to-end round-trip checks for the analysis-mode source formatter:
    // each fixture is sent through FORMAT and the response is asserted to
    // match the canonical form. The fixtures cover syntax forms that the
    // formatter has historically dropped, mangled, or crashed on — anything
    // not already exercised here is fair game to regress.
    //
    // FORMAT_ISOLATION_TESTS covers the "errors-in-other-files do not block
    // formatting" guarantee; this fixture is focussed on the printer
    // producing source that re-parses to the same tree.
    @TestClass()
    class FORMATTER_ROUND_TRIP_TESTS is
        init() is si

        // The formatter always finishes its output with a single trailing
        // newline; the helper appends one so the test source can read as a
        // newline-separated list of lines without that detail in every
        // fixture.
        lines(parts: Iterable[string]) -> string is
            let result = System.Text.StringBuilder();
            for part in parts do
                result.append(part);
                result.append('\n');
            od
            return result.to_string();
        si

        // Format `source` once and assert the result equals `expected`.
        // Then format the result a second time and assert idempotence — a
        // formatter that drops or mangles syntax usually trips the second
        // pass too, so the idempotence check is a cheap second signal.
        assert_round_trips(source: string, expected: string) is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_format("round_trip.ghul", source);
            let first = analyser.read_response();

            assert isa Response.FORMAT(first) else
                "expected FORMAT response on first pass\n--- analyser stderr ---\n{analyser.stderr_capture}";

            are_equal(
                expected,
                first.text,
                "first-pass format did not match expected output\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            analyser.send_format("round_trip.ghul", first.text);
            let second = analyser.read_response();

            assert isa Response.FORMAT(second) else
                "expected FORMAT response on second pass\n--- analyser stderr ---\n{analyser.stderr_capture}";

            are_equal(
                first.text,
                second.text,
                "formatter is not idempotent\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        @Test()
        primary_constructor_header_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX(value: int) is",
                "        _value",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        partial_block_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        _value: int",
                "    si",
                "    partial BOX is",
                "        get_value() -> int => _value",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        impl_block_round_trips() is
            let body = lines([
                "namespace Test is",
                "    trait Printer is",
                "        print() -> string => \"?\"",
                "    si",
                "    class BOX is",
                "    si",
                "    impl Printer for BOX is",
                "        print() -> string => \"box\"",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        primary_constructor_semicolon_shorthand_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX(value: int)",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        primary_constructor_with_init_modifier_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class TOKEN_PAIR(token: int, value: string init) is",
                "        get_value() -> string => value",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        struct_with_primary_constructor_round_trips() is
            let body = lines([
                "namespace Test is",
                "    struct POINT(x: int, y: int)",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        super_call_body_declaration_round_trips() is
            // SUPER_CALL is reachable only from inside a primary-ctor
            // class body. Without an explicit FORMATTER override the
            // StrictVisitor base throws and FORMAT echoes the buffer back
            // unchanged — invisible to the user but a pure-regression
            // path.
            let body = lines([
                "namespace Test is",
                "    class ANIMAL is",
                "        init(name: string) is si",
                "    si",
                "",
                "    class DOG(name: string): ANIMAL is",
                "        super(name)",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        secondary_init_splice_marker_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class POINT(x: int, y: int) is",
                "        init(.., label: string) is si",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        let_mut_modifier_round_trips() is
            // A trailing `mut` on a local declares a reassignable variable;
            // without it the local is immutable. Dropping `mut` on format
            // silently changes the program's meaning.
            let body = lines([
                "namespace Test is",
                "    main() is",
                "        let a mut = 0",
                "        let b: int mut = 1",
                "        a = a + 1",
                "        b = b + 1",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        union_variants_round_trip() is
            let body = lines([
                "namespace Test is",
                "    union COLOUR is",
                "        RED",
                "        GREEN",
                "        BLUE(intensity: int)",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        match_marker_leaf_round_trips() is
            // A `~` leaf and an unmarked one differ only by the marker,
            // and on a bare name the difference is match versus bind —
            // so dropping it in the printer would silently change what
            // the pattern means. The marker is written back wherever it
            // was read, including where it is a no-op.
            let source = lines([
                "namespace Test is",
                "    class Main is",
                "        check(pair: (int, string), expected: int) static is",
                "            if let (~expected, name) = pair then",
                "                IO.Std.write_line(name)",
                "            fi",
                "            case pair",
                "            when (~1, s) then",
                "                IO.Std.write_line(s)",
                "            when (2, s) then",
                "                IO.Std.write_line(s)",
                "            else",
                "                IO.Std.write_line(\"none\")",
                "            esac",
                "        si",
                "    si",
                "si"
            ]);

            assert_round_trips(source, source);
        si

        @Test()
        union_with_primary_constructor_round_trips() is
            // A union primary-constructor header `(name: string)` is part
            // of the source the user wrote and must survive a format pass.
            // Variant fields containing `..` round-trip verbatim; a variant
            // with no additional fields round-trips to the bare-`NAME;`
            // form (the implicit splice).
            let source = lines([
                "namespace Test is",
                "    union Color(name: string) is",
                "        RED(..)",
                "        GREEN",
                "        BLUE(intensity: int, ..)",
                "    si",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    union Color(name: string) is",
                "        RED",
                "        GREEN",
                "        BLUE(intensity: int, ..)",
                "    si",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        case_statement_then_else_round_trips() is
            // The inherited base printer emits the legacy `when X :` /
            // `default` arm shape, which the parser does not accept;
            // the formatter must produce `when X then` / `else` for the
            // output to re-parse.
            let body = lines([
                "namespace Test is",
                "    label(value: int) is",
                "        case value",
                "        when 200 then",
                "            let ok = 1",
                "        when 500 then",
                "            let server = 2",
                "        else",
                "            let other = 3",
                "        esac",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        case_expression_round_trips() is
            let source = lines([
                "namespace Test is",
                "    label(value: int) -> string =>",
                "        case value",
                "        when 200 then",
                "            \"ok\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    label(value: int) -> string => case value",
                "    when 200 then",
                "        \"ok\"",
                "    else",
                "        \"other\"",
                "    esac",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        case_binding_pattern_round_trips() is
            let source = lines([
                "namespace Test is",
                "    describe(p: int) -> string =>",
                "        case p",
                "        when v: int then",
                "            \"int\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    describe(p: int) -> string => case p",
                "    when v: int then",
                "        \"int\"",
                "    else",
                "        \"other\"",
                "    esac",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        case_literal_leaf_pattern_round_trips() is
            let source = lines([
                "namespace Test is",
                "    describe(p: (int, int)) -> string =>",
                "        case p",
                "        when (1, n) then",
                "            \"first\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    describe(p: (int, int)) -> string => case p",
                "    when (1, n) then",
                "        \"first\"",
                "    else",
                "        \"other\"",
                "    esac",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        if_let_chained_guard_round_trips() is
            let body = lines([
                "namespace Test is",
                "    sum(x: int?, y: int) -> int => if let v = x /\\ v > 0 /\\ y > v then v + y else 0 fi",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        generic_kind_constraint_round_trips() is
            let body = lines([
                "namespace Test is",
                "    typed[T: class](x: T) -> T => x",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        generic_new_constraint_round_trips() is
            let body = lines([
                "namespace Test is",
                "    typed[T: class init](x: T) -> T => x",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        generic_variance_constraint_round_trips() is
            let body = lines([
                "namespace Test is",
                "    trait COVARIANT[T: out] is",
                "    si",
                "    trait CONTRAVARIANT[T: in] is",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        optional_type_round_trips() is
            let body = lines([
                "namespace Test is",
                "    length(name: string?) -> int => if name? then name!.length else 0 fi",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        yield_in_iterable_returning_function_round_trips() is
            let body = lines([
                "namespace Test is",
                "    first_three() -> Collections.Iterable[int] is",
                "        yield 1",
                "        yield 2",
                "        yield 3",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        default_expression_round_trips() is
            let body = lines([
                "namespace Test is",
                "    blank() -> int => _",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        thread_first_chain_round_trips() is
            // `|>` is desugared at parse time into an ordinary call with
            // the subject as argument 0, so the formatter has to render
            // the chain back rather than the call it became.
            let body = lines([
                "namespace Test is",
                "    use Collections",
                "    first_big(xs: List[int]) -> int? => xs |> find(x => x > 10)",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        // `val ... lav` is a value-producing block. The formatter
        // emits the keyword pair as its own lines so multi-statement
        // bodies stack vertically; each inner statement renders via
        // its own visit.

        @Test()
        val_lav_value_block_round_trips() is
            let source = lines([
                "namespace Test is",
                "    f() -> int => val let y = 5; y * 2 lav",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    f() -> int => val",
                "        let y = 5",
                "        y * 2",
                "    lav",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        val_lav_void_block_round_trips() is
            // Void-tail (LET) block in void position: the formatter
            // emits the same form; semantic context decides void vs
            // value at compile time, not at format time.
            let source = lines([
                "namespace Test is",
                "    f() is",
                "        val write_line(\"hi\"); let unused = 99; lav",
                "    si",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    f() is",
                "        val",
                "            write_line(\"hi\")",
                "            let unused = 99",
                "        lav",
                "    si",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        let_use_disposal_round_trips() is
            // `let use x = e` must keep its `use`: the disposal keyword is
            // load-bearing (it schedules a scope-exit dispose) and trivial
            // for the printer to drop.
            let body = lines([
                "namespace Test is",
                "    f(d: Disposable) is",
                "        let use x = d",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        let_use_in_disposal_round_trips() is
            // The `let use x = e in ...` expression form carries the same
            // `want_dispose` flag as a `let use` statement and must keep its
            // `use` through formatting.
            let body = lines([
                "namespace Test is",
                "    f(d: Disposable) is",
                "        let use x = d in g(x)",
                "    si",
                "    g(d: Disposable) is si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        backtick_escaped_keyword_identifiers_round_trip() is
            // A name that collides with a keyword is only an identifier
            // because it was backtick-escaped in source. The printer must
            // re-emit the backtick in every position - member declaration,
            // member reference, and local variable - or the output tokenises
            // as the keyword and no longer re-parses.
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        `field: int",
                "        `class: string",
                "        value() -> int is",
                "            let `let = `field",
                "            return `let",
                "        si",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        backtick_escaped_numeric_identifiers_round_trip() is
            // A name made only of identifier characters but starting with a
            // digit tokenises as a number when bare, so it too can only be an
            // identifier via a backtick escape and must keep it on output.
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        `123: int",
                "        value() -> int => `123",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        backtick_escaped_operator_reference_round_trips() is
            // An operator referred to as a plain value (rather than applied)
            // must keep its backtick, or it re-parses as an operator token.
            // The operator stays bare where it is applied - the binary `f(a, b)`
            // call and any operator definition - so only the value position
            // gains the escape.
            let body = lines([
                "namespace Test is",
                "    apply[T](f: (T, T) -> T, a: T, b: T) -> T => f(a, b)",
                "    add(a: int, b: int) -> int => apply(`+, a, b)",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        trailing_comma_round_trips() is
            // A trailing comma adds no element, so nothing but the span of
            // the list records that the source wrote one. Dropping it would
            // move the cursor's argument slot under the author.
            let body = lines([
                "namespace Test is",
                "    scale(value: int, factor: int, offset: int) -> int => value * factor + offset",
                "    entry() is",
                "        let call = scale(1, 2, 3,)",
                "        let threaded = 1 |> scale(2, 3,)",
                "        let array = [1, 2, 3,]",
                "        let tuple = (1, 2,)",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        trailing_comma_survives_wrapping() is
            // Broken across lines the comma stays hard against the argument
            // it trails, leaving the closing bracket on its own line.
            let source = lines([
                "namespace Test is",
                "    scale(a_long_parameter_name: int, another_long_parameter: int) -> int => 0",
                "    entry() is",
                "        let wrapped = scale(a_very_long_argument_expression_here, another_very_long_argument_expression,)",
                "    si",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    scale(a_long_parameter_name: int, another_long_parameter: int) -> int => 0",
                "    entry() is",
                "        let wrapped = scale(",
                "            a_very_long_argument_expression_here,",
                "            another_very_long_argument_expression,",
                "        )",
                "    si",
                "si"
            ]);

            assert_round_trips(source, expected);
        si

        @Test()
        a_bodyless_trait_method_terminates_with_one_semicolon() is
            let body = lines([
                "namespace Test is",
                "    trait Shape is",
                "        area() -> double",
                "        name() -> string",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_bodyless_trait_property_terminates_with_one_semicolon() is
            let body = lines([
                "namespace Test is",
                "    trait Sized is",
                "        count: int",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        an_abstract_class_keeps_the_abstract_modifier() is
            let body = lines([
                "namespace Test is",
                "    class ANIMAL abstract is",
                "        init() is si",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_nested_destructure_group_keeps_its_type_ascription() is
            let body = lines([
                "namespace Test is",
                "    union Tree is",
                "        LEAF(value: int)",
                "        NODE(left: Tree, right: Tree)",
                "    si",
                "    sum(t: Tree) -> int => case t",
                "    when ((ll, lr): NODE, r): NODE then",
                "        sum(ll) + sum(lr) + sum(r)",
                "    when v: LEAF then",
                "        v.value",
                "    esac",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_top_level_let_stays_interleaved_with_the_function_that_follows_it() is
            let body = lines([
                "namespace Test is",
                "    let LIMIT = 20000",
                "    sum(n: int) -> int => n + LIMIT",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_rec_marker_round_trips() is
            let body = lines([
                "namespace Test is",
                "    let factorial = n rec => if n == 0 then 1 else n * rec(n - 1) fi",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_sole_destructure_group_argument_keeps_its_parens() is
            let body = lines([
                "namespace Test is",
                "    let add = ((a, b)) => a + b",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_typed_destructure_lambda_parameter_round_trips() is
            let body = lines([
                "namespace Test is",
                "    let add = ((a, b): (int, int)) => a + b",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        // A line comment written as the last item of a block belongs inside
        // the block, indented with the statements it follows - not after the
        // block's closing keyword.
        @Test()
        a_trailing_comment_stays_inside_every_block_form() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        while true do",
                "            assert true",
                "            // while note",
                "        od",
                "",
                "        do",
                "            assert true",
                "            // do note",
                "        od",
                "",
                "        for i in 1::2 do",
                "            assert true",
                "            // for note",
                "        od",
                "",
                "        case 1",
                "        when 1 then",
                "            assert true",
                "            // arm note",
                "        else",
                "            assert true",
                "            // else note",
                "        esac",
                "",
                "        try",
                "            assert true",
                "            // try note",
                "        catch e: System.Exception",
                "            assert true",
                "            // catch note",
                "        finally",
                "            assert true",
                "            // finally note",
                "        yrt",
                "",
                "        if true then",
                "            assert true",
                "            // then note",
                "        else",
                "            assert true",
                "            // else-arm note",
                "        fi",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        // A comment after a block's closing keyword is the next statement's
        // leading comment, and a blank line after it is a separator: neither
        // may be pulled back inside the block.
        @Test()
        a_comment_after_a_closing_keyword_stays_outside_the_block() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        if true then",
                "            assert true",
                "        fi",
                "        // leads the next statement",
                "        assert false",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        @Test()
        a_blank_line_after_a_closing_keyword_stays_outside_the_block() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        if true then",
                "            assert true",
                "            // note",
                "        fi",
                "",
                "        assert false",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        // A comment between one case arm and the next arm's keyword belongs
        // to the arm it trails, not to the next arm's body.
        @Test()
        a_trailing_comment_precedes_the_next_case_arm_keyword() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        case 1",
                "        when 1 then",
                "            assert true",
                "            // one and done",
                "        else",
                "            assert false",
                "        esac",
                "    si",
                "si"
            ]);

            assert_round_trips(body, body);
        si

        // A range between two single terms prints without spaces around the
        // operator; an operand that is not a single term keeps them.
        @Test()
        a_range_between_single_terms_prints_tight() is
            let source = lines([
                "namespace Test is",
                "    entry(xs: int[]) is",
                "        let a = 1 .. 10",
                "        let b = xs[0] .. xs[1]",
                "        let c = (1 + 0) .. (2 + 0)",
                "        let d = xs[0 ..< 1]",
                "        let e = x .. y + 1",
                "    si",
                "si"
            ]);

            let expected = lines([
                "namespace Test is",
                "    entry(xs: int[]) is",
                "        let a = 1..10",
                "        let b = xs[0]..xs[1]",
                "        let c = (1 + 0)..(2 + 0)",
                "        let d = xs[0..<1]",
                "        let e = x .. y + 1",
                "    si",
                "si"
            ]);

            assert_round_trips(source, expected);
        si
        // Each of the fixtures below is a defect that made the compiler's
        // own formatted source fail to parse or fail to build, found by
        // formatting the whole of src/ and building the result.

        @Test()
        assign_accessor_body_keyword_is_separated() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        _value: int",
                "        value: int public",
                "            => _value,",
                "            = v is",
                "                _value = v",
                "            si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        statement_after_a_block_terminator_is_not_run_on() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        total(xs: int[]) -> int is",
                "            let t mut = 0",
                "            for x in xs do",
                "                t = t + x",
                "            od",
                "            t",
                "        si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        throw_expression_body_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        stub() -> int => throw System.Exception(\"nope\")",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        literal_escaping_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        quote: char => '\\''",
                "        double_quote: char => '\"'",
                "        braces: string => \"a {{{{ b }}}} c\"",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        prefix_operator_stays_tight_against_its_operand() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        name: string?",
                "        anonymous: bool => !name?",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        tuple_literal_keeps_the_space_after_its_comma() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        pair: (int, int) => (1, 2)",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        empty_body_stays_on_one_line() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        trait_modifiers_are_separated_from_its_name() is
            let body = lines([
                "namespace Test is",
                "    trait Named open is",
                "        name: string",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_pragma_survives_formatting() is
            let body = lines([
                "namespace Test is",
                "    @System.Obsolete(\"old\")",
                "    class BOX is",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A postfix type constructor binds to a function type's result, so
        // dropping the parens changes what the type means.
        @Test()
        a_function_type_under_a_postfix_constructor_keeps_its_parens() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        callback: (() -> int)?",
                "        predicates: ((int) -> bool)[]",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A block comment's continuation lines carry the indentation they
        // were written at, and the renderer indents them again, so the
        // indent has to be stripped before they are re-emitted or the
        // comment moves four columns right on every pass.
        @Test()
        a_block_comment_does_not_drift_right() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        /*",
                "            indented continuation",
                "                deeper still",
                "        */",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A line break stands in for the terminator, so the formatter
        // writes none - except between two adjacent string literals, which
        // would otherwise chain into one literal across the break.
        @Test()
        the_string_separating_terminator_is_kept() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        let band = \"top\";",
                "        \"{{band}} band\"",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

    si
si
