namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;
    use Analysis.Protocol.user_diagnostics_of;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Which function the assembly enters at is settled once per debounced
    // COMPILE rather than on each edit, so the warning a file gets for
    // top-level statements that will not run arrives with the COMPILE and
    // not with the EDIT that preceded it.
    @TestClass()
    class ENTRY_POINT_SELECTION_TESTS is
        init() is si

        script_source() -> string =>
            "use IO.Std.write_line;\n"
            "\n"
            "write_line(\"not the entry point\");\n";

        entry_source() -> string =>
            "use IO.Std.write_line;\n"
            "\n"
            "entry() is\n"
            "    write_line(\"declared entry\");\n"
            "si\n";

        counted(diagnostics: LIST[DIAGNOSTIC]) -> int is
            let result mut = 0;

            for d in diagnostics do
                if let code = d.code /\ code =~ "top-level-statements-not-run" then
                    result = result + 1;
                fi
            od

            return result;
        si

        @Test()
        Unrun_top_level_statements_are_reported_by_COMPILE_and_not_by_EDIT() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit_files(
                [
                    EDIT_FILE("script.ghul", script_source()),
                    EDIT_FILE("main.ghul", entry_source())
                ]);

            let edit_response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(edit_response)
                else "expected DIAGNOSTICS response after EDIT";

            are_equal(
                0,
                counted(LIST[DIAGNOSTIC](user_diagnostics_of(edit_response))),
                "EDIT should not settle the entry point"
            );

            analyser.send_compile();

            let compile_response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(compile_response)
                else "expected DIAGNOSTICS response after COMPILE";

            are_equal(
                1,
                counted(LIST[DIAGNOSTIC](user_diagnostics_of(compile_response))),
                "COMPILE should report the file whose top-level statements will not run"
            );

            // A second COMPILE with no edit between reports the same one
            // warning rather than a second copy of it.
            analyser.send_compile();

            let repeat_response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(repeat_response)
                else "expected DIAGNOSTICS response after the second COMPILE";

            are_equal(
                1,
                counted(LIST[DIAGNOSTIC](user_diagnostics_of(repeat_response))),
                "a repeated COMPILE should not double the warning"
            );
        si
    si
si
