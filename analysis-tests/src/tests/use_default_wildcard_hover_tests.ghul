namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // `use default` and `use X.*` import several symbols through one
    // clause with no per-imported-name token in source. Hovering or
    // colouring the clause itself must not pick up one of the imports
    // it happens to have resolved last - there is nothing there to
    // rename, define, or describe as that import.
    @TestClass()
    class USE_DEFAULT_WILDCARD_HOVER_TESTS is
        init() is si

        load_fixture(name: string) -> string is
            let path = fixture_path(name);

            assert File.exists(path) else "fixture missing: {path}";

            return File.read_all_text(path);
        si

        hover_description(analyser: ANALYSER_PROCESS, path: string, line: int, column: int) -> string is
            analyser.send_hover(path, line, column);

            let response = analyser.read_query_response();

            assert isa Response.HOVER(response) else "expected HOVER response";

            if !response.signature? then
                return "";
            fi

            return response.signature;
        si

        @Test()
        hover_on_use_default_reports_nothing() is
            let use analyser = ANALYSER_PROCESS();

            let source = load_fixture("use-default-tokens/use-default-tokens.ghul");

            analyser.send_edit("use-default-tokens.ghul", source);
            analyser.read_response();

            // "default" starts at column 9 of `    use default`.
            let description = hover_description(analyser, "use-default-tokens.ghul", 2, 9);

            are_equal(
                "",
                description,
                "hovering `use default` should report nothing, not an imported symbol; got '{description}'"
            );
        si

        @Test()
        semantic_tokens_do_not_colour_use_default() is
            let use analyser = ANALYSER_PROCESS();

            let source = load_fixture("use-default-tokens/use-default-tokens.ghul");

            analyser.send_edit("use-default-tokens.ghul", source);
            analyser.read_response();

            analyser.send_semantic_tokens("use-default-tokens.ghul");

            let response = analyser.read_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            for token in response.tokens do
                is_false(
                    token.start_line == 2 /\ token.start_column == 9,
                    "expected no semantic token over `default` in `use default`, got '{token.token_type}'"
                );
            od
        si

        @Test()
        hover_on_use_wildcard_target_describes_the_container() is
            let use analyser = ANALYSER_PROCESS();

            let source = load_fixture("use-wildcard-tokens/use-wildcard-tokens.ghul");

            analyser.send_edit("use-wildcard-tokens.ghul", source);
            analyser.read_response();

            analyser.send_compile();
            analyser.read_response();

            // "COLOURS" starts at column 9 of line 7, `    use COLOURS.*;`.
            let description = hover_description(analyser, "use-wildcard-tokens.ghul", 7, 9);

            is_true(
                description.contains("COLOURS"),
                "hovering `use COLOURS.*` should describe COLOURS itself, got '{description}'"
            );
        si

        @Test()
        semantic_tokens_colour_use_wildcard_target_as_the_class() is
            let use analyser = ANALYSER_PROCESS();

            let source = load_fixture("use-wildcard-tokens/use-wildcard-tokens.ghul");

            analyser.send_edit("use-wildcard-tokens.ghul", source);
            analyser.read_response();

            analyser.send_semantic_tokens("use-wildcard-tokens.ghul");

            let response = analyser.read_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            let actual_type: string mut = "";
            let found mut = false;

            for token in response.tokens do
                if token.start_line == 7 /\ token.start_column == 9 then
                    found = true;
                    actual_type = token.token_type;
                fi
            od

            is_true(found, "expected a semantic token over `COLOURS` in `use COLOURS.*`");

            are_equal(
                "class",
                actual_type,
                "expected `COLOURS` in `use COLOURS.*` to colour as a class, got '{actual_type}'"
            );
        si
    si
si
