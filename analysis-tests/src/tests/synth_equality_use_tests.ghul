namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.SEMANTIC_TOKEN;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The value-equality test a `case` `when` label (and a literal
    // destructure leaf) performs is synthesized - no source token names
    // `=~` - so recording it as a symbol use paints whatever span the
    // caller handed in: the whole `case` arm, coloured as one method
    // call, or the literal leaf itself. The synthesized comparison
    // records no symbol use; a written `=~` keeps recording at its own
    // operator token.
    @TestClass()
    class SYNTH_EQUALITY_USE_TESTS is
        init() is si

        load_fixture() -> string is
            let path = fixture_path("synth-equality-use/synth-equality-use.ghul");

            assert File.exists(path) else "fixture missing: {path}";

            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS) -> Response.SEMANTIC_TOKENS is
            analyser.send_edit("synth-equality-use.ghul", load_fixture());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            let user_diagnostics = LIST(user_diagnostics_of(diagnostics));
            are_equal(
                0,
                user_diagnostics.count,
                diagnostics_summary("EDIT had unexpected diagnostics", user_diagnostics)
            );

            analyser.send_semantic_tokens("synth-equality-use.ghul");

            let response = analyser.read_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            return response;
        si

        // A call-shaped token - method, function or operator. The
        // whole-arm use was reported as `method`.
        is_call_token(token: SEMANTIC_TOKEN) -> bool =>
            token.token_type =~ "method" \/
            token.token_type =~ "function" \/
            token.token_type =~ "operator";

        covers(token: SEMANTIC_TOKEN, line: int, column: int) -> bool =>
            (token.start_line < line \/ (token.start_line == line /\ token.start_column <= column)) /\
            (token.end_line > line \/ (token.end_line == line /\ token.end_column >= column));

        call_token_at(
            response: Response.SEMANTIC_TOKENS,
            line: int,
            column: int
        ) -> string? is
            for token in response.tokens do
                if is_call_token(token) /\ covers(token, line, column) then
                    return token.token_type;
                fi
            od

            return null;
        si

        // No synthesized comparison paints a whole `case` arm: nothing
        // call-shaped spans a line boundary in this fixture.
        @Test()
        no_call_shaped_token_spans_multiple_lines() is
            let use analyser = ANALYSER_PROCESS();

            let response = prime(analyser);

            for token in response.tokens do
                if is_call_token(token) then
                    is_false(
                        token.end_line > token.start_line,
                        "a {token.token_type} token spans lines "
                        "{token.start_line}..{token.end_line} - the synthesized `=~` "
                        "behind a `when` label must record no symbol use"
                    );
                fi
            od
        si

        // Hovering inside a literal-label arm's body does not report
        // the synthesized `=~` the label lowered to.
        @Test()
        hover_inside_case_arm_body_is_not_the_synthesized_operator() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("synth-equality-use.ghul", load_fixture());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            analyser.send_hover("synth-equality-use.ghul", 7, 13);

            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            let description = response.signature ?? "";

            is_false(
                description.contains("=~"),
                "hover inside a `when 200` arm body reported '{description}'"
            );
        si

        // A literal destructure leaf is an equality test against that
        // value, not a call to the operator performing it.
        @Test()
        literal_destructure_leaf_is_not_a_call_token() is
            let use analyser = ANALYSER_PROCESS();

            let response = prime(analyser);

            let covering = call_token_at(response, 28, 17);

            assert !covering? else
                "the literal leaf `1` in `if let (1, name)` carries a "
                "{covering} token.\n--- analyser stderr ---\n{analyser.stderr_capture}";
        si

        // A written `=~` still records its use, at its own operator
        // token - over non-optional operands and over an optional one,
        // the latter being the case that shares a lowering
        // (_build_null_safe_equality) with the suppressed builder.
        @Test()
        written_equality_operator_still_records_a_use() is
            let use analyser = ANALYSER_PROCESS();

            let response = prime(analyser);

            let same_covering = call_token_at(response, 32, 24);

            assert same_covering? else
                "no call-shaped token covers the written `=~` at line 32, column 24"
            ;

            let matched_covering = call_token_at(response, 33, 28);

            assert matched_covering? else
                "no call-shaped token covers the written `=~` over an optional "
                "operand at line 33, column 28.\n--- analyser stderr ---\n{analyser.stderr_capture}"
            ;
        si
    si
si
