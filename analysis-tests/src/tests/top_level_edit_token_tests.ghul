namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;
    use Analysis.Protocol.SEMANTIC_TOKEN;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A file of top-level statements has every one of them inside the
    // synthesised entry, so each edit to it is interface-preserving and takes
    // the incremental body re-walk. Reconciliation discards recorded uses
    // inside a re-walked body on the promise that the re-walk re-records them,
    // which holds only where the span really is the body: given the whole
    // file, it discards the file's imports, and nothing re-records those.
    // The loss is permanent - a later full compile does not restore them -
    // so it reads as the imports losing their colour and never getting it back.
    @TestClass()
    class TOP_LEVEL_EDIT_TOKEN_TESTS is
        init() is si

        baseline() -> string =>
            "use IO.Std.write_line;\n"
            "\n"
            "let total = 1 + 2;\n"
            "write_line(\"{{total}}\");\n";

        edited() -> string =>
            baseline().replace("1 + 2", "1 + 3");

        edit(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("top-level-tokens.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";
        si

        tokens(analyser: ANALYSER_PROCESS) -> LIST[SEMANTIC_TOKEN] is
            analyser.send_semantic_tokens("top-level-tokens.ghul");

            let response = analyser.read_query_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            return LIST[SEMANTIC_TOKEN](response.tokens);
        si

        // The imported name on line 1, which is outside every statement.
        has_import_token(tokens: LIST[SEMANTIC_TOKEN]) -> bool is
            for token in tokens do
                if token.start_line == 1 /\ token.token_type =~ "function" then
                    return true;
                fi
            od

            return false;
        si

        @Test()
        an_import_keeps_its_token_across_an_edit() is
            let use analyser = ANALYSER_PROCESS();

            edit(analyser, baseline());

            is_true(
                has_import_token(tokens(analyser)),
                "the import had no token before the edit"
            );

            edit(analyser, edited());

            is_true(
                has_import_token(tokens(analyser)),
                "the import lost its token after an edit to a top-level statement"
            );
        si

        // Everything else in the file keeps its token too, so a regression that
        // widens the span again is caught wherever it lands rather than only at
        // the imports.
        @Test()
        an_edit_leaves_the_rest_of_the_file_coloured() is
            let use analyser = ANALYSER_PROCESS();

            edit(analyser, baseline());

            let before = tokens(analyser).count;

            edit(analyser, edited());

            are_equal(
                before,
                tokens(analyser).count,
                "an edit that changes only a literal changed how many tokens the file has"
            );
        si
    si
si
