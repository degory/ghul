namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Hovering a name that resolves to a type alias describes the alias
    // itself - its name, its type parameters and the type it stands for -
    // so a reader learns what the name means without having to find the
    // clause. A generic alias describes its own declaration rather than
    // the type the arguments at the use site substitute into it.
    @TestClass()
    class TYPE_ALIAS_HOVER_TESTS is
        init() is si

        load_fixture() -> string is
            let path = fixture_path("type-alias-hover/type-alias-hover.ghul");

            assert File.exists(path) else "fixture missing: {path}";

            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("type-alias-hover.ghul", source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            let user_diagnostics = LIST(user_diagnostics_of(diagnostics));

            are_equal(
                0,
                user_diagnostics.count,
                diagnostics_summary("EDIT had unexpected diagnostics", user_diagnostics)
            );
        si

        hover_description(analyser: ANALYSER_PROCESS, line: int, column: int) -> string is
            analyser.send_hover("type-alias-hover.ghul", line, column);

            let response = analyser.read_query_response();

            assert isa Response.HOVER(response) else "expected HOVER response";

            if !response.signature? then
                return "";
            fi

            return response.signature;
        si

        assert_hover_contains(actual: string, expected_substring: string, where: string, analyser: ANALYSER_PROCESS) is
            is_true(
                actual? /\ actual.contains(expected_substring),
                "{where}: expected HOVER to contain '{expected_substring}', got '{actual}'.\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        @Test()
        hover_on_an_alias_clause__describes_the_alias() is
            let source = load_fixture();
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, source);

            let description = hover_description(analyser, 4, 9);

            assert_hover_contains(description, "IndexedString", "hover on the alias clause", analyser);
        si

        @Test()
        hover_on_a_use_of_an_alias__describes_the_alias() is
            let source = load_fixture();
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, source);

            let description = hover_description(analyser, 9, 21);

            assert_hover_contains(
                description,
                "use IndexedString = (index: int, value: string)",
                "hover on a parameter typed by an alias",
                analyser
            );
        si

        @Test()
        hover_on_a_generic_alias_use__describes_the_declaration() is
            let source = load_fixture();
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, source);

            let description = hover_description(analyser, 13, 16);

            assert_hover_contains(
                description,
                "use Pair[A, B] = (first: A, second: B)",
                "hover on a parameter typed by a generic alias",
                analyser
            );
        si
    si
si
