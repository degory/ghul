namespace Analysis.Tests is
    use IO.File;
    use IO.Path;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // SIGNATURE on a call written with an argument pack spread out,
    // `apply(join, "x", "y")`, where the callee declares two parameters
    // and the call supplies three arguments.
    @TestClass()
    class SPREAD_CALL_SIGNATURE_TESTS is
        init() is si

        load() -> string is
            let path = Path.combine(fixture_dir("spread-call-signature"), "main.ghul");
            assert File.exists(path) else "fixture missing: {path}";
            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit_files([EDIT_FILE("main.ghul", source)]);
            analyser.read_response();
            analyser.send_edit("main.ghul", source);
            analyser.read_response();
        si

        signature_at(analyser: ANALYSER_PROCESS, line: int, column: int) -> Response.SIGNATURE is
            analyser.send_signature("main.ghul", line, column);

            let response = analyser.read_query_response();
            assert isa Response.SIGNATURE(response) else "expected SIGNATURE response";

            return response;
        si

        @Test()
        spread_call_reports_the_callees_two_parameters() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // inside `join`, the first argument
            let first = signature_at(analyser, 7, 30);

            is_true(first.signatures.count >= 1, "no signature returned in the first argument");
            are_equal(2, first.signatures[0].parameters.count, "expected the two declared parameters");
            are_equal(0, first.current_parameter_index, "expected current parameter 0 in the first argument");
        si

        @Test()
        spread_arguments_all_fall_in_the_spread_parameter() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // inside `"x"` and inside `"y"`
            let second = signature_at(analyser, 7, 36);
            let third = signature_at(analyser, 7, 41);

            are_equal(1, second.current_parameter_index, "expected current parameter 1 in the second argument");
            are_equal(1, third.current_parameter_index, "expected current parameter 1 in the third argument");
        si
    si
si
