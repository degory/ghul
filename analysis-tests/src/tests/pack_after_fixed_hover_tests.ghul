namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A formal whose function type takes parameters of its own before
    // the argument pack, `f: (A, T..) -> A`, renders in a hover with
    // those parameters in place, both as declared and at the call, where
    // the pack has been bound to a tuple.
    @TestClass()
    class PACK_AFTER_FIXED_HOVER_TESTS is
        init() is si

        load_fixture() -> string is
            let path = fixture_path("pack-after-fixed-hover/pack-after-fixed-hover.ghul");

            assert File.exists(path) else "fixture missing: {path}";

            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("pack-after-fixed-hover.ghul", source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            let user_diagnostics = LIST(user_diagnostics_of(diagnostics));
            are_equal(0, user_diagnostics.count, diagnostics_summary("EDIT had unexpected diagnostics", user_diagnostics));
        si

        hover_signature(analyser: ANALYSER_PROCESS, line: int, column: int) -> string is
            analyser.send_hover("pack-after-fixed-hover.ghul", line, column);

            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            return response.signature ?? "";
        si

        @Test()
        hover_on_the_declaration__keeps_the_leading_parameter() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_fixture());

            // line 2, on `fold`
            let signature = hover_signature(analyser, 2, 6);

            is_true(signature.contains("f: (A, T..) -> A"), "expected the leading parameter before the pack; got:\n---\n{signature}\n---");
        si

        @Test()
        hover_on_the_call__keeps_the_leading_parameter_at_the_bound_tuple() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_fixture());

            // line 13, on `fold` at the call
            let signature = hover_signature(analyser, 13, 22);

            is_true(signature.contains("f: (int, (int, int)..) -> int"), "expected the leading parameter before the bound pack; got:\n---\n{signature}\n---");
        si
    si
si
