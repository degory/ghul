namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The end-to-end proof that a diagnostic is reported once. It lives
    // here rather than beside the integration tests because ghul-test
    // passes `--test-run` on every compile, which keeps duplicates so
    // that captured snapshots show what the passes reported - so no
    // test run under it can observe deduplication. Analysis mode has it
    // on, as an editor does.
    //
    // A name that does not resolve inside a property's type expression
    // was reported once per walk of that expression, and a property is
    // walked more than once.
    @TestClass()
    class DUPLICATE_DIAGNOSTIC_TESTS is
        init() is si

        unresolved_in_a_property: string =>
            "namespace DuplicateDiagnostic is\n"
            "    use IO.Path;\n"
            "\n"
            "    class A is\n"
            "        init() is si\n"
            "\n"
            "        name: object => typeof(Path.assembly);\n"
            "    si\n"
            "si\n";

        symbol_not_found_count(response: Response) -> int is
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            let user = LIST[DIAGNOSTIC](user_diagnostics_of(cast Response.DIAGNOSTICS(response)));

            let count mut = 0;

            for d in user do
                if d.message.starts_with("symbol not found") then
                    count = count + 1;
                fi
            od

            return count;
        si

        @Test()
        an_unresolved_name_in_a_property_is_reported_once() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("duplicate-diagnostic.ghul", unresolved_in_a_property);

            are_equal(1, symbol_not_found_count(analyser.read_response()));
        si

        // The same file with duplicates kept, which is what every
        // ghul-test run sees: the walk really does report twice, so the
        // test above is observing deduplication rather than a pass that
        // happens to report once.
        @Test()
        keeping_duplicates_shows_the_repeat() is
            let use analyser =
                ANALYSER_PROCESS(LIST[string](["--keep-duplicate-diagnostics"]));

            analyser.send_edit("duplicate-diagnostic.ghul", unresolved_in_a_property);

            are_equal(2, symbol_not_found_count(analyser.read_response()));
        si
    si
si
