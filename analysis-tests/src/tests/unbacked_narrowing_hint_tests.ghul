namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.INLAY_HINT;
    use Analysis.Protocol.Response;
    use Analysis.Protocol.user_diagnostics_of;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // A fact formed through a getter the solved effect relations
    // cannot prove for the fact's kind is never presented as a
    // narrowing: the introduction inlay at the test site is
    // retracted and replaced by a `narrowing-unavailable` hint,
    // hover stays wide, and facts through backed getters at other
    // sites are untouched.
    class UNBACKED_NARROWING_HINT_TESTS is
        @test()

        init() is si

        // Lines of interest (1-based):
        //   22  `if h? /\\ h.dirty? then`  — unbacked presence test
        //   23  `let copy: INNER? = h.dirty;` — non-leaning read
        //   27  `if h? /\\ h.auto_prop? then` — backed auto-property
        //   31  `if h? /\\ h.clean? then` — backed passthrough
        //   32  `let c: INNER? = h.clean;` — non-leaning read
        source() -> string =>
            "namespace Unbacked is\n"
            "    class INNER is\n"
            "        init() is si\n"
            "    si\n"
            "    class HOST is\n"
            "        _store: INNER? field;\n"
            "        _count: int field;\n"
            "        auto_prop: INNER?;\n"
            "        dirty: INNER? is\n"
            "            _count = _count + 1;\n"
            "            return _store;\n"
            "        si\n"
            "        clean: INNER? is\n"
            "            return _store;\n"
            "        si\n"
            "        init() is si\n"
            "    si\n"
            "    class USES is\n"
            "        init() is si\n"
            "        takes(i: INNER) is si\n"
            "        unbacked_presence(h: HOST?) is\n"
            "            if h? /\\ h.dirty? then\n"
            "                let copy: INNER? = h.dirty;\n"
            "            fi\n"
            "        si\n"
            "        backed_auto(h: HOST?) is\n"
            "            if h? /\\ h.auto_prop? then\n"
            "            fi\n"
            "        si\n"
            "        backed_clean(h: HOST?) is\n"
            "            if h? /\\ h.clean? then\n"
            "                let c: INNER? = h.clean;\n"
            "            fi\n"
            "        si\n"
            "    si\n"
            "si\n";

        compile_file(path: string, text: string) -> Response.DIAGNOSTICS is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files([path]);

            analyser.send_edit(path, text);
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            return compile;
        si

        // The unbacked fact's carrier is retracted at its own test
        // site while backed facts — including the local-presence
        // half of the same condition — keep theirs.
        unbacked_presence_test__loses_intro_inlay() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files(["unbacked.ghul"]);

            analyser.send_edit("unbacked.ghul", source());
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            analyser.send_inlay_hints("unbacked.ghul");
            let inlays = analyser.read_response();
            assert isa Response.INLAY_HINTS(inlays) else "expected INLAY_HINTS response";

            // line 22: the `h` presence inlay survives at column 16;
            // the `h.dirty` carrier at column 22 is gone
            Assert.is_true(
                has_inlay_at(inlays.hints, "narrowing-presence", 22, 16),
                "expected the local presence inlay on line 22, got: {summary(inlays.hints)}");

            Assert.is_false(
                has_inlay_at(inlays.hints, "narrowing-presence", 22, 22),
                "expected no presence inlay for the unbacked `h.dirty` test, got: {summary(inlays.hints)}");

            // backed controls keep theirs
            Assert.is_true(
                has_inlay_at(inlays.hints, "narrowing-presence", 27, 22),
                "expected the auto-property presence inlay on line 27, got: {summary(inlays.hints)}");

            Assert.is_true(
                has_inlay_at(inlays.hints, "narrowing-presence", 31, 22),
                "expected the passthrough presence inlay on line 31, got: {summary(inlays.hints)}");
        si

        // The retracted inlay is replaced by one editor-only hint per
        // test site, naming the getter and the remedy, and the file
        // carries nothing louder — no use here leans on the fact.
        unbacked_presence_test__gains_unavailable_hint() is
            @test()

            let compile = compile_file("unbacked.ghul", source());

            let hints = LIST[DIAGNOSTIC]();
            let louder = LIST[DIAGNOSTIC]();

            for d in user_diagnostics_of(compile) do
                if d.severity == 4 /\ d.code =~ "narrowing-unavailable" then
                    hints.add(d);
                elif d.severity <= 2 then
                    louder.add(d);
                fi
            od

            Assert.are_equal(
                1,
                hints.count,
                "expected exactly one narrowing-unavailable hint, got: {diagnostics_summary(hints)}");

            Assert.are_equal(0, louder.count, diagnostics_summary("unexpected errors or warnings", louder));

            let hint = hints[0];

            Assert.are_equal(22, hint.start_line, "hint line");

            Assert.is_true(
                hint.message.contains("'dirty'"),
                "hint should name the getter, got: {hint.message}");

            Assert.is_true(
                hint.message.contains("not provably stable"),
                "hint should say the getter is not provably stable, got: {hint.message}");
        si

        // Hover on a read through the unbacked fact reports the
        // declared optional type — no narrowed line — while the same
        // read through a backed getter shows the narrowed shape.
        unbacked_read__hover_stays_wide() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files(["unbacked.ghul"]);

            analyser.send_edit("unbacked.ghul", source());
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            // line 23 `let copy: INNER? = h.dirty;` — `dirty` at column 38
            analyser.send_hover("unbacked.ghul", 23, 38);
            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            let signature = response.signature ?? "";

            Assert.is_true(
                signature.contains("INNER?"),
                "expected the wide optional type on the unbacked read, got: {signature}");

            Assert.is_false(
                signature.contains("►"),
                "expected no narrowed line on the unbacked read, got: {signature}");

            // line 32 `let c: INNER? = h.clean;` — `clean` at column 35,
            // backed by the post-solve store-free proof
            analyser.send_hover("unbacked.ghul", 32, 35);
            let backed = analyser.read_query_response();
            assert isa Response.HOVER(backed) else "expected HOVER response";

            let backed_signature = backed.signature ?? "";

            Assert.is_true(
                backed_signature.contains("►"),
                "expected the narrowed line on the backed read, got: {backed_signature}");
        si

        // A monotone memoiser backs presence facts by design, so its
        // test site keeps the introduction inlay — the unbacked
        // classification must not reach for it.
        monotone_memoiser_presence__keeps_inlay() is
            @test()

            let memoiser_source =
                "namespace Memo is\n"
                "    class FRAME is\n"
                "        init() is si\n"
                "    si\n"
                "    class HOST is\n"
                "        _frame: FRAME? field;\n"
                "        frame: FRAME? is\n"
                "            if !_frame? then\n"
                "                _frame = FRAME();\n"
                "            fi\n"
                "            return _frame;\n"
                "        si\n"
                "        init() is si\n"
                "    si\n"
                "    class USES is\n"
                "        init() is si\n"
                "        use_frame(h: HOST?) is\n"
                "            if h? /\\ h.frame? then\n"
                "            fi\n"
                "        si\n"
                "    si\n"
                "si\n";

            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files(["memo.ghul"]);

            analyser.send_edit("memo.ghul", memoiser_source);
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            analyser.send_inlay_hints("memo.ghul");
            let inlays = analyser.read_response();
            assert isa Response.INLAY_HINTS(inlays) else "expected INLAY_HINTS response";

            // line 18 `if h? /\\ h.frame? then` — the frame carrier at column 22
            Assert.is_true(
                has_inlay_at(inlays.hints, "narrowing-presence", 18, 22),
                "expected the monotone memoiser presence inlay, got: {summary(inlays.hints)}");
        si

        has_inlay_at(hints: Collections.Iterable[INLAY_HINT], code: string, line: int, column: int) -> bool is
            for h in hints do
                if h.code =~ code /\ h.line == line /\ h.column == column then
                    return true;
                fi
            od

            return false;
        si

        summary(hints: Collections.Iterable[INLAY_HINT]) -> string is
            let buffer = System.Text.StringBuilder();

            for h in hints do
                buffer.append("[{h.line},{h.column} {h.code}] ");
            od

            return buffer.to_string();
        si

        diagnostics_summary(diagnostics: Collections.Iterable[DIAGNOSTIC]) -> string is
            let buffer = System.Text.StringBuilder();

            for d in diagnostics do
                buffer.append("[{d.start_line} sev{d.severity} {d.code ?? "-"}] {d.message}; ");
            od

            return buffer.to_string();
        si

        diagnostics_summary(prefix: string, diagnostics: Collections.Iterable[DIAGNOSTIC]) -> string =>
            "{prefix}: {diagnostics_summary(diagnostics)}";
    si
si
