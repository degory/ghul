namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.EDIT_DELTA_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // The `edit_delta` request: an edit whose text is given as the one
    // span that changed rather than in full.
    //
    // The property that matters is equivalence — the analyser splices the
    // span into its retained copy and then does exactly what it does for
    // an edit carrying the same text, so nothing downstream may differ,
    // neither the diagnostics nor which edit path handled it. The other
    // tests here pin the failure direction: a delta the analyser cannot
    // account for recycles rather than being applied to the wrong text.
    class EDIT_DELTA_TESTS is
        @test()

        init() is si

        // `alpha`'s body is `        return 1;` on line 3 — eight spaces,
        // then `return `, so the `1` is at column 16 and the `;` at 17.
        baseline() -> string =>
            "namespace EditDelta is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // The `1` replaced by an expression: interface-preserving, and
        // still clean.
        body_edited() -> string =>
            "namespace EditDelta is\n"
            "    alpha() -> int is\n"
            "        return 1 + 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // The `1` replaced by a name nothing declares, so the edit is
        // answered with a diagnostic rather than with nothing — an
        // equivalence check between two empty diagnostics lists would
        // hold however wrong the spliced text was, and would not
        // distinguish a correctly spliced file from one the splice put
        // the changed text nowhere near.
        body_broken() -> string =>
            "namespace EditDelta is\n"
            "    alpha() -> int is\n"
            "        return undeclared_name;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // The undeclared name inserted before the `1` rather than
        // replacing it — what `baseline()` becomes under a zero-width
        // insertion at line 3 column 16.
        body_inserted() -> string =>
            "namespace EditDelta is\n"
            "    alpha() -> int is\n"
            "        return undeclared_name + 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // What a fresh analyser answers when `source` arrives in full,
        // over the same baseline every delta here is computed against.
        full_text_answer(source: string) -> LIST[DIAGNOSTIC] is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "delta.ghul", baseline());

            analyser.send_edit("delta.ghul", source);

            return diagnostics_for(analyser, "delta.ghul");
        si

        // What a fresh analyser in the same state answers when the
        // change arrives as the span that produced it.
        delta_answer(
            start_line: int, start_column: int, end_line: int, end_column: int,
            new_text: string
        ) -> LIST[DIAGNOSTIC] is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "delta.ghul", baseline());

            analyser.send_edit_delta(
                "delta.ghul",
                start_line, start_column, end_line, end_column,
                new_text,
                baseline()
            );

            return diagnostics_for(analyser, "delta.ghul");
        si

        // A delta and the whole text it reconstructs must be answered
        // identically. Two processes rather than one, so the comparison
        // is between two analysers in the same state rather than between
        // successive edits to one.
        a_delta_is_answered_exactly_as_the_equivalent_full_text_edit() is
            @test()

            assert_same_answer(
                "replacing the `1` with an undeclared name",
                full_text_answer(body_broken()),
                delta_answer(3, 16, 3, 17, "undeclared_name")
            );
        si

        // A keystroke is an insertion, not a replacement: start and end
        // positions equal, `new_text` non-empty. The commonest shape a
        // client sends, and the one where an off-by-one in the offset
        // arithmetic would land the text one character out.
        a_zero_width_insertion_is_answered_exactly_as_the_equivalent_full_text_edit() is
            @test()

            assert_same_answer(
                "inserting an undeclared name before the `1`",
                full_text_answer(body_inserted()),
                delta_answer(3, 16, 3, 16, "undeclared_name + ")
            );
        si

        // `        return 1;` is 17 characters, so column 18 is the
        // end-of-line position — one past the last character, where the
        // newline sits. A client selecting to the end of a line sends
        // exactly this, and the offset of the last position on a line is
        // the boundary the bounds check admits rather than rejects.
        a_span_ending_at_end_of_line_is_answered_exactly_as_the_equivalent_full_text_edit() is
            @test()

            assert_same_answer(
                "replacing to the end of the line",
                full_text_answer(body_broken()),
                delta_answer(3, 16, 3, 18, "undeclared_name;")
            );
        si

        // A span past the end of the retained text cannot be applied,
        // and `expected_length` does not catch it — a file can be the
        // right length and still not have the line the delta names. The
        // bounds check is the only thing between that and a splice at
        // whatever offset the arithmetic happened to produce.
        a_delta_whose_span_falls_outside_the_retained_text_recycles_the_analyser() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "delta.ghul", baseline());

            analyser.send_edit_delta("delta.ghul", 99, 1, 99, 1, "x", baseline());

            assert_recycled(analyser, "a delta naming a line the file does not have");
        si

        // Both answers must be the same, and both must be non-empty: two
        // empty diagnostics lists would compare equal however badly the
        // delta had been spliced.
        assert_same_answer(
            description: string,
            full_text_diagnostics: LIST[DIAGNOSTIC],
            delta_diagnostics: LIST[DIAGNOSTIC]
        ) is
            Assert.is_true(
                full_text_diagnostics.count > 0,
                "{diagnostics_summary("the full-text edit for {description} was expected to report the undeclared name", full_text_diagnostics)}"
            );

            Assert.are_equal(
                describe(full_text_diagnostics),
                describe(delta_diagnostics),
                "{description}: the delta and the full text it reconstructs "
                "were answered differently"
            );
        si

        // A delta that leaves every signature alone is an
        // interface-preserving edit like any other, so it must take the
        // incremental body re-walk. Reconstructing the text before the
        // edit path sees it is what makes that true; a delta answered by
        // the whole-project rebuild would still produce the right
        // diagnostics and lose the whole point.
        an_interface_preserving_delta_takes_the_body_rewalk_path() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "delta.ghul", baseline());

            assert_work(
                analyser,
                "interface-preserving delta",
                [
                    exactly(edit_path_body_rewalk, 1),
                    exactly(edit_path_interface_incremental, 0),
                    exactly(edit_path_full_rebuild, 0)
                ],
                () is
                    analyser.send_edit_delta("delta.ghul", 3, 16, 3, 17, "1 + 1", baseline());
                    drain_edit(analyser);
                si
            );

            let diagnostics = diagnostics_after_compile(analyser, "delta.ghul");

            Assert.are_equal(
                0,
                diagnostics.count,
                "{diagnostics_summary("the spliced text was expected to compile clean", diagnostics)}"
                "\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // The analyser's retained text being the text the spans were
        // computed against is the client's responsibility, and
        // `expected_length` is where it is checked. A mismatch means the
        // two copies have already diverged, so the analyser recycles
        // instead of splicing onto text it cannot account for.
        a_delta_whose_expected_length_does_not_match_recycles_the_analyser() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "delta.ghul", baseline());

            analyser.send_edit_delta_files([
                EDIT_DELTA_FILE("delta.ghul", 3, 16, 3, 17, "1 + 1", baseline().length + 1)
            ]);

            assert_recycled(analyser, "a delta whose expected_length is wrong");
        si

        // Same rule for a file the analyser has never been sent: there is
        // no text to splice into, and inventing one would put the two
        // copies permanently out of step.
        a_delta_for_a_file_the_analyser_does_not_hold_recycles_the_analyser() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "delta.ghul", baseline());

            analyser.send_edit_delta("absent.ghul", 1, 1, 1, 1, "x", "");

            assert_recycled(analyser, "a delta for a file the analyser does not hold");
        si

        // The analyser answers a delta it cannot apply with a restart and
        // goes, exiting 1 as it does for any recycle.
        assert_recycled(analyser: ANALYSER_PROCESS, description: string) is
            let response = analyser.read_response();

            Assert.is_true(
                isa Response.RESTART(response),
                "{description} should have recycled the analyser, got a "
                "different response.\n--- analyser stderr ---\n"
                "{analyser.stderr_capture}"
            );

            Assert.is_true(
                analyser.wait_for_exit(5000),
                "{description} should have ended the analyser process.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            Assert.are_equal(1, analyser.exit_code, "recycle exit status");
        si

        // A stable rendering of a diagnostics list, for comparing two
        // analysers' answers as one value.
        describe(diagnostics: LIST[DIAGNOSTIC]) -> string is
            let result = System.Text.StringBuilder();

            for d in diagnostics do
                result.append("{d}\n");
            od

            return result.to_string();
        si

        edit_and_drain(analyser: ANALYSER_PROCESS, path: string, source: string) is
            analyser.send_edit(path, source);
            drain_edit(analyser);
        si

        drain_edit(analyser: ANALYSER_PROCESS) is
            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
            Assert.are_equal("partial", diagnostics.phase);
        si

        // User diagnostics for one file from the next diagnostics frame,
        // which must be an EDIT's.
        diagnostics_for(analyser: ANALYSER_PROCESS, file_name: string) -> LIST[DIAGNOSTIC] is
            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
            Assert.are_equal("partial", diagnostics.phase);

            return collect(diagnostics, file_name);
        si

        // User diagnostics for one file from a full COMPILE, which sees
        // the whole project rather than only the edited file.
        diagnostics_after_compile(analyser: ANALYSER_PROCESS, file_name: string) -> LIST[DIAGNOSTIC] is
            analyser.send_compile();

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
            Assert.are_equal("full", diagnostics.phase);

            return collect(diagnostics, file_name);
        si

        collect(diagnostics: Response.DIAGNOSTICS, file_name: string) -> LIST[DIAGNOSTIC] is
            let result = LIST[DIAGNOSTIC]();

            for d in user_diagnostics_of(diagnostics) do
                if d.path.ends_with(file_name) then
                    result.add(d);
                fi
            od

            return result;
        si
    si
si
