namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.INLAY_HINT;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // A narrowing that survives a call the effect relations cannot
    // prove harmless is still what resolution used, so the editor
    // would otherwise show the narrowed type with nothing to say that
    // it is unproven. These drive EDIT, COMPILE and then INLAY_HINTS
    // or HOVER, and assert that such a load carries the
    // `narrowing-unproven` inlay and that hover names the shape the
    // value could have reverted to.
    //
    // The load under test is deliberately one that leans on nothing:
    // `_f` flows into an `INNER?` parameter, which the un-narrowed
    // type already satisfies. A leaning use is reported as a reliance
    // diagnostic instead, and carries no inlay.
    class NARROWING_UNPROVEN_HINT_TESTS is
        @test()

        init() is si

        // `clobber` assigns `_f` a possibly-absent value, so a call to
        // it discharges neither the presence fact nor the narrow.
        // `quiet` writes an unrelated member, so the same shape over it
        // discharges and must draw no inlay. Line 19 is the unproven
        // load, line 26 the discharged one, and column 33 is `_f` in
        // both.
        source() -> string =>
            "namespace Unproven is\n"
            "    class INNER is\n"
            "        init() is si\n"
            "    si\n"
            "    class HOLDER is\n"
            "        _f: INNER?;\n"
            "        _count: int;\n"
            "        init() is si\n"
            "        clobber() is\n"
            "            _f = null;\n"
            "        si\n"
            "        quiet() is\n"
            "            _count = _count + 1;\n"
            "        si\n"
            "        describe(v: INNER?) -> string => if v? then \"y\" else \"n\" fi;\n"
            "        unproven() -> string is\n"
            "            if _f? then\n"
            "                clobber();\n"
            "                return describe(_f);\n"
            "            fi\n"
            "            return \"none\";\n"
            "        si\n"
            "        proven() -> string is\n"
            "            if _f? then\n"
            "                quiet();\n"
            "                return describe(_f);\n"
            "            fi\n"
            "            return \"none\";\n"
            "        si\n"
            "    si\n"
            "si\n";

        prime(analyser: ANALYSER_PROCESS, open_paths: Collections.Iterable[string]) is
            analyser.send_open_files(open_paths);

            analyser.send_edit("unproven.ghul", source());
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";
        si

        compile_inlays(open_paths: Collections.Iterable[string]) -> LIST[INLAY_HINT] is
            let use analyser = ANALYSER_PROCESS();

            prime(analyser, open_paths);

            analyser.send_inlay_hints("unproven.ghul");
            let inlays = analyser.read_response();
            assert isa Response.INLAY_HINTS(inlays) else "expected INLAY_HINTS response";

            return LIST[INLAY_HINT](inlays.hints);
        si

        unproven_inlays(hints: Collections.Iterable[INLAY_HINT]) -> LIST[INLAY_HINT] is
            let result = LIST[INLAY_HINT]();

            for h in hints do
                if h.code =~ "narrowing-unproven" then
                    result.add(h);
                fi
            od

            return result;
        si

        // The load at line 19 stands on a presence fact the call at
        // line 18 leaves unproven, and leans on nothing, so it is
        // reported as an inlay rather than as a diagnostic.
        inlay_marks_a_load_over_an_unproven_call() is
            @test()

            let inlays = unproven_inlays(compile_inlays(["unproven.ghul"]));

            let saw mut = false;

            for h in inlays do
                if h.line == 19 /\ h.label =~ "◄?" then
                    saw = true;
                fi
            od

            Assert.is_true(
                saw,
                "expected a narrowing-unproven inlay at line 19, saw: {inlay_summary(inlays)}"
            );
        si

        // The detail names both the shape the value could have
        // reverted to and the call that could have reverted it, so
        // hovering the sigil explains it without another query.
        inlay_detail_names_the_wide_type_and_the_call() is
            @test()

            let inlays = unproven_inlays(compile_inlays(["unproven.ghul"]));

            let saw mut = false;

            for h in inlays do
                if h.line == 19 /\
                    h.detail.contains("INNER?") /\
                    h.detail.contains("clobber") then
                    saw = true;
                fi
            od

            Assert.is_true(
                saw,
                "expected the inlay detail to name INNER? and clobber, saw: {inlay_summary(inlays)}"
            );
        si

        // `quiet` writes only `_count`, which the solved relations
        // prove disjoint from the fact, so the load at line 26 keeps
        // its narrowing with nothing to report.
        no_inlay_where_the_call_is_proven_harmless() is
            @test()

            let inlays = unproven_inlays(compile_inlays(["unproven.ghul"]));

            for h in inlays do
                Assert.are_not_equal(
                    26,
                    h.line,
                    "expected no inlay for a discharged crossing, saw: {h.detail}"
                );
            od
        si

        // Same editor-only gate the other narrowing inlays carry.
        no_inlay_when_the_file_is_not_open() is
            @test()

            let inlays = unproven_inlays(compile_inlays(["other.ghul"]));

            Assert.are_equal(
                0,
                inlays.count,
                "expected no narrowing-unproven inlay for a file that is not open"
            );
        si

        // Hover on the unproven load names the un-narrowed shape, so
        // the popover cannot be read as a promise that the narrowed
        // one still holds.
        hover_on_an_unproven_load_names_the_wide_type() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            prime(analyser, ["unproven.ghul"]);

            analyser.send_hover("unproven.ghul", 19, 33);
            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            let signature = response.signature ?? "";

            Assert.is_true(
                signature.contains("not proven here") /\ signature.contains("INNER?"),
                "expected the hover to say the narrowing is not proven and name INNER?, got '{signature}'"
                "\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Hover on the same load over the discharged call says
        // nothing extra: a proven narrowing reads as it always did.
        hover_on_a_proven_load_carries_no_note() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            prime(analyser, ["unproven.ghul"]);

            analyser.send_hover("unproven.ghul", 26, 33);
            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            let signature = response.signature ?? "";

            Assert.is_false(
                signature.contains("not proven here"),
                "expected no unproven note for a discharged crossing, got '{signature}'"
            );
        si

        inlay_summary(hints: Collections.Iterable[INLAY_HINT]) -> string is
            let out = System.Text.StringBuilder();

            for h in hints do
                out.append("[{h.line}:{h.label}:{h.detail}]");
            od

            return out.to_string();
        si
    si
si
