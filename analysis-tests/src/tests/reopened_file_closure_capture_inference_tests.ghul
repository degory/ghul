namespace Analysis.Tests is
    use Collections.LIST;
    use Ghul.Pipes;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Opening a file that has already been built drops its expression
    // state, and the next COMPILE walks its bodies again against the
    // closures the first build declared. A local whose type is inferred
    // only from a use inside a closure body must come out the same as it
    // does on the first build.
    @TestClass()
    class REOPENED_FILE_CLOSURE_CAPTURE_INFERENCE_TESTS is
        init() is si

        source() -> string =>
            "namespace ReopenedCapture is\n"
            "    use Collections.LIST;\n"
            "\n"
            "    f() -> int is\n"
            "        let xs = LIST();\n"
            "        let add = (x: int) is xs.add(x); si;\n"
            "        add(1);\n"
            "        return xs.count;\n"
            "    si\n"
            "si\n";

        user_diagnostics_from_compile(analyser: ANALYSER_PROCESS) -> LIST[DIAGNOSTIC] is
            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            return LIST[DIAGNOSTIC](user_diagnostics_of(response));
        si

        describe(diagnostics: Collections.Iterable[DIAGNOSTIC]) -> string =>
            diagnostics |> map(d => "{d.start_line}:{d.start_column} {d.message}") |> join(", ");

        @Test()
        file_opened_after_build__compile_still_infers_type_from_closure_use() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("reopenedcapture.ghul", source());
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_open_files(["reopenedcapture.ghul"]);

            analyser.send_compile();
            let diagnostics = user_diagnostics_from_compile(analyser);

            are_equal(
                0,
                diagnostics.count,
                "opening a built file must not lose a type inferred from a use inside a closure: {describe(diagnostics)}"
            );
        si
    si
si
