namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A `let` ending in `mut` records its extent up to the `mut`. Taken
    // from whatever the parser is looking at once the declaration is
    // parsed, the extent reaches the next line instead, and completion
    // there is answered as one made in the variable's type slot - where
    // locals are filtered out and only types are offered.
    //
    // The fixture is, by line:
    //
    //   6   let counter: int mut     (no terminator)
    //   7                            (blank)
    //   8   counter = 1;
    @TestClass()
    class DECLARATION_EXTENT_COMPLETION_TESTS is
        init() is si

        load() -> string is
            let path = fixture_path("declaration-extent-completion/declaration-extent-completion.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        complete(analyser: ANALYSER_PROCESS, line: int, column: int) -> Collections.SET[string] is
            analyser.send_completion("declaration-extent-completion.ghul", line, column);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            let names = Collections.SET[string]();

            for item in response.items do
                names.add(item.name);
            od

            return names;
        si

        opened() -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS();

            analyser.send_edit("declaration-extent-completion.ghul", load());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            return analyser;
        si

        @Test()
        the_line_after_a_mut_let_offers_the_local_it_declared() is
            let use analyser = opened();

            let names = complete(analyser, 7, 13);

            is_true(
                names.contains("counter"),
                "expected `counter` among the completions on the line after "
                "`let counter: int mut`.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        @Test()
        the_line_after_a_mut_let_is_not_a_type_position() is
            let use analyser = opened();

            let names = complete(analyser, 7, 13);

            is_true(
                names.contains("while"),
                "expected statement keywords on the line after "
                "`let counter: int mut`; a type-position answer drops them.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
