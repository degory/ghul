namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.QUICK_FIX;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Quick fixes are answered by the `code_actions` request, one file
    // over one range: a preferred removal fix for the redundant-operator
    // warnings, and a `@suppress("<code>")` insertion per enclosing scope
    // for every coded diagnostic. The IDE client offers them without any
    // per-code knowledge.
    @TestClass()
    class QUICK_FIX_TESTS is
        init() is si

        _find_by_code(diagnostics: Collections.Iterable[DIAGNOSTIC], code: string) -> DIAGNOSTIC? static is
            for d in diagnostics do
                if d.code? /\ d.code =~ code then
                    return d;
                fi
            od

            return null;
        si

        // Every diagnostic in the file, with its fixes attached. The end
        // line is past any fixture, so the range covers the whole file.
        _code_actions_for_file(analyser: ANALYSER_PROCESS, path: string) -> LIST[DIAGNOSTIC] static is
            analyser.send_code_actions(path, 1, 1, 100_000, 1);

            let response = analyser.read_response();
            assert isa Response.CODE_ACTIONS(response) else "expected CODE_ACTIONS response";

            return LIST[DIAGNOSTIC](response.diagnostics);
        si

        @Test()
        redundant_operator_warnings_carry_removal_then_suppress_fixes() is
            let source = File.read_all_text(fixture_path("quick-fixes/quick-fixes.ghul"));

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("quick-fixes.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            let user = _code_actions_for_file(analyser, "quick-fixes.ghul");

            // `b!` on line 18: the removal fix comes first, marked
            // preferred, deleting the last character of the diagnostic
            // range.
            let unwrap = _find_by_code(user, "redundant-unwrap");
            assert unwrap? else "expected a redundant-unwrap diagnostic\n{diagnostics_summary("got", user)}";

            let fixes = unwrap.fixes;
            assert fixes? /\ fixes.count == 4 else "expected 4 fixes on redundant-unwrap, got {if fixes? then fixes.count.to_string() else "none" fi}";

            let removal = fixes[0];
            are_equal("Remove redundant '!'", removal.title);
            is_true(removal.is_preferred);
            are_equal(1, removal.edits.count);

            let removal_edit = removal.edits[0];
            are_equal(unwrap.end_line, removal_edit.start_line);
            are_equal(unwrap.end_column - 1, removal_edit.start_column);
            are_equal(unwrap.end_column, removal_edit.end_column);
            are_equal("!", removal_edit.replaces);
            are_equal("", removal_edit.new_text);

            // Suppress fixes walk outward: the statement, the enclosing
            // if, the enclosing function — each an insertion at column 1
            // of the anchor's line, indented to match the anchor.
            are_equal("Suppress here: @suppress(\"redundant-unwrap\")", fixes[1].title);
            are_equal("Suppress for enclosing block: @suppress(\"redundant-unwrap\")", fixes[2].title);
            are_equal("Suppress for enclosing method: @suppress(\"redundant-unwrap\")", fixes[3].title);

            is_false(fixes[1].is_preferred);

            let here_edit = fixes[1].edits[0];
            are_equal(18, here_edit.start_line);
            are_equal(1, here_edit.start_column);
            are_equal(18, here_edit.end_line);
            are_equal(1, here_edit.end_column);
            is_false(here_edit.replaces?);
            are_equal("            @suppress(\"redundant-unwrap\")\n", here_edit.new_text);

            are_equal(17, fixes[2].edits[0].start_line);
            are_equal("        @suppress(\"redundant-unwrap\")\n", fixes[2].edits[0].new_text);

            are_equal(14, fixes[3].edits[0].start_line);
            are_equal("    @suppress(\"redundant-unwrap\")\n", fixes[3].edits[0].new_text);

            // `b?` on line 19 gets the same shape with the '?' operator.
            let presence = _find_by_code(user, "redundant-presence-test");
            assert presence? else "expected a redundant-presence-test diagnostic\n{diagnostics_summary("got", user)}";

            let presence_fixes = presence.fixes;
            assert presence_fixes? else "expected fixes on redundant-presence-test";

            are_equal("Remove redundant '?'", presence_fixes[0].title);
            are_equal("?", presence_fixes[0].edits[0].replaces);

            // `b?.label` on line 20: the fix deletes the '?' that follows
            // the receiver `b`, leaving a plain member access.
            let coalesce = _find_by_code(user, "redundant-coalesce");
            assert coalesce? else "expected a redundant-coalesce diagnostic\n{diagnostics_summary("got", user)}";

            let coalesce_fixes = coalesce.fixes;
            assert coalesce_fixes? else "expected fixes on redundant-coalesce";

            let coalesce_removal = coalesce_fixes[0];
            are_equal("Replace '?.' with '.'", coalesce_removal.title);
            is_true(coalesce_removal.is_preferred);

            let coalesce_edit = coalesce_removal.edits[0];
            are_equal(20, coalesce_edit.start_line);
            are_equal(33, coalesce_edit.start_column);
            are_equal(20, coalesce_edit.end_line);
            are_equal(34, coalesce_edit.end_column);
            are_equal("?", coalesce_edit.replaces);
            are_equal("", coalesce_edit.new_text);
        si

        @Test()
        coded_diagnostic_without_removal_gets_suppress_fixes_only() is
            let source = File.read_all_text(fixture_path("diagnostic-code/diagnostic-code.ghul"));

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("diagnostic-code.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            let user = _code_actions_for_file(analyser, "diagnostic-code.ghul");

            let coded = _find_by_code(user, "non-exception-throw");
            assert coded? else "expected a non-exception-throw diagnostic\n{diagnostics_summary("got", user)}";

            let fixes = coded.fixes;
            assert fixes? /\ fixes.count > 0 else "expected suppress fixes on non-exception-throw";

            for fix in fixes do
                is_false(fix.is_preferred);
            od

            is_true(
                fixes[0].title =~ "Suppress here: @suppress(\"non-exception-throw\")",
                "unexpected first fix title: {fixes[0].title}"
            );
        si

        // Synthesizing fixes walks the AST of the whole file, so the edit
        // path must not do it: an editor asks for actions at one position,
        // long after the compile that reported the squiggle.
        @Test()
        reported_diagnostics_carry_no_fixes() is
            let source = File.read_all_text(fixture_path("quick-fixes/quick-fixes.ghul"));

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("quick-fixes.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            for d in user_diagnostics_of(response) do
                is_false(d.fixes?, "diagnostic carries fixes: {d}");
            od
        si

        // Only the diagnostics the requested range touches come back, so
        // the cost of a code-action gesture does not scale with how many
        // warnings the file has.
        @Test()
        code_actions_are_scoped_to_the_requested_range() is
            let source = File.read_all_text(fixture_path("quick-fixes/quick-fixes.ghul"));

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("quick-fixes.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            let whole_file = _code_actions_for_file(analyser, "quick-fixes.ghul");

            let unwrap = _find_by_code(whole_file, "redundant-unwrap");
            assert unwrap? else "expected a redundant-unwrap diagnostic";

            // A bare cursor inside the unwrap's own range.
            analyser.send_code_actions(
                "quick-fixes.ghul",
                unwrap.start_line, unwrap.start_column,
                unwrap.start_line, unwrap.start_column
            );

            let at_cursor = analyser.read_response();
            assert isa Response.CODE_ACTIONS(at_cursor) else "expected CODE_ACTIONS response";

            let scoped = LIST[DIAGNOSTIC](at_cursor.diagnostics);

            is_true(scoped.count < whole_file.count, "range did not narrow the result");
            is_true(_find_by_code(scoped, "redundant-unwrap")?, "expected the diagnostic under the cursor");
            is_false(_find_by_code(scoped, "redundant-coalesce")?, "expected no diagnostic from another line");
        si

        // A range with nothing in it still answers, so a client can tell
        // "no actions here" from "the analyser did not reply".
        @Test()
        empty_range_answers_with_no_diagnostics() is
            let source = File.read_all_text(fixture_path("quick-fixes/quick-fixes.ghul"));

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("quick-fixes.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            analyser.send_code_actions("quick-fixes.ghul", 1, 1, 1, 1);

            let at_top = analyser.read_response();
            assert isa Response.CODE_ACTIONS(at_top) else "expected CODE_ACTIONS response";

            are_equal(0, at_top.diagnostics.count);
        si
    si
si
