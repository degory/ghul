namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A discard local ("let (_, _, z) = t;") is declared under a
    // compiler-picked "$discard_N" name. It must not surface as a scope
    // completion candidate the way an ordinary local would.
    @TestClass()
    class DISCARD_COMPLETION_TESTS is
        init() is si

        load() -> string is
            let path = fixture_path("discard-completion/discard-completion.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        has_completion(response: Response.COMPLETION, name: string) -> bool is
            for item in response.items do
                if item.name.starts_with(name) then
                    return true;
                fi
            od

            return false;
        si

        // Line 5 (blank, indented) is right after the discard destructure
        // on line 4; column 9 is inside the indentation, in scope for
        // every local declared above it including the synthesised
        // discard slots.
        @Test()
        discard_locals_are_not_offered_as_completions() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("discard-completion.ghul", load());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            analyser.send_completion("discard-completion.ghul", 5, 9);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            is_false(
                has_completion(response, "$discard"),
                "a discard local's synthesised name should not be offered as a "
                "completion candidate.\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            is_true(
                has_completion(response, "t"),
                "expected the ordinary local `t` among scope completions.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
