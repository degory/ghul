namespace Analysis.Tests is
    use IO.File;
    use IO.Path;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // SIGNATURE coverage for indexer expressions. The callee is the read
    // accessor of the left operand's type rather than a named function, so
    // the response is derived from a different path to a plain call, and
    // covers ghūl-declared indexers and imported .NET ones alike.
    //
    // The response carries best_signature_index, current_parameter_index
    // and a list of signatures - see SIGNATURE_HANDLER.
    @TestClass()
    class INDEXER_SIGNATURE_TESTS is
        init() is si

        load() -> string is
            let path = Path.combine(fixture_dir("indexer-signature"), "main.ghul");
            assert File.exists(path) else "fixture missing: {path}";
            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit_files([EDIT_FILE("main.ghul", source)]);
            analyser.read_response();
            analyser.send_edit("main.ghul", source);
            analyser.read_response();
        si

        signature_at(analyser: ANALYSER_PROCESS, line: int, column: int) -> Response.SIGNATURE is
            analyser.send_signature("main.ghul", line, column);

            let response = analyser.read_query_response();
            assert isa Response.SIGNATURE(response) else "expected SIGNATURE response";

            return response;
        si

        // `let a = grid[0];` - the cursor is between the brackets of an
        // indexer declared in ghūl source.
        @Test()
        indexer_on_ghul_declared_type_shows_signature() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            let inside = signature_at(analyser, 20, 22);

            is_true(
                inside.signatures.count >= 1,
                "no signature returned for a ghūl-declared indexer"
            );

            // The accessor's CLR name is not spellable in ghūl, so the
            // label takes the indexer's own shape.
            is_true(
                inside.signatures[0].label.starts_with("GRID["),
                "expected a GRID[...] indexer signature, got: {inside.signatures[0].label}"
            );

            is_false(
                inside.signatures[0].label.contains("get_Item"),
                "signature leaked the CLR accessor name: {inside.signatures[0].label}"
            );
        si

        // `let b = list[1];` - the same query against an imported .NET
        // indexer, which reaches the accessor through reflected metadata.
        @Test()
        indexer_on_imported_type_shows_signature() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            let inside = signature_at(analyser, 21, 22);

            is_true(
                inside.signatures.count >= 1,
                "no signature returned for an imported indexer"
            );
        si

        // `let c = map["key"];` - an indexer whose parameter is not an int,
        // so a signature that ignored the argument type would still look
        // plausible here.
        @Test()
        indexer_with_string_argument_shows_signature() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            let inside = signature_at(analyser, 22, 22);

            is_true(
                inside.signatures.count >= 1,
                "no signature returned for a string-keyed indexer"
            );
        si

        // The cursor on the left operand rather than between the brackets
        // is not inside the indexer, and must not draw its signature: the
        // guard that rejects it is what stops `grid` reporting help for
        // something the cursor is not in.
        @Test()
        cursor_on_left_operand_returns_no_indexer_signature() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            let on_left = signature_at(analyser, 20, 18);

            are_equal(
                0,
                on_left.signatures.count,
                "expected no signature with the cursor on the left operand"
            );
        si
    si
si
