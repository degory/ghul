namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A method hiding an inherited trait property names the hidden
    // declaration in prose only ("hides HasPropertyTest.test: int") - the
    // wire DTO should also carry it as a structured related location an
    // editor can jump to. See symbol_inheritance_resolver.ghul (the
    // hides-inherited family) and diagnostics_store.ghul (the carrier)
    // for the mechanism.
    @TestClass()
    class DIAGNOSTIC_RELATED_LOCATION_TESTS is
        init() is si

        @Test()
        hides_inherited_carries_related_location_on_the_wire() is
            let source = File.read_all_text(fixture_path("related-location/related-location.ghul"));

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit("related-location.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";

            let user = LIST[DIAGNOSTIC](user_diagnostics_of(response));

            let found: DIAGNOSTIC? mut = null;

            for d in user do
                if d.code? /\ d.code =~ "hides-inherited" then
                    found = d;
                fi
            od

            assert found? else
                "expected a diagnostic with code 'hides-inherited'\n"
                "{diagnostics_summary("got", user)}";

            let hides = found!;

            assert hides.related? /\ hides.related!.count > 0 else
                "expected the hides-inherited diagnostic to carry a related location\n"
                "{diagnostics_summary("got", user)}";

            let related = hides.related![0];

            is_true(
                related.message.length > 0,
                "expected the related location to carry a non-empty message"
            );

            is_true(
                related.location.start_line > 0,
                "expected the related location to point at a real position"
            );
        si
    si
si
