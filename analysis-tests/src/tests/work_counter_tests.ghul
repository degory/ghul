namespace Analysis.Tests is
    use Collections.Iterable;
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // The work counters themselves: that each family reports the walk it
    // names, and that the three EDIT dispositions are distinguishable from
    // the counters alone.
    //
    // These are the tests the rest of the incremental suite leans on. Every
    // other incremental test asserts its own path through `assert_work`;
    // if the counters were wrong, all of those assertions would be wrong
    // together and silently. So this class checks the instrument, against
    // edits whose disposition is obvious by construction.
    class WORK_COUNTER_TESTS is
        @test()

        init() is si

        baseline() -> string =>
            "namespace WorkCount is\n"
            "    class HOLDER is\n"
            "        init() is si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 1;\n"
            "        si\n"
            "    si\n"
            "si\n";

        // Body-only change: same declaration set, same signatures.
        body_edited() -> string =>
            "namespace WorkCount is\n"
            "    class HOLDER is\n"
            "        init() is si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 2;\n"
            "        si\n"
            "    si\n"
            "si\n";

        // A method appended to the class: interface-affecting, and of the
        // shape the incremental interface path handles.
        member_appended() -> string =>
            "namespace WorkCount is\n"
            "    class HOLDER is\n"
            "        init() is si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 2;\n"
            "        si\n"
            "\n"
            "        beta() -> int is\n"
            "            return 3;\n"
            "        si\n"
            "    si\n"
            "si\n";

        // An interface-preserving edit must take the body re-walk: the
        // edited file's bodies are re-walked, and no file is taken through
        // a whole-file pass.
        a_body_edit_re_walks_bodies_and_runs_no_whole_file_pass() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "work.ghul", baseline());

            assert_work(
                analyser,
                "a body-only edit",
                [
                    exactly(EDIT_PATH_BODY_REWALK, 1),
                    exactly(EDIT_PATH_INTERFACE_INCREMENTAL, 0),
                    exactly(EDIT_PATH_FULL_REBUILD, 0),
                    exactly(file_rewalk("compile-expressions"), 1),
                    at_most(file_pass("compile-expressions"), 0),
                    at_most(file_pass("declare-symbols"), 0)
                ],
                () is
                    edit_and_drain(analyser, "work.ghul", body_edited());
                si
            );
        si

        // The first EDIT has no retained parse to splice onto, so it takes
        // the whole-project rebuild and every file goes through the build
        // loop. This is the counter reading the other tests are asserting
        // the *absence* of, so it is worth pinning directly.
        the_first_edit_takes_the_full_rebuild_and_runs_whole_file_passes() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            assert_work(
                analyser,
                "the first edit",
                [
                    exactly(EDIT_PATH_FULL_REBUILD, 1),
                    exactly(EDIT_PATH_BODY_REWALK, 0),
                    exactly(EDIT_PATH_INTERFACE_INCREMENTAL, 0),
                    exactly(file_pass("declare-symbols"), 1),
                    exactly(file_pass("compile-expressions"), 1),
                    at_most(file_rewalk("compile-expressions"), 0)
                ],
                () is
                    edit_and_drain(analyser, "work.ghul", baseline());
                si
            );
        si

        // Appending a member is interface-affecting, so it takes the
        // incremental interface path: the appended subtree is built in
        // place, and no file is taken through a whole-file pass.
        appending_a_member_builds_a_subtree_and_runs_no_whole_file_pass() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "work.ghul", baseline());
            edit_and_drain(analyser, "work.ghul", body_edited());

            assert_work(
                analyser,
                "appending a member",
                [
                    exactly(EDIT_PATH_INTERFACE_INCREMENTAL, 1),
                    exactly(EDIT_PATH_FULL_REBUILD, 0),
                    exactly(subtree_pass("declare-members"), 1),
                    exactly(subtree_pass("compile-expressions"), 1),
                    at_most(file_pass("declare-symbols"), 0)
                ],
                () is
                    edit_and_drain(analyser, "work.ghul", member_appended());
                si
            );
        si

        edit_and_drain(analyser: ANALYSER_PROCESS, path: string, source: string) is
            analyser.send_edit(path, source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response after EDIT";
        si
    si
si
