namespace Analysis.Tests is
    use Collections.Iterable;
    use Collections.LIST;
    use Collections.MutableMap;

    use System.Text.StringBuilder;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // How each kind of edit is dispatched, across each kind of type and
    // each kind of member.
    //
    // The individual path and decline tests pin one shape each. This is
    // the sweep: the same handful of edit kinds - change a body, change a
    // signature, add a member, remove a member - applied to a class, a
    // struct, a trait, a union, an enum and a namespace's globals, and to
    // methods, properties and constructors within them.
    //
    // Its value is twofold. It pins the incremental coverage we have, so
    // a change that narrows it fails here rather than silently costing
    // latency. And the table is the evidence for where to widen coverage
    // next: every `full-rebuild:` row is an edit a person makes that
    // currently pays for a whole-project rebuild.
    //
    // Each expected value was read off the analyser, not predicted. When
    // a cell changes, check whether the new disposition is better or
    // worse before updating it - a cell moving from an incremental path
    // to full-rebuild is a regression, the reverse is progress.
    class EDIT_MATRIX_TESTS is
        @test()

        init() is si

        // -- class ------------------------------------------------------

        class_baseline() -> string =>
            "namespace MatrixClass is\n"
            "    class HOLDER is\n"
            "        _count: int;\n"
            "\n"
            "        init() is _count = 0; si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 1;\n"
            "        si\n"
            "\n"
            "        total: int => _count;\n"
            "    si\n"
            "si\n";

        class_method_body_changed() -> string =>
            class_baseline().replace("return 1;", "return 11;");

        class_method_signature_changed() -> string =>
            class_baseline().replace("alpha() -> int is", "alpha(n: int) -> int is");

        class_method_appended() -> string =>
            class_baseline().replace(
                "        total: int => _count;\n",
                "        total: int => _count;\n"
                "\n"
                "        beta() -> int is\n"
                "            return 2;\n"
                "        si\n"
            );

        class_method_deleted() -> string =>
            class_baseline().replace(
                "        alpha() -> int is\n"
                "            return 1;\n"
                "        si\n"
                "\n",
                ""
            );

        class_property_body_changed() -> string =>
            class_baseline().replace("total: int => _count;", "total: int => _count + 1;");

        class_property_type_changed() -> string =>
            class_baseline().replace("total: int => _count;", "total: long => 0L;");

        class_property_appended() -> string =>
            class_baseline().replace(
                "        total: int => _count;\n",
                "        total: int => _count;\n"
                "\n"
                "        doubled: int => _count * 2;\n"
            );

        class_constructor_body_changed() -> string =>
            class_baseline().replace("init() is _count = 0; si", "init() is _count = 5; si");

        class_constructor_signature_changed() -> string =>
            class_baseline().replace("init() is _count = 0; si", "init(n: int) is _count = n; si");

        class_field_type_changed() -> string =>
            class_baseline().replace("_count: int;", "_count: long;");

        // -- struct -----------------------------------------------------

        struct_baseline() -> string =>
            "namespace MatrixStruct is\n"
            "    struct POINT is\n"
            "        x: int;\n"
            "\n"
            "        init(x: int) is self.x = x; si\n"
            "\n"
            "        doubled() -> int is\n"
            "            return x * 2;\n"
            "        si\n"
            "    si\n"
            "si\n";

        struct_method_body_changed() -> string =>
            struct_baseline().replace("return x * 2;", "return x * 3;");

        struct_method_signature_changed() -> string =>
            struct_baseline().replace("doubled() -> int is", "doubled(n: int) -> int is");

        struct_method_appended() -> string =>
            struct_baseline().replace(
                "        doubled() -> int is\n"
                "            return x * 2;\n"
                "        si\n",
                "        doubled() -> int is\n"
                "            return x * 2;\n"
                "        si\n"
                "\n"
                "        tripled() -> int is\n"
                "            return x * 3;\n"
                "        si\n"
            );

        // -- trait ------------------------------------------------------

        trait_baseline() -> string =>
            "namespace MatrixTrait is\n"
            "    trait Describable is\n"
            "        label() -> int => 1;\n"
            "\n"
            "        describe() -> int is\n"
            "            return label();\n"
            "        si\n"
            "    si\n"
            "si\n";

        trait_default_body_changed() -> string =>
            trait_baseline().replace("return label();", "return label() + 1;");

        trait_default_signature_changed() -> string =>
            trait_baseline().replace("describe() -> int is", "describe(n: int) -> int is");

        trait_member_appended() -> string =>
            trait_baseline().replace(
                "        describe() -> int is\n"
                "            return label();\n"
                "        si\n",
                "        describe() -> int is\n"
                "            return label();\n"
                "        si\n"
                "\n"
                "        extra() -> int => 2;\n"
            );

        // -- union ------------------------------------------------------

        union_baseline() -> string =>
            "namespace MatrixUnion is\n"
            "    union Shape is\n"
            "        CIRCLE(radius: int);\n"
            "        SQUARE(side: int);\n"
            "    si\n"
            "si\n";

        union_variant_appended() -> string =>
            union_baseline().replace(
                "        SQUARE(side: int);\n",
                "        SQUARE(side: int);\n"
                "        POINT;\n"
            );

        union_variant_deleted() -> string =>
            union_baseline().replace("        SQUARE(side: int);\n", "");

        union_variant_field_changed() -> string =>
            union_baseline().replace("SQUARE(side: int);", "SQUARE(side: long);");

        // -- enum -------------------------------------------------------

        enum_baseline() -> string =>
            "namespace MatrixEnum is\n"
            "    enum Colour is\n"
            "        RED,\n"
            "        GREEN,\n"
            "    si\n"
            "si\n";

        enum_member_appended() -> string =>
            enum_baseline().replace("        GREEN,\n", "        GREEN,\n        BLUE,\n");

        enum_member_deleted() -> string =>
            enum_baseline().replace("        GREEN,\n", "");

        // -- namespace globals ------------------------------------------

        global_baseline() -> string =>
            "namespace MatrixGlobal is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        global_body_changed() -> string =>
            global_baseline().replace("return 1;", "return 11;");

        global_signature_changed() -> string =>
            global_baseline().replace("alpha() -> int is", "alpha(n: int) -> int is");

        global_appended() -> string =>
            global_baseline().replace(
                "    beta() -> int is\n"
                "        return 2;\n"
                "    si\n",
                "    beta() -> int is\n"
                "        return 2;\n"
                "    si\n"
                "\n"
                "    gamma() -> int is\n"
                "        return 3;\n"
                "    si\n"
            );

        global_deleted() -> string =>
            global_baseline().replace(
                "\n"
                "    beta() -> int is\n"
                "        return 2;\n"
                "    si\n",
                ""
            );

        // -- the matrix -------------------------------------------------

        class_edits: Iterable[MATRIX_CASE] =>
            [
                CASE("method body", class_baseline(), class_method_body_changed(), "body-rewalk"),
                CASE("method signature", class_baseline(), class_method_signature_changed(), "interface-incremental"),
                CASE("method appended", class_baseline(), class_method_appended(), "interface-incremental"),
                CASE("method deleted", class_baseline(), class_method_deleted(), "interface-incremental"),
                CASE("property body", class_baseline(), class_property_body_changed(), "body-rewalk"),
                CASE("property type", class_baseline(), class_property_type_changed(), "full-rebuild:outgoing-not-a-function"),
                CASE("property appended", class_baseline(), class_property_appended(), "full-rebuild:incoming-not-a-function"),
                CASE("constructor body", class_baseline(), class_constructor_body_changed(), "body-rewalk"),
                CASE("constructor signature", class_baseline(), class_constructor_signature_changed(), "interface-incremental"),
                CASE("field type", class_baseline(), class_field_type_changed(), "full-rebuild:outgoing-not-a-function")
            ];

        // Every interface edit to a struct, trait, union or enum rebuilds
        // the project. The narrowing search descends into namespaces and
        // classes only - it tests for `Definitions.CLASS`, where
        // `Definitions.Classy` is the base the other four share - so the
        // edit falls straight through to replacing the type in its
        // namespace's member list, where it is not a function. Body edits
        // are unaffected, being interface-preserving whatever contains
        // them.
        //
        // These are the rows worth acting on: the guard is not protecting
        // an invariant here, it simply never looked at these types.

        struct_edits: Iterable[MATRIX_CASE] =>
            [
                CASE("method body", struct_baseline(), struct_method_body_changed(), "body-rewalk"),
                CASE("method signature", struct_baseline(), struct_method_signature_changed(), "full-rebuild:outgoing-not-a-function"),
                CASE("method appended", struct_baseline(), struct_method_appended(), "full-rebuild:outgoing-not-a-function")
            ];

        trait_edits: Iterable[MATRIX_CASE] =>
            [
                CASE("default body", trait_baseline(), trait_default_body_changed(), "body-rewalk"),
                CASE("default signature", trait_baseline(), trait_default_signature_changed(), "full-rebuild:outgoing-not-a-function"),
                CASE("member appended", trait_baseline(), trait_member_appended(), "full-rebuild:outgoing-not-a-function")
            ];

        union_edits: Iterable[MATRIX_CASE] =>
            [
                CASE("variant appended", union_baseline(), union_variant_appended(), "full-rebuild:outgoing-not-a-function"),
                CASE("variant deleted", union_baseline(), union_variant_deleted(), "full-rebuild:outgoing-not-a-function"),
                CASE("variant field type", union_baseline(), union_variant_field_changed(), "full-rebuild:outgoing-not-a-function")
            ];

        enum_edits: Iterable[MATRIX_CASE] =>
            [
                CASE("member appended", enum_baseline(), enum_member_appended(), "full-rebuild:outgoing-not-a-function"),
                CASE("member deleted", enum_baseline(), enum_member_deleted(), "full-rebuild:outgoing-not-a-function")
            ];

        global_edits: Iterable[MATRIX_CASE] =>
            [
                CASE("body", global_baseline(), global_body_changed(), "body-rewalk"),
                CASE("signature", global_baseline(), global_signature_changed(), "interface-incremental"),
                CASE("appended", global_baseline(), global_appended(), "interface-incremental"),
                CASE("deleted", global_baseline(), global_deleted(), "interface-incremental")
            ];

        edits_to_a_class_are_dispatched_as_expected() is
            @test()

            assert_matrix("class", class_edits);
        si

        edits_to_a_struct_are_dispatched_as_expected() is
            @test()

            assert_matrix("struct", struct_edits);
        si

        edits_to_a_trait_are_dispatched_as_expected() is
            @test()

            assert_matrix("trait", trait_edits);
        si

        edits_to_a_union_are_dispatched_as_expected() is
            @test()

            assert_matrix("union", union_edits);
        si

        edits_to_an_enum_are_dispatched_as_expected() is
            @test()

            assert_matrix("enum", enum_edits);
        si

        edits_to_namespace_globals_are_dispatched_as_expected() is
            @test()

            assert_matrix("namespace globals", global_edits);
        si

        // Run every case and report all mismatching cells at once: fixing
        // them one failure per run would be several rebuilds of the suite
        // to learn one table.
        assert_matrix(kind: string, cases: Iterable[MATRIX_CASE]) is
            let failures = LIST[string]();

            for matrix_case in cases do
                let actual = disposition(matrix_case.baseline, matrix_case.edited);

                if actual !~ matrix_case.expected then
                    failures.add(
                        "  {kind} / {matrix_case.description}: expected {matrix_case.expected}, got {actual}"
                    );
                fi
            od

            if failures.count == 0 then
                return;
            fi

            let message = StringBuilder();

            message.append("edit dispositions changed:\n");

            for failure in failures do
                message.append(failure).append('\n');
            od

            message.append(
                "\nA cell moving to full-rebuild is a regression in incremental "
                "coverage. A cell moving off it is progress - update the table."
            );

            Assert.fail(message.to_string());
        si

        // Prime an analyser with `baseline`, apply `edited`, and name how
        // the second edit was handled: the incremental path that took it,
        // or the rebuild together with the guard that caused it.
        disposition(baseline_source: string, edited_source: string) -> string is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "matrix.ghul", baseline_source);

            let before = analyser.stat_counts();

            edit_and_drain(analyser, "matrix.ghul", edited_source);

            let after = analyser.stat_counts();

            if _moved(before, after, EDIT_PATH_BODY_REWALK) then
                return "body-rewalk";
            fi

            if _moved(before, after, EDIT_PATH_INTERFACE_INCREMENTAL) then
                return "interface-incremental";
            fi

            if !_moved(before, after, EDIT_PATH_FULL_REBUILD) then
                return "no-edit-path-reported";
            fi

            for name in after.keys do
                if name.starts_with("edit-declined-") /\ _moved(before, after, name) then
                    return "full-rebuild:{name.substring("edit-declined-".length)}";
                fi
            od

            return "full-rebuild:no-reason-reported";
        si

        _moved(before: MutableMap[string,int], after: MutableMap[string,int], name: string) -> bool =>
            _at(after, name) > _at(before, name);

        _at(counts: MutableMap[string,int], name: string) -> int =>
            if counts.contains_key(name) then counts[name] else 0 fi;

        edit_and_drain(analyser: ANALYSER_PROCESS, path: string, source: string) is
            analyser.send_edit(path, source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response after EDIT";
        si
    si

    // One cell: an edit applied to a baseline, and how it should be
    // dispatched.
    struct MATRIX_CASE(description: string, baseline: string, edited: string, expected: string);

    CASE(description: string, baseline: string, edited: string, expected: string) -> MATRIX_CASE =>
        MATRIX_CASE(description, baseline, edited, expected);
si
