namespace Analysis.Tests is
    use IO.File;
    use IO.Path;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // SIGNATURE coverage for the argument the cursor sits in.
    //
    // A `|>` call carries its subject as the first actual argument even
    // though the subject is written to the left of the call, so the
    // parameter the cursor is in is one further along than the written
    // arguments alone suggest. The plain-call cases are the paired
    // control: the same fixture, the same function, no threading.
    @TestClass()
    class THREAD_FIRST_SIGNATURE_TESTS is
        init() is si

        load() -> string is
            let path = Path.combine(fixture_dir("thread-first-signature"), "main.ghul");
            assert File.exists(path) else "fixture missing: {path}";
            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit_files([EDIT_FILE("main.ghul", source)]);
            analyser.read_response();
            analyser.send_edit("main.ghul", source);
            analyser.read_response();
        si

        signature_at(analyser: ANALYSER_PROCESS, line: int, column: int) -> Response.SIGNATURE is
            analyser.send_signature("main.ghul", line, column);

            let response = analyser.read_query_response();
            assert isa Response.SIGNATURE(response) else "expected SIGNATURE response";

            return response;
        si

        assert_scale_signature(response: Response.SIGNATURE, where: string) is
            is_true(response.signatures.count >= 1, "no signature returned at {where}");

            let signature = response.signatures[0];

            are_equal(
                "scale(value: int, factor: int, offset: int) -> int",
                signature.label,
                "unexpected label at {where}"
            );

            are_equal(3, signature.parameters.count, "expected three parameters at {where}");
            are_equal("value: int", signature.parameters[0]);
            are_equal("factor: int", signature.parameters[1]);
            are_equal("offset: int", signature.parameters[2]);
        si

        @Test()
        thread_first_call_counts_the_subject_as_the_first_parameter() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // `3 |> scale(4, 5)` — 4 is written first but fills `factor`
            let first_written = signature_at(analyser, 5, 35);
            assert_scale_signature(first_written, "first written argument");
            are_equal(1, first_written.current_parameter_index, "expected current parameter 1");

            // `5` fills `offset`
            let second_written = signature_at(analyser, 5, 38);
            are_equal(2, second_written.current_parameter_index, "expected current parameter 2");
        si

        @Test()
        thread_first_call_with_no_written_arguments_starts_at_the_second_parameter() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // `3 |> scale()` with the cursor between the parentheses
            let response = signature_at(analyser, 6, 32);
            assert_scale_signature(response, "empty thread-first argument list");
            are_equal(1, response.current_parameter_index, "expected current parameter 1");
        si

        @Test()
        chained_thread_first_calls_track_their_own_arguments() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // `3 |> scale(4, 5) |> scale(6, 7)` — 4 is the first stage's `factor`
            let first_stage = signature_at(analyser, 9, 34);
            are_equal(1, first_stage.current_parameter_index, "expected current parameter 1 in the first stage");

            // 6 is the second stage's `factor`, 7 its `offset`
            let second_stage = signature_at(analyser, 9, 49);
            assert_scale_signature(second_stage, "second stage of the chain");
            are_equal(1, second_stage.current_parameter_index, "expected current parameter 1 in the second stage");

            let second_stage_last = signature_at(analyser, 9, 52);
            are_equal(2, second_stage_last.current_parameter_index, "expected current parameter 2 in the second stage");
        si

        @Test()
        plain_call_tracks_the_written_arguments() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // `scale(3, 4, 5)`
            let first = signature_at(analyser, 7, 27);
            assert_scale_signature(first, "first argument");
            are_equal(0, first.current_parameter_index, "expected current parameter 0");

            let second = signature_at(analyser, 7, 30);
            are_equal(1, second.current_parameter_index, "expected current parameter 1");

            let third = signature_at(analyser, 7, 33);
            are_equal(2, third.current_parameter_index, "expected current parameter 2");
        si

        @Test()
        trailing_comma_opens_the_next_parameter() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // `scale(3,)` — the closing parenthesis is already in place, so
            // the slot after the comma holds no argument to locate by
            let plain_argument = signature_at(analyser, 10, 33);
            assert_scale_signature(plain_argument, "argument before a trailing comma");
            are_equal(0, plain_argument.current_parameter_index, "expected current parameter 0");

            let plain_slot = signature_at(analyser, 10, 35);
            are_equal(1, plain_slot.current_parameter_index, "expected current parameter 1");

            // `3 |> scale(4,)` — the same slot, one further along again
            let threaded_argument = signature_at(analyser, 11, 41);
            are_equal(1, threaded_argument.current_parameter_index, "expected current parameter 1");

            let threaded_slot = signature_at(analyser, 11, 43);
            assert_scale_signature(threaded_slot, "thread-first slot after a trailing comma");
            are_equal(2, threaded_slot.current_parameter_index, "expected current parameter 2");
        si

        @Test()
        plain_call_with_no_written_arguments_starts_at_the_first_parameter() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load());

            // `scale()` with the cursor between the parentheses
            let response = signature_at(analyser, 8, 33);
            assert_scale_signature(response, "empty argument list");
            are_equal(0, response.current_parameter_index, "expected current parameter 0");
        si
    si
si
