namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;
    use Analysis.Protocol.SEMANTIC_TOKEN;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    // An interface-preserving edit keeps the retained tree and copies the
    // fresh parse's locations onto it, translating the analyser's location
    // side tables through the same correspondence. A location the walk never
    // reaches is never translated, and the use recorded there keeps its
    // pre-edit position for as long as the retained tree lives - so the
    // colouring stops tracking the text and no later compile puts it right.
    //
    // The two that are easy to miss are a qualified name's rightmost segment,
    // which is where the use of the name it resolves to is recorded, and the
    // identifier a generic type expression holds, which that type expression
    // does not walk.
    class INCREMENTAL_LOCATION_RECONCILE_TESTS is
        @test()

        init() is si

        baseline() -> string =>
            "namespace Probe is\n"
            "    use IO.Std.write_line;\n"
            "\n"
            "    process(xs: Collections.LIST[int]) is\n"
            "        write_line(\"{{xs.count}}\");\n"
            "    si\n"
            "si\n";

        // One blank line at the top: every line below moves down by one, and
        // nothing else about the file changes.
        shifted() -> string =>
            "\n{baseline()}";

        edit(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("reconcile.ghul", source);

            let response = analyser.read_response();
            assert isa Response.DIAGNOSTICS(response) else "expected DIAGNOSTICS response";
        si

        tokens(analyser: ANALYSER_PROCESS) -> LIST[SEMANTIC_TOKEN] is
            analyser.send_semantic_tokens("reconcile.ghul");

            let response = analyser.read_query_response();
            assert isa Response.SEMANTIC_TOKENS(response) else "expected SEMANTIC_TOKENS response";

            return LIST[SEMANTIC_TOKEN](response.tokens);
        si

        describe(tokens: LIST[SEMANTIC_TOKEN]) -> string is
            let parts = LIST[string]();

            for token in tokens do
                parts.add("{token.start_line},{token.start_column} {token.token_type}");
            od

            return Ghul.Pipes.pipe(parts) |> Ghul.Pipes.join("; ");
        si

        every_token_moves_with_the_text_it_marks() is
            @test()

            let use analyser = ANALYSER_PROCESS();

            edit(analyser, baseline());

            let before = tokens(analyser);

            Assert.is_true(before.count > 0, "the file produced no tokens at all");

            edit(analyser, shifted());

            let after = tokens(analyser);

            Assert.are_equal(
                before.count,
                after.count,
                "inserting a blank line changed how many tokens the file has:\n"
                "  before: {describe(before)}\n"
                "  after:  {describe(after)}"
            );

            // Same tokens, same columns, every line one lower.
            for i in 0..before.count do
                Assert.are_equal(
                    before[i].start_line + 1,
                    after[i].start_line,
                    "token {i} ({before[i].token_type} at column {before[i].start_column}) "
                    "did not move with the text:\n"
                    "  before: {describe(before)}\n"
                    "  after:  {describe(after)}"
                );

                Assert.are_equal(
                    before[i].start_column,
                    after[i].start_column,
                    "token {i} changed column"
                );
            od
        si
    si
si
