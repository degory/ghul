// A literal in a generic class that names the class's type parameter
// in a written parameter type is an instance method of the class,
// reaching T as the enclosing instance carries it, not a generic method
// capturing T as a type argument of its own - the same lowering the
// literal gets when the parameter type is left to inference.
namespace Test is
    class BOX[T] is
        _item: T;

        init(item: T) is
            _item = item;
        si

        pair() -> ((T, T)) -> (T, T) is
            @IL.output("il.out")
            let swap = (p: (T, T)) -> (T, T) => (p.`1, p.`0);

            return swap;
        si
    si
si
