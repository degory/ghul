namespace Test is
    use Std = IO.Std;

    sum_to(n: int, acc: int) -> int is
        @IL.output("il.out")
        try
            if n == 0 then
                return acc;
            fi

            return sum_to(n - 1, acc + n);
        finally
            Std.write_line("done");
        yrt
    si

    class MAIN is
        entry() static is
        si
    si
si
