// A capture-free literal at a pack formal inside an instance method is
// resolved over a placeholder walk first, during which its adapter binds
// the receiver, and found capture-free on the final walk. Its delegate is
// memoised in a static cache field; a self-load mark left by the earlier
// walk once kept it an instance method built on every evaluation.
namespace Test is
    union STREAM[T, S] is
        DONE;
        YIELD(value: T, state: S);
    si

    marked_stream[T, S..](initial: S, advance: S.. -> STREAM[T, S]) -> Ghul.Pipes.Pipe[T] is
        let state mut = initial;

        while true do
            let step = advance(state);

            if let y: STREAM.YIELD[T, S] = step then
                yield y.value;
                state = y.state;
            else
                return;
            fi
        od
    si

    class RUNNER is
        init() is si

        run() -> Ghul.Pipes.Pipe[int] is
            @IL.output("il.out")
            let fib = marked_stream((0, 1), (previous, current) => STREAM.YIELD(previous, (current, previous + current)));

            return fib;
        si
    si
si
