namespace Test is
    use Collections;

    // Pins that a chain written as direct qualified calls, with no
    // `|>` and no `use Ghul.Pipes`, is recognised and fused the same
    // way the thread-first spelling is: the emitted code drives the
    // source's own enumerator inline and calls no Ghul.Pipes
    // combinator.
    class FUSION is
        counted(xs: LIST[int]) -> int is
            @IL.output("il.out")
            return Ghul.Pipes.count(Ghul.Pipes.map(xs, n => n * 2));
        si
    si
si
