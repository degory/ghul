namespace Test is
    use Std = IO.Std;

    struct COUNTER is
        n: int;

        init(n: int) is
            self.n = n;
        si

        count_down() -> int is
            if n == 0 then
                return 0;
            fi

            n = n - 1;

            @IL.output("il.out")
            return self.count_down();
        si
    si

    class MAIN is
        entry() static is
        si
    si
si
