// A parenthesised N-ary literal written as the operand of an operator
// whose formal takes an argument pack is packed where it stands, as the
// same literal passed to the call spelling is, rather than compiled N-ary
// and adapted through a hoisted closure frame.
namespace Test is
    >=>[T.., U, V](f: T.. -> U, g: (U) -> V) -> T.. -> V => v => g(f(v))

    inc(n: int) -> int => n + 1

    run() -> int is
        @IL.output("il.out")
        let g = ((a: int, b: int) -> int => a + b * 10) >=> inc

        return g(1, 2)
    si
si
