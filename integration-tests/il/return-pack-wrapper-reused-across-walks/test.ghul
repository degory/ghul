// A body that takes two walks presents each pack-marked return through
// one wrapper closure: the first walk's wrapper is the node's spare and
// the second walk takes it up, so the assembly holds one frame per
// presented call, with no frame left over that nothing references.
namespace Test is
    use Ghul.`>>;

    make() -> (int, int) -> int => (a: int, b: int) -> int => a + b;

    both() -> (int, int) -> string => make() >> (x => "<{x}>");
si
