namespace Test is
    use Collections;
    use Ghul.Pipes;

    // Pins that a fusible chain is recognised and fused. The chain
    // produces the same answer either way, so only the emitted code
    // shows whether fusion fired: a fused chain drives the source's
    // own enumerator inline and calls no Ghul.Pipes combinator, while
    // an unrecognised one calls `map` and `count` and walks the pipe
    // objects they build.
    class FUSION is
        counted(xs: LIST[int]) -> int is
            @IL.output("il.out")
            return xs |> map(n => n * 2) |> count();
        si
    si
si
