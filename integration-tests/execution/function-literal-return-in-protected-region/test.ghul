namespace Test is
    use IO.Std.write_line

    class NOTED: Ghul.Disposable is
        _name: string

        init(name: string) is
            _name = name
        si

        dispose() is
            write_line("disposed {_name}")
        si
    si

    // A literal written before the disposal region, returning from its own
    // body, called from inside the region the function returns from.
    written_before(x: string) -> int is
        let h = () -> int is
            let n = x.length

            return n
        si

        let use d = NOTED("written_before")

        return h()
    si

    // A literal written inside the disposal region, returning early from
    // its own body, while the function also returns from inside it.
    written_inside(x: string) -> int is
        let use d = NOTED("written_inside")

        let h = (s: string) -> int is
            if s.length > 2 then
                return 99
            fi

            return s.length
        si

        write_line("literal gives {h(x)}")

        return h("ab")
    si

    // The same inside an explicit try with a finally.
    written_in_try(x: string) -> int is
        try
            let h = () -> int is
                return x.length
            si

            return h()
        finally
            write_line("finally written_in_try")
        yrt
    si

    entry() is
        write_line("written_before: {written_before("ab")}")
        write_line("written_inside: {written_inside("abcd")}")
        write_line("written_in_try: {written_in_try("abc")}")
    si
si
