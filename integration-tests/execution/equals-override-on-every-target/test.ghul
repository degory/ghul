use IO.Std.write_line

class KEY is
    n: int;
    init(n: int) is self.n = n; si
    equals(other: object?) -> bool => if let k: KEY = other then k.n == n else false fi;
    get_hash_code() -> int => n;
si

class DERIVED_KEY: KEY is
    init(n: int) is super.init(n); si
si

class PLAIN is
    init() is si
si

same[T](a: T, b: T) -> bool => a =~ b

entry() is
    let m = Collections.MAP[KEY, string]()
    m[KEY(1)] = "one"
    let s = Collections.SET[KEY]()
    s.add(KEY(2))
    write_line("{m.contains_key(KEY(1))} {m.contains_key(KEY(9))} {s.contains(KEY(2))} {s.contains(KEY(8))}")

    let d = Collections.SET[DERIVED_KEY]()
    d.add(DERIVED_KEY(4))
    write_line("{d.contains(DERIVED_KEY(4))} {same(DERIVED_KEY(5), DERIVED_KEY(5))} {same(KEY(3), KEY(3))} {same(KEY(3), KEY(4))}")

    let p = PLAIN()
    write_line("{same(p, p)} {same(PLAIN(), PLAIN())}")
si
