namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // `take`/`skip` reached via thread-first fuse the same way map/filter
    // do: a running counter, no TAKE_PIPE/SKIP_PIPE object. Covers each in
    // isolation and combined with a map stage, since the countdown state is
    // a different PIPE_FUSION_STAGE shape from map/filter's transform-or-
    // branch and isn't exercised by the other thread-first tests.

    class Main is
        entry() static is
            let xs = [1, 2, 3, 4, 5, 6];

            for x in xs |> take(3) do
                Std.write_line("take: {x}");
            od

            for x in xs |> skip(4) do
                Std.write_line("skip: {x}");
            od

            for x in xs |> skip(1) |> take(2) do
                Std.write_line("skip-take: {x}");
            od

            for x in xs |> take(4) |> map(n => n * 10) do
                Std.write_line("take-map: {x}");
            od
        si
    si
si
