use IO.Std.write_line

// Tests: a call written with its argument pack spread out fills the
// pack's formal from the trailing arguments. Each is converted to the
// element the pack binds it to, so a value boxes where the element is
// an object, widens where it is optional, and null stands where it may;
// a literal among them takes its parameter types from the pack.

apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)

describe(a: object, b: string?, c: int?) -> string => "{a}/{b ?? "none"}/{c ?? 0}"

entry() is
    write_line(apply(describe, 1, "x", 3))
    write_line(apply(describe, "s", null, null))
    write_line("{apply((a, b) => a * b, 6, 7)}")
    write_line("{apply((a: int, b: int) => a - b, 9, 4)}")
    write_line("{apply((a, b) => "{a}{b}", "p", 2)}")
    write_line("{apply((a, b, c) => a + b + c, 1, 2, 3)}")
    write_line("{apply((a, b) => a + b, (10, 20))}")
si
