use IO.Std.write_line

// An array of tuples holding strings the program computed keeps them alive:
// the array is one the collector scans, so after enough garbage to force
// several collections the strings still read back as they were made.
entry() is
    let count = 1000
    let items = Collections.LIST[(string, int)]()

    for i in 0..count do
        items.add(("item {i}", i))
    od

    let held = items.to_array()

    let filler mut = "x"

    for i in 0..10 do
        filler = "{filler}{filler}"
    od

    let churn mut = 0

    for i in 0..300000 do
        let garbage = "{filler}{i}"
        churn = churn + garbage.length
    od

    let intact mut = 0

    for (name, n) in held do
        if name =~ "item {n}" then
            intact = intact + 1
        fi
    od

    write_line("{intact} of {count} intact after {churn / 1024} KB of garbage")
si
