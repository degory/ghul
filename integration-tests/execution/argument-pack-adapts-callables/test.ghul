namespace Test is
    use IO.Std;

    // Tests: `[T..]` declares that T stands for the arguments of a call,
    // held as a positional tuple, and `f: T.. -> U` says this formal
    // takes them spread out. A function of two or more parameters then
    // goes into that formal - written out, referred to by name, or
    // already destructuring - while `v: T` stays the tuple.

    apply[T.., U](f: T.. -> U, v: T) -> U => f(v);

    concat(a: string, b: string) -> string => "{a}{b}";

    double(n: int) -> int => n * 2;

    class Main is
        entry() static is
            Std.write_line("{apply(double, 123)}");
            Std.write_line(apply(((a, b)) => "{a}{b}", ("x", "y")));
            Std.write_line(apply((a, b) => "{a}{b}", ("x", "y")));
            Std.write_line(apply(concat, ("x", "y")));
            Std.write_line("{apply((a, b, c) => a + b + c, (1, 2, 3))}");
            Std.write_line("{apply((a, b, c, d, e, f, g) => a + b + c + d + e + f + g, (1, 2, 3, 4, 5, 6, 7))}");
            return;
        si
    si
si
