namespace Test is
    use IO.Std;

    // Tests: a type parameter declared `[T..]` takes the arguments of an
    // N-ary call as a positional tuple, so a function of two or more
    // parameters goes into a `T -> U` slot - written out, referred to by
    // name, or already destructuring - and a one-parameter one binds T to
    // its own parameter type as it always did.

    apply[T.., U](f: T -> U, v: T) -> U => f(v);

    concat(a: string, b: string) -> string => "{a}{b}";

    double(n: int) -> int => n * 2;

    class Main is
        entry() static is
            Std.write_line("{apply(double, 123)}");
            Std.write_line(apply(((a, b)) => "{a}{b}", ("x", "y")));
            Std.write_line(apply((a, b) => "{a}{b}", ("x", "y")));
            Std.write_line(apply(concat, ("x", "y")));
            Std.write_line("{apply((a, b, c) => a + b + c, (1, 2, 3))}");
            Std.write_line("{apply((a, b, c, d, e, f, g) => a + b + c + d + e + f + g, (1, 2, 3, 4, 5, 6, 7))}");
            return;
        si
    si
si
