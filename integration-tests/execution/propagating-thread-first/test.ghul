namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    parse_port(s: string) -> int? => if s =~ "8080" then 8080 else null fi;
    clamp_port(n: int) -> int? => if n >= 1 /\ n <= 65535 then n else null fi;
    label(n: int) -> string? => "port {n}";
    tag(n: int) -> string => "[{n}]";

    first_present[T](x: T?, f: (T) -> string) -> string? => x ~> f();

    apply_tagged(n: int?, f: (int) -> string) -> string? => n ~> f();

    tag_async(n: int) -> Tasks.TASK[string] is
        await Tasks.TASK.yield();
        return "[{n}]";
    si

    combine_async(x: int?) -> Tasks.TASK[string?] is
        await Tasks.TASK.yield();
        let t = x ~> tag_async();
        if t? then
            return await t;
        fi
        return null;
    si

    increment(n: int) -> int => n + 1;

    gen(n: int?) -> Pipe[int] is
        let v = n ~> increment();
        if v? then
            yield v;
            yield v * 10;
        fi
    si

    class Main is
        _hit: bool static;

        note(n: int) static is _hit = true; si

        entry() static is
            test_chain();
            test_absent_short_circuits();
            test_widens_non_optional_result();
            test_value_type_subject();
            test_void_callee_skipped();
            test_generic_subject();
            test_function_value_callee();
            test_in_async_body();
            test_in_generator_body();
            test_mixes_with_thread_first();
        si

        // A `~>` chain threads an optional value through calls that
        // take it non-optionally; each stage runs only when the value
        // so far is present.
        test_chain() static is
            let ok = "8080" |> parse_port() ~> clamp_port() ~> label();
            Std.out.write_line("01-present: {ok}");
        si

        // An absent subject skips the call - argument evaluation
        // included - and yields the absent value.
        test_absent_short_circuits() static is
            let bad = "nope" |> parse_port() ~> clamp_port() ~> label();
            Std.out.write_line("02-absent: {if bad? then bad else "<null>" fi}");
        si

        // A callee returning a non-optional `U` is widened to `U?`.
        test_widens_non_optional_result() static is
            let n = parse_port("8080");
            let r = n ~> tag();
            Std.out.write_line("03-widened: {r}");

            let absent: int? = null;
            let r2 = absent ~> tag();
            Std.out.write_line("03-absent: {if r2? then r2 else "<null>" fi}");
        si

        // A value-type optional (Nullable) subject takes the same path.
        test_value_type_subject() static is
            let n: int? mut = null;
            let r = n ~> tag();
            Std.out.write_line("04-absent: {if r? then r else "<null>" fi}");

            let present = parse_port("8080");
            let r2 = present ~> tag();
            Std.out.write_line("04-present: {r2}");
        si

        // A void callee is simply skipped on an absent subject.
        test_void_callee_skipped() static is
            _hit = false;

            let absent: int? = null;
            absent ~> note();
            Std.out.write_line("05-skipped: {_hit}");

            let present: int? = 1;
            present ~> note();
            Std.out.write_line("05-ran: {_hit}");
        si

        // An unconstrained `T?` subject rides the MAYBE carrier.
        test_generic_subject() static is
            Std.out.write_line("06-generic-present: {first_present(4, tag)}");
            Std.out.write_line("06-generic-absent: {if first_present(null, tag)? then "set" else "<null>" fi}");
        si

        // The callee can be a function-typed value rather than a name.
        test_function_value_callee() static is
            Std.out.write_line("07-value-callee: {apply_tagged(9, tag)}");
        si

        test_in_async_body() static is
            Std.out.write_line("08-async-present: {combine_async(21).result}");

            let absent = combine_async(null).result;
            Std.out.write_line("08-async-absent: {if absent? then absent else "<null>" fi}");
        si

        test_in_generator_body() static is
            Std.out.write_line("09-generator-present: {gen(4) |> map(n => "{n}") |> join(",")}");

            let none = gen(null) |> first();
            Std.out.write_line("09-generator-absent: {if none? then "set" else "<null>" fi}");
        si

        // `|>` and `~>` interleave in one chain: the `|>` stage runs
        // unconditionally, the `~>` stages propagate absence.
        test_mixes_with_thread_first() static is
            let r = "8080" |> parse_port() ~> clamp_port() ~> tag() ?? "closed";
            Std.out.write_line("10-mixed-present: {r}");

            let r2 = "nope" |> parse_port() ~> clamp_port() ~> tag() ?? "closed";
            Std.out.write_line("10-mixed-absent: {r2}");
        si
    si
si
