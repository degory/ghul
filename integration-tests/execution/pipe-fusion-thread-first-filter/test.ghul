namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A `for` over a thread-first `filter` chain fuses the same way the
    // `map`-only chain does: `filter` is a fixed global function with no
    // receiver and no virtual dispatch, so the fused loop drives the
    // source's own iterator directly and never builds a FilterPipe.

    class Main is
        entry() static is
            let xs = [1, 2, 3, 4, 5, 6];

            for x in xs |> filter(n => n % 2 == 0) do
                Std.write_line("filtered: {x}");
            od
        si
    si
si
