use default

// A deferred-init local given an else-less if settles optional, and
// coalescing it inside the arm of another if expression joins as the
// coalesced type.
coalesce_block_arm(c: bool) is
    let v mut
    v = if c then (let x = 1; x + 7) fi
    let w = if true then (v ?? 9) else 16 fi
    write_line("block arm {w}")
si

coalesce_literal_arm(c: bool) is
    let v mut
    v = if c then 8 fi
    let w = if true then (v ?? 9) else 16 fi
    write_line("literal arm {w}")
si

coalesce_block_arm(true)
coalesce_block_arm(false)
coalesce_literal_arm(true)
coalesce_literal_arm(false)
