use IO.Std.write_line;

compute(limit: int) -> long is
    let total mut = 0L;

    let step = (n: int) -> long rec is
        if n > limit then
            return total;
        fi

        total = total + cast long(n);
        return rec(n + 1);
    si;

    return step(1);
si

entry() is
    write_line("{compute(2_000_000)}");
si
