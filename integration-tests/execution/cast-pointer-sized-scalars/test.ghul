use IO.Std.write_line;

// `word` and `uword` convert to and from every other scalar. Decimal is
// the one that cannot be reached by a `conv` opcode, so it goes through
// the 64-bit integer of the same signedness.
entry() is
    let w = cast word(-1234);

    write_line("{cast int(w)}");
    write_line("{cast long(w)}");
    write_line("{cast short(w)}");
    write_line("{cast double(w)}");
    write_line("{cast decimal(w)}");
    write_line("{cast word(w)}");

    let u = cast uword(4321);

    write_line("{cast uint(u)}");
    write_line("{cast ulong(u)}");
    write_line("{cast ushort(u)}");
    write_line("{cast decimal(u)}");
    write_line("{cast uword(u)}");

    write_line("{cast word(987.65m)}");
    write_line("{cast uword(987.65m)}");
    write_line("{cast word(55.9D)}");
    write_line("{cast uword('A')}");
si
