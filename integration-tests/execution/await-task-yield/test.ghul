namespace Test is
    use Std = IO.Std;

    // `Tasks.TASK.yield()` returns a `YieldAwaitable`, not a task, and
    // its awaiter is never completed, so the continuation is always
    // registered.
    class Main is
        compute() -> Tasks.TASK[int] static is
            Std.write_line("before");
            await Tasks.TASK.yield();
            Std.write_line("after");
            return 1;
        si

        entry() static is
            Std.write_line("got={compute().result}");
        si
    si
si
