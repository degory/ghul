namespace Test is
    use Std = IO.Std;

    union Box is
        FULL(payload: int);
        EMPTY;
    si

    class Main is
        entry() static is
            Std.write_line(describe(Box.FULL(5)));
            Std.write_line(describe(Box.EMPTY));
        si

        // an ascribed arm narrows the scrutinee itself inside the body,
        // the way `if let f: Box.FULL = b then ... b.payload ...` always
        // has — `b.payload` below needs no separate bound name. The
        // narrow is arm-local: it does not reach the else arm or the
        // code after the `case`.
        describe(b: Box) -> string static is
            case b
            when f: Box.FULL then
                return "full {b.payload}";
            else
                if isa Box.FULL(b) then
                    return "also full";
                fi
                return "empty";
            esac
        si
    si
si
