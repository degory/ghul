use default

// A deferred-init local passed to a generic function taking an
// `Iterable[T]` takes its type from the value assigned to it: the
// formal, still mentioning the callee's own `T`, does not bound it.
sums() is
    let numbers mut
    numbers = [1, 2, 3]
    write_line("count {numbers |> count()}, joined {numbers |> join(",")}")
si

letters() is
    let text mut
    text = "abc"
    write_line("letters {text |> count()}")
si

any_large(c: bool) is
    let values mut
    values = if c then [1, 9] else [2] fi
    write_line("any large {values |> any(x => x > 8)}")
si

sums()
letters()
any_large(true)
any_large(false)
