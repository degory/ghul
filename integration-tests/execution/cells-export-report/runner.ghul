namespace Runner is
    use IO.Std.write_line;
    use System.Reflection.Assembly;

    // The cells beside this file are one session, and the build wrote
    // each cell's exportable names into a .cells.json beside the
    // program. The report is what a host without assemblies to read
    // builds its `use cellK.name` prelude from, so print it whole.
    entry() is
        let location = Assembly.get_executing_assembly().location ?? ""
        let beside = IO.Path.get_directory_name(location) ?? ""
        let reports = IO.Directory.get_files(beside, "*.cells.json")

        for report in reports do
            write_line(IO.File.read_all_text(report).trim())
        od
    si
si
