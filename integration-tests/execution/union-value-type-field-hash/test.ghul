// A union variant holding a bigint, or a key and value pair, hashes and
// compares through its synthesised members, which box the field.
use IO.Std.write_line
use Collections.KEY_VALUE_PAIR
use Collections.SET

union Value is
    INTEGER(value: bigint)
    PAIR(entry: KEY_VALUE_PAIR[string, int])
si

entry() is
    let seen = SET[Value]()

    seen.add(Value.INTEGER(12345678901234567890n))
    seen.add(Value.INTEGER(12345678901234567890n))
    seen.add(Value.INTEGER(7n))
    seen.add(Value.PAIR(KEY_VALUE_PAIR("one", 1)))
    seen.add(Value.PAIR(KEY_VALUE_PAIR("one", 1)))
    seen.add(Value.PAIR(KEY_VALUE_PAIR("two", 2)))

    write_line("{seen.count} distinct")
    write_line("{seen.contains(Value.INTEGER(7n))} {seen.contains(Value.INTEGER(8n))}")
    write_line("{seen.contains(Value.PAIR(KEY_VALUE_PAIR("two", 2)))} {seen.contains(Value.PAIR(KEY_VALUE_PAIR("two", 3)))}")
si
