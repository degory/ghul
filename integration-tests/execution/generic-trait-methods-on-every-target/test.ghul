use IO.Std.write_line

trait Shape[T] is
    value() -> T

    apply[K](f: (T) -> K) -> K => f(value())

    describe[K](f: (T) -> K) -> string => "default {apply(f)}"
si

class SQUARE: Shape[int] is
    init() is si
    value() -> int => 4
si

class LABEL: Shape[int] is
    init() is si
    value() -> int => 7

    describe[K](f: (int) -> K) -> string => "label {f(value())}"
si

show(shapes: Shape[int][]) is
    for shape in shapes do
        write_line(shape.describe(x => x * 2))
        write_line(shape.describe(x => "<{x}>"))
        write_line("{shape.apply(x => x + 1)}")
    od
si

show([SQUARE(), LABEL()])
