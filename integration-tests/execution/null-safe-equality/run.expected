  (body)
present =~ same: True
  (body)
present =~ other: False
present =~ absent: False
absent =~ present: False
absent =~ also_absent: True
absent !~ also_absent: False
present !~ absent: True
  (body)
present !~ other: True
plain =~ absent: False
absent =~ plain: False
  (own-nulls body, other present: False)
own =~ own_absent: True
own_absent =~ own: False
own_absent =~ own_also_absent: True
