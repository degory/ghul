namespace Test is
    use IO.Std;

    // `=~` declares its parameter at the declaring type, so a body is
    // written over present values and never sees null. Presence is
    // settled at the call site: two absent operands are equal, one
    // absent operand is not, and neither reaches the body.

    class BOX is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: BOX) -> bool is
            Std.write_line("  (body)");
            return _v == other._v;
        si
    si

    describe(label: string, result: bool) is
        Std.write_line("{label}: {result}");
    si

    class Main is
        entry() static is
            let present: BOX? = BOX(3);
            let same: BOX? = BOX(3);
            let other: BOX? = BOX(5);
            let absent: BOX? = null;
            let also_absent: BOX? = null;

            describe("present =~ same", present =~ same);
            describe("present =~ other", present =~ other);

            // an absent operand short-circuits, so no body line above
            // these two
            describe("present =~ absent", present =~ absent);
            describe("absent =~ present", absent =~ present);

            // two absent values are equal
            describe("absent =~ also_absent", absent =~ also_absent);

            // `!~` negates the lowered relation entire, so two absent
            // values are not unequal
            describe("absent !~ also_absent", absent !~ also_absent);
            describe("present !~ absent", present !~ absent);
            describe("present !~ other", present !~ other);

            // a non-optional operand on one side still routes through
            // the presence test for the other
            let plain = BOX(3);

            describe("plain =~ absent", plain =~ absent);
            describe("absent =~ plain", absent =~ plain);

            return;
        si
    si
si
