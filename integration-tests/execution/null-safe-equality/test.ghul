namespace Test is
    use IO.Std;

    // `=~` declares its parameter at the declaring type, so a body is
    // written over present values and never sees null. Presence is
    // settled at the call site: two absent operands are equal, one
    // absent operand is not, and neither reaches the body.

    class BOX is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: BOX) -> bool is
            Std.write_line("  (body)");
            return _v == other._v;
        si
    si

    // An operator that declares its parameter optional is handling
    // absence itself, so it is called as written and decides the
    // answer for an absent operand on its own.
    class OWN_NULLS is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: OWN_NULLS?) -> bool is
            Std.write_line("  (own-nulls body, other present: {other?})");
            return !other? \/ _v == other._v;
        si
    si

    // A value type's optional is `Nullable[T]`, which carries presence
    // in a member rather than in the reference.
    struct POINT is
        x: int;

        init(x: int) is self.x = x; si

        =~(other: POINT) -> bool => x == other.x;
    si

    // A value type whose operator declares its parameter optional, so
    // the argument arm is not emitted and the operand has to reach the
    // body as its carrier - projecting the value out of an absent
    // `Nullable[T]` would throw rather than let the body answer.
    struct OWN_NULLS_POINT is
        x: int;

        init(x: int) is self.x = x; si

        =~(other: OWN_NULLS_POINT?) -> bool is
            Std.write_line("  (value own-nulls body, other present: {other?})");
            return !other? \/ x == other.x;
        si
    si

    some_own_point(x: int) -> OWN_NULLS_POINT? => OWN_NULLS_POINT(x);
    no_own_point() -> OWN_NULLS_POINT? => _;

    // An unconstrained `T?` is carried by `MAYBE[T]`, the third
    // lowering.
    through_a_type_parameter[T: Ghul.Equatable[T]](a: T?, b: T?) -> bool => a =~ b;

    // Keeps an operand optional: assigning a present value to a `T?`
    // local narrows it to `T`, which would take these off the path
    // under test.
    some_point(x: int) -> POINT? => POINT(x);
    no_point() -> POINT? => _;
    some_int(v: int) -> int? => v;
    no_int() -> int? => _;

    // `Ghul.Equatable[T]` declares its parameter optional, so an
    // implementation does too.
    class EQUATABLE: Ghul.Equatable[EQUATABLE] is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: EQUATABLE?) -> bool => other? /\ _v == other._v;
    si

    describe(label: string, result: bool) is
        Std.write_line("{label}: {result}");
    si

    class Main is
        entry() static is
            let present: BOX? = BOX(3);
            let same: BOX? = BOX(3);
            let other: BOX? = BOX(5);
            let absent: BOX? = null;
            let also_absent: BOX? = null;

            describe("present =~ same", present =~ same);
            describe("present =~ other", present =~ other);

            // an absent operand short-circuits, so no body line above
            // these two
            describe("present =~ absent", present =~ absent);
            describe("absent =~ present", absent =~ present);

            // two absent values are equal
            describe("absent =~ also_absent", absent =~ also_absent);

            // `!~` negates the lowered relation entire, so two absent
            // values are not unequal
            describe("absent !~ also_absent", absent !~ also_absent);
            describe("present !~ absent", present !~ absent);
            describe("present !~ other", present !~ other);

            // a non-optional operand on one side still routes through
            // the presence test for the other
            let plain = BOX(3);

            describe("plain =~ absent", plain =~ absent);
            describe("absent =~ plain", absent =~ plain);

            // the optional-parameter operator keeps deciding for an
            // absent argument: its body runs and answers true for one
            let own: OWN_NULLS? = OWN_NULLS(3);
            let own_absent: OWN_NULLS? = null;
            let own_also_absent: OWN_NULLS? = null;

            describe("own =~ own_absent", own =~ own_absent);

            // an absent receiver is never its decision, though - there
            // is nothing to dispatch on - so those arms are answered
            // for it, and the body does not run
            describe("own_absent =~ own", own_absent =~ own);
            describe("own_absent =~ own_also_absent", own_absent =~ own_also_absent);

            // a value-type optional reaches the same three arms
            describe("some_int 1 =~ 1", some_int(1) =~ some_int(1));
            describe("some_int 1 =~ 2", some_int(1) =~ some_int(2));
            describe("some_int 1 =~ none", some_int(1) =~ no_int());
            describe("no_int =~ some_int 1", no_int() =~ some_int(1));
            describe("no_int =~ no_int", no_int() =~ no_int());
            describe("no_int !~ no_int", no_int() !~ no_int());

            // and so does a user struct's
            describe("some_point 1 =~ 1", some_point(1) =~ some_point(1));
            describe("some_point 1 =~ none", some_point(1) =~ no_point());
            describe("no_point =~ no_point", no_point() =~ no_point());

            // and an unconstrained T?, carried by MAYBE[T]
            let equatable = EQUATABLE(1);
            let same_equatable = EQUATABLE(1);

            describe(
                "through_a_type_parameter present",
                through_a_type_parameter[EQUATABLE](equatable, same_equatable));

            describe(
                "through_a_type_parameter one absent",
                through_a_type_parameter[EQUATABLE](equatable, _));

            describe(
                "through_a_type_parameter both absent",
                through_a_type_parameter[EQUATABLE](_, _));

            // a value-shape operand is always guarded, whatever its
            // operator declares: the parameter is a bare value at IL,
            // so there is no absent value to hand the body. The body
            // does not run for these two
            describe(
                "some_own_point =~ no_own_point",
                some_own_point(1) =~ no_own_point());

            describe(
                "no_own_point =~ some_own_point",
                no_own_point() =~ some_own_point(1));

            describe(
                "some_own_point =~ same",
                some_own_point(1) =~ some_own_point(1));

            // and the same answer with a present non-optional left, so
            // one comparison does not answer two ways depending on the
            // other operand
            let plain_own_point = OWN_NULLS_POINT(1);

            describe(
                "plain_own_point =~ no_own_point",
                plain_own_point =~ no_own_point());

            describe(
                "plain_own_point =~ some_own_point",
                plain_own_point =~ some_own_point(1));

            return;
        si
    si
si
