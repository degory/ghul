use IO.Std.write_line;

// A null says a value can be absent without saying what it holds when
// present, so a literal whose body is null takes what it returns from
// the slot it goes into rather than settling on void.
take_object(loaded: (string) -> object?) -> string => "{loaded("a") ?? "absent"}"

take_string(name: string, loaded: (string) -> string?) -> string => "{loaded(name) ?? "absent"}"

// A value type has no null of its own to be, so the widening goes
// through its optional carrier rather than the reference optional.
take_int(name: string, loaded: (string) -> int?) -> string is
    let got = loaded(name)

    return if got? then "{got}" else "absent" fi
si

entry() is
    write_line("expression: {take_object(name => null)}");
    write_line("block: {take_object(name is return null si)}");

    // One return produces a value and another produces null, so the
    // return is what the value said, able to be absent. Both are
    // reached, to show the literal really does return either.
    write_line(
        "mixed present: {take_string("abc", name is if name.length > 0 then return name fi; return null si)}");

    write_line(
        "mixed absent: {take_string("", name is if name.length > 0 then return name fi; return null si)}");

    write_line("arms present: {take_string("abc", name => if name.length > 0 then name else null fi)}");
    write_line("arms absent: {take_string("", name => if name.length > 0 then name else null fi)}");

    write_line("value present: {take_int("abc", name => if name.length > 0 then name.length else null fi)}");
    write_line("value absent: {take_int("", name => if name.length > 0 then name.length else null fi)}");
    write_line("value null only: {take_int("abc", name => null)}");
si
