namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    union Tree[T] is
        EMPTY;
        NODE(value: T, rest: Tree[T]);
    si

    class Main is
        entry() static is
            simple_name();
            destructure();
            guarded();
            in_loop();
            member_path();

            for v in walk(Tree.NODE(1, Tree.NODE(2, Tree.EMPTY[int]))) do
                Std.out.write_line("yielded {v}");
            od
        si

        mk[T](value: T) -> Tree[T] static => Tree.NODE(value, Tree.EMPTY[T]);

        next[T](t: Tree[T]) -> Tree[T] static => t;

        // The scrutinee is a call, so the then-edge narrowing has no
        // target to specialise: the variant the clause tests has to
        // carry the union's type arguments regardless, or the isinst
        // names the open generic and the assembly will not load.
        simple_name() static is
            if let n: Tree.NODE = mk("b") then
                Std.out.write_line("simple {n.value}");
            fi
        si

        destructure() static is
            if let (value, rest): Tree.NODE = mk(42) then
                Std.out.write_line("destructured {value}");
            fi
        si

        guarded() static is
            if let n: Tree.NODE = mk("g") /\ n.value =~ "g" then
                Std.out.write_line("guarded {n.value}");
            fi
        si

        in_loop() static is
            while let n: Tree.NODE = mk(7) do
                Std.out.write_line("while {n.value}");
                break;
            od
        si

        // A member access is not a narrowing target either.
        member_path() static is
            let holder = HOLDER[string](mk("m"));

            if let n: Tree.NODE = holder.tree then
                Std.out.write_line("path {n.value}");
            fi
        si

        walk[T](t: Tree[T]) -> Pipe[T] static is
            let cur mut = t;

            while true do
                if let (value, rest): Tree.NODE = next(cur) then
                    yield value;
                    cur = rest;
                else
                    break;
                fi
            od
        si
    si

    class HOLDER[T] is
        tree: Tree[T];

        init(tree: Tree[T]) is self.tree = tree; si
    si
si
