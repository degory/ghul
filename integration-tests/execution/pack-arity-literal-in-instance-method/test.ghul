namespace Test is
    use IO.Std.write_line;

    // A pack-adapted literal filling an N-ary formal, walked while
    // still inside an instance method: the closure is a captureless
    // INSTANCE_CLOSURE, which is eligible for delegate-caching on its
    // very first walk - before the pack adaptation that matches its
    // inferred return type against the sibling `initial` argument has
    // had a chance to settle. Converting to a delegate and re-walking
    // at that point discarded the settling walk's progress, leaving
    // the retry loop believing nothing had changed and the tuple
    // element-name mismatch between `initial`'s unnamed `(int, int)`
    // and the lambda's own inferred `(current: int, `1: int)` return
    // stood as reported.

    union STREAM[T, S] is
        DONE;
        YIELD(value: T, state: S);
    si

    marked_stream[T, S..](initial: S, advance: S.. -> STREAM[T, S]) -> Ghul.Pipes.Pipe[T] is
        let state mut = initial;

        while true do
            let step = advance(state);

            if let y: STREAM.YIELD[T, S] = step then
                yield y.value;
                state = y.state;
            else
                return;
            fi
        od
    si

    class RUNNER is
        init() is si

        run() -> int is
            let fib =
                marked_stream(
                    (0, 1),
                    (previous, current) => STREAM.YIELD(previous, (current, previous + current))
                );

            let total mut = 0;
            let count mut = 0;

            for n in fib do
                if count >= 6 then
                    break;
                fi

                total = total + n;
                count = count + 1;
            od

            return total;
        si
    si

    entry() is
        write_line("{RUNNER().run()}");
    si
si
