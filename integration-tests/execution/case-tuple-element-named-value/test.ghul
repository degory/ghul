namespace Test is
    use Std = IO.Std;

    enum COLOUR is
        RED,
        BLACK,
    si

    union TREE is
        EMPTY;
        NODE(colour: COLOUR, left: TREE, value: int);
    si

    class Main is
        entry() static is
            // A tuple element named `value` once made the arm bind from
            // that element instead of the whole tuple, so no label was
            // tested and every name bound its default.
            balance(COLOUR.BLACK, TREE.EMPTY, 3);
            balance(COLOUR.RED, TREE.EMPTY, 3);

            keyed(1, 42);
            keyed(2, 42);
        si

        balance(colour: COLOUR, left: TREE, value: int) static is
            case (colour, left, value)
            when (COLOUR.BLACK, l, z) then
                Std.out.write_line("black z={z}");
            else
                Std.out.write_line("other");
            esac
        si

        keyed(a: int, value: int) static is
            case (a, value)
            when (1, z) then
                Std.out.write_line("one z={z}");
            else
                Std.out.write_line("other");
            esac
        si
    si
si
