// A pattern arm's guard is walked with the pattern's bound names in
// scope, but a guard-derived narrow does not currently reach the arm
// body the way an `if let` clause guard's narrow reaches its then-arm
// — case-arm patterns don't participate in NARROW_ENV at all yet
// (see #1819). So `f.payload!` below is still a live unwrap, not a
// redundant one: if narrowing is ever added for case-arm guards, this
// pins the change by flipping to a `redundant-unwrap` warning.
namespace Test is
    use Std = IO.Std;

    union Box is
        FULL(payload: int?);
        EMPTY;
    si

    class Main is
        entry() static is
            describe(Box.FULL(5));
            describe(Box.EMPTY);
        si

        describe(b: Box) static is
            case b
            when f: Box.FULL /\ f.payload? then
                Std.write_line("{f.payload!}");
            else
                Std.write_line("none");
            esac
        si
    si
si
