// A guard's narrowing does not currently reach the arm body, so
// `f.payload!` below is still a live unwrap, not a redundant one. If
// that changes, this test flips to a `redundant-unwrap` warning.
namespace Test is
    use Std = IO.Std;

    union Box is
        FULL(payload: int?);
        EMPTY;
    si

    class Main is
        entry() static is
            describe(Box.FULL(5));
            describe(Box.EMPTY);
        si

        describe(b: Box) static is
            case b
            when f: Box.FULL /\ f.payload? then
                Std.write_line("{f.payload!}");
            else
                Std.write_line("none");
            esac
        si
    si
si
