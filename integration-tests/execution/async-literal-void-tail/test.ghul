namespace Test is
    use IO.Std.write_line;

    class Main is
        // Literals that await and end on something that looks like a
        // tail but delivers nothing: each is void-async after all, and
        // the tail still runs for its effects.
        entry() static is
            let block_tail = () is
                let x = await Tasks.TASK.from_result(1);
                write_line("block {x}")
            si;

            block_tail().wait();

            let expression_tail = () => write_line("expression {await Tasks.TASK.from_result(2)}");

            expression_tail().wait();

            let early_return = () is
                let x = await Tasks.TASK.from_result(3);

                if x > 0 then
                    write_line("early {x}");
                    return;
                fi

                write_line("unreached")
            si;

            early_return().wait();
        si
    si
si
