use IO.Std.write_line;

class BOX is
    label: string;

    init(label: string) is
        self.label = label;
    si
si

// expression-bodied function returning `null` for a non-optional
// `BOX` return type — warns at the `null`
absent_box() -> BOX => null;

// opaque to flow narrowing — a direct literal assignment would let
// the compiler prove `!` redundant below
present_box() -> BOX? => BOX("present");

entry() is
    // `null` into a non-optional typed `let` — warns
    let a: BOX = null;

    // `null` into a non-optional assignment — warns
    let b mut = BOX("b");
    b = null;

    // an optional target accepts `null` cleanly — no warning
    let maybe: BOX? = null;

    // a `BOX?` the flow analysis has proven present — no warning
    if maybe? then
        let proven: BOX = maybe;
    fi

    // explicit `!` unwrap takes responsibility — no warning. The
    // `!` operator itself now enforces presence at runtime, so the
    // receiver has to genuinely hold a value here rather than the
    // still-null `maybe` above.
    let unwrapped: BOX = present_box()!;

    write_line("ok");
si
