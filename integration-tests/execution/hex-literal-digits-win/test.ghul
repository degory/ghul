namespace Test is
    use IO.Std;

    // `b` and `c` are hex digits as well as size selectors. In a hex
    // literal the digit reading wins, so a suffix that would be read as
    // a digit has to be attached with a backtick.
    entry() is
        let euro = 0x20AC;
        let ab = 0xAB;
        let single = 0xB;
        let ff = 0xFF;

        Std.write_line("{euro} {ab} {single} {ff}");

        let as_char = 0x20AC`c;
        let as_ubyte = 0xFF`ub;

        Std.write_line("{cast int(as_char)} {cast int(as_ubyte)}");

        // A selector that is not a hex digit needs no backtick.
        let wide = 0x20ACl;

        Std.write_line("{wide}");

        // Decimal is unaffected: nothing there collides.
        let small = 123b;
        let letter = 65c;

        Std.write_line("{cast int(small)} {letter}");
    si
si
