// Read-only structs read in place and sharing one default instance must
// still behave as values: a default written through a reference leaves
// other defaults alone, and a presence test of a boxed value answers by
// what the value is.
use IO.Std.write_line

struct PAIR(a: int public, b: string public) is
    sum_with(n: int) -> int => a + n
si

trait Named is
    name: string
si

struct LABEL(name: string public): Named

struct PLAIN(n: int public)

set_pair(p: (int, string) ref) is
    p! = (7, "seven")
si

present[K](key: K) -> bool => (cast object?(key))?

named[K](key: K) -> bool => (cast Named?(key))?

@suppress("definite-assignment")
entry() is
    let first: (int, string) mut
    let second: (int, string) mut

    set_pair(first ref)

    write_line("first {first.`0} {first.`1}")
    write_line("second {second.`0}")

    let rows = [(key = "a", columns = [1, 2]), (key = "b", columns = [3])]
    let total mut = 0

    for row in rows do
        let offset mut = 0

        while offset < row.columns.count do
            total = total + row.columns[offset]
            offset = offset + 1
        od
    od

    write_line("total {total}")

    let pairs = [PAIR(1, "one"), PAIR(2, "two")]
    let sum mut = 0

    for p in pairs do
        sum = sum + p.sum_with(10) + p.b.length
    od

    write_line("sum {sum}")

    let map = Collections.MAP[int, string]()

    map[1] = "one"
    map[2] = "two"

    let keys mut = 0

    for entry in map do
        keys = keys + entry.key + entry.value.length
    od

    write_line("keys {keys}")
    write_line("present {present(3)} {present[string?](null)} {present("x")}")
    write_line("named {named(LABEL("l"))} {named(PLAIN(1))}")
si
