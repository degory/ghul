use IO.Std.write_line

// An optional value type: whether it holds a value, a fallback, the value it
// holds, and reading the value of an absent one, which throws.
find(want: bool) -> int? => if want then 42 else null fi

entry() is
    let present = find(true)
    let absent = find(false)

    write_line("{present?} {absent?}")
    write_line("{present ?? 0} {absent ?? 7}")
    write_line("{present!}")

    try
        write_line("{absent!}")
    catch e: Ghul.InvalidOperationException
        write_line("caught")
    yrt
si
