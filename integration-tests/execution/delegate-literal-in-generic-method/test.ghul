@@suppress("impure-function-argument")

namespace Test is
    use IO.Std;
    use Ghul.Pipes;
    use Collections;

    // Tests: a function literal converted to a delegate in a method
    // that has type parameters of its own, of its class, or both. Such
    // a delegate's method carries the parameters its signature names
    // and the construction site reaches it through an instantiation,
    // as a frameless literal already did.

    class HOLDER[X] is
        _label: string;

        init(label: string) is
            _label = label;
        si

        // Class and method parameters together.
        both[Y](xs: LIST[(X, Y)]) -> string =>
            xs |> map(p => "{p.`0}{p.`1}") |> join(",");

        // The same, where the callback is fitted to the pack.
        packed[Y](xs: LIST[(X, Y)]) -> string =>
            xs |> map((a, b) => "{a}{b}") |> join(",");

        // Class parameter alone.
        class_only(xs: LIST[X]) -> string =>
            xs |> map(x => "{x}") |> join(",");

        // The literal reads the receiver as well.
        captures_self[Y](xs: LIST[(X, Y)]) -> string =>
            xs |> map(p => "{p.`0}{_label}{p.`1}") |> join(",");
    si

    class PLAIN is
        init() is si

        // Method parameter alone, on a class that has none.
        method_only[Y](xs: LIST[Y]) -> string =>
            xs |> map(y => "{y}") |> join(",");
    si

    class Main is
        entry() static is
            let h = HOLDER[int](":");
            let pairs = LIST[(int, string)]([(1, "a"), (2, "b")]);

            Std.write_line(h.both[string](pairs));
            Std.write_line(h.packed[string](pairs));
            Std.write_line(h.class_only(LIST[int]([3, 4])));
            Std.write_line(h.captures_self[string](pairs));
            Std.write_line(PLAIN().method_only[string](LIST[string](["c", "d"])));

            return;
        si
    si
si
