namespace Test is
    use Std = IO.Std;

    // `private` captures into the underscore-named member, so the value
    // has to survive the constructor and read back through `_secret`.
    class BOX(secret: int private) is
        reveal() -> int => _secret;
    si

    // A private capture sits out the synthesised deconstruct, which
    // exposes only the public-readable ones.
    class POINT(x: int, tag: int private, y: int) is
        tag() -> int => _tag;
    si

    // An already-underscored parameter keeps its single underscore.
    class KEEP(_v: int private) is
        peek() -> int => _v;
    si

    class Main is
        entry() static is
            Std.write_line("{BOX(42).reveal()}");

            let p = POINT(1, 2, 3);
            let (a, b) = p;
            Std.write_line("{a},{b},{p.tag()}");

            Std.write_line("{KEEP(9).peek()}");
        si
    si
si
