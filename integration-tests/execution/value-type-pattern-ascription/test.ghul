use IO.Std.write_line

show_optional(m: int?) is
    if let i: int = m then
        write_line("optional present {i + 1}")
    else
        write_line("optional absent")
    fi
si

show_boxed(o: object?) is
    if let i: int = o then
        write_line("boxed int {i + 1}")
    elif let s: string = o then
        write_line("boxed string {s}")
    else
        write_line("boxed other")
    fi
si

guarded(o: object?) -> int =>
    if let i: int = o /\ i > 0 then i else -1 fi

case_boxed(o: object) is
    case o
    when i: int then write_line("case int {i * 2}")
    when l: long then write_line("case long {l}")
    else write_line("case other")
    esac
si

case_optional(m: int?) is
    case m
    when i: int /\ i > 3 then write_line("case big {i}")
    when i: int then write_line("case small {i}")
    else write_line("case absent")
    esac
si

show_optional(4)
show_optional(null)

show_boxed(41)
show_boxed("x")
show_boxed(2L)
show_boxed(null)

write_line("{guarded(5)} {guarded(-5)} {guarded("s")} {guarded(null)}")

case_boxed(21)
case_boxed(5L)
case_boxed("q")

case_optional(7)
case_optional(1)
case_optional(null)
