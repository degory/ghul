// Implicit tail returns compose with async functions: a bare-T tail
// wraps as TASK[T] like `return T` - except in state-machine bodies,
// where the result slot holds the element type and no wrap applies.
// Both await-carrying and await-free bodies are pinned here.

namespace Test is
    use Std = IO.Std;
    use System.Threading.Tasks;

    class MAIN is
        entry() static is
            Std.write_line("{load(true).result}");
            Std.write_line("{load(false).result}");
            Std.write_line("{awaited(true).result}");
            Std.write_line("{awaited(false).result}");
            Std.write_line("{tail_is_await().result}");
        si
    si

    load(flag: bool) -> Tasks.TASK[string] is
        let raw = if flag then "yes" else "no" fi;

        raw.to_upper()
    si

    // Await in body + implicit tail: judged against the element type.
    awaited(flag: bool) -> Tasks.TASK[int] is
        let v = await load(flag);
        v.length
    si

    // The await itself as tail.
    tail_is_await() -> Tasks.TASK[int] is
        let one = Tasks.TASK.from_result[int](0);
        await one
    si
si
