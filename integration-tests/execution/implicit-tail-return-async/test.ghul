// Implicit tail returns compose with async functions: a bare-T tail
// is wrapped as TASK[T], exactly as an explicit `return T` is.

namespace Test is
    use Std = IO.Std;
    use System.Threading.Tasks;

    class MAIN is
        entry() static is
            Std.write_line("{load(true).result}");
            Std.write_line("{load(false).result}");
        si
    si

    load(flag: bool) -> Tasks.TASK[string] is
        let raw = if flag then "yes" else "no" fi;

        raw.to_upper()
    si
si
