// A tuple-typed local, and a struct-typed one, written through a reference
// as try_get_value does. Writing through the reference changes the local and
// nothing that held the same value before.
use IO.Std.write_line
use Collections.MAP

struct POINT is
    x: int field
    y: int field

    init(x: int, y: int) is
        self.x = x
        self.y = y
    si
si

entry() is
    let named = MAP[int, (name: string, size: int)]()

    named[1] = ("one", 3)
    named[2] = ("two", 5)

    let found: (name: string, size: int) mut = ("none", 0)

    if named.try_get_value(1, found ref) then
        write_line("found {found.name} {found.size}")
    fi

    let kept = found

    if named.try_get_value(2, found ref) then
        write_line("found {found.name} {found.size}, kept {kept.name} {kept.size}")
    fi

    write_line("map still holds {named[1].name} and {named[2].name}")

    let points = MAP[int, POINT]()

    points[1] = POINT(3, 4)

    let point: POINT mut = POINT(0, 0)

    if points.try_get_value(1, point ref) then
        write_line("point {point.x} {point.y}")
    fi
si
