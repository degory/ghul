namespace Test is
    use Std = IO.Std;

    use System.Reflection.Assembly;
    use System.Reflection.CustomAttributeData;

    class Main is
        // Reads the assembly's own attributes back through the parser
        // that validates the whole custom-attribute blob, including the
        // named-argument count a positional-only attribute still has to
        // carry. Assembly.get_custom_attributes() does not: it tolerates
        // a blob truncated after the last positional argument.
        entry() static is
            let names = Collections.LIST[string]();

            for data in CustomAttributeData.get_custom_attributes(Assembly.get_executing_assembly()) do
                if data.constructor_arguments.count == 1 then
                    names.add("{data.attribute_type.name}={data.constructor_arguments[0].value}");
                fi
            od

            let sorted = names | .sort();

            for name in sorted do
                Std.write_line(name);
            od

            return;
        si
    si
si
