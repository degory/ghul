use IO.Std.write_line

union Shape is
    CIRCLE(radius: int)
    NOTHING
si

union Colour is
    RED
    GREEN
    BLUE
si

union Option[T] is
    SOME(value: T)
    NONE
si

describe(s: Shape) -> string =>
    case s
    when (radius): Shape.CIRCLE then "circle {radius}"
    when Shape.NOTHING then "nothing"
    esac

name(c: Colour) -> string =>
    case c
    when Colour.RED then "red"
    when Colour.GREEN, Colour.BLUE then "not red"
    esac

show(o: Option[int]) -> string =>
    case o
    when (value): Option.SOME[int] then "some {value}"
    when Option.NONE then "none"
    esac

report(o: Option[string]) is
    case o
    when Option.NONE then write_line("absent")
    when s: Option.SOME[string] then write_line("present {s.value}")
    esac
si

write_line(describe(Shape.CIRCLE(3)))
write_line(describe(Shape.NOTHING))
write_line(name(Colour.RED))
write_line(name(Colour.BLUE))
write_line(show(Option.SOME(7)))
write_line(show(Option.NONE))
report(Option.NONE)
report(Option.SOME("x"))
