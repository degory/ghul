use IO.Std.write_line

// A string's length, its code units, comparison by content, slicing and
// joining, and a type test for it, as every target gives them.
describe(o: object) -> string =>
    if isa string(o) then "a string" else "not a string" fi

entry() is
    let word = "naïve café"
    let computed = "{word.substring(0, 5)}{word.substring(5)}"

    write_line("{word.length}")
    write_line("{word[2]}")
    write_line(word.substring(6))
    write_line("{computed =~ word}")
    write_line("{computed == word}")
    write_line("{"" =~ ""}")

    let absent: string? = null

    write_line("{word =~ absent} {absent =~ word} {absent =~ absent}")
    write_line("joined: {word}!")

    let boxed: object = 42

    write_line(describe(word))
    write_line(describe(boxed))
si
