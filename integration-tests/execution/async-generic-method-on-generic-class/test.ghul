namespace Test is
    use Std = IO.Std;

    class HOLDER[T: class] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        // The frame captures the class's T at index 0 and the method's
        // U at index 1, so the outer method names it over both.
        combine[U: Ghul.Comparable[U]](other: U) -> Tasks.TASK[string] is
            await Tasks.TASK.yield();

            return "{_value}/{other}";
        si
    si

    class Main is
        entry() static is
            Std.write_line("combined: {HOLDER[string]("left").combine[int](7).result}");
        si
    si
si
