namespace Test is
    use Std = IO.Std;

    // A returned task whose result does not fit the slot is the
    // ordinary mismatch, reported against the slot's element type.
    class Main is
        fetch() -> Tasks.TASK[string] static =>
            Tasks.TASK.from_result("x");

        compute() -> Tasks.TASK[int] static is
            await fetch();
            return fetch();
        si

        entry() static is
            compute();
        si
    si
si
