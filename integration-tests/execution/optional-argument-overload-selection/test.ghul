namespace Test is
    render(o: object?) -> string => "object";
    render(s: string) -> string => "string";
    render[T](i: Collections.Iterable[T]) -> string => "Iterable";

    entry() is
        let absent: string? = null;
        let present = "hello";

        IO.Std.write_line(render(absent));
        IO.Std.write_line(render(present));
        IO.Std.write_line(render([1, 2, 3]));
    si
si
