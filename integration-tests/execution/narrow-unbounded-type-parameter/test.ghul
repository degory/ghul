use IO.Std.write_line;

// Narrowing a value whose declared type is an unbound type parameter
// keeps the parameter: the value is still a `T`, so the narrowed view
// is `T & TARGET` and the value stays assignable back to `T`. The
// runtime test itself boxes, because `T` can be instantiated at a
// value type.

trait Box[T] is
    get_value() -> T;

    smaller_of(other: T) -> T is
        let v = get_value();

        if isa Ghul.Comparable[T](v) then
            if v <> other <= 0 then
                return v;
            fi
        fi

        return other;
    si
si

class INT_BOX(value: int): Box[int] is
    get_value() -> int => value;
si

class NAME(text: string): Ghul.Comparable[NAME] is
    <>(other: NAME) -> int pure => text.compare_to(other.text);
si

class NAME_BOX(value: NAME): Box[NAME] is
    get_value() -> NAME => value;
si

class OPAQUE is
    init() is si
si

class OPAQUE_BOX(value: OPAQUE): Box[OPAQUE] is
    get_value() -> OPAQUE => value;
si

is_comparable[T](v: T) -> bool is
    if isa Ghul.Comparable[T](v) then
        return true;
    fi

    return false;
si

entry() is
    write_line("{INT_BOX(3).smaller_of(7)}");
    write_line("{INT_BOX(9).smaller_of(7)}");
    write_line(NAME_BOX(NAME("alice")).smaller_of(NAME("bob")).text);

    let o = OPAQUE();
    write_line("{OPAQUE_BOX(o).smaller_of(o) == o}");

    write_line("{is_comparable(3)}");
    write_line("{is_comparable("text")}");
    write_line("{is_comparable(OPAQUE())}");
si
