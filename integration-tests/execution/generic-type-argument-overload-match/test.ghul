namespace Test is
    use IO.Std;

    // A value whose type is an unconstrained type parameter satisfies
    // only a formal that accepts every type - which `object?` always
    // does, since every type variable has `object` among its ancestors. `T` is fixed where the
    // call is written - nothing at the call site can bind it - so a
    // formal asking for a specific class is a formal the argument
    // cannot satisfy, and the `object?` overload is the only sound
    // choice.
    //
    // Selecting the `REF` overload instead reinterprets whatever the
    // value really is - a boxed `int` below - as a `REF`, so a wrong
    // answer here is a miscompile rather than a difference in
    // formatting.

    class REF is
        init() is si
    si

    pick(o: object?) -> string => "object";

    pick(r: REF) -> string => "REF";

    // a second specific formal, and one that is generic itself: an
    // unconstrained `T` satisfies neither, which leaves the `object?`
    // overload as the only candidate rather than the merely
    // best-scoring one
    pick[E](i: Collections.Iterable[E]) -> string => "sequence";

    directly[T](x: T) -> string => pick(x);

    class BOX[B](item: B) is
        // the lambda's parameter type comes from `B`, which the
        // enclosing generic function pins to its own type variable
        apply[R](f: (B) -> R) -> R => f(item);
    si

    through_lambda[T](x: T) -> string => BOX(x).apply(y => pick(y));

    through_pipe[T](values: Collections.Iterable[T]) -> string =>
        Ghul.Pipes.join(Ghul.Pipes.pipe(values) | .map(x => pick(x)), ",");

    entry() is
        Std.write_line(directly(42));
        Std.write_line(through_lambda(42));
        // resolution is static: `T = REF` at this call site does not
        // reach back into the body's choice of overload
        Std.write_line(through_lambda(REF()));
        Std.write_line(through_pipe([1, 2]));
    si
si
