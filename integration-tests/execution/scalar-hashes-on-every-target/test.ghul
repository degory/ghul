use IO.Std.write_line

// A scalar's hash code depends on its value, whether it is called on the
// scalar or reached through a box, so a tuple's hash depends on the order
// of its elements. Floating values that =~ reports equal hash alike.
hash_of(value: object) -> int => value.get_hash_code()

entry() is
    write_line("{(7).get_hash_code()} {hash_of(7)} {(5L).get_hash_code()}")
    write_line("{(1).get_hash_code() == (2).get_hash_code()} {hash_of(1) == hash_of(2)}")
    write_line("{(1, 2).get_hash_code() == (2, 1).get_hash_code()}")
    write_line("{(0.0).get_hash_code() == (-0.0).get_hash_code()} {(1.5).get_hash_code() == (2.5).get_hash_code()}")
si
