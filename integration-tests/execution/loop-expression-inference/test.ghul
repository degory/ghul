namespace Test is
    use Std = IO.Std;

    apply(f: int -> string, v: int) -> string => f(v);
    twice_with(f: int -> int, v: int) -> int => f(v) * 2;
    wrap(f: int -> int) -> int -> int => f;

    consume(value: int?) is
        if value? then
            Std.write_line("consumed {value}");
        else
            Std.write_line("consumed absent");
        fi
    si

    class Main is
        entry() static is
            let xs = [1, 2, 3];

            // down: the expected result type threads loop -> break ->
            // call -> the untyped lambda's parameter
            let r: string? = for x in xs do
                if x > 0 then break apply(n => "n{n}", x) fi;
            od;

            check("down-lambda-arg", r =~ "n1");

            // up: an untyped lambda as the break value; its return type
            // comes from its body and the loop widens to the optional
            let g: (int -> int)? = while true do
                break m => m * 3;
            od;

            check("up-lambda", g!(4) == 12);

            // sibling: the lambda's parameter is pinned by the other
            // argument's use, with no annotation anywhere on it
            let h: int? = do
                break twice_with(n => n + 1, 10);
            od;

            check("sibling-arg", h =~ 22);

            // a lambda local inside the body, its parameter inferred
            // from its use below it, flowing out as the break value
            let k: (int -> int)? = while true do
                let inc = wrap(n => n + 1);
                break inc;
            od;

            check("body-lambda", k!(9) == 10);

            // down through a call-argument slot: the loop expression
            // infers against the parameter type
            consume(for x in xs do
                if x > 1 then break x fi;
            od);
        si

        check(name: string, ok: bool) static is
            if ok then
                Std.write_line("ok {name}");
            else
                Std.write_line("FAIL {name}");
            fi
        si
    si
si
