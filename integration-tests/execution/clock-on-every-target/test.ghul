use IO.Std.write_line

// The clock members the compiler times its passes with read the same way on
// every target: a TimeSpan built from ticks, a DateTime difference, and a
// Stopwatch's elapsed milliseconds.
entry() is
    let total mut = System.TimeSpan(0L)

    let started = System.DateTime.now
    let watch = System.Diagnostics.Stopwatch.start_new()

    let elapsed = System.DateTime.now.subtract(started)

    total = total.add(elapsed)
    total = total.add(System.TimeSpan(20_000L))

    write_line(if total.total_milliseconds >= 2.0D then "the total grows" else "the total is {total.total_milliseconds}" fi)
    write_line(if total.divide(2.0D).total_milliseconds >= 1.0D then "the average is half" else "the average is wrong" fi)
    write_line(if watch.elapsed_milliseconds >= 0L then "the stopwatch runs" else "the stopwatch went back" fi)
si
