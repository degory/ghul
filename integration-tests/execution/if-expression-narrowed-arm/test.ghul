// An if expression's arm yields a value a type test narrowed, held at its
// wider declared type, where the expression's own type is the narrow one.
use IO.Std.write_line

class Shape abstract is
    init() is si
si

class GROUP: Shape is
    _names: string
    init(names: string) is super.init(); _names = names si
    names: string => _names
    merged(other: GROUP) -> GROUP => GROUP("{_names}+{other.names}")
si

class DOT: Shape is
    init() is super.init() si
si

merge(shapes: Shape[]) -> GROUP? is
    let merged: GROUP? mut = null

    for shape in shapes do
        if isa GROUP(shape) then
            merged =
                if let prior = merged then
                    prior.merged(shape)
                else
                    shape
                fi
        fi
    od

    return merged
si

entry() is
    write_line(merge([GROUP("a"), DOT(), GROUP("b")])?.names ?? "none")
si
