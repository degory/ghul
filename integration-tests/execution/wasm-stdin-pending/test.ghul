// The wasm engine can say whether a complete line of standard input is
// waiting, wait for one, and read what it waited for; and can report how
// much heap the program holds.
use IO.Std.write_line

@intrinsic("host.stdin_pending")
input_pending() -> bool => false

@intrinsic("host.stdin_wait")
wait_for_input(timeout_ms: int) -> bool => false

@intrinsic("host.heap_bytes")
heap_bytes(force: bool) -> double => 0.0

entry() is
    // The input is supplied whole and closed, so each wait is answered
    // true and the end of the input is itself something to wait for.
    while wait_for_input(5000) do
        let line = IO.Std.read_line()

        if !line? then
            break
        fi

        write_line("line: [{line}]")
    od

    write_line("ended: {wait_for_input(5000)} {input_pending()}")
    write_line("heap: {heap_bytes(false) > 0.0} {heap_bytes(true) > 0.0}")
si
