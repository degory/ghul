use IO.Std.write_line

union Marked(label: string) is
    PLAIN(..)
    BOLD(weight: int, ..)
si

union Tagged(tag: string private, n: int) is
    ONE(..)
    TWO(extra: int, ..)
si

report(what: string, equal: bool, same_hash: bool) is
    write_line("{what}: equal {equal}, same hash {same_hash}")
si

compare(what: string, a: Marked, b: Marked) is
    report(what, a =~ b, a.get_hash_code() == b.get_hash_code())
si

compare(what: string, a: Tagged, b: Tagged) is
    report(what, a =~ b, a.get_hash_code() == b.get_hash_code())
si

compare("header only, same", Marked.PLAIN("a"), Marked.PLAIN("a"))
compare("header only, differ", Marked.PLAIN("a"), Marked.PLAIN("b"))
compare("own and header, same", Marked.BOLD(1, "a"), Marked.BOLD(1, "a"))
compare("own same, header differs", Marked.BOLD(1, "a"), Marked.BOLD(1, "b"))
compare("own differs, header same", Marked.BOLD(1, "a"), Marked.BOLD(2, "a"))
compare("different variants", Marked.PLAIN("a"), Marked.BOLD(1, "a"))

compare("private header, same", Tagged.ONE("a", 1), Tagged.ONE("a", 1))
compare("private header differs", Tagged.ONE("a", 1), Tagged.ONE("b", 1))
compare("public header differs", Tagged.ONE("a", 1), Tagged.ONE("a", 2))
compare("private differs beside own", Tagged.TWO(5, "a", 1), Tagged.TWO(5, "b", 1))

let seen = Collections.SET[Marked]()

seen.add(Marked.PLAIN("a"))
seen.add(Marked.PLAIN("a"))
seen.add(Marked.PLAIN("b"))

write_line("distinct in a set: {seen.count}")
