namespace Test is
    use IO.Std;

    // Tests: the `..` marker can sit on the parameter of any function
    // type along a formal's return spine, not only the outermost. The
    // N-ary function is then the one the caller's own lambda returns,
    // and is fitted to the tuple the pack binds to where it stands.

    run[T.., U](make: (int) -> T.. -> U, v: T) -> U => make(10)(v);

    run_twice[T.., U](make: (int) -> (int) -> T.. -> U, v: T) -> U => make(1)(2)(v);

    class SELF_APPLY[A, B](_f: (SELF_APPLY[A, B]) -> (A -> B)) is
        apply(r: SELF_APPLY[A, B]) -> (A -> B) => _f(r)
    si

    y[A.., B](f: (A -> B) -> A.. -> B) -> (A -> B) =>
        let wrap =
            SELF_APPLY[A, B](
                (r: SELF_APPLY[A, B]) => (a: A) => f(r.apply(r))(a))
        in wrap.apply(wrap);

    class Main is
        entry() static is
            // Adapted where the marker is one return in.
            Std.write_line("{run(n => (a, b) => a + b + n, (1, 2))}");

            // A one-parameter lambda needs no adaptation, and a
            // destructuring one is already the shape the pack asks for.
            Std.write_line("{run(n => v => v + n, 5)}");
            Std.write_line("{run(n => ((a, b)) => a + b + n, (1, 2))}");

            // Two returns in.
            Std.write_line("{run_twice(x => y => (a, b, c) => a + b + c + x + y, (1, 2, 3))}");

            // The higher-order case the marker exists for: the caller
            // writes the recursive step with its arguments spread out.
            let gcd =
                y[(int, int), int](
                    recurse => (a, b) => if b == 0 then a else recurse((b, a % b)) fi);

            Std.write_line("{gcd((1071, 462))}");

            return;
        si
    si
si
