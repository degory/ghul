use IO.Std.write_line

run() is
    let list = Collections.LIST[int]()
    list.add(10)
    list.add(20)

    let seen mut = 0

    for x in list do
        seen = seen + x

        if x == 10 then
            list.add(30)
        fi
    od

    write_line("snapshot {seen} now {list.count}")
si

run()
