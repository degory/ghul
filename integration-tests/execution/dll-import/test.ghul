namespace Test is
    use IO.Std.write_line;

    // Tests: a body-less static method carrying DllImport calls the
    // named function in the shared library. Covers a plain call, a
    // string argument marshalled to a native buffer, and an entry point
    // named apart from the ghūl method. libc is what CI runs on.

    class LIBC is
        @System.Runtime.InteropServices.DllImport("libc")
        abs(value: int) -> int static;

        @System.Runtime.InteropServices.DllImport("libc")
        strlen(text: string) -> word static;

        @System.Runtime.InteropServices.DllImport("libc", entry_point = "getpid")
        process_id() -> int static;

        init() is si
    si

    entry() is
        write_line("{LIBC.abs(-7)}");
        write_line("{LIBC.strlen("hello")}");

        // The process id the library reports is the one the runtime
        // reports: a value neither side can have made up.
        write_line("{LIBC.process_id() == System.Environment.process_id}");
    si
si
