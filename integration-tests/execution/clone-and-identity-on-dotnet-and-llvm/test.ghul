use IO.Std.write_line

// memberwise_clone makes a separate object holding the same fields, and a
// set over ReferenceEqualityComparer tells apart two objects with the same
// contents by their identity.
class POINT is
    x: int public
    y: int public

    init(x: int, y: int) is
        self.x = x
        self.y = y
    si

    copy() -> POINT => cast POINT?(memberwise_clone())!
si

entry() is
    let original = POINT(3, 4)
    let copy = original.copy()

    write_line("{copy.x} {copy.y} {copy == original}")

    copy.x = 5

    write_line("{original.x} {copy.x}")

    let seen = Collections.SET[object](Collections.ReferenceEqualityComparer.instance)

    seen.add(original)
    seen.add(copy)
    seen.add(original)

    write_line("{seen.count} {seen.contains(original)} {seen.contains(POINT(3, 4))}")

    let comparer = Collections.ReferenceEqualityComparer.instance

    write_line("{comparer.get_hash_code(original) == comparer.get_hash_code(original)}")
si
