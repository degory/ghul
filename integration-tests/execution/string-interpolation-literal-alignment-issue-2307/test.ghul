use IO.Std.write_line;

entry() is
    let name = "item";

    // an expression hole holding a string literal honours its
    // alignment and format clauses like any other expression would
    write_line("[{"item",-10}]");
    write_line("[{name,-10}]");
    write_line("[{"item",10}]");
    write_line("[{1234,-6}]");
    write_line("{"item":x}");
si
