use IO.Std.write_line;

width_of(w: int) -> string => "[{1234,w}]";

// an alignment expression whose type is only settled by deferred
// inference, not a literal or a typed local
run_inferred() -> string is
    let f = (w) => "[{1234,w}]";

    return f(10);
si

entry() is
    let name = "item";

    // an expression hole holding a string literal honours its
    // alignment and format clauses like any other expression would
    write_line("[{"item",-10}]");
    write_line("[{name,-10}]");
    write_line("[{"item",10}]");
    write_line("[{1234,-6}]");
    write_line("{"item":x}");

    write_line(run_inferred());
    write_line(width_of(8));
si
