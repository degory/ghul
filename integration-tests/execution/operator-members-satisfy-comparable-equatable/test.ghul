namespace Test is
    use IO.Std;

    // A type satisfies `Ghul.Comparable[T]` / `Ghul.Equatable[T]` by
    // declaring the operators themselves: the reflected interface
    // members arrive under their ghul operator names, so `<>` and `=~`
    // are what implements them.

    class BOX: Ghul.Comparable[BOX], Ghul.Equatable[BOX] is
        _v: int;

        init(v: int) is _v = v; si

        <>(other: BOX?) -> int => if other? then _v - other._v else 1 fi;
        =~(other: BOX?) -> bool => other? /\ _v == other._v;
    si

    order[T: Ghul.Comparable[T]](a: T, b: T) -> int => a.compare_to(b);

    class Main is
        entry() static is
            let a = BOX(3);
            let b = BOX(5);

            Std.write_line("a =~ b: {a =~ b}");
            Std.write_line("a =~ BOX(3): {a =~ BOX(3)}");
            Std.write_line("a !~ b: {a !~ b}");

            // reached through the interface, dispatching to the member
            let e: Ghul.Equatable[BOX] = a;
            Std.write_line("e =~ b: {e =~ b}");

            // a primitive's own comparisons keep their innate lowering:
            // the reflected `IComparable[int].CompareTo` member is hidden
            // from operator resolution so `<` stays a comparison opcode
            Std.write_line("3 < 5: {3 < 5}");
            Std.write_line("5 < 3: {5 < 3}");

            // `int` has no innate `=~`, so its reflected member serves it
            Std.write_line("3 =~ 3: {3 =~ 3}");
            Std.write_line("3 =~ 4: {3 =~ 4}");

            // the same reflected members stay reachable under their
            // ordinary names, so an explicit call resolves too
            let three = 3;
            let five = 5;

            Std.write_line("three.compare_to(five) < 0: {three.compare_to(five) < 0}");
            Std.write_line("five.compare_to(three) < 0: {five.compare_to(three) < 0}");
            Std.write_line("three.equals(3): {three.equals(3)}");
            Std.write_line("three.equals(4): {three.equals(4)}");

            // and through a bounded type parameter, where the member is
            // reached on the interface rather than on the concrete type
            Std.write_line("order(three, five): {order(three, five)}");
            Std.write_line("order(five, three): {order(five, three)}");

            // `string` has no innate order, so ordering one reaches
            // `System.String.CompareTo`. That is culture-sensitive, and
            // a case-crossing comparison answers differently under a
            // current culture than under invariant globalization. Only
            // orderings that hold either way are pinned here.
            Std.write_line("apple < banana: {"apple" < "banana"}");
            Std.write_line("banana < apple: {"banana" < "apple"}");
            Std.write_line("apple =~ apple: {"apple" =~ "apple"}");

            return;
        si
    si
si
