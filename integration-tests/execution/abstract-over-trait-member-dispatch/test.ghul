trait Renderable is
    render() -> string;

    describe() -> string => "described";
si

class Expr: Renderable abstract is
    init() is si

    render() -> string;

    describe() -> string;
si

class NUM: Expr is
    init() is super.init(); si

    render() -> string => "num";

    describe() -> string => "num described";
si

entry() is
    let n = NUM();
    let as_expr: Expr = n;
    let as_trait: Renderable = n;

    IO.Std.write_line(n.render());
    IO.Std.write_line(as_expr.render());
    IO.Std.write_line(as_trait.render());
    IO.Std.write_line(as_trait.describe());
si
