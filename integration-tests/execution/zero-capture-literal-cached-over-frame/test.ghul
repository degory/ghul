namespace Test is
    use IO.Std.write_line

    // A literal that captures nothing is built once and cached. The cached
    // delegate targets an instance method, so the call through it can be
    // devirtualised; these check it still runs, and is still built once,
    // from a class method, a static method and a global function.
    apply(f: (int) -> int, x: int) -> int => f(x)

    class SCALER is
        init() is si

        doubled(x: int) -> int => apply(n => n * 2, x)

        tripled(x: int) -> int static => apply(n => n * 3, x)

        same_delegate() -> bool is
            let a = make()
            let b = make()

            return object.reference_equals(a, b)
        si

        make() -> (int) -> int => n => n + 1
    si

    squared(x: int) -> int => apply(n => n * n, x)

    entry() is
        let scaler = SCALER()

        write_line("{scaler.doubled(5)} {SCALER.tripled(5)} {squared(5)}")
        write_line("built once: {scaler.same_delegate()}")

        let f = SCALER().make()

        write_line("target is an instance: {f.target?}")
    si
si
