namespace Lib is
    class T is
        v: int public;

        init(v: int) is self.v = v; si
    si

    // The operator's operands are `T`, so nothing about it is reachable
    // from the operand type: the import is the only route to it.
    class OPS is
        *(a: T, b: T) -> int static pure => a.v * b.v;
        -(a: T) -> int static pure => -a.v;
    si

    // A static operator on the operand's own type reaches another
    // namespace without an import.
    class SELF_OPS is
        w: int public;

        init(w: int) is self.w = w; si

        +(a: SELF_OPS, b: SELF_OPS) -> int static pure => a.w + b.w;
    si
si

namespace App is
    use IO.Std.write_line;

    use Lib.T;
    use Lib.SELF_OPS;
    use Lib.OPS.`*;
    use Lib.OPS.`-;

    entry() is
        let x = T(6);
        let y = T(7);

        write_line("{x * y}");
        write_line("{-x}");
        write_line("{SELF_OPS(2) + SELF_OPS(3)}");
    si
si
