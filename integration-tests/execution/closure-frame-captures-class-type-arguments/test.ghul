namespace Test is
    use IO.Std;

    // Tests: a function literal that captures, in a method of a generic
    // class, whose own signature names the class's type parameter. The
    // capture puts the body on a frame class, which is not the class
    // carrying that parameter, so the frame has to declare it.

    class HOLDER[X] is
        init() is si

        plain(p: X, sep: string) -> string is
            let f = (q: X) -> string => "{q}{sep}";

            return f(p);
        si

        tupled[Y](p: (X, Y), sep: string) -> string is
            let f = (q: (X, Y)) -> string => "{q.`0}{sep}{q.`1}";

            return f(p);
        si

        returned(p: X, sep: string) -> string is
            let f = (n: int) -> X => p;

            return "{f(0)}{sep}";
        si
    si

    class Main is
        entry() static is
            let h = HOLDER[int]();

            Std.write_line(h.plain(1, ":"));
            Std.write_line(h.tupled[string]((2, "a"), ":"));
            Std.write_line(h.returned(3, ":"));

            let g = HOLDER[string]();

            Std.write_line(g.tupled[int](("b", 4), "-"));

            return;
        si
    si
si
