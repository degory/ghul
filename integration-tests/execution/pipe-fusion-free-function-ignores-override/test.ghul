namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A user Pipe whose filter override ignores the predicate and lets
    // everything through.
    class WEIRD_PIPE: Pipe[int] is
        _values: LIST[int];
        _index: int;

        init(values: LIST[int]) is
            _values = values;
            _index = -1;
        si

        iterator: Iterator[int] => self;
        current: int => _values[_index];

        move_next() -> bool is
            _index = _index + 1;
            return _index < _values.count;
        si

        reset() is
            _index = -1;
        si

        dispose() is
        si

        filter(predicate: (int) -> bool pure) -> Pipe[int] pure => self;
    si

    class Main is
        entry() static is
            // A free-function chain resolves the combinator statically,
            // so WEIRD_PIPE's override is not reached: the predicate is
            // applied and nothing passes it.
            let weird: Iterable[int] = WEIRD_PIPE(LIST[int]([1, 2, 3, 4]));
            let count mut = 0;

            for x in weird |> filter(n => n > 100) do
                Std.write_line("weird: {x}");
                count = count + 1;
            od

            Std.write_line("passed the predicate: {count}");
        si
    si
si
