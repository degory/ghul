namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A user Pipe whose filter override ignores the predicate and lets
    // everything through, used to pin that a free-function chain does not
    // reach it. `Ghul.Pipes.filter` takes the pipe as an argument rather
    // than dispatching on it, so which filter runs is settled by the
    // function the call resolved to - which is what lets a chain fuse
    // whatever it starts from.
    class WEIRD_PIPE: Pipe[int] is
        _values: LIST[int];
        _index: int;

        init(values: LIST[int]) is
            _values = values;
            _index = -1;
        si

        iterator: Iterator[int] => self;
        current: int => _values[_index];

        move_next() -> bool is
            _index = _index + 1;
            return _index < _values.count;
        si

        reset() is
            _index = -1;
        si

        dispose() is
        si

        filter(predicate: (int) -> bool pure) -> Pipe[int] pure => self;
    si

    class Main is
        entry() static is
            let weird = WEIRD_PIPE(LIST[int]([1, 2, 3, 4]));
            // The free function's own filter runs, so the predicate is
            // applied and nothing passes it - the override is not reached.
            let count mut = 0;

            for x in weird |> filter(n => n > 100) do
                Std.write_line("weird: {x}");
                count = count + 1;
            od

            // Written out so the assertion is a line rather than the
            // absence of one: an empty snapshot would pass just as well
            // if the loop stopped running at all.
            Std.write_line("passed the predicate: {count}");
        si
    si
si
