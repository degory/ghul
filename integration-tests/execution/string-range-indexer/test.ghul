namespace Test is
    use Std = IO.Std;

    // A slice of a string is another string rather than a view onto it: a
    // substring is what a caller wants back, and .NET has no non-copying
    // one to hand out.
    class Main is
        entry() static is
            let s = "hello world";

            Std.write_line("drop last : '{s[0..<1]}'");
            Std.write_line("to the end: '{s[6..<0]}'");
            Std.write_line("head      : '{s[0..<6]}'");
            Std.write_line("last five : '{s[5..<<0]}'");
            Std.write_line("inclusive : '{s[0::<6]}'");
            Std.write_line("from start: '{s[0..5]}'");
            Std.write_line("incl start: '{s[0::4]}'");
            Std.write_line("plain     : {s[1]}");
        si
    si
si
