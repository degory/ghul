class SIMPLE: System.Attribute is
    init() is si
si

class SCALAR: System.Attribute is
    text: string public;
    number: int public;

    init(text: string, number: int) is
        self.text = text;
        self.number = number;
    si
si

class TARGETED: System.Attribute is
    kind: System.AttributeTargets public;

    init(kind: System.AttributeTargets) is
        self.kind = kind;
    si
si

class SERVICE is
    init() is si

    global_style_handler(@SIMPLE() @TARGETED(System.AttributeTargets.PARAMETER) id: int, name: string) -> string =>
        "{id}:{name}";

    scalar_argument_handler(id: int, @SCALAR("from-query", 7) query: string) -> string =>
        "{id}:{query}";
si

show_parameter_attributes(name: string, method: System.Reflection.MethodInfo) static is
    for p in method.get_parameters() do
        IO.Std.write_line("{name}.{p.name}:");

        for a in p.get_custom_attributes(false) do
            if isa SIMPLE(a) then
                IO.Std.write_line("  SIMPLE attribute present");
            fi

            let targeted = cast TARGETED?(a);
            if targeted? then
                IO.Std.write_line("  TARGETED kind={targeted.kind}");
            fi

            let scalar = cast SCALAR?(a);
            if scalar? then
                IO.Std.write_line("  SCALAR text={scalar.text} number={scalar.number}");
            fi
        od
    od
si

entry() static is
    let service_type = SERVICE().get_type();

    show_parameter_attributes("global_style_handler", service_type.get_method("global_style_handler")!);
    show_parameter_attributes("scalar_argument_handler", service_type.get_method("scalar_argument_handler")!);

    IO.Std.write_line(SERVICE().global_style_handler(1, "alice"));
    IO.Std.write_line(SERVICE().scalar_argument_handler(2, "bob"));

    return;
si
