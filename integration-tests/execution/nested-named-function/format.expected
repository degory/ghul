use IO.Std.write_line

entry() is
    double(x: int) -> int => x * 2

    write_line("{double(21)}")

    describe(x: int) -> string is
        if x > 10 then
            return "big"
        fi

        "small"
    si

    write_line("{describe(3)} {describe(30)}")

    let base = 100

    add_base(x) => x + base

    write_line("{add_base(5)}")

    let total mut = 0

    accumulate(x: int) is
        total = total + x
    si

    accumulate(3)
    accumulate(4)

    write_line("total {total}")

    outer(x: int) -> int is
        inner(y: int) -> int => y * y

        inner(x) + 1
    si

    write_line("{outer(4)}")
si
