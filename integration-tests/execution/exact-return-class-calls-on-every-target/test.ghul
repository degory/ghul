use IO.Std.write_line

trait Shape is
    area() -> int
si

class SQUARE: Shape is
    side: int
    init(side: int) is self.side = side si
    area() -> int => side * side
si

class CIRCLE: Shape is
    init() is si
    area() -> int => 3
si

make_square(n: int) -> Shape => SQUARE(n)

make_any(n: int) -> Shape => if n > 2 then SQUARE(n) else CIRCLE() fi

maybe_square(n: int) -> Shape? => if n > 0 then SQUARE(n) else null fi

mixed(n: int, other: Shape) -> Shape is
    let result: Shape mut = SQUARE(n)

    if n > 5 then
        result = other
    fi

    return result
si

run() is
    let s = make_square(4)
    write_line("{s.area()}")

    let a = make_any(1)
    write_line("{a.area()}")

    let m = mixed(6, CIRCLE())
    write_line("{m.area()}")

    let absent = maybe_square(0)

    try
        write_line("{absent!.area()}")
    catch e: Ghul.Exception
        write_line("absent")
    yrt

    write_line("{maybe_square(2)!.area()}")
si

run()
