// The wasm engine can say whether a standard stream is a terminal. A test
// run has none, so each answer is false, and so is a stream that does not
// exist.
use IO.Std.write_line

@intrinsic("host.is_terminal")
is_terminal(stream: int) -> bool => false

entry() is
    write_line("input: {is_terminal(0)}")
    write_line("output: {is_terminal(1)}")
    write_line("error: {is_terminal(2)}")
    write_line("none: {is_terminal(7)}")
si
