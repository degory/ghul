namespace Test is
    use Std = IO.Std;

    trait DESCRIBED is
        describe() -> string;
    si

    class HOLDER is
        _n: int;

        init(n: int) is
            _n = n;
        si

        _double() -> int => _n * 2;
    si

    partial HOLDER is
        // direct access from a partial-block method: already worked
        direct() -> int => _n;

        // access from lambdas inside a partial-block method
        via_lambda() -> int is
            let read = () -> int => _n;
            let doubled = () -> int => _double();
            return read() + doubled();
        si
    si

    impl DESCRIBED for HOLDER is
        // access from a lambda inside an impl-block method
        describe() -> string is
            let read = () -> int => _n;
            return "n={read()}";
        si
    si

    class Main is
        entry() static is
            let h = HOLDER(21);
            Std.write_line("{h.direct()}");
            Std.write_line("{h.via_lambda()}");
            Std.write_line("{h.describe()}");
        si
    si
si
