namespace Test is
    use Std = IO.Std;

    class Main is
        run() -> Tasks.TASK static is
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("outer");

                await Tasks.TASK.yield();

                let inner = () => seen.add("inner");

                inner();
            si;

            await body();

            Std.write_line("{seen.count} {seen[0]} {seen[1]}");
        si

        entry() static is
            run().wait();
        si
    si
si
