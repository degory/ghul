// A source type declaring an operator as a member does not unsettle
// the analysis of the same operator over unrelated operands: the
// store-free analysis runs with resolved types, so `(x % 3) + 1`
// binds to the int intrinsics however many member `+` declarations
// are in scope, `g` proves store-free, and the literal calling it
// satisfies the pure function-typed parameter. The member operator
// itself still works.

use Std = IO.Std;

class VEC is
    n: int;
    init(n: int) is self.n = n; si
    +(other: VEC) -> VEC => VEC(n + other.n);
si

g(x: int) -> int => (x % 3) + 1;

apply(f: (int) -> int pure, x: int) -> int pure => f(x);

entry() is
    Std.write_line("{apply(i => g(i), 7)}");
    Std.write_line("{(VEC(1) + VEC(2)).n}");
si
