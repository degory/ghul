namespace Test is
    use Std = IO.Std;

    class BOX is
        value: int;
        init(value: int) is self.value = value; si
    si

    struct POINT is
        x: int;
        y: int;
    si

    class Main is
        zero() -> int static => _;

        zero_block() -> int static is
            return _;
        si

        is_null(b: BOX) -> bool static => !b?;

        entry() static is
            // context type from a `let` annotation
            let i: int = _;
            Std.out.write_line("default int: {i}");

            // explicit type argument pins the type directly
            let q = _[int];
            Std.out.write_line("_[int]: {q}");

            // explicit type argument for a reference type defaults to null
            let qb = _[BOX];
            Std.out.write_line("_[BOX] is null: {!qb?}");

            let b: bool = _;
            Std.out.write_line("default bool: {b}");

            // reference type defaults to null
            let box: BOX = _;
            Std.out.write_line("default BOX is null: {!box?}");

            // value-type struct defaults to all-zero
            let p: POINT = _;
            Std.out.write_line("default POINT: {p.x}, {p.y}");

            // assignment RHS picks up the target type
            let j mut = 99;
            j = _;
            Std.out.write_line("after j = _: {j}");

            // return and argument positions
            Std.out.write_line("zero(): {zero()}");
            Std.out.write_line("zero_block(): {zero_block()}");
            Std.out.write_line("is_null(_): {is_null(_)}");

            // a tuple literal element takes the element type
            let pair: (int, int) = (1, _);
            Std.out.write_line("tuple: {pair.`0}, {pair.`1}");

            // discard positions keep their binding meaning, not default:
            // a plain discard, and destructure leaves.
            let _ = 7;
            let (_, second) = (1, 2);
            Std.out.write_line("destructure: {second}");

            // a discard formal in a multi-arg lambda
            let f = (_, y) => y;
            Std.out.write_line("lambda multi-arg: {f(10, 3)}");

            // a single-arg discard formal
            let g = _ => 4;
            Std.out.write_line("lambda single-arg: {g(0)}");

            // a destructure formal
            let h = ((a, b2)) => a + b2;
            Std.out.write_line("lambda destructure: {h((4, 5))}");

            // a typed discard formal
            let typed = (_: int) => 9;
            Std.out.write_line("lambda typed discard: {typed(0)}");

            for _ in 1::2 do
                Std.out.write_line("loop");
            od
        si
    si
si
