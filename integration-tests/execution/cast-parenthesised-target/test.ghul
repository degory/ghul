namespace Test is
    use Std = IO.Std;

    class BOX is
        v: int;

        init(v: int) is self.v = v; si
    si

    triple(x: int) -> int => x * 3;

    class Main is
        entry() static is
            // `cast (X)(args)` reads two ways: a cast to the
            // parenthesised type `X` taking `args` as its value, or a
            // cast of the value `X` whose result is called with `args`.
            // Which is meant is decided by what `X` turns out to name.

            // A type name: the parentheses are the target's, and the
            // arguments are the value being converted.
            let count = 3;

            let widened = cast (double)(count);
            Std.out.write_line("type target: {widened}");

            let boxed: object = BOX(7);
            let unboxed = cast (BOX)(boxed);
            Std.out.write_line("class target: {unboxed.v}");

            // A value: the parentheses are the cast's, and the
            // arguments call the result. The target the cast is
            // waiting for is the function type the call determines -
            // the argument types with the call's own expected type as
            // the return.
            let held: object = triple;

            let tripled: int = cast(held)(count);
            Std.out.write_line("value target: {tripled}");

            // Written unambiguously, with the cast's own parentheses,
            // the same call means the same thing.
            let again: int = (cast(held))(count);
            Std.out.write_line("parenthesised: {again}");

            // The target of an ordinary elided cast is still the type
            // the context asks for, not the shape of any call.
            let plain: double = cast(count);
            Std.out.write_line("elided: {plain}");

            return;
        si
    si
si
