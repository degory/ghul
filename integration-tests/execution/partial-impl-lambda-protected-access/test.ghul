namespace Test is
    use Std = IO.Std;

    class HOLDER is
        _n: int;
        init(n: int) is _n = n; si
    si

    partial HOLDER is
        // under the protected policy the accessing type is the target
        // itself, so a lambda in the block reaches the member
        via_lambda() -> int is
            let read = () -> int => _n;
            return read();
        si
    si

    class Main is
        entry() static is
            let h = HOLDER(9);
            Std.write_line("{h.via_lambda()}");
        si
    si
si
