namespace Test is
    use Std = IO.Std;

    // Both the function and the literal inside it compile into state
    // machines, and both carry the same type parameter. The function's
    // own use of it comes after the literal's body, so the position the
    // parameter renders at has to survive the literal being emitted.
    class HOLDER is
        run[U](extra: U) -> Tasks.TASK static is
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("inner {extra}");

                await Tasks.TASK.yield();
            si;

            await body();

            let kept = Collections.LIST[U]();
            kept.add(extra);

            await Tasks.TASK.yield();

            Std.write_line("{seen[0]} outer {kept[0]}");
        si
    si

    class BOX[T] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        run() -> Tasks.TASK is
            let held = _value;
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("inner {held}");

                await Tasks.TASK.yield();
            si;

            await body();

            let kept = Collections.LIST[T]();
            kept.add(_value);

            await Tasks.TASK.yield();

            Std.write_line("{seen[0]} outer {kept[0]}");
        si
    si

    class Main is
        entry() static is
            HOLDER.run(7).wait();
            BOX[string]("held").run().wait();
        si
    si
si
