use IO.Std.write_line

// Thread takes a ThreadStart, with no parameters, or a
// ParameterizedThreadStart, with one: a literal's own parameter count
// says which.
let no_parameters = System.Threading.Thread(() -> void is write_line("no parameters") si, 1048576)
no_parameters.start()
no_parameters.join()

let one_parameter = System.Threading.Thread(x => write_line("one parameter: {x}"), 1048576)
one_parameter.start("p")
one_parameter.join()
