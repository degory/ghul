use IO.Std.write_line

enum Colour is
    RED,
    GREEN
si

class HOLDER is
    colour: Colour public
    day: System.DayOfWeek public

    init() is
        colour = Colour.GREEN
        day = System.DayOfWeek.FRIDAY
    si
si

let holder = HOLDER()
let properties = (typeof HOLDER).get_properties()

write_line("colour: {cast int(cast Colour(properties[0].get_value(holder)))}")
write_line("day: {cast int(cast System.DayOfWeek(properties[1].get_value(holder)))}")
