// Two operator interfaces joined with `/\`: the function adds and
// subtracts through separate bounds instead of demanding the whole
// numeric tower.

namespace Test is
    use IO.Std;

    use System.Numerics.IAdditionOperators;
    use System.Numerics.IAdditionOperators.`+;
    use System.Numerics.ISubtractionOperators;
    use System.Numerics.ISubtractionOperators.`-;

    around[T: IAdditionOperators[T, T, T] /\ ISubtractionOperators[T, T, T]](a: T, b: T) -> T => (a + b) - b;

    class Main is
        entry() static is
            Std.write_line("{around(3, 4)}");
        si
    si
si
