namespace Test is
    use Collections;
    use Std = IO.Std;

    class ANIMAL open is
        init() is si
    si

    class PET: ANIMAL open is
        init() is super.init(); si
    si

    class CAT: PET is
        init() is super.init(); si
    si

    // Neither formal is the actual's own type, so both are reached by
    // widening and score alike. The nearer ancestor is the one that
    // widened less.
    describe(a: ANIMAL) -> string => "ANIMAL";
    describe(p: PET) -> string => "PET";

    // The same question between two traits the actual implements.
    accepts(x: Iterable[int]) -> string => "Iterable";
    accepts(x: List[int]) -> string => "List";

    class Main is
        entry() static is
            Std.write_line(describe(CAT()));
            Std.write_line(accepts(LIST[int]()));

            return;
        si
    si
si
