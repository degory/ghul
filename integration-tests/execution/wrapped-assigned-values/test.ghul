// A value wrapped onto a later line is read across the boundary however it
// is laid out: dedented past the statement it belongs to, level with it, or
// indented under it. Nothing about a program that parses depends on its
// indentation, and the speculation that recovers a half-written assignment
// must leave every one of these alone.
namespace TEST.WrappedAssignedValues is
    use IO.Std.write_line

    entry() is
        let dedented =
    1 + 2

        let level =
        3 + 4

        let indented =
                5 + 6

        let total mut = 0

        total =
    dedented + level

        total =
                total + indented

        let chained =
            if total > 0 then
                total * 2
            else
                0
            fi

        let wrapped_call =
        add(
            total,
            chained)

        write_line("{dedented} {level} {indented} {total} {chained} {wrapped_call}")

        let in_expression = (let inner = 
        7 in inner * 3)

        write_line("{in_expression}")
    si

    add(a: int, b: int) -> int => a + b
si
