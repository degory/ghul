namespace Test is
    use IO.Std.write_line;

    // Tests: a lambda nested inside another lambda takes its parameter
    // type from the enclosing function's declared return type, even
    // where that return type is written in terms of the function's own
    // type parameter. Church numerals are the shape that needs it -
    // every numeral and every operation over them is two lambdas deep.

    zero[T]() -> ((T) -> T) -> (T) -> T => f => x => x;

    successor[T](n: ((T) -> T) -> (T) -> T) -> ((T) -> T) -> (T) -> T =>
        f => x => f(n(f)(x));

    add[T](a: ((T) -> T) -> (T) -> T, b: ((T) -> T) -> (T) -> T) -> ((T) -> T) -> (T) -> T =>
        f => x => a(f)(b(f)(x));

    multiply[T](a: ((T) -> T) -> (T) -> T, b: ((T) -> T) -> (T) -> T) -> ((T) -> T) -> (T) -> T =>
        f => a(b(f));

    to_int(n: ((int) -> int) -> (int) -> int) -> int => n(x => x + 1)(0);

    class Main is
        entry() static is
            let zero_ = zero[int]();
            let one = successor[int](zero_);
            let two = successor[int](one);
            let three = add[int](one, two);
            let six = multiply[int](two, three);

            write_line("{to_int(zero_)} {to_int(one)} {to_int(two)} {to_int(three)} {to_int(six)}");
        si
    si
si
