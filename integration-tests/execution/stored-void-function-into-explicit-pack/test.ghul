use default

// A stored function value of an N-ary function type, going into a formal
// that takes the pack spread out, with the pack's type argument written
// at the call rather than inferred. The void and value-returning shapes
// both have to reach the adaptation.
run[T..](v: T, action: (T..) -> void) => action(v)

apply_to[T.., U](v: T, f: (T..) -> U) -> U => f(v)

pack_each[T..](source: Iterable[T], action: (T..) -> void) is
    for element in source do
        action(element)
    od
si

let show = (left: int, right: int) => write_line("{left}-{right}")

run((1, 2), show)
run[(int, int)]((3, 4), show)

let describe: (string, int) -> void = (name, count) => write_line("{name}: {count}")
run[(string, int)](("cats", 3), describe)

let add = (left: int, right: int) => left + right
write_line("{apply_to[(int, int), int]((5, 6), add)}")

pack_each[(int, int)]([(7, 8), (9, 10)], show)
