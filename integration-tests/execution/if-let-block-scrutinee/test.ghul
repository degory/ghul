use IO.Std.write_line

// A block written as the first clause's scrutinee of an `if let`
// declares its locals in the arm's scope, where the scrutinee is
// resolved, and the arm runs with its value.
first_clause(c: bool) is
    if let x = (let t = if c then "block" fi; t) then
        write_line("first clause: {x}")
    else
        write_line("first clause: absent")
    fi
si

typed_and_guarded() is
    if let x: string = (let t: object = "typed"; t) /\ x.length > 0 then
        write_line("typed: {x}")
    fi
si

second_clause() is
    if let y = "outer", x = (let t = "{y} and block"; t) then
        write_line("second clause: {x}")
    fi
si

first_clause(true)
first_clause(false)
typed_and_guarded()
second_clause()
