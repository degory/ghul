use IO.Std.write_line

// A reference to an element of an array of a kind narrower than an int
// reads and writes the element, whatever its width, and a method called
// on such an element sees its value.
bump_byte(x: ubyte ref) is x! = x! + 1ub si
bump_signed(x: byte ref) is x! = x! - 1b si
bump_short(x: short ref) is x! = x! + 1000s si
next_char(x: char ref) is x! = cast char(int(x!) + 1) si
flip(x: bool ref) is x! = !x! si

entry() is
    let bytes = [1ub, 255ub, 3ub]
    let signed = [-127b, 0b]
    let shorts = [32000s, 5s]
    let chars = ['a', 'y']
    let flags = [true, false]

    bump_byte(bytes[1] ref)
    bump_signed(signed[0] ref)
    bump_short(shorts[0] ref)
    next_char(chars[1] ref)
    flip(flags[0] ref)

    write_line("{bytes[0]} {bytes[1]} {bytes[2]}")
    write_line("{signed[0]} {signed[1]}")
    write_line("{shorts[0]} {shorts[1]}")
    write_line("{chars[0]}{chars[1]} {chars[1].to_string()}")
    write_line("{flags[0]} {flags[1]}")
si
