// A recursive lambda literal's self-call goes through its own
// not-yet-known type: even when the body is otherwise store-free, the
// self-call must not be conservatively treated as impure just because
// the closure's own promotion to a pure function type happens after
// the body has already been walked.
namespace Test is
    use Std = IO.Std;

    take_pure(f: (int) -> int pure) -> int pure => f(6);

    class Main is
        entry() static is
            let fib = n rec => if n < 2 then n else rec(n - 1) + rec(n - 2) fi;

            Std.write_line("{take_pure(fib)}");

            let fib_via_local = (n: int) -> int rec =>
                let fib_via_local = rec in
                if n < 2 then n else fib_via_local(n - 1) + fib_via_local(n - 2); fi;

            Std.write_line("{take_pure(fib_via_local)}");

            return;
        si
    si
si
