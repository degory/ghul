// Statement terminators inferred at end of line: statement lists, member
// declarations, use aliases, paren blocks, tuples and destructures all
// parse without written semicolons.
use IO.Std.write_line

use Aliased = string

class BOX is
    _value: int

    value: int => _value

    init(value: int) is
        _value = value
    si

    doubled() -> int => _value * 2

    =~(other: BOX) -> bool => _value == other._value

    get_hash_code() -> int => _value
si

add(a: int, b: int) -> int is
    let result = a + b
    return result
si

label(s: Aliased) -> string => "<{s}>"

entry() is
    let xs = [1, 2, 3]
    let total mut = 0

    for x in xs do
        total = add(total, x)
        write_line("{x}")
    od

    let box = BOX(total)
    write_line("{box.value} {box.doubled()}")
    write_line("{box =~ BOX(6)}")

    let pair = (10, "ten")
    let (n, s) = pair
    write_line("{n} {s}")

    let block = (
        let y = 5
        write_line("in block")
        y * 2
    )
    write_line("block {block}")

    write_line(label("done"))

    if total > 3 then
        write_line("big")
        return
    fi

    write_line("unreachable")
si
