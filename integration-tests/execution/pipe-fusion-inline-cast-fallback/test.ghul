namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;
    use Collections;

    // A map/filter stage lambda whose body contains a `cast` disqualifies
    // itself from pipe-fusion's inlining: `cast` compiles in two steps,
    // and only the delegate-function compilation path gets the second,
    // generate-il-time walk that fills in its placeholder. The chain still
    // fuses around such a stage - only the stage itself falls back to a
    // delegate call.
    //
    // Both source kinds are covered because the fallback runs per stage
    // rather than per source: an array and a collection reach the same
    // lowering, and pinning both keeps that true.
    class ANIMAL is
        init() is si
    si

    class CAT: ANIMAL is
        name: string;
        init(name: string) is self.name = name; si
    si

    class Main is
        entry() static is
            let from_array: ANIMAL[] = [CAT("felix"), CAT("tom")];

            for cat in from_array |> map(a => cast CAT?(a)!) do
                write_line("array: {cat.name}");
            od

            let from_list = LIST[ANIMAL]();
            from_list.add(CAT("felix"));
            from_list.add(CAT("tom"));

            for cat in from_list |> map(a => cast CAT?(a)!) do
                write_line("list: {cat.name}");
            od

            return;
        si
    si
si
