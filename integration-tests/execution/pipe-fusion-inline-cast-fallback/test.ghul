namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;

    // A map/filter stage lambda whose body contains a `cast` disqualifies
    // itself from Stage-B inlining (ghul#1858): `cast` compiles in two
    // steps, and only the delegate-function compilation path gets the
    // second, generate-il-time walk that fills in its placeholder. The
    // chain still fuses around it - only this stage falls back to a
    // delegate call - so both thread-first and fluent forms, written
    // directly in a `for` loop header, still run.
    class ANIMAL is
        init() is si
    si

    class CAT: ANIMAL is
        name: string;
        init(name: string) is self.name = name; si
    si

    class Main is
        entry() static is
            let animals: ANIMAL[] = [CAT("felix"), CAT("tom")];

            for cat in animals |> map(a => cast CAT?(a)!) do
                write_line("thread-first: {cat.name}");
            od

            for cat in animals | .map(a => cast CAT?(a)!) do
                write_line("fluent: {cat.name}");
            od

            return;
        si
    si
si
