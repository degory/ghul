namespace Test is
    use Std = IO.Std;
    use IO.FileAttributes;
    use System.Diagnostics.Tracing.EventKeywords;

    // An enum's bitwise operators are supplied per enum type, which
    // means they are supplied at both the places an enum symbol is
    // built. This one is imported rather than declared here, so it
    // exercises the reflected path, gated on the reflected type's own
    // FlagsAttribute rather than on a pragma; `enum-bitwise-operators`
    // covers the source path. Both FileAttributes and EventKeywords
    // carry FlagsAttribute in the BCL. FileAttributes is 32-bit;
    // EventKeywords is 64-bit, which exercises the wider IL load/store
    // the ordering and equality operators already cover for reflected
    // enums.

    class Main is
        entry() static is
            let read_only = FileAttributes.READ_ONLY;
            let hidden = FileAttributes.HIDDEN;
            let both = read_only | hidden;

            Std.out.write_line("READ_ONLY | HIDDEN has READ_ONLY: {(both & read_only) == read_only}");
            Std.out.write_line("READ_ONLY | HIDDEN has HIDDEN: {(both & hidden) == hidden}");
            Std.out.write_line("READ_ONLY ^ READ_ONLY == 0: {(read_only ^ read_only) == cast FileAttributes(0)}");

            let none = EventKeywords.NONE;
            let all = EventKeywords.ALL;

            Std.out.write_line("\\NONE == ALL: {\none == all}");
            Std.out.write_line("NONE | ALL == ALL: {(none | all) == all}");

            return;
        si
    si
si
