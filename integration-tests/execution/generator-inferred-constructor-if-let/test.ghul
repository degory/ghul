namespace Test is
    use Std = IO.Std;

    union Tree[T] is
        EMPTY;
        NODE(value: T, left: Tree[T], right: Tree[T]);
    si

    class Main is
        levelorder[T](tree: Tree[T]) -> Ghul.Pipes.Pipe[T] static is
            let pending = Collections.Queue();

            pending.enqueue(tree);

            while pending.count > 0 do
                let node = pending.dequeue();

                if let (value, left, right): Tree.NODE = node then
                    yield value;

                    pending.enqueue(left);
                    pending.enqueue(right);
                fi
            od
        si

        entry() static is
            let leaf_2 = Tree.NODE(2, Tree.EMPTY[int], Tree.EMPTY[int]);
            let leaf_3 = Tree.NODE(3, Tree.EMPTY[int], Tree.EMPTY[int]);
            let tree = Tree.NODE(1, leaf_2, leaf_3);

            for v in levelorder(tree) do
                Std.write_line("v: {v}");
            od
        si
    si
si
