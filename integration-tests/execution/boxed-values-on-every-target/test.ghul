use IO.Std.write_line

// Scalars and structs held as object or behind a trait: their own methods
// reached through the box, type tests and casts back, optional casts, and a
// generic method calling a value's own method.
struct POINT(x: int public, y: int public) is
    to_string() -> string => "({x}, {y})"
si

total(values: Collections.Iterable[int]) -> int is
    let sum mut = 0

    for v in values do
        sum = sum + v
    od

    return sum
si

text_of[T](value: T) -> string is
    let text: string? = value.to_string()

    return text ?? ""
si

describe(o: object) -> string is
    let text: string? = o.to_string()

    return text ?? ""
si

entry() is
    let n: object = 42
    let d: object = 2.5
    let p: object = POINT(3, 4)
    let s: object = "x"

    write_line("{describe(n)} {describe(d)} {describe(p)}")
    write_line("{total(1::4)}")

    if let q: POINT = p then
        write_line("{q.x + q.y}")
    fi

    write_line("{cast int?(n) ?? -1} {cast int?(s) ?? -1} {cast char?(n)?} {cast POINT?(n)?}")
    write_line("{text_of(7)} {text_of("y")} {text_of(POINT(1, 2))} {text_of(9n)}")
si
