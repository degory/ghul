use IO.Std.write_line

// A member redeclaring an inherited one with a narrower reference return
// type overrides it: a caller holding the base type, or a trait the
// member implements, reaches the narrower member.

class SHAPE is
    init() is si
    name() -> string => "shape"
si

class CIRCLE: SHAPE is
    init() is super.init() si
    name() -> string => "circle"
si

class BIG: CIRCLE is
    init() is super.init() si
    name() -> string => "big circle"
si

class FACTORY is
    init() is si
    make() -> SHAPE => SHAPE()
si

class CIRCLE_FACTORY: FACTORY is
    init() is super.init() si
    make() -> CIRCLE => CIRCLE()
si

class BIG_FACTORY: CIRCLE_FACTORY is
    init() is super.init() si
    make() -> BIG => BIG()
si

class BOX_FACTORY[T] is
    init() is si
    make(x: T) -> SHAPE => SHAPE()
si

class GENERIC_CIRCLE_FACTORY[T]: BOX_FACTORY[T] is
    init() is super.init() si
    make(x: T) -> CIRCLE => CIRCLE()
si

class OF[T] is
    init() is si
    get() -> T => cast T(SHAPE())
si

class CIRCLES: OF[SHAPE] is
    init() is super.init() si
    get() -> CIRCLE => CIRCLE()
si

trait Maker is
    make() -> SHAPE;
si

class CIRCLE_MAKER: Maker is
    init() is si
    make() -> CIRCLE => CIRCLE()
si

struct STRUCT_MAKER: Maker is
    tag: int
    init() is tag = 1 si
    make() -> CIRCLE => CIRCLE()
si

trait Of[T] is
    make(x: T) -> SHAPE;
si

class INT_MAKER: Of[int] is
    init() is si
    make(x: int) -> CIRCLE => CIRCLE()
si

class ANY_MAKER[T]: Of[T] is
    init() is si
    make(x: T) -> CIRCLE => CIRCLE()
si

let factory: FACTORY = CIRCLE_FACTORY()
write_line("through the base: {factory.make().name()}")

let circle: CIRCLE = CIRCLE_FACTORY().make()
write_line("through its own type: {circle.name()}")

let deeper: FACTORY = BIG_FACTORY()
write_line("two levels down, through the base: {deeper.make().name()}")

let middle: CIRCLE_FACTORY = BIG_FACTORY()
write_line("two levels down, through the middle: {middle.make().name()}")

let generic: BOX_FACTORY[int] = GENERIC_CIRCLE_FACTORY[int]()
write_line("generic base: {generic.make(1).name()}")

let of: OF[SHAPE] = CIRCLES()
write_line("type-parameter return: {of.get().name()}")

let maker: Maker = CIRCLE_MAKER()
write_line("through a trait: {maker.make().name()}")

let struct_maker: Maker = STRUCT_MAKER()
write_line("a struct through a trait: {struct_maker.make().name()}")

let int_maker: Of[int] = INT_MAKER()
write_line("an instantiated generic trait: {int_maker.make(1).name()}")

let any_maker: Of[string] = ANY_MAKER[string]()
write_line("a generic trait on a generic class: {any_maker.make("x").name()}")
