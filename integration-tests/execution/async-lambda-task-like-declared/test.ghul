namespace Test is
    use Std = IO.Std;

    use System.Runtime.CompilerServices.IAsyncStateMachine;
    use System.Runtime.CompilerServices.ICriticalNotifyCompletion;
    use System.Runtime.CompilerServices.INotifyCompletion;

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER[_]))
    class COROUTINE[T] is
        value: T public;
        completed: bool public;

        init() is si
    si

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER))
    class COROUTINE is
        completed: bool public;

        init() is si
    si

    // Parks its continuation on a queue the test drains.
    struct PAUSE: ICriticalNotifyCompletion is
        _queue: Collections.Queue[() -> void];

        init(queue: Collections.Queue[() -> void]) is _queue = queue; si

        get_awaiter() -> PAUSE => self;
        is_completed: bool => false;
        get_result() is si
        on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
        unsafe_on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
    si

    class COROUTINE_BUILDER[T] is
        _coroutine: COROUTINE[T]?;

        init() is si

        create() -> COROUTINE_BUILDER[T] static => COROUTINE_BUILDER[T]();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: COROUTINE[T] is
            if !_coroutine? then
                _coroutine = COROUTINE[T]();
            fi
            return _coroutine;
        si

        set_result(v: T) is
            task.value = v;
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("coroutine failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    class COROUTINE_BUILDER is
        _coroutine: COROUTINE?;

        init() is si

        create() -> COROUTINE_BUILDER static => COROUTINE_BUILDER();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: COROUTINE is
            if !_coroutine? then
                _coroutine = COROUTINE();
            fi
            return _coroutine;
        si

        set_result() is
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("coroutine failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    // A function literal declares a task-like return type and is
    // driven through that type's builder, exactly as a named
    // function is: the value-less form completes the handle when
    // the body falls off the end, the value form delivers its
    // return.
    class MAIN is
        entry() static is
            let queue = Collections.Queue[() -> void]();

            let ticker = (name: string) -> COROUTINE is
                Std.write_line("{name} before");
                await PAUSE(queue);
                Std.write_line("{name} after");
            si;

            let doubler = (v: int) -> COROUTINE[int] is
                await PAUSE(queue);
                return v * 2;
            si;

            let t = ticker("tick");
            let d = doubler(21);

            Std.write_line("suspended: {!t.completed} {!d.completed}");

            while queue.count > 0 do
                queue.dequeue()();
            od

            Std.write_line("completed: {t.completed} {d.completed} value={d.value}");
        si
    si
si
