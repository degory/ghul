namespace Test is
    use IO.Std;

    class BOX: Ghul.Comparable[BOX], Ghul.Equatable[BOX] is
        _v: int;
        init(v: int) is _v = v; si
        <>(other: BOX?) -> int => if other? then _v - other._v else 1 fi;
        =~(other: BOX?) -> bool => other? /\ _v == other._v;
    si

    class Main is
        entry() static is
            let a = BOX(3);
            let b = BOX(5);
            // both arities of the colliding name resolve as a group, so
            // the generic one is reachable as a variable's type here
            let c: Ghul.Comparable[BOX] = a;
            Std.write_line("{isa BOX(c)}");
            let e: Ghul.Equatable[BOX] = a;
            Std.write_line("{e =~ b}");
            Std.write_line("{e =~ BOX(3)}");
            return;
        si
    si
si
