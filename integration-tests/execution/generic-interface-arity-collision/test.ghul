namespace Test is
    use IO.Std;

    class BOX: Ghul.Comparable[BOX], Ghul.Equatable[BOX] is
        _v: int;
        init(v: int) is _v = v; si
        compare_to(other: BOX?) -> int => if other? then _v - other._v else 1 fi;
        equals(other: BOX?) -> bool => other? /\ _v == other._v;
    si

    class Main is
        entry() static is
            let a = BOX(3);
            let b = BOX(5);
            let c: Ghul.Comparable[BOX] = a;
            Std.write_line("{c.compare_to(b)}");
            let e: Ghul.Equatable[BOX] = a;
            Std.write_line("{e.equals(b)}");
            Std.write_line("{e.equals(BOX(3))}");
            return;
        si
    si
si
