namespace Test is
    use Std = IO.Std;

    class Main is
        counting(limit: int) -> Ghul.Pipes.Pipe[int] static is
            let i mut = 0;
            while i < limit do
                yield i;
                i = i + 1;
            od
        si

        repeating[T](value: T, times: int) -> Ghul.Pipes.Pipe[T] static is
            let i mut = 0;
            while i < times do
                yield value;
                i = i + 1;
            od
        si

        entry() static is
            Std.write_line("{counting(3)}");
            Std.write_line("{repeating("x", 2)}");
            Std.write_line(counting(2).to_string());
        si
    si
si
