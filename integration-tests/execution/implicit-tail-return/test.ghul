// Implicit tail returns: a final statement that reaches the body's
// terminator without its `;` is the function's return value on the
// fall-through path. Void bodies tolerate any tail; a trailing `;`
// keeps the statement reading.

namespace Test is
    use Std = IO.Std;
    class MAIN is
        entry() static is
            Std.write_line("{plain_tail(3, 5)}");
            Std.write_line("{if_tail(false)}");
            Std.write_line("{case_tail(7)}");
            Std.write_line("{getter.value}");
            Std.write_line("{closure()(2)}");
        si
    si

    plain_tail(w: int, h: int) -> int is
        let doubled = w * 2;
        let trimmed = h - 1;

        doubled * trimmed
    si

    if_tail(c: bool) -> string is
        if c then
            "yes"
        else
            "no"
        fi
    si

    case_tail(n: int) -> string is
        case n
        when 1 then "one"
        when 2 then "two"
        else "many"
        esac
    si

    class GETTER is
        _v: int;

        init(v: int) is _v = v; si

        value: int is
            _v * 2
        si
    si

    getter: GETTER is
        GETTER(21)
    si

    closure() -> (int) -> int pure is
        let factor = 10;

        (n) => n * factor
    si
si
