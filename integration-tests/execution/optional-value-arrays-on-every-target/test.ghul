use IO.Std.write_line

entry() is
    let xs: (n: int, s: string)?[] = [null, (n = 1, s = "a")]

    write_line("{xs[0]?.n} {xs[1]?.s}")

    let ys: int?[] = [3, null, 5]
    write_line("{ys[0]} {ys[1]} {ys[2]}")

    let m = Collections.MAP[int, (n: int, s: string)?]()
    m[1] = (n = 2, s = "b")
    m[2] = null
    write_line("{m[1]?.s} {m[2]?.s} {m.count}")
si
