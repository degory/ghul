namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A multi-stage thread-first chain (`filter` then `map`) fuses stage by
    // stage - the recognizer must peel more than one Ghul.Pipes free-function
    // layer off the loop expression, not just a single stage.

    class Main is
        entry() static is
            let xs = [1, 2, 3, 4, 5, 6];

            for x in xs |> filter(n => n % 2 == 0) |> map(n => n * 10) do
                Std.write_line("mapped-filtered: {x}");
            od
        si
    si
si
