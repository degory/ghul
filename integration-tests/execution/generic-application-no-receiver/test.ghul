use IO.Std.write_line;

// A bare global generic function called with explicit type arguments
// and no receiver: COMPILE_GENERIC_APPLICATION / COMPILE_EXPRESSIONS
// build a `left_value` that is legitimately null here (there is no
// receiver expression to hold a value), then pass it on unchanged to
// the resolved symbol's `load`.
identity[T](v: T) -> T => v;

empty_option[T]() -> T? => null;

class BOX is
    init() is si

    identity[T](v: T) -> T => v;
si

entry() is
    // no receiver, no backtick — AMBIGUOUS_EXPRESSION path
    write_line("{identity[int](42)}");
    write_line("{empty_option[string]()}");

    // no receiver, backtick — GENERIC_APPLICATION path
    write_line("{identity`[int](7)}");

    // receiver present — left_value genuinely holds a value here,
    // exercising the same call sites from the other side
    let box = BOX();
    write_line("{box.identity[string]("present")}");

    write_line("done");
si
