use IO.Std.write_line

class Animal abstract is
    sound() -> string
    describe() -> string => "says {sound()}"
si

class DOG: Animal is
    init() is si
    sound() -> string => "woof"
si

class CAT: Animal is
    init() is si
    sound() -> string => "meow"
si

trait Named is
    name() -> string
si

class ONLY: Named is
    init() is si
    name() -> string => "only"
si

class HOLDER is
    pet: Animal
    named: Named

    init(pet: Animal, named: Named) is
        self.pet = pet
        self.named = named
    si
si

union Shape is
    DOT
    LINE(length: int)
si

trait Measured is
    measure() -> int
si

impl Measured for Shape is
    measure() -> int => if let (length): Shape.LINE = self then length else 0 fi
si

speak(a: Animal?) is
    try
        write_line(a!.sound())
    catch e: Ghul.Exception
        write_line("threw")
    yrt
si

total(m: Measured) -> int => m.measure()

speak(DOG())
speak(null)

let holder = HOLDER(DOG(), ONLY())

write_line(holder.pet.describe())
write_line(holder.named.name())
write_line("{total(Shape.DOT)} {total(Shape.LINE(3))}")
