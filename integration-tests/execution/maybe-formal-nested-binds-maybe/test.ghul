// A generic `T?` formal nested inside a function type still binds
// against an actual that carries the same optional representation: a
// generic function's own `U?` result is the same carrier as the
// callee's `(T) -> U?`, so composing generics through it works and
// absence propagates as absence rather than as a present null.
namespace Test is
    use Std = IO.Std;

    unit[T](value: T) -> T? => value;

    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    compose[A, B, C](f: (A) -> B?, g: (B) -> C?) -> (A) -> C? =>
        a => bind(f(a), g);

    some[T](value: T) -> T? => value;

    none[T]() -> T? => null;

    class Main is
        entry() static is
            let halve = (n: int) => if n % 2 == 0 then some(n / 2) else none[int]() fi;

            let halve_twice = compose(halve, halve);

            for n in [8, 6, 5] do
                let result = halve_twice(n);

                Std.write_line("{n}: {if result? then "{result}" else "nothing" fi}");
            od
        si
    si
si
