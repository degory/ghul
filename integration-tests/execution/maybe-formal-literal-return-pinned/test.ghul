// A function literal passed where `(T) -> U?` is expected leaves its
// return type to be inferred, and the slot's `U?` is `MAYBE[U]`
// whatever U turns out to be. The body's value pins the literal's
// return as `MAYBE` over what it produced - a bare value, a `T?` of
// either carrier, an early `return` or a tail - so the delegate has
// the shape the slot binds against and absence arrives as absence.
namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes.find_map;

    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    spell(n: int) -> string? => if n < 10 then "small" else null fi;

    half(n: int) -> int? => if n % 2 == 0 then n / 2 else null fi;

    class Main is
        show(label: string, value: string?) static =>
            Std.write_line("{label}: {value ?? "nothing"}");

        entry() static is
            let bare = bind(4, n => n + 1);
            Std.write_line("bare: {if bare? then "{bare}" else "nothing" fi}");

            show("reference present", bind(3, n => spell(n)));
            show("reference absent", bind(30, n => spell(n)));

            let value_absent = bind(3, n => half(n));
            Std.write_line("value absent: {if value_absent? then "{value_absent}" else "nothing" fi}");

            show("early return", bind(5, n is if n > 2 then return "block"; fi; return null; si));
            show("if arms", bind(1, n is if n > 2 then return "block" else return null fi si));
            show("tail", bind(5, n is "tail" si));
            show("tail local", bind(5, n is let s: string? = null; s si));

            show("find_map present", [1, 2, 30] |> find_map(x => spell(x)));
            show("find_map absent", [10, 20, 30] |> find_map(x => spell(x)));
        si
    si
si
