namespace Test is
    use Std = IO.Std;

    union QueuedFrame is
        REQUEST(payload: int);
        PARSE_ERROR(message: string);
    si

    class Main is
        entry() static is
            let frame: QueuedFrame = QueuedFrame.REQUEST(5);

            // Should NOT warn: the cast target is already spelled
            // optional (`V?`), the null-on-failure form the warning
            // itself recommends. specialize_variant_for_receiver
            // resolves the bare variant `REQUEST` against the
            // receiver's union to its closed form for IL emission,
            // and must carry the written `?` through onto that
            // resolved type rather than dropping it.
            let queued = cast QueuedFrame.REQUEST?(frame);

            Std.out.write_line("{queued?}");
            return;
        si
    si
si
