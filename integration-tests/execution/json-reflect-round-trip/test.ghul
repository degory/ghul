use IO.Std.write_line
use Collections.LIST

class LOCATION is
    file: string public
    line: int public

    init() is
        file = ""
    si

    init(file: string, line: int) is
        self.file = file
        self.line = line
    si
si

union Message is
    OPEN(paths: LIST[string], counts: LIST[int])
    FOUND(location: LOCATION, note: string?, score: int?)
    CLOSE
si

round_trip(message: Message) is
    let written = Json.write(Json.to_json(message))

    write_line(written)

    if let read: Message = Json.from_json(Json.parse(written), typeof Message) then
        write_line(Json.write(Json.to_json(read)))
    fi
si

entry() is
    round_trip(Message.OPEN(LIST[string](["a.ghul", "b.ghul"]), LIST[int]([1, 2, 3])))
    round_trip(Message.FOUND(LOCATION("c.ghul", 7), "near", 42))
    round_trip(Message.FOUND(LOCATION("d.ghul", 0), null, null))
    round_trip(Message.CLOSE)
si
