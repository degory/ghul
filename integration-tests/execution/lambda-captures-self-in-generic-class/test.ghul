namespace Test is
    use IO.Std;

    // Tests: a lambda in a generic class's method that captures both a
    // local and the receiver. The frame's captured-receiver field has to
    // name the class instantiated with its own type parameters — the
    // bare class name is not a loadable type.

    class BOX[T] is
        _value: T;

        init(value: T) is _value = value; si

        get_value() -> T => _value;

        show() -> void is
            let n = 1;
            let f = () -> string => "{get_value()} {n}";
            Std.write_line(f());
        si
    si

    class Main is
        entry() static is
            BOX[int](5).show();
            BOX[string]("five").show();

            return;
        si
    si
si
