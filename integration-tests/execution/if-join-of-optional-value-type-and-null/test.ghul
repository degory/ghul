namespace Test is
    use IO.Std.write_line

    use Pair = (a: int, b: string)

    f(x: int) -> Pair? => if x > 0 then (a = x, b = "p") else null fi

    entry() is
        let h = if true then f(1) else null fi
        write_line("{h?.a}")

        let other: Pair = (a = 9, b = "o")
        let fallback = if false then f(1) else null fi
        write_line("{(fallback ?? other).a}")

        let picked = if let c = h then c else other fi
        write_line("{picked.b}")

        let absent: int? = if false then 3 else null fi
        let present = if true then absent else null fi
        write_line("[{present}]")
    si
si
