namespace Test is
    use Std = IO.Std;

    g(x: int) -> int => x * 2;

    named_arrow(x: int) -> void => g(x);

    take(a: (int) -> void) is
        a(1);
    si

    // A same-arity pair: one formal wants a value, the other does not.
    run(a: (int) -> void) is
        Std.write_line("action");
        a(1);
    si

    run(f: (int) -> bool) is
        Std.write_line("predicate {f(1)}");
    si

    entry() is
        named_arrow(1);

        take(s -> void => g(s));
        take((x: int) -> void => g(x));

        take(x => g(x));
        take(x is g(x); si);

        run(x => x > 0);
        run(x => Std.write_line("{x}"));

        Std.write_line("done");
    si
si
