namespace Test is
    use Std = IO.Std;
    use Colour.RED;
    use Colour.BLACK;
    use Colour.GREEN;

    class Main is
        entry() static is
            // A marked bare name matches by value where the same name
            // unmarked would bind and match everything.
            show((Colour.RED, "stop"));
            show((Colour.GREEN, "go"));

            // The marked value need not be a constant.
            against_local((3, "three"), 3);
            against_local((3, "three"), 4);

            // A marker on a leaf that already matches is a no-op.
            no_op((1, "one"));
            no_op((0, "zero"));
            no_op_qualified((Colour.BLACK, "coal"));
            no_op_qualified((Colour.GREEN, "grass"));

            // Marked leaves inside a variant pattern, nested a level down.
            nested(TREE.NODE(Colour.RED, 7));
            nested(TREE.NODE(Colour.BLACK, 9));
            nested(TREE.EMPTY);

            // Every combination covered by marked leaves, so the case
            // needs no else arm.
            Std.out.write_line(pair_label(Colour.RED, Colour.BLACK));
            Std.out.write_line(pair_label(Colour.GREEN, Colour.GREEN));

            drain([(1, "keep"), (1, "also keep"), (2, "stop")]);
        si

        show(pair: (Colour, string)) static is
            if let (~RED, label) = pair then
                Std.out.write_line("red: {label}");
            else
                Std.out.write_line("not red");
            fi
        si

        against_local(pair: (int, string), expected: int) static is
            if let (~expected, label) = pair then
                Std.out.write_line("matched {label}");
            else
                Std.out.write_line("no match");
            fi
        si

        no_op(pair: (int, string)) static is
            case pair
            when (~1, label) then Std.out.write_line("one: {label}");
            else Std.out.write_line("other");
            esac
        si

        no_op_qualified(pair: (Colour, string)) static is
            case pair
            when (~Colour.BLACK, label) then Std.out.write_line("black: {label}");
            else Std.out.write_line("other colour");
            esac
        si

        nested(tree: TREE) static is
            case tree
            when (~RED, value): TREE.NODE then Std.out.write_line("red node {value}");
            when (~BLACK, value): TREE.NODE then Std.out.write_line("black node {value}");
            else Std.out.write_line("empty");
            esac
        si

        pair_label(a: Colour, b: Colour) -> string static =>
            case (a, b)
            when (~RED, ~RED) then "red red"
            when (~RED, ~BLACK) then "red black"
            when (~RED, ~GREEN) then "red green"
            when (~BLACK, ~RED) then "black red"
            when (~BLACK, ~BLACK) then "black black"
            when (~BLACK, ~GREEN) then "black green"
            when (~GREEN, ~RED) then "green red"
            when (~GREEN, ~BLACK) then "green black"
            when (~GREEN, ~GREEN) then "green green"
            esac;

        drain(pairs: (int, string)[]) static is
            let source = pairs.iterator;
            let wanted = 1;

            while let (~wanted, label) = _next(source) do
                Std.out.write_line("drained {label}");
            od
        si

        _next(source: Collections.Iterator[(int, string)]) -> (int, string)? static =>
            if source.move_next() then source.current else null fi;
    si

    enum Colour is
        RED,
        BLACK,
        GREEN,
    si

    union TREE is
        EMPTY;
        NODE(colour: Colour, value: int);
    si
si
