use IO.Std.write
use IO.Std.write_line

// System.Environment reads a variable, names an executable that exists
// where there is one, and ends the process with the status passed to exit,
// after the output written before it.
entry() -> int is
    write_line(if System.Environment.get_environment_variable("PATH")? then "PATH is set" else "PATH is not set" fi)
    write_line(System.Environment.get_environment_variable("GHUL_TEST_UNSET") ?? "absent")

    let path = System.Environment.process_path

    write_line(if !path? \/ IO.File.exists(path) then "the process path is usable" else "no executable at {path}" fi)

    write("written before exit")

    System.Environment.exit(3)

    write_line("not reached")

    return 0
si
