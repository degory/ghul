namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let xs = [1, 2, 3];
            let ys = [10, 20, 30];

            // valued break crossing a statement-form inner loop to the
            // consumed outer for — no wrapper needed
            let hit: int? =
                for x in xs do
                    for y in ys do
                        if x * y > 25 then break x * 100 + y fi;
                    od;
                od;

            check("crossing", hit =~ 130);

            // a valued break targets the innermost consuming loop even
            // when another expression loop sits outside it
            let outer: int? = while true do
                let inner: int? = for v in xs do
                    if v == 2 then break v fi;
                od;

                break inner ?? 0;
            od;

            check("nearest-taker", outer =~ 2);

            // labelled loop: bare label-break and labelled continue keep
            // working alongside the new forms
            search: for x in xs do
                for y in ys do
                    if y == 20 then continue search fi;

                    if x * y > 40 then
                        check("label-exit", x * y == 60);
                        break search;
                    fi;
                od;
            od;

            // a local shadowing the label wins at the break: the name
            // resolves to the value, so the consuming loop receives 77
            // rather than an absence exit
            let shadowed_val: int? = do
                for i in [1, 2] do
                    if i == 2 then
                        if true then
                            let shadowtest = 77;

                            break shadowtest;
                        fi;
                    fi;
                od;

                break 1;
            od;

            check("shadow-value", shadowed_val =~ 77);
        si

        check(name: string, ok: bool) static is
            if ok then
                Std.write_line("ok {name}");
            else
                Std.write_line("FAIL {name}");
            fi
        si
    si
si
