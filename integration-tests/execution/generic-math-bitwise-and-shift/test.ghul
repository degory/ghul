use IO.Std.write_line;

use System.Numerics.IBinaryInteger;
use System.Numerics.IBitwiseOperators.`&;
use System.Numerics.IBitwiseOperators.`|;
use System.Numerics.IBitwiseOperators.`^;
use System.Numerics.IBitwiseOperators.`\;
use System.Numerics.IShiftOperators.`<<;
use System.Numerics.IShiftOperators.`>>;
use System.Numerics.IShiftOperators.`>>>;
use System.Numerics.IUnaryNegationOperators.`-;
use System.Numerics.ISubtractionOperators.`-;

both[T: IBinaryInteger[T]](a: T, b: T) -> T => a & b;

either[T: IBinaryInteger[T]](a: T, b: T) -> T => a | b;

difference[T: IBinaryInteger[T]](a: T, b: T) -> T => a ^ b;

up[T: IBinaryInteger[T]](a: T, by: int) -> T => a << by;

down[T: IBinaryInteger[T]](a: T, by: int) -> T => a >> by;

down_unsigned[T: IBinaryInteger[T]](a: T, by: int) -> T => a >>> by;

// One parameter rather than two, so a different resolution path from
// every other operator here.
complement[T: IBinaryInteger[T]](a: T) -> T => \a;

negate[T: IBinaryInteger[T]](a: T) -> T => -a;

// `-` is the one name two interfaces supply, at different
// arities, so both have to survive being imported together.
subtract[T: IBinaryInteger[T]](a: T, b: T) -> T => a - b;

entry() is
    write_line("{both(12, 10)}");
    write_line("{either(12, 10)}");
    write_line("{difference(12, 10)}");
    write_line("{up(3, 4)}");
    write_line("{down(48, 4)}");
    write_line("{down_unsigned(-16, 2)}");
    write_line("{down(-16, 2)}");
    write_line("{complement(5)}");
    write_line("{negate(7)}");
    write_line("{subtract(10, 3)}");
    write_line("{negate(subtract(10, 3))}");
    write_line("{6 & 3} {6 | 3} {6 ^ 3} {6 << 2} {48 >> 2} {\5} {-7}");
si
