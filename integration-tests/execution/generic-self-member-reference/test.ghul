namespace Test is
    use IO.Std;

    // A generic type reaching its own fields and methods from inside
    // its own body. The receiver is the type applied to its own
    // parameters, so a reference naming the open definition disagrees
    // with what is on the stack and the type fails to load.
    class HOLDER[T] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        value: T => _value;

        replace(value: T) is
            _value = value;
        si

        describe() -> string => "holds {stringify()}";

        stringify() -> string => "{_value}";
    si

    class Main is
        entry() static is
            let h = HOLDER[int](42);
            Std.write_line("{h.value}");
            Std.write_line(h.describe());

            h.replace(7);
            Std.write_line("{h.value}");
        si
    si
si
