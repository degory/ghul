namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A `for` over a thread-first chain of `Ghul.Pipes` free functions.
    // `|>` desugars to an ordinary call at parse time, so `map` here is a
    // fixed global function resolved once - no receiver, and so no virtual
    // dispatch for the fused loop to have to reproduce.

    class Main is
        entry() static is
            let xs = [1, 2, 3, 4, 5];

            for x in xs |> map(n => n * 10) do
                Std.write_line("mapped: {x}");
            od
        si
    si
si
