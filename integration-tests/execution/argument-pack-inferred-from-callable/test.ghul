namespace Test is
    use IO.Std;

    // Tests: a pack binds to the tuple of the N-ary function written at
    // its own formal, so a call supplying nothing else still infers. The
    // function's own parameter types are what say so - written out on a
    // literal, or settled already on a named function.

    n_ary[A.., B](f: A.. -> B) -> (A -> B) => f;

    run[T.., U](make: (int) -> T.. -> U) -> (T -> U) => make(10);

    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    add(a: int, b: int) -> int => a + b;

    join(a: string, b: string, c: string) -> string => "{a}{b}{c}";

    class Main is
        entry() static is
            // A literal writing its parameter types out.
            let sum = n_ary((a: int, b: int) => a + b);

            Std.write_line("{sum((1, 2))}");

            // A named function, whose type is settled before the call.
            let also_sum = n_ary(add);

            Std.write_line("{also_sum((3, 4))}");

            let joined = n_ary(join);

            Std.write_line(joined(("x", "y", "z")));

            // The same, one return in - the pack is bound from the
            // function the caller's own lambda returns.
            let nested = run(n => (a: int, b: int) => a + b + n);

            Std.write_line("{nested((1, 2))}");

            // A named function of three parameters, spread at the call.
            Std.write_line(apply(join, "p", "q", "r"));

            return;
        si
    si
si
