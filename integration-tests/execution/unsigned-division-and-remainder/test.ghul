namespace Test is
    use IO.Std.write_line

    entry() is
        let big = 4000000000u

        write_line("{big / 2u}")
        write_line("{big % 7u}")

        let huge = 18000000000000000000ul

        write_line("{huge / 2ul}")
        write_line("{huge % 7ul}")

        write_line("{-7 / 2} {-7 % 2}")
        write_line("{201ub / 2ub} {201ub % 2ub}")
    si
si
