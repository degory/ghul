namespace Ghul.Internal is
    @INTRINSIC_ATTRIBUTE("arithmetic.rem_un") %(a: uint, b: uint) -> uint pure
    @INTRINSIC_ATTRIBUTE("arithmetic.rem_un") %(a: ulong, b: ulong) -> ulong pure

    @INTRINSIC_ATTRIBUTE("arithmetic.div_un") ÷(a: uint, b: uint) -> uint pure
    @INTRINSIC_ATTRIBUTE("arithmetic.div_un") ÷(a: ulong, b: ulong) -> ulong pure
si

namespace Test is
    use IO.Std.write_line

    entry() is
        let big = 4000000000u

        write_line("{big ÷ 2u}")
        write_line("{big % 7u}")

        let huge = 18000000000000000000ul

        write_line("{huge ÷ 2ul}")
        write_line("{huge % 7ul}")
    si
si
