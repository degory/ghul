namespace Test is
    use Std = IO.Std;

    union Box is
        FULL(payload: int?);
        EMPTY;
    si

    class Main is
        entry() static is
            describe(Box.FULL(5));
            describe(Box.FULL(null));
            describe(Box.EMPTY);
        si

        describe(b: Box) static is
            case b
            // the guard's narrowing reaches the arm body, so `f.payload`
            // reads as `int` below with no unwrap needed
            when f: Box.FULL /\ f.payload? then
                Std.write_line("{f.payload + 1}");
            else
                Std.write_line("none");
            esac
        si
    si
si
