use IO.Std.write_line
use Ghul.Pipes

// Tests: a fused take, skip and index run their stage counters, and a
// member read through a coalesced receiver yields the member, on every
// target.

maybe(present: bool) -> int? => if present then 42 else null fi
name(n: int) -> string => "n{n}"

let xs = [10, 20, 30, 40, 50]

for x in xs |> skip(1) |> take(3) do
    write_line("{x}")
od

for (i, x) in xs |> index() |> take(2) do
    write_line("{i}: {x}")
od

let present = maybe(true) ~> name()
let absent = maybe(false) ~> name()

write_line("{present?.length ?? -1}")
write_line("{absent?.length ?? -1}")
write_line("{(maybe(true) ~> name())?.length}")
