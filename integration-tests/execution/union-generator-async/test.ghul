namespace Test is
    use Std = IO.Std;

    // A generator or async method reopened onto a union (or one of its
    // variants) via `partial` runs like an ordinary instance method —
    // unions are reference types, so the state machine's captured
    // `self` is a real reference, not a value-type copy.

    union Tree is
        NODE(left: Tree, right: Tree);
        LEAF(value: int);
    si

    partial Tree is
        upto(times: int) -> Ghul.Pipes.Pipe[int] is
            let i mut = 0;

            while i < times do
                yield i;
                i = i + 1;
            od
        si

        later() -> Tasks.TASK[int] is
            let v = await Tasks.TASK.from_result(42);

            return v;
        si
    si

    partial Tree.LEAF is
        repeat_value(times: int) -> Ghul.Pipes.Pipe[int] is
            let i mut = 0;

            while i < times do
                yield value;
                i = i + 1;
            od
        si

        doubled() -> Tasks.TASK[int] is
            let v = await Tasks.TASK.from_result(value);

            return v * 2;
        si
    si

    class Main is
        entry() static is
            let t: Tree = Tree.LEAF(10);

            for n in t.upto(3) do
                Std.write_line("upto {n}");
            od

            Std.write_line("later {t.later().result}");

            if let l: Tree.LEAF = t then
                for n in l.repeat_value(2) do
                    Std.write_line("repeat_value {n}");
                od

                Std.write_line("doubled {l.doubled().result}");
            fi
        si
    si
si
