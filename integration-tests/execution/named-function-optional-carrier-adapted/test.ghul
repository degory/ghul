// A named function referred to by name becomes a delegate directly, so
// its type is fixed by its declaration: a `(T) -> U?` formal over an
// unconstrained U is `Func<T, MAYBE<U>>`, and no `ldftn` over a function
// returning `int?` produces that delegate. The reference is
// eta-expanded instead - `f` becomes `(a) => f(a)` - so the literal path
// supplies the delegate the formal binds against and the return
// boundary coerces one carrier into the other. Both directions, and a
// parameter's carrier as well as a return's.
namespace Test is
    use Std = IO.Std;

    unit[T](value: T) -> T? => value;

    absent[T](value: T) -> T? => null;

    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    halve(n: int) -> int? => if n % 2 == 0 then n / 2 else null fi;

    spell(n: int) -> string? => if n < 10 then "small" else null fi;

    // The carrier the other way: a `T?` over an unconstrained T is
    // `MAYBE[T]`, and these slots want a reference `string?` and a
    // `Nullable[int]`.
    apply_value(n: int, f: (int) -> int?) -> int? => f(n);

    apply_ref(s: string, f: (string) -> string?) -> string? => f(s);

    // Contravariant: the parameter's carrier differs, not the return's.
    consume_value(f: (int?) -> string, v: int?) -> string => f(v);

    consume_ref(f: (string?) -> string, v: string?) -> string => f(v);

    describe[T](v: T?) -> string => if v? then "{v}" else "absent" fi;

    class TOOLS is
        third(n: int) -> int? static => if n % 3 == 0 then n / 3 else null fi;
    si

    class Main is
        show(label: string, value: string?) static =>
            Std.write_line("{label}: {value ?? "nothing"}");

        show_int(label: string, value: int?) static =>
            Std.write_line("{label}: {if value? then "{value}" else "nothing" fi}");

        entry() static is
            show_int("halve present", bind(unit(8), halve));
            show_int("halve absent", bind(unit(7), halve));

            show("spell present", bind(unit(3), spell));
            show("spell absent", bind(unit(30), spell));

            show_int("static present", bind(unit(9), TOOLS.third));
            show_int("static absent", bind(unit(10), TOOLS.third));

            // Written-out type arguments name the same reference, so
            // the adaptation applies to it the same way.
            show("explicit type arguments", bind[int, string](3, spell));

            show_int("value slot present", apply_value(4, unit[int]));
            show_int("value slot absent", apply_value(4, absent[int]));

            show("reference slot present", apply_ref("hi", unit[string]));
            show("reference slot absent", apply_ref("hi", absent[string]));

            Std.write_line("value parameter present: {consume_value(describe[int], 7)}");
            Std.write_line("value parameter absent: {consume_value(describe[int], null)}");

            Std.write_line("reference parameter present: {consume_ref(describe[string], "hi")}");
            Std.write_line("reference parameter absent: {consume_ref(describe[string], null)}");
        si
    si
si
