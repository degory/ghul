namespace Test is
    use IO.Std;

    // A function can be named with an operator, and `|>` accepts one on
    // its right. Written without an argument list the threaded value is
    // the only argument, so a formatting function reads as `xs |> $`.
    //
    // The name and the `|>` must be separated: a run of operator
    // characters scans as a single token, so `xs |>$` is one operator
    // named `|>$` rather than two.

    $(o: object?) -> string => if o? then "<{o.to_string()}>" else "null" fi;

    $(a: int, b: int) -> string => "<{a}+{b}>";

    ~(s: string) -> string => "~{s}~";

    entry() is
        Std.write_line(42 |> $);
        Std.write_line(42 |> $());
        Std.write_line(1 |> $(2));
        Std.write_line("b" |> ~ |> ~);

        // `Ghul.$` is in scope alongside the one declared here, and the
        // two merge into a single group rather than the nearer one
        // hiding the other. A `string` argument therefore reaches
        // `Ghul.$(value: string)`, an exact match, ahead of the
        // `object?` above it - which is the resolution working across
        // the namespaces, not the import winning by being an import.
        Std.write_line("a" |> $);

        // The same group with no better candidate: `Ghul.$` takes a
        // present `string` and an `object?`, so an argument written
        // `null` lands on the one declared here.
        Std.write_line(null |> $);
    si
si
