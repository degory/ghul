namespace Tést is
    use Std = IO.Std;

    // A letter of any script is an identifier character, so a
    // namespace, a type, a member and a local can each be named in
    // the language they are about.
    class CAFÉ is
        naïve_count: int;

        init(naïve_count: int) is
            self.naïve_count = naïve_count;
        si

        описание() -> string => "{naïve_count} cups";

        説明() -> string => описание();
    si

    trait Größe is
        breite: int;
    si

    class BREITE: Größe is
        breite: int;

        init(breite: int) is
            self.breite = breite;
        si
    si

    class Main is
        entry() static is
            let café = CAFÉ(3);
            let größe: Größe = BREITE(7);

            Std.write_line(café.説明());
            Std.write_line("{größe.breite}");
        si
    si
si
