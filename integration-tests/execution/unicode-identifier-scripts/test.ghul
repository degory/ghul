namespace Tést is
    use Std = IO.Std;

    // A letter of any script is an identifier character, so a
    // namespace, a type, a member and a local can each be named in
    // the language they are about.
    class CAFÉ is
        naïve_count: int;

        init(naïve_count: int) is
            self.naïve_count = naïve_count;
        si

        описание() -> string => "{naïve_count} cups";

        説明() -> string => описание();
    si

    trait Größe is
        breite: int;
    si

    class BREITE: Größe is
        breite: int;

        init(breite: int) is
            self.breite = breite;
        si
    si

    // A symbol is an operator character and a letter is an identifier
    // character, so the two spellings never collide: this multiplies,
    // and the class above is a name.
    ×(a: int, b: int) -> int => a * b;

    class Main is
        entry() static is
            let multiply = `×;

            Std.write_line("{3 × 4} {multiply(5, 6)}");

            let café = CAFÉ(3);
            let größe: Größe = BREITE(7);

            Std.write_line(café.説明());
            Std.write_line("{größe.breite}");
        si
    si
si
