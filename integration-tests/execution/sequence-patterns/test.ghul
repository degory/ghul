use default

head_and_rest([first, ..rest]: List[int]) -> string => "{first} {rest |> join(",")} {rest.count}"

second_of([_, second, ..]: int[]) -> int => second

describe(xs: List[int]) -> string =>
    case xs
    when [] then "empty"
    when [x] then "one {x}"
    when [x, y] then "two {x} {y}"
    when [x, ..more] then "many {x} then {more.count}"
    esac

entry() is
    let xs: List[int] = [10, 20, 30, 40]

    let [a, b, ..rest] = xs
    write_line("{a} {b} {rest |> join(",")} {rest.count}")

    let [only] = [7]
    write_line("{only}")

    if let [x, ..tail] = xs then
        write_line("head {x} tail {tail |> join(",")}")
    fi

    if let [x, y] = xs then
        write_line("exactly two {x} {y}")
    else
        write_line("not exactly two")
    fi

    let nothing: List[int] = []

    if let [x, ..] = nothing then
        write_line("has head {x}")
    else
        write_line("empty")
    fi

    write_line(describe(nothing))
    write_line(describe([5]))
    write_line(describe([5, 6]))
    write_line(describe(xs))

    let arr = [1, 2, 3]
    let [p, ..q] = arr
    write_line("{p} {q |> join(",")}")

    for [f, ..g] in [[1, 2, 3], [4, 5]] do
        write_line("{f} {g |> join(",")}")
    od

    let ([m, ..n], z) = (xs, 99)
    write_line("{m} {n.count} {z}")

    let [u, [v, ..w], ..] = [[1], [2, 3, 4]]
    write_line("{u |> join(",")} {v} {w |> join(",")}")

    let c1 mut = 1
    let c2 mut = 2
    [c1, c2] = [c2, c1]
    write_line("{c1} {c2}")

    let h mut = 0
    let t: List[int] mut = nothing
    [h, ..t] = xs
    write_line("{h} {t |> join(",")}")

    write_line(head_and_rest(xs))
    write_line(head_and_rest([7]))
    write_line("{second_of([1, 2, 3])}")
si
