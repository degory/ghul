use IO.Std.write_line;

// An overloaded ghūl function passed by name where the formal's type
// picks the member.
over(c: char) -> string => "char";
over(s: string, i: int) -> string => "string";

apply(f: (char) -> string, c: char) -> string => f(c);
test(p: (char) -> bool, c: char) -> bool => p(c);

entry() is
    write_line(apply(over, 'x'));
    write_line(test(char.is_letter, 'a'));
    write_line(test(char.is_letter, '9'));
si
