namespace Test is
    use Std = IO.Std;

    class Main is
        // Mutates its parameter, so a replay only yields the same
        // elements again if the rewind puts the parameter back to the
        // value the generator was constructed with.
        countdown(n: int mut) -> Ghul.Pipes.Pipe[int] static is
            while n > 0 do
                yield n;
                n = n - 1;
            od
        si

        entry() static is
            let pipe = countdown(3);

            Std.write_line("first: {pipe |> Ghul.Pipes.join(" ")}");

            // The pass above rewound the pipe at its end, so this pass
            // starts over - and must start with the parameter the
            // generator was constructed with, not where the body left
            // it.
            Std.write_line("second: {pipe |> Ghul.Pipes.join(" ")}");
        si
    si
si
