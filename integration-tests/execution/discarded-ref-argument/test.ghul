use IO.Std.write_line

// A `_` written for a `T ref` parameter discards what the callee writes
// through it: the callee is handed the address of a fresh local rather
// than a null reference, for a reference type and a value type alike.
write_line("{System.Version.try_parse("1.2", _)}")
write_line("{System.Version.try_parse("not a version", _)}")
write_line("{System.Guid.try_parse("0f8fad5b-d9cb-469f-a165-70867728950e", _)}")
write_line("{System.DateTime.try_parse("not a date", _)}")
