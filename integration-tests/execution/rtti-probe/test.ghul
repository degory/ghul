use IO.Std.write_line
use System.Reflection.BindingFlags

class PERSON is
    name: string public
    age: int public
    nick: string? public
    score: int? public
    tags: Collections.Iterable[string]? public
    _secret: int

    init() is
        name = "nobody"
        _secret = 7
    si
si

union Shape is
    CIRCLE(radius: int)
    SQUARE(side: int, label: string)
si

show(t: System.Type) is
    let all = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.INSTANCE

    write_line("{t.name} base: {t.base_type} class={t.is_class} value={t.is_value_type}")

    for f in t.get_fields(all) do
        write_line("  field {f.name}: {f.field_type}")
    od

    for p in t.get_properties() do
        write_line("  property {p.name}: {p.property_type} read={p.can_read} write={p.can_write}")
    od

    for c in t.get_constructors(BindingFlags.PUBLIC | BindingFlags.INSTANCE | BindingFlags.DECLARED_ONLY) do
        write_line("  constructor of {c.get_parameters().count}")

        for p in c.get_parameters() do
            write_line("    {p.name}: {p.parameter_type}")
        od
    od
si

entry() is
    let all = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.INSTANCE
    let t = typeof PERSON

    show(t)
    show(typeof Shape)
    show(typeof Shape.SQUARE)

    let o = System.Activator.create_instance(t)!

    t.get_property("name")!.set_value(o, "Ada")
    t.get_property("age")!.set_value(o, 36)
    t.get_property("score")!.set_value(o, 99)
    t.get_field("_secret", all)!.set_value(o, 42)

    let person = cast PERSON(o)

    write_line("{person.name} {person.age} {person.score} {t.get_field("_secret", all)!.get_value(o)}")
    write_line("{t.get_property("name")!.get_value(o)} {t.get_property("nick")!.get_value(o)} {t.get_property("score")!.get_value(o)}")

    let square = System.Activator.create_instance(typeof Shape.SQUARE, [3, "three"])!

    write_line("{square} {square.get_type().name}")

    show_enum()
    show_union()
si

enum Colour is
    RED = 1, GREEN = 2, BLUE = 4
si

show_enum() is
    let t = typeof Colour

    write_line("{t.is_enum} {System.Enum.get_names(t) |> Ghul.Pipes.join(",")}")

    for n in System.Enum.get_names(t) do
        let v = System.Enum.parse(t, n)
        write_line("  {v} {System.Enum.get_name(t, v)}")
    od

    write_line("{System.Enum.to_object(t, 2L)} {System.Enum.parse(t, "BLUE")}")
    let n = typeof int?
    write_line("{n} {n.is_value_type} {n.is_generic_type} {n.get_generic_arguments().count}")
    write_line("{System.Nullable.get_underlying_type(typeof int?)} {System.Nullable.get_underlying_type(typeof int)}")
si

show_union() is
    for a in (typeof Shape).get_custom_attributes(false) do
        let at = a.get_type()

        if let variants = at.get_property("variants") then
            if let types: System.Type[] = variants.get_value(a) then
                write_line("{at.name}: {types |> Ghul.Pipes.map(v => v.name) |> Ghul.Pipes.join(",")}")
            fi
        fi
    od
si
