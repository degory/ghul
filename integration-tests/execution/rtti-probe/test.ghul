use IO.Std.write_line
use System.Reflection.BindingFlags

class PERSON is
    name: string public
    age: int public
    nick: string? public
    _secret: int

    init() is
        name = "nobody"
        _secret = 7
    si
si

entry() is
    let t = typeof PERSON
    let all = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.INSTANCE

    write_line("base: {t.base_type}")

    for f in t.get_fields(all) do
        write_line("field {f.name}: {f.field_type} public={f.is_public}")
    od

    for p in t.get_properties() do
        write_line("property {p.name}: {p.property_type} read={p.can_read} write={p.can_write}")
    od

    let o = System.Activator.create_instance(t)

    t.get_property("name")!.set_value(o, "Ada")
    t.get_property("age")!.set_value(o, 36)
    t.get_field("_secret", all)!.set_value(o, 42)

    let person = cast PERSON(o)

    write_line("{person.name} {person.age} {t.get_field("_secret", all)!.get_value(o)}")
    write_line("{t.get_property("name")!.get_value(o)} {t.get_property("nick")!.get_value(o)}")
si
