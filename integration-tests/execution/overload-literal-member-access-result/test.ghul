// Overloads that differ only in what a function parameter returns, where
// the literal's result comes from a member of its parameter: the
// parameter's type comes from the overloads, and the literal's result
// then picks between them.
use IO.Std.write_line

class PERSON(name: string public)

total[T](source: Collections.Iterable[T], selector: T -> int pure) -> string => "int"
total[T](source: Collections.Iterable[T], selector: T -> double pure) -> string => "double"
total[T](source: Collections.Iterable[T], selector: T -> string pure) -> string => "string"

spread[T..](source: Collections.Iterable[T], selector: T.. -> int pure) -> string => "int"
spread[T..](source: Collections.Iterable[T], selector: T.. -> long pure) -> string => "long"

entry() is
    let words = ["pipe", "stage"]
    let people = [PERSON("ada"), PERSON("grace")]

    write_line(total(words, w => w.length))
    write_line(total(people, p => p.name))
    write_line(total(people, p => p.name.length))
    write_line(spread(words, w => w.length))

    let letters: int = words |> Ghul.Pipes.sum_by(w => w.length)
    write_line("{letters}")
si
