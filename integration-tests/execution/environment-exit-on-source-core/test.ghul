use IO.Std.write
use IO.Std.write_line

// On the source-core targets, the program's environment reads a variable,
// names an executable that exists where there is one, and ends the process
// with the status passed to exit, after the output written before it.
entry(env: Ghul.Environment) -> int is
    write_line(if env["PATH"]? then "PATH is set" else "PATH is not set" fi)
    write_line(env["GHUL_TEST_UNSET"] ?? "absent")

    let path = env.process_path

    write_line(if !path? \/ IO.File.exists(path) then "the process path is usable" else "no executable at {path}" fi)

    write("written before exit")

    env.exit(3)

    write_line("not reached")

    return 0
si
