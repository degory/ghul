// An unterminated tail in a block-bodied function literal is the
// literal's return value on fall-through, exactly as in a named
// function - including a literal that captures and reassigns an
// outer mut local, whose tail reads the shared box.

namespace Test is
    use Std = IO.Std;

    class ANIMAL is
        init() is si
        speak() -> string => "animal";
    si

    class CAT: ANIMAL is
        init() is si
    si

    class MAIN is
        entry() static is
            let plain = () -> int is
                let a = 6;
                a * 7
            si;

            Std.write_line("{plain()}");

            let n mut = 0;

            let counter = () -> int is
                n = n + 1;
                n
            si;

            Std.write_line("{counter()} {counter()} {counter()}");
            Std.write_line("outer sees {n}");

            let running = val
                let total mut = 0.0D;

                (x: double) -> double is
                    total = total + x;
                    total
                si
            lav;

            Std.write_line("{running(2.0D)} {running(3.0D)}");

            // A void literal discards whatever its tail leaves, and
            // may end on a guard `if` with no else.
            let announce = (loud: bool) is
                if loud then
                    Std.write_line("loud");
                fi
            si;

            announce(true);

            // Every path diverges, so the tail is dead code: the
            // literal returns through its own `return` statements.
            let choose = (which: bool) -> ANIMAL is
                if which then
                    return CAT();
                else
                    return ANIMAL();
                fi
            si;

            Std.write_line("{choose(true).speak()}");
        si
    si
si
