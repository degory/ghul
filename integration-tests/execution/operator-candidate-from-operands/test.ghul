namespace Test is
    use IO.Std.write_line
    use Ghul.Pipes
    use Point = (x: double, y: double)

    +(a: Point, b: Point) -> Point => (x = a.x + b.x, y = a.y + b.y)

    entry() is
        let total =
            [1.0D, 2.0D] |> reduce(0.0D, (running, part) => running + part)

        let moved = (x = 1.0D, y = 2.0D) + (x = 10.0D, y = 20.0D)

        write_line("{total}")
        write_line("{moved}")
    si
si
