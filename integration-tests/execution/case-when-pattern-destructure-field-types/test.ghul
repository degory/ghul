namespace Test is
    use Std = IO.Std;

    union Tree is
        EMPTY;
        NODE(colour: int, left: Tree, value: int, right: Tree);
    si

    class Main is
        entry() static is
            // every field of an arm's destructure pattern must carry
            // its own type, not the variant's: `sum` recurses through
            // `left`/`right` (Tree), compares `colour` (int) and adds
            // `value` (int), so a mistyped field is an
            // overload-resolution error at each use.
            let t =
                Tree.NODE(0,
                    Tree.NODE(1, Tree.EMPTY, 1, Tree.EMPTY),
                    2,
                    Tree.NODE(1, Tree.EMPTY, 3, Tree.EMPTY));
            Std.write_line("{sum(t)}");
            Std.write_line("{sum(Tree.EMPTY)}");
        si

        sum(t: Tree) -> int static =>
            case t
            when e: Tree.EMPTY then 0
            when (c, l, v, r): Tree.NODE then
                (if c == 0 then v else v + 1 fi) + sum(l) + sum(r)
            esac;
    si
si
