use IO.Std.write_line

// A ubyte[] written to a file and read back crosses to the host and returns
// unchanged, empty and every byte value included.
entry() is
    let path = "file-bytes-on-every-target.bin"
    let bytes = [0ub, 1ub, 127ub, 128ub, 255ub]

    IO.File.write_all_bytes(path, bytes)

    let back = IO.File.read_all_bytes(path)

    write_line("{back.count} {back[0]} {back[2]} {back[3]} {back[4]}")

    IO.File.write_all_bytes(path, [])
    write_line("{IO.File.read_all_bytes(path).count}")

    IO.File.delete(path)
si
