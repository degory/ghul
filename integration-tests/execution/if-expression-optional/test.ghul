// An if expression without an else yields an optional of its
// completing arms' type: present when a branch runs, absent when
// control falls through - the same answer a loop expression gives
// exhaustion. A non-optional expected type still demands the else,
// and a guard whose only arm diverges keeps its error.

namespace Test is
    use Std = IO.Std;

    class MAIN is
        entry() static is
            show(pick(true));
            show(pick(false));
            show(inferred(true));
            show(inferred(false));
            show(tail_present());
            show(tail_absent());

            // Nested absence composes: the inner if yields int?, the
            // outer LUB folds it back into one optional layer.
            show(nested(true, true));
            show(nested(true, false));
            show(nested(false, true));
        si

        show(n: object?) static is
            if let v = n then
                Std.write_line("{v}");
            else
                Std.write_line("absent");
            fi
        si
    si

    pick(c: bool) -> int? is
        let direct: int? = if c then 7 fi;
        direct
    si

    inferred(c: bool) -> string? is
        let s = if c then "str" fi;
        s
    si

    tail_present() -> int? is
        if true then
            99
        fi
    si

    tail_absent() -> int? is
        if false then
            99
        fi
    si

    nested(a: bool, b: bool) -> int? is
        if a then
            if b then
                5
            fi
        fi
    si
si
