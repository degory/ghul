use IO.Std.write_line

union Colour is
    RED
    GREEN
    BLUE
si

union Marked(label: string) is
    PLAIN(..)
    BOLD(..)
si

name(c: Colour) is
    case c
    when Colour.RED then write_line("red")
    when Colour.GREEN then write_line("green")
    esac
si

weight(m: Marked, plain: Marked.PLAIN) is
    case m
    when plain then write_line("the plain one")
    when b: Marked.BOLD then write_line("bold {b.label}")
    esac
si

name(Colour.BLUE)
weight(Marked.PLAIN("a"), Marked.PLAIN("a"))
