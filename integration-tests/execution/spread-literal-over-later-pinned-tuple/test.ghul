use default

// The spread literal's tuple carries the enclosing literal's parameter,
// which only the later call pins. A tuple position still being inferred
// joins as the placeholder it is, not as an absent value, so the literal
// waits for the call rather than settling its parameter at object.
let f = x => [(x, 1)] |> filter((a, b) => a < 100) |> count()

write_line("{f(8)}")
