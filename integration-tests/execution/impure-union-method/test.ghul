namespace Test is
    use IO.Std;

    // Members reach a union only through a partial or impl block, and
    // union state is read-only variant fields, so a member supplied
    // there is expected to be pure: declared `pure`, or provably
    // store-free. A storing member draws `impure-union-method` - a
    // warning rather than an error, so a project can promote it or
    // mute it. Accessors count as members. Trait defaults a union
    // inherits keep their own classification, and blocks targeting
    // classes carry no such expectation.

    class BOX is
        v: int public;

        init(v: int) is
            self.v = v;
        si
    si

    union U is
        A(x: int);
        B;
    si

    partial U is
        // Stores through the argument: warned.
        bump(b: BOX) -> int is
            b.v = b.v + 1;
            return b.v;
        si

        // The same body declared pure: trusted, not verified, like
        // any other pure declaration.
        bump_pure(b: BOX) -> int pure is
            b.v = b.v + 1;
            return b.v;
        si

        // Provably store-free: silent, and callable end to end.
        total() -> int =>
            if let a: U.A = self then
                a.x
            else
                0
            fi;

        // Accessors are members for this purpose: both directions
        // warn when they store.
        p: int => bump(BOX(0)),
            = nv is
                bump(BOX(0));
            si
    si

    trait DESCRIBED is
        describe() -> string;
    si

    impl DESCRIBED for U is
        describe() -> string is
            bump(BOX(2));
            return "u";
        si
    si

    // An inherited trait default is not user-written union code and
    // keeps its own classification.
    trait LABELLED is
        label() -> string => "labelled";
    si

    union TAGGED: LABELLED is
        T;
    si

    class C is
        init() is
        si
    si

    partial C is
        // A storing method on a class target is not what the union
        // expectation speaks to, and carries no warning.
        poke(b: BOX) -> int is
            b.v = b.v + 1;
            return b.v;
        si
    si

    entry() is
        let u: U mut = U.A(3);

        Std.write_line("total A: {u.total()}");
        Std.write_line("describe: {u.describe()}");

        u = U.B;
        Std.write_line("total B: {u.total()}");
    si
si
