use default

// A literal stored in a local with untyped parameters, passed by name to a
// spread formal whose pack only the later call of the result pins, is
// typed from that call.
retry[T.., U](f: T.. -> U, attempts: int) -> T.. -> U => v => f(v)

let plus = (a, b) => a + b
let safe = retry(plus, 1)

write_line("{safe(2, 3)}")
