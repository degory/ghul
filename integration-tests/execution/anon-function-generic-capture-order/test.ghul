use IO.Std.write_line;
use Collections.Iterable;
use Ghul.Pipes;

// A frameless generic anon function's method signature must index the
// enclosing function's type parameters by their position in the anon
// method's own generic parameter list, not their position in the
// enclosing function's. The two differ when the parameters are captured
// in a different order than the enclosing function declares them.

entry() is
    // second tuple element read through a pipe; first element typed by
    // the enclosing function's second type parameter
    write_line(["bb", "a"] |> tag(7) |> join(", "));

    // first tuple element instead
    write_line(["bb", "a"] |> tag_key(7) |> join(", "));

    // no tuple: the anon captures only the second type parameter, so
    // its one generic parameter must encode as index 0
    write_line(["bb", "a"] |> pick(7) |> join(", "));

    // the idiom the bug blocked: decorate-sort-undecorate over a
    // caller-supplied key
    write_line(
        ["banana", "kiwi", "cherry"]
            |> decorate_sort_undecorate(s => s.length)
            |> join(", "));
si

tag[T, K](items: Iterable[T], key: K) -> Pipe[T] =>
    items |> map(item => (k = key, v = item)) |> map(pair => pair.v);

tag_key[T, K](items: Iterable[T], key: K) -> Pipe[K] =>
    items |> map(item => (k = key, v = item)) |> map(pair => pair.k);

pick[T, K](items: Iterable[K], unused: T) -> Pipe[K] =>
    items |> map(x => x);

decorate_sort_undecorate[T, K: Ghul.Comparable[K]]
    (items: Iterable[T], key: (T) -> K pure) -> Pipe[T]
=>
    items
        |> map(item => (key = key(item), item))
        |> sort_by(pair => pair.key)
        |> map(pair => pair.item);
