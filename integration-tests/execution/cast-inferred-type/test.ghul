namespace Test is
    use Std = IO.Std;

    class HOLDER is
        _values: int[];

        init(values: int[]) is _values = values; si

        `0: int => _values[0];

        at(index: int) -> int => _values[index];
    si

    // Heterogeneous formals: the right formal is unrelated to the left
    // operand's type, so the target can only have come from the
    // operator this resolved to. Declared on `*` rather than `+` so it
    // does not join the candidates the plain `+` cases resolve among —
    // an untyped operand matches every formal, so a second candidate
    // accepting a double on the right would make those ambiguous.
    *(a: HOLDER, b: double) -> double => cast double(a.at(0)) + b;

    takes_a_double(d: double) -> double => d;

    to_double(i: int) -> double => cast(i);

    returns_a_double(i: int) -> double is
        return cast(i);
    si

    class Main is
        entry() static is
            let count = 3;
            let average = 2.5D;

            // typed `let` initializer
            let from_let: double = cast(count);
            Std.out.write_line("let: {from_let}");

            // assignment right-hand side
            let from_assign: double mut = 0.0D;
            from_assign = cast(count);
            Std.out.write_line("assign: {from_assign}");

            Std.out.write_line("arrow body: {to_double(count)}");
            Std.out.write_line("return: {returns_a_double(count)}");

            // call argument
            Std.out.write_line("argument: {takes_a_double(cast(count))}");

            // operator operand, either side
            Std.out.write_line("operator left: {cast(count) + average}");
            Std.out.write_line("operator right: {average + cast(count)}");

            let holder = HOLDER([7, 8, 9]);
            Std.out.write_line("operator formal: {holder * cast(count)}");

            // index argument
            let index = 2L;
            let array = [10, 20, 30];
            Std.out.write_line("array index: {array[cast(index)]}");

            let list = Collections.LIST[int]([40, 50, 60]);
            Std.out.write_line("list index: {list[cast(index)]}");

            // a .NET user-defined conversion operator, reached the same
            // way the numeric conversions are
            let half = cast System.Half(1.5);
            let single_value = 0.5;
            Std.out.write_line("conversion operator: {cast(half) + single_value}");

            // A tuple type is parenthesised, so the target here could
            // have been read either as the elided form or as a cast to
            // `(int, string)`. A type is only taken as the target when
            // the argument list's `(` follows it, which keeps the
            // written-out form reading as it always did.
            let boxed: object = (1, "one");

            let written = cast (int, string)(boxed);
            Std.out.write_line("written tuple target: {written.`0} {written.`1}");

            let elided: (int, string) = cast(boxed);
            Std.out.write_line("elided tuple target: {elided.`0} {elided.`1}");

            return;
        si
    si
si
