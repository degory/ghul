namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // An inlined stage body is emitted by walking it where the fused loop
    // wants it, so every node whose emission generate-il completes - a
    // string interpolation, a cast, an if or case expression's block -
    // emits correctly, under a `for` loop and under a terminal consumer
    // alike. A nested literal that reads the stage parameter is the one
    // shape that still keeps its delegate, and answers the same either
    // way, so every case here is checked by its result.
    class Main is
        entry() static is
            let ns = LIST[int]([1, 2, 3]);
            let ys = LIST[string](["a", "b"]);
            let offset = 10;

            // interpolation
            for s in ns |> map(n => "<{n}>") do
                Std.write_line("for-interp {s}");
            od

            Std.write_line("consumer-interp {ns |> map(n => "<{n}>") |> collect_mutable() |> join(",")}");

            // cast
            for d in ns |> map(n => cast double(n)) do
                Std.write_line("for-cast {d}");
            od

            Std.write_line("consumer-cast {ns |> map(n => cast double(n)) |> collect_mutable() |> join(",")}");

            // if expression
            for s in ns |> map(n => if n > 2 then "big" else "small" fi) do
                Std.write_line("for-if {s}");
            od

            Std.write_line("consumer-if {ns |> map(n => if n > 2 then "big" else "small" fi) |> collect_mutable() |> join(",")}");

            // case expression
            for s in ns |> map(n => case n when 1 then "one" when 2 then "two" else "many" esac) do
                Std.write_line("for-case {s}");
            od

            // captured outer local
            for n in ns |> map(n => n + offset) do
                Std.write_line("for-outer {n}");
            od

            Std.write_line("consumer-outer {ns |> map(n => n + offset) |> collect_mutable() |> join(",")}");

            // struct member access after index()
            for v in ns |> index() |> map(iv => iv.index * 100 + iv.value) do
                Std.write_line("for-index {v}");
            od

            Std.write_line("consumer-index {ns |> index() |> map(iv => "{iv.index}:{iv.value}") |> collect_mutable() |> join(",")}");

            // a nested literal reading the stage parameter: declined,
            // still correct through its delegate
            for f in ns |> map(n => (m: int) => m + n) do
                Std.write_line("for-nested {f(100)}");
            od

            Std.write_line("consumer-nested {ys |> filter(t => ys |> any(u => t =~ u)) |> collect_mutable() |> join(",")}");
        si
    si
si
