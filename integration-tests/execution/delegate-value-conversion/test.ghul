namespace Test is
    use IO.Std;
    use Collections;

    // A function value forwarded through a plain parameter, with no
    // literal at the point it is converted to a delegate.
    sort_with(xs: LIST[int], compare: (int, int) -> int) static is
        xs.sort(System.Comparison[int](compare));
    si

    entry() static is
        let compare: (int, int) -> int = (a: int, b: int) -> int => b - a;

        let c = System.Comparison[int](compare);

        Std.write_line("{c.get_type()}");

        let ys = LIST[int]([3, 1, 2]);
        ys.sort(c);

        for y in ys do
            Std.write_line("{y}");
        od

        let xs = LIST[int]([3, 1, 2]);

        sort_with(xs, compare);

        for x in xs do
            Std.write_line("{x}");
        od
    si
si
