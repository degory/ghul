use IO.Std.write_line;

// Class equality is synthesized only where `@equality` asks for it,
// and asking cascades to every subclass. An abstract base with no
// state of its own still carries the operator, so a comparison
// written against the base type resolves and dispatches to whichever
// subclass the values actually are.

@equality()
class Shape abstract is
    area() -> int;
si

class CIRCLE: Shape is
    radius: int;

    init(radius: int) is
        self.radius = radius;
    si

    area() -> int => radius * radius * 3;
si

class SQUARE: Shape is
    _side: int;

    init(side: int) is
        _side = side;
    si

    area() -> int => _side * _side;
si

// No pragma anywhere above it, so this keeps the reference equality a
// class has by default and `=~` does not resolve for it at all.
class PLAIN is
    value: int;

    init(value: int) is
        self.value = value;
    si
si

entry() is
    let a: Shape = CIRCLE(3);
    let b: Shape = CIRCLE(3);
    let c: Shape = SQUARE(3);

    write_line("{a =~ b}");
    write_line("{a =~ c}");
    write_line("{c =~ SQUARE(3)}");
    write_line("{c =~ SQUARE(4)}");

    // Private state is compared too: the pragma is the author asking
    // for it, so what the members can see is not in question.
    write_line("{PLAIN(1) == PLAIN(1)}");
si
