class BASE is
    init() is si

    greet() -> string => "base";
si

class SUB: BASE is
    init() is super.init(); si

    greet() -> string;
si

entry() is
    let b: BASE = SUB();

    try
        IO.Std.write_line(b.greet());
    catch e: System.NotImplementedException
        IO.Std.write_line("threw: {e.message}");
    yrt
si
