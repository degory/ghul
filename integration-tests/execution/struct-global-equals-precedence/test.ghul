use IO.Std.write_line;

// A global `=~` does not opt a struct out of synthesis: the decision
// reads the type's own members only. Where both exist the member
// operator answers - member first, then a global one - and that order
// does not turn on what happens to be in scope, so the same
// expression resolves the same way from every namespace. A global
// `=~` declared for a struct with a synthesized member is therefore
// shadowed by it; equality that differs from the memberwise answer is
// declared on the type, which opts out of synthesis, or spelled as a
// differently named function.

struct POINT is
    x: int;
    y: int;

    init(x: int, y: int) is
        self.x = x;
        self.y = y;
    si
si

// deliberate: y takes no part in this operator - and none in the
// comparison in entry either, because the synthesized member
// operator, not this global, is what answers there
=~(a: POINT, b: POINT) -> bool => a.x == b.x;

entry() is
    // the member operator answers: memberwise, so differing y differs
    write_line("same x, differing y: {POINT(1, 2) =~ POINT(1, 3)}");
    write_line("differing x: {POINT(1, 2) =~ POINT(2, 2)}");
si
