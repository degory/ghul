namespace Test is
    use IO.Std;

    // Tests: lambda literals in the default-method body of a *generic*
    // trait, including one written in a generic method of its own. The
    // frame class mirrors the trait's type parameter, and a captured
    // receiver is typed as the instantiated trait rather than the bare
    // type name.

    trait Box[T] is
        get_value() -> T;

        captures_local() -> void is
            let n = 3;
            let f = (x: T) -> string => "{x} {n}";
            Std.write_line(f(get_value()));
        si

        captures_self() -> void is
            let f = () -> T => get_value();
            Std.write_line("{f()}");
        si

        compare_by[K: Ghul.Comparable[K]](key_selector: (T) -> K) -> void is
            let compare = (a: T, b: T) -> int => key_selector(a) <> key_selector(b);
            Std.write_line("{compare(get_value(), get_value())}");
        si
    si

    class INT_BOX: Box[int] is
        _value: int;

        init(value: int) is _value = value; si

        get_value() -> int => _value;
    si

    class Main is
        entry() static is
            let b = INT_BOX(5);

            b.captures_local();
            b.captures_self();
            b.compare_by[int](x => x);

            return;
        si
    si
si
