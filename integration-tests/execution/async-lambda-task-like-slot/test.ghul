namespace Test is
    use Std = IO.Std;

    use System.Runtime.CompilerServices.IAsyncStateMachine;
    use System.Runtime.CompilerServices.ICriticalNotifyCompletion;
    use System.Runtime.CompilerServices.INotifyCompletion;

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER[_]))
    class COROUTINE[T] is
        value: T public;
        completed: bool public;

        init() is si
    si

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER))
    class COROUTINE is
        completed: bool public;

        init() is si
    si

    // Parks its continuation on a queue the test drains.
    struct PAUSE: ICriticalNotifyCompletion is
        _queue: Collections.Queue[() -> void];

        init(queue: Collections.Queue[() -> void]) is _queue = queue; si

        get_awaiter() -> PAUSE => self;
        is_completed: bool => false;
        get_result() is si
        on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
        unsafe_on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
    si

    class COROUTINE_BUILDER[T] is
        _coroutine: COROUTINE[T]?;

        init() is si

        create() -> COROUTINE_BUILDER[T] static => COROUTINE_BUILDER[T]();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: COROUTINE[T] is
            if !_coroutine? then
                _coroutine = COROUTINE[T]();
            fi
            return _coroutine;
        si

        set_result(v: T) is
            task.value = v;
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("coroutine failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    class COROUTINE_BUILDER is
        _coroutine: COROUTINE?;

        init() is si

        create() -> COROUTINE_BUILDER static => COROUTINE_BUILDER();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: COROUTINE is
            if !_coroutine? then
                _coroutine = COROUTINE();
            fi
            return _coroutine;
        si

        set_result() is
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("coroutine failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    class SCHEDULER is
        queue: Collections.Queue[() -> void];

        init() is
            queue = Collections.Queue[() -> void]();
        si

        pause() -> PAUSE => PAUSE(queue);

        // Two overloads of the same arity, told apart only by whether
        // the literal's body produces a value.
        spawn(body: SCHEDULER -> COROUTINE) -> COROUTINE => body(self);

        spawn[T](body: SCHEDULER -> COROUTINE[T]) -> COROUTINE[T] => body(self);

        run() is
            while queue.count > 0 do
                queue.dequeue()();
            od
        si
    si

    // A function literal with no declared return type takes its
    // task-like from the slot it goes into: a typed local, a
    // parameter of a non-generic function type, and a generic one
    // whose result argument is inferred from the body's returns.
    class MAIN is
        entry() static is
            let s = SCHEDULER();

            let from_typed_local: SCHEDULER -> COROUTINE = _ is
                await s.pause();
                Std.write_line("typed local resumed");
            si;

            let typed_value: SCHEDULER -> COROUTINE[string] = sch is
                await sch.pause();
                return "typed value";
            si;

            let void_slot = s.spawn(sch is
                Std.write_line("void slot started");
                await sch.pause();
                Std.write_line("void slot resumed");
            si);

            let value_slot = s.spawn((sch: SCHEDULER) is
                await sch.pause();
                return 42;
            si);

            let untyped_value_slot = s.spawn(sch is
                await sch.pause();
                return (sch.queue.count, "pair");
            si);

            let t = from_typed_local(s);
            let v = typed_value(s);

            s.run();

            Std.write_line("typed local: {t.completed}");
            Std.write_line("typed value: {v.value}");
            Std.write_line("void slot: {void_slot.completed}");
            Std.write_line("value slot: {value_slot.value}");
            Std.write_line("untyped value slot: {untyped_value_slot.value}");
        si
    si
si
