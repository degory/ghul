namespace Test is
    trigger(z: int) is
        let a = 1;
        let b = 10 / z;
    si

    // Extracts the innermost frame's reported line from a stack trace
    // string (`   at Test.trigger() in /path/test.ghul:line 4`),
    // rather than printing the raw trace: the test runner strips the
    // ` in <path>:line <N>` suffix from any frame that has one before
    // comparing run.out against run.expected, which would erase the
    // exact signal this test needs.
    reported_line(stack_trace: string) -> int is
        let marker = "line ";
        let index = stack_trace.index_of(marker);

        if index < 0 then
            return 0;
        fi

        let rest = stack_trace.substring(index + marker.length);
        let end = rest.index_of_any(['\r', '\n']);
        let digits = if end < 0 then rest else rest.substring(0, end) fi;

        return int.parse(digits.trim());
    si

    entry() is
        try
            trigger(0);
        catch e: Ghul.DivideByZeroException
            IO.Std.write_line("threw at line {reported_line(e.stack_trace!)}");
        yrt
    si
si
