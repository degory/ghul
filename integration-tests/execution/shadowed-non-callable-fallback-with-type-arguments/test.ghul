use Ghul.Pipes
use IO.Std.write_line

// A name written with type arguments reaches the function a non-callable
// local of the same name shadows, as the same call without them does.
show(xs: int[]) is
    for (index, x) in xs |> index[int]() do
        write_line("{index} {x}")
    od

    let count = xs |> count[int]()

    write_line("{count}")
si

entry() is
    show([10, 20])
si
