use IO.Std.write_line

// A trait called through its type, implemented by a class and by a struct,
// at a reference type, a scalar and a struct argument: each instantiation
// dispatches to its own implementation, as on .NET.

trait Same[T] is
    same(a: T, b: T) -> bool
si

class CLASS_SAME[T]: Same[T] is
    init() is si
    same(a: T, b: T) -> bool => a =~ b
si

struct STRUCT_SAME[T]: Same[T] is
    init() is si
    same(a: T, b: T) -> bool => a =~ b
si

struct P(x: int public)

check[T](s: Same[T], a: T, b: T) -> bool => s.same(a, b)

entry() is
    write_line("{check(CLASS_SAME[string](), "a", "a")} {check(CLASS_SAME[int](), 1, 2)} {check(CLASS_SAME[P](), P(1), P(1))}")
    write_line("{check(STRUCT_SAME[string](), "a", "b")} {check(STRUCT_SAME[int](), 3, 3)} {check(STRUCT_SAME[P](), P(1), P(2))}")
si
