use default

// `use default` stands for the curated import set, so the sequence
// combinators, the collections and `write_line` are all in scope from
// the one clause. An explicit import of something already in the set is
// how a file adds to it, and is not a duplicate.
use Ghul.Pipes

total(xs: int[]) -> int =>
    xs |> filter(x => x % 2 == 0) |> map(x => x * 10) |> reduce(0, (a, b) => a + b)

entry() is
    let names = LIST[string]()

    names.add("first")

    let counts = MAP[string, int]()

    counts.add("only", names.count)

    write_line("{total([1, 2, 3, 4])} {names[0]} {counts["only"]}")
si
