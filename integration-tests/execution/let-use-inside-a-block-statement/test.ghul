namespace Test is
    use Ghul;
    use Std = IO.Std;

    class HANDLE: Disposable is
        init() is si

        read() -> string => "read";

        dispose() is
            Std.write_line("disposed");
        si
    si

    class Main is
        // A `let use` one statement list further in - here the `if`'s
        // body - has a disposal region of its own, and is unaffected
        // by the parenthesised block around it.
        described(flag: bool) -> string static is
            let text = (
                if flag then
                    let use handle = HANDLE();

                    Std.write_line(handle.read());
                fi

                "done"
            );

            return text;
        si

        entry() static is
            Std.write_line(described(true));
        si
    si
si
