use IO.Std.write_line;

struct N(v: int) is
    ⊕(other: N) -> N => N(v + other.v);
    ⊗(other: N) -> N => N(v * other.v);
    ⊻(other: N) -> N => N(v ^ other.v);
    ≤(other: N) -> bool => v <= other.v;
    to_string() -> string => "{v}";
si

let two = N(2);
let three = N(3);
let four = N(4);
let five = N(5);

write_line("{two ⊕ three ⊗ four}");
write_line("{two ⊻ three ⊕ five}");
write_line("{two ≤ three ⊕ four}");
