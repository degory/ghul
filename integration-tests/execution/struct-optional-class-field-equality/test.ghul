namespace Test is
    use IO.Std.write_line

    // A struct's synthesized `=~` over an optional field of a class that
    // declares no equality compares the field by reference, absent
    // values included.
    class NODE(name: string)

    struct HOLDER is
        node: NODE? public

        init(node: NODE?) is
            self.node = node
        si
    si

    entry() is
        let first = NODE("first")
        let second = NODE("first")

        write_line("{HOLDER(first) =~ HOLDER(first)}")
        write_line("{HOLDER(first) =~ HOLDER(second)}")
        write_line("{HOLDER(null) =~ HOLDER(null)}")
        write_line("{HOLDER(first) =~ HOLDER(null)}")
        write_line("{HOLDER(null) =~ HOLDER(first)}")
    si
si
