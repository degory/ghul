namespace Test is
    use IO.Std.write_line

    /// A thing with a size.
    ///
    /// Grows on request.
    class WIDGET is
        /// How big it is.
        size: int public

        init() is si

        /// Doubles the size.
        @suppress("non-snake-case-name")
        Grow() is size = size * 2; si

        // Not documented.
        shrink() is size = size / 2; si
    si

    /// Shades.
    enum Shade is
        /// Quite dark.
        DARK,
        LIGHT
    si

    //// A divider, not a doc comment.
    entry() is
        let widget = typeof WIDGET

        show("WIDGET", widget)
        show("size", widget.get_property("size"))
        show("Grow", widget.get_method("Grow"))
        show("shrink", widget.get_method("shrink"))
        show("DARK", (typeof Shade).get_field("DARK"))
        show("LIGHT", (typeof Shade).get_field("LIGHT"))
        show("entry", widget.assembly.get_type("Test.$globals")?.get_method("entry"))
    si

    show(what: string, member: System.Reflection.MemberInfo?) is
        if !member? then
            write_line("{what}: missing")
            return
        fi

        for attribute in member.get_custom_attributes_data() do
            if attribute.attribute_type.full_name =~ "Ghul.Internal.DOC_ATTRIBUTE" then
                write_line("{what}: {attribute.constructor_arguments[0].value}")
                return
            fi
        od

        write_line("{what}: no doc")
    si
si
