use IO.Std.write_line

// A struct's methods change it where it is held, assigning one copies it,
// and a scalar's and a range's methods are a struct's methods too.
struct COUNTER is
    count: int field

    init(start: int) is
        count = start
    si

    bump() is
        count = count + 1
    si
si

entry() is
    let counter mut = COUNTER(5)

    counter.bump()
    counter.bump()

    let copy mut = counter

    copy.bump()

    write_line("{counter.count} {copy.count}")

    let total mut = 0

    for i in 1::4 do
        total = total + i
    od

    write_line(total.to_string())
    write_line("{-17 / 5} {-17 % 5} {17 / 5}")

    try
        let zero = total - 10
        write_line("{total / zero}")
    catch e: Ghul.DivideByZeroException
        write_line("divide by zero")
    yrt
si
