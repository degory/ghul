use IO.Std.write_line

// A deferred-init local passed to a generic call before its assignment
// takes its type from that assignment, and the call's type argument is
// the join of it and the other arguments.
class ANIMAL is init() is si si
class CAT: ANIMAL is init() is super.init() si si

describe(a: CAT) -> string => "cat"
describe(a: ANIMAL) -> string => "animal"

pick[T](a: T, b: T) -> T => b

pick_first[T](a: T, b: T) -> T => a
pick_first[T](a: T, b: T, c: T) -> T => a

widened() is
    let x mut
    let r = pick(x, CAT())
    x = ANIMAL()
    write_line("x {describe(x)}, r {describe(r)}")
si

overloaded() is
    let x mut
    let r = pick_first(x, CAT())
    x = ANIMAL()
    write_line("overloaded r {describe(r)}")
si

unassigned_later() is
    let x mut
    x = CAT()
    let r = pick(x, CAT())
    write_line("assigned first r {describe(r)}")
si

widened()
overloaded()
unassigned_later()
