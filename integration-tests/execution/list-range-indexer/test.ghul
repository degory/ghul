namespace Test is
    use Std = IO.Std;
    use Collections;

    // A window is taken through `List[T]`, not on every type that
    // satisfies it: the indexer is supplied on the interface, and an
    // implementor neither inherits it nor is required to provide it.
    // MINE is here to pin the second half - supplying a member on an
    // interface this widely implemented must stay inert for implementors,
    // or every collection in every consuming assembly stops compiling.
    class MINE: List[int] is
        _xs: int[];

        init(xs: int[]) is
            _xs = xs;
        si

        [i: int]: int => _xs[i];

        count: int => _xs.count;

        iterator: Iterator[int] => _xs.iterator;
    si

    class Main is
        show(label: string, v: List[int]) static is
            let sb = System.Text.StringBuilder();

            for x in v do
                sb.append("{x} ");
            od

            Std.write_line("{label}: {sb}");
        si

        entry() static is
            let xs: List[int] = LIST[int]([10, 20, 30, 40, 50]);

            show("drop last ", xs[1..<1]);
            show("to the end", xs[1..<0]);
            show("last three", xs[3..<<0]);
            show("inclusive ", xs[1::<1]);
            show("from start", xs[1..3]);
            show("incl start", xs[1::3]);

            let mine: List[int] = MINE([1, 2, 3]);

            show("implementor", mine[1..<0]);

            Std.write_line("plain: {xs[2]}");
        si
    si
si
