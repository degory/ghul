namespace Test is
    use Std = IO.Std;

    @System.Flags()
    enum Flags is
        NONE = 0,
        READ = 1,
        WRITE = 2,
        EXECUTE = 4,
    si

    class Main is
        entry() static is
            let read = Flags.READ;
            let write = Flags.WRITE;
            let read_write = Flags.READ | Flags.WRITE;

            Std.out.write_line("READ | WRITE == READ_WRITE: {(read | write) == read_write}");
            Std.out.write_line("READ_WRITE & READ == READ: {(read_write & read) == read}");
            Std.out.write_line("READ_WRITE & EXECUTE == NONE: {(read_write & Flags.EXECUTE) == Flags.NONE}");
            Std.out.write_line("READ ^ WRITE == READ_WRITE: {(read ^ write) == read_write}");
            Std.out.write_line("READ ^ READ == NONE: {(read ^ read) == Flags.NONE}");
            Std.out.write_line("not NONE & READ_WRITE == READ_WRITE: {(\Flags.NONE & read_write) == read_write}");
            Std.out.write_line("not READ & READ == NONE: {(\read & read) == Flags.NONE}");

            return;
        si
    si
si
