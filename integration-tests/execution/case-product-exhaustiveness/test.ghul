namespace Test is
    use Std = IO.Std;

    union SHAPE is
        A(v: int);
        B(v: int);
    si

    class POINT(x: bool, y: bool);

    class Main is
        entry() static is
            Std.write_line("{pair(SHAPE.A(1), SHAPE.B(2))}");
            Std.write_line("{half(false, false)}");
            Std.write_line("{nested(true, false, true)}");
            Std.write_line("{destructured(POINT(true, false))}");
        si

        // A product of two closed domains is covered by covering the
        // combinations, with no `else` and no catch-all arm.
        pair(x: SHAPE, y: SHAPE) -> int static =>
            case (x, y)
            when (a: SHAPE.A, b: SHAPE.A) then 0
            when (a: SHAPE.A, b: SHAPE.B) then 1
            when (a: SHAPE.B, b: SHAPE.A) then 2
            when (a: SHAPE.B, b: SHAPE.B) then 3
            esac;

        // A wildcard in one column covers that column's whole domain,
        // so two arms suffice for four combinations.
        half(a: bool, b: bool) -> int static =>
            case (a, b)
            when (_, true) then 1
            when (_, false) then 2
            esac;

        // Nesting recurses: the inner group is a product in its own
        // right.
        nested(a: bool, b: bool, c: bool) -> int static =>
            case (a, (b, c))
            when (true, _) then 1
            when (false, (true, _)) then 2
            when (false, (false, _)) then 3
            esac;

        // The shape comes from whatever the language destructures, so
        // a class with a primary constructor works the same way.
        destructured(p: POINT) -> int static =>
            case p
            when (true, true) then 0
            when (true, false) then 1
            when (false, true) then 2
            when (false, false) then 3
            esac;
    si
si
