use IO.Std.write_line

// A loop label among top-level statements labels the loop, as it does in a
// body, rather than beginning a global declaration.
let values = [1, 2, 3]

rows: for row in values do
    if row == 2 then
        break rows
    fi

    write_line("row {row}")
od

let count mut = 0

outer: while true do
    inner: do
        count = count + 1

        if count > 2 then
            break outer
        fi

        continue outer
    od
od

write_line("count {count}")

limit: int

limit = 5

write_line("limit {limit}")
