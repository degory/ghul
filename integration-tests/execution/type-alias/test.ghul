namespace Test is
    use Console = IO.Std;

    use IndexedString = (index: int, value: string);
    use Pair[A, B] = (first: A, second: B);
    use IntPair = Pair[int, int];
    use StringMap[V] = Collections.MAP[string, V];
    use Names = string[];
    use MaybeName = string?;
    use Handler = (int) -> void;
    use Numbers = Collections.LIST[int];

    swap[A, B](p: Pair[A, B]) -> Pair[B, A] =>
        (first = p.second, second = p.first);

    total(xs: Numbers) -> int is
        let sum mut = 0;

        for x in xs do
            sum = sum + x;
        od

        return sum;
    si

    entry() is
        let indexed: IndexedString = (index = 1, value = "one");

        Console.write_line("{indexed.index} {indexed.value}");

        // An alias is the type it names, so the underlying spelling and
        // the alias are interchangeable in both directions.
        let plain: (int, string) = indexed;
        let back: IndexedString = plain;

        Console.write_line("{back.value}");

        let pair: Pair[int, string] = (first = 2, second = "two");
        let swapped = swap(pair);

        Console.write_line("{swapped.first} {swapped.second}");

        let ints: IntPair = (first = 3, second = 4);

        Console.write_line("{ints.first} {ints.second}");

        let map: StringMap[int] = _();

        map["five"] = 5;

        Console.write_line("{map["five"]}");

        let names: Names = ["six", "seven"];

        Console.write_line("{names.count} {names[1]}");

        let maybe: MaybeName = null;

        Console.write_line("{maybe?}");

        let handler: Handler = i => Console.write_line("handled {i}");

        handler(8);

        // Constructing through an alias constructs what it names.
        let numbers = Numbers();

        numbers.add(9);
        numbers.add(10);

        Console.write_line("{total(numbers)}");

        let anything: object = numbers;

        if isa Numbers(anything) then
            Console.write_line("narrowed to {anything.count}");
        fi
    si
si
