use default

class BLAH(args: string[]);

class EXPLICIT is
    args: string[]

    init(args: string[]) is
        self.args = args
    si
si

struct HOLDER(args: string[]);

union Wrap is
    SOME(args: string[]);
si

class G[T](items: T[]);

takes(args: string[]) -> int => args.count

write_line("function {takes([])} {takes(["a"])}")
write_line("primary {BLAH([]).args.count} {BLAH(["a"]).args.count}")
write_line("explicit {EXPLICIT([]).args.count} {EXPLICIT(["a"]).args.count}")
write_line("struct {HOLDER([]).args.count} {HOLDER(["a"]).args.count}")
write_line("variant {(cast Wrap.SOME(Wrap.SOME([]))).args.count}")
write_line("generic {G[int]([]).items.count} {G([1]).items.count}")

let pinned: G[int] = G([])

write_line("pinned {pinned.items.count}")
