use IO.Std.write_line;
use Ghul.Pipes.Pipe;

// A generator returning a closed instantiation of a generic trait
// derived from `Pipe[T]`. The element type is read off the return
// type's ancestors, which on a closed instantiation are the
// unspecialised trait's: read without specialising, the state
// machine's element field takes the trait's type parameter and the
// assembly fails to load.
trait Numbers[T]: Pipe[T] is si

counting() -> Numbers[int] is
    yield 1;
    yield 2;
si

for n in counting() do
    write_line("{n}");
od
