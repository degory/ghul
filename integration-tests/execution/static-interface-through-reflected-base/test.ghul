use IO.Std.write_line

// IPAddress implements ISpanParsable, whose parse is static abstract.
// The base supplies it, and .NET lets a derived type inherit that, so
// this is not the shape the static-member check refuses.
class MY_ADDRESS: System.Net.IPAddress is
    init() is
        super.init(0L)
    si
si

entry() is
    let address = MY_ADDRESS()

    write_line("{address}")
si
