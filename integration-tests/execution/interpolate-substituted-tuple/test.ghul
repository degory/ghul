use default

class SPEAKS is
    init() is si

    to_string() -> string => "speaks"
si

pair_of[T](a: T, b: T) -> (T, T) => (a, b)

entry() is
    write_line("written out:  {(LIST[int]([1]), LIST[int]([2]))}")
    write_line("substituted:  {pair_of(LIST[int]([1]), LIST[int]([2]))}")
    write_line("from a pipe:  {[1, 2, 3] |> partition(n => n % 2 == 0)}")
    write_line("its own text: {pair_of(SPEAKS(), SPEAKS())}")
    write_line("an absent:    {pair_of[string?](null, "here")}")
si
