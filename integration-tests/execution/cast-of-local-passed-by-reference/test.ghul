// A local passed by reference is held in a cell; reading it back and
// converting it reads the value out of the cell once.
use IO.Std.write_line
use Collections.MAP

enum Level is
    LOW,
    HIGH,
si

entry() is
    let levels = MAP[string, Level]()

    levels["up"] = Level.HIGH

    let level: Level mut = Level.LOW

    if levels.try_get_value("up", level ref) then
        write_line("{cast int(level)} {cast int(level) > cast int(Level.LOW)}")
    fi

    let count: int mut = 0
    let counts = MAP[string, int]()

    counts["n"] = 41

    if counts.try_get_value("n", count ref) then
        write_line("{double(count) + 1.0}")
    fi
si
