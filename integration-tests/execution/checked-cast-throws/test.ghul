use IO.Std.write_line;

class ANIMAL is
    init() is si
si

class CAT: ANIMAL is
    init() is si
si

union COLOUR is
    RED;
    GREEN;
si

entry() is
    let a: ANIMAL = ANIMAL();

    // A cast that is allowed to fail says so, and declines.
    let maybe_cat = cast CAT?(a);

    write_line("optional cast declined: {!maybe_cat?}");

    // A refutable type test declines too - it shares the cast's lowering
    // but must never fault.
    if let c: CAT = a then
        write_line("unexpected: if let matched");
    else
        write_line("if let declined");
    fi

    case a
    when c: CAT then
        write_line("unexpected: case arm matched");
    else
        write_line("case arm declined");
    esac

    // A union compares unequal across variants rather than throwing out
    // of the synthesised equality bridge, which casts to reach it.
    write_line("RED =~ GREEN: {COLOUR.RED =~ COLOUR.GREEN}");

    // A cast that succeeds is unaffected.
    let real: ANIMAL = CAT();

    let good = cast CAT(real);

    write_line("good cast: {good.get_type().name}");

    // And a cast the program wrote, to a type the value does not have,
    // faults here rather than producing a null the type denies.
    try
        let bad = cast CAT(a);

        write_line("unexpected: reached");
    catch e: System.InvalidCastException
        write_line("checked cast threw");
    yrt
si
