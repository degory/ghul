use default

// A local whose type comes from a later call, indexed by a lambda
// parameter that has no type of its own yet. Each settles the other's
// input: the index is what the receiver's element type is reached
// through, and what a list is indexed by is what the receiver settles
// to. The shape is the spiral-matrix Rosetta Code solution's own.
spiral(size: int) -> LIST[LIST[int]] is
    let grid = LIST()

    for _ in 0..size do
        grid.add(LIST((0..size) |> map((column: int) => 0)))
    od

    let free = (row, column) => grid[row][column] == 0

    let filled mut = 0

    for row in 0..size do
        for column in 0..size do
            if free(row, column) then
                filled = filled + 1
                grid[row][column] = filled
            fi
        od
    od

    grid
si

entry() is
    let grid = LIST()
    grid.add(LIST([-1, -1]))

    let negative = (row, column) => grid[row][column] < 0

    write_line("{negative(0, 1)}")

    spiral(3) |> each(row => write_line("{row |> map(n => "{n}") |> join(" ")}"))
si
