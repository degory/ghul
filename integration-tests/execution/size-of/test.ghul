// The bytes a value of a type takes where it is stored, as an array's
// element holds it.
use IO.Std.write_line

@intrinsic("type.size_of")
size_of[T]() -> int => -1

struct PAIR(a: int, b: long)

class THING(name: string)

measured[T]() -> int => Ghul.Intrinsics.size_of[T]()

entry() is
    write_line("int {Ghul.Intrinsics.size_of[int]()}")
    write_line("long {Ghul.Intrinsics.size_of[long]()}")
    write_line("bool {Ghul.Intrinsics.size_of[bool]()}")
    write_line("struct {Ghul.Intrinsics.size_of[PAIR]()}")
    write_line("class {Ghul.Intrinsics.size_of[THING]()}")
    write_line("parameter {measured[int]()} {measured[THING]()}")
si
