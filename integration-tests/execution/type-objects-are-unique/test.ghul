// A type has one type object, however it is asked for.
use IO.Std.write_line

class THING is init() is si si
class OTHER is init() is si si

entry() is
    let a = THING()
    let b = THING()

    write_line("{a.get_type() == b.get_type()}")
    write_line("{typeof THING == a.get_type()}")
    write_line("{a.get_type() == OTHER().get_type()}")
    write_line(a.get_type().name)

    let seen = Collections.SET[object]()
    seen.add(a.get_type())
    seen.add(b.get_type())
    seen.add(typeof THING)
    seen.add(typeof OTHER)
    write_line("{seen.count}")
si
