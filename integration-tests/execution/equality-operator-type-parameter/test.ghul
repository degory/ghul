namespace Test is
    use Std = IO.Std;

    class BOX is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: BOX) -> bool => _v == other._v;

        get_hash_code() -> int => _v;
    si

    class NODE is
        _v: int;

        init(v: int) is _v = v; si
    si

    struct POINT is
        x: int;
        y: int;

        init(x: int, y: int) is self.x = x; self.y = y; si
    si

    enum Suit is
        HEARTS,
        SPADES,
    si

    // A method on a generic class compares its own type parameter the
    // same way a generic function does.
    class HOLD[T] is
        a: T field;
        b: T field;

        init(a: T, b: T) is self.a = a; self.b = b; si

        same() -> bool => a =~ b;
    si

    // A type parameter with a bound that declares `=~` keeps resolving
    // the bound's operator rather than falling to the comparer.
    trait NAMED is
        name: string;

        =~(other: NAMED) -> bool => name == other.name;
    si

    class PET: NAMED is
        name: string public;

        init(name: string) is self.name = name; si
    si

    generic_eq[T](a: T, b: T) -> bool => a =~ b;

    generic_ne[T](a: T, b: T) -> bool => a !~ b;

    named_eq[T: NAMED](a: T, b: T) -> bool => a =~ b;

    class Main is
        entry() static is
            Std.out.write_line("expect True False: int: {generic_eq(1, 1)} {generic_eq(1, 2)}");
            Std.out.write_line("expect True False: string: {generic_eq("a", "a")} {generic_eq("a", "b")}");
            Std.out.write_line("expect False True: !~: {generic_ne(1, 1)} {generic_ne(1, 2)}");

            // A type declaring `=~` and `get_hash_code` carries the
            // Equals bridge the comparer reaches, so the user's
            // operator answers.
            Std.out.write_line("expect True False: =~ class: {generic_eq(BOX(1), BOX(1))} {generic_eq(BOX(1), BOX(2))}");

            // A class with no `=~` compares by reference through the
            // comparer, as it does everywhere else.
            Std.out.write_line("expect False False: no-operator class: {generic_eq(NODE(1), NODE(1))} {generic_eq(NODE(1), NODE(2))}");

            Std.out.write_line("expect True False: struct: {generic_eq(POINT(1, 2), POINT(1, 2))} {generic_eq(POINT(1, 2), POINT(3, 4))}");

            Std.out.write_line("expect True False: enum: {generic_eq(Suit.HEARTS, Suit.HEARTS)} {generic_eq(Suit.HEARTS, Suit.SPADES)}");

            Std.out.write_line("expect True False: class-level T: {HOLD[int](1, 1).same()} {HOLD[int](1, 2).same()}");

            Std.out.write_line("expect True False: bounded T: {named_eq(PET("rex"), PET("rex"))} {named_eq(PET("rex"), PET("fido"))}");
        si
    si
si
