use IO.Std.write_line

use Ghul.`>>

// Tests: a body that is compiled more than once presents each call whose
// declared return is pack-marked through one generated closure, however
// many times the call was compiled: the assembly holds one closure frame
// for each presented value - here the operand going into the operator and
// the function the operator returns - and none that nothing references.

make() -> (int, int) -> int => (a: int, b: int) -> int => a + b

both() -> (int, int) -> string => make() >> (x => "<{x}>")

entry() is
    write_line(both()(3, 4))

    let frames mut = 0

    for type in System.Reflection.Assembly.get_entry_assembly()!.get_types() do
        if type.name.starts_with("$frame") then
            frames = frames + 1
        fi
    od

    write_line("frames: {frames}")
si
