use IO.Std.write_line

// A checked cast to a type the value is not throws InvalidCastException, which
// a program can catch, and the optional form answers absent instead.

class Animal abstract is
    init() is si
si

class CAT: Animal is
    init() is super.init() si
si

class DOG: Animal is
    init() is super.init() si
si

pick(cat: bool) -> Animal => if cat then CAT() else DOG() fi

attempt(name: string, operation: () -> string) is
    try
        write_line("{name}: {operation()}")
    catch e: Ghul.InvalidCastException
        write_line("{name}: invalid cast")
    yrt
si

@suppress("cast-may-throw")
as_cat(a: Animal) -> CAT => cast CAT(a)

@suppress("cast-may-throw")
as_string(o: object) -> string => cast string(o)

attempt("cat as cat", () -> string => "{as_cat(pick(true)).get_type().name}")
attempt("dog as cat", () -> string => "{as_cat(pick(false)).get_type().name}")
attempt("int as string", () -> string => as_string(42))
attempt("optional dog as cat", () -> string => if cast CAT?(pick(false))? then "present" else "absent" fi)
