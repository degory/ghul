namespace Test is
    use Std = IO.Std;

    class HELPER is
        init() is si

        pair(a: string, b: string) -> string => "{a}/{b}";

        joined(a: string, b: string) -> string static => "{a}|{b}";
    si

    class MAIN is
        one() -> Tasks.TASK[int] static => Tasks.TASK.from_result(1);

        // The receiver of a static call names a type, so it holds no
        // value for a suspend to lose and nothing to spill.
        g() -> Tasks.TASK static is
            IO.Std.write_line("qualified {await MAIN.one()}");
            Std.write_line("alias {await MAIN.one()}");
            IO.Std.write_line(HELPER.joined("x", "{await MAIN.one()}"));

            let h = HELPER();
            IO.Std.write_line(h.pair("y", "{await MAIN.one()}"));
        si

        entry() static is
            g().wait();
        si
    si
si
