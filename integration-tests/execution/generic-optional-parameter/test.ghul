namespace Test is
    use IO.Std;

    // A `T?` parameter on an unconstrained type parameter lowers to
    // MAYBE[T]. Every other `T?` lowering — a reference type carrying
    // the optional flag, and NULLABLE[T] — reaches such a slot through
    // an implicit coercion, and the type argument is inferred from
    // whichever carrier the actual arrived in.

    class CAT is
        name: string;
        init(name: string) is self.name = name; si
        to_string() -> string => "cat {name}";
    si

    class Main is
        is_absent[T](value: T?) -> bool static => !value?;

        show[T](value: T?) -> string static =>
            if value? then "some {value}" else "none" fi;

        pick[T](a: T?, b: T?) -> T? static => if a? then a else b fi;

        which[T](value: T) -> string static => "non-optional";
        which[T](value: T?) -> string static => "optional";

        entry() static is
            let no_string: string? = null;
            let a_string: string? = "hello";
            let no_int: int? = null;
            let an_int: int? = 42;
            let no_cat: CAT? = null;
            let a_cat: CAT? = CAT("tabby");

            Std.write_line("absent: {is_absent(no_string)} {is_absent(no_int)}");
            Std.write_line("present: {is_absent(a_string)} {is_absent(an_int)}");
            Std.write_line("explicit: {is_absent[string](no_string)} {is_absent[int](an_int)}");

            Std.write_line("show: {show(no_string)} {show(a_string)}");
            Std.write_line("show: {show(no_int)} {show(an_int)}");
            Std.write_line("show: {show(no_cat)} {show(a_cat)}");

            // A non-optional actual widens into the slot, and a bare
            // null pins nothing, so it needs the type argument.
            Std.write_line("widened: {show("bare")} {show(7)}");
            Std.write_line("null: {show[string](null)}");

            // Back out of the slot into each carrier again.
            let chosen: CAT? = pick(no_cat, a_cat);
            let chosen_int: int? = pick(no_int, an_int);
            Std.write_line("pick: {chosen} {chosen_int}");
            Std.write_line("pick absent: {pick[string](null, null)?}");

            // Both overloads bind now, so the tie is settled by which
            // formal fits the actual exactly once its type argument is
            // known: `T` takes `int` and `int?` as they stand, where
            // `T?` would have to widen or re-wrap either of them.
            Std.write_line("overload: {which(7)} {which(no_int)}");

            return;
        si
    si
si
