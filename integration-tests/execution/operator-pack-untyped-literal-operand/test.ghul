use default

// An untyped N-ary literal written as the operand of an operator whose
// formal takes an argument pack is typed as the same literal passed to
// the call spelling is: from a later call of the result, or from the
// function type the context expects.
>=>[T.., U, V](f: T.. -> U, g: (U) -> V) -> T.. -> V => v => g(f(v))

double(x: int) -> int => x * 2

write_line("{(((a, b) => a + b) >=> double)(1, 2)}")

let composed = ((a, b) => a * b) >=> double
write_line("{composed(3, 4)}")

let pinned: (int, int) -> int = ((a, b) => a - b) >=> double
write_line("{pinned(10, 4)}")
