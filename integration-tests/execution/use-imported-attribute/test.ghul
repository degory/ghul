use System.Obsolete;
use Marker = System.Obsolete;

@Obsolete("short form")
class SHORT is
    init() is si
si

@Marker("aliased")
class ALIASED is
    init() is si
si

show(label: string, value: object) is
    for a in value.get_type().get_custom_attributes(false) do
        let obsolete = cast System.ObsoleteAttribute?(a);

        if obsolete? then
            IO.Std.write_line("{label}: {obsolete.message}");
        fi
    od
si

entry() is
    show("SHORT", SHORT());
    show("ALIASED", ALIASED());
si
