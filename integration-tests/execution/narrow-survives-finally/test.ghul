use default

class THING is
    init() is si

    close() is
        write_line("closed")
    si
si

make() -> THING? => THING()

busy() is
    write_line("busy")
si

entry() is
    let tested = make()

    if tested? then
        try
            busy()
        finally
            tested.close()
        yrt
    fi

    if let held = make() then
        try
            busy()
        finally
            held.close()
        yrt
    fi
si
