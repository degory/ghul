namespace Test is
    use Std = IO.Std;

    // ghūl gives every enum the bitwise operators regardless of intent
    // (see `enum-bitwise-operators`), rather than gating them behind a
    // `[Flags]`-equivalent as C# does. `System.FlagsAttribute` still
    // works as-is through the ordinary .NET-attribute pragma: applying
    // it changes only `to_string()`'s rendering of a combined value,
    // the same as it does in C#.

    @System.Flags()
    enum Access is
        NONE = 0,
        READ = 1,
        WRITE = 2,
        EXECUTE = 4,
    si

    class Main is
        entry() static is
            let combined = Access.READ | Access.WRITE;

            Std.out.write_line("{combined}");
            Std.out.write_line("{Access.NONE}");
            Std.out.write_line("{Access.READ | Access.WRITE | Access.EXECUTE}");

            return;
        si
    si
si
