namespace Test is
    use Std = IO.Std;

    // System.FlagsAttribute has two effects here: it gates whether the
    // enum gets the bitwise operators at all (see
    // `enum-bitwise-operators-need-flags`, which pins the case without
    // it), and it changes `to_string()`'s rendering of a combined value
    // to its constituent names, which is what this test pins.

    @System.Flags()
    enum Access is
        NONE = 0,
        READ = 1,
        WRITE = 2,
        EXECUTE = 4,
    si

    class Main is
        entry() static is
            let combined = Access.READ | Access.WRITE;

            Std.out.write_line("{combined}");
            Std.out.write_line("{Access.NONE}");
            Std.out.write_line("{Access.READ | Access.WRITE | Access.EXECUTE}");

            return;
        si
    si
si
