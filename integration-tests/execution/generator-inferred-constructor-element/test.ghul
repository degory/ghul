namespace Test is
    use Std = IO.Std;

    class Main is
        gen(limit: int) -> Ghul.Pipes.Pipe[int] static is
            let seen = Collections.LIST();

            for i in 1..limit do
                for s in seen do
                    Std.write_line("seen: {s}");
                od

                seen.add(i);

                yield i;
            od
        si

        entry() static is
            for v in gen(4) do
                Std.write_line("v: {v}");
            od
        si
    si
si
