use IO.Std.write_line

// memberwise_clone makes a separate object holding the same fields.
class POINT is
    x: int public
    y: int public

    init(x: int, y: int) is
        self.x = x
        self.y = y
    si

    copy() -> POINT => cast POINT?(memberwise_clone())!
si

entry() is
    let original = POINT(3, 4)
    let copy = original.copy()

    write_line("{copy.x} {copy.y} {copy == original}")

    copy.x = 5

    write_line("{original.x} {copy.x}")
si
