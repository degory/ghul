use IO.Std.write_line
use Ghul.Pipes

// Tests: a function literal written with an argument pack spread out,
// going into a formal that takes the pack as one tuple, in each of the
// positions such a literal can stand: parameters untyped and typed, a
// captured value read in the body and in a literal nested in it,
// the chain consumed by a terminal and by `for`, the pack bound by
// another argument and by nothing but the literal itself, and a body
// that has to be compiled more than once for an unrelated reason.

traced[T.., U](f: T.. -> U) -> T.. -> U => v => (write_line("call {v}"); f(v))

call[T.., U](f: T.. -> U, v: T..) -> U => f(v)

takes(xs: int[]) is si

struct POINT(x: int public, y: int public)

entry() is
    let later = []

    let pairs = [(1, 2), (3, 4)]

    write_line("{pairs |> map((a, b) => a + b)}")
    write_line("{pairs |> map((a: int, b: int) -> int => a * b)}")

    let k = 10

    write_line("{pairs |> map((a, b) => a + b + k) |> reduce(0, (total, x) => total + x)}")

    for s in pairs |> map((a, b) => a * b) |> filter(p => p > 2) do
        write_line("{s}")
    od

    write_line("{pairs |> map((a, b) => (let inner = () => a + b + k; inner()))}")

    write_line("{call((x, y) => x - y, 9, 4)}")
    write_line("{call((x: int, y: int) => x - y, (9, 4))}")
    write_line("{call((x, y) => x * y, POINT(6, 7))}")
    write_line("{call((x: object, y: object) => "{x}/{y}", (1, "one"))}")

    let t = traced((a, b) => a * b)

    write_line("{t(3, 4)}")

    takes(later)
si
