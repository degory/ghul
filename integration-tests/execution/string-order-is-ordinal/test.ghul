use IO.Std.write_line
use Ghul.Pipes

// Tests: strings order by UTF-16 code unit on every target, so upper case
// sorts before lower case and punctuation by its code, with `<>` and the
// relational operators alike.

let words = ["banana", "Apple", "apple", "12 + 3", "12 - 3", "_under", "Zebra", "a-b", "a+b", "ápple"]

write_line(words |> sort((a, b) => a <> b) |> join(", "))

write_line("{"apple" <> "Apple" > 0} {"Apple" < "apple"} {"a" > "B"} {"abc" <= "abd"} {"x" >= "x"}")
