use IO.Std.write_line;

// Narrowing must know the result of a constructor call holds a
// value, for both construction forms (`Foo(args)`, and `_(args)`
// with the type inferred from the slot), and for both the
// initializer and the assignment-to-optional-local paths. Without
// this, the `null-deref` warning fires on the
// immediately-following dereference even though the value is
// trivially non-null.

class BOX is
    contents: int;

    init(c: int) is
        self.contents = c;
    si

    describe() -> string => "box of {contents}";
si

entry() is
    // Assignment path.
    let a: BOX? mut = null;
    a = BOX(1);
    write_line(a.describe());

    let b: BOX? mut = null;
    b = BOX(2);
    write_line(b.describe());

    let c: BOX? mut = null;
    c = _(3);
    write_line(c.describe());

    // Initializer path.
    let d: BOX? = BOX(4);
    write_line(d.describe());

    let e: BOX? = BOX(5);
    write_line(e.describe());

    let f: BOX? = _(6);
    write_line(f.describe());
si
