namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;
    use Collections.LIST;

    // Tests: the enclosing lambda's parameter (`row`) is inferred
    // purely from a nested lambda's `if`-expression body comparing
    // it against the nested lambda's own inferred parameter. Both
    // parameters come from void-returning closures (`each`), whose
    // function type carries no trailing return-type slot.

    class Main is
        entry() static is
            let rows = LIST([3, 1]);

            rows |> each(row =>
                write_line((0..4) |> map(c => if c == row then "Q" else "." fi) |> join(" ")));

            return;
        si
    si
si
