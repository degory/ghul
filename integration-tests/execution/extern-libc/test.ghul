namespace Test is
    use IO.Std.write_line;

    // Tests: a body-less global function declared extern calls the named
    // symbol in the C library, on every target that links one. Covers an
    // int, a long, a double, a string argument marshalled to a native
    // buffer, a name that differs from the ghūl one, and a void result.

    @extern("libc", "abs")
    absolute(value: int) -> int;

    @extern("libc", "labs")
    long_absolute(value: long) -> long;

    @extern("libc", "atof")
    parse_float(text: string) -> double;

    @extern("libc", "strlen")
    length_of(text: string) -> word;

    @extern("libc", "toupper")
    upper(code: int) -> int;

    @extern("libc", "srand")
    seed(value: uint);

    entry() is
        write_line("{absolute(-7)}");
        write_line("{long_absolute(-4_000_000_000L)}");
        write_line("{parse_float("-2.5")}");
        write_line("{length_of("hello")}");
        write_line("{length_of("héllo €")}");
        write_line("{length_of("😀")}");
        write_line("{upper(97)}");

        seed(1u);

        write_line("done");
    si
si
