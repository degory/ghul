use IO.Std.write_line

total(m: Collections.Map[string, int]) -> int is
    let t mut = 0

    for (k, v) in m do
        t = t + k.length * v
    od

    return t
si

members(s: Collections.Set[string]) -> int is
    let n mut = 0

    for x in s do
        n = n + x.length
    od

    return n
si

joined(xs: Collections.Iterable[string]) -> string is
    let r = Text.STRING_BUILDER()

    for x in xs do
        r.append(x)
    od

    return r.to_string()
si

run() is
    let m = Collections.MAP[string, int]()
    m["a"] = 1
    m["bb"] = 2
    m["ccc"] = 3
    m.remove("bb")
    m["dddd"] = 4

    let direct mut = 0

    for (k, v) in m do
        direct = direct + v
    od

    for pair in m do
        write_line("{pair.key}={pair.value}")
    od

    write_line("direct {direct} total {total(m)}")

    let s = Collections.SET[string]()
    s.add("x")
    s.add("yy")
    s.add("zzz")
    s.remove("x")

    let count mut = 0

    for e in s do
        count = count + 1
    od

    write_line("set {count} {members(s)}")
    write_line("joined {joined(["p", "q"])} {joined(Collections.LIST[string]([ "r" ]))}")
    write_line("empty {total(Collections.MAP[string, int]())} {members(Collections.SET[string]())}")

    let cleared = Collections.MAP[string, int]()
    cleared["a"] = 1
    cleared.clear()

    let none = Collections.SET[string]()
    let seen mut = 0

    for e in none do
        seen = seen + 1
    od

    write_line("cleared {total(cleared)} {seen}")
si

run()
