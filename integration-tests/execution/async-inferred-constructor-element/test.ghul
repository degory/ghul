namespace Test is
    use Std = IO.Std;

    class Main is
        compute(limit: int) -> Tasks.TASK[int] static is
            let seen = Collections.LIST();

            let total mut = 0;

            for i in 1..limit do
                for s in seen do
                    total = total + await Tasks.TASK.from_result(s);
                od

                seen.add(i);
            od

            return total;
        si

        entry() static is
            let r = compute(4);

            Std.write_line("total={r.result}");
        si
    si
si
