// Being store-free is a property of a function value itself, not of
// the slot it is heading for, so it holds however the value is
// written and wherever it is used: a literal whose parameter types
// are spelled out, one held in a variable that cannot be reassigned,
// and one passed as the operand of a user-defined operator all
// satisfy a pure function-typed slot, whether or not the variable
// holding one can be reassigned. A pure function type is a claim
// about what the slot holds, so it is the assignment that has to
// show the value is store-free, and the claim is trusted from then
// on the same way a `pure` declaration on a function is. Every way
// of putting a value into such a slot is checked, not only
// assignment: an initializer and a return carry the same obligation.

use Std = IO.Std;

_counter: int;

double(x: int) -> int pure => x * 2;

>>[A, B, C](f: (A) -> B pure, g: (B) -> C pure) -> (A) -> C pure => x => g(f(x));

take(f: (int) -> int pure) -> int => f(21);

entry() is
    Std.write_line("{take(n => n * 2)}");
    Std.write_line("{take((n: int) -> int => n * 2)}");

    let held = (n: int) -> int => n * 2;
    Std.write_line("{take(held)}");

    let reassignable mut = (n: int) -> int => n * 2;
    Std.write_line("{take(reassignable)}");

    reassignable = (n: int) -> int => n * 3;
    Std.write_line("{take(reassignable)}");

    reassignable = n is
        _counter = _counter + n;

        return n;
    si;

    Std.write_line("{take(reassignable)} {_counter}");

    let declared: (int) -> int pure mut = double;
    Std.write_line("{take(declared)}");

    declared = n is
        _counter = _counter + n;

        return n;
    si;

    Std.write_line("{take(declared)} {_counter}");

    let composed = double >> (n => n + 1);
    Std.write_line("{composed(10)}");

    let leaky = (n => val _counter = _counter + n; n lav) >> double;
    Std.write_line("{leaky(1)} {_counter}");

    let initialized: (int) -> int pure = n is
        _counter = _counter + n;

        return n;
    si;

    Std.write_line("{take(initialized)} {_counter}");
    Std.write_line("{take(returns_impure())}");
si

returns_impure() -> (int) -> int pure is
    return n is
        _counter = _counter + n;

        return n;
    si;
si
