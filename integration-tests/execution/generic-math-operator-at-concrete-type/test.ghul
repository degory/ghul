use IO.Std.write_line;

use System.Half;
use System.Int128;

use System.Numerics.INumber;
use System.Numerics.INumber.max;
use System.Numerics.IAdditionOperators.`+;
use System.Numerics.IMultiplyOperators.`*;

total[T: INumber[T]](a: T, b: T) -> T => a + b;

entry() is
    write_line("{Half.one + Half.one}");
    write_line("{Int128.one + Int128.one}");
    write_line("{(Int128.one + Int128.one) * (Int128.one + Int128.one)}");
    write_line("{max(Int128.one, Int128.zero)}");
    write_line("{`+(Int128.one, Int128.one)}");
    write_line("{total(Int128.one, Int128.one)}");
    write_line("{3 + 4}");
si
