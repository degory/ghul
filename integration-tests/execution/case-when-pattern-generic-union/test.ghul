namespace Test is
    use Std = IO.Std;

    union RESULT[T, E] is
        OK(value: T);
        ERROR(error: E);
    si

    class Main is
        entry() static is
            describe(RESULT.OK[double, string](2.5d));
            describe(RESULT.ERROR[double, string]("division by zero"));

            // A second instantiation, so the arms cannot pass by
            // accidentally matching a single closed form.
            label(RESULT.OK[string, int]("hello"));
            label(RESULT.ERROR[string, int](404));
        si

        describe(r: RESULT[double, string]) static is
            case r
            when ok: RESULT.OK then
                Std.out.write_line("ok {ok.value}");
            when err: RESULT.ERROR then
                Std.out.write_line("error: {err.error}");
            esac
        si

        label(r: RESULT[string, int]) static is
            case r
            when ok: RESULT.OK then
                Std.out.write_line("ok {ok.value}");
            when err: RESULT.ERROR then
                Std.out.write_line("error: {err.error}");
            esac
        si
    si
si
