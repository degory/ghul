namespace Test is
    use IO.Std.write_line;

    // Tests: `-> T.. -> U` hands the pack back out. The declared return
    // type still names the tuple-in shape; a call that binds the pack to
    // a concrete tuple presents its result as the N-ary function of that
    // tuple, evaluated once where the call stands.

    builds: int;

    once[T.., U](f: T.. -> U) -> T.. -> U is
        builds = builds + 1;
        return v => f(v);
    si

    compose_n[T.., U](f: T.. -> U, g: (U) -> string) -> T.. -> string =>
        v => g(f(v));

    add(a: int, b: int) -> int => a + b;

    cat3(a: string, b: string, c: string) -> string => "{a}{b}{c}";

    show(n: int) -> string => "[{n}]";

    double(n: int) -> int => n * 2;

    pass_through[T.., U](f: T.. -> U) -> T.. -> U is
        return once(f);
    si

    apply_n[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    class HOLDER is
        mul(a: int, b: int) -> int => a * b;

        init() is
        si
    si

    entry() is
        // The wrapper presents two arguments and evaluates once.
        let w = once(add);
        write_line("{w(1, 2)} {w(3, 4)} builds={builds}");

        // Three arguments, through the same declaration.
        let joined = compose_n(cat3, s => "<{s}>");
        write_line(joined("a", "b", "c"));

        // An n-ary first stage composed with a unary post-stage.
        write_line(compose_n(add, show)(2, 3));

        // A generic whose own return carries the marker hands the
        // shape through; its call does the presenting.
        let p = pass_through(add);
        write_line("{p(4, 5)} builds={builds}");

        // One argument is the value itself: no presentation, and the
        // function is returned as it is.
        let d = once(double);
        write_line("{d(21)}");

        // A method named on an instance fills a `T.. -> U` formal the
        // same way a global function does.
        let h = HOLDER();
        write_line("{apply_n(h.mul, 6, 7)}");
    si
si
