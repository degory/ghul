namespace Test is
    use Std = IO.Std;

    class Main is
        // An await inside a try inside a loop must resume after the
        // await with the loop state intact, not re-run the loop body
        // from its first iteration.
        for_loop() -> Tasks.TASK[int] static is
            let total mut = 0;

            for n in 1::3 do
                try
                    await Tasks.TASK.yield();
                    total = total + n;
                catch e: System.Exception
                    total = total - 100;
                yrt
            od

            return total;
        si

        // Same shape over a while loop.
        while_loop() -> Tasks.TASK[int] static is
            let total mut = 0;
            let i mut = 0;

            while i < 3 do
                i = i + 1;

                try
                    await Tasks.TASK.yield();
                    total = total + i;
                catch e: System.Exception
                    total = total - 100;
                yrt
            od

            return total;
        si

        // A throw after a resumed await still reaches the catch of
        // the same iteration.
        caught_on_resume() -> Tasks.TASK[string] static is
            let out = System.Text.StringBuilder();

            for n in 1::3 do
                try
                    await Tasks.TASK.yield();

                    if n == 2 then
                        throw System.Exception("boom");
                    fi

                    let _ = out.append(n.to_string());
                catch e: System.Exception
                    let _ = out.append("E");
                yrt
            od

            return out.to_string();
        si

        // Nested try inside try inside the loop: both suspend sites
        // resume into the right iteration.
        nested_try() -> Tasks.TASK[int] static is
            let total mut = 0;

            for n in 1::3 do
                try
                    try
                        await Tasks.TASK.yield();
                        total = total + n;
                    catch inner: System.Exception
                        total = total - 1000;
                    yrt
                catch outer: System.Exception
                    total = total - 100;
                yrt
            od

            return total;
        si

        entry() static is
            Std.write_line("for={for_loop().result}");
            Std.write_line("while={while_loop().result}");
            Std.write_line("caught={caught_on_resume().result}");
            Std.write_line("nested={nested_try().result}");
        si
    si
si
