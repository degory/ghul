use IO.Std.write_line;

// A .NET `const` is a compile-time literal: the value is in metadata and
// there is no field to load. Every width has to come back as the value
// rather than as a read of something that is not there.
entry() is
    write_line("byte    {byte.min_value} {byte.max_value}");
    write_line("ubyte   {ubyte.min_value} {ubyte.max_value}");
    write_line("short   {short.min_value} {short.max_value}");
    write_line("ushort  {ushort.min_value} {ushort.max_value}");
    write_line("int     {int.min_value} {int.max_value}");
    write_line("uint    {uint.min_value} {uint.max_value}");

    // Wider than the int32 a constant load usually takes, and the
    // unsigned maximum is out of range read as a signed number.
    write_line("long    {long.min_value} {long.max_value}");
    write_line("ulong   {ulong.min_value} {ulong.max_value}");

    // Asserted as bit patterns rather than as text. How a real number
    // renders depends on the culture the program runs under - which
    // character separates the parts, and whether an infinity comes out
    // as a word or a symbol - and none of that is what this is about.
    write_line("single  {System.BitConverter.single_to_int32_bits(single.epsilon)} {System.BitConverter.single_to_int32_bits(single.max_value)}");
    write_line("double  {System.BitConverter.double_to_int64_bits(double.epsilon)} {System.BitConverter.double_to_int64_bits(double.max_value)}");
    write_line("special {double.is_na_n(double.na_n)} {double.is_positive_infinity(double.positive_infinity)} {double.is_negative_infinity(double.negative_infinity)}");

    write_line("char    {cast int(char.max_value)}");

    // Read in an expression rather than straight into interpolation, so
    // the constant has to arrive at the right type as well as the right
    // value.
    let headroom = int.max_value - int.max_value / 2;
    write_line("arith   {headroom}");

    // A `static readonly` field is an ordinary field and keeps working.
    write_line("field   [{string.empty}] {System.Guid.empty}");
si
