use IO.Std.write_line;
use Ghul.Pipes;

tally(xs: int[]) -> int => xs.count;

double(x: int) -> int => x * 2;

class HOLDER is
    tally: int public;

    init() is
        tally = 7;
    si

    // A field is looked past the same way a local is, and the field
    // itself still reads as a field.
    run(xs: int[]) is
        write_line("field {tally}");
        write_line("call {tally(xs)}");
    si
si

// The callable looked past to can be a value holding a function, not
// only a function group.
function_valued_target() is
    let double_it: (int) -> int = x => x * 4;

    val
        let double = 0;

        write_line("value {double_it(5)}");
        write_line("group {double(3)}");
    lav;
si

entry() is
    let xs = [1, 2, 3, 4];

    let tally = tally(xs);
    write_line("uninitialized {tally}");

    let count = xs |> Pipes.filter(x => x > 1) |> count();
    write_line("pipes {count}");

    HOLDER().run(xs);

    function_valued_target();
si
