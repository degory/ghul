namespace Test is
    use IO.Std;

    call_bare(f: (int?) -> string) -> string => f(4);
    call_null(f: (int?) -> string) -> string => f(null);
    call_optional(f: (int?) -> string, v: int?) -> string => f(v);
    call_action(f: (int?) -> void, v: int?) => f(v);

    entry() is
        Std.write_line(call_optional(v => if v? then "{v}" else "absent" fi, 7));
        Std.write_line(call_bare(v => if v? then "{v}" else "absent" fi));
        Std.write_line(call_null(v => if v? then "{v}" else "absent" fi));
        call_action(w => Std.write_line("action: {if w? then w else 0 fi}"), 9);
        call_action(w => Std.write_line("action: {if w? then w else 0 fi}"), null);
        Std.write_line(call_bare(v => "{v ?? -1}"));
    si
si
