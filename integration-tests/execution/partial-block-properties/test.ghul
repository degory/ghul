namespace Test is
    use IO.Std;

    // Tests: properties declared in a `partial` or `impl` block. The
    // accessor functions and auto-property backing variables synthesized
    // for them have to be declared into the block's target type, not the
    // enclosing namespace - a getter landing there is a global function,
    // and every read of the property through a receiver fails.

    class OUTER is
        _field: int;

        init() is _field = 7; si

        twice() -> int => _in_between * 2;
    si

    partial OUTER is
        _in_between: int => _field + 1;
    si

    class BOX is
        init() is counter = Collections.LIST[int](); si

        read() -> int => counter.count + _hidden;
        _hidden: int => 3;
    si

    partial BOX is
        counter: Collections.LIST[int] public;
        bump() is counter.add(1); si
    si

    trait VALUED is
        value: int;
        doubled() -> int => value * 2;
    si

    class VAL_BOX is
        init() is si
    si

    impl VALUED for VAL_BOX is
        value: int => 41;
    si

    class Main is
        entry() static is
            Std.write_line("{OUTER().twice()}");

            let b = BOX();
            b.bump();
            b.bump();
            Std.write_line("{b.read()}");

            let v = VAL_BOX();
            Std.write_line("{v.value} {v.doubled()}");

            return;
        si
    si
si
