namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // `zip` is a Ghul.Pipes free function the fusion recognizer does not
    // cover (a two-source stage - see docs/claude/pipe-fusion.md). A `for`
    // over a thread-first chain ending in `zip` must still compile and run
    // correctly through the ordinary, unfused ZIP_PIPE lowering - proving the
    // recognizer's "stop peeling, fall back" path for an unrecognised stage
    // doesn't leave anything broken.

    class Main is
        entry() static is
            let xs = [1, 2, 3];
            let ys = [10, 20, 30];

            for pair in xs |> zip(ys) do
                Std.write_line("zip: {pair.`0},{pair.`1}");
            od
        si
    si
si
