namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;

    // Tests: a chain wrapped with `|>` or `~>` leading each line, and one
    // with the operator ending each line, including a subject gathered
    // from a binary operator and an operator after the last call.

    lookup(n: int) -> int? => if n > 0 then n * 100 else null fi;
    three() -> int? => 3;

    entry() is
        let leading =
            1::4
                |> filter(x => x % 2 == 0)
                |> map(x => x * 10)
                |> reduce(0, (a, x) => a + x);

        write_line("{leading}");                   // 60

        let trailing =
            1::4 |>
                map(x => x + 1) |>
                count();

        write_line("{trailing}");                  // 4

        let propagated =
            three()
                ~> lookup() ?? 0;

        write_line("{propagated}");                // 300

        let after =
            [1, 2, 3]
                |> count() * 2;

        write_line("{after}");                     // 6
    si
si
