use default

// A literal whose parameter is a destructure pattern, with a literal inside
// it capturing a destructured name together with a variable from an
// enclosing scope. The frame class stays non-generic: a type variable owned
// by neither a method nor a class has no index to be emitted as.
total(pairs: (string, int)[], n: int) -> int =>
    pairs |> map(((_, k)) => [n] |> map(x => x + k) |> sum()) |> sum()

write_line("{total([("a", 10)], 1)}")

// The same shape with the capture coming from a loop's local.
for step in 1::2 do
    let scaled =
        [("b", 5)] |> map(((_, k)) => [step] |> map(x => x * k) |> sum())

    write_line("{scaled |> sum()}")
od
