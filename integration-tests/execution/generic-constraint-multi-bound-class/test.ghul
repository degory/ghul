// Multiple bounds on a *type*'s type parameter: the class body reads
// members of both bounds through the parameter.

namespace Test is
    use IO.Std;

    trait NAMED is
        name: string;
    si

    trait SIZED is
        size: int;
    si

    class THING: NAMED, SIZED is
        name: string => "thing";
        size: int => 7;
        init() is si
    si

    class HOLDER[T: NAMED /\ SIZED] is
        item: T;

        init(item: T) is self.item = item; si

        describe() -> string => "{item.name}/{item.size}";
    si

    class Main is
        entry() static is
            Std.write_line(HOLDER[THING](THING()).describe());
        si
    si
si
