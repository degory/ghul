namespace Test is
    use Std = IO.Std;

    // Iterator[T] is the reflected IEnumerator[T], so `reset` here is a
    // default for a member the trait inherits rather than one of its
    // own, and the class below supplies none.
    trait Rewindable: Collections.Iterator[int] is
        reset() is
            Std.write_line("the trait's own reset ran");
        si
    si

    class COUNTER: Rewindable is
        _at: int;

        init() is _at = 0; si

        move_next() -> bool is
            _at = _at + 1;

            return _at <= 1;
        si

        current: int => _at;

        dispose() is si
    si

    class Main is
        entry() static is
            let counter = COUNTER();

            counter.reset();

            // Through the slot the default fills, which is what the
            // class was rejected at type load for leaving open.
            let legacy =
                System.Type.get_type("System.Collections.IEnumerator")!.get_method("Reset")!;

            legacy.invoke(counter, []);
        si
    si
si
