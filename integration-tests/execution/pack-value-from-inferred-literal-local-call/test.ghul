use default

// A value argument to a pack function that is a call to a local
// function literal whose parameter types are inferred: the pack's
// tuple waits for the literal's return type to settle.
pack_apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)

let a = 3
let add = (p, q) => p + q

write_line("{pack_apply((x, y) => x + y, a, add(a, 13))}")
write_line("{pack_apply((x, y) => x * y, add(a, 1), a)}")
