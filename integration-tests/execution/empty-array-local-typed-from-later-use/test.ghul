use default

// An untyped local initialized with `[]` takes its element type from how
// it is used later: passed where an array is expected, or placed beside
// other arrays in a literal passed where an array of arrays is expected.
// A local nothing types keeps the object element type.
count_all(xs: int[]) -> int => xs.count

show_nary(lists: List[List[int]]) is
    write_line(lists |> map(list => "[{list |> map(n => "{n}") |> join(", ")}]") |> join(" "))
si

show_words(groups: string[][]) is
    write_line(groups |> map(g => "{g.count}") |> join(","))
si

let empty = []
write_line("{count_all(empty)}")

let nothing = []
show_nary([[1, 2, 3], nothing, [500, 100]])

let none = []
show_words([["ABC"], none, ["ABC", "DEF"]])

untyped() is
    let local = []
    write_line("{count_all(local)} {local.get_type()}")
si

untyped()

let plain = []
write_line("{plain.count} {plain.get_type()}")
