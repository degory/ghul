namespace Test is
    use Std = IO.Std;

    class Main is
        // `T` is pinned by the first argument alone; a `_` argument
        // never itself contributes to binding a type variable, but
        // the resolved formal is concrete by the time the second
        // argument is checked, so it can still be pushed.
        pair[T](a: T, b: T) -> T static => b;

        entry() static is
            Std.out.write_line("pair(5, _): {pair(5, _)}");

            return;
        si
    si
si