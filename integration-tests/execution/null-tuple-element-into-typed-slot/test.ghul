use IO.Std.write_line

take(p: (string?, int)) -> int => p.`1

// A tuple literal with a null element converts to a tuple type that says what
// the element holds, whether that type comes from a variable, a parameter or
// the other arm of an if.
entry(args: string[]) is
    let c = args.count > 0

    let typed: (string?, int) = (null, 1)
    write_line("{typed.`0 ?? "absent"} {typed.`1}")

    write_line("{take((null, 2))}")

    let joined = if c then ("present", 3) else (null, 3) fi
    write_line("{joined.`0 ?? "absent"} {joined.`1}")

    let listed = [(null, 4), ("present", 5)]
    write_line("{listed.count}")
si
