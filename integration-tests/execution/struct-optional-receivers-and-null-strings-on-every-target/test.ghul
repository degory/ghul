use IO.Std.write_line

struct POINT(x: int, y: int) is
    sum() -> int => x + y
    describe() -> string => "({x}, {y})"
si

show(p: POINT?) is
    write_line("{p?.sum() ?? -1} {p?.describe() ?? "none"}")
si

@suppress("definite-assignment")
entry() is
    show(POINT(3, 4))
    show(null)

    let unassigned: string mut
    write_line(unassigned)
    write_line("after a null string")
si
