namespace Test is
    use Std = IO.Std;

    class BOX[T: Ghul.Comparable[T]] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        read() -> T => _value;
    si

    class Main is
        drain[T: Ghul.Comparable[T]](box: BOX[T]) -> Ghul.Pipes.Pipe[T] static is
            yield box.read();
            yield box.read();
        si

        entry() static is
            for v in drain[int](BOX[int](7)) do
                Std.write_line("v: {v}");
            od
        si
    si
si
