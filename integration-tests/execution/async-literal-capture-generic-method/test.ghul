namespace Test is
    use Std = IO.Std;

    class HOLDER is
        inferred[U](extra: U) -> Tasks.TASK static is
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("{extra}");

                await Tasks.TASK.yield();

                seen.add("{extra}");
            si;

            await body();

            Std.write_line("inferred {seen.count} {seen[1]}");
        si

        written[U](extra: U) -> Tasks.TASK static is
            let seen = Collections.LIST[string]();

            let body = () -> Tasks.TASK is
                seen.add("{extra}");

                await Tasks.TASK.yield();

                seen.add("{extra}");
            si;

            await body();

            Std.write_line("written {seen.count} {seen[1]}");
        si

        // Only the second parameter is captured, so the machine carries
        // that one and nothing else.
        one_of_two[U, V](a: U, b: V) -> Tasks.TASK static is
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("{b}");

                await Tasks.TASK.yield();

                seen.add("{b}");
            si;

            await body();

            Std.write_line("one_of_two {seen.count} {seen[1]} {a}");
        si
    si

    class Main is
        entry() static is
            HOLDER.inferred(7).wait();
            HOLDER.written(8).wait();
            HOLDER.one_of_two(9, "v").wait();
        si
    si
si
