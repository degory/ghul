use default

// Joining optionals of different subtypes keeps the optionality: an if
// whose arms are a `CAT?` and a `DOG?` is an `Animal?`, so coalescing it
// tests for absence rather than dereferencing a null.
class Animal abstract is
    init() is si
    name: string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    name: string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    name: string => "dog"
si

else_less_arms(c: bool, d: bool) is
    let v = if c then (if d then CAT() fi) else (if d then DOG() fi) fi
    let w = v ?? DOG()
    write_line("else-less arms: {w.name}")
si

optional_locals(c: bool) is
    let a: CAT? = null
    let b: DOG? = DOG()
    let v = if c then a else b fi
    write_line("optional locals: {v?.name ?? "absent"}")
si

one_optional_arm(c: bool) is
    let b: DOG? = null
    let v = if c then CAT() else b fi
    write_line("one optional arm: {v?.name ?? "absent"}")
si

array_of_optionals() is
    let a: CAT? = null
    let b: DOG? = DOG()
    let xs = [a, b]
    write_line("array: {xs |> map(x => x?.name ?? "absent") |> join(",")}")
si

else_less_arms(true, false)
else_less_arms(true, true)
else_less_arms(false, true)
optional_locals(true)
optional_locals(false)
one_optional_arm(true)
one_optional_arm(false)
array_of_optionals()
