namespace Test is
    use Ghul.Pipes;
    use Std = IO.Std;

    // `sort` constrains its element to `Ghul.Comparable[T]`. The bound
    // is written on an imported generic, which declares no type
    // parameter into a scope the compiler can look a name up in, so the
    // bound is only substituted if the parameter is identified by
    // symbol. Left unsubstituted it reads as `Comparable[T]`, which no
    // actual satisfies, and every call to `sort` is rejected.
    entry() is
        let names = ["pear", "apple", "fig"];

        for name in names |> sort() do
            Std.write_line(name);
        od

        let sizes = [3, 1, 2];

        for size in sizes |> sort() do
            Std.write_line("{size}");
        od
    si
si
