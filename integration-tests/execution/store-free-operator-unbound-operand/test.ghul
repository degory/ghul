// An operator whose operand type is not trivially derivable
// disqualifies its enclosing function, the same way a call through an
// untypable receiver does — a member operator could exist on
// whatever the operand's real type turns out to be, and there is
// nothing here to bound it against. `(x % 3)` is not trivially
// typed (the free `%` group's overloads disagree on return type), so
// the `+` over it cannot be proven store-free, and `g` fails to
// satisfy the pure function-typed parameter.

use Std = IO.Std;

g(x: int) -> int => (x % 3) + 1;

apply(f: (int) -> int pure, x: int) -> int pure => f(x);

entry() is
    Std.write_line("{apply(i => g(i), 7)}");
si
