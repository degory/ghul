// The store-free analysis runs with the types compile-expressions
// resolved, so an operator over an operand whose type is only
// settled by overload resolution — `(x % 3)`, where the free `%`
// group's overloads disagree on return type — is still bounded to
// the intrinsic it resolved to. `g` is proven store-free and both
// it and the literal calling it satisfy the pure function-typed
// parameter without a declaration.

use Std = IO.Std;

g(x: int) -> int => (x % 3) + 1;

apply(f: (int) -> int pure, x: int) -> int pure => f(x);

entry() is
    Std.write_line("{apply(i => g(i), 7)}");
si
