namespace Runner is
    use IO.Std.write_line;
    use cell_1.ANIMAL;
    use cell_1.CAT;
    use cell_2.DOG;

    // The cells beside this file are one session, built with --session:
    // the second cell subclasses a class the first declared, and a call
    // through the base type dispatches to the subclass's override.
    entry() is
        let a: ANIMAL = DOG()

        write_line(a.speak())
        write_line(CAT().speak())
    si
si
