// Types declared under an explicit, multi-segment namespace, so the
// typeof cases in test.ghul cover the emitted-name shapes a declared
// type can have: a nested namespace, a generic under one, and two
// same-named generics of different arity, which are emitted under
// arity-suffixed names where a lone generic is not.

namespace Deep.Nested.Space is
    class WIDGET is
        init() is si
    si

    class PAIR[T] is
        init() is si
    si

    class PAIR[T, U] is
        init() is si
    si
si
