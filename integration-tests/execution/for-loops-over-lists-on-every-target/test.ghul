use IO.Std.write_line

class ANIMAL is
    name: string
    init(name: string) is self.name = name si
si

class CAT: ANIMAL is
    init(name: string) is super.init(name) si
si

total(xs: Collections.List[int]) -> int is
    let t mut = 0

    for x in xs do
        t = t + x
    od

    return t
si

names(xs: Collections.Iterable[ANIMAL]) -> string is
    let r = Text.STRING_BUILDER()

    for x in xs do
        r.append(x.name)
    od

    return r.to_string()
si

pairs(xs: Collections.List[int]) -> int is
    let t mut = 0

    for x in xs do
        if x == 2 then continue fi

        for y in xs do
            if y > 3 then break fi
            t = t + x * y
        od
    od

    return t
si

run() is
    let array = [1, 2, 3, 4]
    let sum mut = 0

    for x in array do
        sum = sum + x
    od

    write_line("array {sum}")

    let list = Collections.LIST[int]()
    list.add(10)
    list.add(20)

    list.add(30)
    write_line("list {total(list)} array {total(array)} empty {total(Collections.LIST[int]())}")
    write_line("pairs {pairs(array)}")

    let animals = Collections.LIST[ANIMAL]()
    animals.add(ANIMAL("a"))
    let cats = Collections.LIST[CAT]()
    cats.add(CAT("b"))
    cats.add(CAT("c"))

    write_line("names {names(animals)} {names(cats)} {names([ANIMAL("d"), CAT("e")])}")

    let missing: Collections.List[int]? = null

    try
        total(missing!)
    catch e: Ghul.Exception
        write_line("absent list threw")
    yrt
si

run()
