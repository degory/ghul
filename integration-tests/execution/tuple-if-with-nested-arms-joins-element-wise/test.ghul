use default

// A tuple-typed if expression whose arm is itself an if expression or a
// block joins its tuples element by element, as the flat elif form and
// an array literal of the same tuples do, so the result destructures.
class Animal abstract is
    init() is si
    name: string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    name: string => "cat"
si

union Shape is
    CIRCLE(radius: int)
    DOT
si

describe(s: Shape) -> string =>
    if let circle: Shape.CIRCLE = s then "circle {circle.radius}" else "dot" fi

nested_if_arm(c: bool, d: bool) is
    let (a, s) = if c then (CAT(), Shape.CIRCLE(1)) else (if d then (CAT(), Shape.DOT) else (CAT(), Shape.CIRCLE(2)) fi) fi
    write_line("nested if: {a.name} {describe(s)}")
si

block_arm(c: bool) is
    let (a, s) = if c then (CAT(), Shape.CIRCLE(1)) else (let r = 3; (CAT(), Shape.CIRCLE(r))) fi
    write_line("block: {a.name} {describe(s)}")
si

scalar_first(c: bool, d: bool) is
    let (n, s) = if c then (1, Shape.CIRCLE(1)) else (if d then (2, Shape.DOT) else (3, Shape.CIRCLE(2)) fi) fi
    write_line("scalar first: {n} {describe(s)}")
si

nested_if_arm(true, false)
nested_if_arm(false, true)
nested_if_arm(false, false)
block_arm(true)
block_arm(false)
scalar_first(false, true)
