use IO.Std.write_line

struct POINT(x: int, y: int) is
    to_string() -> string => "({x}, {y})"
si

from_object[T](value: object?) -> T => cast T(value)
to_int[T](value: T) -> int => cast int(value)

describe(m: int?) -> string =>
    "{isa int(m)} {if let s: string = m then s else "no" fi}"

entry() is
    let boxed: object = POINT(3, 4)
    let p = cast POINT(boxed)
    write_line("struct from object: {p}")

    write_line("int from object: {from_object[int](42)}")
    write_line("int from a string: {from_object[int]("hello")}")
    write_line("int from null: {from_object[int](null)}")
    write_line("point from object: {from_object[POINT](boxed)}")
    write_line("string from object: {from_object[string]("text")}")
    write_line("string from an int: {from_object[string](7)}")

    write_line("int from a T holding an int: {to_int(9)}")
    write_line("int from a T holding a string: {to_int("nine")}")

    write_line("type tests over int?: {describe(5)} {describe(null)}")

    let first = [5] |> Ghul.Pipes.first()
    write_line("type test over a MAYBE: {isa int(first)} {isa string(first)}")
si
