// let-bound lambdas, recursion, placeholder locals with early returns
use IO.Std.write_line
use Collections
let twice = x => x * 2
let fact = n rec => if n == 0 then 1 else n * rec(n - 1) fi
collect(limit: int) -> Iterable[int] => (
    let out = LIST()
    let i mut = 0
    while i < limit do
        if i == 3 then return out fi
        out.add(twice(i))
        i = i + 1
    od
    out
)
write_line("{fact(5)} {collect(10) |> Ghul.Pipes.count()}")
