use default

// A loop that ends an arm of the last statement of a function literal
// whose return type is inferred is a statement, not a value: the
// literal settles as void.
count_orderings(n: int) -> int is
    let best mut = 0

    let search = (position: int) rec is
        if position == n then
            best = best + 1
        else
            for i in position::(n - 1) do
                rec(position + 1)
            od
        fi
    si

    search(0)

    return best
si

write_line("{count_orderings(3)}")
