namespace Test is
    use Std = IO.Std;

    use System.Runtime.CompilerServices.INotifyCompletion;

    // A class awaitable whose awaiter is a separate object, implements
    // only the non-critical interface, and yields a value. Completed
    // when constructed with one, so `await` takes the hot path; empty
    // otherwise, so the continuation is registered and run later.
    class BOX_AWAITER: INotifyCompletion is
        _box: BOX;

        init(box: BOX) is _box = box; si

        is_completed: bool => _box.value?;
        get_result() -> int => _box.value!;
        on_completed(continuation: () -> void) is _box.pending = continuation; si
    si

    class BOX is
        value: int? public;
        pending: (() -> void)? public;

        init() is si
        init(value: int) is self.value = value; si

        get_awaiter() -> BOX_AWAITER => BOX_AWAITER(self);

        fill(value: int) is
            self.value = value;
            if let continuation = pending then
                continuation();
            fi
        si
    si

    class Main is
        compute(hot: BOX, cold: BOX) -> Tasks.TASK[int] static is
            let a = await hot;
            Std.write_line("hot={a}");
            let b = await cold;
            Std.write_line("cold={b}");
            return a + b;
        si

        entry() static is
            let cold = BOX();
            let task = compute(BOX(1), cold);
            Std.write_line("suspended={!task.is_completed}");
            cold.fill(2);
            Std.write_line("got={task.result}");
        si
    si
si
