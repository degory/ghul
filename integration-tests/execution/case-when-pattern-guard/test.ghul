namespace Test is
    use Std = IO.Std;

    union Shape is
        CIRCLE(radius: int);
        SQUARE(side: int);
    si

    class Main is
        entry() static is
            describe(Shape.CIRCLE(5));
            describe(Shape.CIRCLE(2));
            describe(Shape.SQUARE(4));
        si

        describe(s: Shape) static is
            case s
            when c: Shape.CIRCLE /\ c.radius > 3 then
                Std.out.write_line("big circle {c.radius}");
            when c: Shape.CIRCLE then
                Std.out.write_line("small circle {c.radius}");
            when q: Shape.SQUARE then
                Std.out.write_line("square {q.side}");
            esac
        si
    si
si
