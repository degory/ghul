namespace Test is
    use Std = IO.Std;

    // In a body that awaits, the caller already holds this function's
    // own task, so a returned task can only complete it: the return
    // is taken as the task's awaited result. A bare value still wraps,
    // a void task completes a void body, and any awaitable whose
    // result fits the slot is accepted.
    class MAIN is
        fetch(n: int) -> Tasks.TASK[string] static =>
            Tasks.TASK.from_result("hit-{n}");

        ping() -> Tasks.TASK static is
            await Tasks.TASK.yield();
            Std.write_line("ping");
        si

        returns_task() -> Tasks.TASK[string] static is
            await fetch(0);
            return fetch(1);
        si

        returns_value() -> Tasks.TASK[string] static is
            await fetch(0);
            return "value";
        si

        returns_held_task() -> Tasks.TASK[string] static is
            let t = fetch(3);
            await Tasks.TASK.yield();
            return t;
        si

        returns_void_task() -> Tasks.TASK static is
            await Tasks.TASK.yield();
            return ping();
        si

        returns_value_task() -> Tasks.TASK[int] static is
            await Tasks.TASK.yield();
            return Tasks.ValueTask[int](5);
        si

        entry() static is
            Std.write_line(returns_task().result);
            Std.write_line(returns_value().result);
            Std.write_line(returns_held_task().result);
            returns_void_task().wait();
            Std.write_line("void done");
            Std.write_line("{returns_value_task().result}");
        si
    si
si
