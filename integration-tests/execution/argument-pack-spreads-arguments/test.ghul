namespace Test is
    use IO.Std;

    // Tests: `v: T..` says this formal absorbs the call's remaining
    // arguments into the tuple the pack binds to, so a caller writes
    // them out rather than assembling the tuple. The written-out tuple
    // still goes into the same formal, and one argument is the value
    // itself, as it is for any parameter.

    apply_n[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    concat(a: string, b: string) -> string => "{a}{b}";

    double(n: int) -> int => n * 2;

    label(a: string, b: string) -> string => "{a}/{b}";

    lookup(want: bool) -> string? => if want then "found" else null fi;

    class EVENT[T..] is
        _handlers: Collections.LIST[T -> void];

        init() is
            _handlers = Collections.LIST[T -> void]();
        si

        subscribe(handler: T.. -> void) is
            _handlers.add(handler);
        si

        raise(v: T..) is
            for h in _handlers do
                h(v);
            od
        si
    si

    class Main is
        entry() static is
            Std.write_line(apply_n(concat, "x", "y"));
            Std.write_line(apply_n((a, b) => "{a}-{b}", "p", "q"));
            Std.write_line("{apply_n((a, b, c) => a + b + c, 1, 2, 3)}");
            Std.write_line("{apply_n(double, 123)}");
            Std.write_line(apply_n(concat, ("x", "y")));

            let e = EVENT[(int, string)]();

            e.subscribe((n, s) => Std.write_line("{n} {s}"));

            e.raise(7, "seven");
            e.raise((8, "eight"));

            // A trailing actual carrying a narrowing: the spread walks
            // it a second time, and it has to read as the narrowed type
            // on that walk too.
            let maybe = lookup(true);

            if maybe? then
                Std.write_line(apply_n(label, maybe, "tail"));
            fi

            return;
        si
    si
si
