use default

// Function literals in the arms of an if expression whose parameters
// only a member access constrains take their parameter type from a use
// of the whole expression, whichever arm that use reaches.
both_untyped(c: bool) is
    let g = if c then w => w.length else w => w.length + 100 fi
    write_line("both untyped {g("abc")}")
si

one_typed(c: bool) is
    let g = if c then (w: string) => w.length else w => w.length + 100 fi
    write_line("one typed {g("abcd")}")
si

both_untyped(true)
both_untyped(false)
one_typed(true)
one_typed(false)
