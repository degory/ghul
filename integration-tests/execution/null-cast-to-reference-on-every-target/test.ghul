use IO.Std.write_line

// `null` cast to a reference type is that type's null, appended as nothing
// and interpolated as nothing, on every target.
@suppress("cast-may-throw")
absent() -> string => cast string(null)

entry() is
    let builder = Text.STRING_BUILDER()

    builder.append("a")
    builder.append(absent())
    builder.append("b")

    write_line(builder.to_string())
    write_line("[{absent()}]")
si
