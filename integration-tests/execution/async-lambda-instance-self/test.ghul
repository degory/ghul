namespace Test is
    use Std = IO.Std;

    // An async function literal's body compiles into a state machine's
    // MoveNext, where ldarg.0 is the state machine rather than the
    // instance the body means by self. Instance members reached from
    // such a body go through the state machine's captured outer self.

    trait Named is
        name() -> string;

        // The literal is constructed inside an async trait default
        // method, so its own construction site is already inside a
        // state machine.
        greet() -> Tasks.TASK[string] is
            let f = () -> Tasks.TASK[string] is
                let n = await Tasks.TASK.from_result(name());

                return "hello {n}";
            si;

            return await f();
        si
    si

    class PERSON: Named is
        init() is si

        name() -> string => "ada";
    si

    class COUNTER is
        _value: int;

        init(value: int) is _value = value; si

        get_value() -> int => _value;

        // No captures beyond self: the literal is emitted as a
        // delegate on COUNTER itself.
        bumped() -> Tasks.TASK[int] is
            let f = () -> Tasks.TASK[int] is
                let v = await Tasks.TASK.from_result(get_value());

                return v + 1;
            si;

            return await f();
        si

        // A captured local forces a captures frame, so self is reached
        // through the frame instead.
        bumped_by(extra: int) -> Tasks.TASK[int] is
            let f = () -> Tasks.TASK[int] is
                let v = await Tasks.TASK.from_result(get_value());

                return v + extra;
            si;

            return await f();
        si
    si

    class Main is
        entry() static is
            Std.write_line(PERSON().greet().result);

            let counter = COUNTER(5);

            Std.write_line("bumped {counter.bumped().result}");
            Std.write_line("bumped_by {counter.bumped_by(10).result}");
        si
    si
si
