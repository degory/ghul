use Ghul;
use IO.Std.write_line;
use Ghul.Pipes;
use Ghul.MAYBE;

// `$` on a `MAYBE[T]` that reaches the call as the return value of a
// function whose signature carries the argument-pack marker
// (`max_by[T.., K]`) must unwrap to a boxed payload on the present
// arm, not leave a bare struct where the `object?` formal expects a
// reference.

struct PAIR is
    a: int;
    b: int;

    init(a: int, b: int) is
        self.a = a;
        self.b = b;
    si

    to_string() -> string => "PAIR({a}, {b})";
si

wrapped[T](v: T) -> MAYBE[T] => MAYBE(v);

entry() is
    let xs = [3, 9, 4];

    // present and absent, value payload
    write_line("{$(xs |> max_by(v => v))}");
    write_line("{$(xs |> max_by(v => -v))}");

    // absent and present from find_map
    write_line("{$(xs |> find_map(v => if v == 9 then MAYBE(v) else MAYBE[int]() fi))}");
    write_line("{$(xs |> find_map(v => if v == 99 then MAYBE(v) else MAYBE[int]() fi))}");

    // generic call site: the payload type is a type variable
    write_line("{$(wrapped(42))}");
    write_line("{$(wrapped("ref"))}");

    // struct payload through the generic body, and the absent form
    write_line("{$(wrapped(PAIR(1, 2)))}");
    write_line("{$(wrapped(MAYBE[int]()))}");
si
