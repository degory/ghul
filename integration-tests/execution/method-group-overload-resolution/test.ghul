namespace Test is
    use IO.Std;

    describe(x: int) -> string => "int:{x}";
    describe(x: string) -> string => "string:{x}";

    class Main is
        entry() static is
            let f: (int) -> string = describe;
            Std.write_line(f(42));

            let g: (string) -> string = describe;
            Std.write_line(g("hi"));

            return;
        si
    si
si
