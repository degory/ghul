use default

// A mutable local with an initializer holds the join of its initializer
// and every value assigned to it, so a union variant or a subclass as the
// initializer does not stop a sibling being assigned later.
union Tree is
    EMPTY
    NODE(left: Tree, value: int, right: Tree)
si

class Animal abstract is
    init() is si
    describe() -> string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    describe() -> string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    describe() -> string => "dog"
si

grow(tree: Tree, value: int) -> Tree => Tree.NODE(tree, value, Tree.EMPTY)

count(tree: Tree) -> int =>
    if let (left, _, right): Tree.NODE = tree then 1 + count(left) + count(right) else 0 fi

let tree mut = Tree.EMPTY

for i in 1..4 do
    tree = grow(tree, i)
od

write_line("nodes: {count(tree)}")

let pet mut = CAT()
write_line("first: {pet.describe()}")

pet = DOG()
write_line("then: {pet.describe()}")

let reset mut = Tree.NODE(Tree.EMPTY, 1, Tree.EMPTY)
reset = Tree.EMPTY
write_line("reset: {count(reset)}")
