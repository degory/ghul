namespace Test is
    use IO.Std;

    // `=~` is emitted as a typed `Equals`, which .NET does not
    // recognise as an equality implementation. Without a bridge a
    // class compares by reference and a struct by reflected
    // memberwise comparison whenever the runtime reaches for
    // equality - as a dictionary key, or searching a collection - so
    // the operator the user wrote is bypassed. A type declaring `=~`
    // gets an `Object.Equals` that delegates to it.

    class PLAIN is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: PLAIN?) -> bool => other? /\ v == other.v;
        get_hash_code() -> int => v;
    si

    struct SPLAIN is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: SPLAIN) -> bool => v == other.v;
        get_hash_code() -> int => v;
    si

    // A struct whose operator deliberately disagrees with memberwise
    // comparison: the reflected default would answer differently, so
    // this pins that the user's operator is what runs.
    struct EVEN_ONLY is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: EVEN_ONLY) -> bool => v % 2 == other.v % 2;
        get_hash_code() -> int => v % 2;
    si

    // A hand-written `equals` is the author's own bridge and is left
    // alone.
    class OWN is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: OWN?) -> bool => other? /\ v == other.v;
        equals(other: object?) -> bool => false;
        get_hash_code() -> int => v;
    si

    // An equality operator over `object` is itself emitted under the
    // name `Equals`, so it already overrides the method the bridge
    // would add and must suppress it - adding both would declare the
    // method twice.
    class OPERATOR_OVER_OBJECT is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: object?) -> bool =>
            val
                let narrowed = cast OPERATOR_OVER_OBJECT?(other);
                if narrowed? then v == narrowed.v else false fi
            lav;

        get_hash_code() -> int => v;
    si

    // `=~` without `get_hash_code` gets no bridge. Bridging would
    // answer equality by the operator while the hash still answered
    // by identity, so two equal keys would land in different buckets;
    // left alone the type compares and hashes by identity, which is
    // at least consistent. The missing half is reported instead.
    @suppress("equality-without-hash")
    class NO_HASH is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: NO_HASH?) -> bool => other? /\ v == other.v;
    si

    // No `=~`, so no bridge: reference identity is unchanged.
    class NO_OPERATOR is
        v: int;

        init(v: int) is self.v = v; si
    si

    class Main is
        entry() static is
            Std.write_line("class equal: {object.equals(PLAIN(1), PLAIN(1))}");
            Std.write_line("class unequal: {object.equals(PLAIN(1), PLAIN(2))}");
            Std.write_line("class other type: {object.equals(PLAIN(1), "x")}");

            Std.write_line("struct equal: {object.equals(SPLAIN(1), SPLAIN(1))}");
            Std.write_line("struct unequal: {object.equals(SPLAIN(1), SPLAIN(2))}");

            // memberwise would say false, the operator says true
            Std.write_line("operator beats memberwise: {object.equals(EVEN_ONLY(2), EVEN_ONLY(4))}");

            Std.write_line("own equals kept: {object.equals(OWN(1), OWN(1))}");

            Std.write_line("operator over object: {object.equals(OPERATOR_OVER_OBJECT(1), OPERATOR_OVER_OBJECT(1))}");
            Std.write_line("operator over object unequal: {object.equals(OPERATOR_OVER_OBJECT(1), OPERATOR_OVER_OBJECT(2))}");

            // no bridge, so equality and hashing both stay by
            // identity and agree with each other
            Std.write_line("no hash, distinct: {object.equals(NO_HASH(1), NO_HASH(1))}");
            let no_hash_map = Collections.MAP[NO_HASH, string]();
            let key = NO_HASH(1);
            no_hash_map.add(key, "first");
            Std.write_line("no hash, same key found: {no_hash_map.contains_key(key)}");
            Std.write_line("no hash, equal key not found: {no_hash_map.contains_key(NO_HASH(1))}");

            let same = NO_OPERATOR(1);
            Std.write_line("no operator, same: {object.equals(same, same)}");
            Std.write_line("no operator, distinct: {object.equals(NO_OPERATOR(1), NO_OPERATOR(1))}");

            let map = Collections.MAP[PLAIN, string]();
            map.add(PLAIN(1), "first");
            Std.write_line("distinct but equal key: {map.contains_key(PLAIN(1))}");

            let struct_map = Collections.MAP[EVEN_ONLY, string]();
            struct_map.add(EVEN_ONLY(2), "first");
            Std.write_line("struct key by operator: {struct_map.contains_key(EVEN_ONLY(4))}");

            return;
        si
    si
si
