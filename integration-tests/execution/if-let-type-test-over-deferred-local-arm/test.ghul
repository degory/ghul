use default

// A local variable assigned after its declaration takes its type from
// that assignment, even when it is one arm of an if expression whose
// other arm is a narrower type: the join is Animal, and the type test
// happens at run time.
class Animal abstract is
    init() is si
    describe() -> string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    describe() -> string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    describe() -> string => "dog"
si

test(k: bool) is
    let v mut
    v = DOG()

    if let c: CAT = (if k then CAT() else v fi) then
        write_line("{c.describe()}")
    else
        write_line("not a cat: {v.describe()}")
    fi
si

test(true)
test(false)
