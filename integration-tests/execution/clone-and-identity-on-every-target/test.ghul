use IO.Std.write_line

// memberwise_clone makes a separate object holding the same fields, and a
// set over ReferenceEqualityComparer tells apart two objects with the same
// contents by their identity.
class POINT is
    x: int public
    y: int public

    init(x: int, y: int) is
        self.x = x
        self.y = y
    si

    copy() -> POINT => cast POINT?(memberwise_clone())!
si

class LABELLED_POINT: POINT is
    label: string public

    init(x: int, y: int, label: string) is
        super.init(x, y)
        self.label = label
    si
si

struct PAIR is
    a: int field
    b: int field

    init(a: int, b: int) is
        self.a = a
        self.b = b
    si

    set_a(value: int) is
        a = value
    si
si

class HOLDER is
    pair: PAIR field

    init() is
        pair = PAIR(1, 2)
    si

    set_a(value: int) is
        pair.set_a(value)
    si

    copy() -> HOLDER => cast HOLDER?(memberwise_clone())!
si

entry() is
    let original = POINT(3, 4)
    let copy = original.copy()

    write_line("{copy.x} {copy.y} {copy == original}")

    copy.x = 5

    write_line("{original.x} {copy.x}")

    let labelled = LABELLED_POINT(1, 2, "corner")
    let labelled_copy = labelled.copy()

    if let l: LABELLED_POINT = labelled_copy then
        write_line("{l.label} {l.x} {l.y}")
    fi

    let holder = HOLDER()
    let holder_copy = holder.copy()

    holder_copy.set_a(9)

    write_line("{holder.pair.a} {holder_copy.pair.a} {holder_copy.pair.b}")

    let seen = Collections.SET[object](Collections.ReferenceEqualityComparer.instance)

    seen.add(original)
    seen.add(copy)
    seen.add(original)

    write_line("{seen.count} {seen.contains(original)} {seen.contains(POINT(3, 4))}")

    let comparer = Collections.ReferenceEqualityComparer.instance

    write_line("{comparer.get_hash_code(original) == comparer.get_hash_code(original)}")
si
