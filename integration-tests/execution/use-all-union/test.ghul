namespace Other is
    union Color is
        RED;
        GREEN;
        CUSTOM(name: string);
    si
si

namespace Test is
    use IO.Std.write_line;
    use Other.Color.*;

    describe(c: Other.Color) -> string is
        if isa RED(c) then
            "red"
        elif isa GREEN(c) then
            "green"
        elif let custom: CUSTOM = c then
            custom.name
        else
            "unknown"
        fi
    si

    entry() is
        write_line(describe(RED));
        write_line(describe(GREEN));
        write_line(describe(CUSTOM("teal")));
    si
si
