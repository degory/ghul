use IO.Std.write_line

union Tree[T] is
    EMPTY
    NODE(value: T, left: Tree[T], right: Tree[T])
si

partial Tree.NODE is
    // The argument slots are typed by the enclosing scope's own type
    // variable, which is what each unit variant's type argument has
    // to be read from.
    init(value: T) pure is
        init(value, Tree.EMPTY, Tree.EMPTY);
    si
si

entry() is
    let leaf = Tree.NODE("a");

    if let (value, left, right): Tree.NODE = leaf then
        write_line("{value} {isa Tree.EMPTY(left)} {isa Tree.EMPTY(right)}");
    fi
si
