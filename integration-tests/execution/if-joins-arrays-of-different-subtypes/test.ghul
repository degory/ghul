use default

// Arrays of reference types are covariant, so arms that are arrays of
// different subtypes join to an array of their common ancestor.
class Animal abstract is
    init() is si
    describe() -> string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    describe() -> string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    describe() -> string => "dog"
si

describe_all(k: int) is
    let a = if k == 0 then [CAT()] elif k == 1 then [DOG(), DOG()] else [CAT(), DOG()] fi
    let b = if k == 0 then (if k == 0 then [CAT()] else [DOG(), DOG()] fi) else [CAT(), DOG()] fi

    write_line("{a.count} {a |> map(x => x.describe()) |> join(",")} {b.count} {b[0].describe()}")
si

describe_all(0)
describe_all(1)
describe_all(2)
