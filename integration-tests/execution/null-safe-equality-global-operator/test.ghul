namespace Test is
    use IO.Std;

    // A global `=~` gets the same null checks a member operator does,
    // so writing `=~(T, T) -> bool` for a concrete T is all it takes
    // for `T? =~ T?` to work: the body is handed two present values,
    // and the absent arms are answered around it.
    class BOX is
        v: int public;

        init(v: int) is self.v = v; si
    si

    =~(a: BOX, b: BOX) -> bool pure is
        Std.write_line("  (box body)");
        return a.v == b.v;
    si

    optional_box(a: BOX?, b: BOX?) -> bool => a =~ b;

    optional_box_unequal(a: BOX?, b: BOX?) -> bool => a !~ b;

    // A global declaring its parameters optional is answering for
    // absence itself, so it is called as written rather than wrapped -
    // its body runs for every combination, absent operands included.
    class OWN_NULLS is
        v: int public;

        init(v: int) is self.v = v; si
    si

    =~(a: OWN_NULLS?, b: OWN_NULLS?) -> bool pure is
        Std.write_line("  (own-nulls body, present: {a?} {b?})");
        return a? /\ b? /\ a.v == b.v;
    si

    optional_own_nulls(a: OWN_NULLS?, b: OWN_NULLS?) -> bool => a =~ b;

    // A tuple compares element by element only when nothing else
    // answers for it. A global operator does, and wins - this one
    // reads `x` alone, so ignoring `y` is what shows which ran.
    =~(a: (x: int, y: int), b: (x: int, y: int)) -> bool pure is
        Std.write_line("  (tuple body)");
        return a.x == b.x;
    si

    optional_tuple(a: (x: int, y: int)?, b: (x: int, y: int)?) -> bool => a =~ b;

    describe(label: string, result: bool) is
        Std.write_line("{label}: {result}");
    si

    class Main is
        entry() static is
            describe("box equal", optional_box(BOX(1), BOX(1)));
            describe("box unequal", optional_box(BOX(1), BOX(2)));

            // no body line for these three: an absent operand is
            // answered without reaching an operator that cannot take
            // one
            describe("box one absent", optional_box(BOX(1), _));
            describe("box other absent", optional_box(_, BOX(1)));
            describe("box both absent", optional_box(_, _));

            describe("box !~ both absent", optional_box_unequal(_, _));
            describe("box !~ unequal", optional_box_unequal(BOX(1), BOX(2)));

            // the optional-parameter operator decides all four itself
            describe("own-nulls equal", optional_own_nulls(OWN_NULLS(1), OWN_NULLS(1)));
            describe("own-nulls one absent", optional_own_nulls(OWN_NULLS(1), _));
            describe("own-nulls both absent", optional_own_nulls(_, _));

            // the user's operator, not the element-wise comparison: it
            // reads x alone, so a differing y is still equal
            describe("tuple y differs", optional_tuple((x = 1, y = 2), (x = 1, y = 9)));
            describe("tuple x differs", optional_tuple((x = 1, y = 2), (x = 3, y = 2)));
            describe("tuple one absent", optional_tuple((x = 1, y = 2), _));
            describe("tuple both absent", optional_tuple(_, _));

            return;
        si
    si
si
