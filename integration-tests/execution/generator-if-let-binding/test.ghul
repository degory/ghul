namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    union Tree is
        NODE(left: Tree, right: Tree);
        LEAF(value: int);
    si

    class Main is
        // `if let` presence binding — the local must be hoisted onto
        // the state-machine frame as a declared field, not loaded
        // from a CLR-local slot MoveNext never declares.
        maybe_yield(value: int?) -> Pipe[int] static is
            if let present = value then
                yield present;
            fi
        si

        // `if let` type-test destructure over a union.
        leaf_value(tree: Tree) -> Pipe[int] static is
            if let (v): Tree.LEAF = tree then
                yield v;
            fi
        si

        // `case`-when binding arms — each arm's bound names are body
        // locals with the same frame-field requirement.
        leaves(tree: Tree) -> Pipe[int] static is
            case tree
            when (value): Tree.LEAF then
                yield value;
            when (left, right): Tree.NODE then
                for v in leaves(left) do
                    yield v;
                od

                for v in leaves(right) do
                    yield v;
                od
            esac
        si

        // `while let` binding in a generator.
        drain(xs: Collections.LIST[int]) -> Pipe[int] static is
            let items mut = xs;
            while let head = first_of(items) do
                yield head;
                items.remove_at(0);
            od
        si

        // A closure capturing an `if let`-bound local reaches the
        // frame field, not a vanished CLR-local slot.
        capture(value: int?) -> Pipe[int] static is
            if let present = value then
                let f = () => present * 2;
                yield f();
            fi
        si

        first_of(xs: Collections.LIST[int]) -> int? static =>
            if xs.count > 0 then xs[0] else null fi;

        entry() static is
            Std.write_line("maybe={maybe_yield(7) |> join(" ")}");
            Std.write_line("absent={maybe_yield(null) |> join(" ")}");

            let tree = Tree.NODE(Tree.LEAF(1), Tree.NODE(Tree.LEAF(2), Tree.LEAF(3)));
            Std.write_line("leaf={leaf_value(tree) |> join(" ")}");
            Std.write_line("leaves={leaves(tree) |> join(" ")}");

            Std.write_line("drain={drain(Collections.LIST[int]([3, 4, 5])) |> join(" ")}");
            Std.write_line("capture={capture(21) |> join(" ")}");
        si
    si
si
