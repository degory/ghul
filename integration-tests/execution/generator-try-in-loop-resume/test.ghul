namespace Test is
    use Std = IO.Std;

    class Main is
        // A yield inside a try inside a loop must resume with the
        // loop state intact, not re-run the loop from its first
        // iteration. Generators share the async dispatch machinery,
        // so the same resume routing applies.
        gen() -> Ghul.Pipes.Pipe[int] static is
            for n in 1::3 do
                try
                    yield n;
                catch e: System.Exception
                    Std.write_line("caught");
                yrt
            od
        si

        gen_finally() -> Ghul.Pipes.Pipe[int] static is
            for n in 1::3 do
                try
                    yield n;
                finally
                    Std.write_line("fin {n}");
                yrt
            od
        si

        entry() static is
            for v in gen() do
                Std.write_line("v {v}");
            od

            for v in gen_finally() do
                Std.write_line("f {v}");
            od
        si
    si
si
