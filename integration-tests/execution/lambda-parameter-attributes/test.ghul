class SIMPLE: System.Attribute is
    init() is si
si

class SCALAR: System.Attribute is
    text: string public;

    init(text: string) is
        self.text = text;
    si
si

show_parameter_attributes(name: string, method: System.Reflection.MethodInfo) static is
    for p in method.get_parameters() do
        IO.Std.write_line("{name}.{p.name}:");

        for a in p.get_custom_attributes(false) do
            if isa SIMPLE(a) then
                IO.Std.write_line("  SIMPLE attribute present");
            fi

            let scalar = cast SCALAR?(a);
            if scalar? then
                IO.Std.write_line("  SCALAR text={scalar.text}");
            fi
        od
    od
si

entry() static is
    let handler: (int, string) -> string =
        (@SIMPLE() id: int, @SCALAR("from-query") name: string) -> string => "{id}:{name}";

    let doubled: (int) -> int = (@SIMPLE() n) -> int => n * 2;

    show_parameter_attributes("handler", handler.method);
    show_parameter_attributes("doubled", doubled.method);

    IO.Std.write_line(handler(1, "alice"));
    IO.Std.write_line("{doubled(21)}");

    return;
si
