namespace Test is
    use Std = IO.Std;

    // A `..`-prefixed operator has to lex the same way whatever precedes it.
    // The numeric-literal scanner pushes a `..` following a number back as a
    // single character, so a literal left operand takes a different path
    // through the tokenizer from every other left operand.
    ..^(from: int, to: int) -> string pure => "[{from} to end-{to}]";

    class Main is
        entry() static is
            let i = 1;

            Std.write_line(1..^2);
            Std.write_line(i..^2);

            // Range precedence, so the shift binds tighter.
            Std.write_line(1 << 2..^0);
        si
    si
si
