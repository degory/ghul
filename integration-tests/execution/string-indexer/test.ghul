namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let s = "hello";

            Std.write_line("first: {s[0]} last: {s[s.length - 1]}");

            let count mut = 0;

            for i in 0..s.length do
                if s[i] == 'l' then
                    count = count + 1;
                fi
            od

            Std.write_line("ells: {count}");

            // StringBuilder names its indexer `Chars` too, and its is
            // assignable
            let buffer = System.Text.StringBuilder();

            buffer.append("world");

            Std.write_line("buffer: {buffer[0]}");

            buffer[0] = 'W';

            Std.write_line("assigned: {buffer}");

            return;
        si
    si
si
