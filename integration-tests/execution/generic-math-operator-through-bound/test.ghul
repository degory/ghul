use IO.Std.write_line;

use System.Numerics.INumber;
use System.Numerics.IAdditionOperators.`+;

total[T: INumber[T]](a: T, b: T) -> T => a + b;

total_by_call[T: INumber[T]](a: T, b: T) -> T => `+(a, b);

largest[T: INumber[T]](a: T, b: T) -> T => T.max(a, b);

entry() is
    write_line("{total(3, 4)}");
    write_line("{total(1.5D, 2.25D)}");
    write_line("{total_by_call(10, 20)}");
    write_line("{largest(3, 4)}");
    write_line("{3 + 4}");
si
