namespace Test is
    use Std = IO.Std;

    use Collections.LIST;

    use Ghul.Pipes;
    use Ghul.Pipes.Pipe;

    // an instance generator, whose frame carries self, and a
    // `yield in` inside a loop, which re-drives the one frame field
    // the iterator lives in on every iteration
    class BOX(_items: int[]) is
        doubled() -> Pipe[int] is
            yield in (_items |> map(x => x * 2));
        si

        scaled() -> Pipe[int] is
            for i in 1::2 do
                yield in (_items |> map(x => x * i));
            od
        si
    si

    class Main is
        // every shape a `for` loop accepts: an array, a list, a pipe
        // stage, and a bare iterator
        mixed() -> Pipe[int] static is
            yield in [1, 2];

            let xs = LIST[int]();

            xs.add(3);
            xs.add(4);

            yield in xs;
            yield in ([5, 6] |> map(x => x * 10));
            yield in [7, 8].iterator;
            yield 9;
        si

        // the element type only has to be assignable to the
        // generator's, not equal to it
        widened() -> Pipe[object] static is
            yield in [1, 2];
            yield "three";
        si

        empty() -> Pipe[int] static is
            yield in Collections.LIST[int]();
        si

        entry() static is
            Std.write_line("mixed:   {mixed() |> join(" ")}");
            Std.write_line("widened: {widened() |> join(" ")}");
            Std.write_line("empty:   [{empty() |> join(" ")}]");

            let box = BOX([1, 2]);

            Std.write_line("doubled: {box.doubled() |> join(" ")}");
            Std.write_line("scaled:  {box.scaled() |> join(" ")}");
        si
    si
si
