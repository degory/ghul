use IO.Std.write_line
use Ghul.Pipes

// Tests: a formal that takes parameters of its own before the argument
// pack - `(A, T..) -> A`, the shape a fold takes. The running value is
// passed as it is and the rest of the parameters are the pack's
// elements, for a literal with its parameters untyped and typed, the
// written-out tuple form, a named function and a stored function value.

fold[A, T..](source: Collections.Iterable[T], seed: A, f: (A, T..) -> A) -> A is
    let running mut = seed

    for element in source do
        running = f(running, element)
    od

    return running
si

weigh(total: int, a: int, b: int) -> int => total + a * b

entry() is
    let pairs = [(1, 2), (3, 4)]

    write_line("{fold(pairs, 0, (total, a, b) => total + a * b)}")
    write_line("{fold(pairs, "", (text: string, a: int, b: int) => "{text}[{a},{b}]")}")
    write_line("{fold(pairs, 100, (total, pair) => total + pair.`0)}")
    write_line("{fold(pairs, 0, weigh)}")

    let stored = (total: int, a: int, b: int) => total - a - b

    write_line("{fold(pairs, 0, stored)}")

    let scale = 10

    write_line("{fold(pairs, 0, (total, a, b) => total + (a + b) * scale)}")
si
