use IO.Std.write_line
use Ghul.Pipes

struct POINT(x: int public, y: int public)

class NAMED is
    init() is si

    to_string() -> string => "named"
si

class DERIVED_NAMED: NAMED is
    init() is super.init() si
si

class NAMELESS(label: string)

union Shape is
    DOT(size: int)
    EMPTY
si

trait Labelled is
    label: string
si

class LABEL_HOLDER(label: string): Labelled is
    to_string() -> string => "holder {label}"
si

// Declared here, it would be the one in scope, but interpolation
// renders through the runtime's `$` whatever else is in scope.
$(value: object?) -> string => "captured"

counting(limit: int) -> Pipe[int] is
    for i in 0..limit do
        yield i
    od
si

generic_hole[T](value: T) -> string => "{value}"

optional_generic_hole[T](value: T?) -> string => "{value}"

let flag = true
let off = false
let maybe_flag: bool? = null
let present_flag: bool? = true

write_line("bool {flag} {off}, optional bool {maybe_flag} {present_flag}")
write_line("formatted bool {flag,6}")

let absent_text: string? = null
let present_text: string? = "text"
let absent_number: int? = null
let present_number: int? = 42

write_line("optional {absent_text} {present_text} {absent_number} {present_number}")

let numbers = [1, 2, 3]
let list = Collections.LIST[string](["a", "b"])
let held: object = numbers

write_line("sequence {numbers} {list} {held}")
write_line("pipe {numbers |> map(n => n * 10)} generator {counting(3)}")

write_line("tuple {(1, "one")} record {POINT(3, 4)} {NAMELESS("x")}")
write_line("union {Shape.DOT(2)} {Shape.EMPTY}")

let labelled: Labelled = LABEL_HOLDER("seven")

write_line("own {NAMED()} inherited {DERIVED_NAMED()} through a trait {labelled}")
write_line("generic {generic_hole(5)} {generic_hole(numbers)} {optional_generic_hole[int](null)} {optional_generic_hole(8)}")
write_line("number {3.5} {12:D4}")

let double = (n: int) => n * 2

write_line("function {double}")
write_line("imported {System.Random(1)}")
