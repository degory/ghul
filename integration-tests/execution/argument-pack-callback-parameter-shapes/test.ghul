namespace Test is
    use IO.Std;
    use Ghul.Pipes;
    use Collections.LIST;

    // Tests: the parameter shapes an N-ary function literal can take at
    // a `T.. -> U` formal whose T is pinned by another actual, here a
    // pipe of `INDEXED_VALUE[T]` - a destructurable struct, so the
    // literal has to destructure what the slot supplies rather than
    // name a tuple of its own. Bare names, a destructured group, an
    // annotated parameter list and a body with no refutable use all
    // reach the same call, and each parameter arrives as the matching
    // element of the pinned type.
    //
    // The nested `if` in the first three bodies matters: it forces the
    // comparison `c = column` to be walked before `column`'s own type
    // is settled from outside, which is where an annotated parameter
    // once lost to a wrapper declared at the actual's written tuple
    // instead of the slot's element type.

    class Main is
        entry() static is
            let rows = LIST([3, 1]);

            // Bare parameters with a nested if.
            rows |> index()
            |> each((row, column) =>
                Std.write_line((0::1) |> map(c => if c == column then "Q" else "." fi) |> join(" ")));

            // A destructured group over the same slot.
            rows |> index()
            |> each(((row, column)) =>
                Std.write_line((0::1) |> map(c => if c == column then "Q" else "." fi) |> join(" ")));

            // An annotated parameter list, same slot.
            rows |> index()
            |> each((row: int, column: int) =>
                Std.write_line((0::1) |> map(c => if c == column then "Q" else "." fi) |> join(" ")));

            // Annotated, compared against the row as well.
            rows |> index()
            |> each((row: int, column: int) =>
                Std.write_line((0::1) |> map(c => if c == row then "Q" else "." fi) |> join(" ")));

            // No nested if: plain interpolation, both elements.
            rows |> index()
            |> each((row, column) =>
                Std.write_line("{column}{row}"));

            return;
        si
    si
si
