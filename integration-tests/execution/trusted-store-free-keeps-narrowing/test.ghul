namespace Test is
    use IO.Std.write_line

    // A build that declares no library sources is its own core, so it may
    // write @trusted_store_free(). A call to a marked method leaves a
    // field's narrowing standing, though the body makes a call the
    // analysis cannot bound.
    class COUNTER is
        callback: () -> void public

        init(callback: () -> void) is
            self.callback = callback
        si

        @trusted_store_free()
        bump() -> int is
            callback()
            return 1
        si
    si

    class HOLDER is
        _name: string?

        init(name: string) is
            _name = name
        si

        run(counter: COUNTER) -> int is
            if _name? then
                let _ = counter.bump()
                return _name.length
            fi

            return 0
        si
    si

    entry() is
        write_line("{HOLDER("four").run(COUNTER(() is si))}")
    si
si
