namespace Test is
    use Ghul.Pipes.map;
    use Collections;
    use IO.Std.write_line;

    trait Op[T] is
        execute(left: T, right: T) -> T;
    si

    class ADD_INT: Op[int] is
        init() is si
        execute(left: int, right: int) -> int => left + right;
    si

    class CALC[T] is
        _m: MAP[string, Op[T]];

        init(source: Iterable[(name: string, op: Op[T])]) is
            _m = MAP(source |> map(on => let (name, op) = on in KeyValuePair(name, op)));
        si

        run(name: string, left: T, right: T) -> T => _m[name].execute(left, right);
    si

    entry() is
        let items: (name: string, op: Op[int])[] = [("add", ADD_INT())];
        let calc = CALC(items);
        write_line("{calc.run("add", 3, 4)}");
    si
si
