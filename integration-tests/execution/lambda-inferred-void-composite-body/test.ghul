namespace Test is
    use IO.Std.write_line;

    take_int_action(f: (int) -> void) is
        f(1);
        f(-1);
    si

    entry() is
        // `if` body, return type inferred
        let signs = (i: int) => if i > 0 then write_line("positive") else write_line("negative") fi;

        signs(1);
        signs(-1);

        // no else arm: nothing to produce a value from either way
        let announce = (i: int) => if i > 0 then write_line("announced {i}") fi;

        announce(1);
        announce(-1);

        // `case` body, return type inferred
        let name = (i: int) => case i when 1 then write_line("one") else write_line("other") esac;

        name(1);
        name(2);

        // nested composites
        let describe =
            (i: int) =>
                if i > 0 then
                    if i > 10 then write_line("big") else write_line("small") fi
                else
                    write_line("not positive")
                fi;

        describe(20);
        describe(1);
        describe(-1);

        // `val ... lav` body whose tail is a void composite
        let logged =
            (i: int) =>
                val
                    write_line("checking {i}");
                    if i > 0 then write_line("ok") else write_line("bad") fi
                lav;

        logged(1);
        logged(-1);

        // the formal pins the return type, but the literal is walked
        // before that is known
        take_int_action(i => if i > 0 then write_line("slot positive") else write_line("slot negative") fi);

        [1, 2] |
            .each(
                i =>
                    case i
                    when 1 then write_line("first")
                    else write_line("rest")
                    esac
            );
    si
si
