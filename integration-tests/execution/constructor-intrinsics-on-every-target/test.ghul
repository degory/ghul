use IO.Std.write_line
use Collections

// The constructors the core library and the runtime declare as intrinsics,
// a string from chars or a repeated char, a map from pairs and an array from
// a sequence, are ordinary methods called as constructors on every target.
entry() is
    write_line(string(['g', 'h', 'u', 'l']))
    write_line("[{string('-', 5)}]")
    let m = MAP([("a", 1), ("b", 2)])
    write_line("{m["b"]}")
    let xs = ARRAY(LIST([3, 4]))
    write_line("{xs.count} {xs[1]}")
si
