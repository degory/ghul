// Every re-observation idiom clears a fact's crossings: a re-test, an
// unwrap, a copy to a local before the call. None of them draws a
// reliance error, and none of the load-bearing ones is warned
// redundant - the redundancy warnings fire only when the fact is
// fully discharged.

use IO.Std.write_line;

class BOX is
    n: int public;

    init(n: int) is
        self.n = n;
    si

    touch() -> int => n;
si

class HOLDER is
    _b: BOX?;

    init() is
        _b = BOX(7);
    si

    mutate() is
        n_calls = n_calls + 1;
    si

    n_calls: int public;

    retest_after_call() -> int is
        if _b? then
            mutate();

            if _b? then
                return _b.touch();
            fi
        fi

        return -1;
    si

    unwrap_after_call() -> int is
        if _b? then
            mutate();
            return _b!.touch();
        fi

        return -1;
    si

    copy_before_call() -> int is
        if _b? then
            let b = _b;
            mutate();
            return b.touch();
        fi

        return -1;
    si

    store_free_callee_discharges() -> int is
        if _b? then
            let k = _b.touch();
            return _b.touch() + k;
        fi

        return -1;
    si
si

entry() is
    let h = HOLDER();

    write_line("{h.retest_after_call()}");
    write_line("{h.unwrap_after_call()}");
    write_line("{h.copy_before_call()}");
    write_line("{h.store_free_callee_discharges()}");
si
