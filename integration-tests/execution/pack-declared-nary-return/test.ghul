// A literal at a marked return-spine position may write its return as
// the N-ary function type the marker licenses, at depth one and two,
// and returning void; each is presented in the tuple-in shape the
// formal takes and runs as the inferred spelling does.
namespace Grid is
    use IO.Std.write_line;

    run_1[T.., U](make: (int) -> T.. -> U, v: T..) -> U => make(10)(v);
    run_2[T.., U](make: (int) -> (string) -> T.. -> U, v: T..) -> U => make(10)("x")(v);
    act[T..](make: (int) -> T.. -> void, v: T..) is make(3)(v); si

    cell_1() -> int => run_1((k: int) -> (int, int) -> int => (a: int, b: int) -> int => a + b * k, 1, 2);

    cell_1_explicit() -> int =>
        run_1[(int, int), int]((k: int) -> (int, int) -> int pure => (a: int, b: int) -> int => a + b * k, 1, 2);

    cell_2() -> string =>
        run_2(
            (k: int) -> (string) -> (int, int, int) -> string =>
                (s: string) -> (int, int, int) -> string =>
                    (a: int, b: int, c: int) -> string => "{s}{a + b + c + k}",
            1, 2, 3);

    cell_a() is
        act((k: int) -> (int, string) -> void => (a: int, s: string) -> void => write_line("{s}{a + k}"), 4, "n");
    si

    entry() is
        write_line("{cell_1()}");
        write_line("{cell_1_explicit()}");
        write_line("{cell_2()}");
        cell_a();
    si
si
