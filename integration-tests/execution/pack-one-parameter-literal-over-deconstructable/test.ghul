use IO.Std.write_line

// Tests: a literal of one parameter going into a formal that takes an
// argument pack takes the pack's value as it is, even where that value is
// of a type that destructures into a single element. One parameter is the
// value, never the pack spread out.

class VISITOR(nickname: string public)

visit[T..](source: Collections.Iterable[T], action: T.. -> void) is
    for element in source do
        action(element)
    od
si

entry() is
    visit(
        [VISITOR("alice"), VISITOR("bob")],
        visitor is
            write_line("{visitor.nickname} called")
        si
    )

    visit([VISITOR("carol")], visitor => write_line(visitor.nickname))
si
