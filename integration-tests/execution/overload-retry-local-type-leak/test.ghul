namespace Test is
    use IO.Std.write_line;

    // ghul#1818: overload resolution first tries the value-returning
    // >>[A,B,C] candidate, which can't bind C against the void lambda
    // and is provisionally specialized with C left unbound. That
    // provisional return type used to survive as `p`'s committed
    // declared type even after a later body-retry iteration picks the
    // correct void overload for the actual call - leaving an unbound
    // method type-parameter in a method with no type parameters of
    // its own, which crashed the emitted assembly at load.
    >>[A, B, C](f: (A) -> B pure, g: (B) -> C pure) -> (A) -> C pure => x => g(f(x));
    >>[A, B](f: (A) -> B pure, g: (B) -> void pure) -> (A) -> void pure => x => g(f(x));

    double(x: int) -> int pure => x * 2;

    class Main is
        entry() static is
            let p = double >> (n is write_line("void {n}"); si);
            p(3);

            return;
        si
    si
si
