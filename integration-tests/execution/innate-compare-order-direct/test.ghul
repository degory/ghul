namespace Test is
    use Std = IO.Std;

    class Main is
        order_sign(v: int) -> string static =>
            if v < 0 then "neg" elif v > 0 then "pos" else "zero" fi;

        count: int static;

        bump() -> int static is
            count = count + 1;
            return 100;
        si

        entry() static is
            Std.out.write_line("expect neg: 100 <> 200: {order_sign(100 <> 200)}");
            Std.out.write_line("expect pos: 200 <> 100: {order_sign(200 <> 100)}");
            Std.out.write_line("expect zero: 100 <> 100: {order_sign(100 <> 100)}");

            // The signed extremes, where a difference would wrap to the
            // wrong sign: the max is greater than -1 and the min is
            // lesser than 1.
            Std.out.write_line("expect pos: max <> -1: {order_sign(2147483647 <> -1)}");
            Std.out.write_line("expect neg: min <> 1: {order_sign(-2147483647 - 1 <> 1)}");
            Std.out.write_line("expect pos: long max <> -1L: {order_sign(9223372036854775807L <> -1L)}");

            // The unsigned wrap corner: 1 is less than the unsigned max
            // even though their difference wraps positive.
            Std.out.write_line("expect neg: 1u <> uint max: {order_sign(1u <> 4294967295u)}");
            Std.out.write_line("expect pos: uint max <> 1u: {order_sign(4294967295u <> 1u)}");

            Std.out.write_line("expect neg: 1.5D <> 2.5D: {order_sign(1.5D <> 2.5D)}");
            Std.out.write_line("expect pos: 2.5D <> 1.5D: {order_sign(2.5D <> 1.5D)}");
            Std.out.write_line("expect neg: 'a' <> 'b': {order_sign('a' <> 'b')}");

            // A member call to the operator takes the same path as the
            // operator spelling.
            let a = 100;
            let b = 200;

            Std.out.write_line("expect neg: 100.`<>(200): {order_sign(a.`<>(b))}");

            // The operands evaluate once each, so a direct `<>` is safe
            // on expressions with side effects.
            Std.out.write_line("expect neg, 1 call: {order_sign(bump() <> 200)} {count}");
        si
    si
si
