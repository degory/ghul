expect neg: 100 <> 200: neg
expect pos: 200 <> 100: pos
expect zero: 100 <> 100: zero
expect pos: max <> -1: pos
expect neg: min <> 1: neg
expect pos: long max <> -1L: pos
expect neg: 1u <> uint max: neg
expect pos: uint max <> 1u: pos
expect neg: 1.5D <> 2.5D: neg
expect pos: 2.5D <> 1.5D: pos
expect neg: 'a' <> 'b': neg
expect neg: 100.`<>(200): neg
expect neg, 1 call: neg 1
