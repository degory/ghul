namespace Grid is
    use IO.Std.write_line;

    weigh(a: int, b: int) -> int => a + b * 10;

    class COMBINATORS is
        init() is si

        apply_n[T.., U](f: T.. -> U, v: T..) -> U => f(v);
    si

    cell() -> int is
        let combinators = COMBINATORS();
        return weigh |> combinators.apply_n(1, 2);
    si

    entry() is
        try
            let result = cell();

            if result == 21 then
                write_line("ok {result}");
            else
                write_line("wrong result, expected 21");
            fi
        catch e: System.Exception
            write_line("exception {e.get_type()}");
        yrt
    si
si
