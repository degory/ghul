namespace Grid is
    use IO.Std.write_line;

    weigh(a: int) -> int => a;

    class COMBINATORS is
        init() is si

        once[T.., U](f: T.. -> U) -> T.. -> U => v => f(v);

        run() -> int is
            let g: (int) -> int = weigh |> self.once();
            return g(1);
        si
