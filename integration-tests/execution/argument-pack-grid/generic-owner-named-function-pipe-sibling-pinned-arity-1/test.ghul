namespace Grid is
    use IO.Std.write_line;

    weigh(a: int) -> int => a;

    class COMBINATORS[T.., U] is
        init() is si

        apply_n(f: T.. -> U, v: T..) -> U => f(v);
    si

    cell() -> int is
        let combinators = COMBINATORS[int, int]();
        return weigh |> combinators.apply_n(1);
    si

    entry() is
        try
            let result = cell();

            if result == 1 then
                write_line("ok {result}");
            else
                write_line("wrong result, expected 1");
            fi
        catch e: System.Exception
            write_line("exception {e.get_type()}");
        yrt
    si
si
