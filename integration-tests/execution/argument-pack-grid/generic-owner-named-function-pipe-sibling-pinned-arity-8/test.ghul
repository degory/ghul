    weigh(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int => a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;

    class COMBINATORS[T.., U] is
        init() is si

        apply_n(f: T.. -> U, v: T..) -> U => f(v);
