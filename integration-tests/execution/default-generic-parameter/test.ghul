namespace Test is
    use Std = IO.Std;

    class REF is
        init() is si
    si

    struct VAL is
        n: int;
    si

    // The default value of an unconstrained class type parameter.
    class HOLDER[T] is
        make() -> T static => _;
        make_explicit() -> T static => _[T];
    si

    // The default value under a `class` constraint — null.
    first_of[T: class]() -> T static => _;

    // The default value under a `struct` constraint — zeroed.
    count_of[T: struct]() -> T static => _;

    class Main is
        entry() static is
            let r = HOLDER[REF].make();
            Std.out.write_line("HOLDER[REF].make() is null: {!r?}");

            let v = HOLDER[VAL].make_explicit();
            Std.out.write_line("HOLDER[VAL].make_explicit().n: {v.n}");

            let cr = first_of[REF]();
            Std.out.write_line("first_of[REF]() is null: {!cr?}");

            let cv = count_of[int]();
            Std.out.write_line("count_of[int](): {cv}");
        si
    si
si
