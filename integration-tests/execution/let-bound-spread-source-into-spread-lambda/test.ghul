use default

// A pipe built through a function whose callback takes its state as an
// argument pack, bound to a local, and consumed by a callback that
// takes its element spread out: the second callback is adapted once the
// element type the first one decides is known.
union Step[T, S] is
    YIELD(value: T, next: S)
    STOP
si

unfold[T, S..](initial: S, advance: S.. -> Step[T, S]) -> Pipe[T] is
    let state mut = initial

    do
        if let (value, next): Step.YIELD = advance(state) then
            yield value
            state = next
        else
            return
        fi
    od
si

use Step.YIELD

let fibonacci = unfold((0, 1), (previous, current) => YIELD(previous, (current, previous + current)))

fibonacci
    |> take(5)
    |> index()
    |> each((position, value) => write_line("{position}: {value}"))
