namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            // A literal leaf, over a plain (non-optional) tuple.
            literal_leaf((1, "one"));
            literal_leaf((2, "two"));

            // A per-element type ascription, over a plain
            // reference-typed tuple.
            let a: (ANIMAL, ANIMAL) = (CAT("Felix"), DOG("Rex"));
            let b: (ANIMAL, ANIMAL) = (DOG("Rex"), DOG("Rex"));
            ascription_leaf(a);
            ascription_leaf(b);

            // while let over a plain, non-optional scrutinee
            countdown();
        si

        literal_leaf(pair: (int, string)) static is
            if let (1, y) = pair then
                Std.out.write_line("literal: {y}");
            else
                Std.out.write_line("literal: no match");
            fi
        si

        ascription_leaf(pair: (ANIMAL, ANIMAL)) static is
            if let (c: CAT, d: DOG) = pair then
                Std.out.write_line("ascription: {c.name} {d.name}");
            else
                Std.out.write_line("ascription: no match");
            fi
        si

        countdown() static is
            let i mut = 0;
            let source = [(1, 10), (1, 20), (2, 30)];

            while let (1, v) = if i < source.count then source[i] else (2, 0) fi do
                Std.out.write_line("countdown: {v}");
                i = i + 1;
            od

            Std.out.write_line("countdown done at i={i}");
        si
    si

    class ANIMAL is
        name: string;
        init(name: string) is self.name = name; si
    si

    class CAT: ANIMAL is
        init(name: string) is super.init(name); si
    si

    class DOG: ANIMAL is
        init(name: string) is super.init(name); si
    si
si
