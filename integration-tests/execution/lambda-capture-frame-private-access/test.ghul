namespace Test is
    use Std = IO.Std;
    use Collections.Iterable;

    class HOLDER is
        _n: int;

        init(n: int) is
            _n = n;
        si

        _double() -> int => _n * 2;

        // Both lambdas capture a local as well as self, so each keeps its
        // capture frame rather than being compiled as a delegate bound to
        // the receiver.
        count_matching(xs: Iterable[int], k: int) -> int =>
            xs | .filter(x => x + k == _n) | .count();

        sum_doubled(xs: Iterable[int], k: int) -> int =>
            xs | .map(x => x + k + _double()) | .reduce(0, (acc, x) => acc + x);
    si

    class Main is
        entry() static is
            let h = HOLDER(21);

            Std.write_line("{h.count_matching([19, 20, 21], 1)}");
            Std.write_line("{h.sum_doubled([1, 2], 3)}");
        si
    si
si
