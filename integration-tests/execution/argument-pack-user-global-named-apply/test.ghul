namespace Test is
    use IO.Std;

    // The #2514 shape: a user global named `apply` beside the runtime's
    // `Ghul.apply`. The runtime's globals in `Ghul` are not imported
    // implicitly, so the bare name here resolves to this declaration
    // alone and the spread call fits it. A blanket import of `Ghul` -
    // or `apply` added to the compiler's built-in list - puts the two
    // in one overload group, and the argument-pack machinery bails on
    // the multi-candidate group with "no static overload found".
    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    add(a: int, b: int) -> int => a + b;

    entry() is
        write_line("{apply(add, 1, 2)}");
        write_line("{apply((a, b) => a * b, 3, 4)}");
    si
si
