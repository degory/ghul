namespace Test is
    use IO.Std;

    // A user global named `apply` beside the runtime's `Ghul.apply`.
    // The runtime's globals in `Ghul` are not imported implicitly, so
    // the bare name resolves to this declaration alone and the spread
    // call fits it. With both in one overload group the argument-pack
    // machinery would decline the multi-candidate group instead.
    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    add(a: int, b: int) -> int => a + b;

    entry() is
        write_line("{apply(add, 1, 2)}");
        write_line("{apply((a, b) => a * b, 3, 4)}");
    si
si
