// A field narrowed by a presence guard survives a call to a helper
// containing a type application, an index whose subscript also reads
// as a type argument, or a `ref` argument. None of the three stores
// anything, so none of them costs a caller its narrowings.
//
// A `ref` also has a shape that still drops the narrow, and both are
// exercised: the boundary is what the address lets the callee write,
// not whether a `ref` appears at all.

use IO.Std;

union OPT[T] is
    SOME(value: T);
    NONE;
si

class BOX is
    v: int public;
    init() is si
    touch() -> int => v;
si

class SINK is
    _n: int;

    init() is _n = 0; si

    // a getter that stores
    counter: int is
        _n = _n + 1;
        return _n;
    si
si

class HOLDER is
    _b: BOX?;
    _spilled: int;

    init() is
        _b = BOX();
        _spilled = 0;
    si

    // a unit variant with explicit type arguments is a read
    _type_application() -> OPT[int] => OPT.NONE[int];

    // `xs[n]` reads as an index or as a type application until the
    // subscript fails to resolve as a type
    _ambiguous_index(xs: int[], n: int) -> int => xs[n];

    // the same shape, with a subscript that reaches a storing getter:
    // the subscript is classified in its own right, so the store is
    // still seen
    _storing_subscript(xs: int[], s: SINK) -> int => xs[s.counter];

    // the address of a local is callee-private, exactly as assigning
    // one is
    _writes_a_local(m: Collections.MAP[string, int]) -> int is
        let found: int mut = 0;

        if m.try_get_value("a", found ref) then
            return found;
        fi

        return 0;
    si

    // the address of a field is not: try_get_value is trusted
    // store-free and writes through it
    _writes_a_field(m: Collections.MAP[string, int]) -> int is
        if m.try_get_value("a", _spilled ref) then
            return _spilled;
        fi

        return 0;
    si

    after_type_application() -> int is
        if _b? then
            let r = _type_application();
            return _b.touch() + (if r? then 1 else 0 fi);
        fi
        return -1;
    si

    after_ambiguous_index(xs: int[], n: int) -> int is
        if _b? then
            let r = _ambiguous_index(xs, n);
            return _b.touch() + r;
        fi
        return -1;
    si

    // narrow drops: the subscript's getter stores
    after_storing_subscript(xs: int[], s: SINK) -> int is
        if _b? then
            let r = _storing_subscript(xs, s);
            return _b!.touch() + r;
        fi
        return -1;
    si

    after_local_reference(m: Collections.MAP[string, int]) -> int is
        if _b? then
            let r = _writes_a_local(m);
            return _b.touch() + r;
        fi
        return -1;
    si

    // narrow drops: the helper hands out the address of a field
    after_field_reference(m: Collections.MAP[string, int]) -> int is
        if _b? then
            let r = _writes_a_field(m);
            return _b!.touch() + r;
        fi
        return -1;
    si
si

class Main is
    entry() static is
        let h = HOLDER();
        let m = Collections.MAP[string, int]();
        m.add("a", 7);

        let xs = [10, 20, 30];

        Std.write_line("{h.after_type_application()}");
        Std.write_line("{h.after_ambiguous_index(xs, 1)}");
        Std.write_line("{h.after_storing_subscript(xs, SINK())}");
        Std.write_line("{h.after_local_reference(m)}");
        Std.write_line("{h.after_field_reference(m)}");
    si
si
