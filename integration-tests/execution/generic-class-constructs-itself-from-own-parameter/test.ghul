namespace Test is
    use IO.Std.write_line

    class NODE[T](value: T) is
        // The construction's type comes from its argument, whose type is
        // this class's own type parameter.
        push(value: T) is
            let head = NODE(value)

            write_line("push {head.value}")
        si

        push_and_return(value: T) -> NODE[T] is
            let head = NODE(value)

            return head
        si

        // The same with a declared type, a return slot, other arguments,
        // and the class itself as the argument.
        declared(value: T) -> NODE[T] is
            let head: NODE[T] = NODE(value)

            return head
        si

        pushed(value: T) -> NODE[T] => NODE(value)

        paired(value: T) -> NODE[(T, int)] => NODE((value, 1))

        one() -> NODE[int] => NODE(1)

        wrap() -> NODE[NODE[T]] => NODE(self)
    si

    class OTHER[U](value: U) is
        make(v: U) -> NODE[U] is
            let head = NODE(v)

            return head
        si
    si

    // A parameter sharing the name T but belonging to another class.
    class SAME_NAME[T](value: T) is
        make(v: T) -> NODE[T] is
            let head = NODE(v)

            return head
        si
    si

    make[T](v: T) -> NODE[T] is
        let head = NODE(v)

        return head
    si

    class PAIR[A, B](first: A, second: B)

    class BOX[T](value: T) is
        wrap[U](u: U) -> PAIR[T, U] => PAIR(value, u)
    si

    entry() is
        let node = NODE("root")

        node.push("pushed")

        write_line("push_and_return {node.push_and_return("returned").value}")
        write_line("declared {node.declared("declared").value}")
        write_line("pushed {node.pushed("arrow").value}")
        write_line("paired {node.paired("tuple").value}")
        write_line("one {node.one().value}")
        write_line("wrap {node.wrap().value.value}")
        write_line("other {OTHER(1.5).make(2.5).value}")
        write_line("same name {SAME_NAME(true).make(false).value}")
        write_line("function {make('c').value}")

        let pair = BOX(7).wrap("seven")

        write_line("box {pair.first} {pair.second}")
    si
si
