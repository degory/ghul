use IO.Std.write_line

sum(xs: Collections.List[int]) -> int is
    let t mut = 0
    let i mut = 0

    while i < xs.count do
        t = t + xs[i]
        i = i + 1
    od

    return t
si

last(xs: Collections.List[string]) -> string => xs[xs.count - 1]

describe(xs: Collections.List[string], i: int) -> string is
    try
        return xs[i]
    catch e: Ghul.ArgumentOutOfRangeException
        return "argument out of range"
    catch e: Ghul.IndexOutOfRangeException
        return "index out of range"
    yrt
si

run() is
    let list = Collections.LIST[int]()
    list.add(3)
    list.add(4)

    write_line("sum {sum(list)} {sum([5, 6, 7])} {sum(Collections.LIST[int]())}")

    let words = Collections.LIST[string]()
    words.add("a")
    words.add("b")

    write_line("last {last(words)} {last(["x", "y", "z"])}")
    write_line("{describe(words, 5)}; {describe(words, -1)}")

    let missing: Collections.List[string]? = null

    try
        write_line(last(missing!))
    catch e: Ghul.Exception
        write_line("absent list threw")
    yrt
si

run()
