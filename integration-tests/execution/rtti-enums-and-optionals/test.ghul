use IO.Std.write_line

enum Colour is
    RED = 1,
    GREEN = 2,
    BLUE = 4
si

struct HOLDER is
    count: int?
    colour: Colour

    init() is si
si

entry() is
    let colour = typeof Colour

    write_line("{colour.name}: enum {colour.is_enum}, value type {colour.is_value_type}")
    write_line(System.Enum.get_names(colour) |> Ghul.Pipes.join(", "))

    for name in System.Enum.get_names(colour) do
        let member = System.Enum.parse(colour, name)

        write_line("  {member} is {System.Enum.get_name(colour, member)}")
    od

    write_line("{System.Enum.to_object(colour, 2L)}")

    let optional = typeof int?

    write_line("{System.Nullable.get_underlying_type(optional)!.name} {System.Nullable.get_underlying_type(typeof int)}")

    let holder = typeof HOLDER

    write_line("{holder.name}: value type {holder.is_value_type}")

    for f in holder.get_fields(System.Reflection.BindingFlags.PUBLIC | System.Reflection.BindingFlags.NON_PUBLIC | System.Reflection.BindingFlags.INSTANCE) do
        let underlying = System.Nullable.get_underlying_type(f.field_type)

        write_line("  {f.name}: optional of {underlying?.name}, enum {f.field_type.is_enum}")
    od

    let instance = System.Activator.create_instance(holder)!

    holder.get_property("count")!.set_value(instance, 5)
    holder.get_property("colour")!.set_value(instance, System.Enum.parse(colour, "BLUE"))

    write_line("{holder.get_property("count")!.get_value(instance)} {holder.get_property("colour")!.get_value(instance)}")
si
