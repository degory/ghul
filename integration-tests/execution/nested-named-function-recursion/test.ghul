use IO.Std.write_line;

entry() is
    fact(n: int) -> int => if n <= 1 then 1 else n * fact(n - 1) fi;

    write_line("{fact(5)}");

    // The function reached from a lambda written inside its own body,
    // which threads the recurse field down through the inner frame.
    countdown(n: int) -> int is
        if n <= 0 then
            return 0;
        fi

        let step = () => countdown(n - 1);

        step() + n
    si

    write_line("{countdown(4)}");
si
