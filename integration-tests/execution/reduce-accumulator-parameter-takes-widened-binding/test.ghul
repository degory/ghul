use Ghul.Pipes

union Resolved is
    FOUND(value: string);
    MISSING;
si

kind(r: Resolved.FOUND) -> string => "found"
kind(r: Resolved) -> string => "resolved"

// The seed binds the accumulator type to Resolved.FOUND before the literal's
// return widens it to Resolved, so running has to take Resolved.
entry() is
    let result = ["a"] |> reduce(Resolved.FOUND("start"), (running, token) =>
        if token =~ "a" then
            Resolved.FOUND(kind(running))
        else
            Resolved.MISSING
        fi
    )

    if let found: Resolved.FOUND = result then
        IO.Std.write_line(found.value)
    fi
si
