namespace Test is
    use IO.Std;

    // A global operator whose name contains a backslash is emitted as an
    // ordinary `.method`, where the backslash is ilasm's escape character
    // and has to be doubled or the identifier runs on past its own closing
    // quote.

    class BITS is
        value: int public;

        init(value: int) is
            self.value = value;
        si
    si

    \(a: BITS) -> BITS => BITS(\a.value);

    class Main is
        entry() static is
            Std.write_line("{(\BITS(5)).value}");
        si
    si
si
