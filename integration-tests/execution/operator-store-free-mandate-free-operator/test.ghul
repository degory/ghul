// The store-free mandate only reaches a member =~/<> - one owned by
// a class, struct, trait or union. A free (namespace-scope) operator
// of the same name is left to the ordinary store-free walk, exactly
// like any other global function, and can store without triggering
// the mandate's error.

use IO.Std.write_line;

class TAG is
    v: int public;
    init(v: int) is self.v = v; si
si

_calls: int static;

=~(a: TAG, b: TAG) -> bool is
    _calls = _calls + 1;
    return a.v == b.v;
si

entry() is
    write_line("{TAG(1) =~ TAG(1)} {TAG(1) =~ TAG(2)} calls={_calls}");
si
