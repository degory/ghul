use default

use REACHED = (cost: int, previous: string)

// The first store says what the map holds, and a value read back out of
// it, here through a lambda, has that type from the start.
nearest_first(nodes: string[], source: string) -> MAP[string, REACHED] is
    let best = MAP()

    best[source] = (cost = 0, previous = "")

    while let nearest = nodes |> filter(node => best.contains_key(node)) |> min_by(node => best[node].cost) do
        best[nearest] = (cost = best[nearest].cost, previous = nearest)
        return best
    od

    best
si

// The first enqueue says what the queue holds, and values destructured
// back out of it have those types from the start.
countdown(start: int) -> long is
    let pending = Queue()

    pending.enqueue((cast long(start), start))

    let total mut = 0L

    while pending.count > 0 do
        let (value, remaining) = pending.dequeue()

        total = total + value

        if remaining > 0 then
            pending.enqueue((value - 1L, remaining - 1))
        fi
    od

    total
si

class Animal abstract is
    init() is si
    name: string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    name: string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    name: string => "dog"
si

// The first add does not settle what the list holds: the second widens
// it, and each add is checked against the join of both.
pets() -> LIST[Animal] is
    let result = LIST()

    result.add(CAT())
    result.add(DOG())

    result
si

write_line(nearest_first(["a", "b"], "a")["a"].previous)
write_line(countdown(3))
write_line(pets() |> map(pet => pet.name) |> join(", "))
