use default

use REACHED = (cost: int, previous: string)

// The key stored on the second line comes from a lambda that reads the
// map, so the map's value type is not known while that line is first
// walked. The first store already says what the map holds.
nearest_first(nodes: string[], source: string) -> MAP[string, REACHED] is
    let best = MAP()

    best[source] = (cost = 0, previous = "")

    while let nearest = nodes |> filter(node => best.contains_key(node)) |> min_by(node => best[node].cost) do
        best[nearest] = (cost = best[nearest].cost, previous = nearest)
        return best
    od

    best
si

// The values enqueued inside the loop are destructured from the queue
// itself, so its element type is not known while they are first walked.
countdown(start: int) -> long is
    let pending = Queue()

    pending.enqueue((cast long(start), start))

    let total mut = 0L

    while pending.count > 0 do
        let (value, remaining) = pending.dequeue()

        total = total + value

        if remaining > 0 then
            pending.enqueue((value - 1L, remaining - 1))
        fi
    od

    total
si

write_line(nearest_first(["a", "b"], "a")["a"].previous)
write_line(countdown(3))
