use default

use REACHED = (cost: int, previous: string)

// The first store says what the map holds. The later store reads its
// key through a lambda over the map, which is not typed until a walk
// has settled the map, so on the first walk that store offers a value
// with an untyped element, which must not count as evidence.
nearest_first(nodes: string[], source: string) -> MAP[string, REACHED] is
    let best = MAP()

    best[source] = (cost = 0, previous = "")

    while let nearest = nodes |> filter(node => best.contains_key(node)) |> min_by(node => best[node].cost) do
        best[nearest] = (cost = best[nearest].cost, previous = nearest)
        return best
    od

    best
si

// The first enqueue says what the queue holds. The values enqueued in
// the loop are destructured from it, and are not typed until a walk has
// settled the queue, so on the first walk that enqueue offers untyped
// elements, which must not count as evidence.
countdown(start: int) -> long is
    let pending = Queue()

    pending.enqueue((cast long(start), start))

    let total mut = 0L

    while pending.count > 0 do
        let (value, remaining) = pending.dequeue()

        total = total + value

        if remaining > 0 then
            pending.enqueue((value - 1L, remaining - 1))
        fi
    od

    total
si

write_line(nearest_first(["a", "b"], "a")["a"].previous)
write_line(countdown(3))
