namespace Test is
    use Std = IO.Std;

    // An array literal whose tuple elements supply a value in one
    // position and `null` in the same position of another element
    // should widen that position to its optional carrier, exactly as
    // a written-out element type does - not settle it at `null`
    // itself, which no back end can encode as a field or local's
    // static type.
    class Main is
        entry() static is
            let rows = [(key = "a", score = 1.0D), (key = "b", score = null)];

            Std.write_line("{rows[0].key} {rows[0].score}");
            Std.write_line("{rows[1].key} {rows[1].score}");

            return;
        si
    si
si
