namespace Test is
    use Std = IO.Std;
    use Collections;

    class Main is
        show[T](label: string, v: List[T]) static is
            let sb = System.Text.StringBuilder();

            for x in v do
                sb.append("{x} ");
            od

            Std.write_line("{label}: {sb}");
        si

        entry() static is
            let xs = [10, 20, 30, 40, 50];

            show("drop both ", xs[1..<1]);
            show("to the end", xs[1..<0]);
            show("whole     ", xs[0..<0]);
            show("last two  ", xs[2..<<0]);
            show("inclusive ", xs[1::<1]);
            show("from start", xs[1..3]);
            show("incl start", xs[1::3]);

            let ss = ["a", "b", "c", "d"];

            show("strings   ", ss[1..<1]);

            Std.write_line("plain: {xs[2]}");
        si
    si
si
