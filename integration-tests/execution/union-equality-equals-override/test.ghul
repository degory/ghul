use IO.Std.write_line;

// Writes `equals` out rather than declaring `=~`: the synthesized
// comparison has to reach it, as it would for an imported class
// overriding `Equals` without implementing `IEquatable`.
class KEY is
    name: string;

    init(name: string) is
        self.name = name;
    si

    equals(other: object?) -> bool =>
        isa KEY(other) /\ name =~ cast KEY(other).name;

    get_hash_code() -> int => name.get_hash_code();
si

class PLAIN is
    init() is si
si

union Holder is
    URI(uri: System.Uri);
    KEYED(key: KEY);
    BARE(plain: PLAIN);
si

entry() is
    let u1: Holder = Holder.URI(System.Uri("https://ghul.dev/a"));
    let u2: Holder = Holder.URI(System.Uri("https://ghul.dev/a"));
    let u3: Holder = Holder.URI(System.Uri("https://ghul.dev/b"));

    write_line("imported Equals override, equal: {u1 =~ u2}");
    write_line("imported Equals override, differ: {u1 =~ u3}");

    let k1: Holder = Holder.KEYED(KEY("k"));
    let k2: Holder = Holder.KEYED(KEY("{"k"}"));
    let k3: Holder = Holder.KEYED(KEY("j"));

    write_line("written equals, equal: {k1 =~ k2}");
    write_line("written equals, differ: {k1 =~ k3}");

    let shared = PLAIN();
    let p1: Holder = Holder.BARE(shared);
    let p2: Holder = Holder.BARE(shared);
    let p3: Holder = Holder.BARE(PLAIN());

    write_line("neither, same object: {p1 =~ p2}");
    write_line("neither, distinct: {p1 =~ p3}");
si
