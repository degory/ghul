use default

// A body later in the file whose inference does not converge - a rec
// literal destructuring a union variant - reports only what its own walk
// left unresolved, not the type arguments of pack calls in bodies that
// settled before it.
pack_apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)

let sum = pack_apply((a, b) => a + b, 1, 2)
write_line("{sum}")

union List[T] is
    NIL
    CONS(head: T, tail: List[T])
si

use List.NIL
use List.CONS

stringify(l: List[int]) -> string =>
    let f = l rec => if let (head, tail): CONS = l then "{head}, {rec(tail)}" else "nil" fi in f(l)

write_line(stringify(List.CONS(1, List.CONS(2, List.NIL[int]))))
