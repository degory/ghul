namespace Test is
    use Std = IO.Std;

    // `null` goes into the slot that accepts absence. Only one
    // overload can hold it: `null` is a value of optional types
    // alone, so the `string` candidate does not apply and never
    // reaches overload resolution's tie-breaks.
    describe(s: string) -> string => "non-optional";
    describe(o: object?) -> string => "optional";

    // The same choice made through a variable, which reaches the
    // same candidate by the same rule.
    describe_through_variable() -> string is
        let absent: string? = null;

        return describe(absent);
    si

    class Main is
        entry() static is
            Std.write_line(describe(null));
            Std.write_line(describe_through_variable());

            return;
        si
    si
si
