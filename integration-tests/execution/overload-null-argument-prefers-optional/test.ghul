namespace Test is
    use Std = IO.Std;

    // `null` goes into the slot that accepts absence. Both overloads
    // take it - a non-optional reference tolerates one - so the two
    // score alike and the choice falls to the tie-breaks, which prefer
    // the more specific parameter. Left to those, the call selects the
    // `string` overload and the parameter arrives absent despite being
    // declared present.
    describe(s: string) -> string => "non-optional";
    describe(o: object?) -> string => "optional";

    // The same choice made through a variable, which never had the
    // problem: an absent `string?` is not assignable to `string`, so
    // only one candidate ever applied.
    describe_through_variable() -> string is
        let absent: string? = null;

        return describe(absent);
    si

    class Main is
        entry() static is
            Std.write_line(describe(null));
            Std.write_line(describe_through_variable());

            return;
        si
    si
si
