namespace Test is
    use write_line = IO.Std.write_line;

    use System.Reflection.CustomAttributeData;
    use System.Reflection.CustomAttributeTypedArgument;

    class HOLDER is
        init() is si

        labelled(a: int) -> (index: int, int) => (a, 42);
    si

    class Main is
        // An element with no name of its own takes a positional one, so
        // the emitted name array is fully populated. A C# producer would
        // leave a null in that slot instead.
        entry() static is
            let method = HOLDER().get_type().get_method("labelled")!;

            for data in method.return_parameter.get_custom_attributes_data() do
                if data.attribute_type.name =~ "TupleElementNamesAttribute" then
                    let elements =
                        cast Collections.Iterable[CustomAttributeTypedArgument]?(
                            data.constructor_arguments[0].value
                        )!;

                    for element in elements do
                        let name = cast string?(element.value);

                        if name? then
                            write_line("name: {name}");
                        else
                            write_line("name: <null>");
                        fi
                    od
                fi
            od

            return;
        si
    si
si
