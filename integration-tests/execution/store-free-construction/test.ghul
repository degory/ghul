// A function whose writes all land on an object nothing else can
// reach yet cannot invalidate a caller's narrowing. That covers a
// constructor writing its own state — through a property accessor
// as much as a field — a constructor chaining to its base, and any
// function that returns a freshly built value, an operator
// included.

use IO.Std.write_line;

class ANIMAL is
    name: string public;

    init(name: string) is
        self.name = name;
    si
si

class CAT: ANIMAL is
    init(name: string) is
        super.init(name);
    si

    purr() -> string => "{name} purrs";
si

class VECTOR is
    x: int;
    y: int;

    init(x: int, y: int) is
        self.x = x;
        self.y = y;
    si

    +(other: VECTOR) -> VECTOR => VECTOR(x + other.x, y + other.y);
si

class PEN is
    occupant: ANIMAL? field;

    init(occupant: ANIMAL?) is
        self.occupant = occupant;
    si
si

// building a component is a write to an object nobody else can
// reach either, so a constructor that builds one keeps its own
// classification
class BASKET is
    lining: VECTOR;

    init() is
        self.lining = VECTOR(0, 0);
    si
si

entry() is
    let pen = PEN(CAT("tom"));
    let origin = VECTOR(1, 2);

    if isa CAT(pen.occupant) then
        let sum = origin + VECTOR(3, 4);
        let understudy = CAT("felix");
        let basket = BASKET();

        write_line(pen.occupant.purr());
        write_line(understudy.purr());
        write_line("{sum.x}, {sum.y}");
        write_line("{basket.lining.x}, {basket.lining.y}");
    fi
si
