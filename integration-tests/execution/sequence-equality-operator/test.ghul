use IO.Std.write_line;
use Collections;

class ITEM is
    v: int public;
    init(v: int) is self.v = v; si
    =~(other: ITEM) -> bool pure => v == other.v;
    get_hash_code() -> int => v;
si

class OPAQUE is
    init() is si
si

struct ORDERED is
    v: int;
    init(v: int) is self.v = v; si
    <>(other: ORDERED) -> int pure => v - other.v;
si

entry() is
    write_line("arrays equal: {[1, 2] =~ [1, 2]}");
    write_line("arrays differ: {[1, 2] =~ [1, 3]}");
    write_line("arrays shorter: {[1, 2] =~ [1, 2, 3]}");
    write_line("arrays not unequal: {[1, 2] !~ [1, 2]}");

    let empty1: int[] = [];
    let empty2: int[] = [];

    write_line("empty arrays: {empty1 =~ empty2}");

    write_line("lists equal: {LIST[int]([1, 2]) =~ LIST[int]([1, 2])}");
    write_line("lists differ: {LIST[int]([1, 2]) =~ LIST[int]([2, 1])}");

    let through_interface: List[int] = LIST[int]([1, 2]);

    write_line("list and array: {through_interface =~ [1, 2]}");

    write_line("nested arrays equal: {[[1, 2], [3]] =~ [[1, 2], [3]]}");
    write_line("nested arrays differ: {[[1, 2], [3]] =~ [[1, 2], [4]]}");

    let nested1 = LIST[List[int]]([LIST[int]([1, 2]), LIST[int]([3])]);
    let nested2 = LIST[List[int]]([LIST[int]([1, 2]), LIST[int]([3])]);

    write_line("nested lists equal: {nested1 =~ nested2}");

    write_line("strings by value: {["a", "b"] =~ ["{"a"}", "{"b"}"]}");

    write_line("elements by their own operator: {[ITEM(1), ITEM(2)] =~ [ITEM(1), ITEM(2)]}");
    write_line("elements differ: {[ITEM(1), ITEM(2)] =~ [ITEM(1), ITEM(3)]}");

    let shared = OPAQUE();

    write_line("opaque elements same object: {[shared] =~ [shared]}");
    write_line("opaque elements distinct: {[OPAQUE()] =~ [OPAQUE()]}");

    write_line("ordered equal: {ORDERED(1) =~ ORDERED(1)}");
    write_line("ordered differ: {ORDERED(1) =~ ORDERED(2)}");
    write_line("ordered arrays: {[ORDERED(1)] =~ [ORDERED(1)]}");
si
