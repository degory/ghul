namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A memo pipe consumed inline by the one `for` loop or terminal
    // consumer that fuses a chain is unobservable, so the chain fuses as
    // though the memo were absent and the MEMO_PIPE is never constructed.
    // A memo bound to a local is consumed at a later statement, so it is
    // not eligible and keeps its replay semantics.

    class COUNTING: Iterable[int], Iterator[int] is
        _n: int;
        _limit: int;
        moves: int;
        iterator: Iterator[int] => self;
        current: int => _n;
        init(limit: int) is _n = -1; _limit = limit; moves = 0; si
        move_next() -> bool is moves = moves + 1; _n = _n + 1; return _n < _limit; si
        reset() is _n = -1; si
        dispose() is si
    si

    class Main is
        entry() static is
            // thread-first chain with an inline memo, consumed by a for
            for x in (1::6) |> filter(n => n % 2 == 0) |> memo() do
                Std.write_line("thread-first for: {x}");
            od

            // the same chain over an array-literal source
            for x in [1, 2, 3, 4, 5, 6] |> filter(n => n % 2 == 0) |> memo() do
                Std.write_line("array source for: {x}");
            od

            // stages both sides of the memo, consumed by a terminal
            Std.write_line("consumer count: {(1::6) |> memo() |> filter(n => n % 2 == 0) |> map(n => n * 10) |> count()}");

            // the memo is the whole chain: it still fuses, iterating the
            // source directly, and pulls each element exactly once
            let a = COUNTING(3);
            let total = a |> memo() |> reduce(0, (acc, n) => acc + n);
            Std.write_line("bare memo reduce: {total}, moves: {a.moves}");

            // bound to a local, the memo is consumed at later statements
            // and must not be elided: the second read replays the cache
            // without driving the source again
            let b = COUNTING(3);
            let m = b |> map(n => n * 10) |> memo();
            Std.write_line("bound memo first: {m |> join(", ")}");
            Std.write_line("bound memo second: {m |> join(", ")}");
            Std.write_line("bound memo moves: {b.moves}");
        si
    si
si
