namespace Test is
    use Ghul;
    use Std = IO.Std;

    class NOTED: Disposable is
        _name: string;

        init(name: string) is
            _name = name;
        si

        read() -> string => _name;

        dispose() is
            Std.write_line("disposed {_name}");
        si
    si

    class Main is
        expression() -> string static is
            let use noted = NOTED("expression");

            noted.read()
        si

        conditional(flag: bool) -> string static is
            let use noted = NOTED("conditional");

            if flag then noted.read() else "other" fi
        si

        chosen(flag: bool) -> string static is
            let use noted = NOTED("case");

            case flag
            when true then noted.read()
            else "other"
            esac
        si

        parenthesised() -> string static is
            let use noted = NOTED("paren");

            (let read = noted.read(); read)
        si

        after_a_loop() -> int static is
            let use noted = NOTED("loop");

            let length mut = 0;

            for c in noted.read() do
                length = length + 1;
            od

            length
        si

        awaited() -> Tasks.TASK[string] static is
            let use noted = NOTED("async");

            noted.read()
        si

        absent() -> string? static is
            let use noted = NOTED("absent");

            null
        si

        found(wanted: string) -> string? static is
            let use noted = NOTED("found");

            for c in noted.read() do
                if "{c}" =~ wanted then
                    return "{c}";
                fi
            od

            null
        si

        returned() -> string static is
            let use noted = NOTED("return");

            return noted.read();
        si

        entry() static is
            Std.write_line(expression());
            Std.write_line(conditional(true));
            Std.write_line(chosen(true));
            Std.write_line(parenthesised());
            Std.write_line("{after_a_loop()}");
            Std.write_line(awaited().result);
            Std.write_line(returned());
            Std.write_line("{absent() ?? "none"}");
            Std.write_line("{found("o") ?? "none"}");
            Std.write_line("{found("z") ?? "none"}");
        si
    si
si
