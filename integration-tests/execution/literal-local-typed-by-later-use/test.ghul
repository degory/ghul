use default

// A local holding a function literal whose parameters nothing in the
// literal constrains takes their types from a later typed use of the
// local, directly or as the tail of a block.
direct() is
    let g = x => 4
    let f: int -> int = g
    write_line("direct {f(1)}")
si

through_block() is
    let f: int -> int = (let g = x => 5; g)
    write_line("through block {f(2)}")
si

two_parameters() is
    let h = (a, b) => a
    let k: (string, int) -> string = h
    write_line("two parameters {k("first", 3)}")
si

direct()
through_block()
two_parameters()
