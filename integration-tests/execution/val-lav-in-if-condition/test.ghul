use IO.Std.write_line;

entry() is
    // A local declared inside a `val ... lav` block used as an `if`
    // condition is visible to the block's own tail expression, and
    // to the branch it guards.
    if val let v = ("a" =~ "a"); v lav then
        write_line("if-branch: {v}");
    else
        write_line("else-branch");
    fi

    let x = 2;

    if x == 1 then
        write_line("one");
    elif val let v = (x == 2); v lav then
        write_line("elif-branch: {v}");
    else
        write_line("other");
    fi

    let r = if val let v = ("a" =~ "a"); v lav then 1 else 2 fi;
    write_line("expression-position: {r}");
si
