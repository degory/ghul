use default

// Top-level statements: a deferred-init global assigned a literal whose
// body calls a global function literal, whose own parameter type only a
// later use settles.
let c = true
let g = q => (let (a, b) = q; a + b)

let v mut
v = if c then (x: int, y: int) => 8 else (x: int, y: int) is g((y, 4)) si fi

let w mut
w = (x: int, y: int) is g((y, 4)) si

write_line("{g((1, 2))} {v(1, 2)} {w(1, 2)}")
