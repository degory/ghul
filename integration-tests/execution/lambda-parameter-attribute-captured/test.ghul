class SIMPLE: System.Attribute is
    init() is si
si

// A lambda that captures state from its enclosing scope, or is
// recursive, compiles to a frame-boxed closure class rather than a
// plain delegate method — a different, and until now uncovered,
// generate_il emission path (Closure.gen_frame -> Classy.gen_all).
// Pins that a captured/recursive lambda's parameter attribute still
// reaches the emitted assembly and the lambda still runs correctly.
entry() static is
    let captured = 10;
    let add: (int) -> int = (@SIMPLE() n: int) -> int => n + captured;

    IO.Std.write_line("has attribute: {add.method.get_parameters()[0].get_custom_attributes(false).count > 0}");
    IO.Std.write_line("{add(5)}");

    let fact = (@SIMPLE() n: int) rec => if n == 0 then 1 else n * rec(n - 1) fi;

    IO.Std.write_line("has attribute: {fact.method.get_parameters()[0].get_custom_attributes(false).count > 0}");
    IO.Std.write_line("{fact(5)}");

    return;
si
