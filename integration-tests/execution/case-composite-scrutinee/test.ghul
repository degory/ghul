use default

// A case whose scrutinee is, or contains, an if expression or a block
// evaluates that scrutinee once and matches its value.
union Shape is
    CIRCLE(radius: int)
    DOT
si

identity(x: int) -> int => x

block_scrutinee() is
    case (let t = 3; t + 1)
    when 4 then write_line("block: four")
    else write_line("block: other")
    esac
si

if_scrutinee(c: bool) is
    case (if c then 3 else 4 fi)
    when 3 then write_line("if: three")
    else write_line("if: other")
    esac
si

pattern_arms(c: bool) is
    case (if c then Shape.CIRCLE(1) else Shape.DOT fi)
    when x: Shape.CIRCLE then write_line("pattern: circle {x.radius}")
    when _: Shape.DOT then write_line("pattern: dot")
    esac
si

nested_in_call(c: bool) is
    case identity(if c then 3 else 4 fi)
    when 3 then write_line("call: three")
    else write_line("call: other")
    esac
si

case_expression(c: bool) is
    let s = case (let t = if c then 3 else 4 fi; t)
    when 3 then "three"
    else "other"
    esac
    write_line("expression: {s}")
si

block_scrutinee()
if_scrutinee(true)
if_scrutinee(false)
pattern_arms(true)
pattern_arms(false)
nested_in_call(true)
nested_in_call(false)
case_expression(true)
case_expression(false)
