use IO.Std;

class ANIMAL is
    init() is si
    name() -> string => "animal";
si

class CAT: ANIMAL is
    init() is super.init(); si
    purr() -> string => "purr";
si

class DOG: ANIMAL is
    init() is super.init(); si
    bark() -> string => "woof";
si

describe() -> string pure => "describing";

let pet: ANIMAL mut = ANIMAL();

pet = CAT();

// narrowed to CAT by the assignment, exactly as a local would be
Std.out.write_line(pet.purr());

// a store-free call cannot have changed it
Std.out.write_line(describe());
Std.out.write_line(pet.purr());

pet = DOG();

Std.out.write_line(pet.bark());

if pet.name() =~ "dog" then
    pet = CAT();
else
    pet = DOG();
fi

// divergent branch assignments join back to the declared view
Std.out.write_line(pet.name());
