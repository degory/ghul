namespace Test is
    use IO.Std.write_line;

    // Tests: a foreign function answering a string. result = "copy" copies
    // text the callee keeps, result = "take" copies text the callee handed
    // over and frees it, and a null answer is the absent string. Also a
    // double argument and result, and a string argument that is empty.

    @extern("libc", "strdup", result = "take")
    duplicate(text: string) -> string?;

    @extern("libc", "strerror", result = "copy")
    describe_error(code: int) -> string?;

    @extern("libc", "getenv", result = "copy")
    environment_variable(name: string) -> string?;

    @extern("libc", "fabs")
    float_absolute(value: double) -> double;

    @extern("libc", "pow")
    power(base: double, exponent: double) -> double;

    @extern("libc", "strlen")
    length_of(text: string) -> word;

    entry() is
        write_line(duplicate("héllo € 😀") ?? "absent");
        write_line("{length_of(duplicate("héllo")!)}");
        write_line(describe_error(2) ?? "absent");
        write_line(environment_variable("GHUL_EXTERN_SURELY_UNSET") ?? "absent");
        write_line("{float_absolute(-2.5)} {power(2.0, 10.0)}");
        write_line("{length_of("")}");

        // A call site that answers null after it answered a string.
        for name in ["PATH", "GHUL_EXTERN_SURELY_UNSET", "PATH"] do
            write_line(if environment_variable(name)? then "present" else "absent" fi);
        od

        // Enough copies that a leak or a double free would show.
        let total mut = 0;

        for i in 0..20000 do
            total = total + (duplicate("0123456789")?.length ?? 0);
        od

        write_line("{total}");
    si
si
