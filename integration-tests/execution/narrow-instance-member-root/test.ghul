// A presence fact proved on a member of the enclosing instance is
// readable in a value position, not only as the receiver of a further
// access. The member may be a field or a store-free property; it may
// be named bare or through `self`, and both spellings share one fact;
// and it may be the root of a longer path, exactly as a local is.

use Std = IO.Std;

len(s: string) -> int => s.length;

class HOLDER is
    name: string? public;

    init(name: string?) is
        self.name = name;
    si
si

class SUBJECT is
    _prop: string?;
    _field: string? field;
    _holder_prop: HOLDER;
    _holder_field: HOLDER field;

    init(text: string?) is
        _prop = text;
        _field = text;
        _holder_prop = HOLDER(text);
        _holder_field = HOLDER(text);
    si

    // bare property, in the three value positions
    property_argument() -> int => if _prop? then len(_prop) else -1 fi;

    property_assignment() -> int is
        if !_prop? then return -1; fi
        let s: string = _prop;
        return s.length;
    si

    property_return() -> string is
        if !_prop? then return "-"; fi
        return _prop;
    si

    // bare field
    field_argument() -> int => if _field? then len(_field) else -1 fi;

    // written through `self`, guarded bare and vice versa
    self_use_after_bare_guard() -> int => if _prop? then len(self._prop) else -1 fi;
    bare_use_after_self_guard() -> int => if self._prop? then len(_prop) else -1 fi;

    // path rooted at an instance member rather than a local
    property_root_path() -> int => if _holder_prop.name? then len(_holder_prop.name) else -1 fi;
    field_root_path() -> int => if _holder_field.name? then len(_holder_field.name) else -1 fi;

    // the local-rooted path that already worked, as the control
    local_root_path() -> int is
        let h = HOLDER("abcd");
        if h.name? then return len(h.name); fi
        return -1;
    si
si

entry() is
    let present = SUBJECT("abc");
    let absent = SUBJECT(null);

    Std.write_line("property argument: {present.property_argument()} {absent.property_argument()}");
    Std.write_line("property assignment: {present.property_assignment()} {absent.property_assignment()}");
    Std.write_line("property return: {present.property_return()} {absent.property_return()}");
    Std.write_line("field argument: {present.field_argument()} {absent.field_argument()}");
    Std.write_line("self after bare: {present.self_use_after_bare_guard()} {absent.self_use_after_bare_guard()}");
    Std.write_line("bare after self: {present.bare_use_after_self_guard()} {absent.bare_use_after_self_guard()}");
    Std.write_line("property root: {present.property_root_path()} {absent.property_root_path()}");
    Std.write_line("field root: {present.field_root_path()} {absent.field_root_path()}");
    Std.write_line("local root: {present.local_root_path()}");
si
