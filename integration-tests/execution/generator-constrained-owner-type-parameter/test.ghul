namespace Test is
    use Std = IO.Std;

    class BOX[T: Ghul.Comparable[T]] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        read() -> T => _value;
    si

    class HOLDER[T: Ghul.Comparable[T]] is
        _box: BOX[T];

        init(box: BOX[T]) is
            _box = box;
        si

        drain() -> Ghul.Pipes.Pipe[T] is
            yield _box.read();
            yield _box.read();
        si
    si

    class Main is
        entry() static is
            for v in HOLDER[int](BOX[int](9)).drain() do
                Std.write_line("v: {v}");
            od
        si
    si
si
