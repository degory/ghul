namespace Test is
    use Std = IO.Std;

    // A state machine declared in a generic owner is generic too, so
    // every reference to it — the launcher's local, the type argument
    // to builder.Start, the one to AwaitUnsafeOnCompleted — names the
    // constructed form. The open form does not resolve at run time.

    class BOX[T] is
        _value: T;

        init(value: T) is _value = value; si

        later() -> Tasks.TASK[T] is
            let v = await Tasks.TASK.from_result(_value);

            return v;
        si

        // Two awaits, so entry-dispatch and a second awaiter field are
        // in play as well.
        twice() -> Tasks.TASK[string] is
            let a = await later();
            let b = await later();

            return "{a}/{b}";
        si
    si

    class Main is
        entry() static is
            Std.write_line("{BOX[int](9).later().result}");
            Std.write_line(BOX[string]("x").twice().result);
        si
    si
si
