// a placeholder-typed local plus a narrowed field killed inside the same body
use IO.Std.write_line
use Collections
class H is
    name: string?
    init() is name = "n" si
    poke() is name = null si
    run() -> Iterable[string] => (
        let out = LIST()
        if name? then
            out.add(name)
            poke()
            out.add(name ?? "gone")
        fi
        out
    )
si
for s in H().run() do write_line(s) od
