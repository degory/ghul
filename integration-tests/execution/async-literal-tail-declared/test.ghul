namespace Test is
    use Std = IO.Std;

    class Main is
        // A literal whose return type is written out, ending on a value
        // tail: the value reaches the builder's result rather than the
        // task completing with the result type's default.
        entry() static is
            let awaited = () -> Tasks.TASK[int] is
                let v = await Tasks.TASK.from_result(20);
                v + 2
            si;

            Std.write_line("awaited={awaited().result}");
        si
    si
si
