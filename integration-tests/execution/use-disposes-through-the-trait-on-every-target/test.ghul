use IO.Std.write_line

// A value held by `use` is disposed through Disposable whatever implements it:
// a class implementing Disposable itself, one picked at run time, and an
// iterator, whose dispose implements Iterator's redeclaration of it.
class QUIET(name: string): Ghul.Disposable is
    dispose() is si
si

class LOUD(name: string): Ghul.Disposable is
    dispose() is write_line("disposed {name}") si
si

pick(loud: bool, name: string) -> Ghul.Disposable => if loud then LOUD(name) else QUIET(name) fi

entry() is
    let a = use pick(true, "first")
    let b = use pick(false, "second")
    let c = use LOUD("third")

    let total mut = 0

    for i in use (1::4).iterator do
        total = total + i
    od

    write_line("total {total}")
si
