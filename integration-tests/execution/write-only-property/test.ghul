use IO.Std.write_line;

// A property with an assign accessor and no read accessor: getter
// synthesis must not run for it, since there is no read body to
// build one from.
class TRIGGER is
    _last: string;

    fired: string public
        = value is
            _last = value;
        si

    init() is
        _last = "";
    si

    last: string => _last;
si

entry() is
    let t = TRIGGER();

    t.fired = "one";
    t.fired = "two";

    write_line(t.last);
si
