// Locals of optional value types, a tuple and an int, written through a
// reference as try_get_value does.
use IO.Std.write_line
use Collections.MAP

entry() is
    let pairs = MAP[int, (name: string, size: int)?]()

    pairs[1] = ("one", 3)
    pairs[2] = null

    let pair: (name: string, size: int)? mut = null

    if pairs.try_get_value(1, pair ref) then
        write_line("found {pair?.name ?? "absent"}")
    fi

    if pairs.try_get_value(2, pair ref) then
        write_line("found {pair?.name ?? "absent"}")
    fi

    let counts = MAP[string, int?]()

    counts["n"] = 7

    let count: int? mut = null

    if counts.try_get_value("n", count ref) then
        write_line("count {count ?? -1}")
    fi
si
