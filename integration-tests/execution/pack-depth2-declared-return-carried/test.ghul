// At a depth-2 return-spine formal whose pack the later call of the
// result pins, a literal with declared N-ary returns is presented
// whatever its innermost function is: a literal, a named function, or
// a stored value. The last two are fitted once the body walk says what
// they are.
namespace Grid is
    use IO.Std.write_line;

    once_2[T.., U](make: (int) -> (int) -> T.. -> U) -> T.. -> U => v => make(10)(20)(v);

    weigh(a: int, b: int) -> int => a + b * 10;

    entry() is
        let literal = once_2((j: int) -> (int) -> (int, int) -> int => (k: int) -> (int, int) -> int => (a: int, b: int) -> int => a + b * 10);
        let named = once_2((j: int) -> (int) -> (int, int) -> int => (k: int) -> (int, int) -> int => weigh);

        let stored = (a: int, b: int) -> int => a + b * 10;
        let held = once_2((j: int) -> (int) -> (int, int) -> int => (k: int) -> (int, int) -> int => stored);

        write_line("{literal(1, 2)}");
        write_line("{named(1, 2)}");
        write_line("{held(1, 2)}");
    si
si
