namespace Test is
    use IO.Std.write_line;

    // Tests: every width crosses to a foreign function as C expects it.
    // The foreign side relies on a small argument being extended to a
    // register and hands back a small result with the rest of the register
    // left as the computation had it, so a missing extension on either side
    // changes the answer. fixture.ll is the foreign side.

    @extern("", "fx_widen_i8") widen_byte(x: byte) -> int;
    @extern("", "fx_widen_u8") widen_ubyte(x: ubyte) -> int;
    @extern("", "fx_widen_i16") widen_short(x: short) -> int;
    @extern("", "fx_widen_u16") widen_ushort(x: ushort) -> int;
    @extern("", "fx_widen_u16") widen_char(x: char) -> int;
    @extern("", "fx_widen_bool") widen_bool(x: bool) -> int;

    @extern("", "fx_ret_i8") return_byte(x: int) -> byte;
    @extern("", "fx_ret_u8") return_ubyte(x: int) -> ubyte;
    @extern("", "fx_ret_i16") return_short(x: int) -> short;
    @extern("", "fx_ret_u16") return_ushort(x: int) -> ushort;
    @extern("", "fx_ret_u16") return_char(x: int) -> char;
    @extern("", "fx_ret_bool") return_bool(x: int) -> bool;

    @extern("", "fx_sum_u32") sum_uint(a: uint, b: uint) -> uint;
    @extern("", "fx_sum_i64") sum_long(a: long, b: long) -> long;
    @extern("", "fx_sum_u64") sum_ulong(a: ulong, b: ulong) -> ulong;
    @extern("", "fx_sum_f32") sum_single(a: single, b: single) -> single;
    @extern("", "fx_sum_f64") sum_double(a: double, b: double) -> double;

    @extern("", "fx_many")
    many(a: byte, b: ushort, c: int, d: long, e: double, f: int, g: int, h: int, i: int, j: long) -> long;

    entry() is
        write_line("{widen_byte(-5b)} {widen_byte(127b)} {widen_ubyte(250ub)} {widen_ubyte(0ub)}");
        write_line("{widen_short(-300s)} {widen_ushort(65000us)} {widen_char('€')} {widen_char('A')}");
        write_line("{widen_bool(true)} {widen_bool(false)}");

        write_line("{return_byte(0x1ff)} {return_byte(0x17f)} {return_ubyte(0x1ff)} {return_ubyte(0x180)}");
        write_line("{return_short(0x1ffff)} {return_short(0x17fff)} {return_ushort(0x1ffff)} {return_ushort(0x18000)}");
        write_line("{cast int(return_char(0x120ac))} {return_bool(0x102)} {return_bool(0x103)}");

        write_line("{sum_uint(4_000_000_000u, 200_000_000u)}");
        write_line("{sum_long(-9_000_000_000_000L, 1L)}");
        write_line("{sum_ulong(18_000_000_000_000_000_000ul, 400_000_000_000_000_000ul)}");
        write_line("{sum_single(1.5s, 2.25s)} {sum_double(1.5, 2.25)}");

        write_line("{many(-1b, 65535us, -3, 5_000_000_000L, 7.9, 1, 2, 3, 4, 6_000_000_000L)}");
    si
si
