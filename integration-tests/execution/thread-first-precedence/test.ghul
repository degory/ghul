// A user-defined operator placed at user-3 binds tighter than
// thread-first; one at user-2 binds looser.
@@precedence("⊞", "user-3")
@@precedence("⊟", "user-2")

namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;

    // Tests: `|>` and `~>` are a binary precedence level below range and
    // above relational. An operator that binds tighter is gathered into
    // the subject; a comparison, a boolean operator and `??` stay outside
    // the chain; a prefix operator applies to its operand first; and an
    // operator written after the call applies to the whole chain.

    twice(x: int) -> int => x * 2;
    lookup(s: string) -> int? => if s =~ "a" then 1 else null fi;
    negate(b: bool) -> bool => !b;
    label(n: int) -> string => "#{n}";

    ⊞(a: int, b: int) -> int => a * 10 + b;
    ⊟(a: int, b: int) -> int => a * 10 + b;

    maybe(present: bool) -> string? => if present then "a" else null fi;

    entry() is
        let n = 3;
        let xs = [1, 2, 3, 4];
        let shape = [5, 9, 2];

        // a binary operator on the left is gathered into the subject
        write_line("{1 + 2 |> twice()}");               // twice(3) = 6
        write_line("{2 * n |> twice()}");               // twice(6) = 12
        write_line("{0..n |> count()}");                // 3
        write_line("{1::n |> map(i => i * i) |> reduce(0, (a, b) => a + b)}"); // 14
        write_line("{1 << 2 |> twice()}");              // twice(4) = 8
        write_line("{6 & 3 |> twice()}");              // twice(2) = 4
        write_line("{1 ⊞ 2 |> twice()}");              // twice(12) = 24
        write_line("{1 ⊟ 2 |> twice()}");              // 1 ⊟ twice(2) = 14

        // comparison, boolean and `??` stay outside the chain
        write_line("{xs |> count() > 3}");              // True
        write_line("{n == 3 /\ xs |> any(x => x > 3)}"); // True
        write_line("{xs |> count() == 4 /\ n |> twice() == 6}"); // True
        write_line("{maybe(false) ~> lookup() ?? 7}");  // 7
        write_line("{maybe(true) ~> lookup() ?? 7}");   // 1

        // a prefix operator applies to its operand first
        write_line("{-n |> twice()}");                  // twice(-3) = -6
        write_line("{!true |> negate()}");              // negate(false) = True
        write_line("{!(xs |> any(x => x > 3))}");       // False

        // an operator after the call applies to the whole chain
        write_line("{shape |> reduce(0, (a, b) => if a > b then a else b fi) + 1}"); // 10
        write_line("{xs |> count() % 3}");              // 1
        write_line("{xs |> reduce(0.0D, (t, v) => t + cast double(v)) / cast double(xs.count)}"); // 2.5
        write_line("{1 + 2 |> twice() * 3}");           // twice(3) * 3 = 18

        // other positions take a whole expression, chain included
        let f = (x: int) => x + 1 |> twice();
        write_line("{f(2)}");                           // twice(3) = 6
        write_line("{(xs |> count(), n + 1 |> twice())}"); // (4, 8)
        let block = (let m = 2; m + 1 |> twice());
        write_line("{block}");                          // 6
        write_line("{cast int(n) |> twice()}");         // 6
        write_line(label(n + 1 |> twice()));             // #8
        assert 1 + 1 |> twice() == 4;
        write_line("{early(xs)}");                      // 5
    si

    early(xs: int[]) -> int is
        return xs |> count() + 1;
    si
si
