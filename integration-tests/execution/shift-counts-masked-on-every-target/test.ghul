use IO.Std.write_line

// A shift count at or above the width of the value is masked, as .NET masks
// it: to the low five bits for a 32-bit or narrower value, and the low six
// for a 64-bit one. The counts come through a function so none is known
// before the program runs.

count(n: int) -> int => n

write_line("int: {1 << count(33)} {-8 >> count(33)} {cast uint(1) << count(32)} {-1 >>> count(60)}")
write_line("long: {1L << count(65)} {-8L >> count(65)} {cast ulong(1) << count(64)}")
write_line("short: {cast short(1) << count(17)} {cast short(1) << count(33)}")
write_line("byte: {cast byte(1) << count(9)} {cast ubyte(1) << count(33)}")
write_line("negative: {1 << count(-1)} {1L << count(-1)}")
