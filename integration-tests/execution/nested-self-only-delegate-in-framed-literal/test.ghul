use IO.Std.write_line

apply(f: (int) -> int, x: int) -> int => f(x)

class BOX is
    value: int

    init(value: int) is
        self.value = value
    si

    get(n: int) -> int => value + n

    run(offset: int) -> int =>
        apply(x => apply(n => get(n), x + offset), 1)
si

entry() is
    write_line("{BOX(40).run(1)}")
si
