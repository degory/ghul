namespace Test is
    use Std = IO.Std;

    class WALKER: Collections.Iterator[int] is
        _at: int;

        init() is _at = 0; si

        move_next() -> bool is
            _at = _at + 1;

            return _at <= 1;
        si

        current: int => _at;

        dispose() is si
    si

    struct TICKER: Collections.Iterator[int] is
        _at: int;

        init(at: int) is _at = at; si

        move_next() -> bool => false;

        current: int => _at;

        dispose() is si
    si

    class REWINDS: Collections.Iterator[int] is
        _at: int;

        init() is _at = 0; si

        move_next() -> bool is
            _at = _at + 1;

            return _at <= 2;
        si

        current: int => _at;

        reset() is _at = 0; si

        dispose() is si
    si

    class Main is
        entry() static is
            try
                WALKER().reset();

                Std.write_line("class: no throw");
            catch e: System.NotSupportedException
                Std.write_line("class: reset is not supported");
            yrt

            try
                TICKER(3).reset();

                Std.write_line("struct: no throw");
            catch e: System.NotSupportedException
                Std.write_line("struct: reset is not supported");
            yrt

            // The legacy interface reaches the same member, which is
            // the slot the synthesis fills.
            let legacy =
                System.Type.get_type("System.Collections.IEnumerator")!.get_method("Reset")!;

            try
                legacy.invoke(WALKER(), []);

                Std.write_line("through the interface: no throw");
            catch e: System.Reflection.TargetInvocationException
                Std.write_line(
                    "through the interface: reset is not supported");
            yrt

            let rewinds = REWINDS();
            let _ = rewinds.move_next();

            rewinds.reset();

            Std.write_line("declared reset kept: {rewinds.move_next()}");

            legacy.invoke(rewinds, []);

            Std.write_line("declared reset through the interface: no throw");
        si
    si
si
