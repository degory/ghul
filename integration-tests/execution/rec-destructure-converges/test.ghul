use default

// A `rec` literal that destructures a union variant with `if let` settles on
// its second walk. The recursive call's argument is judged against the
// parameter's declared type, not the variant it is narrowed to inside the
// `if let`, so the walk records no spurious progress and the body converges
// instead of spending every walk it is allowed.
union List[T] is
    NIL
    CONS(head: T, tail: List[T])
si

use List.NIL
use List.CONS

stringify(l: List[int]) -> string =>
    let f = l rec => if let (head, tail): CONS = l then "{head}, {rec(tail)}" else "nil" fi in f(l)

write_line(stringify(List.CONS(1, List.CONS(2, List.NIL[int]))))

for line in IO.File.read_all_lines("trace.txt") do
    if line.starts_with("body-end") /\ !line.contains("walks=1\t") then
        let fields = line.split(['\t'])

        write_line("{fields[2]} {fields[3]}")
    fi
od
