namespace Test is
    use IO.Std.write_line;

    // Tests: `await` is a prefix operator, so `await t |> f()` awaits `t`
    // and threads the result into `f`.

    twice(x: int) -> int => x * 2;

    get() -> Tasks.TASK[int] => Tasks.TASK.from_result(5);

    run() -> Tasks.TASK[int] is
        let r = await get() |> twice();
        return r;
    si

    entry() is
        write_line("{run().result}");              // 10
    si
si
