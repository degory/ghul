use default

// An empty array literal with nothing around it to say what it holds takes
// the element type of the array literals beside it.
quibble(words: string[]) -> string => "[{words |> join(",")}]"

let examples = [[], ["ABC"], ["ABC", "DEF"]]

for words in examples do
    write_line(quibble(words))
od

let levels = [[], [1, 2, 4], []]

write_line("{levels |> map(l => "{l.count}") |> join(",")}")

let only_empties = [[], []]

write_line("{only_empties.count}")
