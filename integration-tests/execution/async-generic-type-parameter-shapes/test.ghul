namespace Test is
    use Std = IO.Std;

    class BOX[T: Ghul.Comparable[T]] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        read() -> T => _value;
    si

    class HOLDER[T: class] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        read() -> T => _value;
    si

    class Main is
        bare[T](value: T) -> Tasks.TASK[T] static is
            await Tasks.TASK.yield();

            return value;
        si

        bounded[T: Ghul.Comparable[T]](box: BOX[T]) -> Tasks.TASK[T] static is
            await Tasks.TASK.yield();

            return box.read();
        si

        kinded[T: class](holder: HOLDER[T]) -> Tasks.TASK[T] static is
            await Tasks.TASK.yield();

            return holder.read();
        si

        entry() static is
            Std.write_line("bare: {bare[int](1).result}");
            Std.write_line("bounded: {bounded[int](BOX[int](2)).result}");
            Std.write_line("kinded: {kinded[string](HOLDER[string]("three")).result}");
        si
    si
si
