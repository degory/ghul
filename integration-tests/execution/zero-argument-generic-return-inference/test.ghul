use default

// A type parameter only the return type mentions is bound from the
// context the call sits in - a typed local, an assignment, the return
// of the enclosing function, or the argument slot of another call -
// whether or not the call has arguments of its own to bind it from.
make[T]() -> T => _[T]

zero_of[T](ignored: int) -> T => _[T]

takes_int(i: int) -> int => i + 1

as_int() -> int => make()

as_text() -> string? is
    return make()
si

entry() is
    let from_argument: int = zero_of(1)
    write_line("{from_argument}")

    let typed_local: int = make()
    write_line("{typed_local}")

    let optional_local: string? = make()
    write_line("{optional_local ?? "absent"}")

    let assigned mut = 0
    assigned = make()
    write_line("{assigned}")

    write_line("{as_int()}")
    write_line("{as_text() ?? "absent"}")

    write_line("{takes_int(make())}")
si
