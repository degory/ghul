use IO.Std.write_line;
use Ghul;
use Ghul.Result.*;

ok(v: int) -> Result[int, string] => OK(v)
bad() -> Result[int, string] => ERROR("no")

ok2(v: int) -> Result[int, F] => OK(v)
bad2() -> Result[int, F] => ERROR(F.BAD)

union F is
    BAD;
si

entry() is
    // `??` over a present Result hands the payload to the fallback's type.
    let a: int = ok(41) ?? 7
    write_line("{a}")

    // An absent Result is replaced by the fallback; the error never surfaces.
    let b: int = bad() ?? 7
    write_line("{b}")

    // Result ?? Result: the answer is the right operand's Result, its
    // error type the right's.
    let c: Result[int, F] = ok(3) ?? bad2()
    let d: Result[int, F] = bad() ?? bad2()
    let e: Result[int, F] = bad() ?? ok2(6)

    if let good: Result.OK = c then
        write_line("c: {good.value}")
    else
        write_line("c failed")
    fi

    if let good: Result.OK = d then
        write_line("d: {good.value}")
    else
        write_line("d failed")
    fi

    case e
    when good: Result.OK then write_line("e: {good.value}")
    when failure: Result.ERROR then write_line("e: {failure.error}")
    esac

    // Chains stay right-associative: each `??` sees a Result left and
    // folds to the rightmost fallback's type.
    let f: int = ok(5) ?? bad2() ?? 9
    let g: int = bad() ?? bad2() ?? 9
    write_line("{f} {g}")
si
