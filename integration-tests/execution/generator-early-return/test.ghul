// A bare `return` in a generator ends the stream. It carries no value, so
// it draws no return-without-value warning against the declared Pipe[T].
use IO.Std.write_line
use Ghul.Pipes

counting(limit: int) -> Pipe[int] is
    let i mut = 0

    while true do
        yield i

        if i >= limit then
            return
        fi

        i = i + 1
    od
si

entry() is
    for n in counting(3) do
        write_line("{n}")
    od
si
