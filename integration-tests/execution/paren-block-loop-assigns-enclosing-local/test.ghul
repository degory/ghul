use IO.Std.write_line;

entry() is
    // A compound statement in element position whose body opens by
    // assigning an enclosing mutable local: the assignment must reach
    // that local rather than declaring one of its own.
    let e mut = 0;
    let a = (
        do
            e = e + 1;
            if e >= 2 then break fi;
        od;
        e
    );
    write_line("a = {a}");

    let f mut = 0;
    let b = (
        for i in 0..3 do
            f = f + i;
        od;
        f
    );
    write_line("b = {b}");

    let g mut = 0;
    let c = (
        while true do
            g = g + 2;
            if g >= 4 then break fi;
        od;
        g
    );
    write_line("c = {c}");

    let h mut = 0;
    let d = (
        if true then
            h = 7;
            write_line("h = {h}");
        fi;
        h
    );
    write_line("d = {d}");

    // Still an ordinary named tuple, not a block.
    let t = (e = 1, f = 2);
    write_line("t = {t.e}, {t.f}");
si
