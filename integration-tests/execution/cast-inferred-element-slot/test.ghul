namespace Test is
    use IO.Std.write_line;
    use Collections.LIST;
    use System.Convert;

    // The element type of `bytes` is settled by the sibling `add`, so
    // the typeless cast's target is still an inference placeholder on
    // the walk that first reaches it.
    fill(text: string) -> LIST[ubyte] is
        let bytes = LIST();

        for i in 0..text.length do
            if text[i] == '%' then
                bytes.add(Convert.to_byte("41", 16));
            else
                bytes.add(cast(text[i]));
            fi
        od

        return bytes;
    si

    class Main is
        entry() static is
            for value in fill("hi%") do
                write_line("{value}");
            od

            return;
        si
    si
si
