use IO.Std.write_line

box[T](value: T) -> object? => value

entry() is
    let present: (n: int, s: string)? = (n = 1, s = "a")
    let absent: (n: int, s: string)? = null

    write_line("{box(present)?} {box(absent)?}")

    let pair = (present, 2)
    let same = (present, 2)

    write_line("{pair.get_hash_code() == same.get_hash_code()}")
si
