use IO.Std.write_line
use Ghul.Pipes.next
use Ghul.Pipes.find_map

// A `T?` over an unconstrained type parameter, at a value type and at a
// reference type: returned present and absent, given a fallback, and
// tested with `if let`. `next` declares its result as `MAYBE[T]` by
// name, which reads as the same optional, and so does find_map's result.
first[T](items: T[]) -> T? => if items.count > 0 then items[0] else null fi

long_word(w: string) -> string? => if w.length > 1 then w else null fi

entry() is
    let numbers = [7, 8]
    let none: int[] = []
    let words = ["a"]
    let no_words: string[] = []

    write_line("{first(numbers) ?? -1} {first(none) ?? -1}")
    write_line("{first(words) ?? "none"} {first(no_words) ?? "none"}")

    if let n = first(numbers) then write_line("got {n}") fi
    if let w = first(no_words) then write_line("got {w}") else write_line("no word") fi

    let iterator = words.iterator
    let present: string? = iterator |> next()
    let absent: string? = iterator |> next()
    write_line("{present ?? "none"} {absent ?? "none"}")

    let found = ["a", "bee", "c"] |> find_map(w => long_word(w))
    write_line(found ?? "none")
si
