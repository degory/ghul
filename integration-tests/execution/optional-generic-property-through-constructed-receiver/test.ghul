use IO.Std.write_line

// A property whose type is an optional generic at the owner's own type
// parameter stays optional when read through a constructed receiver.
class NODE[T](value: T) is
    next: NODE[T]? public
    other: BOX[T]? public

    push(value: T) -> NODE[T] is
        let head = NODE[T](value)
        head.next = self
        return head
    si
si

class BOX[T](item: T);

length[T](node: NODE[T]) -> int is
    let count mut = 1
    let current mut = node

    while current.next? do
        current = current.next
        count = count + 1
    od

    return count
si

second(node: NODE[int]) -> int =>
    if let n = node.next then n.value else -1 fi

let node = NODE(1)

write_line("absent {node.next?} {node.other?}")

node.next = NODE(2)
node.other = BOX(3)

write_line("present {node.next?} {node.next!.value} {node.other!.item}")

if let n = node.next then
    write_line("if let {n.value}")
fi

write_line("coalesce {node.next?.value} {node.next?.next?.value ?? -1}")

write_line("second {second(node)} {second(NODE(9))}")

write_line("length {length(node)} {length(node.push(0))}")
