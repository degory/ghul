use default

// A queue constructed with no type arguments takes them from what is
// enqueued, and a cast over a value destructured from it compiles once
// that type has settled.
esthetic(base: int) -> Pipe[long] is
    let pending = Collections.Queue()

    for digit in 1..base do
        pending.enqueue((cast long(digit), digit))
    od

    while pending.count > 0 do
        let (value, last) = pending.dequeue()

        yield value + cast long(last)
    od
si

write_line("{esthetic(4) |> map(x => "{x}") |> join(",")}")
