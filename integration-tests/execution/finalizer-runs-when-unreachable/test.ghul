// Instances of a class with a finalizer that nothing reaches are finalized
// once the collector runs, which allocating enough brings about. The
// collector scans the stack conservatively, so a stale copy of one
// pointer can keep that one object alive; of a hundred, some are finalized.
use IO.Std.write_line

use Tracking.TRACKED
use Tracking.FINALIZED

make() is
    for i in 0..100 do
        let tracked = TRACKED("tracked {i}")
    od
si

make()

let rounds mut = 0

while FINALIZED.count == 0 /\ rounds < 2000000 do
    let garbage = [rounds, rounds, rounds, rounds]
    rounds = rounds + 1
od

write_line(if FINALIZED.count > 0 then "collected" else "never collected" fi)
