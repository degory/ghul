// A class whose instances count their finalization, declared in a library
// source, where @finalizer() is accepted. The finalizer reads its own
// object's field, which is still in memory when it runs.
namespace Tracking is
    class FINALIZED is
        count: int static public
    si

    class TRACKED is
        _name: string

        init(name: string) is
            _name = name
        si

        @finalizer()
        finalize() is
            if _name.length > 0 then
                FINALIZED.count = FINALIZED.count + 1
            fi
        si
    si
si
