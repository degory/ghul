class SELF_APPLY[A, B](_f: (SELF_APPLY[A, B]) -> (A -> B)) is
    apply(r: SELF_APPLY[A, B]) -> (A -> B) => _f(r)
si

y[A.., B](f: (A -> B) -> A.. -> B) -> (A -> B) =>
    let wrap =
        SELF_APPLY[A, B](
            (r: SELF_APPLY[A, B]) => (a: A) => f(r.apply(r))(a))
    in wrap.apply(wrap)

let gcd = y(recurse => (a, b) => if b == 0 then a else recurse((b, a % b)) fi)

IO.Std.write_line("{gcd((1071, 462))}")
