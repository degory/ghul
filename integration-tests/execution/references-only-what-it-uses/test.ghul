namespace Test is
    use IO.Std.write_line

    // Refers to the console, reflection and a list, so the assembly should
    // reference the framework assemblies those live in, at the framework's
    // own version, and no others.
    entry() is
        let names = Collections.LIST[string]()

        for name in System.Reflection.Assembly.get_executing_assembly().get_referenced_assemblies() do
            // The runtime is versioned on its own schedule, so only the
            // framework's rows are checked.
            if name.name!.starts_with("System.") then
                names.add("{name.name} {name.version!.major}")
            fi
        od

        names.sort()

        for name in names do
            write_line(name)
        od
    si
si
