use IO.Std.write_line
use Ghul.Pipes

// A function literal that returns nothing and stores nothing is a pure
// action: called through a fused each, held in a local and called, and
// passed where a pure action is expected, it returns nothing on every target.
apply_all(items: int[], action: (int) -> void pure) is
    for item in items do
        action(item)
    od
si

entry() is
    (0..4) |> filter(n => n % 2 == 0) |> each(n => write_line("even {n}"))

    let shout = (text: string) => write_line("{text}!")
    shout("hello")

    apply_all([7, 8], n => write_line("item {n}"))
si
