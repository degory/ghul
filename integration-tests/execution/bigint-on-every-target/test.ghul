use IO.Std.write_line

// A bigint built from literals and scalars, through arithmetic that stays in
// a long and arithmetic that does not, compared and written out.
entry() is
    let f mut = 1n

    for i in 1::30 do
        f = f * bigint(i)
    od

    write_line("{f}")
    write_line("{f % 1000007n} {f / f} {-f + f}")
    write_line("{bigint.pow(2n, 100)}")
    write_line("{bigint.mod_pow(3n, 200n, 1000000007n)}")
    write_line("{9223372036854775807n + 1n} {123456789012345678901234567890n}")
    write_line("{3n <> 2n} {f > 1n} {7n =~ 7n}")
si
