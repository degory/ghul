let greeting = "hello";
let (a, b) = (1, "two");
let count mut = 0;
let deferred mut;

deferred = 3.5;

greet() is
    IO.Std.write_line("{greeting} {a} {b} {deferred} {count}");
si

bump() is
    count = count + 1;
si

class HOLDER is
    init() is si

    sum() -> string => "{greeting}-{count}";
si

greet();
bump();
bump();
greet();
IO.Std.write_line(HOLDER().sum());

let show = () is IO.Std.write_line("lambda: {greeting}"); si;
show();
