namespace Test is
    use IO.Std;
    use Collections;

    double(x: int) -> int => x * 2;

    class HOLDER is
        factor: int;

        init(factor: int) is
            self.factor = factor;
        si

        scale(x: int) -> int => x * factor;
    si

    apply_each[T,U](xs: Iterable[T], f: T -> U) -> LIST[U] is
        let result = LIST[U]();
        for x in xs do
            result.add(f(x));
        od
        return result;
    si

    class Main is
        entry() static is
            // Global function referenced as a value with no target
            // type context: infers its own native function shape.
            let f = double;
            Std.write_line("{f(10)}");

            // Instance method referenced through an explicit receiver.
            let holder = HOLDER(3);
            let g = holder.scale;
            Std.write_line("{g(7)}");

            let xs = [1, 2, 3];

            // Method group passed directly as a higher-order argument -
            // no lambda wrapper needed.
            let doubled = apply_each(xs, double);
            for d in doubled do
                Std.write_line("{d}");
            od

            return;
        si
    si
si
