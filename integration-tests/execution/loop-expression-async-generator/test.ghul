namespace Test is
    use Std = IO.Std;
    use System.Threading.Tasks;

    class Main is
        entry() static is
            gen() | .each(i => Std.write_line("yielded {i}"));

            Std.write_line("acc {STATE.gen_acc}");

            find_async().wait();

            Std.write_line("async {STATE.async_result}");
        si
    si

    class STATE is
        gen_acc: int public static;
        async_result: string public static;
    si

    gen() -> Ghul.Pipes.Pipe[int] is
        let acc: int? = do
            for i in 1::5 do
                yield i;

                if i == 3 then break i fi;
            od;

            break null;
        od;

        STATE.gen_acc = acc ?? -1;

        for i in [acc ?? 0] do
            yield i * 10;
        od
    si

    find_async() -> Tasks.TASK is
        let n mut = 0;
        let r: string? = while n < 5 do
            let s = await fetch(n);
            n = n + 1;

            if s? then break s fi;
        od;

        STATE.async_result = r ?? "exhausted";
    si

    fetch(n: int) -> Tasks.TASK[string?] is
        if n == 2 then
            return Tasks.TASK.from_result[string?]("hit-{n}");
        fi

        return Tasks.TASK.from_result[string?](null);
    si
si
