use IO.Std.write_line;

class KEYED is
    _name: string;
    _n: int;

    init(name: string, n: int) is
        _name = name;
        _n = n;
    si

    =~(other: KEYED) -> bool => _name =~ other._name /\ _n == other._n;
    get_hash_code() -> int => _name.get_hash_code();
si

// defines no =~, so the synthesized union equality compares this field
// with the default equality comparer and warns at the declaration
class OPAQUE is
    init() is si
si

// the cast-may-throw warn.expected line below is not from the
// synthesized `=~`: the synthesized `get_hash_code` boxes every field
// with `cast object(...)`, and an optional field makes that cast
// spellable as throwing. Pinned as-is; fixing it belongs with the
// hash synthesis, not the equality body.

union HOLDER is
    KEY(key: KEYED);
    BOXED(opaque: OPAQUE);
    MAYBE_TEXT(text: string?);
    PAIR(a: int, b: string);
si

entry() is
    // a field whose type defines =~ compares through that operator, so
    // two distinct instances with equal content are equal
    let k1 = HOLDER.KEY(KEYED("a", 1));
    let k2 = HOLDER.KEY(KEYED("a", 1));
    let k3 = HOLDER.KEY(KEYED("b", 1));
    write_line(k1 =~ k2);
    write_line(k1 =~ k3);

    // a field whose type defines no =~ compares with the default
    // equality comparer, which is reference identity for a class
    let b1 = HOLDER.BOXED(OPAQUE());
    let b2 = HOLDER.BOXED(OPAQUE());
    write_line(b1 =~ b1);
    write_line(b1 =~ b2);

    // an optional string field compares through the string operator
    let t1: HOLDER = HOLDER.MAYBE_TEXT(null);
    let t2: HOLDER = HOLDER.MAYBE_TEXT(null);
    let t3: HOLDER = HOLDER.MAYBE_TEXT("x");
    write_line(t1 =~ t2);
    write_line(t1 =~ t3);

    // scalar fields
    let p1 = HOLDER.PAIR(1, "one");
    let p2 = HOLDER.PAIR(1, "one");
    let p3 = HOLDER.PAIR(2, "one");
    write_line(p1 =~ p2);
    write_line(p1 =~ p3);

    // different variants are never equal
    write_line(k1 =~ p1);
si
