use IO.Std.write_line;

// The same void recursive-literal shape inside a named function's
// body, where the enclosing function's own retry loop re-walks the
// literal before the return type settles.
run(a: int) is
    let tick = b rec => val
        if b == 0 then
            return;
        fi

        write_line("inner tick {b}");
        rec(b - 1);
    lav;

    tick(a);
si

entry() is
    // A void recursive literal whose return type is inferred: the
    // self-call must see the settled `int -> void` type, not the
    // unresolved placeholder the body was first walked against.
    let h = a rec => val
        if a == 0 then
            return;
        fi

        write_line("counting down from {a}");
        rec(a - 1);
    lav;

    h(3);

    // Annotated parameter, same shape.
    let countdown = (n: int) rec => val
        if n == 0 then
            return;
        fi

        write_line("tick {n}");
        rec(n - 1);
    lav;

    countdown(2);

    // A value-returning recursive literal for contrast.
    let factorial = n rec => if n <= 1 then 1L else cast long(n) * rec(n - 1) fi;
    write_line("factorial(5) is {factorial(5)}");

    run(2);
si
