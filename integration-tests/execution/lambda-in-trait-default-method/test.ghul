namespace Test is
    use IO.Std;

    // Tests: lambda literals written in a trait's default-method body.
    // Each shape the compiler lowers differently — a stateless anonymous
    // function, a frame class over a captured local, a delegate bound to
    // the receiver — has to be emitted alongside the trait, exactly as
    // it is for a class.

    trait Box is
        get_value() -> int;

        stateless() -> void is
            let f = (a: int, b: int) -> int => a + b;
            Std.write_line("{f(2, 3)}");
        si

        captures_local() -> void is
            let n = 7;
            let f = (a: int) -> int => a + n;
            Std.write_line("{f(2)}");
        si

        captures_self() -> void is
            let f = () -> int => get_value();
            Std.write_line("{f()}");
        si
    si

    class INT_BOX: Box is
        _value: int;

        init(value: int) is _value = value; si

        get_value() -> int => _value;
    si

    class Main is
        entry() static is
            let b = INT_BOX(5);

            b.stateless();
            b.captures_local();
            b.captures_self();

            return;
        si
    si
si
