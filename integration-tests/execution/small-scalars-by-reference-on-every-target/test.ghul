use IO.Std.write_line

// A reference to a bool, a byte or a char reads and writes the value
// wherever it is held: a local, a field, an array element. A struct of
// mixed widths keeps each member at its own width, and reads and
// compares by them.
bump(x: ubyte ref) is x! = x! + 1ub si
next_char(x: char ref) is x! = cast char(int(x!) + 1) si
flip(x: bool ref) is x! = !x! si

class HOLDER is
    count: ubyte field
    letter: char field
    on: bool field

    init() is
        count = 7ub
        letter = 'q'
        on = false
    si
si

struct MIXED(small: byte public, letter: char public, flag: bool public, wide: long public)

entry() is
    let count mut = 254ub
    let letter mut = 'a'
    let on mut = true
    let holder = HOLDER()
    let bytes = [1ub, 2ub]
    let chars = ['m', 'n']
    let flags = [false, true]

    bump(count ref)
    bump(holder.count ref)
    bump(bytes[1] ref)
    next_char(letter ref)
    next_char(holder.letter ref)
    next_char(chars[0] ref)
    flip(on ref)
    flip(holder.on ref)
    flip(flags[0] ref)

    write_line("{count} {holder.count} {bytes[0]} {bytes[1]}")
    write_line("{letter} {holder.letter} {chars[0]}{chars[1]}")
    write_line("{on} {holder.on} {flags[0]} {flags[1]}")

    let m = MIXED(-3b, 'z', true, 1099511627776L)
    let same = MIXED(-3b, 'z', true, 1099511627776L)
    let other = MIXED(-3b, 'z', false, 1099511627776L)

    write_line("{m.small} {m.letter} {m.flag} {m.wide}")
    write_line("{m =~ same} {m =~ other}")
si
