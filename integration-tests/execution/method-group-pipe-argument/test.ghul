use IO.Std.write_line;
use Ghul.Pipes;

reverse(s: string) -> string => s |> reduce("", (acc, c) => "{c}{acc}");
is_palindrome(s: string) -> bool => s =~ reverse(s);

// The pipe combinators' generic formals pin the member: filter's
// predicate is (T) -> bool pure with T bound by the source, map's
// (T) -> S leaves S for the delegate's own shape to bind.
is_inexact_palindrome(s: string) -> bool =>
    s
        |> filter(char.is_letter)
        |> map(char.to_lower)
        |> reduce("", (acc, c) => "{acc}{c}")
        |> is_palindrome();

entry() is
    write_line(is_inexact_palindrome("A man, a plan, a canal: Panama"));
    write_line(is_inexact_palindrome("not one"));
si
