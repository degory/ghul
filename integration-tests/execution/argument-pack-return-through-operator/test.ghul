namespace Test is
    use IO.Std.write_line;

    // Tests: the N-ary presentation a pack-marked declared return type
    // asks for reaches a call through the operator spelling too. The
    // operator resolves against the tuple-in formals; the call of the
    // operator itself re-presents the result as the function of the
    // bound tuple, evaluated once.

    builds: int;

    >~[T.., B, C](f: T.. -> B, g: (B) -> C) -> T.. -> C is
        builds = builds + 1;
        return v => g(f(v));
    si

    add(a: int, b: int) -> int => a + b;

    show(n: int) -> string => "[{n}]";

    entry() is
        let tagged = add >~ show;

        write_line(tagged(2, 3));
        write_line(tagged(30, 4));
        write_line("builds={builds}");
    si
si
