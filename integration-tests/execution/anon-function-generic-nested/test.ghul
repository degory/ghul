use IO.Std.write_line;

// A lambda written inside another lambda, in a generic function, reaching the
// function's type parameter. The inner literal's body is emitted into a frame
// class, where the parameter is one of the frame's own rather than the
// function's, so every reference to it has to be translated - both to a
// class-level position and to the frame's index for it, which is not
// necessarily the index it was declared at.

entry() is
    write_line("nested: {nested[int](7)(1)(2)}");
    write_line("nested_string: {nested[string]("seven")(1)(2)}");

    // The captured parameter is the second of two, so its index on the frame
    // differs from its index on the function. A translation that fixed only
    // the class-versus-method distinction and kept the declared index would
    // pass the case above and fail this one.
    write_line("skewed: {skewed[bool, int](true, 7)(1)(2)}");

    write_line("two_captured: {two_captured[int, string](7, "x")(1)}");

    // The shape this was found through: the recursive type needed to give the
    // Y combinator's self-application a type in a language without one.
    write_line("y: {y(recurse => n => if n <= 1 then 1 else n * recurse(n - 1) fi)(10)}");
si

nested[A](x: A) -> (int -> (int -> A)) =>
    (i: int) => (j: int) => x;

skewed[X, A](d: X, x: A) -> (int -> (int -> A)) =>
    (i: int) => (j: int) => x;

two_captured[A, B](a: A, b: B) -> (int -> string) =>
    (i: int) => "{a}/{b}";

class SELF_APPLY is
    _f: (SELF_APPLY) -> (int -> int);

    init(f: (SELF_APPLY) -> (int -> int)) is
        _f = f;
    si

    apply(r: SELF_APPLY) -> (int -> int) => _f(r);
si

y(f: (int -> int) -> (int -> int)) -> (int -> int) is
    let wrap = SELF_APPLY((r: SELF_APPLY) => (a: int) => f(r.apply(r))(a));

    return wrap.apply(wrap);
si
