// A trait restating a member it inherits is the same slot as the member
// it restates, so a call through either trait reaches the implementation.
// So does a call through either of two traits a third trait inherits a
// member of the same shape from.
use IO.Std.write_line

trait Closer is
    close() -> string
si

trait Stream: Closer is
    close() -> string
    read() -> int
si

class FILE: Stream is
    init() is si

    close() -> string => "closed"
    read() -> int => 42
si

trait Adds is
    add(x: int, y: int) -> int
si

trait AlsoAdds is
    add(x: int, y: int) -> int
si

trait Both: Adds, AlsoAdds is
si

class SUM: Both is
    init() is si

    add(x: int, y: int) -> int => x + y
si

entry() is
    let file = FILE()
    let as_stream: Stream = file
    let as_closer: Closer = file

    write_line("stream {as_stream.close()} {as_stream.read()}")
    write_line("closer {as_closer.close()}")

    let sum = SUM()
    let adds: Adds = sum
    let also: AlsoAdds = sum
    let both: Both = sum

    write_line("adds {adds.add(1, 2)} also {also.add(3, 4)} both {both.add(5, 6)}")
si
