namespace Test is
    use IO.Std.write_line;
    use System.IParsable;

    // A static virtual/abstract interface member (.NET's generic-math
    // feature) reached through a bound type parameter needs the CLR's
    // `constrained.` call shape and a CLR-visible constraint clause on
    // the generic parameter itself - both are otherwise easy to omit
    // since most generic code never needs them.
    parse_via_bound[T: IParsable[T]](s: string) -> T =>
        T.parse(s, null);

    entry() is
        write_line("{parse_via_bound[int]("42")}");
        write_line("{parse_via_bound[double]("1.5")}");
    si
si
