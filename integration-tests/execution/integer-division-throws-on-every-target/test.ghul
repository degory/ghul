use IO.Std.write_line

// An integer division or remainder by zero throws DivideByZeroException, and
// a signed 32- or 64-bit one of the least value by -1 throws
// OverflowException, where a program can catch either.

divide(a: int, b: int) -> int => a / b
remainder(a: int, b: int) -> int => a % b
divide_long(a: long, b: long) -> long => a / b
remainder_long(a: long, b: long) -> long => a % b
divide_unsigned(a: uint, b: uint) -> uint => a / b
divide_byte(a: byte, b: byte) -> byte => a / b

attempt(name: string, operation: () -> void) is
    try
        operation()
        write_line("{name}: no exception")
    catch e: Ghul.DivideByZeroException
        write_line("{name}: divide by zero: {e.message}")
    catch e: Ghul.OverflowException
        write_line("{name}: overflow: {e.message}")
    yrt
si

attempt("int divide", () is divide(1, 0) si)
attempt("int remainder", () is remainder(1, 0) si)
attempt("long divide", () is divide_long(1L, 0L) si)
attempt("long remainder", () is remainder_long(1L, 0L) si)
attempt("uint divide", () is divide_unsigned(1u, 0u) si)
attempt("byte divide", () is divide_byte(1b, 0b) si)

attempt("int least / -1", () is divide(-2147483647 - 1, -1) si)
attempt("int least % -1", () is remainder(-2147483647 - 1, -1) si)
attempt("long least / -1", () is divide_long(-9223372036854775807L - 1L, -1L) si)
attempt("long least % -1", () is remainder_long(-9223372036854775807L - 1L, -1L) si)

write_line("byte least / -1: {divide_byte(cast byte(-128), cast byte(-1))}")
write_line("ordinary: {divide(7, 2)} {remainder(-7, 2)} {divide_long(9L, -3L)} {divide_unsigned(4000000000u, 2u)}")
