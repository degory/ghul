use default

// A deferred-init local assigned the result of a function whose
// parameter type is inferred from its use keeps that result's type when
// it is later compared: `=~` and `!~` say nothing about whether their
// operands are optional, so the comparison does not widen it. A presence
// test on it is reported as a test of a never-optional value, not as a
// redundant test of a narrowed optional one.
compared() is
    let f = s => s.to_upper()
    let v mut
    v = f("a")
    let different = v !~ "hello"
    let same = v =~ "A"
    write_line("compared {v} {different} {same} {v?}")
si

optional_still_optional(s: string?) is
    let v mut
    v = s
    write_line("optional {v =~ "x"} {v ?? "none"}")
si

compared()
optional_still_optional(null)
optional_still_optional("x")
