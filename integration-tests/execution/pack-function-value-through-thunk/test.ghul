use IO.Std.write_line
use Ghul.Pipes

// Tests: a function that is not a literal written at the call - a stored
// function value, the result of a call, a named function - going into a
// formal that takes an argument pack as one tuple. The operand is
// evaluated once where it stands however often the function is called,
// at arities up to the widest tuple, through a call whose own return is
// pack-marked, and in a chain consumed by `for`.

add(a: int, b: int) -> int => a + b

make(k: int) -> (int, int) -> int is
    write_line("make runs once")

    return (a, b) => a * b + k
si

once[T.., U](f: T.. -> U) -> T.. -> U => v => f(v)

entry() is
    let pairs = [(1, 2), (3, 4)]

    let stored = (a: int, b: int) => a - b

    write_line("{pairs |> map(stored)}")
    write_line("{pairs |> map(make(100))}")
    write_line("{pairs |> map(add)}")

    for x in pairs |> map(stored) |> filter(v => v < 0) do
        write_line("{x}")
    od

    let wide = (a: int, b: int, c: int, d: int, e: int, f: int, g: int) -> int =>
        a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000

    let presented = wide |> once()

    write_line("{presented(1, 2, 3, 4, 5, 6, 7)}")
si
