use IO.Std.write_line;

entry() is
    test_explicit_conversion_to_struct();
    test_implicit_conversion_from_struct();
    test_optional_conversion_present();
    test_optional_conversion_from_wider_struct();
    test_decimal_char_conversion();
    test_optional_conversion_absent_on_overflow();
si

// System.Half declares no op_Implicit(float), only
// `explicit operator Half(float)` - narrowing a wider float loses
// precision, so `cast` has to fall back to the explicit operator.
test_explicit_conversion_to_struct() is
    let h = cast System.Half(1.5);
    write_line("{h}");
si

// The reverse direction - Half to float - is a widening conversion,
// so System.Half declares it `implicit`.
test_implicit_conversion_from_struct() is
    let h = cast System.Half(2.25);
    let back = cast single(h);
    write_line("{back}");
si

// `cast T?(...)` reaches the same operator and just wraps the
// result; a conversion that succeeds still reports present.
test_optional_conversion_present() is
    let h = cast System.Half?(3.5);
    write_line("{h?} {h}");
si

// System.Int128 declares `implicit operator Int128(int)`.
test_optional_conversion_from_wider_struct() is
    let i = cast System.Int128?(123);
    write_line("{i?} {i}");
si

// System.Decimal declares both directions against char - not covered
// by the compiler's own fast-path decimal-conversion table, which
// only knows the built-in scalars, but still reachable through the
// general user-defined-conversion lookup.
test_decimal_char_conversion() is
    let c = cast char(12.34m);
    write_line("{cast int(c)}");

    let d = cast decimal('a');
    write_line("{d}");
si

// System.Decimal's op_Explicit to char throws OverflowException for
// a value outside char's range - `cast char?(...)` must catch that
// and report absent rather than let it propagate.
test_optional_conversion_absent_on_overflow() is
    let out_of_range = cast char?(123456.0m);
    write_line("{out_of_range?}");

    let in_range = cast char?(65.0m);
    write_line("{in_range?} {in_range}");
si
