namespace Runner is
    use IO.Std.write_line

    // The file of top-level statements beside this one is compiled as a
    // submission named `demo`: its definitions are in a namespace of that
    // name, and its entry hands back the value of its final expression.
    entry() is
        let result = demo.entry(System.Array.empty[string](), Ghul.ENVIRONMENT.instance)

        write_line("the submission returned {result}")
        write_line("and declared count as {demo.count}, double as {demo.double(4)}")
    si
si
