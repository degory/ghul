use IO.Std.write_line;

use System.Half;
use System.Int128;
use System.DateTime;
use System.TimeSpan;

// A static operator declared on a type is a candidate wherever one of
// its values is an operand, from anywhere the type is visible.
class VECTOR is
    x: int;
    y: int;

    init(x: int, y: int) is
        self.x = x;
        self.y = y;
    si

    +(a: VECTOR, b: VECTOR) -> VECTOR static => VECTOR(a.x + b.x, a.y + b.y);
    *(a: VECTOR, k: int) -> VECTOR static => VECTOR(a.x * k, a.y * k);
    *(k: int, a: VECTOR) -> VECTOR static => VECTOR(a.x * k, a.y * k);
    -(a: VECTOR) -> VECTOR static => VECTOR(-a.x, -a.y);

    to_string() -> string => "({x}, {y})";
si

class OTHER is
    init() is si

    describe() -> string is
        let v = VECTOR(1, 2);

        return "{v + v} {v * 3} {3 * v} {-v}";
    si
si

entry() is
    let two = Int128.one + Int128.one;
    let four = two * two;

    write_line("{two} {four - Int128.one} {-four} {four / two % two} {four << 3}");
    write_line("{Half.one + Half.one}");

    let start = DateTime(2020, 1, 1);
    let step = TimeSpan.from_seconds(90.0D);

    write_line("{start + step} {(start + step) - start} {step * 2.0D} {2.0D * step} {-step}");

    // The scalar operators are still the intrinsics: decimal declares its
    // own `op_Addition`, and the intrinsic is the one that answers.
    write_line("{1.5m + 2.5m} {3 + 4} {7 % 3} {-7} {1 << 4}");

    write_line(OTHER().describe());

    // A type's operator is a static member of it, an intrinsic included,
    // so it can be called through the type by its quoted name.
    write_line("{int.`+(123, 456)} {Int128.`*(two, two)} {VECTOR.`-(VECTOR(1, 1))}");
si
