namespace Test is
    use Std = IO.Std;

    use System.Runtime.CompilerServices.IAsyncStateMachine;
    use System.Runtime.CompilerServices.ICriticalNotifyCompletion;
    use System.Runtime.CompilerServices.INotifyCompletion;

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER[_]))
    class COROUTINE[T] is
        value: T public;
        completed: bool public;

        init() is si
    si

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER))
    class COROUTINE is
        completed: bool public;

        init() is si
    si

    // Parks its continuation on a queue the test drains.
    struct PAUSE: ICriticalNotifyCompletion is
        _queue: Collections.Queue[() -> void];

        init(queue: Collections.Queue[() -> void]) is _queue = queue; si

        get_awaiter() -> PAUSE => self;
        is_completed: bool => false;
        get_result() is si
        on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
        unsafe_on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
    si

    class COROUTINE_BUILDER[T] is
        _coroutine: COROUTINE[T]?;

        init() is si

        create() -> COROUTINE_BUILDER[T] static => COROUTINE_BUILDER[T]();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: COROUTINE[T] is
            if !_coroutine? then
                _coroutine = COROUTINE[T]();
            fi
            return _coroutine;
        si

        set_result(v: T) is
            task.value = v;
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("coroutine failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    class COROUTINE_BUILDER is
        _coroutine: COROUTINE?;

        init() is si

        create() -> COROUTINE_BUILDER static => COROUTINE_BUILDER();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: COROUTINE is
            if !_coroutine? then
                _coroutine = COROUTINE();
            fi
            return _coroutine;
        si

        set_result() is
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("coroutine failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    // An asynchronous function whose return type carries no result
    // completes when its body falls off the end, so there is no
    // value the definite-return check could find missing - for
    // Tasks.TASK and for a source-declared task-like alike. One that
    // does carry a result still warns.
    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(STRUCT_FRAME_BUILDER))
    struct STRUCT_FRAME is
        completed: bool public;

        init() is si
    si

    struct STRUCT_FRAME_BUILDER is
        _frame: STRUCT_FRAME field;

        init() is si

        create() -> STRUCT_FRAME_BUILDER static => STRUCT_FRAME_BUILDER();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: STRUCT_FRAME => _frame;

        set_result() is
            _frame.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("frame failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    // Two task-likes whose builders cannot be driven without a state
    // machine, so neither is completed at fall-through. PARTIAL_HANDLE's
    // builder is incomplete, and naming it in a return position while
    // handing back a value explicitly is an ordinary function that never
    // drives a builder at all. GENERIC_HANDLE carries no result but its
    // builder is generic, and only the state-machine lowering knows what
    // to instantiate it at - so a machine-less body still falls through
    // to the default handle and still warns definite-return.
    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(PARTIAL_BUILDER))
    class PARTIAL_HANDLE is
        init() is si
    si

    class PARTIAL_BUILDER is
        init() is si

        create() -> PARTIAL_BUILDER static => PARTIAL_BUILDER();

        task: PARTIAL_HANDLE => PARTIAL_HANDLE();
    si

    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(GENERIC_BUILDER[_]))
    class GENERIC_HANDLE is
        completed: bool public;

        init() is si
    si

    class GENERIC_BUILDER[T] is
        _handle: GENERIC_HANDLE?;

        init() is si

        create() -> GENERIC_BUILDER[T] static => GENERIC_BUILDER[T]();

        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next();
        si

        task: GENERIC_HANDLE is
            if !_handle? then
                _handle = GENERIC_HANDLE();
            fi
            return _handle;
        si

        set_result() is
            task.completed = true;
        si

        set_exception(e: System.Exception) is
            throw System.Exception("generic handle failed", e);
        si

        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.on_completed(state_machine.move_next);
        si

        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            awaiter.unsafe_on_completed(state_machine.move_next);
        si
    si

    class MAIN is
        tick(queue: Collections.Queue[() -> void]) -> COROUTINE static is
            await PAUSE(queue);
            Std.write_line("tick done");
        si

        task_tick() -> Tasks.TASK static is
            await Tasks.TASK.yield();
            Std.write_line("task tick done");
        si

        no_value(queue: Collections.Queue[() -> void]) -> COROUTINE[int] static is
            await PAUSE(queue);
        si

        // A body ending in a loop completes the same way - the loop is
        // a valueless tail, not a tail owing a value. task_loop_in_branch
        // awaits, so its state machine's builder completes it; the other
        // loop-tailed bodies are machine-less and take the appended
        // completing return, as does task_bare_return with no loop at all.
        task_tail_loop() -> Tasks.TASK static is
            for _ in 1..2 do
                Std.write_line("task loop tick");
            od
        si

        task_loop_in_branch(n: int) -> Tasks.TASK static is
            if n > 0 then
                await Tasks.TASK.yield();
                Std.write_line("branch awaited");
            else
                for _ in 1..2 do
                    Std.write_line("task branch tick");
                od
            fi
        si

        task_loop_no_await(n: int) -> Tasks.TASK static is
            if n > 0 then
                Std.write_line("no-await branch taken");
            else
                for _ in 1..2 do
                    Std.write_line("task no-await tick");
                od
            fi
        si

        task_bare_return() -> Tasks.TASK static is
            Std.write_line("bare return body");
            return;
        si

        // An empty body, and one whose tail is a `try`, complete the
        // same way - every fall-through shape does, not only those
        // whose tail could stand as a value.
        task_empty_body() -> Tasks.TASK static is si

        task_try_tail() -> Tasks.TASK static is
            try
                Std.write_line("try tick");
            catch e: System.Exception
                Std.write_line("caught");
            yrt
        si

        coroutine_loop_tail(queue: Collections.Queue[() -> void]) -> COROUTINE static is
            await PAUSE(queue);
            for _ in 1..2 do
                Std.write_line("coroutine loop tick");
            od
        si

        entry() static is
            let queue = Collections.Queue[() -> void]();

            let t = tick(queue);
            let n = no_value(queue);

            while queue.count > 0 do
                queue.dequeue()();
            od

            task_tick().wait();

            task_tail_loop().wait();
            task_loop_in_branch(0).wait();
            task_loop_in_branch(1).wait();
            task_loop_no_await(0).wait();
            task_bare_return().wait();
            task_empty_body().wait();
            task_try_tail().wait();

            let c = coroutine_loop_tail(queue);
            while queue.count > 0 do
                queue.dequeue()();
            od

            Std.write_line("completed: {t.completed} {n.completed} {c.completed} value={n.value}");

            let d = coroutine_no_await();
            let e = coroutine_no_await_bare();
            Std.write_line("no-await completed: {d.completed} {e.completed} {frame_no_await().completed}");

            let _ = make_partial();
            let _ = generic_no_await();
        si

        // An await-free body returning a result-less task-like other
        // than Task completes through its builder at fall-through, the
        // same way a Tasks.TASK one completes through completed_task -
        // the class builder here, the struct builder of STRUCT_FRAME
        // below.
        coroutine_no_await() -> COROUTINE static is
            for _ in 1..2 do
                Std.write_line("coroutine no-await tick");
            od
        si

        coroutine_no_await_bare() -> COROUTINE static is
            Std.write_line("coroutine bare return");
            return;
        si

        // Falls through to the default handle: the completion would
        // have to instantiate GENERIC_BUILDER, and the warning below is
        // what says so.
        generic_no_await() -> GENERIC_HANDLE static is
            for _ in 1..2 do
                Std.write_line("generic tick");
            od
        si

        make_partial() -> PARTIAL_HANDLE static is
            return PARTIAL_HANDLE();
        si

        frame_no_await() -> STRUCT_FRAME static is
            for _ in 1..2 do
                Std.write_line("frame no-await tick");
            od
        si
    si
si
