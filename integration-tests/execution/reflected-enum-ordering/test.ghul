namespace Test is
    use Std = IO.Std;

    // An enum's `<>` operator is supplied per enum type, which means it
    // is supplied at both the places an enum symbol is built. This one
    // is imported rather than declared here, so it exercises the
    // reflected path; `issue-773-enum-ordering-operators` covers the
    // source path.

    class Main is
        entry() static is
            let monday = System.DayOfWeek.MONDAY;
            let friday = System.DayOfWeek.FRIDAY;

            Std.out.write_line("MONDAY < FRIDAY: {monday < friday}");
            Std.out.write_line("FRIDAY < MONDAY: {friday < monday}");
            Std.out.write_line("MONDAY >= MONDAY: {monday >= System.DayOfWeek.MONDAY}");
            Std.out.write_line("FRIDAY <= FRIDAY: {friday <= System.DayOfWeek.FRIDAY}");

            return;
        si
    si
si
