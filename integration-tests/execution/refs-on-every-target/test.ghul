use IO.Std.write_line

// A `ref` to a local and to an array element, written through by the
// callee, a try-pattern parse, and a struct's synthesised deconstruct.
struct PAIR(a: int public, b: int public)

bump(n: int ref) is
    n! = n! + 1
si

entry() is
    let x mut = 1
    bump(x ref)
    write_line("{x}")

    let numbers = [10, 20, 30]
    bump(numbers[1] ref)
    write_line("{numbers[1]}")

    let parsed mut = 0
    if int.try_parse("42", parsed ref) then write_line("{parsed}") fi

    let (a, b) = PAIR(3, 4)
    write_line("{a + b}")
si
