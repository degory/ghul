use IO.Std.write_line
use Ghul.Pipes

// A type test over a value-type optional - Nullable[T] for a value type,
// the MAYBE[T] an unconstrained T? lowers to for either kind of T - tests
// the payload, the same way a test over a reference optional does. The
// tested variable is then read at the narrowed type.

report(label: string, isa_result: bool, if_let_result: string, case_result: string, payload: string) is
    write_line("{label}: isa {isa_result}, if let {if_let_result}, case {case_result}, payload {payload}")
si

reference_optional(m: object?) is
    report(
        "object? holding a string",
        isa string(m),
        if let s: string = m then s else "no" fi,
        case m when s: string then s else "no" esac,
        cast string?(m) ?? "none")
si

nullable(m: int?) is
    report(
        "int? holding 5",
        isa string(m),
        if let s: string = m then s else "no" fi,
        case m when s: string then s else "no" esac,
        "{isa int(m)}")
si

maybe_of_reference() is
    let m = (cast object[](["abc"])) |> first()

    report(
        "MAYBE[object] holding a string",
        isa string(m),
        if let s: string = m then s else "no" fi,
        case m when s: string then s else "no" esac,
        cast string?(m) ?? "none")

    if isa string(m) then
        write_line("narrowed length {m.length}")
    fi
si

maybe_of_value() is
    let m = [5] |> first()

    report(
        "MAYBE[int] holding 5",
        isa string(m),
        if let s: string = m then s else "no" fi,
        case m when s: string then s else "no" esac,
        "{isa int(m)}")
si

absent_maybe() is
    let empty: object[] = []
    let m = empty |> first()

    report(
        "absent MAYBE[object]",
        isa string(m),
        if let s: string = m then s else "no" fi,
        case m when s: string then s else "no" esac,
        cast string?(m) ?? "none")
si

generic[T](m: T?) -> string =>
    "{isa string(m)} {if let s: string = m then s else "no" fi} {case m when s: string then s else "no" esac} {cast string?(m) ?? "none"}"

entry() is
    reference_optional("a")
    nullable(5)
    maybe_of_reference()
    maybe_of_value()
    absent_maybe()
    write_line("generic over object: {generic[object]("b")}")
    write_line("generic over int: {generic[int](7)}")
si
