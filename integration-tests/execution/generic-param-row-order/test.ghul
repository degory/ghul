namespace Test is
    use IO.Std;

    // A generic type's own type parameter is written to metadata after
    // its methods' parameters are, and GenericParam is sorted on an
    // owner coded over both TypeDef and MethodDef. A generic method
    // declared after another member therefore sorts ahead of the type
    // that owns it, and SRM rejects the assembly unless the rows are
    // ordered before they are written.
    //
    // The methods only have to exist for their rows to be emitted.
    class HOLDER[T] is
        init() is si

        wrap[U](other: U) -> string => "wrapped";

        label: string => "holder";
    si

    class PAIR[A, B] is
        init() is si

        first[X](x: X) -> string => "first";

        second[Y](y: Y) -> string => "second";
    si

    class Main is
        entry() static is
            Std.write_line("ok");
        si
    si
si
