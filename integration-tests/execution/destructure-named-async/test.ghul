namespace Test is
    use Std = IO.Std;

    class Main is
        double_async(x: int) -> Tasks.TASK[int] static is
            return x * 2;
        si

        combine((a, b): (int, int)) -> Tasks.TASK[int] static is
            let d = await double_async(a);
            return d + b;
        si

        sum_nested(((a, b), c): ((int, int), int)) -> Tasks.TASK[int] static is
            let d = await double_async(c);
            return a + b + d;
        si

        entry() static is
            Std.write_line("combine={combine((3, 4)).result}");
            Std.write_line("nested={sum_nested(((1, 2), 50)).result}");
        si
    si
si
