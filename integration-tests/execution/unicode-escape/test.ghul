namespace Test is
    use IO.Std;

    // \u takes exactly four hex digits, so it never consumes the text
    // that follows it - which matters because a-f are letters.
    entry() is
        Std.write_line("[\u0041]");
        Std.write_line("[\u20AC]");
        Std.write_line("[\u0041cat]");

        // Above the basic plane is a surrogate pair, which is what it
        // genuinely is: two char values.
        let grin = "\uD83D\uDE00";

        Std.write_line("{grin} {grin.length}");

        let letter = '\u0041';

        Std.write_line("{letter}");
    si
si
