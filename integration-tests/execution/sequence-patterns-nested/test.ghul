use default

f([(a, b), ..rest]: List[(int, string)]) -> string => "{a} {b} {rest.count}"
g(([x, ..xs], (p, [q, r])): (List[int], (int, List[int]))) -> string => "{x} {xs.count} {p} {q} {r}"

entry() is
    let pairs: List[(int, string)] = [(1, "a"), (2, "b"), (3, "c")]
    let [(n, s), ..more] = pairs
    write_line("{n} {s} {more.count}")

    let ([h, ..t], (u, [v, w])) = ([1, 2, 3], (4, [5, 6]))
    write_line("{h} {t.count} {u} {v} {w}")

    let nested: List[List[(int, int)]] = [[(1, 2), (3, 4)], [(5, 6)]]
    let [[(a, b), ..], [(c, d)]] = nested
    write_line("{a} {b} {c} {d}")

    if let [(1, y), ..] = pairs then write_line("hit") else write_line("miss") fi

    case ([1, 2], (3, "x"))
    when ([k, ..], (3, z)) then write_line("case {k} {z}")
    else write_line("none")
    esac

    for ([i, j], (m, [o])) in [([1, 2], (3, [4]))] do
        write_line("{i} {j} {m} {o}")
    od

    write_line(f(pairs))
    write_line(g(([7, 8, 9], (1, [2, 3]))))

    let aa mut = 0
    let bb mut = 0
    let cc mut = 0
    ([aa, ..], (bb, [cc])) = ([5, 6], (7, [8]))
    write_line("{aa} {bb} {cc}")
si
