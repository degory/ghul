namespace Test is
    use Std = IO.Std;

    // A cased character is read against the convention for its kind
    // in whatever script it is written in.
    class ТИП is
        поле: int;

        init(поле: int) is
            self.поле = поле;
        si

        Описание() -> int => поле;
    si

    // A script with no case says nothing about the convention, so a
    // name written entirely in one draws no warning whichever kind it
    // is declared as.
    class 型 is
        値: int;

        init(値: int) is
            self.値 = 値;
        si

        説明() -> int => 値;
    si

    trait Σχήμα is
        μέγεθος: int;
    si

    trait σχήμα is
        μέγεθος: int;
    si

    class Main is
        entry() static is
            let τιμή = ТИП(1);
            let Значение = 型(2);

            Std.write_line("{τιμή.Описание()} {Значение.説明()}");
        si
    si
si
