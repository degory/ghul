namespace Test is
    use IO.Std;

    // An enum member's initializer is any integer literal the lexer
    // accepts, so it can carry digit grouping, a radix prefix and a type
    // suffix. None of those reach the emitted value. In hex a trailing
    // `b` or `c` is a digit rather than a selector, so a suffix there
    // needs a backtick.
    enum Status is
        PLAIN = 200,
        SUFFIXED = 404l,
        GROUPED = 1_000,
        HEX = 0x1F4,
        HEX_GROUPED = 0x1_F4,
        HEX_TRAILING_NON_SUFFIX_DIGIT = 0xBEE,
        HEX_TRAILING_SELECTOR_IS_A_DIGIT = 0x1Fb,
        HEX_BACKTICK_SUFFIX = 0x1F`b,
    si

    class Main is
        entry() static is
            Std.write_line("{cast int(Status.PLAIN)}");
            Std.write_line("{cast int(Status.SUFFIXED)}");
            Std.write_line("{cast int(Status.GROUPED)}");
            Std.write_line("{cast int(Status.HEX)}");
            Std.write_line("{cast int(Status.HEX_GROUPED)}");
            Std.write_line("{cast int(Status.HEX_TRAILING_NON_SUFFIX_DIGIT)}");
            Std.write_line("{cast int(Status.HEX_TRAILING_SELECTOR_IS_A_DIGIT)}");
            Std.write_line("{cast int(Status.HEX_BACKTICK_SUFFIX)}");
        si
    si
si
