use IO.Std.write_line

bytes() -> ubyte[] => [1ub, 2ub]

pick(full: bool) -> ubyte[] is
    let chosen = if full then bytes() else [] fi

    return chosen
si

pick_case(full: bool) -> ubyte[] is
    let chosen =
        case full
        when true then bytes()
        else []
        esac

    chosen
si

first_empty(full: bool) -> string[] is
    let chosen = if full then [] elif !full then ["a"] else [] fi

    chosen
si

both_empty(full: bool) -> object[] => if full then [] else [] fi

write_line("{pick(true).count} {pick(false).count} {pick_case(true).count} {pick_case(false).count} {first_empty(true).count} {first_empty(false).count} {both_empty(true).count}")
write_line("{pick(false).get_type()} {first_empty(true).get_type()}")
