// `break` and `continue` in a `case` arm act on the enclosing loop. A
// case is not a loop: there is no fall-through between arms, so there
// is nothing in one to break out of, and an arm's jump past the arms
// below it is the case's own business.
namespace Test is
    use IO.Std.write_line

    class MAIN is
        entry() static is
            for x in [1, 2, 3, 4] do
                case x
                when 2 then
                    continue
                when 4 then
                    break
                else
                    write_line("body {x}")
                esac

                write_line("end of body {x}")
            od

            write_line("after for")

            let i mut = 0
            while i < 4 do
                i = i + 1

                case i
                when 2 then
                    continue
                when 4 then
                    break
                else
                    write_line("while {i}")
                esac

                write_line("end of while body {i}")
            od

            write_line("after while")
        si
    si
si
