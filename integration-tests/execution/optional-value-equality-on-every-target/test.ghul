use IO.Std.write_line

same[T](a: T, b: T) -> bool => a =~ b

entry() is
    let present: (n: int, s: string)? = (n = 1, s = "a")
    let equal: (n: int, s: string)? = (n = 1, s = "a")
    let other: (n: int, s: string)? = (n = 2, s = "a")
    let absent: (n: int, s: string)? = null

    write_line("{same(present, equal)} {same(present, other)} {same(present, absent)} {same(absent, absent)}")

    let x: int? = 3
    let y: int? = null

    write_line("{same(x, x)} {same(x, y)} {same(y, y)}")
si
