namespace Test is
    use IO.Std;

    // Tests: the `..` marker on a class or method type parameter. The
    // adaptation is per slot, so one pack serves both a handler slot and
    // the value slot that feeds it, and a captured local survives the
    // wrapping.

    class EVENT[T..] is
        _handlers: Collections.LIST[T -> void];

        init() is
            _handlers = Collections.LIST[T -> void]();
        si

        subscribe(handler: T -> void) is
            _handlers.add(handler);
        si

        raise(v: T) is
            for h in _handlers do
                h(v);
            od
        si
    si

    class SCALE is
        _factor: int;

        init(factor: int) is
            _factor = factor;
        si

        combine[T.., U](f: T -> U, v: T) -> U => f(v);

        factor: int => _factor;
    si

    class Main is
        entry() static is
            let e = EVENT[(int, string)]();

            e.subscribe((n, s) => Std.write_line("got {n} {s}"));
            e.raise((7, "seven"));

            let scale = SCALE(5);

            Std.write_line("{scale.combine((x, y) => x * y + scale.factor, (3, 4))}");
            return;
        si
    si
si
