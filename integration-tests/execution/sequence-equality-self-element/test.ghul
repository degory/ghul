use IO.Std.write_line;
use Collections;

// A node is a list of its own children, so it is a sequence whose
// element type is itself. Comparing two of them has to settle on
// something rather than chase that for ever.
class NODE: List[NODE] is
    _children: LIST[NODE];

    init() is
        _children = LIST[NODE]();
    si

    add(child: NODE) is
        _children.add(child);
    si

    count: int => _children.count;

    [index: int]: NODE => _children[index];

    iterator: Iterator[NODE] => _children.iterator;
si

entry() is
    let a = NODE();
    let b = NODE();

    write_line("distinct leaves: {a =~ b}");
    write_line("same leaf: {a =~ a}");

    let parent = NODE();
    parent.add(a);

    write_line("parent and leaf: {parent =~ a}");
si
