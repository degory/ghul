namespace Test is
    use Std = IO.Std;

    class Main is
        run() -> Tasks.TASK static is
            let total mut = 1;

            let body = () is
                total = total + 1;

                await Tasks.TASK.yield();

                total = total + 1;
            si;

            await body();

            Std.write_line("total {total}");
        si

        entry() static is
            run().wait();
        si
    si
si
