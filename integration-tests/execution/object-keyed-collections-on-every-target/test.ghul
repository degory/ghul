use IO.Std.write_line

// A set or map whose element or key type is object finds an equal value, not
// only the same one: a boxed scalar, a string and an object whose class
// overrides equals each compare as their own type says, as on .NET.

class POINT(x: int public, y: int public) is
    equals(other: object?) -> bool =>
        if let p: POINT = other then p.x == x /\ p.y == y else false fi

    get_hash_code() -> int => x * 31 + y
si

boxed(o: object) -> object => o

text(s: string) -> object => "{s}"

let seen = Collections.SET[object]()

seen.add(boxed(1))
seen.add(boxed(2.5))
seen.add(text("one"))
seen.add(POINT(1, 2))

write_line("set: {seen.contains(boxed(1))} {seen.contains(boxed(2.5))} {seen.contains(text("one"))} {seen.contains(POINT(1, 2))}")
write_line("set misses: {seen.contains(boxed(2))} {seen.contains(boxed(1L))} {seen.contains(text("two"))} {seen.contains(POINT(2, 1))}")

let names = Collections.MAP[object, string]()

names[boxed(1)] = "int one"
names[text("one")] = "string one"
names[POINT(1, 2)] = "point"

write_line("map: {names[boxed(1)]} {names[text("one")]} {names[POINT(1, 2)]} {names.contains_key(boxed('1'))}")
