// Same program as `non-nullable-by-default`, but the build sets
// `--no-warn-non-optional` — so none of the patterns flagged in the
// comments below produce a diagnostic. The opt-out test.

use IO.Std.write_line;

class BOX is
    label: string;

    init(label: string) is
        self.label = label;
    si
si

// opaque to flow narrowing — a direct literal assignment would let
// the compiler prove `!` redundant below
present_box() -> BOX? => BOX("present");

entry() is
    // the default value of a non-optional reference type is absent,
    // which the type says it never is — warns at the `_`
    let a: BOX = _;

    // an optional target takes the default cleanly — no warning
    let maybe: BOX? = _;

    // a `BOX?` the flow analysis has proven present — no warning
    if maybe? then
        let proven: BOX = maybe;
    fi

    // explicit `!` unwrap takes responsibility — no warning. `!`
    // enforces presence at runtime, so the operand has to hold a
    // value.
    let unwrapped: BOX = present_box()!;

    write_line("ok");
si
