namespace Test is
    use IO.Std.write_line;

    // Tests: a generic function or method named with explicit type
    // arguments, in value position rather than as a call target,
    // becomes a function value at that instantiation.

    identity[T](x: T) -> T => x;

    pick[T](a: T, b: T) -> T => a;
    pick[T](a: T) -> T => a;

    class BOX is
        init() is si

        echo[T](x: T) -> T => x;
        shout[T](x: T) -> T static => x;
    si

    class Main is
        entry() static is
            let f = identity[int];
            write_line("{f(1)}");

            let g: (string) -> string = identity[string];
            write_line("{g("two")}");

            // The expected type picks the group member, exactly as it
            // does for an overloaded non-generic reference.
            let two_arg: (int, int) -> int = pick[int];
            let one_arg: (int) -> int = pick[int];
            write_line("{two_arg(3, 4)} {one_arg(5)}");

            let b = BOX();
            let instance = b.echo[int];
            let static_member = BOX.shout[int];
            write_line("{instance(6)} {static_member(7)}");

            // The call-target form is unaffected.
            write_line("{identity[int](8)}");
        si
    si
si
