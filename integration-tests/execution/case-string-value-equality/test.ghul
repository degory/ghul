namespace Test is
    use IO.Std.write_line;

    // A single `when` label, matched against a string that is
    // value-equal but not the same instance as the literal.
    classify_single(s: string) -> string is
        case s
        when "add" then return "matched add";
        else return "fell through";
        esac
    si

    // Several labels on one arm, matched the same way.
    classify_multi(s: string) -> string is
        case s
        when "add", "plus" then return "matched add-or-plus";
        else return "fell through";
        esac
    si

    class OWN_EQUATABLE: Ghul.Equatable[OWN_EQUATABLE] is
        n: int;

        init(n: int) is self.n = n; si

        =~(other: OWN_EQUATABLE) -> bool => n == other.n;
        get_hash_code() -> int => n;
    si

    // A user-declared class with `=~` also gets value-equality in a
    // `case`, not just built-in strings.
    classify_own(v: OWN_EQUATABLE) -> string is
        case v
        when OWN_EQUATABLE(1) then return "one";
        else return "other";
        esac
    si

    // An optional scrutinee is not resolved against `=~`/`<>` at all
    // (see CASE_MATCH_OPERAND_RESOLVER): `when null` is a presence
    // test, but a present optional still matches its other labels by
    // reference, unlike the non-optional `classify_single` above.
    // Pinned deliberately - see GHUL.md's `case` section.
    classify_optional(s: string?) -> string is
        case s
        when null then return "none";
        when "add" then return "matched add";
        else return "fell through";
        esac
    si

    entry() is
        let interned = "add";
        let computed = "{"ad"}d";
        let computed_plus = "{"pl"}us";

        write_line(classify_single(interned));
        write_line(classify_single(computed));
        write_line(classify_single("nope"));

        write_line(classify_multi(computed_plus));
        write_line(classify_multi("nope"));

        write_line(classify_own(OWN_EQUATABLE(1)));
        write_line(classify_own(OWN_EQUATABLE(2)));

        let optional_interned: string? = "add";
        let optional_computed: string? = "{"ad"}d";

        write_line(classify_optional(null));
        write_line(classify_optional(optional_interned));
        write_line(classify_optional(optional_computed));
    si
si
