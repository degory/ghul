use default

// A function literal stored in a local, with its parameter types left to
// be inferred, passed by name to a spread formal whose pack the other
// arguments pin: its parameters take the pack's element types.
pack_apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)

pack_each[T..](source: Iterable[T], action: T.. -> void) is
    for element in source do
        action(element)
    od
si

pack_map[T.., U](source: Iterable[T], mapper: T.. -> U) -> LIST[U] is
    let result = LIST[U]()

    for element in source do
        result.add(mapper(element))
    od

    return result
si

let add = (a, b) => a + b
write_line("{pack_apply(add, 1, 2)}")

let describe = (name, count) => "{name}: {count}"
write_line(pack_apply(describe, "cats", 3))

scale(factor: int) -> int is
    let multiply = (x, y, z) => x * y * z
    return pack_apply(multiply, factor, 2, 3)
si

write_line("{scale(7)}")

let pairs = [(1, 2), (3, 4)]

let show = (left, right) => write_line("{left}-{right}")
pack_each(pairs, show)

let sum = (left, right) => left + right
write_line("{pack_map(pairs, sum) |> map(s => "{s}") |> join(",")}")
