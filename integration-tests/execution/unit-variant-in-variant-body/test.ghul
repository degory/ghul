use IO.Std.write_line

union Tree[T] is
    EMPTY
    NODE(value: T, left: Tree[T], right: Tree[T])
si

use Tree.EMPTY

partial Tree.NODE is
    // A name looked up from inside a generic type's own body arrives
    // already specialized, so the unit-variant lowering has to see
    // through that wrapper to reach the interned value.
    empty_left() -> Tree[T] => EMPTY;
si

entry() is
    let node = Tree.NODE(1, Tree.EMPTY, Tree.EMPTY);

    write_line("{isa Tree.EMPTY(node.empty_left())}");
si
