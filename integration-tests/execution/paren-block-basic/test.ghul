use IO.Std.write_line;

entry() is
    // Side effect then tail value.
    let a = (write_line("a effect"); 40 + 2);
    write_line("a = {a}");

    // Assignment to a simple name as the first statement: the same
    // spelling as a named tuple element, disambiguated by the `;`.
    let acc mut = 0;
    let b = (acc = 123 * 2; acc + 1);
    write_line("b = {b}");

    // ... while the comma spelling stays a named tuple.
    let nt = (p = 123 * 2, q = 456 / 4);
    write_line("nt = {nt.p},{nt.q}");

    // Multiple let statements and an arithmetic tail.
    let c = (let y = 3; let z = 4; y * z);
    write_line("c = {c}");

    // A block nests inside a block.
    let d = ((let i = 1; i + 1); 5);
    write_line("d = {d}");

    // Loop accumulation, as val ... lav is used.
    let e = (
        let total mut = 0;
        for i in 1..5 do
            total = total + i;
        od;
        total
    );
    write_line("e = {e}");

    // A function literal with a statement body is an ordinary
    // element expression; its semicolons belong to the body.
    let f = (let g = (v: int) is write_line("g called"); return v * 2; si; g(21));
    write_line("f = {f}");

    // Ordinary parenthesised groups are untouched: tuples, lambda
    // formals, destructuring, precedence grouping.
    let t = (1, "two");
    write_line("t = {t.`0} {t.`1}");

    let add = (m: int, n: int) => m + n;
    write_line("add = {add(2, 3)}");

    let (d1, d2) = (7, 8);
    write_line("d1 d2 = {d1} {d2}");

    let grouped = (1 + 2) * 3;
    write_line("grouped = {grouped}");
si
