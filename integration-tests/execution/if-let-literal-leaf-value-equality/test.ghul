namespace Test is
    use Std = IO.Std;

    enum Colour is
        RED,
        GREEN,
    si

    class ROW is
        name: string public;
        n: int public;
        colour: Colour public;
        flag: bool public;
        letter: char public;
        maybe_name: string? public;
        maybe_n: int? public;

        init(
            name: string,
            n: int,
            colour: Colour,
            flag: bool,
            letter: char,
            maybe_name: string?,
            maybe_n: int?
        ) is
            self.name = name;
            self.n = n;
            self.colour = colour;
            self.flag = flag;
            self.letter = letter;
            self.maybe_name = maybe_name;
            self.maybe_n = maybe_n;
        si
    si

    class Main is
        entry() static is
            // Built at runtime, so it is a different object from the
            // interned literal the patterns below compare it against.
            let part = "ali";
            let built = "{part}ce";

            let matching = ROW(built, 7, Colour.GREEN, true, 'x', built, 7);
            let other = ROW("bob", 3, Colour.RED, false, 'y', null, null);

            for row in [matching, other] do
                Std.out.write_line(
                    "{if_let_string(row)} {case_string(row)} {optional_string(row)} "
                    "{optional_int(row)} {int_leaf(row)} {enum_leaf(row)} "
                    "{bool_leaf(row)} {char_leaf(row)} {null_leaf(row)}"
                );
            od
        si

        // A string leaf compares by value, so a name built at runtime
        // matches the content-equal literal.
        if_let_string(row: ROW) -> string static =>
            if let ("alice" = name, n = n) = row then "if-let:{n}" else "if-let:no" fi;

        // The same pattern in a `case` arm takes the same path.
        case_string(row: ROW) -> string static =>
            case row
            when ("alice" = name, n = n) then "case:{n}"
            else "case:no"
            esac;

        // An optional source position is tested null-safely: absent
        // never matches a present literal.
        optional_string(row: ROW) -> string static =>
            if let ("alice" = maybe_name) = row then "opt-string:yes" else "opt-string:no" fi;

        optional_int(row: ROW) -> string static =>
            if let (7 = maybe_n) = row then "opt-int:yes" else "opt-int:no" fi;

        int_leaf(row: ROW) -> string static =>
            if let (7 = n) = row then "int:yes" else "int:no" fi;

        enum_leaf(row: ROW) -> string static =>
            if let (Colour.GREEN = colour) = row then "enum:yes" else "enum:no" fi;

        bool_leaf(row: ROW) -> string static =>
            if let (true = flag) = row then "bool:yes" else "bool:no" fi;

        char_leaf(row: ROW) -> string static =>
            if let ('x' = letter) = row then "char:yes" else "char:no" fi;

        // A `null` leaf stays a presence test rather than a comparison.
        null_leaf(row: ROW) -> string static =>
            if let (null = maybe_name) = row then "null:yes" else "null:no" fi;
    si
si
