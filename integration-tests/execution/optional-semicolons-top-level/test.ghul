use IO.Std.write_line
use Ghul.Pipes

// a line-start `[` opens a statement rather than the `use`'s own
// type-argument list
[3, 4] |> each(n => write_line("{n}"))

let words = ["plough", "sword"]

words |> each(word => write_line(word))

let countdown = (n: int) rec is
    write_line("{n}")
    if n > 0 then
        let next = n - 1
        rec(next)
    fi
si

countdown(2)
