use IO.Std.write_line

// Tests: a literal of two parameters is tried against an overload that
// takes an argument pack and against one that takes a function of two
// parameters. The second is the more specific declaration and wins, so
// the literal is the function of two parameters it was written as, and
// nothing the rejected candidate pushed onto it survives.

pick[T.., U](f: T.. -> U, v: T) -> string => "pack {f(v)}"
pick(f: (int, int) -> int, v: (int, int)) -> string => "plain {f(v.`0, v.`1)}"

only[T.., U](f: T.. -> U, v: T) -> string => "pack {f(v)}"

entry() is
    write_line(pick((a, b) => a + b, (1, 2)))
    write_line(pick((a: int, b: int) => a * b, (3, 4)))
    write_line(only((a, b) => a + b, (1, 2)))
si
