namespace Test is
    use Std = IO.Std;

    enum Level is
        LOW,
        MID,
        HIGH
    si

    class Main is
        entry() static is
            let lo = Level.LOW;
            let hi = Level.HIGH;

            Std.out.write_line("LOW =~ LOW: {lo =~ lo}");
            Std.out.write_line("LOW =~ HIGH: {lo =~ hi}");
            Std.out.write_line("HIGH =~ LOW: {hi =~ lo}");
            Std.out.write_line("LOW !~ HIGH: {lo !~ hi}");
            Std.out.write_line("LOW !~ LOW: {lo !~ lo}");
            Std.out.write_line("LOW == LOW: {lo == lo}");
            Std.out.write_line("LOW != HIGH: {lo != hi}");

            if lo =~ lo then
                Std.out.write_line("equal");
            fi
            return;
        si
    si
si
