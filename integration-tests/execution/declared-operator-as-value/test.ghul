use default

struct V(v: int public) is
    +(a: V, b: V) -> V static => V(a.v + b.v)
si

⊕(a: int, b: int) -> int => a + b

class COUNT is
    init() is si

    twice(n: int) -> int static => n * 2
si

let vs = [V(1), V(2), V(3)]
let ns = [1, 2, 3, 4]

write_line("{(vs |> reduce(V(0), V.`+)).v}")
write_line("{ns |> reduce(0, `⊕)}")
write_line("{ns |> map(COUNT.twice) |> join(",")}")
