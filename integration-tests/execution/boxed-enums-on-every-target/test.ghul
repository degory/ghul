use IO.Std.write_line

// An enum value held as an object keeps its enum type: it reads as its
// member names, compares equal only to the same value of the same enum,
// hashes as its value does, and tests and reports as the enum.

enum Suit is
    HEARTS,
    SPADES
si

@Ghul.Flags()
enum Access is
    READ = 1,
    WRITE = 2
si

boxed(o: object) -> object => o

let suit = boxed(Suit.SPADES)
let access = boxed(Access.READ | Access.WRITE)

write_line("interpolated: {suit} {access}")
write_line("to_string: {suit.to_string()} {access.to_string()}")
write_line("equals: {suit.equals(boxed(Suit.SPADES))} {suit.equals(boxed(Suit.HEARTS))} {suit.equals(boxed(1))}")
write_line("isa: {isa Suit(suit)} {isa Access(suit)} {isa Access(access)} {isa int(suit)}")
write_line("get_type: {suit.get_type().name} {access.get_type().name}")
write_line("hash: {suit.get_hash_code() == 1} {access.get_hash_code() == 3}")
write_line("unboxed: {cast Suit(suit) == Suit.SPADES} {cast Access(access) & Access.WRITE == Access.WRITE}")
