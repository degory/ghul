use IO.Std.write_line

// `=~` over tuples element by element, a struct's synthesised equality, a
// NaN within a tuple, a class's own `=~` with absent values, and tuples of
// tuples, alike on every target.
struct POINT(x: int public, y: int public)

class THING(n: int) is
    =~(other: THING) -> bool => n == other.n
    get_hash_code() -> int => n
si

entry() is
    let a = ("x", 1)
    let b = ("{"x"}", 1)
    let c = ("x", 2)
    write_line("{a =~ b} {a =~ c}")
    write_line("{POINT(1, 2) =~ POINT(1, 2)} {POINT(1, 2) =~ POINT(2, 1)}")

    let nan = 0.0 / 0.0
    write_line("{(nan, 1) =~ (nan, 1)}")

    let t1: THING? = THING(3)
    let t2: THING? = THING(3)
    let t3: THING? = null
    write_line("{t1 =~ t2} {t1 =~ t3} {t3 =~ t3}")
    write_line("{((1, 'a'), "s") =~ ((1, 'a'), "s")}")
si
