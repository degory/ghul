use IO.Std.write_line
use Collections.MAP
use Collections.SET

// Keys that compare by their own =~, coarser than their fields: two NAMEs
// are equal whatever their case, and two CELLs whatever their tag.
class NAME: Ghul.Equatable[NAME] is
    text: string
    init(text: string) is self.text = text si
    =~(other: NAME) -> bool pure => text.to_lower() =~ other.text.to_lower()
    get_hash_code() -> int => text.to_lower().get_hash_code()
si

struct CELL(x: int public, tag: string public): Ghul.Equatable[CELL] is
    =~(other: CELL) -> bool pure => x == other.x
    get_hash_code() -> int => x
si

same[T: Ghul.Equatable[T]](a: T, b: T) -> bool => a =~ b

through(e: Ghul.Equatable[NAME], other: NAME) -> bool => e =~ other

entry() is
    let names = MAP[NAME, int]()
    names[NAME("Ada")] = 1
    names[NAME("ADA")] = 2
    write_line("{names.count} {names[NAME("ada")]} {names.contains_key(NAME("bob"))}")

    let cells = MAP[CELL, string]()
    cells[CELL(1, "first")] = "one"
    cells[CELL(1, "second")] = "uno"
    cells[CELL(2, "x")] = "two"
    write_line("{cells.count} {cells[CELL(1, "other")]} {cells[CELL(2, "")]}")

    let seen = SET[NAME]()
    write_line("{seen.add(NAME("x"))} {seen.add(NAME("X"))} {seen.count}")

    let cell_set = SET[CELL]()
    write_line("{cell_set.add(CELL(3, "a"))} {cell_set.add(CELL(3, "b"))} {cell_set.count}")

    write_line("{same(NAME("q"), NAME("Q"))} {same(CELL(5, "a"), CELL(5, "b"))} {same(CELL(5, "a"), CELL(6, "a"))}")
    write_line("{through(NAME("Zed"), NAME("zed"))} {through(NAME("Zed"), NAME("zoe"))}")
    write_line("{'a' <> 'b'} {3 <> 1} {false < true} {'b' > 'a'}")
si
