use IO.Std.write_line
use Collections.LIST
use Ghul.Pipes

// A generic construction whose type argument is only settled by
// later use, consumed straight by a terminal pipe combinator.
//
// The terminal takes the sequence itself, so its formal is a type
// variable of the combinator being resolved rather than a concrete
// type, and the element type has to reach the construction through
// that pairing. Consumers behind a lazy stage take a different route
// and do not stand in for this one.
entry() is
    let xs = LIST()

    xs.add(10)
    xs.add(20)
    xs.add(30)

    write_line("{xs |> join(",")}")
    write_line("{xs |> count()}")
    write_line("{xs |> first()}")
si
