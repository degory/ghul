namespace Test is
    use Std = IO.Std;

    // `ValueTask[T]` is a struct with its own awaiter type; nothing
    // about it is a `Task`.
    class Main is
        compute() -> Tasks.TASK[int] static is
            let a = await Tasks.ValueTask[int](40);
            await Tasks.ValueTask.completed_task;
            let b = await Tasks.ValueTask[int](Tasks.TASK.from_result(2));
            return a + b;
        si

        entry() static is
            Std.write_line("got={compute().result}");
        si
    si
si
