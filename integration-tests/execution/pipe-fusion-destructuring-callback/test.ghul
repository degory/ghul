namespace Test is
    use IO.Std;
    use Ghul.Pipes;

    // Tests: a combinator callback written with a destructure pattern
    // in a chain consumed directly by a `for`. The fused consumer
    // inlines a stage by declaring one enclosing-method local for the
    // formal, which a pattern's leaves are not, so such a stage keeps
    // its delegate and the leaves stay with the closure that owns them.

    class Main is
        entry() static is
            let pairs = [(1, 2), (3, 4)];
            let k = 10;

            let captured mut = 0;

            for s in pairs |> map(((a, b)) => a + b + k) do
                captured = captured + s;
            od

            Std.write_line("{captured}");

            let plain mut = 0;

            for s in pairs |> map(((a, b)) => a + b) do
                plain = plain + s;
            od

            Std.write_line("{plain}");

            for t in pairs |> filter(((a, b)) => a + b + k > 15) do
                Std.write_line("{t.`0}");
            od

            // A plain formal beside it still fuses.
            for w in pairs |> map(p => p.`0 + k) do
                Std.write_line("{w}");
            od

            return;
        si
    si
si
