namespace Test is
    use Std = IO.Std;

    // The inner literal reaches the method's type parameter through the
    // outer literal's captures, so its own captures are empty when its
    // machine is first asked what it carries.
    class BOX[T] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        run[U](extra: U) -> Tasks.TASK is
            let held = _value;
            let seen = Collections.LIST[string]();

            let outer = () is
                seen.add("{held}");

                let inner = () is
                    await Tasks.TASK.yield();

                    seen.add("{extra}");
                si;

                await inner();

                seen.add("{held} {extra}");
            si;

            await outer();

            Std.write_line("{seen.count} {seen[2]}");
        si
    si

    class Main is
        entry() static is
            BOX[int](7).run("x").wait();
        si
    si
si
