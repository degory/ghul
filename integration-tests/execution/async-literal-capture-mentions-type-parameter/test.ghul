namespace Test is
    use Std = IO.Std;

    class HOLDER is
        // The captured value's type names the parameter without being
        // it, so the machine has to read through the type rather than
        // match it.
        run[U](extra: U) -> Tasks.TASK static is
            let items = Collections.LIST[U]();

            let body = () is
                items.add(extra);

                await Tasks.TASK.yield();

                items.add(extra);
            si;

            await body();

            Std.write_line("{items.count} {items[1]}");
        si
    si

    class Main is
        entry() static is
            HOLDER.run(7).wait();
        si
    si
si
