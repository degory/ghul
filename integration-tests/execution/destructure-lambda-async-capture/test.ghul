namespace Test is
    use Std = IO.Std;

    class Main is
        double_async(x: int) -> Tasks.TASK[int] static is
            return x * 2;
        si

        entry() static is
            let f = ((a, b)) -> Tasks.TASK[int] is
                let scaled = () -> int => a * 100;
                let d = await double_async(a);
                let e = await double_async(b);
                return scaled() + d + e;
            si;

            Std.write_line("got={f((1, 2)).result}");
        si
    si
si
