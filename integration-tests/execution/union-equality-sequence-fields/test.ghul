use IO.Std.write_line;
use Collections;

// Defines an ordering and no equality: the synthesized comparison
// reads its `<>` against zero.
struct ORDERED is
    v: int;
    init(v: int) is self.v = v; si
    <>(other: ORDERED) -> int pure => v - other.v;
si

union Payload is
    ARRAY_FIELD(xs: int[]);
    LIST_FIELD(xs: LIST[int]);
    LIST_INTERFACE(xs: List[int]);
    NESTED(xs: int[][]);
    STRINGS(xs: LIST[string]);
    ORDER(o: ORDERED);
    OPTIONAL_ARRAY(xs: int[]?);
si

entry() is
    let a1: Payload = Payload.ARRAY_FIELD([1, 2, 3]);
    let a2: Payload = Payload.ARRAY_FIELD([1, 2, 3]);
    let a3: Payload = Payload.ARRAY_FIELD([1, 2, 4]);
    let a4: Payload = Payload.ARRAY_FIELD([1, 2]);

    write_line("array equal: {a1 =~ a2}");
    write_line("array differ: {a1 =~ a3}");
    write_line("array shorter: {a1 =~ a4}");

    let l1: Payload = Payload.LIST_FIELD(LIST[int]([1, 2]));
    let l2: Payload = Payload.LIST_FIELD(LIST[int]([1, 2]));
    let l3: Payload = Payload.LIST_FIELD(LIST[int]([2, 1]));

    write_line("list equal: {l1 =~ l2}");
    write_line("list reordered: {l1 =~ l3}");

    let i1: Payload = Payload.LIST_INTERFACE(LIST[int]([7]));
    let i2: Payload = Payload.LIST_INTERFACE([7]);

    write_line("list interface, list and array: {i1 =~ i2}");

    let n1: Payload = Payload.NESTED([[1, 2], [3]]);
    let n2: Payload = Payload.NESTED([[1, 2], [3]]);
    let n3: Payload = Payload.NESTED([[1, 2], [4]]);

    write_line("nested equal: {n1 =~ n2}");
    write_line("nested inner differs: {n1 =~ n3}");

    let s1: Payload = Payload.STRINGS(LIST[string](["a", "b"]));
    let s2: Payload = Payload.STRINGS(LIST[string](["{"a"}", "{"b"}"]));

    write_line("strings by value: {s1 =~ s2}");

    let o1: Payload = Payload.ORDER(ORDERED(5));
    let o2: Payload = Payload.ORDER(ORDERED(5));
    let o3: Payload = Payload.ORDER(ORDERED(6));

    write_line("order equal: {o1 =~ o2}");
    write_line("order differ: {o1 =~ o3}");

    let p1: Payload = Payload.OPTIONAL_ARRAY([1]);
    let p2: Payload = Payload.OPTIONAL_ARRAY([1]);
    let p3: Payload = Payload.OPTIONAL_ARRAY(null);
    let p4: Payload = Payload.OPTIONAL_ARRAY(null);

    write_line("optional array both present: {p1 =~ p2}");
    write_line("optional array both absent: {p3 =~ p4}");
    write_line("optional array one absent: {p1 =~ p3}");
si
