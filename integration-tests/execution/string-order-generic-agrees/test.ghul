use IO.Std.write_line
use Ghul.Pipes

// Tests: ordering strings through a Comparable[T] bound agrees with `<>`
// written on the strings themselves, and with sort(), min and max, all
// by code unit, on every target.

least[T: Ghul.Comparable[T]](values: T[]) -> T is
    let result mut = values[0]

    for v in values do
        if v < result then
            result = v
        fi
    od

    return result
si

insertion_sort[T: Ghul.Comparable[T]](values: T[]) -> Collections.LIST[T] is
    let sorted = Collections.LIST[T]()

    for v in values do
        let i mut = 0

        while i < sorted.count /\ sorted[i] <> v <= 0 do
            i = i + 1
        od

        sorted.insert(i, v)
    od

    return sorted
si

let words = ["banana", "Apple", "apple", "12 + 3", "12 - 3", "_under", "Zebra"]

write_line(insertion_sort(words) |> join(", "))
write_line(words |> sort() |> join(", "))
write_line(words |> sort((a, b) => a <> b) |> join(", "))
write_line("{least(words)} {(words |> min())!} {(words |> max())!}")
