namespace Test is
    use IO.Std.write_line

    read_resource(name: string) -> string is
        let assembly = System.Reflection.Assembly.get_executing_assembly()
        let stream = assembly.get_manifest_resource_stream(name)!
        let reader = IO.StreamReader(stream)

        return reader.read_to_end()
    si

    entry() is
        write_line(read_resource("greeting.txt"))
        write_line(read_resource("second.dat"))
    si
si
