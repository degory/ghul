namespace Test is
    use IO.Std;

    takes_seven(t: (int, int, int, int, int, int, int)) -> int static => t.`6;

    adds_sixteen(a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, a8: int, a9: int, a10: int, a11: int, a12: int, a13: int, a14: int, a15: int) -> int static
        => a0+a1+a2+a3+a4+a5+a6+a7+a8+a9+a10+a11+a12+a13+a14+a15;

    entry() static is
        let seven = (1, 2, 3, 4, 5, 6, 7);
        Std.write_line("{takes_seven(seven)}");

        let sixteen_literal = (a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, a8: int, a9: int, a10: int, a11: int, a12: int, a13: int, a14: int, a15: int) -> int
            => a0+a1+a2+a3+a4+a5+a6+a7+a8+a9+a10+a11+a12+a13+a14+a15;
        Std.write_line("{sixteen_literal(2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2)}");

        let sixteen_value = adds_sixteen;
        Std.write_line("{sixteen_value(2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2)}");
    si
si
