namespace Test is
    use IO.Std.write_line;

    // Tests: a function declared in the project wins against the same
    // name from the implicitly imported Ghul namespace, rather than
    // every call reporting both as candidates. The same holds for an
    // operator the project declares over imported operands.

    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    add(a: int, b: int) -> int => a + b;

    >>[A, B, C](f: A -> B, g: B -> C) -> A -> C => x => g(f(x));

    class Main is
        entry() static is
            write_line("{apply(add, 1, 2)}");

            let inc = (n: int) -> int => n + 1;
            write_line("{(inc >> inc)(1)}");
            return;
        si
    si
si
