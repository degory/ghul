namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;
    use Collections;

    // A named function passed where a combinator's pure formal is
    // expected, while the element type the formal is built from has
    // not settled. The formal's parameter names nothing at that
    // point, so the shape it offers refuses what the settled shape
    // accepts.
    class Main is
        label(n: int) -> string static => "<{n}>";

        // Written: the element type is settled before the reference
        // is built.
        written() static is
            let items = LIST[int]();

            for i in 0..3 do
                items.add(i);
            od

            Std.write_line(items |> take(2) |> map(label) |> join(" "));
        si

        // Inferred: it is not.
        inferred() static is
            let items = LIST();

            for i in 0..3 do
                items.add(i);
            od

            Std.write_line(items |> take(2) |> map(label) |> join(" "));
        si

        // Two chains reading the same local, which is the shape the
        // Rosetta task that found this has.
        two_chains() static is
            let items = LIST();

            for i in 0..4 do
                items.add(i);
            od

            Std.write_line(items |> take(2) |> map(label) |> join(" "));
            Std.write_line(items |> skip(2) |> map(label) |> join(" "));
        si

        entry() static is
            written();
            inferred();
            two_chains();
        si
    si
si
