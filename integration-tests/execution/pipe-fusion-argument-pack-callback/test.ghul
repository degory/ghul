namespace Test is
    use IO.Std;
    use Ghul.Pipes;

    // Tests: a combinator declaring an argument pack takes a callback
    // with one parameter per tuple element, and a chain built inline in
    // a `for` is the shape the fused consumer recognises. The callback
    // the fused stages would build on is the adapted one, so fusion has
    // to leave the chain alone until the call has adapted it.

    class Main is
        entry() static is
            let pairs = [(1, "a"), (2, "b")];

            for s in pairs |> map((n, t) => "{n}{t}") do
                Std.write_line(s);
            od

            for u in pairs |> filter((n, t) => n > 1) do
                Std.write_line("{u.`1}");
            od

            for v in pairs |> map((n, t) => "{t}{n}") |> filter(s => s !~ "a1") do
                Std.write_line(v);
            od

            // The single-parameter callback still fuses.
            for w in pairs |> map(p => p.`0 * 10) do
                Std.write_line("{w}");
            od

            return;
        si
    si
si
