use IO.Std.write_line;

class SUMMER is
    init() is si

    sum_to(n: int, acc: long) -> long is
        if n == 0 then
            return acc;
        fi

        return self.sum_to(n - 1, acc + cast long(n));
    si
si

entry() is
    let summer = SUMMER();

    write_line("{summer.sum_to(2_000_000, 0L)}");
si
