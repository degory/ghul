namespace Test is
    use Std = IO.Std;

    class Main is
        // An `=> body` that awaits: the value goes to the builder's
        // result, rather than being returned out of MoveNext.
        doubled() -> Tasks.TASK[int] static =>
            await Tasks.TASK.from_result(20) + 2;

        entry() static is
            Std.write_line("doubled={doubled().result}");
        si
    si
si
