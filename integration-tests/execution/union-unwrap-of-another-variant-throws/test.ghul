// `u!` on a union holding a variant other than its default throws where it
// is written, whether the default variant has one field, which `!` reads,
// or several, where `!` answers the variant itself. Neither unwrapped value
// is read afterwards, so the throw cannot come from using a null.
use IO.Std.write_line

union Result is
    OK(value: int) default;
    ERROR(message: string);
si

union Boxed is
    PAIR(a: int, b: int) default;
    EMPTY;
si

entry() is
    let bad: Result = Result.ERROR("oops")

    try
        let value = bad!
        write_line("one field: no exception")
    catch e: Ghul.InvalidCastException
        write_line("one field: threw at the unwrap")
    yrt

    let empty: Boxed = Boxed.EMPTY

    try
        let pair = empty!
        write_line("several fields: no exception")
    catch e: Ghul.InvalidCastException
        write_line("several fields: threw at the unwrap")
    yrt

    let good: Result = Result.OK(42)
    let full: Boxed = Boxed.PAIR(3, 4)

    write_line(good!.to_string())
    write_line(full!.b.to_string())
si
