namespace Test is
    use Std = IO.Std;

    class Main is
        // Statements before a try holding an await must not re-run
        // when MoveNext resumes: the re-entry dispatch routes control
        // straight into the try, past the prologue.

        // A loop that completes before the try must not run again.
        loop_before_try() -> Tasks.TASK[string] static is
            let out = System.Text.StringBuilder();

            for n in 1::2 do
                let _ = out.append("L{n}");
            od

            try
                await Tasks.TASK.yield();
                let _ = out.append("T");
            catch e: System.Exception
                let _ = out.append("E");
            yrt

            return out.to_string();
        si

        // A mutable local initialized before the try keeps its
        // mid-suspend value across the resume.
        let_before_try() -> Tasks.TASK[int] static is
            let x mut = 0;

            try
                await Tasks.TASK.yield();
                x = x + 1;
                await Tasks.TASK.yield();
                x = x + 1;
            catch e: System.Exception
                x = x - 100;
            yrt

            return x;
        si

        // An await inside a try before the loop and another inside a
        // try in the loop: both resume without side effects replayed.
        await_before_and_inside() -> Tasks.TASK[string] static is
            let out = System.Text.StringBuilder();

            try
                await Tasks.TASK.yield();
                let _ = out.append("pre");
            catch e: System.Exception
                let _ = out.append("E1");
            yrt

            for n in 1::2 do
                try
                    await Tasks.TASK.yield();
                    let _ = out.append("m{n}");
                catch e: System.Exception
                    let _ = out.append("E2");
                yrt
            od

            return out.to_string();
        si

        entry() static is
            Std.write_line("loop={loop_before_try().result}");
            Std.write_line("let={let_before_try().result}");
            Std.write_line("mixed={await_before_and_inside().result}");
        si
    si
si
