use IO.Std.write_line

// A floating-point value out of an integer type's range converts to the
// nearest value the type holds, and NaN converts to zero, as .NET does from
// .NET 9 on. A type narrower than 32 bits is reached through int, so the
// value saturates to int's range and is then truncated, as on .NET. The
// values come through a function so none is known before the program runs.

value(d: double) -> double => d

let huge = value(1.0e20)
let tiny = value(-1.0e20)
let nan = value(0.0) / value(0.0)

write_line("int: {int(huge)} {int(tiny)} {int(nan)} {int(value(-2.9))}")
write_line("long: {long(huge)} {long(tiny)} {long(nan)}")
write_line("uint: {uint(huge)} {uint(tiny)} {uint(value(-1.0))}")
write_line("ulong: {ulong(huge)} {ulong(tiny)}")
write_line("short: {short(huge)} {short(tiny)} {short(value(40000.0))}")
write_line("ubyte: {ubyte(huge)} {ubyte(value(-1.0))} {ubyte(value(300.0))}")
write_line("ushort: {ushort(value(-1.0))} {ushort(huge)} {int(char(value(-1.0)))}")
write_line("byte: {byte(value(200.0))} {byte(tiny)}")
write_line("from single: {int(single(huge))} {long(single(tiny))}")
