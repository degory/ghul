namespace Test is
    use IO.Std;
    use Collections;

    compare_descending(a: int, b: int) -> int => b - a;

    call_with_comparison(c: System.Comparison[int]) static is
        let xs = LIST[int]([3, 1, 2]);
        xs.sort(c);

        for x in xs do
            Std.write_line("{x}");
        od
    si

    class Main is
        entry() static is
            // A named function referred to directly, at a call site
            // whose formal is a real .NET delegate type - no lambda
            // wrapper and no explicit delegate construction needed.
            call_with_comparison(compare_descending);

            // The same, but the formal is one of several
            // arity-matching overloads (`Sort(Comparison[T])` and
            // `Sort(IComparer[T])`) - only the delegate-shaped one
            // accepts a bare function reference, which disambiguates
            // the call.
            let ys = LIST[int]([3, 1, 2]);
            ys.sort(compare_descending);

            for y in ys do
                Std.write_line("{y}");
            od

            return;
        si
    si
si
