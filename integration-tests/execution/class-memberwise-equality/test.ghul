use IO.Std.write_line;
use Collections;

// A class declaring neither operator compares by reference and has no
// `=~` at all, so one is synthesized over the members that hold its
// state - guarded on the runtime type, so that a base and a subclass
// never compare equal in either direction.

@equality()
class POINT is
    x: int;
    y: int;

    init(x: int, y: int) is
        self.x = x;
        self.y = y;
    si
si

// A subclass over a synthesized base joins the base's operator rather
// than opening a second: one virtual slot, comparing the whole value.
@equality()
class POINT_3D: POINT is
    z: int;

    init(x: int, y: int, z: int) is
        super.init(x, y);
        self.z = z;
    si
si

@equality()
class POINT_4D: POINT_3D is
    w: int;

    init(x: int, y: int, z: int, w: int) is
        super.init(x, y, z);
        self.w = w;
    si
si

// A property with a body is derived from the state rather than part
// of it, and a static member belongs to the type, so neither takes
// part.
@equality()
class COMPUTED is
    v: int;
    tag: int field;

    doubled: int => v * 2;

    count: int static;

    init(v: int, tag: int) is
        self.v = v;
        self.tag = tag;
    si
si

// A base that declares its own operator keeps it, and the subclass
// inherits that one rather than being given a second.
class NAMED is
    name: string;

    init(name: string) is self.name = name; si

    =~(other: NAMED) -> bool pure => name =~ other.name;
    get_hash_code() -> int => name.get_hash_code();
si

class TAGGED: NAMED is
    tag: int;

    init(name: string, tag: int) is
        super.init(name);
        self.tag = tag;
    si
si

@equality()
class BOX[T] is
    value: T;

    init(value: T) is self.value = value; si
si

entry() is
    write_line("equal: {POINT(1, 2) =~ POINT(1, 2)}");
    write_line("unequal: {POINT(1, 2) =~ POINT(1, 3)}");
    write_line("hash agrees: {POINT(1, 2).get_hash_code() == POINT(1, 2).get_hash_code()}");

    let base: POINT = POINT(1, 2);
    let derived: POINT = POINT_3D(1, 2, 3);

    write_line("base vs subclass: {base =~ derived}");
    write_line("subclass vs base: {derived =~ base}");
    write_line("subclass equal: {derived =~ cast POINT(POINT_3D(1, 2, 3))}");
    write_line("subclass differs deep: {derived =~ cast POINT(POINT_3D(1, 2, 4))}");
    write_line("subclass differs shallow: {derived =~ cast POINT(POINT_3D(9, 2, 3))}");

    let deep: POINT = POINT_4D(1, 2, 3, 4);

    write_line("three levels equal: {deep =~ cast POINT(POINT_4D(1, 2, 3, 4))}");
    write_line("three levels differ: {deep =~ cast POINT(POINT_4D(1, 2, 3, 5))}");
    write_line("three levels vs two: {deep =~ derived}");

    write_line("computed ignored: {COMPUTED(1, 2) =~ COMPUTED(1, 2)}");
    write_line("field counts: {COMPUTED(1, 2) =~ COMPUTED(1, 3)}");

    write_line("inherited operator: {cast NAMED(TAGGED("a", 1)) =~ cast NAMED(TAGGED("a", 2))}");

    write_line("generic equal: {BOX[int](3) =~ BOX[int](3)}");
    write_line("generic unequal: {BOX[int](3) =~ BOX[int](4)}");

    // The bridge is what makes .NET reach the operator, so an equal
    // value that is not the same object is found.
    let seen = SET[POINT]();
    let _ = seen.add(POINT_3D(1, 2, 3));

    write_line("found by value: {seen.contains(cast POINT(POINT_3D(1, 2, 3)))}");
    write_line("subclass not found as base: {seen.contains(POINT(1, 2))}");
si
