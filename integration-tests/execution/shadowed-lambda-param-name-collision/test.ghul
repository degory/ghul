namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let f = i => i * 2;

            // apply_twice's own parameter is named `f`, shadowing the
            // outer `f`, and is left unannotated so its type is only
            // known once the call site below resolves it.
            let apply_twice = (f, i) => f(f(i));

            Std.write_line("{apply_twice(f, 7)}");

            let triple = i => i * 3;
            let apply_twice_2 = (f, i) => f(f(i));

            Std.write_line("{apply_twice_2(triple, 7)}");
        si
    si
si
