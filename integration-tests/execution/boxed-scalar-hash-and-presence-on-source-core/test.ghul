use IO.Std.write_line

is_null[T](value: T) -> bool => !(cast object?(value))?

boxed_hash(value: object) -> int => value.get_hash_code()

entry() is
    write_line("{is_null(5)} {is_null('x')} {is_null(2.5)} {is_null[string?](null)} {is_null("text")}")
    write_line("{boxed_hash(cast byte(-1))} {boxed_hash(cast short(-2))} {boxed_hash(200ub)} {boxed_hash(-7)}")
si
