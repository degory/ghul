namespace Test is
    use Std = IO.Std;
    use Collections.LIST;

    class NUMBERS: Collections.Iterable[int] is
        init() is si

        iterator: Collections.Iterator[int] => LIST[int]([1, 2, 3]).iterator;
    si

    class DOUBLED: NUMBERS is
        init() is super.init(); si

        iterator: Collections.Iterator[int] => LIST[int]([2, 4, 6]).iterator;
    si

    struct PAIR: Collections.Iterable[int] is
        _a: int;

        init(a: int) is _a = a; si

        iterator: Collections.Iterator[int] => LIST[int]([_a, _a + 1]).iterator;
    si

    class BUCKET[T]: Collections.Iterable[T] is
        _items: LIST[T];

        init(items: LIST[T]) is _items = items; si

        iterator: Collections.Iterator[T] => _items.iterator;
    si

    class COUNTER: Collections.Iterator[int] is
        _at: int;

        init() is _at = 0; si

        move_next() -> bool is
            _at = _at + 1;

            return _at <= 2;
        si

        current: int => _at * 10;

        reset() is _at = 0; si

        dispose() is si
    si

    class Main is
        counting() -> Ghul.Pipes.Pipe[int] static is
            yield 7;
            yield 8;
        si

        // Reached by reflection because ghūl cannot name the legacy
        // interfaces, which is the whole reason the bridges exist.
        walk(what: string, subject: object) static is
            let enumerable = System.Type.get_type("System.Collections.IEnumerable")!
            let walker = enumerable.get_method("GetEnumerator")!.invoke(subject, []);

            if !walker? then
                Std.write_line("{what}: null enumerator");

                return;
            fi

            let enumerator = System.Type.get_type("System.Collections.IEnumerator")!
            let move_next = enumerator.get_method("MoveNext")!
            let current = enumerator.get_property("Current")!
            let seen = LIST[string]();

            while cast bool(move_next.invoke(walker, [])!) do
                seen.add("{current.get_value(walker, null)}");
            od

            Std.write_line("{what}: [{seen |> Ghul.Pipes.join(", ")}]");
        si

        entry() static is
            walk("class", NUMBERS());
            walk("subclass override", DOUBLED());
            walk("struct", PAIR(4));
            walk("generic at value type", BUCKET[int](LIST[int]([1, 2])));
            walk("generic at reference type", BUCKET[string](LIST[string](["a", "b"])));
            walk("generator", counting());

            let enumerator = System.Type.get_type("System.Collections.IEnumerator")!
            let counter = COUNTER();
            let _ = enumerator.get_method("MoveNext")!.invoke(counter, []);

            Std.write_line(
                "iterator current: {enumerator.get_property("Current")!.get_value(counter, null)}");
        si
    si
si
