// The pure-slot warning is reported against the argument that failed
// to satisfy the slot, not against the call it appears in. With two
// pure formals only the offending one is named, and a call spread over
// several lines is not underlined whole.

use Std = IO.Std;

_counter: int;

double(x: int) -> int pure => x * 2;

bump(x: int) -> int is
    _counter = _counter + x;

    return x;
si

both(f: (int) -> int pure, g: (int) -> int pure) -> int => f(1) + g(2);

after(a: int, f: (int) -> int pure, b: int) -> int => f(a) + b;

entry() is
    Std.write_line("{both(double, bump)}");
    Std.write_line("{both(bump, double)}");

    Std.write_line(
        "{
            after(
                10,
                bump,
                100
            )
        }"
    );

    Std.write_line("{_counter}");
si
