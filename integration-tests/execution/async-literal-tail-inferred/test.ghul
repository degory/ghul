namespace Test is
    use Std = IO.Std;

    class Main is
        // A literal that awaits, declares no return type and goes into
        // no slot naming a task, ending on a value tail rather than a
        // `return`. The tail is what settles the literal as returning
        // TASK[int] - nothing before the body is walked can say so.
        entry() static is
            let awaited = () is
                let v = await Tasks.TASK.from_result(20);
                v + 2
            si;

            Std.write_line("awaited={awaited().result}");
        si
    si
si
