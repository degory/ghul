use Ghul.Pipes
use IO.Std.write_line

class ITEM(n: int)

// sort has an overload whose type parameter is bounded by Comparable and
// overloads taking a comparer; ITEM is not Comparable, so writing the type
// argument out has to leave the comparer overloads to choose from.
entry() is
    let items = [ITEM(2), ITEM(1), ITEM(3)]

    let inferred = items |> sort((x, y) => x.n - y.n)
    let written = items |> sort[ITEM]((x: ITEM, y: ITEM) -> int => x.n - y.n)

    write_line("{inferred |> map(i => i.n) |> join(", ")}")
    write_line("{written |> map(i => i.n) |> join(", ")}")
si
