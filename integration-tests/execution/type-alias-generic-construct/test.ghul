namespace Test is
    use IO.Std.write_line

    use Collections.MAP

    use StringMap[V] = MAP[string, V]
    use Counts = StringMap[int]
    use Grid[T] = MAP[int, MAP[int, T]]

    class BOX[T] is
        value: T

        init(value: T) is
            self.value = value
        si
    si

    use Box[T] = BOX[T]

    build[V](key: string, value: V) -> MAP[string, V] is
        let map = StringMap[V]()
        map[key] = value
        return map
    si

    entry() is
        let names = StringMap[int]()
        names["one"] = 1
        write_line("applied: {names["one"]}")

        let counts = Counts()
        counts["two"] = 2
        write_line("alias of an alias: {counts["two"]}")

        let grid = Grid[string]()
        grid[0] = MAP[int, string]()
        grid[0][1] = "cell"
        write_line("nested: {grid[0][1]}")

        write_line("partial: {build("three", 3)["three"]}")

        write_line("applied class: {Box[string]("hi").value}")
        write_line("inferred: {Box("inferred").value}")

        let slot: StringMap[bool] = _()
        slot["yes"] = true
        write_line("default slot: {slot["yes"]}")
    si
si
