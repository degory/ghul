namespace Test is
    use IO.Std.write_line

    // AssemblyMetadataAttribute takes a key and a value, so a value with no
    // comma matches no constructor. It is reported and left out, so reading
    // the assembly's attributes through ordinary reflection still works.
    entry() is
        let found mut = 0

        for attribute in System.Reflection.Assembly.get_executing_assembly().get_custom_attributes_data() do
            if attribute.attribute_type.name =~ "AssemblyMetadataAttribute" then
                found = found + 1
            fi
        od

        write_line("metadata attributes: {found}")
    si
si
