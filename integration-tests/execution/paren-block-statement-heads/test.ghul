use IO.Std.write_line;

class BOX is
    v: int public;
    init() is v = 0; si
si

entry() is
    // A statement-only token directly after `(` commits the block.
    let a = (let x = 10; x + 1);
    write_line("a = {a}");

    // `let ... in` keeps its existing parenthesised reading.
    let b = (let q = 5 in q * q);
    write_line("b = {b}");

    // `assert ... in` likewise.
    let c = (assert b > 0 else "positive" in b + 1);
    write_line("c = {c}");

    // An assert statement opens a block.
    let d = (assert b > 0; b - 1);
    write_line("d = {d}");

    // `try` has no expression form; return targets the block.
    let e = (try return 10 / 2; catch ex: System.Exception return 0; yrt);
    write_line("e = {e}");

    // A member assignment as the first statement.
    let box = BOX();
    let f = (box.v = 7; box.v * 2);
    write_line("f = {f}");

    // An if statement runs ahead of the tail; return exits the block.
    let g = (if f > 10 then return 100; fi; 1);
    write_line("g = {g}");

    // A compound statement followed by anything that cannot continue
    // its expression commits the block without needing a `;` — for,
    // if, case and while, each with the tail on its own line.
    let h = (
        for x in [1, 3, 4] do
            if x % 2 == 0 then
                return x;
            fi
        od
        0
    );
    write_line("h = {h}");

    let i = (
        if f > 10 then
            write_line("big");
        fi
        42
    );
    write_line("i = {i}");

    let j = (
        case f
        when 14 then
            write_line("fourteen");
        else
            write_line("other");
        esac
        43
    );
    write_line("j = {j}");

    let k mut = 0;
    let l = (
        while k < 3 do
            k = k + 1;
        od
        k
    );
    write_line("l = {l}");

    // The expression reading is unchanged when the tail could continue
    // the compound statement's expression: an operator-headed tail, a
    // postfix `!`, a tuple element, or the group closing right after.
    let m = (if true then 2 else 5 fi - 1);
    write_line("m = {m}");

    let n = (for x in [7] do break x od ?? 0);
    write_line("n = {n}");

    let o = (for x in [8] do break x od!);
    write_line("o = {o}");

    let p = (for x in [9] do break x od, 99);
    write_line("p = {p.`0 ?? 0} {p.`1}");

    let q = (if true then 6 else 7 fi);
    write_line("q = {q}");
si
