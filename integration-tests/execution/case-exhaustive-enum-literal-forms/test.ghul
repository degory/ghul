namespace Test is
    use IO.Std;

    // Exhaustiveness compares an arm's coverage against the enum's
    // members, and an arm is recorded from the resolved literal. A member
    // written with a type suffix, digit grouping or a radix prefix has to
    // compare equal to the arm that covers it.
    enum Status is
        PLAIN = 200,
        SUFFIXED = 404l,
        GROUPED = 1_000,
        HEX = 0x1F4,
    si

    describe(status: Status) -> string =>
        case status
        when Status.PLAIN then "plain"
        when Status.SUFFIXED then "suffixed"
        when Status.GROUPED then "grouped"
        when Status.HEX then "hex"
        esac;

    class Main is
        entry() static is
            Std.write_line(describe(Status.PLAIN));
            Std.write_line(describe(Status.SUFFIXED));
            Std.write_line(describe(Status.GROUPED));
            Std.write_line(describe(Status.HEX));
        si
    si
si
