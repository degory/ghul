namespace Test is
    use IO.Std;
    use Collections;

    // Inspired by `Pipe.each(action: T -> void)`
    // in `ghul-runtime/src/pipe.ghul`.
    //
    // The lambda has a single T param and returns void (the action
    // is for-effect, not for-value). Tests the void-return inference
    // path — lambdas that have no return statement and whose body
    // expressions are statement-style. Distinct from `.map(...)`
    // whose lambda returns a value: `each` expects an Action[T]
    // conversion (or equivalent void-returning delegate).

    class Main is
        entry() static is
            let xs = [10, 20, 30];

            xs | .each(x => Std.write_line("x={x}"));

            // A chain over a pinned source lowers `each` into the fused
            // loop rather than calling the combinator. Both lowerings
            // must produce the same elements in the same order.
            (0..4) | .filter(n => n % 2 == 0) .each(n => Std.write_line("n={n}"));

            return;
        si
    si
si
