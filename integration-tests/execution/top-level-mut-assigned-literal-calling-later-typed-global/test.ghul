use default

// g's parameter is only typed by its later calls, so on the first walk its
// body fails and the literal assigned to v has a failing tail. v must not be
// fixed as a void-returning function by that walk.
let c = true
let g = q => (let (a, b) = q; a + b)
let v mut
v = if c then (x: int, y: int) => 8 else (x: int, y: int) is g((y, 4)) si fi
write_line("{g((1, 2))} {v(1, 2)}")
