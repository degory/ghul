namespace Test is
    use Std = IO.Std;

    // A trait default method has a body like any other, so it can be a
    // generator or asynchronous. Exercised on a generic trait and a
    // non-generic one — the generic case additionally puts the
    // state-machine class in a generic owner.

    trait Box[T] is
        get_value() -> T;

        repeat(times: int) -> Ghul.Pipes.Pipe[T] is
            let i mut = 0;

            while i < times do
                yield get_value();
                i = i + 1;
            od
        si

        later() -> Tasks.TASK[T] is
            let v = await Tasks.TASK.from_result(get_value());

            return v;
        si
    si

    trait Counter is
        start() -> int;

        count_up(times: int) -> Ghul.Pipes.Pipe[int] is
            let i mut = 0;

            while i < times do
                yield start() + i;
                i = i + 1;
            od
        si

        doubled() -> Tasks.TASK[int] is
            let v = await Tasks.TASK.from_result(start());

            return v * 2;
        si
    si

    class STRING_BOX: Box[string] is
        init() is si

        get_value() -> string => "hello";
    si

    class FROM_THREE: Counter is
        init() is si

        start() -> int => 3;
    si

    class Main is
        entry() static is
            let box = STRING_BOX();

            for v in box.repeat(2) do
                Std.write_line("repeat {v}");
            od

            Std.write_line("later {box.later().result}");

            let counter = FROM_THREE();

            for v in counter.count_up(3) do
                Std.write_line("count {v}");
            od

            Std.write_line("doubled {counter.doubled().result}");
        si
    si
si
