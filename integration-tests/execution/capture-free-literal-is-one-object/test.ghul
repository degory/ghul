use IO.Std.write_line

entry() is
    let first = increment()
    let second = increment()

    write_line("{first == second} {first(1)} {second(2)}")

    let ints = identity[int]()
    let strings = identity[string]()

    write_line("{ints(3)} {strings("s")}")

    let a = adder(10)
    let b = adder(10)

    write_line("{a == b} {a(1)} {b(2)}")
si

increment() -> (int) -> int => x => x + 1

identity[T]() -> (T) -> T => x => x

adder(n: int) -> (int) -> int => x => x + n
