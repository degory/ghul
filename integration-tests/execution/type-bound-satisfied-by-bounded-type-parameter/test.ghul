use IO.Std.write_line;

// The other side of the constraint check: a type parameter whose own
// declaration guarantees what the callee requires is accepted, including
// through a self-referential bound and through a union's variants, whose
// type parameters are copied from the union's own list.

trait Comparable[T] is
    compare_to(other: T) -> int;
si

class BOX: Comparable[BOX] is
    value: int public;

    init(value: int) is
        self.value = value;
    si

    compare_to(other: BOX) -> int => value - other.value;
si

pick_larger[T: Comparable[T]](a: T, b: T) -> T =>
    if a.compare_to(b) >= 0 then a else b fi;

// The bound is passed on to a callee requiring the same bound.
relay[T: Comparable[T]](a: T, b: T) -> T => pick_larger(a, b);

// A class bound satisfies a `class` kind constraint, the way a CLR
// `where T : SomeClass` satisfies a `where U : class`. A trait bound
// would not, since a struct can implement one.
describe[T: class](x: T) -> string => "{x}";

via_bound[T: BOX](x: T) -> string => describe(x);

// The guarantee also reaches through a bound that is itself a type
// parameter, so the chain has to be walked to its end.
via_bound_chain[TBase: BOX, TDerived: TBase](x: TDerived) -> string => describe(x);

// A bounded parameter also has to be accepted as a type argument in an
// annotation - field, parameter, return and local. The kind constraint
// there is checked at a different point in the pipeline from a call's,
// after the declared bound is attached to the parameter symbol.
class WRAP[U: class] is
    init() is si
si

class HOLD[T: BOX] is
    kept: WRAP[T]?;

    init() is si

    pass_through(w: WRAP[T]) -> WRAP[T] is
        let local: WRAP[T]? = w;

        return w;
    si
si

union HOLDER[E: Comparable[E]] is
    NOTHING;
    ONE(item: E);
si

unwrap[E: Comparable[E]](h: HOLDER[E], fallback: E) -> E =>
    if let one: HOLDER.ONE = h then one.item else fallback fi;

entry() is
    write_line("{relay(BOX(3), BOX(7)).value}");
    write_line("{relay(BOX(9), BOX(2)).value}");
    write_line("{via_bound(BOX(1))}");
    write_line("{via_bound_chain[BOX, BOX](BOX(2))}");
    write_line("{HOLD[BOX]().pass_through(WRAP[BOX]())}");
    write_line("{unwrap(HOLDER.ONE(BOX(5)), BOX(0)).value}");
    write_line("{unwrap(HOLDER.NOTHING[BOX], BOX(4)).value}");
si
