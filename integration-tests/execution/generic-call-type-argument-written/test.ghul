namespace Test is
    use Std = IO.Std;

    class Main is
        // T is named only in the body, so the call has to write it out.
        describe[T](label: string) static is
            Std.write_line("{label}: {typeof T}");
        si

        entry() static is
            describe[byte]("byte");
            describe[string]("string");
        si
    si
si
