use IO.Std.write_line

class Shape abstract is
    is_round: bool => false;
    init() is si
si

class CIRCLE: Shape is
    is_round: bool => true;
    init() is super.init(); si
si

class BOX is
    flag: bool;
    count: int;
    init(flag: bool, count: int) is self.flag = flag; self.count = count; si
si

round(s: Shape?) -> bool => s?.is_round ?? false
flag(b: BOX?) -> bool? => b?.flag
count(b: BOX?) -> int => b?.count ?? -1
starts(s: string?) -> bool => s?.starts_with("a") ?? false

entry() is
    write_line("{round(CIRCLE())} {round(null)}")
    write_line("{flag(BOX(true, 3))} {flag(null)}")
    write_line("{count(BOX(true, 3))} {count(null)}")
    write_line("{starts("abc")} {starts("xyz")} {starts(null)}")
si
