use IO.Std.write_line

use Collections.LIST
use Collections.List
use Collections.Iterable

use Ghul.Pipes

returned() -> List[int] is
    let xs = LIST()
    return xs
si

tail() -> List[int] is
    let xs = LIST()
    xs
si

exact() -> LIST[string] is
    let xs = LIST()
    xs
si

widened() -> Iterable[int] is
    let xs = LIST()
    return xs
si

entry() is
    let r = returned()
    let t = tail()
    let e = exact()
    let w = widened()

    write_line("{r.count} {t.count} {e.count} {w |> count()}")

    e.add("added")
    write_line(e[0])
si
