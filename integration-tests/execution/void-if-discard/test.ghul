namespace Test is
    use IO.Std;

    // An if or case expression in void position whose branch produces
    // a non-void value needs the value popped from the stack. The
    // bare pop sites in visit(IF) and visit(CASE) handle this.
    class Main is
        entry() static is
            let cond = true;

            if cond then
                "discarded";
            fi;

            case cond
            when true then "also discarded"
            else "also discarded"
            esac;

            Std.write_line("ok");
        si
    si
si
