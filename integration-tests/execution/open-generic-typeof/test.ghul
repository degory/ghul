namespace Test is
    use Std = IO.Std;

    // A name declared at two generic arities. A bare `THING` names the
    // sibling taking no type arguments, so the generic one needs a
    // spelling of its own.
    class THING is
        init() is si
    si

    class THING[T] is
        init() is si
    si

    class PAIR[A, B] is
        init() is si
    si

    class LONE[T] is
        init() is si
    si

    class MAIN is
        entry() static is
            Std.write_line("{typeof THING}");
            Std.write_line("{typeof THING[_]}");
            Std.write_line("{typeof THING[int]}");
            Std.write_line("{typeof PAIR[_, _]}");
            Std.write_line("{typeof LONE[_]}");

            Std.write_line("open {(typeof THING[_]).is_generic_type_definition}");
            Std.write_line("open {(typeof PAIR[_, _]).is_generic_type_definition}");

            // The open form is the definition the constructed form is
            // built from.
            Std.write_line(
                "same {(typeof THING[int]).get_generic_type_definition() == typeof THING[_]}");

            // The two siblings are distinct runtime types.
            Std.write_line("distinct {typeof THING != typeof THING[_]}");
        si
    si
si
