namespace Test is
    use Std = IO.Std;

    use Ghul.Pipes.Pipe;

    class Main is
        // the inner generator must not run ahead of the consumer's
        // demand: its output has to interleave with the consumer's
        inner() -> Pipe[int] static is
            Std.write_line("inner produces 1");
            yield 1;
            Std.write_line("inner produces 2");
            yield 2;
        si

        outer() -> Pipe[int] static is
            yield in inner();
        si

        // a `yield in` inside a try body suspends out of the
        // protected region and resumes back into it
        guarded() -> Pipe[int] static is
            try
                yield in [3, 4];
            finally
                Std.write_line("finally ran");
            yrt
        si

        entry() static is
            for x in outer() do
                Std.write_line("consumer sees {x}");
            od

            for x in guarded() do
                Std.write_line("consumer sees {x}");
            od
        si
    si
si
