use default

use VISIT = (id: string, date: string)

trait Seq[E: out] is
    size: int;
si

class BAG[T]: Seq[T] is
    init() is si

    size: int => 0
si

class FULL: Seq[string] is
    init() is si

    size: int => 1
si

// A class that reaches a trait through another trait.
trait Collection[E: out]: Seq[E] is
si

class POUCH[T]: Collection[T] is
    init() is si

    size: int => 0
si

entry() is
    let visits: List[VISIT] = [(id = "1", date = "a"), (id = "2", date = "b")]
    let nobody: List[VISIT] = []
    let full: Seq[string] = FULL()

    let c = visits.count > 0

    // An empty constructor on one arm, a supertype of it on the other: the
    // constructor takes its type argument from the other arm.
    let theirs = if c then visits else LIST() fi
    let nothing = if !c then visits else LIST() fi

    write_line("{theirs |> count()} {nothing |> count()}")

    let by_id = visits |> group_by(visit => visit.id)
    let looked_up = if by_id.contains_key("1") then by_id["1"] else LIST() fi

    write_line("{looked_up |> count()}")

    let seq = if c then full else BAG() fi
    let swapped = if c then BAG() else full fi

    write_line("{seq.size} {swapped.size}")

    // The trait is two steps up from the class.
    let far = if c then full else POUCH() fi

    write_line("{far.size}")

    let chosen =
        case visits.count
        when 0 then nobody
        else LIST()
        esac

    write_line("{chosen |> count()}")
si
