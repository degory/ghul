use IO.Std.write_line
use Ghul.Pipes

class NODE(name: string public)

lookup(n: int) -> string? => if n > 1 then "big {n}" else null fi

first_even(xs: int[]) -> int? => xs |> find(x => x % 2 == 0)

entry() is
    let xs = [3, 4, 7, 8]
    let nodes = [NODE("a"), NODE("bb")]

    let found: int? = xs |> find(x => x > 5)
    write_line("{found ?? -1}")

    let missing: int? = xs |> find(x => x > 50)
    write_line("{missing ?? -1}")

    write_line("{first_even(xs) ?? -1}")

    let mapped: string? = xs |> find_map(x => lookup(x))
    write_line("{mapped ?? "none"}")

    let node: NODE? = nodes |> find(n => n.name.length > 1)
    write_line("{node?.name ?? "none"}")

    if let biggest = xs |> max() then
        write_line("max {biggest}")
    fi

    let least: int = xs |> min() ?? 0
    write_line("min {least}")

    let empty: int[] = []
    write_line("{(empty |> first()) ?? -1}")

    let it = xs.iterator
    let head: int? = it |> next()
    write_line("{head ?? -1}")

    while let n = it |> next() do
        write_line("next {n}")
    od

    write_line("{(nodes |> last())?.name ?? "none"}")
si
