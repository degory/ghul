use IO.Std.write_line

// Reading the value of an absent optional value type throws
// InvalidOperationException, which a program can catch.

struct POINT(x: int public, y: int public);

value_of(n: int?) -> int => n!
point_of(p: POINT?) -> POINT => p!

attempt(name: string, operation: () -> string) is
    try
        write_line("{name}: {operation()}")
    catch e: Ghul.InvalidOperationException
        write_line("{name}: {e.message}")
    yrt
si

attempt("absent int", () -> string => "{value_of(null)}")
attempt("present int", () -> string => "{value_of(42)}")
attempt("absent struct", () -> string => "{point_of(null).x}")
attempt("present struct", () -> string => "{point_of(POINT(3, 4)).y}")
