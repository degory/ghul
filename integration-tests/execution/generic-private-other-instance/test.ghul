namespace Test is
    use IO.Std;

    // A generic reading a private member of a second instance of
    // itself — the equality/comparison pattern. The same code in a
    // non-generic type already compiled.

    struct BOX[T] is
        _value: T;
        init(value: T) is _value = value; si
        // reads a private field of a peer instance
        matches(other: BOX[T]) -> bool => object.equals(_value, other._value);
        // calls a private method on a peer instance
        same_as(other: BOX[T]) -> bool => object.equals(_value, other._peers_value());
        _peers_value() -> T => _value;
    si

    class CELL[T] is
        _value: T;
        init(value: T) is _value = value; si
        matches(other: CELL[T]) -> bool => object.equals(_value, other._value);
    si

    entry() is
        Std.write_line("{BOX(1).matches(BOX(1))}");
        Std.write_line("{BOX(1).same_as(BOX(2))}");
        Std.write_line("{CELL('a').matches(CELL('a'))}");
        Std.write_line("{CELL('a').matches(CELL('b'))}");
    si
si
