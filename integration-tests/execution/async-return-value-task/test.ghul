namespace Test is
    use Std = IO.Std;

    // `ValueTask[T]` names AsyncValueTaskMethodBuilder through its
    // AsyncMethodBuilderAttribute; the whole lowering is driven through
    // that builder rather than the Task one.
    class MAIN is
        compute(x: int) -> Tasks.ValueTask[int] static is
            let a = await Tasks.ValueTask[int](x);
            await Tasks.TASK.yield();
            return a + 1;
        si

        pause() -> Tasks.ValueTask static is
            await Tasks.TASK.yield();
        si

        entry() static is
            Std.write_line("value={compute(41).result}");
            let v = pause();
            v.as_task().wait();
            Std.write_line("void done");
        si
    si
si
