use IO.Std.write_line

// Reading through a reference that holds null throws NullReferenceException,
// which a program can catch: in the function that read through it, or in a
// caller, with the finally blocks between running first.

class THING(value: int public) is
    describe() -> string => "thing {value}"
si

class Shape abstract is
    init() is si

    area() -> int
si

class SQUARE(side: int): Shape is
    super()

    area() -> int => side * side
si

trait Named is
    name() -> string
si

class PERSON(_name: string): Named is
    name() -> string => _name
si

nothing[T]() -> T => _[T]

same_function(t: THING) -> string is
    try
        return "{t.value}"
    catch e: Ghul.NullReferenceException
        return "caught where it was read"
    yrt
si

attempt(name: string, operation: () -> string) is
    try
        try
            write_line("{name}: {operation()}")
        finally
            write_line("{name}: finally")
        yrt
    catch e: Ghul.NullReferenceException
        write_line("{name}: null reference")
    yrt
si

write_line("same function: {same_function(THING(1))}")
write_line("same function: {same_function(nothing[THING]())}")

attempt("field", () -> string => "{nothing[THING]().value}")
attempt("field store", () -> string is
    let t = nothing[THING]()
    t.value = 2
    return "stored"
si)
attempt("method", () -> string => nothing[THING]().describe())
attempt("virtual method", () -> string => "{nothing[Shape]().area()}")
attempt("trait method", () -> string => nothing[Named]().name())
attempt("array count", () -> string => "{nothing[int[]]().count}")
attempt("array element", () -> string => "{nothing[int[]]()[0]}")
attempt("string length", () -> string => "{nothing[string]().length}")
attempt("function value", () -> string => "{nothing[(int) -> int]()(1)}")
attempt("present", () -> string => "{THING(3).value} {SQUARE(4).area()} {PERSON("pat").name()}")
