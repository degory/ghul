// A bare `assert` as the last statement of an arm leaves the `else` that
// follows to the enclosing `if` or `case`: dedented past the assert, it
// closes the arm. Indented at least as far as the assert, an `else` on the
// next line is the assert's own message, whether it sits level with the
// assert or deeper.
use IO.Std.write_line

check(flag: bool, value: int) is
    if flag then
        assert value > 0
    else
        write_line("if else arm")
    fi

    case value
    when 1 then
        assert flag
    when 2 then
        assert !flag
    else
        assert true
    esac

    try
        assert value < 3
        else "level with the assert: {value}"
    catch e: Ghul.AssertFailedException
        write_line("caught level")
    yrt

    try
        assert value < 3
            else "deeper than the assert: {value}"
    catch e: Ghul.AssertFailedException
        write_line("caught deeper")
    yrt

    write_line("checked {flag} {value}")
si

entry() is
    check(true, 1)
    check(false, 2)
    check(true, 3)
si
