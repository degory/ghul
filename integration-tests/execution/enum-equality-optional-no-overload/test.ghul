namespace Test is
    use Std = IO.Std;

    // An enum's `=~` is an opcode innate (compare.value), which takes
    // both operands as arguments. The null-safe `=~` path calls the
    // operator as an instance method, so it declines an innate and the
    // optional form reports no overload. This pins that the combination
    // is known-broken rather than accidentally passing; the right
    // answer is for `=~` over an optional enum to be null-safe, which
    // needs `=~` as a real method rather than an opcode and belongs
    // with the broader `=~` lowering work. The operands are left
    // optional (defaulted) so flow narrowing does not reduce them to
    // the non-optional enum, where `=~` does resolve.
    enum Level is
        LOW,
        MID,
        HIGH
    si

    class Main is
        entry() static is
            let a: Level? = _;
            let b: Level? = _;

            Std.out.write_line("{a =~ b}");

            return;
        si
    si
si
