use IO.Std.write_line

// A boxed scalar equals another box of the same type holding an equal
// value, as the scalar's own Equals has it on .NET: a NaN equals a NaN, and a
// box of another type is never equal however the values compare.

boxed(o: object) -> object => o

let one = boxed(1)

write_line("int: {one.equals(boxed(1))} {one.equals(boxed(2))} {one.equals(boxed(1L))} {one.equals(null)}")
write_line("double: {boxed(1.5).equals(boxed(1.5))} {boxed(0.0 / 0.0).equals(boxed(0.0 / 0.0))} {boxed(1.5).equals(boxed(2.5))}")
write_line("char: {boxed('a').equals(boxed('a'))} {boxed('a').equals(boxed(97))}")
write_line("hash: {one.get_hash_code() == boxed(1).get_hash_code()}")
