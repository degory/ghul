namespace Test is
    use IO.Std;

    // Neither `Ghul.Equatable[T]` nor `Ghul.Comparable[T]` obliges an
    // implementer to declare the operator's parameter optional,
    // whichever way the interface spells it: presence is settled
    // where the operator is used, so the body is only handed present
    // values. The non-optional spelling below is the exception to the
    // rule that an implementation cannot declare a parameter
    // non-optional where the overridden member accepts optional.

    class TIDY: Ghul.Equatable[TIDY], Ghul.Comparable[TIDY] is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: TIDY) -> bool => _v == other._v;
        <>(other: TIDY) -> int => _v - other._v;
    si

    // Declaring it optional stays available for a reference type, so a
    // body can defend against a null arriving from a caller in another
    // language without the compiler calling the test redundant.
    class DEFENSIVE: Ghul.Equatable[DEFENSIVE] is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: DEFENSIVE?) -> bool => other? /\ _v == other._v;
    si

    // A constructed-generic type argument accepts both spellings the
    // same way as a plain class, whichever way the interface's
    // parameter renders.
    class WRAP[T]: Ghul.Equatable[WRAP[T]] is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: WRAP[T]) -> bool => v == other.v;
    si

    class WRAP_DEFENSIVE[T]: Ghul.Equatable[WRAP_DEFENSIVE[T]] is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: WRAP_DEFENSIVE[T]?) -> bool => other? /\ v == other.v;
    si

    // A value type has no such freedom: its `T?` is a `Nullable[T]`
    // carrier, a different signature from the one the interface
    // declares, so only the plain spelling implements it.
    struct VAL: Ghul.Equatable[VAL] is
        x: int;

        init(x: int) is self.x = x; si

        =~(other: VAL) -> bool => x == other.x;
    si

    class Main is
        entry() static is
            Std.write_line("tidy equal: {TIDY(1) =~ TIDY(1)}");
            Std.write_line("tidy unequal: {TIDY(1) =~ TIDY(2)}");
            Std.write_line("tidy less: {TIDY(1) < TIDY(2)}");
            Std.write_line("defensive equal: {DEFENSIVE(1) =~ DEFENSIVE(1)}");
            Std.write_line("wrap equal: {WRAP[int](1) =~ WRAP[int](1)}");
            Std.write_line("wrap defensive equal: {WRAP_DEFENSIVE[int](1) =~ WRAP_DEFENSIVE[int](2)}");
            Std.write_line("val equal: {VAL(1) =~ VAL(1)}");

            // and the operators still reach across optionals, with the
            // bodies above only ever handed present values
            let present: TIDY? = TIDY(1);
            let absent: TIDY? = null;

            Std.write_line("present =~ absent: {present =~ absent}");
            Std.write_line("absent =~ absent: {absent =~ absent}");

            // reflected members keep their declared optionality, so
            // an optional argument still passes where the imported
            // signature accepts one
            let maybe: string? = null;
            Std.write_line("string equals absent: {"x".equals(maybe)}");

            return;
        si
    si
si
