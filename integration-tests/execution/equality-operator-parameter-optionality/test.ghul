namespace Test is
    use IO.Std;

    // `IEquatable[T]` and `IComparable[T]` annotate their parameter
    // `T?`, but on an unconstrained type parameter that is a C#
    // annotation with no runtime form - it compiles to a bare `T`. So
    // neither interface obliges an implementer to declare the parameter
    // optional, and the body is written over present values, with
    // presence settled where the operator is used.

    class TIDY: Ghul.Equatable[TIDY], Ghul.Comparable[TIDY] is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: TIDY) -> bool => _v == other._v;
        <>(other: TIDY) -> int => _v - other._v;
    si

    // Declaring it optional stays available for a reference type, so a
    // body can defend against a null arriving from a caller in another
    // language without the compiler calling the test redundant.
    class DEFENSIVE: Ghul.Equatable[DEFENSIVE] is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: DEFENSIVE?) -> bool => other? /\ _v == other._v;
    si

    // A value type has no such freedom: its `T?` is a `Nullable[T]`
    // carrier, a different signature from the one the interface
    // declares, so only the plain spelling implements it.
    struct VAL: Ghul.Equatable[VAL] is
        x: int;

        init(x: int) is self.x = x; si

        =~(other: VAL) -> bool => x == other.x;
    si

    class Main is
        entry() static is
            Std.write_line("tidy equal: {TIDY(1) =~ TIDY(1)}");
            Std.write_line("tidy unequal: {TIDY(1) =~ TIDY(2)}");
            Std.write_line("tidy less: {TIDY(1) < TIDY(2)}");
            Std.write_line("defensive equal: {DEFENSIVE(1) =~ DEFENSIVE(1)}");
            Std.write_line("val equal: {VAL(1) =~ VAL(1)}");

            // and the operators still reach across optionals, with the
            // bodies above only ever handed present values
            let present: TIDY? = TIDY(1);
            let absent: TIDY? = null;

            Std.write_line("present =~ absent: {present =~ absent}");
            Std.write_line("absent =~ absent: {absent =~ absent}");

            return;
        si
    si
si
