sum_of(pairs: Collections.Iterable[(int, int)]) -> int =>
    pairs | .map(((a, b)) => a + b) .reduce(0, (x, y) => x + y);

entry() static is
    let xs = [(1, 2), (3, 4)];

    // element types inferred from the sequence
    IO.Std.write_line("{sum_of(xs)}");

    // ascription on the whole pattern, and on one element of it
    let f = ((a, b): (int, int)) => a + b;
    let g = ((a: int, b)) => a + b;
    IO.Std.write_line("{f((10, 20))}");
    IO.Std.write_line("{g((30, 40))}");

    // destructures anything positional, not just tuples
    let m = Collections.MAP[string, int]();
    m.add("a", 1);
    m | .each(((k, v): Collections.KeyValuePair[string, int]) => IO.Std.write_line("{k}={v}"));

    // nested patterns and discards
    [((1, 2), 3)] | .each((((a, b), c)) => IO.Std.write_line("{a + b + c}"));
    xs | .each(((_, b)) => IO.Std.write_line("{b}"));

    // a `:` inside string interpolation opens a format specifier,
    // never a type ascription on a parenthesised group
    let p = 1.5;
    let q = 2;
    IO.Std.write_line("{(p, q):F3}");
    IO.Std.write_line("{p:F3}");
    IO.Std.write_line("{(p, q),12}");

    // ... and the alignment slot is not a formal-argument list either
    let w = 12;
    IO.Std.write_line("{p,w:F3}");
si
