sum_of(pairs: Collections.Iterable[(int, int)]) -> int =>
    pairs | .map(((a, b)) => a + b) .reduce(0, (x, y) => x + y);

entry() static is
    let xs = [(1, 2), (3, 4)];

    // element types inferred from the sequence
    IO.Std.write_line("{sum_of(xs)}");

    // explicit ascription on the pattern
    let f = ((a, b): (int, int)) => a + b;
    IO.Std.write_line("{f((10, 20))}");

    // destructures anything positional, not just tuples
    let m = Collections.MAP[string, int]();
    m.add("a", 1);
    m | .for_each(((k, v): Collections.KeyValuePair[string, int]) => IO.Std.write_line("{k}={v}"));

    // nested patterns and discards
    [((1, 2), 3)] | .for_each((((a, b), c)) => IO.Std.write_line("{a + b + c}"));
    xs | .for_each(((_, b)) => IO.Std.write_line("{b}"));
si
