// A line-start `(` or `[` never continues the previous line's expression:
// the destructure assignment and tuple statement below are new statements,
// not call or index trailers. Leading `.`, `|` and `|>` still continue.
use IO.Std.write_line

use Collections

twice(x: int) -> int => x * 2

entry() is
    let source = [(1, "one"), (2, "two")]

    let n: int mut
    let s: string mut

    (n, s) = source[1]
    write_line("{n} {s}")

    let total = source
        | .map(t => t.`0)
          .reduce(0, (acc, v) => acc + v)
    write_line("total {total}")

    let piped = 5 |> twice()
        |> twice()
    write_line("piped {piped}")

    let flag = (
        let name = "x"
        !(name =~ "y")
    )
    write_line("flag {flag}")
si
