namespace Test is
    use IO.Std;
    use Collections;

    entry() static is
        let compare: System.Comparison[int] = (a: int, b: int) -> int => b - a;

        Std.write_line("{compare.get_type()}");

        let xs = LIST[int]([3, 1, 2]);

        xs.sort(compare);

        for x in xs do
            Std.write_line("{x}");
        od
    si
si
