namespace Test is
    use IO.Std;
    use Collections;

    entry() static is
        let xs = LIST[int]([3, 1, 2]);

        // the only overload taking a literal is the delegate one
        xs.sort((a: int, b: int) -> int => b - a);

        for x in xs do
            Std.write_line("{x}");
        od

        // a literal reached through an expression that is not itself one
        let ys = LIST[int]([3, 1, 2]);
        let ascending = false;

        ys.sort(
            if ascending then
                (a: int, b: int) -> int => a - b
            else
                (a: int, b: int) -> int => b - a
            fi
        );

        for y in ys do
            Std.write_line("{y}");
        od

        // parameter types inferred from the delegate the slot expects
        Std.write_line("{xs.find_index(v => v == 2)}");
    si
si
