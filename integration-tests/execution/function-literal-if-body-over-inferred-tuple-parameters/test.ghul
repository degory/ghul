use Ghul.Pipes

take[T](xs: T[], f: (T, T) -> int) -> int => f(xs[0], xs[1])

pick[T](xs: T[], f: (T) -> string) -> string => f(xs[0])

entry() is
    let ps = [(x = 3, y = 1), (x = 1, y = 2), (x = 1, y = 1)]

    IO.Std.write_line("{take(ps, (a, b) => if a.x != b.x then a.x - b.x else a.y - b.y fi)}")

    let sorted = ps |> sort((a, b) =>
        if a.x != b.x then a.x - b.x else a.y - b.y fi)

    IO.Std.write_line("{sorted}")

    let named =
        pick(
            ps,
            p =>
                case p.x
                when 3 then "three {p.y}"
                else "other {p.y}"
                esac
        )

    IO.Std.write_line(named)

    ps |> each(p => if p.x > 1 then IO.Std.write_line("big {p.x}") fi)
si
