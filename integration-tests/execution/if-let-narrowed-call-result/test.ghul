// A type test on a property call, whose result is declared wider than the
// type the test proves, reads the result at the narrower type.
use IO.Std.write_line

class Logger abstract is
    init() is si
si

class STORE: Logger is
    init() is super.init() si
    keep() is write_line("kept") si
si

class HOLDER is
    _logger: Logger
    init(logger: Logger) is _logger = logger si
    logger: Logger => _logger

    want() is
        if let store: STORE = logger then
            store.keep()
        fi
    si
si

entry() is
    HOLDER(STORE()).want()
si
