namespace Runner is
    use IO.Std.write_line;
    use cell_1.PROBE;
    use cell_1.CAT;
    use cell_1.DOG;
    use cell_2.BIRD;

    // The cells beside this file are one session, built with --session:
    // the first cell's case and else-edge narrowing were compiled
    // against the hierarchy as that cell saw it, so a subclass the
    // second cell adds is guarded at run time rather than compiled in.
    entry() is
        let probe = PROBE();

        try
            probe.say(BIRD());

            write_line("ran no arm and carried on");
        catch e: Ghul.AssertFailedException
            write_line("guarded: {e.message}");
        yrt

        try
            IO.Std.write("described: {probe.describe(BIRD())}");
        catch e: Ghul.InvalidCastException
            write_line("guarded narrow");
        yrt

        probe.say(DOG());

        write_line("described: {probe.describe(CAT())}");
    si
si
