class Animal abstract is
    init() is si
si

class CAT: Animal is
    init() is super.init(); si

    purr() -> string => "purr";
si

class DOG: Animal is
    init() is super.init(); si

    bark() -> string => "woof";
si

class PROBE is
    init() is si

    // Exhaustive over the hierarchy as this cell sees it: a later
    // cell's subclass is not an arm, and the guard says so.
    say(a: Animal) is
        case a
        when c: CAT then IO.Std.write_line("cat")
        when d: DOG then IO.Std.write_line("dog")
        esac
    si

    // The else edge narrows to the one alternative left, and the
    // load of the narrowed value is checked.
    describe(a: Animal) -> string is
        if isa CAT(a) then
            return "cat";
        fi

        return "dog: {a.bark()}"
    si
si
