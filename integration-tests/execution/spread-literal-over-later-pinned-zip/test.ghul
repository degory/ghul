use default

// The tuple comes from zip, whose type parameters are unbound until the
// enclosing literal's parameter is pinned by the later call. An unbound
// parameter of the candidate is not a type the spread literal's own
// parameters can take, so they wait for the call as well.
let f = x => [x, 19] |> zip([x]) |> take_while((a, b) => a < 100) |> count()

write_line("{f(8)}")
