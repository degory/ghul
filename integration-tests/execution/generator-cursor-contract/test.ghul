namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    class BOX[T] is
        value: T;

        init(value: T) is
            self.value = value;
        si

        // A generic instance generator: its frame carries the class's
        // type parameter and the outer self, both of which a rewind
        // has to leave in place.
        repeated(times: int mut) -> Pipe[T] is
            while times > 0 do
                yield value;
                times = times - 1;
            od
        si
    si

    class Main is
        countdown(n: int mut) -> Pipe[int] static is
            while n > 0 do
                yield n;
                n = n - 1;
            od
        si

        // Ends its stream with a bare return rather than by falling off
        // the end, so a rewind has to happen on that path too.
        until_zero(n: int mut) -> Pipe[int] static is
            while true do
                yield n;
                n = n - 1;

                if n == 0 then
                    return;
                fi
            od
        si

        entry() static is
            let pipe = countdown(3);

            // Driven directly the frame is a cursor: the first loop takes
            // one element, the next carries on, and once the frame has
            // run out the loop after that starts it over.
            for n in pipe do
                Std.write_line("first: {n}");
                break;
            od

            for n in pipe do
                Std.write_line("rest: {n}");
            od

            for n in pipe do
                Std.write_line("again: {n}");
            od

            // reset() rewinds the frame early, in place.
            for n in pipe do
                Std.write_line("before reset: {n}");
                break;
            od

            pipe.reset();

            Std.write_line("after reset: {pipe |> join(" ")}");

            let returned = until_zero(2);

            Std.write_line("returned: {returned |> join(" ")}");
            Std.write_line("returned again: {returned |> join(" ")}");

            let box = BOX[string]("x");
            let xs = box.repeated(2);

            Std.write_line("generic: {xs |> join(" ")}");
            Std.write_line("generic again: {xs |> join(" ")}");
        si
    si
si
