use default

use Church[T] = ((T) -> T) -> (T) -> T

// `_()` with nothing pushed into it builds what the local's later uses say
// it holds: here, the type the local is returned as.
subsets[T](values: List[T]) -> LIST[LIST[T]] is
    let result = _()

    result.add(LIST())

    for value in values do
        let with_value = _()

        with_value.add(value)

        result.add(with_value)
    od

    return result
si

zero[T](f: (T) -> T) -> (T) -> T => x => x

successor[T](n: Church[T]) -> Church[T] => f => x => f(n(f)(x))

to_church[T](n: int) -> Church[T] =>
    if n == 0 then zero else successor(to_church(n - 1)) fi

exponentiate[T](a: Church[T], b: Church[(T) -> T]) -> Church[T] => b(a)

to_int(n: Church[int]) -> int => n(x => x + 1)(0)

// A call whose own type parameter only its return type mentions takes
// that parameter from where the local holding its result is used.
power() -> int is
    let two = successor(successor(zero[int]))
    let exponent = to_church(3)

    to_int(exponentiate(two, exponent))
si

write_line(subsets([1, 2]).count)
write_line(power())
