namespace Test is
    use Std = IO.Std;

    trait Op[T] is
        execute(left: T, right: T) -> T;
    si

    class ADD_INT: Op[int] is
        init() is si

        execute(left: int, right: int) -> int => left + right;
    si

    class CALC[T] is
        _ops: Collections.MAP[string, Op[T]];

        init(ops: Collections.Iterable[(name: string, op: Op[T])]) is
            _ops = Collections.MAP[string, Op[T]]();

            for (name, op) in ops do
                _ops.add(name, op);
            od
        si

        run(name: string, left: T, right: T) -> T is
            let op = _ops[name];
            return op.execute(left, right);
        si
    si

    entry() static is
        let entries: (name: string, op: Op[int])[] = [
            (name = "add", op = ADD_INT())
        ];

        let calc = CALC(entries);
        let result = calc.run("add", 3, 4);

        Std.write_line("result={result}");
    si
si
