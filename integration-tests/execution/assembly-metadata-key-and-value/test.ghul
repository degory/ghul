namespace Test is
    use IO.Std.write_line

    // Read back through ordinary reflection, which resolves each
    // attribute's constructor: a two-string attribute is given its key and
    // value, and a one-string attribute keeps the comma in its value.
    entry() is
        let assembly = System.Reflection.Assembly.get_executing_assembly()

        for attribute in assembly.get_custom_attributes_data() do
            let name = attribute.attribute_type.name

            if name =~ "AssemblyMetadataAttribute" \/ name =~ "AssemblyDescriptionAttribute" then
                write_line("{attribute}")
            fi
        od
    si
si
