namespace Other is
    class UTILITY is
        counter: int static;
        double_value(x: int) -> int static => x * 2;

        instance_value: int;

        init(instance_value: int) is
            self.instance_value = instance_value;
        si

        instance_only() -> int => instance_value;
    si
si

namespace Test is
    use IO.Std.write_line;
    use Other.UTILITY.*;

    entry() is
        counter = 3;
        write_line("counter: {counter}");
        write_line("double_value: {double_value(counter)}");
    si
si
