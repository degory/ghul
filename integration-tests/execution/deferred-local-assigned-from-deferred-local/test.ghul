use default

// A deferred-init local whose only clue is another deferred-init local
// takes that local's type, even when it is then passed to a generic
// function taking an `Iterable[T]`.
chained() is
    let a mut
    a = [1, 2]
    let b mut
    b = a
    write_line("chained {b |> join(",")}")
si

three_deep() is
    let a mut
    a = ["x", "y"]
    let b mut
    b = a
    let c mut
    c = b
    write_line("three deep {c |> count()}")
si

chained()
three_deep()
