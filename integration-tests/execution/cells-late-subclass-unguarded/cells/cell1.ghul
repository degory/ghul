class Animal abstract is
    init() is si
si

class CAT: Animal is
    init() is super.init(); si
si

class DOG: Animal is
    init() is super.init(); si
si

class PROBE is
    init() is si

    // Exhaustive as this cell wrote it; the second cell's BIRD is a
    // later alternative, and without --session nothing guards the
    // no-match path: the case runs no arm and carries on.
    say(a: Animal) is
        case a
        when c: CAT then IO.Std.write_line("cat")
        when d: DOG then IO.Std.write_line("dog")
        esac
    si
si
