use IO.Std.write_line;

class BOX(v: int);

absent_box() -> BOX? => null;
present_box() -> BOX? => BOX(42);

absent_nullable() -> int? => null;
present_nullable() -> int? => 7;

// unconstrained T lowers T? to Ghul.MAYBE[T]
wrap_if[T](f: bool, a: T) -> T? => if f then a else null fi;

expect_throw(action: () -> void) is
    let caught mut = false;

    try
        action();
    catch e: System.Exception
        caught = true;
    yrt

    assert caught else "expected an exception, none was thrown";
si

entry() is
    // plain reference-typed T? — `!` on absent throws, including when
    // the unwrapped result is never read
    expect_throw(() -> void is let b = absent_box()!; write_line("{b}"); si);
    expect_throw(() -> void is absent_box()!; si);

    let present = present_box()!;
    write_line("present box: {present.v}");

    // Nullable[T] — `!` on absent throws (native .NET behaviour)
    expect_throw(() -> void is let n = absent_nullable()!; write_line("{n}"); si);
    write_line("present nullable: {present_nullable()!}");

    // MAYBE[T] (unconstrained T) — `!` on absent throws
    expect_throw(() -> void is let m = wrap_if[string](false, "x")!; write_line("{m}"); si);
    write_line("present maybe: {wrap_if[string](true, "x")!}");

    // MAYBE[T] -> reference T? coercion at a generic instantiation
    // boundary: no `!` written anywhere, absence still becomes a
    // plain null rather than throwing.
    let coerced: string? = wrap_if[string](false, "x");

    if coerced? then
        write_line("SHOULD NOT REACH: {coerced}");
    else
        write_line("coerced absent maybe: ok");
    fi

    let coerced_present: string? = wrap_if[string](true, "x");
    write_line("coerced present maybe: {coerced_present!}");

    write_line("done");
si
