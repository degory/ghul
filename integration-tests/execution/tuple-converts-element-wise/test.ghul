use default

// A tuple is assignable to a tuple type whose elements each accept its
// own. The CLR type is invariant, so the value is rebuilt element by
// element wherever it crosses into the wider type.
class Animal abstract is
    init() is si
    describe() -> string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    describe() -> string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    describe() -> string => "dog"
si

union Shape is
    CIRCLE(radius: int)
    DOT
si

shape_name(s: Shape) -> string =>
    if let circle: Shape.CIRCLE = s then "circle {circle.radius}" else "dot" fi

show(p: (Animal, Shape)) -> string => "{p.`0.describe()} {shape_name(p.`1)}"

widen(t: (CAT, Shape.DOT)) -> (Animal, Shape) => t

class HOLDER is
    pair: (object, object) public
    init() is pair = (0, 0) si
si

numbers(t: (int, int)) -> Pipe[(object, object)] is
    yield t
si

entry() is
    let k = true
    let t = (CAT(), Shape.DOT)

    let a: (Animal, Shape) = t
    write_line("let: {show(a)}")

    write_line("argument: {show(t)}")
    write_line("return: {show(widen(t))}")

    let assigned: (Animal, Shape) mut = (DOG(), Shape.CIRCLE(1))
    assigned = t
    write_line("assignment: {show(assigned)}")

    let joined = if k then t else (DOG(), Shape.CIRCLE(2)) fi
    let (animal, shape) = joined
    write_line("if join: {animal.describe()} {shape_name(shape)}")

    let joined_from_block = if !k then (DOG(), Shape.CIRCLE(2)) else (let unused = 1; t) fi
    write_line("block join: {show(joined_from_block)}")

    let d = (DOG(), Shape.CIRCLE(3))
    let pairs = [t, d]
    write_line("array: {show(pairs[0])}, {show(pairs[1])}")

    let ints = (40, 2)

    let boxed: (object, object) = ints
    write_line("boxed: {boxed.`0} {boxed.`1}")

    let optional: (int?, int) = ints
    write_line("optional: {optional.`0 ?? 0} {optional.`1}")

    let nested = ((CAT(), Shape.DOT), 5)
    let wide_nested: ((Animal, Shape), int) = nested
    write_line("nested: {show(wide_nested.`0)} {wide_nested.`1}")

    let holder = HOLDER()
    holder.pair = ints
    write_line("property: {holder.pair.`0}")

    for p in numbers(ints) do
        write_line("yield: {p.`1}")
    od

    let list = LIST[(object, object)]()
    list.add(ints)
    write_line("list: {list[0].`0}")
si
