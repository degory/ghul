use IO.Std.write_line

node() -> (label: string, children: int[]) =>
    (label = "leaf", children = [])

let check: (name: string, test: (int, int) -> bool) =
    (name = "first", test = (a, _) => a > 0)

let checks: (name: string, test: (int, int) -> bool)[] =
    [(name = "second", test = (a, b) => a > b)]

let nested: (outer: (inner: string[], n: int), ok: bool) =
    (outer = (inner = [], n = 1), ok = true)

write_line("{node().label} {node().children.count}")
write_line("{check.name} {check.test(1, 2)}")
write_line("{checks[0].name} {checks[0].test(1, 2)}")
write_line("{nested.outer.inner.count} {nested.outer.n} {nested.ok}")
