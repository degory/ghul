namespace Test is
    use IO.Std.write_line;

    class Main is
        entry() static is
            let small: bigint = 2n;
            let zero = 0n;
            let hex = 0xDEADBEEFn;
            let wide = 123456789012345678901234567890n;

            write_line("{small} {zero} {hex} {wide}");

            // Arithmetic and comparison both resolve through the
            // reflected members rather than through any innate handler.
            write_line("{small * 21n} {wide + 1n} {wide / 1000000000000000n}");
            write_line("{small =~ 2n} {small !~ 2n} {small < 3n} {small >= 3n}");

            // A literal too wide for a long is built by parsing its
            // digits, so its value has to survive the radix it was
            // written in as well as the width.
            write_line("{0xFFFFFFFFFFFFFFFFFFFFn} {wide * wide}");

            let counted = count_halvings(wide);

            write_line("{counted}");
        si

        count_halvings(value: bigint) -> int static is
            let remaining mut = value
            let steps mut = 0

            while remaining > 0n do
                remaining = remaining / 2n
                steps = steps + 1
            od

            return steps
        si
    si
si
