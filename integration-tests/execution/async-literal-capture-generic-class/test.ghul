namespace Test is
    use Std = IO.Std;

    class BOX[T] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        run() -> Tasks.TASK is
            let held = _value;
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("{held}");

                await Tasks.TASK.yield();

                seen.add("{held}");
            si;

            await body();

            Std.write_line("{seen.count} {seen[1]}");
        si
    si

    class Main is
        entry() static is
            BOX[int](7).run().wait();
            BOX[string]("held").run().wait();
        si
    si
si
