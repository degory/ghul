namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    union Tree is
        EMPTY;
        NODE(value: int, rest: Tree);
    si

    use Tree.NODE;

    class PAIR is
        `0: int field;
        `1: int field;
        init(a: int, b: int) is `0 = a; `1 = b; si
    si

    class BOX is
        _items: Collections.LIST[Tree];

        init(items: Collections.LIST[Tree]) is _items = items; si

        take() -> Tree is
            let head = _items[0];
            _items.remove_at(0);
            return head;
        si
    si

    class Main is
        entry() static is
            step(NODE(7, Tree.EMPTY));
            step(Tree.EMPTY);

            method_call();

            for v in walk(NODE(1, NODE(2, Tree.EMPTY))) do
                Std.out.write_line("yielded {v}");
            od

            named_group(NODE(5, Tree.EMPTY));

            plain_type(make_pair(3, 4));
        si

        next(t: Tree) -> Tree static => t;

        // The scrutinee is a call, so the then-edge narrowing has
        // nothing to narrow: the destructure has to read its members
        // off the ascribed variant instead of the declared union.
        step(t: Tree) static is
            if let (value, rest): NODE = next(t) then
                Std.out.write_line("node {value}");
            else
                Std.out.write_line("empty");
            fi
        si

        method_call() static is
            let box = BOX(Collections.LIST[Tree]([NODE(9, Tree.EMPTY)]));

            if let (value, rest): NODE = box.take() then
                Std.out.write_line("took {value}");
            fi
        si

        // Same shape inside a generator, where the bound names live on
        // the state-machine frame.
        walk(t: Tree) -> Pipe[int] static is
            let cur mut = t;

            while true do
                if let (value, rest): NODE = next(cur) then
                    yield value;
                    cur = rest;
                else
                    break;
                fi
            od
        si

        named_group(t: Tree) static is
            if let (v = value): NODE = next(t) then
                Std.out.write_line("named {v}");
            fi
        si

        make_pair(a: int, b: int) -> object static => PAIR(a, b);

        // A plain class target, not a union variant.
        plain_type(o: object) static is
            if let (a, b): PAIR = o then
                Std.out.write_line("pair {a},{b}");
            fi
        si
    si
si
