use IO.Std.write_line;
use Collections;

// A member compared element-wise cannot be hashed by the reference
// its own `get_hash_code` answers for: two equal sequences are
// different objects, so the pair .NET requires would be broken and a
// hash-based collection would miss an equal value. The synthesized
// hash reads such a member's count instead.

struct BUF is
    data: int[];
    tag: string;

    init(data: int[], tag: string) is
        self.data = data;
        self.tag = tag;
    si
si

struct NESTED is
    rows: int[][];

    init(rows: int[][]) is self.rows = rows; si
si

struct LISTED is
    xs: LIST[string];

    init(xs: LIST[string]) is self.xs = xs; si
si

// An ordering defines the comparison, and this type answers no hash
// of its own, so its members contribute nothing to the hash rather
// than an identity that the comparison would contradict.
struct ORDERED is
    v: int;

    init(v: int) is self.v = v; si

    <>(other: ORDERED) -> int pure => v - other.v;
si

struct HOLDS_ORDERED is
    o: ORDERED;
    tag: int;

    init(o: ORDERED, tag: int) is
        self.o = o;
        self.tag = tag;
    si
si

entry() is
    write_line("array equal: {BUF([1, 2], "x") =~ BUF([1, 2], "x")}");
    write_line("array differing: {BUF([1, 2], "x") =~ BUF([1, 3], "x")}");
    write_line("array hash agrees: {BUF([1, 2], "x").get_hash_code() == BUF([1, 2], "x").get_hash_code()}");

    write_line("nested equal: {NESTED([[1], [2]]) =~ NESTED([[1], [2]])}");
    write_line("nested hash agrees: {NESTED([[1], [2]]).get_hash_code() == NESTED([[1], [2]]).get_hash_code()}");

    write_line("list equal: {LISTED(LIST[string](["a"])) =~ LISTED(LIST[string](["a"]))}");
    write_line("list hash agrees: {LISTED(LIST[string](["a"])).get_hash_code() == LISTED(LIST[string](["a"])).get_hash_code()}");

    write_line("ordered member equal: {HOLDS_ORDERED(ORDERED(1), 2) =~ HOLDS_ORDERED(ORDERED(1), 2)}");
    write_line("ordered member differing: {HOLDS_ORDERED(ORDERED(1), 2) =~ HOLDS_ORDERED(ORDERED(3), 2)}");
    write_line("ordered hash agrees: {HOLDS_ORDERED(ORDERED(1), 2).get_hash_code() == HOLDS_ORDERED(ORDERED(1), 2).get_hash_code()}");

    // the whole point of the pair: an equal value is found in a
    // hash-based collection
    let seen = SET[BUF]();
    seen.add(BUF([1, 2], "x"));
    write_line("set membership: {seen.contains(BUF([1, 2], "x"))}");
    write_line("set rejects differing: {seen.contains(BUF([1, 9], "x"))}");

    let nested_seen = SET[NESTED]();
    nested_seen.add(NESTED([[1], [2]]));
    write_line("nested set membership: {nested_seen.contains(NESTED([[1], [2]]))}");
si
