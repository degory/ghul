use IO.Std.write_line

// Tests: a formal marked past its own function type takes a function
// that returns the N-ary one, and what it returns need not be a
// literal: a named function, a stored value, and a literal whose body
// is one are each presented as the function of the tuple. The pack
// can follow leading parameters, at the marker and along the spine,
// and a literal may write its return out as the N-ary type.

weigh(total: int, a: int, b: int) -> int => total + a * b

pair(a: int, b: int) -> int => a * b

maker(n: int) -> (int, int, int) -> int => weigh

deep[A, T..](make: (int) -> (A, T..) -> A, seed: A, v: T) -> A => make(1)(seed, v)

deeper[A, T..](make: (string) -> (int) -> (A, T..) -> A, seed: A, v: T) -> A => make("x")(1)(seed, v)

plain[T..](make: (int) -> T.. -> int, v: T) -> int => make(1)(v)

keep[A, T.., U](f: (A, T..) -> U) -> (A, T..) -> U => (s, v) => f(s, v)

entry() is
    write_line("{deep((n: int) => weigh, 5, (2, 3))}")
    write_line("{deep((n: int) -> (int, int, int) -> int => weigh, 5, (2, 3))}")
    write_line("{deep((n: int) => (total: int, a: int, b: int) => total + a + b + n, 5, (2, 3))}")
    write_line("{deep[int, (int, int)]((n: int) => weigh, 5, (2, 3))}")
    write_line("{deep(maker, 5, (2, 3))}")

    let m = maker
    write_line("{deep(m, 5, (2, 3))}")

    write_line("{deeper((s: string) => maker, 5, (2, 3))}")
    write_line("{deeper((s: string) => (n: int) => weigh, 5, (2, 3))}")

    write_line("{plain((n: int) => pair, (2, 3))}")

    let g: (int, int, int) -> int = keep((s, a, b) => s + a * b)
    write_line("{g(1, 2, 3)}")

    let h: (int, int, int) -> int = keep(weigh)
    write_line("{h(1, 2, 3)}")
si
