struct POINT is
    x: int; y: int;
    init(x: int, y: int) is self.x = x; self.y = y; si
    deconstruct(a: int ref, b: int ref) is
        a! = x;
        b! = y;
    si
si

add_pair((a: int, b: int): (int, int)) -> int => a + b;

nested(((a: int, b: int): (int, int), c: int): ((int, int), int)) -> int => a + b + c;

mixed(x: int, (a: int, b: int): (int, int), y: int) -> int => x + a + b + y;

mutate((a: int, b: int): (int, int)) -> int is
    let sum mut = a;
    sum = sum + 100;
    return sum + b;
si

sum_point((a: int, b: int): POINT) -> int => a + b;

entry() static is
    IO.Std.write_line("{add_pair((3, 4))}");
    IO.Std.write_line("{nested(((1, 2), 3))}");
    IO.Std.write_line("{mixed(10, (1, 2), 20)}");
    IO.Std.write_line("{mutate((1, 2))}");
    IO.Std.write_line("{sum_point(POINT(5, 7))}");
si
