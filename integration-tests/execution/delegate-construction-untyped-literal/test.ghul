namespace Test is
    use IO.Std;
    use Collections;

    // The literals' parameter types come only from the delegate type
    // being constructed, not from any annotation or argument slot.
    entry() static is
        let xs = LIST[int]([3, 1, 2]);

        xs.sort(System.Comparison[int]((a, b) => b - a));

        Std.write_line("{xs[0]} {xs[1]} {xs[2]}");

        let ascending = System.Comparison[int]((a, b) => a - b);

        xs.sort(ascending);

        Std.write_line("{xs[0]} {xs[1]} {xs[2]}");

        let longer_than_two = System.Predicate[string](s => s.length > 2);

        Std.write_line("{longer_than_two.invoke("abc")} {longer_than_two.invoke("a")}");
    si
si
