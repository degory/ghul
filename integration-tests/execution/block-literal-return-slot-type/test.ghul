use IO.Std.write_line

use Ghul.Result

run(f: () -> Result[int, string]) -> Result[int, string] => f()

entry() is
    let a = run(() is
        return Result.OK(1)
    si)

    let b = run(() is
        if a? then
            return Result.ERROR("failed")
        fi

        return Result.OK(2)
    si)

    write_line("{a?} {b?}")
si
