// With `--sdk-ref-path` and no `-a`, the compiler references the whole
// pack, so a type from any framework assembly resolves without naming
// the assembly. Each line below lives in an assembly outside the
// original five-assembly default set.
use IO.Std.write_line

let complex = System.Numerics.Complex(3.0D, 4.0D)
write_line("{complex.magnitude}")

write_line("{System.Text.RegularExpressions.Regex.is_match("abc", "b")}")

write_line("{System.Linq.Enumerable.max([3, 1, 2])}")

let thread = System.Threading.Thread(System.Threading.ThreadStart(() => write_line("thread")))
thread.start()
thread.join()

write_line(System.Text.Json.JsonSerializer.serialize([1, 2, 3], System.Text.Json.JsonSerializerOptions()))
