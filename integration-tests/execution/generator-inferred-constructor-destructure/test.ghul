namespace Test is
    use Std = IO.Std;

    class Main is
        gen(limit: int) -> Ghul.Pipes.Pipe[long] static is
            let pending = Collections.Queue();

            for i in 1..limit do
                pending.enqueue((cast long(i), i * 10));
            od

            while pending.count > 0 do
                let (value, scaled) = pending.dequeue();

                Std.write_line("scaled: {scaled}");

                yield value;
            od
        si

        entry() static is
            for v in gen(4) do
                Std.write_line("v: {v}");
            od
        si
    si
si
