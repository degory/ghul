// The documented parameter order, selected by name: both recognised
// parameters are matched by type rather than by position, so this is
// the same entry point as the reversed order beside it, and the shape
// check sees the wrapper rather than these two parameters.
entry(args: string[], env: Ghul.Environment) is
    env["GHUL_ENTRY_ORDER_TEST_VAR"] = "set"

    IO.Std.write_line("{args.count} {env["GHUL_ENTRY_ORDER_TEST_VAR"]}")
si
