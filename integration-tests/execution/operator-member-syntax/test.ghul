namespace Test is
    use IO.Std.write_line;

    class BOX is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: BOX) -> bool => v == other.v;
        <>(other: BOX) -> int => v - other.v;
        +(other: BOX) -> BOX => BOX(v + other.v);
        get_hash_code() -> int => v;
    si

    class Main is
        entry() static is
            let a = BOX(1);
            let b = BOX(2);

            // an operator is an ordinary member and can be called as
            // one, spelled either with a space after the dot or with a
            // backtick escape. Without one of the two the tokenizer
            // scans `.=~` as a single operator token.
            write_line("{a. =~(b)}");
            write_line("{a.`=~(b)}");
            write_line("{a. =~(BOX(1))}");

            write_line("{a. <>(b)}");
            write_line("{a.`<>(b)}");

            write_line("{(a. +(b)).v}");
            write_line("{(a.`+(b)).v}");

            // chains, and against the operator spelling of the same call
            write_line("{(a. +(b). +(a)).v}");
            write_line("{a =~ b}");

            return;
        si
    si
si
