// A class member with the same name and arguments as an inherited one but a
// return type the inherited one does not accept hides it rather than
// overriding it, as a task with a result hides the awaiter of a task
// without one. A caller holding the subclass reaches the subclass's member;
// one holding the base reaches the base's, even for a subclass instance.
// A member whose return does fit still overrides, and super reaches the
// hidden member.
use IO.Std.write_line

class NOTHING is
    init() is si

    describe() -> string => "nothing"
si

class VALUE[T] is
    _value: T

    init(value: T) is
        _value = value
    si

    value: T => _value

    describe() -> string => "a value"
si

class MY_TASK is
    init() is si

    result() -> NOTHING => NOTHING()

    name() -> string => "a task"
si

class MY_TASK[T]: MY_TASK is
    _value: T

    init(value: T) is
        super.init()
        _value = value
    si

    @suppress("hides-inherited")
    result() -> VALUE[T] => VALUE[T](_value)

    name() -> string => "a task with a result"

    base_result() -> NOTHING => super.result()
si

entry() is
    let typed = MY_TASK[int](42)
    let base: MY_TASK = typed

    write_line(typed.result().describe())
    write_line(base.result().describe())
    write_line(base.name())
    write_line(typed.base_result().describe())

    write_line(typed.result().value.to_string())

    for task in [MY_TASK(), typed] do
        write_line(task.name())
        write_line(task.result().describe())
    od
si
