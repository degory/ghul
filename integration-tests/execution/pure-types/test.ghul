namespace Test is
    use IO.Std;

    // Pure types end to end: provable members need no annotation,
    // statics are exempt and keep their own state, a declared-pure
    // member is trusted though it stores, a bodiless class member is a
    // contract its overrides must satisfy, and a pure trait's implicit
    // declarations bind implementors - including through properties.

    struct POINT pure is
        x: int;
        y: int;

        init(x: int, y: int) is
            self.x = x;
            self.y = y;
        si

        manhattan() -> int =>
            (if x < 0 then 0 - x else x fi) + (if y < 0 then 0 - y else y fi);
    si

    class BOX[T] pure is
        item: T;

        init(v: T) is
            item = v;
        si

        get() -> T => item;
    si

    trait NAMED pure is
        name: string;
        label() -> string;
    si

    class USER: NAMED is
        name: string;

        init(n: string) is
            name = n;
        si

        label() -> string => "<{name}>";
    si

    class SHAPE pure abstract is
        area() -> double;
        describe() -> string => "shape";
    si

    class SQUARE: SHAPE is
        side: double;

        init(s: double) is
            side = s;
        si

        area() -> double => side * side;
    si

    class SERIAL pure is
        _next: int static;
        _id: int;

        init() static is
            _next = 100;
        si

        init() is
            _id = _next;
            _next = _next + 1;
        si

        id() -> int => _id;

        // Declared pure: trusted though it stores, like any other pure
        // declaration. The type promise does not verify it.
        reset_counter() pure static is
            _next = 0;
        si
    si

    entry() is
        let p = POINT(3, 4);
        Std.write_line("manhattan: {p.manhattan()}");

        let b = BOX("hello");
        Std.write_line("box: {b.get()}");

        let u = USER("alice");
        Std.write_line("label: {u.label()}");

        let s = SQUARE(2.0D);
        Std.write_line("area: {s.area()} {s.describe()}");

        let first = SERIAL();
        let second = SERIAL();
        Std.write_line("serials: {first.id()} {second.id()}");

        SERIAL.reset_counter();
        Std.write_line("after reset: {SERIAL().id()}");
    si
si
