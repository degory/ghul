use default

// A local initialized or assigned with `null` takes its type from what
// else is assigned to it, or from the value `??` falls back to, and is
// optional because it has held absence.
class NODE is
    name: string
    init(name: string) is self.name = name si
si

let root mut = null

for name in ["first", "second"] do
    root = NODE(name)
od

write_line("root: {root!.name}")

let unknown = null

if unknown ?? false then
    write_line("unknown is true")
else
    write_line("unknown is absent or false")
fi

let missing = null
write_line("missing: {missing ?? "a fallback"}")

deferred() is
    let r mut
    r = null
    write_line("deferred absent: {r?.name ?? "none"}")
    r = NODE("third")
    write_line("deferred present: {r.name}")
si

deferred()
