namespace Test is
    use Std = IO.Std;

    class Main is
        pair_stream((a, b): (int, int)) -> Ghul.Pipes.Pipe[int] static is
            yield a;
            yield b;
        si

        entry() static is
            for x in pair_stream((3, 4)) do
                Std.write_line("got={x}");
            od
        si
    si
si
