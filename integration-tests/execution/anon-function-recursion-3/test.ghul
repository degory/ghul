use IO.Std.write_line;

entry() is
    test_call_function();
si

apply_n[T,R](f: (T) -> R, i: T) -> R =>
    f(i);

test_call_function() is
    let fibonacci = (i: int) rec => 
    if i < 2 then
        i
    else
        apply_n(rec, i - 1) + apply_n(rec, i - 2)
    fi;

    for i in 0..10 do
        write_line("fibonacci({i}) is {fibonacci(i)}");
    od
si
