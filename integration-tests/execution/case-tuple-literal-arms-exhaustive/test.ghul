namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            // Every literal-leaf arm here only matches one combination of
            // values, so the arms are not a catch-all even though they
            // happen to cover the whole (bool, bool) domain. Without an
            // `else`, the compiler used to treat any pattern arm as a
            // catch-all and skip both the exhaustive-throw and the
            // default-fallthrough IL, leaving the no-match path with
            // nothing pushed for the JIT to reject at run time.
            Std.write_line("{pair(true, true)}");
            Std.write_line("{pair(true, false)}");
            Std.write_line("{pair(false, true)}");
            Std.write_line("{pair(false, false)}");
        si

        pair(a: bool, b: bool) -> int static =>
            case (a, b)
            when (true, true) then 3
            when (true, false) then 2
            when (false, true) then 1
            when (false, false) then 0
            esac;
    si
si
