use IO.Std.write_line

enum Level is
    INFO,
    WARN,
    ERROR
si

@System.Flags()
enum Access is
    NONE = 0,
    READ = 1,
    WRITE = 2,
    EXECUTE = 4
si

class HOLDER is
    level: Level;
    init(level: Level) is self.level = level; si
si

entry() is
    let l = Level.WARN
    write_line("{l} {Level.INFO} {HOLDER(Level.ERROR).level} {l.to_string()} {l == Level.WARN} {l > Level.INFO}")
    let rw = Access.READ | Access.WRITE
    write_line("{rw} {Access.NONE} {Access.EXECUTE} {rw | Access.EXECUTE} {rw.to_string()}")
si
