namespace Test is
    use Std = IO.Std;

    struct GEN[T] is
        _present: bool;

        item() -> string => "{get_type()} here";

        init(present: bool) is
            _present = present;
        si
    si

    class Main is
        entry() static is
            let g = GEN[int](true);

            Std.write_line(g.item());
        si
    si
si
