use IO.Std.write_line

// Integer arithmetic that overflows wraps around, as unchecked .NET
// arithmetic does, and a comparison the wrap makes false stays false: the
// optimiser may not assume overflow cannot happen. The values come through a
// function so none is known before the program runs.

int_value(n: int) -> int => n
long_value(n: long) -> long => n

grows(n: int) -> bool => n + 1 > n

let most = int_value(2147483647)
let least = int_value(-2147483647 - 1)

write_line("int: {most + 1} {least - 1} {most * 2} {-least}")
write_line("long: {long_value(9223372036854775807L) + 1L} {long_value(4611686018427387904L) * 4L}")
write_line("uint: {cast uint(int_value(0)) - 1u} {cast uint(int_value(-1)) + 2u}")
write_line("grows: {grows(int_value(1))} {grows(most)}")
