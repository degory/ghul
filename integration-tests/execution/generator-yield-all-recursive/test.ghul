namespace Test is
    use Std = IO.Std;

    use Ghul.Pipes;
    use Ghul.Pipes.Pipe;

    union Tree[T] is
        EMPTY;
        NODE(value: T, left: Tree[T], right: Tree[T]);
    si

    class Main is
        preorder[T](tree: Tree[T]) -> Pipe[T] static is
            if let (value, left, right): Tree.NODE = tree then
                yield value;
                yield in preorder(left);
                yield in preorder(right);
            fi
        si

        inorder[T](tree: Tree[T]) -> Pipe[T] static is
            if let (value, left, right): Tree.NODE = tree then
                yield in inorder(left);
                yield value;
                yield in inorder(right);
            fi
        si

        leaf[T](value: T) -> Tree[T] static =>
            Tree.NODE(value, Tree.EMPTY[T], Tree.EMPTY[T]);

        entry() static is
            let tree =
                Tree.NODE(1,
                    Tree.NODE(2, Tree.NODE(4, leaf(7), Tree.EMPTY[int]), leaf(5)),
                    Tree.NODE(3, Tree.NODE(6, leaf(8), leaf(9)), Tree.EMPTY[int]));

            Std.write_line("preorder: {preorder(tree) |> join(" ")}");
            Std.write_line("inorder:  {inorder(tree) |> join(" ")}");
        si
    si
si
