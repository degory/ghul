namespace Test is
    use Std = IO.Std;

    class Main is
        // A val-block whose body suspends and whose contributors
        // include a settled `null`: the targeted return contributes
        // `string`, the `null` tail joins as optionality, and the
        // block settles at `string?` — the async frame's spill field
        // is typed from that, not from the null type itself.
        async_null_tail(flag: bool) -> Tasks.TASK[string?] static is
            let r: string? = val
                let s = await Tasks.TASK.from_result("hit");
                if flag then return s fi;
                null
            lav;

            return r;
        si

        // Same shape over a value type: the block widens to `int?`,
        // the spill field is a Nullable[int], and the int return is
        // wrapped into it while the null tail lowers to its default.
        async_null_tail_value(flag: bool) -> Tasks.TASK[int?] static is
            let r: int? = val
                let n = await Tasks.TASK.from_result(5);
                if flag then return n fi;
                null
            lav;

            return r;
        si

        // A targeted `return null` is a contributor too, and joins
        // the same way.
        async_return_null(flag: bool) -> Tasks.TASK[string?] static is
            let r: string? = val
                await Tasks.TASK.from_result(0);
                if flag then return "yes" fi;
                return null;
            lav;

            return r;
        si

        // Without a suspend the block captures instead of spilling;
        // the null tail still widens the join to `string?`.
        sync_null_tail() -> string? static is
            let r: string? = val
                let t mut = 0;
                if t > 0 then "pos" else "neg" fi;
                null
            lav;

            return r;
        si

        entry() static is
            Std.write_line("async flag=true: {Main.async_null_tail(true).result}");
            Std.write_line("async flag=false: {Main.async_null_tail(false).result}");
            Std.write_line("value flag=true: {Main.async_null_tail_value(true).result}");
            Std.write_line("value flag=false: {Main.async_null_tail_value(false).result}");
            Std.write_line("ret-null flag=true: {Main.async_return_null(true).result}");
            Std.write_line("ret-null flag=false: {Main.async_return_null(false).result}");
            Std.write_line("sync: {Main.sync_null_tail()}");
        si
    si
si
