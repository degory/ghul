namespace Test is
    use Std = IO.Std;

    // A tuple is a struct, so == and != are rejected on one (see
    // semantic/struct-equality-operator-rejected). =~ compares it
    // through the runtime's default equality comparer, which reaches
    // ValueTuple's own element-wise equality - so each element
    // compares the way that element's type compares, however deep
    // the tuple nests.
    class BOX is
        _v: int;

        init(v: int) is _v = v; si

        =~(other: BOX) -> bool => _v == other._v;

        get_hash_code() -> int => _v;
    si

    class NODE is
        _v: int;

        init(v: int) is _v = v; si
    si

    class TABLE is
        _a: int;

        init() is _a = 1; si

        bump() is _a = _a + 1; si

        // The operand shape from the report: a call result on the left
        // of the comparison, which is where the bare ceq the tuple used
        // to lower to was refused outright by the JIT.
        sizes() -> (functions: int, opaque: int) => (_a, 2);

        unchanged(passed: (functions: int, opaque: int)) -> bool =>
            sizes() =~ passed;
    si

    class Main is
        entry() static is
            Std.out.write_line("expect True False: scalars: {(1, 2) =~ (1, 2)} {(1, 2) =~ (1, 3)}");

            Std.out.write_line("expect False True: !~: {(1, 2) !~ (1, 2)} {(1, 2) !~ (1, 3)}");

            // The reason == cannot stand in: a reference element
            // compares by value here, where ceq compared the field by
            // identity and answered False for two equal strings.
            let a = "hello";
            let b = "{"hel"}{"lo"}";

            Std.out.write_line("expect True: string element by value: {(a, 1) =~ (b, 1)}");

            Std.out.write_line("expect True False: named elements: {(x = 1, y = 2) =~ (x = 1, y = 2)} {(x = 1, y = 2) =~ (x = 1, y = 3)}");

            Std.out.write_line("expect True False: nested: {((1, 2), "z") =~ ((1, 2), "z")} {((1, 2), "z") =~ ((1, 3), "z")}");

            // Each element goes through its own type's equality, so a
            // class declaring =~ answers with its operator and one
            // declaring none answers by reference.
            Std.out.write_line("expect True False: =~ class element: {(BOX(1), 0) =~ (BOX(1), 0)} {(BOX(1), 0) =~ (BOX(2), 0)}");

            Std.out.write_line("expect False: no-operator class element: {(NODE(1), 0) =~ (NODE(1), 0)}");

            let table = TABLE();
            let saved = table.sizes();

            Std.out.write_line("expect True: call result on the left: {table.unchanged(saved)}");

            table.bump();

            Std.out.write_line("expect False: after a change: {table.unchanged(saved)}");
        si
    si
si
