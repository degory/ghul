use IO.Std.write_line

// A uint, ulong or uword with its top bit set is a large positive number,
// and stays one when widened to a signed integer or to a floating type.
from_uint(u: uint) is
    write_line("uint {u}: long {cast long(u)}, word {cast word(u)}, ulong {cast ulong(u)}, uword {cast uword(u)}")
    write_line("uint {u}: double {cast double(u)}, single {cast single(u)}")
si

from_ulong(u: ulong) is
    write_line("ulong {u}: double {cast double(u)}, single {cast single(u)}, uword {cast uword(u)}")
si

from_uword(u: uword) is
    write_line("uword {u}: double {cast double(u)}, single {cast single(u)}, ulong {cast ulong(u)}")
si

from_narrow(b: ubyte, s: ushort, c: char) is
    write_line("ubyte {b}: int {cast int(b)}, long {cast long(b)}, double {cast double(b)}, single {cast single(b)}")
    write_line("ushort {s}: int {cast int(s)}, long {cast long(s)}, double {cast double(s)}, single {cast single(s)}")
    write_line("char {cast int(c)}: int {cast int(c)}, long {cast long(c)}, double {cast double(c)}, single {cast single(c)}")
si

entry() is
    from_uint(0u)
    from_uint(2147483647u)
    from_uint(2147483648u)
    from_uint(4294967295u)

    from_ulong(0ul)
    from_ulong(9223372036854775807ul)
    from_ulong(9223372036854775808ul)
    from_ulong(18446744073709551615ul)

    from_uword(cast uword(0ul))
    from_uword(cast uword(9223372036854775808ul))
    from_uword(cast uword(18446744073709551615ul))

    from_narrow(255ub, 65535us, cast char(65535))

    let u = 4294967295u
    let big = 18446744073709551615ul

    write_line("inline: {cast double(u)} {cast long(u)} {cast double(big)}")
si
