namespace Test is
    use IO.Std.write_line

    last_is_null(x: int) -> string? is
        let y = x + 1
        null
    si

    only_null(x: int) -> string? is
        null
    si

    parenthesised(x: int) -> string? is
        let y = x + 1
        (null)
    si

    entry() is
        write_line("[{last_is_null(1)}][{only_null(1)}][{parenthesised(1)}]")
    si
si
