// A body's tail is judged by its type, never by its terminator: a
// final expression assignable to the declared return type is the
// return value with or without its `;`, a void tail falls through to
// the default value under the definite-return warning, and an
// asynchronous body delivers a terminated bare-T tail the same way.
use IO.Std.write_line

terminated(x: int) -> int is
    x * 10;
si

unterminated(x: int) -> int is
    x * 100
si

void_tail(label: string) -> int is
    write_line(label);
si

async_terminated(x: int) -> Tasks.TASK[int] is
    x + 7;
si

entry() is
    write_line("{terminated(4)}")
    write_line("{unterminated(4)}")
    write_line("{void_tail("effect only")}")
    write_line("{async_terminated(3).result}")
si
