// A function declared `pure` satisfies a pure function-typed slot on
// the strength of its declaration: the contract is enforced on every
// override and survives into assembly metadata, so nothing about the
// body has to be proved at the call site. The same holds for a
// function reference bound to a receiver, and for one reached through
// a pipe combinator's pure parameter. A named function that writes is
// still refused, and the refused call still drops heap facts.

use Std = IO.Std;

_counter: int;

double(x: int) -> int pure => x * 2;
is_even(x: int) -> bool pure => x % 2 == 0;

bump(x: int) -> int is
    _counter = _counter + x;

    return x;
si

take(f: (int) -> int pure) -> int => f(21);

class BOX is
    _scale: int;
    _tag: string?;

    init(scale: int, tag: string?) is
        _scale = scale;
        _tag = tag;
    si

    scale(x: int) -> int pure => x * _scale;

    probe() is
        if _tag? then
            let n = take(scale);

            Std.write_line("kept: {_tag.length} {n}");
        fi
    si
si

entry() is
    Std.write_line("{take(double)}");
    Std.write_line("{take(bump)}");

    let xs = [1, 2, 3, 4];

    Std.write_line("{xs | .map(double) .join(",")}");
    Std.write_line("{xs | .filter(is_even) .join(",")}");

    BOX(3, "hi").probe();
si
