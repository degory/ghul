use default

probe() -> int is
    let held = LIST[int]()
    let spilled = LIST[int]()

    let spill = () is
        if held.count == 0 then
            return
        fi

        spilled.add(held.count)
        held.clear()
    si;

    spill()
    held.add(1)
    spill()

    spilled.count
si

write_line("{probe()}")
