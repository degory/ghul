namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;
    use Collections.LIST;

    // Tests: the argument-pack-adapted sibling of
    // nested-lambda-if-body-param-inference. The outer callback here
    // takes two parameters (`row`, `column`) spread from `index()`'s
    // pack, so it is wrapped by FUNCTION_REFERENCE_ADAPTER.try_adapt_packed
    // rather than compiled directly - `column`'s type must still be
    // inferable from a nested lambda's `if`-expression body that
    // compares it against the nested lambda's own inferred parameter.

    class Main is
        entry() static is
            let rows = LIST([1, 3]);

            rows |> index() |> each((row, column) =>
                write_line((0..2) |> map(c => if c == column then "Q" else "." fi) |> join(" ")));

            return;
        si
    si
si
