namespace Test is
    use IO.Std;

    // Tests: a lambda that captures the receiver, written in a method
    // that lives in a `partial` or `impl` block rather than in the type's
    // own body. The block is a scope of its own, so the enclosing
    // instance type has to be found through the scope stack for the
    // captured-receiver field to get a well-formed type.

    trait Printer is
        print() -> string;
    si

    class HOLDER is
        value: int public;

        init(value: int) is self.value = value; si
    si

    partial HOLDER is
        show() -> void is
            let k = 2;
            let f = (a: int) -> int => a + k + value;
            Std.write_line("{f(1)}");
        si
    si

    impl Printer for HOLDER is
        print() -> string is
            let k = 3;
            let f = () -> int => value * k;

            return "{f()}";
        si
    si

    class BOX[T] is
        item: T public;

        init(item: T) is self.item = item; si
    si

    partial BOX[T] is
        show() -> void is
            let k = 1;
            let f = () -> string => "{item} {k}";
            Std.write_line(f());
        si
    si

    class Main is
        entry() static is
            let h = HOLDER(4);

            h.show();
            Std.write_line(h.print());

            BOX[int](9).show();

            return;
        si
    si
si
