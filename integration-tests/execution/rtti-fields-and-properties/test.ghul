use IO.Std.write_line
use System.Reflection.BindingFlags

class ANIMAL is
    name: string public

    init() is
        name = "animal"
    si
si

class DOG: ANIMAL is
    legs: int public
    nick: string?
    _owner: string
    weight: double field

    init() is
        super.init()
        _owner = "nobody"
    si

    shout: string => name.to_upper()
si

class HOOK is
    on_bark: (string) -> void public

    init() is
        on_bark = s => write_line(s)
    si
si

entry() is
    let all = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.INSTANCE
    let t = typeof DOG

    write_line("{t.name} extends {t.base_type!.name}, class {t.is_class}, value type {t.is_value_type}")

    write_line("declared fields:")

    for f in t.get_fields(all | BindingFlags.DECLARED_ONLY) do
        write_line("  {f.name}: {f.field_type.name}, public {f.is_public}")
    od

    write_line("public fields, inherited included:")

    for f in t.get_fields() do
        write_line("  {f.name}")
    od

    write_line("properties:")

    for p in t.get_properties() do
        write_line("  {p.name}: {p.property_type.name}, read {p.can_read}, write {p.can_write}, public setter {p.get_set_method()?}")
    od

    let dog = System.Activator.create_instance(t)!

    t.get_property("name")!.set_value(dog, "Rex")
    t.get_property("legs")!.set_value(dog, 4)
    t.get_field("weight")!.set_value(dog, 12.5)
    t.get_field("_owner", all)!.set_value(dog, "Ada")

    write_line("{t.get_property("name")!.get_value(dog)} {t.get_property("legs")!.get_value(dog)} {t.get_field("weight")!.get_value(dog)} {t.get_field("_owner", all)!.get_value(dog)}")
    write_line("{t.get_property("shout")!.get_value(dog)} {t.get_property("nick")!.get_value(dog)}")
    write_line("{t.get_property("shout")!.can_write}")
    write_line("{(typeof HOOK).get_property("on_bark")!.property_type.is_class}")

    if let d: DOG = dog then
        write_line("{d.name} {d.legs} {d.weight}")
    fi
si
