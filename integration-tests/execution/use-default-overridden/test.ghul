use default

// `--default-use` replaces the curated set rather than adding to it, so
// this file gets `Collections` and nothing else: `LIST` resolves, and
// `write_line` has to be imported by name.
use IO.Std.write_line

entry() is
    let names = LIST[string]()

    names.add("only")

    write_line(names[0])
si
