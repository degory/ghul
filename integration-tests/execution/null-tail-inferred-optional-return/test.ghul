namespace Test is
    use IO.Std;

    // Tests: a `null` tail in a block-bodied function whose return
    // type is a pinned non-void optional. `NULL.matches` answers true
    // for every type, so the tail read as void and the demand went
    // undelivered - the body left a stray value on the stack ahead of
    // the fall-through default, and the JIT rejected the method.

    some(n: int) -> int? => n;

    class Main is
        entry() static is
            // inferred return, pinned by the earlier `return`
            let f = (n: int) is if n > 2 then return some(n); fi; null si;

            let r mut = f(1);

            Std.write_line("f(1) present: {r?}");
            Std.write_line("f(1) value: {r ?? 0}");

            r = f(2);

            Std.write_line("f(2) present: {r?}");
            Std.write_line("f(2) value: {r ?? 0}");

            // declared value-type optional return
            let g = (n: int) -> int? is if n > 2 then return some(n); fi; null si;

            Std.write_line("g(3): {g(3)!}");

            // declared reference-optional return
            let h = (n: int) -> string? is if n > 2 then return "big"; fi; null si;

            Std.write_line("h(1) is null: {h(1) == null}");
            Std.write_line("h(3): {h(3)!}");

            // a null tail in a void body is a discarded statement
            let w = (n: int) -> void is if n > 5 then Std.write_line("big"); fi; null si;

            w(1);

            Std.write_line("done");

            return;
        si
    si
si
