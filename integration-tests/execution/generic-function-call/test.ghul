namespace Test is
    use IO.Std;

    // Calling a generic function at an instantiation needs a
    // MethodSpec naming the open definition plus the arguments. A
    // definition row names the uninstantiated method, which the
    // runtime refuses to call.
    identity[T](value: T) -> T => value;

    first[A, B](a: A, b: B) -> A => a;

    class BOX[T] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        // A generic method on a generic type needs both instantiations:
        // the owner's, through a reference on its specification, and
        // the method's own. A definition row carries neither.
        pair[U](other: U) -> string => "{_value}/{other}";
    si

    class Main is
        entry() static is
            Std.write_line("{identity[int](7)}");
            Std.write_line(identity[string]("text"));
            Std.write_line("{first[int, string](1, "two")}");
            Std.write_line(BOX[int](3).pair[string]("x"));
        si
    si
si
