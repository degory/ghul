use IO.Std.write_line
use Ghul.Pipes

// Tests: a bigint held as an object calls its own methods, unboxes back to
// a bigint, and reports its .NET type name, on every target.

let big = bigint.pow(10n, 25)
let o: object = big

write_line("{o}")
write_line(o.to_string())
write_line("{o.get_hash_code() == big.get_hash_code()}")
write_line("{cast bigint(o) + 1n}")
write_line(o.get_type().to_string())
write_line([1n, 22n, big] |> join(" "))
write_line($(5n))
