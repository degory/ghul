namespace Test is
    use IO.Std.write_line;

    // Tests: a type whose type parameter is a pack, storing handlers as
    // the tuple-in spelling of the same function type. The subscribe
    // formal takes the pack reading; a lambda written into it is
    // destructured, typed or untyped, once T is pinned by the
    // construction.

    class EVENT[T..] is
        handlers: Collections.LIST[(T) -> void] field;

        init() is
            handlers = Collections.LIST[(T) -> void]();
        si

        subscribe(handler: T.. -> void) is
            handlers.add(handler);
        si

        raise(v: T..) is
            for h in handlers do
                h(v);
            od
        si
    si

    entry() is
        let e = EVENT[(int, string)]();

        let got mut = "";

        e.subscribe((n: int, s: string) -> void is
            got = "{n}/{s}";
        si);
        e.raise(7, "seven");
        write_line(got);

        let other mut = "";

        e.subscribe((n, s) -> void is
            other = "{s}!{n}";
        si);
        e.raise(8, "eight");
        write_line(other);
    si
si
