use IO.Std.write_line

// A tuple built, read element by element, destructured, and named.
pair(n: int) -> (string, int) => ("n{n}", n * 2)

entry() is
    let p = pair(3)
    write_line("{p.`0} {p.`1}")

    let (name, twice) = pair(5)
    write_line("{name} {twice}")

    let named = (first = "a", second = 'b')
    write_line("{named.first}{named.second}")
si
