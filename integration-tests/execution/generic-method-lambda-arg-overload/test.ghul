namespace Test is
    use IO.Std;

    // A lambda passed to a generic method of a constructed generic type
    // takes its parameter type from the method's formal, so `describe`
    // must resolve to the object overload throughout - including when
    // the owner's type argument is itself a type variable and the
    // method's own type argument binds from no other argument.
    //
    // An untyped lambda parameter matches the sequence overload
    // instead, and the emitted call then reinterprets the element as a
    // sequence, so a wrong answer here is a miscompile rather than a
    // difference in formatting.

    describe(o: object?) -> string => "object";

    describe[E](i: Collections.Iterable[E]) -> string => "sequence";

    class BOX[B] is
        _value: B;

        init(value: B) is
            _value = value;
        si

        apply[R](f: (B) -> R) -> R => f(_value);
    si

    through_generic_owner[U](value: U) -> string => BOX(value).apply(x => describe(x));

    through_concrete_owner(value: int) -> string => BOX(value).apply(x => describe(x));

    // the same shape through the runtime's own generic pipe methods: the
    // element type is only a type variable while the enclosing function
    // is generic, so the call has to be made from one
    describe_each[T](values: Collections.Iterable[T]) -> string =>
        Ghul.Pipes.join(Ghul.Pipes.pipe(values) | .map(x => describe(x)), ",");

    entry() is
        Std.write_line(through_generic_owner(42));
        Std.write_line(through_concrete_owner(42));
        Std.write_line(through_generic_owner("text"));
        Std.write_line(describe_each([1, 2, 3]));
    si
si
