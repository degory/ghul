namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A `for` over a `map`/`filter` pipe chain whose base source is a
    // collection - a LIST[int], and a variable typed as the Iterable[int]
    // interface, so the dynamic type is not visible at the call. A chain of
    // `Ghul.Pipes` free functions resolves statically whatever the source
    // turns out to be, so both fuse, and the result must match the unfused
    // lowering.

    class Main is
        entry() static is
            let xs = LIST[int]([1, 2, 3, 4, 5]);

            // map then filter over a concrete LIST source.
            for x in xs |> map(n => n * 10) |> filter(n => n > 20) do
                Std.write_line("map/filter: {x}");
            od

            // filter only.
            for x in xs |> filter(n => n % 2 == 0) do
                Std.write_line("filter: {x}");
            od

            // Source typed as the Iterable interface.
            let ys: Iterable[int] = LIST[int]([10, 20, 30, 40]);
            for x in ys |> map(n => n + 1) |> filter(n => n > 21) do
                Std.write_line("iterable: {x}");
            od
        si
    si
si
