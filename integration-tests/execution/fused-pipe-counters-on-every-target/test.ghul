use IO.Std.write_line
use Ghul.Pipes

entry() is
    let xs = [10, 20, 30, 40, 50]

    for item in xs |> index() do
        write_line("{item.index} {item.value}")
    od

    for x in xs |> skip(2) do
        write_line("skipped to {x}")
    od

    for x in xs |> skip(1) |> take(2) do
        write_line("window {x}")
    od
si
