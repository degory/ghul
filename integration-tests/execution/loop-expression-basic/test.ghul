namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            // for: value found
            let xs = [1, 2, 3, 4];

            let found: int? = for x in xs do
                if x > 2 then break x fi;
            od;

            check("for-value", found =~ 3);

            // for: exhausted
            let absent: int? = for x in xs do
                if x > 99 then break x fi;
            od;

            check("for-absent", !absent?);

            // while: break with a value
            let n mut = 0;
            let word: string? = while n < 10 do
                n = n + 1;
                if n == 3 then break "three" fi;
            od;

            check("while-value", word =~ "three");

            // while: exhaustion yields absence
            let never: string? = while false do
                break "unreachable";
            od;

            check("while-never", !never?);

            // do: unconditional body, break decides
            let m mut = 0;
            let parity: string? = do
                m = m + 1;
                if m % 2 == 0 then break "even" fi;
                break "odd";
            od;

            check("do-value", parity =~ "odd");

            // break null is indistinguishable from exhaustion
            let explicit: int? = for x in xs do
                if x == 2 then break null fi;
            od;

            check("break-null", !explicit?);

            // bare break exits without a value
            let bare: int? = for x in xs do
                if x == 1 then break fi;
            od;

            check("bare-break", !bare?);

            // inferred result type
            let inferred = while true do
                break 7;
            od;

            check("inferred", inferred =~ 7);

            // expected type flows down: the loop's value feeds a call
            let doubled: int? = for x in xs do
                if x > 3 then break twice(x) fi;
            od;

            check("expected-down", doubled =~ 8);
        si

        twice(x: int) -> int static => x * 2;

        check(name: string, ok: bool) static is
            if ok then
                Std.write_line("ok {name}");
            else
                Std.write_line("FAIL {name}");
            fi
        si
    si
si
