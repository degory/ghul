use IO.Std.write_line
use Collections.LIST
use Collections.MAP
use Ghul.Pipes

// A construction whose type argument is settled by later use, where
// the later use supplies a type variable of an enclosing declaration
// rather than a concrete type. The variable stands for a definite
// type wherever it is read, so it settles the construction as
// readily as a concrete type does.
collect_one[T](value: T) -> LIST[T] is
    let xs = LIST()

    xs.add(value)

    return xs
si

class HOLDER[T] is
    _value: T

    init(value: T) is _value = value; si

    // The variable is the declaring class's own, reached from a
    // method written inside it.
    twice() -> LIST[T] is
        let ys = LIST()

        ys.add(_value)
        ys.add(_value)

        return ys
    si

    // Two variables from two enclosing declarations at once, and the
    // one belonging to the method reaches a slot of its own.
    keyed[K](key: K) -> MAP[K, T] is
        let m = MAP()

        m[key] = _value

        return m
    si
si

entry() is
    write_line("{collect_one(42) |> join(",")}")
    write_line("{collect_one("hi") |> join(",")}")
    write_line("{HOLDER("x").twice() |> join(",")}")

    let keyed = HOLDER(7).keyed("k")

    write_line("{keyed.count} {keyed["k"]}")
si
