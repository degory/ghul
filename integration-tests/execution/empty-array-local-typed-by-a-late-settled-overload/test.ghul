use default

// The overload that types an untyped local initialized with `[]` is
// itself chosen by an argument nothing has settled yet: `n` takes its
// type from the assignment below the call, so the local is settled two
// walks after it is written. The object element type is a default, and a
// default is taken once the walks have stopped rather than by the walk
// after the local first waited.
describe(xs: int[], n: int) -> string => "int {xs.count} {n}"

describe(xs: string[], s: string) -> string => "string {xs.count} {s}"

late() is
    let waiting = []
    let n mut

    let described = describe(waiting, n)

    n = 3

    write_line("{described} {waiting.get_type()}")
si

late()
