// Curated store-free entries for genuinely read-only BCL members
// (Semantic.Symbols.STORE_FREE_IMPORTS): a field narrowing must
// survive a call to one of them. Each helper below calls one such
// member between the presence guard and the guarded read; none of
// them may cost the narrowing.

use IO.Std;
use Collections;

class HOLDER is
    _name: string?;
    _kv: KeyValuePair[string, int];

    init() is
        _name = "hello";
        _kv = KeyValuePair("k", 1);
    si

    // System.Type.to_string
    survives_type_to_string() -> int is
        if _name? then
            let s = self.get_type().to_string();
            return _name.length;
        fi
        return -1;
    si

    // System.Reflection.MemberInfo.GetCustomAttributesData
    survives_custom_attributes_data() -> int is
        if _name? then
            let member: System.Reflection.MemberInfo = self.get_type();
            let attrs = member.get_custom_attributes_data();
            return _name.length;
        fi
        return -1;
    si

    // Collections.KeyValuePair.Key / .Value
    survives_key_value_pair_reads() -> int is
        if _name? then
            let k = _kv.key;
            let v = _kv.value;
            return _name.length;
        fi
        return -1;
    si
si

class Main is
    entry() static is
        let h = HOLDER();
        Std.write_line("{h.survives_type_to_string()}");
        Std.write_line("{h.survives_custom_attributes_data()}");
        Std.write_line("{h.survives_key_value_pair_reads()}");
    si
si
