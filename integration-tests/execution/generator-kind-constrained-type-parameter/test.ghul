namespace Test is
    use Std = IO.Std;

    class HOLDER[T: class] is
        _value: T;

        init(value: T) is
            _value = value;
        si

        read() -> T => _value;
    si

    class Main is
        seed[T: class](holder: HOLDER[T], count: int) -> Ghul.Pipes.Pipe[T] static is
            for _ in 0..count do
                yield holder.read();
            od
        si

        entry() static is
            for v in seed[string](HOLDER[string]("tick"), 2) do
                Std.write_line("v: {v}");
            od
        si
    si
si
