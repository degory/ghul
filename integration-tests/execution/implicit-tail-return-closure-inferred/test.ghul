// A function literal that leaves its return type to be inferred takes
// it from its tail, exactly as it takes it from a `return`. A void
// body still tolerates whatever its tail leaves, so a guard `if` with
// no else stays the statement it is.

namespace Test is
    use Std = IO.Std;
    use System.Threading.Tasks;

    class MAIN is
        entry() static is
            let doubled = (x: int) is
                x * 2
            si;

            Std.write_line("{doubled(21)}");

            let name = () is
                "bob"
            si;

            Std.write_line("{name()}");

            // A `return` settles the type first, and the tail is then
            // judged against it.
            let pick = (c: bool) is
                if c then
                    return 1;
                fi

                2
            si;

            Std.write_line("{pick(true)} {pick(false)}");

            // Void bodies: an effect-only tail and a guard `if` both
            // leave the return void.
            let shout = (s: string) is
                Std.write_line(s)
            si;

            shout("shout");

            let announce = (loud: bool) is
                if loud then
                    Std.write_line("loud");
                fi
            si;

            announce(true);

            // An `if` or `case` tail settles the return the same way.
            let sign = (n: int) is
                if n < 0 then
                    "negative"
                else
                    "non-negative"
                fi
            si;

            Std.write_line("{sign(-1)} {sign(1)}");

            let label = (n: int) is
                case n
                when 1 then "one"
                else "many"
                esac
            si;

            Std.write_line("{label(1)} {label(9)}");

            // A nested literal settles before the tail that calls it.
            let outer = () is
                let inner = () is
                    7
                si;

                inner() * 2
            si;

            Std.write_line("{outer()}");

            // A slot that names the return type settles it instead, so
            // the tail is judged against the slot.
            let described: (int) -> string = n is "n{n}" si;

            Std.write_line("{described(3)}");

            // A recursive literal settles its return from the tail
            // before its own self-call is emitted.
            let total = (n: int) rec is
                if n <= 0 then
                    return 0;
                fi

                n + rec(n - 1)
            si;

            Std.write_line("{total(4)}");

            // An async literal wraps a bare-T tail as its task, the
            // same way an explicit `return` does.
            let load = () -> Tasks.TASK[int] is
                let x = 20;

                x + 1
            si;

            Std.write_line("{load().result}");
        si
    si
si
