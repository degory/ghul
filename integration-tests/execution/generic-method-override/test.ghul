namespace Test is
    use Std = IO.Std;

    trait Visitor[T] is
        visit_add(node: ADD) -> T;
        visit_leaf(node: LEAF) -> T;
    si

    class Expression abstract is
        accept[T](visitor: Visitor[T]) -> T
    si

    class LEAF(value: int): Expression is
        init(..) is si

        accept[T](visitor: Visitor[T]) -> T => visitor.visit_leaf(self);
    si

    class ADD(left: Expression, right: Expression): Expression is
        init(..) is si

        accept[T](visitor: Visitor[T]) -> T => visitor.visit_add(self);
    si

    class PRINTER: Visitor[string] is
        init() is si

        visit_leaf(node: LEAF) -> string => "{node.value}";

        visit_add(node: ADD) -> string =>
            "({node.left.accept[string](self)} + {node.right.accept[string](self)})";
    si

    trait Named is
        label[T](tag: T) -> string;
    si

    class TAGGED: Named is
        init() is si

        label[T](tag: T) -> string => "tagged {tag}";
    si

    class Pairs abstract is
        pair[A, B](a: A, b: B) -> string
    si

    class PAIRS: Pairs is
        init() is si

        pair[A, B](a: A, b: B) -> string => "{a}/{b}";
    si

    class Bounded abstract is
        largest[T: Ghul.Comparable[T]](a: T, b: T) -> T
    si

    class BOUNDED: Bounded is
        init() is si

        largest[T: Ghul.Comparable[T]](a: T, b: T) -> T =>
            if a <> b > 0 then a else b fi;
    si

    class Main is
        entry() static is
            let tree: Expression = ADD(LEAF(1), ADD(LEAF(2), LEAF(3)));
            let named: Named = TAGGED();
            let pairs: Pairs = PAIRS();
            let bounded: Bounded = BOUNDED();

            Std.write_line(tree.accept[string](PRINTER()));
            Std.write_line(named.label(7));
            Std.write_line(pairs.pair("a", 2));
            Std.write_line("{bounded.largest(3, 9)}");
        si
    si
si
