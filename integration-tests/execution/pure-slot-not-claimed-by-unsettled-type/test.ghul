namespace Test is
    use Std = IO.Std;

    use Sequence = (int) -> int;
    use Maker = (Sequence[]) -> Sequence;

    // Neither alias is declared pure, so nothing here asks for a pure
    // slot. The literals' types settle through a walk that holds
    // placeholders, and a placeholder shape's purity is not a claim
    // the program made.
    class Main is
        take(makers: Maker[]) -> int static => makers.count;

        entry() static is
            Std.write_line("{take([(fs) => (n) => n + fs[0](n)])}");
            Std.write_line("{take([(fs: Sequence[]) -> Sequence => (n: int) => n + fs[0](n)])}");
        si
    si
si
