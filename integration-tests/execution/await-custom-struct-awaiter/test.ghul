namespace Test is
    use Std = IO.Std;

    use System.Runtime.CompilerServices.ICriticalNotifyCompletion;

    // A struct awaitable that is its own awaiter, implements the
    // critical interface, and hands its continuation to a queue, so
    // several async functions can be interleaved by hand with no task
    // allocated per suspension.
    struct PAUSE: ICriticalNotifyCompletion is
        _queue: Collections.Queue[() -> void];

        init(queue: Collections.Queue[() -> void]) is _queue = queue; si

        get_awaiter() -> PAUSE => self;
        is_completed: bool => false;
        get_result() is si
        on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
        unsafe_on_completed(continuation: () -> void) is _queue.enqueue(continuation); si
    si

    class SCHEDULER is
        _ready: Collections.Queue[() -> void];

        init() is _ready = Collections.Queue[() -> void](); si

        pause() -> PAUSE => PAUSE(_ready);

        run() is
            while _ready.count > 0 do
                _ready.dequeue()();
            od
        si
    si

    class Main is
        ping(s: SCHEDULER, name: string, n: int) -> Tasks.TASK static is
            for i in 0..n do
                Std.write_line("{name} {i}");
                await s.pause();
            od
            Std.write_line("{name} done");
            return;
        si

        entry() static is
            let s = SCHEDULER();
            let a = ping(s, "a", 3);
            let b = ping(s, "b", 2);
            s.run();
            Std.write_line("completed={a.is_completed} {b.is_completed}");
        si
    si
si
