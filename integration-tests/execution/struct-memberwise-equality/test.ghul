namespace Test is
    use IO.Std;

    // A struct has no equality of its own to inherit and `==` does not
    // apply to one, so a struct that declares neither `=~` nor
    // `get_hash_code` gets both, comparing the members that hold its
    // state and hashing the same ones.

    struct PAIR is
        a: int;
        b: string;

        init(a: int, b: string) is
            self.a = a;
            self.b = b;
        si
    si

    struct EMPTY is
        init() is si
    si

    // A property with a body is derived from the state rather than
    // part of it, so it takes no part in the comparison - two values
    // agreeing on `v` agree, whatever `doubled` reads.
    struct COMPUTED is
        v: int;

        doubled: int => v * 2;

        init(v: int) is self.v = v; si
    si

    struct INNER is
        n: int;

        init(n: int) is self.n = n; si
    si

    // A struct member is compared by its own equality, so nesting
    // composes without either struct knowing about the other.
    struct OUTER is
        i: INNER;
        tag: int;

        init(i: INNER, tag: int) is
            self.i = i;
            self.tag = tag;
        si
    si

    // A declared operator is left alone, even one that disagrees with
    // a memberwise comparison.
    struct EVEN_ONLY is
        v: int;

        init(v: int) is self.v = v; si

        =~(other: EVEN_ONLY) -> bool => v % 2 == other.v % 2;
        get_hash_code() -> int => v % 2;
    si

    struct EQUATABLE: Ghul.Equatable[EQUATABLE] is
        v: int;

        init(v: int) is self.v = v; si
    si

    class Main is
        entry() static is
            Std.write_line("equal: {PAIR(1, "x") =~ PAIR(1, "x")}");
            Std.write_line("differing int: {PAIR(1, "x") =~ PAIR(2, "x")}");

            // string members compare by value, not by reference
            Std.write_line("differing string: {PAIR(1, "x") =~ PAIR(1, "y")}");
            let built = "x".to_upper().to_lower();
            Std.write_line("distinct equal strings: {PAIR(1, built) =~ PAIR(1, "x")}");

            Std.write_line("empty: {EMPTY() =~ EMPTY()}");

            Std.write_line("computed excluded: {COMPUTED(1) =~ COMPUTED(1)}");

            Std.write_line("nested equal: {OUTER(INNER(1), 2) =~ OUTER(INNER(1), 2)}");
            Std.write_line("nested differing: {OUTER(INNER(1), 2) =~ OUTER(INNER(9), 2)}");

            // equal values hash equal, which is what a hash-based
            // collection needs of them
            Std.write_line("hash agrees: {PAIR(1, "x").get_hash_code() == PAIR(1, built).get_hash_code()}");
            Std.write_line("nested hash agrees: {OUTER(INNER(1), 2).get_hash_code() == OUTER(INNER(1), 2).get_hash_code()}");

            Std.write_line("declared operator kept: {EVEN_ONLY(2) =~ EVEN_ONLY(4)}");

            Std.write_line("satisfies Equatable: {EQUATABLE(1) =~ EQUATABLE(1)}");
            let through_trait: Ghul.Equatable[EQUATABLE] = EQUATABLE(1);
            Std.write_line("through trait: {through_trait =~ EQUATABLE(1)}");

            return;
        si
    si
si
