use IO.Std.write_line;
use Collections;

// A struct has no equality to inherit and `==` does not apply to one,
// so a struct declaring neither operator has none at all until one is
// synthesized for it, over the members that hold its state.

struct PAIR is
    a: int;
    b: string;

    init(a: int, b: string) is
        self.a = a;
        self.b = b;
    si
si

struct EMPTY is
    init() is si
si

// A property with a body is derived from the state rather than part
// of it, so two values agreeing on `v` agree, whatever `doubled`
// reads. A `field` member is state and takes part.
struct COMPUTED is
    v: int;
    tag: int field;

    doubled: int => v * 2;

    init(v: int, tag: int) is
        self.v = v;
        self.tag = tag;
    si
si

struct INNER is
    n: int;

    init(n: int) is self.n = n; si
si

// A struct member is compared by its own equality, so nesting
// composes without either struct knowing about the other.
struct OUTER is
    i: INNER;
    tag: int;

    init(i: INNER, tag: int) is
        self.i = i;
        self.tag = tag;
    si
si

// A declared operator is the author's own answer and is left alone,
// even one that disagrees with a memberwise comparison.
struct EVEN_ONLY is
    v: int;

    init(v: int) is self.v = v; si

    =~(other: EVEN_ONLY) -> bool => v % 2 == other.v % 2;
    get_hash_code() -> int => v % 2;
si

// An ordering already defines equality, so a struct declaring `<>`
// gets no operator of its own and compares through that.
struct ORDERED is
    v: int;

    init(v: int) is self.v = v; si

    <>(other: ORDERED) -> int pure => v - other.v;
si

struct GENERIC[T] is
    v: T;

    init(v: T) is self.v = v; si
si

struct OPTIONAL_MEMBER is
    v: string?;

    init(v: string?) is self.v = v; si
si

entry() is
    let built = "x".to_upper().to_lower();

    write_line("equal: {PAIR(1, "x") =~ PAIR(1, "x")}");
    write_line("differing int: {PAIR(1, "x") =~ PAIR(2, "x")}");

    // string members compare by characters, not by reference
    write_line("differing string: {PAIR(1, "x") =~ PAIR(1, "y")}");
    write_line("distinct equal strings: {PAIR(1, built) =~ PAIR(1, "x")}");

    write_line("empty: {EMPTY() =~ EMPTY()}");

    write_line("computed excluded: {COMPUTED(1, 2) =~ COMPUTED(1, 2)}");
    write_line("field included: {COMPUTED(1, 2) =~ COMPUTED(1, 3)}");

    write_line("nested equal: {OUTER(INNER(1), 2) =~ OUTER(INNER(1), 2)}");
    write_line("nested differing: {OUTER(INNER(1), 2) =~ OUTER(INNER(9), 2)}");

    // equal values hash equal, which is what a hash-based collection
    // needs of them
    write_line("hash agrees: {PAIR(1, "x").get_hash_code() == PAIR(1, built).get_hash_code()}");
    write_line("nested hash agrees: {OUTER(INNER(1), 2).get_hash_code() == OUTER(INNER(1), 2).get_hash_code()}");

    write_line("declared operator kept: {EVEN_ONLY(2) =~ EVEN_ONLY(4)}");
    write_line("ordering used: {ORDERED(1) =~ ORDERED(1)}");
    write_line("ordering differing: {ORDERED(1) =~ ORDERED(2)}");

    write_line("generic value: {GENERIC[int](1) =~ GENERIC[int](1)}");
    write_line("generic reference: {GENERIC[string](built) =~ GENERIC[string]("x")}");

    write_line("both absent: {OPTIONAL_MEMBER(null) =~ OPTIONAL_MEMBER(null)}");
    write_line("one absent: {OPTIONAL_MEMBER(null) =~ OPTIONAL_MEMBER("x")}");
    write_line("both present: {OPTIONAL_MEMBER(built) =~ OPTIONAL_MEMBER("x")}");

    // the operator reaches .NET through the synthesized bridge, so a
    // struct is a working key
    let seen = SET[PAIR]();
    seen.add(PAIR(1, "x"));
    write_line("set membership: {seen.contains(PAIR(1, built))}");

    let counts = MAP[PAIR, int]();
    counts[PAIR(1, "x")] = 7;
    write_line("map key: {counts[PAIR(1, built)]}");
si
