// A bare `return` at end of line is void when the next line opens with a
// closing keyword, and glues when the next line starts an expression.
use IO.Std.write_line

wrapped(x: int) -> int is
    return
        x * 10
si

early(x: int) is
    if x > 2 then
        write_line("early out")
        return
    fi

    write_line("fell through")
si

entry() is
    write_line("{wrapped(4)}")
    early(3)
    early(1)
si
