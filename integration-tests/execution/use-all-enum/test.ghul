namespace Other is
    enum Suit is
        HEARTS,
        DIAMONDS,
        CLUBS,
        SPADES,
    si
si

namespace Test is
    use IO.Std.write_line;
    use Other.Suit.*;

    entry() is
        let suit = SPADES;
        write_line("{suit}");
        write_line("{suit > HEARTS}");
    si
si
