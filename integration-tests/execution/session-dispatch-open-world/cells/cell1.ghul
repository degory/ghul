class BOX is
    _name: string?;

    init() is si

    // Reads the backing field and nothing else: an ordinary closed
    // build proves it leaves every fact alone, and a session does not.
    read_name() -> string? => _name

    report() -> int is
        if _name? then
            read_name()

            return _name.length
        fi

        return 0
    si
si
