namespace Test is
    use IO.Std.write_line

    use System.Reflection.BindingFlags

    // The JIT does not inline a method whose declared max stack is above
    // 16, so a small method has to declare a small one.
    class COUNTER is
        count: int

        init(count: int) is
            self.count = count
        si

        doubled() -> int => count * 2
    si

    scale(k: int) -> (int) -> int => x => x * k

    entry() is
        let counter = typeof COUNTER

        show("count getter", counter.get_property("count")?.get_method)
        show("doubled", counter.get_method("doubled"))

        let f = scale(3)

        show("literal", f.method)

        write_line("{f(4)}")
    si

    show(what: string, method: System.Reflection.MethodInfo?) is
        if let body = method?.get_method_body() then
            write_line("{what}: max stack at most 8: {body.max_stack_size <= 8}")
        else
            write_line("{what}: missing")
        fi
    si
si
