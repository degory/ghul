// The session's own entry, as a host writes it: each cell's statements run
// in order, and the cells' functions are reachable across cells.
namespace Session is
    entry() -> int is
        let args: string[] = []
        let environment = Ghul.ENVIRONMENT.instance

        cell1.entry(args, environment)
        cell2.entry(args, environment)

        return cell1.double(10) + cell2.quadruple(1)
    si
si
