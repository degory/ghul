namespace ArgumentPackGrid is
    use default

    use IO.File
    use IO.Directory
    use IO.Path

    // A way of writing the function that fills a pack-callable formal
    // (`f: T.. -> U`). `callable` renders it for a given arity, `preamble` any
    // statement the cell body needs before it, and `declaration` any global
    // function it names.
    class SHAPE(
        slug: string,
        is_literal: bool,
        passes_tuple: bool,
        callable: (int) -> string,
        preamble: (int) -> string,
        declaration: (int) -> string
    )

    // Where the function sits relative to the pack. A position declares two
    // combinators: one that takes the pack's arguments beside the function,
    // and one that hands the pack back out as the function's return, so a
    // later call of the result supplies the arguments.
    class POSITION(
        slug: string,
        parenthesises_literal: bool,
        passes_arguments_as_tuple: bool,
        sibling_declaration: string,
        presenting_declaration: string,
        wrap: (string) -> string,
        sibling_call: (string, string) -> string,
        presenting_call: (string) -> string,
        presenting_adjustment: int
    )

    // What pins the pack to a concrete tuple: the arguments written beside the
    // function, the declared type of the local the result goes into, or
    // nothing but the later call of that local.
    class PINNING(
        slug: string,
        is_sibling: bool,
        is_context: bool
    )

    class CELL(
        shape: SHAPE,
        position: POSITION,
        pinning: PINNING,
        arity: int
    ) is
        slug: string => "{shape.slug}-{position.slug}-{pinning.slug}-arity-{arity}"
    si

    // The edges of the pack: no arguments, which a pack has no reading for;
    // one, where the pack is the value itself; two, the smallest tuple; seven,
    // the largest tuple; and eight, past it, which has to fail cleanly.
    ARITIES: int[] static => [0, 1, 2, 7, 8]

    MAX_ARITY: int static => 8

    PARAMETER_NAMES: string[] static => ["a", "b", "c", "d", "e", "f", "g", "h"]

    parameters(arity: int) -> LIST[string] =>
        LIST[string](PARAMETER_NAMES |> take(arity))

    weight(index: int) -> int is
        let result mut = 1

        for _ in 0..index do
            result = result * 10
        od

        result
    si

    // Each argument is weighted by its position, so a result built from
    // arguments in the wrong order, or from too few of them, is visible.
    body(arity: int) -> string is
        let terms = LIST[string]()

        for i in 0..arity do
            let name = PARAMETER_NAMES[i]

            if i == 0 then
                terms.add(name)
            else
                terms.add("{name} * {weight(i)}")
            fi
        od

        if arity == 0 then "42" else terms |> join(" + ") fi
    si

    expected(arity: int) -> int is
        if arity == 0 then
            return 42
        fi

        let result mut = 0

        for i in 0..arity do
            result = result + (i + 1) * weight(i)
        od

        result
    si

    typed_literal(arity: int) -> string =>
        "({parameters(arity) |> map(p => "{p}: int") |> join(", ")}) -> int => {body(arity)}"

    untyped_literal(arity: int) -> string =>
        if arity == 1 then
            "a => a"
        else
            "({parameters(arity) |> join(", ")}) => {body(arity)}"
        fi

    weigh_declaration(arity: int) -> string =>
        "weigh({parameters(arity) |> map(p => "{p}: int") |> join(", ")}) -> int => {body(arity)}"

    spread_arguments(arity: int) -> string =>
        LIST[string]((1::arity) |> map(i => "{i}")) |> join(", ")

    with_arguments(callable: string, arguments: string) -> string =>
        if arguments.length == 0 then callable else "{callable}, {arguments}" fi

    tuple_arguments(arity: int) -> string =>
        if arity == 1 then "1" else "({spread_arguments(arity)})" fi

    function_type(arity: int) -> string =>
        "({LIST[string]((1::arity) |> map(i => "int")) |> join(", ")}) -> int"

    SHAPES: LIST[SHAPE] static =>
        LIST[SHAPE]([
            SHAPE("typed-literal", true, false, typed_literal, n => "", n => ""),
            SHAPE("untyped-literal", true, false, untyped_literal, n => "", n => ""),
            SHAPE("named-function", false, false, n => "weigh", n => "", weigh_declaration),
            SHAPE("stored-value", false, false, n => "stored", n => "let stored = {typed_literal(n)}", n => ""),
            SHAPE("written-out-tuple", false, true, n => "weigh", n => "", weigh_declaration)
        ])

    APPLY: string static => "apply_n[T.., U](f: T.. -> U, v: T..) -> U => f(v)"

    ONCE: string static => "once[T.., U](f: T.. -> U) -> T.. -> U => v => f(v)"

    POSITIONS: LIST[POSITION] static =>
        LIST[POSITION]([
            POSITION(
                "direct-call", false, false, APPLY, ONCE,
                c => c,
                (c, a) => "apply_n({with_arguments(c, a)})",
                c => "once({c})",
                0
            ),
            POSITION(
                "return-spine-depth-1", false, false,
                "run_1[T.., U](make: (int) -> T.. -> U, v: T..) -> U => make(10)(v)",
                "once_1[T.., U](make: (int) -> T.. -> U) -> T.. -> U => v => make(10)(v)",
                c => "k => {c}",
                (c, a) => "run_1({with_arguments(c, a)})",
                c => "once_1({c})",
                0
            ),
            POSITION(
                "return-spine-depth-2", false, false,
                "run_2[T.., U](make: (int) -> (int) -> T.. -> U, v: T..) -> U => make(10)(20)(v)",
                "once_2[T.., U](make: (int) -> (int) -> T.. -> U) -> T.. -> U => v => make(10)(20)(v)",
                c => "j => k => {c}",
                (c, a) => "run_2({with_arguments(c, a)})",
                c => "once_2({c})",
                0
            ),
            POSITION(
                "pipe", true, false, APPLY, ONCE,
                c => c,
                (c, a) => "{c} |> apply_n({a})",
                c => "{c} |> once()",
                0
            ),
            // An operator has one operand for the pack, so the arguments
            // beside the function are always the tuple. The presenting
            // operator composes with `inc`, which adds one to the result.
            POSITION(
                "operator", true, true,
                "<*>[T.., U](f: T.. -> U, v: T) -> U => f(v)",
                ">=>[T.., U, V](f: T.. -> U, g: (U) -> V) -> T.. -> V => v => g(f(v));\n\n    inc(n: int) -> int => n + 1",
                c => c,
                (c, a) => "{c} <*> {a}",
                c => "{c} >=> inc",
                1
            )
        ])

    PINNINGS: LIST[PINNING] static =>
        LIST[PINNING]([
            PINNING("sibling-pinned", true, false),
            PINNING("context-pinned", false, true),
            PINNING("unpinned", false, false)
        ])

    // Cells the language itself rules out, rather than ones that fail today.
    // Apart from an empty pack beside an operator, only the written-out tuple
    // has any: it differs from the named-function cell only in how the
    // arguments beside the function are spelled.
    skip_reason(cell: CELL) -> string? is
        if cell.arity == 0 /\ cell.pinning.is_sibling /\ cell.position.passes_arguments_as_tuple then
            // An operator's operand is one expression, and an empty pack has
            // no expression to write there.
            return "an operator has no operand for an empty pack"
        fi

        if !cell.shape.passes_tuple then
            return null
        fi

        if cell.arity == 0 then
            return "there is no empty tuple to write out"
        fi

        if cell.arity == 1 then
            // There are no one-element tuples: a single argument is the
            // value itself, which is the named-function cell.
            return "no one-element tuples"
        fi

        if !cell.pinning.is_sibling then
            // The arguments are supplied by the call of the presented
            // result, which is an N-ary function, so one tuple argument is
            // an arity error by definition.
            return "the presented result is N-ary"
        fi

        if cell.position.passes_arguments_as_tuple then
            // The operand already is the written-out tuple, so the cell is
            // the named-function cell.
            return "an operator operand is already the tuple"
        fi

        return null
    si

    all_cells() -> LIST[CELL] is
        let result = LIST[CELL]()

        for shape in SHAPES do
            for position in POSITIONS do
                for pinning in PINNINGS do
                    for arity in ARITIES do
                        result.add(CELL(shape, position, pinning, arity))
                    od
                od
            od
        od

        result
    si

    program(cell: CELL) -> string is
        let shape = cell.shape
        let position = cell.position
        let arity = cell.arity

        let callable mut = shape.callable(arity)

        if shape.is_literal /\ position.parenthesises_literal then
            callable = "({callable})"
        fi

        callable = position.wrap(callable)

        let declarations = LIST[string]()

        let shape_declaration = shape.declaration(arity)

        if shape_declaration.length > 0 then
            declarations.add(shape_declaration)
        fi

        let statements = LIST[string]()

        let preamble = shape.preamble(arity)

        if preamble.length > 0 then
            statements.add(preamble)
        fi

        let want mut = expected(arity)

        if cell.pinning.is_sibling then
            declarations.add(position.sibling_declaration)

            let arguments =
                if shape.passes_tuple \/ position.passes_arguments_as_tuple then
                    tuple_arguments(arity)
                else
                    spread_arguments(arity)
                fi

            statements.add("return {position.sibling_call(callable, arguments)}")
        else
            declarations.add(position.presenting_declaration)

            want = want + position.presenting_adjustment

            let annotation = if cell.pinning.is_context then ": {function_type(arity)}" else "" fi

            statements.add("let g{annotation} = {position.presenting_call(callable)}")
            statements.add("return g({spread_arguments(arity)})")
        fi

        let text = System.Text.StringBuilder()

        text
            .append("// Generated by integration-tests/generators/argument-pack-grid: regenerate\n")
            .append("// rather than edit.\n")
            .append("//\n")
            .append("// shape:    {shape.slug}\n")
            .append("// position: {position.slug}\n")
            .append("// pinning:  {cell.pinning.slug}\n")
            .append("// arity:    {arity}\n")
            .append("\n")
            .append("namespace Grid is\n")
            .append("    use IO.Std.write_line;\n")

        for declaration in declarations do
            text.append("\n    {declaration};\n")
        od

        text.append("\n    cell() -> int is\n")

        for statement in statements do
            text.append("        {statement};\n")
        od

        text
            .append("    si\n")
            .append("\n")
            .append("    entry() is\n")
            .append("        try\n")
            .append("            let result = cell();\n")
            .append("\n")
            .append("            if result == {want} then\n")
            .append("                write_line(\"ok {{result}}\");\n")
            .append("            else\n")
            .append("                write_line(\"wrong result {{result}}, expected {want}\");\n")
            .append("            fi\n")
            .append("        catch e: System.Exception\n")
            .append("            write_line(\"exception {{e.get_type()}}\");\n")
            .append("        yrt\n")
            .append("    si\n")
            .append("si\n")

        text.to_string()
    si

    GHUL_JSON: string static =>
        "\{\n    \"compiler\": \"../../../../publish/ghul.dll\",\n    \"binary\": \"binary.exe\"\n\}\n"

    generate(root: string) -> int is
        Directory.create_directory(root)

        let wanted = SET[string]()
        let skipped mut = 0

        for cell in all_cells() do
            if skip_reason(cell)? then
                skipped = skipped + 1
                continue
            fi

            let directory = Path.combine(root, cell.slug)

            wanted.add(cell.slug)

            Directory.create_directory(directory)

            File.write_all_text(Path.combine(directory, "test.ghul"), program(cell))
            File.write_all_text(Path.combine(directory, "ghulflags"), "")
            File.write_all_text(Path.combine(directory, "ghul.json"), GHUL_JSON)
            File.write_all_text(Path.combine(directory, "tags"), "generics inference lambdas\n")
        od

        // A cell no longer in the grid would otherwise keep running with
        // whatever it was last generated as.
        for directory in Directory.get_directories(root) do
            let name = Path.get_file_name(directory)!

            if !wanted.contains(name) /\ File.exists(Path.combine(directory, "ghulflags")) then
                Directory.delete(directory, true)
                write_line("removed stale cell {name}")
            fi
        od

        write_line("generated {wanted.count} cells under {root}, skipped {skipped} the language rules out")

        0
    si

    outcome(root: string, cell: CELL) -> string is
        if skip_reason(cell)? then
            return "·"
        fi

        let directory = Path.combine(root, cell.slug)

        if File.exists(Path.combine(directory, "fail.expected")) then
            return "C"
        fi

        let run = Path.combine(directory, "run.expected")

        if !File.exists(run) then
            return "?"
        fi

        let text = File.read_all_text(run)

        if text.starts_with("ok ") then
            "✓"
        elif text.starts_with("wrong ") then
            "W"
        elif text.starts_with("exception ") then
            "X"
        else
            "?"
        fi
    si

    // The first error each failing cell records, with its location removed,
    // so the table can be read beside what the compiler says.
    first_error(root: string, cell: CELL) -> string? is
        let path = Path.combine(Path.combine(root, cell.slug), "err.expected")

        if !File.exists(path) then
            return null
        fi

        let lines = File.read_all_lines(path)

        if lines.count == 0 then
            return null
        fi

        let line = lines[0]
        let marker = ": error: "
        let at = line.index_of(marker)

        let message = if at < 0 then line else line.substring(at + marker.length) fi

        // Arity shows up in a message as the length of a tuple of ints, so
        // collapsing those lets one gap across every arity count as one.
        let without_arity = System.Text.RegularExpressions.Regex.replace(message, "\\(int(, int)+\\)", "(int, ...)")

        System.Text.RegularExpressions.Regex.replace(without_arity, "( pure)+", " pure")
    si

    report(root: string) -> int is
        let cells = all_cells()

        let counts = MAP[string, int]()
        let errors = MAP[string, int]()

        write_line("| shape | position | pinning | {ARITIES |> map(i => "{i}") |> join(" | ")} |")
        write_line("|---|---|---|{ARITIES |> map(i => "---") |> join("|")}|")

        let row = LIST[string]()

        for cell in cells do
            let result = outcome(root, cell)

            counts[result] = if counts.contains_key(result) then counts[result] + 1 else 1 fi

            if result =~ "C" then
                if let message = first_error(root, cell) then
                    errors[message] = if errors.contains_key(message) then errors[message] + 1 else 1 fi
                fi
            fi

            row.add(result)

            if cell.arity == MAX_ARITY then
                write_line("| {cell.shape.slug} | {cell.position.slug} | {cell.pinning.slug} | {row |> join(" | ")} |")
                row.clear()
            fi
        od

        write_line("")

        for (key, value) in counts do
            write_line("- `{key}`: {value}")
        od

        write_line("")

        for (key, value) in errors do
            write_line("- {value} x `{key}`")
        od

        0
    si

    entry(args: string[]) -> int is
        if args.count == 2 /\ args[0] =~ "generate" then
            return generate(args[1])
        elif args.count == 2 /\ args[0] =~ "report" then
            return report(args[1])
        fi

        write_line("usage: argument-pack-grid generate|report <grid-directory>")

        1
    si
si
