namespace InferenceOracle is
    use default

    use IO.File
    use IO.Directory
    use IO.Path

    use System.Text.RegularExpressions.Regex

    use ArgumentPackGrid

    // What checking one cell found. `inferred` and `explicit` hold the two
    // programs' working directories.
    class CHECK(cell: CELL, inferred: string, explicit: string) is
        verdict: string? public
    si

    // Runs a shell command line in a directory and returns the process,
    // which the caller waits on. Output goes to a file named by the command,
    // so a batch of processes started together never blocks on a full pipe.
    start(directory: string, command: string) -> System.Diagnostics.Process is
        let info = System.Diagnostics.ProcessStartInfo("bash")

        info.argument_list.add("-c")
        info.argument_list.add(command)
        info.working_directory = directory
        info.use_shell_execute = false

        System.Diagnostics.Process.start(info)!
    si

    quote(text: string) -> string => "'{text}'"

    find_ildasm(named: string?) -> string is
        if named? then
            return Path.get_full_path(named)
        fi

        let from_environment = System.Environment.get_environment_variable("GHUL_TEST_ILDASM")

        if from_environment? /\ from_environment.length > 0 then
            return from_environment
        fi

        let packages_variable = System.Environment.get_environment_variable("NUGET_PACKAGES")

        let packages =
            if packages_variable? /\ packages_variable.length > 0 then
                packages_variable
            else
                Path.combine(System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE), ".nuget/packages")
            fi

        let package = Path.combine(packages, "runtime.linux-x64.microsoft.netcore.ildasm")

        if !Directory.exists(package) then
            throw System.Exception("ildasm not found: pass --ildasm <path> or set GHUL_TEST_ILDASM")
        fi

        let best: string? mut = null
        let best_version: System.Version? mut = null

        for directory in Directory.get_directories(package) do
            let version = System.Version(Path.get_file_name(directory)!)

            if !best_version? \/ version > best_version then
                best_version = version
                best = Path.combine(directory, "runtimes/linux-x64/native/ildasm")
            fi
        od

        if !best? then
            throw System.Exception("ildasm not found under {package}")
        fi

        best
    si

    // A NuGet package carries no Unix permissions, so the native arrives
    // without its execute bit.
    make_executable(path: string) is
        let mode = cast int(File.get_unix_file_mode(path))
        let wanted = mode | cast int(IO.UnixFileMode.USER_EXECUTE)

        if mode != wanted then
            File.set_unix_file_mode(path, cast IO.UnixFileMode(wanted))
        fi
    si

    // The disassembly with everything that differs between two compiles of
    // the same program removed: the assembly header (ildasm's banner, the
    // MVID, the image base), instruction offsets and code sizes, which move
    // whenever any earlier instruction does, and the numbers the compiler
    // gives its generated members, which count in the order they are made
    // rather than anything about what they are.
    normalise(text: string) -> string is
        let result = System.Text.StringBuilder()
        let numbering = MAP[string, string]()

        let in_members mut = false

        for line in text.split(['\n']) do
            if line.contains("CLASS MEMBERS DECLARATION") then
                in_members = true
                continue
            fi

            if !in_members then
                continue
            fi

            if line.contains("DISASSEMBLY COMPLETE") \/ line.trim().starts_with("// Code size") then
                continue
            fi

            let without_offsets = Regex.replace(line.trim_end(), "IL_[0-9a-f]{4}", "IL_")

            let renumbered = Regex.replace(
                without_offsets,
                "\\$([A-Za-z]+)_([0-9]+)",
                (m: System.Text.RegularExpressions.Match) -> string is
                    let key = m.value

                    if !numbering.contains_key(key) then
                        let prefix = m.groups[1].value
                        let used = numbering.values |> filter(v => v.starts_with("${prefix}_")) |> count()

                        numbering[key] = "${prefix}_{used}"
                    fi

                    numbering[key]
                si
            )

            result.append(renumbered).append('\n')
        od

        canonicalise_frames(result.to_string())
    si

    // The index of the `>` closing the `<` at `open`.
    matching_close(text: string, open: int) -> int is
        let depth mut = 0

        for i in open..text.length do
            if text[i] == '<' then
                depth = depth + 1
            elif text[i] == '>' then
                depth = depth - 1

                if depth == 0 then
                    return i
                fi
            fi
        od

        -1
    si

    // The top-level comma-separated items between `open` and `close`.
    split_arguments(text: string, open: int, close: int) -> LIST[string] is
        let result = LIST[string]()
        let depth mut = 0
        let start mut = open + 1

        for i in open + 1..close do
            if text[i] == '<' then
                depth = depth + 1
            elif text[i] == '>' then
                depth = depth - 1
            elif text[i] == ',' /\ depth == 0 then
                result.add(text.substring(start, i - start))
                start = i + 1
            fi
        od

        result.add(text.substring(start, close - start))

        result
    si

    // Each occurrence of a closure frame class's name followed by its type
    // arguments: the frame's name, where its `<` is and where its `>` is.
    frame_references(line: string) -> LIST[(name: string, open: int, close: int)] is
        let result = LIST[(name: string, open: int, close: int)]()

        let found = Regex.matches(line, "\\$frame_[0-9]+<")

        for k in 0..found.count do
            let m = found[k]

            let open = m.index + m.length - 1
            let close = matching_close(line, open)

            if close > 0 then
                result.add((name = m.value.substring(0, m.length - 1), open = open, close = close))
            fi
        od

        result
    si

    // A closure frame class takes the type parameters its lambda captures, in
    // the order the compiler first meets them, and writing a type out can
    // change that order. Two frames differing only in it are the same class,
    // so each frame's type parameters are put in name order, and every
    // reference to the frame and to its parameters by index follows.
    canonicalise_frames(text: string) -> string is
        let lines = text.split(['\n'])

        // For each frame, the new index of each of its type parameters.
        let permutations = MAP[string, int[]]()

        for line in lines do
            if line.starts_with(".class ") then
                let m = Regex.match(line, "(\\$frame_[0-9]+)<([^<>]*)>")

                if m.success then
                    let parameters = m.groups[2].value.split([','])
                    let sorted = LIST[string](parameters)

                    sorted.sort()

                    let permutation = LIST[int]()

                    for p in parameters do
                        permutation.add(sorted.index_of(p))
                    od

                    permutations[m.groups[1].value] = permutation.to_array()
                fi
            fi
        od

        let result = System.Text.StringBuilder()
        let current_frame: string? mut = null
        let continued_owner: string? mut = null
        let open_parentheses mut = 0

        for original in lines do
            let line mut = original

            if line.starts_with(".class ") then
                let m = Regex.match(line, "(\\$frame_[0-9]+)<")

                current_frame = if m.success then m.groups[1].value else null fi
            fi

            // An index written after `::` belongs to the type named before
            // it; anywhere else in a frame's body it belongs to the frame.
            // A signature ildasm wraps onto following lines keeps the owner
            // of the line it started on.
            let owner mut =
                if continued_owner? then
                    continued_owner
                elif line.contains("::") then
                    null
                else
                    current_frame
                fi

            let starts_signature = !continued_owner?

            for reference in frame_references(line) do
                if reference.close + 2 < line.length /\ line.substring(reference.close + 1, 2) =~ "::" then
                    owner = reference.name
                fi
            od

            open_parentheses = open_parentheses + line.split(['(']).count - line.split([')']).count

            continued_owner =
                if open_parentheses > 0 /\ (!starts_signature \/ line.contains("::")) then
                    owner
                else
                    open_parentheses = 0
                    null
                fi

            if let permutation = if owner? /\ permutations.contains_key(owner) then permutations[owner] else null fi then
                line = Regex.replace(
                    line,
                    "(?<![!\\w])!([0-9]+)",
                    (m: System.Text.RegularExpressions.Match) -> string is
                        let index = int.parse(m.groups[1].value)

                        if index < permutation.count then "!{permutation[index]}" else m.value fi
                    si
                )
            fi

            // Reorder the type arguments of each reference, last first so the
            // earlier positions stay valid.
            let references = frame_references(line)

            for i in 0..references.count do
                let reference = references[references.count - 1 - i]

                if permutations.contains_key(reference.name) then
                    let permutation = permutations[reference.name]
                    let arguments = split_arguments(line, reference.open, reference.close)

                    if arguments.count == permutation.count then
                        let reordered = LIST[string](arguments)

                        for j in 0..arguments.count do
                            reordered[permutation[j]] = arguments[j]
                        od

                        let before = line.substring(0, reference.open + 1)
                        let joined = reordered |> join(",")
                        let after = line.substring(reference.close)

                        line = "{before}{joined}{after}"
                    fi
                fi
            od

            if line.starts_with("}} // end of class") then
                current_frame = null
            fi

            result.append(line).append('\n')
        od

        result.to_string()
    si

    check(grid: string, work: string, compiler: string, ildasm: string, filter_text: string?) -> int is
        make_executable(ildasm)

        let checks = LIST[CHECK]()

        for cell in all_cells() do
            if filter_text? /\ !cell.slug.contains(filter_text) then
                continue
            fi

            let result = CHECK(cell, Path.combine(Path.combine(work, cell.slug), "inferred"), Path.combine(Path.combine(work, cell.slug), "explicit"))

            if skip_reason(cell)? then
                result.verdict = "·"
            elif File.exists(Path.combine(Path.combine(grid, cell.slug), "fail.expected")) then
                result.verdict = "C"
            elif !File.exists(Path.combine(Path.combine(grid, cell.slug), "test.ghul")) then
                result.verdict = "?"
            fi

            checks.add(result)
        od

        let to_compile = LIST[CHECK](checks |> filter(c => !c.verdict?))

        let batch_size = System.Math.max(1, System.Environment.processor_count / 2)

        write_line("compiling {to_compile.count} cells twice each, {batch_size} at a time")

        for batch in to_compile |> chunk(batch_size) do
            let processes = LIST[System.Diagnostics.Process]()

            for c in batch do
                for directory in [c.inferred, c.explicit] do
                    if Directory.exists(directory) then
                        Directory.delete(directory, true)
                    fi

                    Directory.create_directory(directory)
                od

                // The inferred program is the grid's own cell, so the oracle
                // checks what the grid runs.
                File.copy(Path.combine(Path.combine(grid, c.cell.slug), "test.ghul"), Path.combine(c.inferred, "test.ghul"))
                File.write_all_text(Path.combine(c.explicit, "test.ghul"), program(c.cell, true))

                for directory in [c.inferred, c.explicit] do
                    processes.add(start(directory, "dotnet {quote(compiler)} test.ghul -o binary.exe > compiler.out 2>&1"))
                od
            od

            for p in processes do
                p.wait_for_exit()
            od

            for c in batch do
                c.verdict = compare(c, ildasm)
            od
        od

        report(checks)
    si

    compare(c: CHECK, ildasm: string) -> string is
        if !File.exists(Path.combine(c.inferred, "binary.exe")) then
            // The grid records this cell as compiling, so the compiler used
            // here is not the one the grid was captured with.
            return "?"
        fi

        if !File.exists(Path.combine(c.explicit, "binary.exe")) then
            return "E"
        fi

        for directory in [c.inferred, c.explicit] do
            let p = start(directory, "{quote(ildasm)} -out=il.raw binary.exe > ildasm.out 2>&1")

            p.wait_for_exit()

            File.write_all_text(Path.combine(directory, "il.normalised"), normalise(File.read_all_text(Path.combine(directory, "il.raw"))))
        od

        let diff = start(
            Path.get_directory_name(c.inferred)!,
            "diff -u inferred/il.normalised explicit/il.normalised > il.diff"
        )

        diff.wait_for_exit()

        if diff.exit_code == 0 then
            File.delete(Path.combine(Path.get_directory_name(c.inferred)!, "il.diff"))
            "="
        else
            "≠"
        fi
    si

    report(checks: LIST[CHECK]) -> int is
        write_line("")
        write_line("| shape | position | pinning | {ARITIES |> map(i => "{i}") |> join(" | ")} |")
        write_line("|---|---|---|{ARITIES |> map(i => "---") |> join("|")}|")

        let counts = MAP[string, int]()
        let row = LIST[string]()

        for i in 0..checks.count do
            let c = checks[i]
            let verdict = c.verdict ?? "?"

            counts[verdict] = if counts.contains_key(verdict) then counts[verdict] + 1 else 1 fi

            row.add(verdict)

            let next: CELL? = if i + 1 < checks.count then checks[i + 1].cell else null fi

            if !next? \/ next.shape != c.cell.shape \/ next.position != c.cell.position \/ next.pinning != c.cell.pinning then
                write_line("| {c.cell.shape.slug} | {c.cell.position.slug} | {c.cell.pinning.slug} | {row |> join(" | ")} |")
                row.clear()
            fi
        od

        write_line("")

        for (key, value) in counts do
            write_line("- `{key}`: {value}")
        od

        let mismatches = LIST[CHECK](checks |> filter(c => c.verdict =~ "≠"))
        let rejected = LIST[CHECK](checks |> filter(c => c.verdict =~ "E"))

        if mismatches.count > 0 then
            write_line("")
            write_line("IL differs:")

            for c in mismatches do
                write_line("- {c.cell.slug}")
            od
        fi

        if rejected.count > 0 then
            write_line("")
            write_line("explicit program does not compile:")

            for c in rejected do
                write_line("- {c.cell.slug}")
            od
        fi

        if mismatches.count > 0 then 1 else 0 fi
    si

    entry(args: string[]) -> int is
        if args.count < 3 \/ !(args[0] =~ "check") then
            write_line("usage: inference-oracle check <grid-directory> <work-directory> [--compiler <ghul.dll>] [--ildasm <path>] [--cell <text>]")
            return 1
        fi

        let compiler mut = "publish/ghul.dll"
        let ildasm: string? mut = null
        let filter_text: string? mut = null

        let i mut = 3

        while i + 1 < args.count do
            if args[i] =~ "--compiler" then
                compiler = args[i + 1]
            elif args[i] =~ "--ildasm" then
                ildasm = args[i + 1]
            elif args[i] =~ "--cell" then
                filter_text = args[i + 1]
            else
                write_line("unknown option {args[i]}")
                return 1
            fi

            i = i + 2
        od

        check(Path.get_full_path(args[1]), Path.get_full_path(args[2]), Path.get_full_path(compiler), find_ildasm(ildasm), filter_text)
    si
si
