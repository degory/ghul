// Under ghul-test this is a library build, and asserts only that it lowers
// with no diagnostics. build/llvm-validate.sh builds it as an executable,
// feeds it `input`, and checks its output and exit status: a string a host
// operation answers is one the native runtime made through the program's
// `ghul_make_string`.
entry() -> int is
    let line = IO.Std.read_line()

    if line? then
        IO.Std.write_line(line)
        return 7
    fi

    return 3
si
