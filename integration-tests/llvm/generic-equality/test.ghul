// =~ over a type parameter, compiled for each instantiation: scalars by
// value, a NaN equal to another as .NET's comparer has it, a class through
// its own =~, a class without one by reference, and an absent value equal
// only to another. The exit status is the number of the first check that
// fails, or 0.
namespace Test is
    class POINT is
        x: int
        init(x: int) is self.x = x si
        =~(other: POINT) -> bool pure => x == other.x
        get_hash_code() -> int => x
    si

    class THING is
        init() is si
    si

    same[T](a: T, b: T) -> bool => a =~ b

    entry() -> int is
        let nan = 0.0 / 0.0
        let thing = THING()
        let absent: POINT? = null
        let also_absent: POINT? = null

        let checks = [
            same(1, 1), !same(1, 2),
            same(7L, 7L), !same(7L, 8L),
            same(2.5, 2.5), !same(2.5, 3.5),
            same(nan, nan), !same(nan, 1.0),
            same(POINT(3), POINT(3)), !same(POINT(3), POINT(4)),
            same(thing, thing), !same(thing, THING()),
            same(absent, also_absent), !same(absent, POINT(1)), !same(POINT(1), absent)
        ]

        let i mut = 0

        while i < checks.count do
            if !checks[i] then
                return i + 1
            fi

            i = i + 1
        od

        return 0
    si
si
