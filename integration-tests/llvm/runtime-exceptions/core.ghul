@@suppress("non-upper-snake-case-name")

// The operators the program uses, and the exceptions the target's runtime
// checks throw, declared as the core library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count

        @intrinsic("array.get")
        [index: int]: E => self[index]
    si

    class Exception is
        message: string

        init(message: string) is
            self.message = message
        si
    si

    class IndexOutOfRangeException: Exception is
        init() is super.init("index out of range") si
    si

    class NullReferenceException: Exception is
        init() is super.init("null reference") si
    si

    class InvalidCastException: Exception is
        init() is super.init("invalid cast") si
    si
si
