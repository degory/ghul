// Each runtime check throws the exception .NET throws, which a catch
// handles: an index out of range, a member reached through null, and a
// cast that fails. A finally runs on the way out of a loop, and the last
// exception goes uncaught.
namespace Test is
    class BOX is
        value: int

        init(value: int) is self.value = value si
    si

    class OTHER is
        init() is si
    si

    index_out_of_range() -> int is
        let xs = [1, 2, 3]

        try
            return xs[3]
        catch e: Ghul.IndexOutOfRangeException
            return 1
        yrt
    si

    null_reference(b: BOX?) -> int is
        try
            return b!.value
        catch e: Ghul.NullReferenceException
            return 10
        yrt
    si

    @suppress("cast-may-throw")
    invalid_cast(o: object) -> int is
        try
            return cast BOX(o).value
        catch e: Ghul.InvalidCastException
            return 100
        yrt
    si

    finally_on_break() -> int is
        let total mut = 0
        let i mut = 0

        while i < 5 do
            try
                if i == 3 then
                    break
                fi

                total = total + 1
            finally
                total = total + 10
            yrt

            i = i + 1
        od

        return total
    si

    entry() -> int is
        let total = index_out_of_range() + null_reference(null) + invalid_cast(OTHER()) + finally_on_break() * 1000

        if total != 43111 then
            return total
        fi

        let xs = [1]

        return xs[1]
    si
si
