// LLVM keeps the names starting `llvm.` for its intrinsics, so a namespace
// named `llvm` at the root is an error on the llvm target. One nested in
// another namespace is not.
namespace llvm is
    one() -> int => 1
si

namespace llvm.Inner is
    two() -> int => 2
si

namespace Outer.llvm is
    three() -> int => 3
si
