// A class whose instances refer to others of the class, built with debug
// information: the class is described by its fields, one of which refers
// back to the class itself.
namespace Test is
    class NODE is
        value: int
        next: NODE?

        init(value: int, next: NODE?) is
            self.value = value
            self.next = next
        si
    si

    total(node: NODE?) -> int => if let n = node then n.value + total(n.next) else 0 fi

    entry() -> int is
        let list = NODE(1, NODE(2, NODE(3, null)))

        return total(list)
    si
si
