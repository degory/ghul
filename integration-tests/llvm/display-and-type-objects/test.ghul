// A value whose type has no text of its own is displayed as its type and
// public properties, or as its elements where it is a sequence. A type
// object is one per type, whether it comes from typeof or from a value's
// get_type, for a class, a scalar directly and through a type parameter,
// and a generic class at each of its instantiations, and is named as .NET
// names the type.
namespace Test is
    class POINT(x: int public, y: int public)

    class LABEL(text: string public, mark: char public)

    class EMPTY is
        init() is si
    si

    class NAMED(name: string public) is
        to_string() -> string => "named {name}"
    si

    class SCORE(points: int): Ghul.Displayable is
        display(state: Ghul.DISPLAY_STATE) is
            state.append("[")
            state.render(points)
            state.append("]")
        si
    si

    class THING is
        init() is si
    si

    class BOX[T] is
        value: T
        init(value: T) is self.value = value si
    si

    type_of[T](value: T) -> Ghul.Type => value.get_type()

    check(passed: bool, what: string) =>
        IO.Std.write_line(if passed then "ok: {what}" else "FAILED: {what}" fi)

    entry() is
        IO.Std.write_line($(POINT(3, -4)))
        IO.Std.write_line("{LABEL("top", 'x')}")
        IO.Std.write_line("{EMPTY()}")
        IO.Std.write_line("{NAMED("thing")}")
        IO.Std.write_line("{SCORE(7)}")
        IO.Std.write_line("{true} {false}")
        IO.Std.write_line("{[1, 2, 3]} {["a", "b"]} {[POINT(1, 2)]}")

        check(typeof THING == THING().get_type(), "typeof a class is its instances' type")
        check(THING().get_type() == THING().get_type(), "one type object per class")
        check(typeof int == 5 .get_type(), "typeof a scalar is its value's type")
        check(type_of(7) == typeof int, "a scalar's type through a type parameter")
        check(!(typeof BOX[int] == typeof BOX[string]), "one type object per instantiation")

        IO.Std.write_line(BOX(1).get_type().full_name)
        IO.Std.write_line(THING().to_string())
        IO.Std.write_line((typeof int).full_name)
    si
si
