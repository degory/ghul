// A trait call whose every implementation is pure and allocates nothing
// carries a memory attribute saying so; one that can allocate does not.
namespace Test is
    trait Shape is
        sides() -> int pure
        copy() -> Shape
    si

    class SQUARE: Shape is
        init() is si

        sides() -> int pure => 4
        copy() -> Shape => SQUARE()
    si

    class TRIANGLE: Shape is
        init() is si

        sides() -> int pure => 3
        copy() -> Shape => TRIANGLE()
    si

    count(shape: Shape) -> int => shape.copy().sides()

    entry() -> int => count(SQUARE()) * 10 + count(TRIANGLE())
si
