// Under ghul-test this is a library build, and asserts only that it lowers
// with no diagnostics. build/llvm-validate.sh builds it as an executable and
// checks that it writes output.expected: string literals reach the native
// runtime as their UTF-16 code units, characters outside ASCII included.
entry() is
    IO.Std.write_line("hello")
    IO.Std.write_line("café €")
si
