// An exception nothing catches is described with the frames it was thrown
// through, innermost first, after its type's name and its message.
namespace Test is
    class NotFound: Ghul.Exception is
        init(message: string) is super.init(message) si
    si

    inner() -> int => throw NotFound("no such thing")

    middle() -> int => inner()

    entry() -> int => middle()
si
