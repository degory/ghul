use IO.Std.write_line

// An optimisation level outside 0 to 3 is rejected on the command line, so
// this program, which builds and runs at level 1 in optimise-level, is
// never compiled.
entry() -> int is
    let i mut = 0

    while i < 3 do
        write_line("step")
        i = i + 1
    od

    return i
si
