// What the llvm target cannot generate yet is reported at the function that
// holds it, once for each kind of construct.
namespace Test is
    first() -> int is
        let b = 1.5m
        return 1
    si

    second() -> int is
        let b = 1.5m
        let c = 2.5m
        return 2
    si

    maybe(n: int) -> int? => n
si
