namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("arithmetic.add") +(a: byte, b: byte) -> byte pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("arithmetic.shl") <<(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool
    @intrinsic("compare.value") !=[T](a: T, b: T) -> bool
si

namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.div") /(a: int, b: int) -> int pure
si
