// On an llvm build the declarations for the other targets are dropped
// whole, so the errors in them are never reported, even where a --define
// names those targets. The llvm declaration, and the one for every target
// with a source core library, are kept, so their errors are.
@IF.dotnet()
dotnet_only() -> int => missing_in_dotnet()

@IF.wasm()
wasm_only() -> int => missing_in_wasm()

@IF.llvm()
llvm_only() -> int => missing_in_llvm()

@IF.source_core()
source_core_only() -> int => missing_in_source_core()

@IF.not.llvm()
not_llvm() -> int => missing_in_not_llvm()

@IF.not.dotnet()
not_dotnet() -> int => missing_in_not_dotnet()
