// The llvm module's text form with only the program's own functions. A use
// of a type's static state that an earlier use in the same function
// dominates tests the type's initialised flag once; a use that no earlier
// use dominates tests it again.
namespace Test is
    class LAZY is
        value: int static

        init() static is
            value = 7
        si

        init() is si

        get() -> int static => value
    si

    both() -> int is
        let first = LAZY.get()
        let second = LAZY.get()

        return first + second
    si

    either(flag: bool) -> int is
        if flag then
            return LAZY.get()
        fi

        return LAZY.get()
    si

    entry() -> int => both() + either(true)
si
