// The session's own entry, as a host writes it: each cell's statements
// run in order, and the newest cell's final value is shown.
namespace Session is
    use IO.Std.write_line

    entry(args: string[], env: Ghul.Environment) is
        cell1.entry(args, env)
        cell2.entry(args, env)

        if let value = cell3.entry(args, env) then
            write_line(Ghul.inspect(value))
        fi
    si
si
