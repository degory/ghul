// Scalar arithmetic, locals, loops, conditionals and calls lower to code
// that runs: `entry` answers the exit status in run.exit.expected.
namespace Test is
    triangle(n: int) -> int is
        let total mut = 0
        let i mut = 1

        while i <= n do
            total = total + i
            i = i + 1
        od

        return total
    si

    // A byte wraps at its own width, as it does on .NET.
    wraps(b: byte) -> int => if b + cast byte(100) == cast byte(-56) then 1 else 0 fi

    sign(n: int) -> int =>
        if n < 0 then -1 elif n == 0 then 0 else 1 fi

    entry() -> int is
        let t = triangle(10)
        let s = sign(t) + sign(0) + sign(-3)

        // Only the low five bits of a shift count are used.
        let shifted = 1 << 33

        return t - 13 + s + wraps(cast byte(100)) + shifted - 3
    si
si
