  %t2 = alloca i32
  store i32 0, ptr %t2
  %t10 = alloca i32
  store i32 0, ptr %t10
  br label %b0

b0:
  %t1 = call i32 @Test.triangle(i32 10)
  store i32 %t1, ptr %t0
  %t3 = load i32, ptr %t0
  %t4 = call i32 @Test.sign(i32 %t3)
  %t5 = call i32 @Test.sign(i32 0)
  %t6 = add i32 %t4, %t5
  %t7 = sub i32 0, 3
  %t8 = call i32 @Test.sign(i32 %t7)
  %t9 = add i32 %t6, %t8
  store i32 %t9, ptr %t2
  %t11 = and i32 33, 31
  %t12 = shl i32 1, %t11
  store i32 %t12, ptr %t10
  %t13 = load i32, ptr %t0
  %t14 = sub i32 %t13, 13
  %t15 = load i32, ptr %t2
  %t16 = add i32 %t14, %t15
  %t17 = trunc i32 100 to i8
  %t18 = sext i8 %t17 to i32
  %t19 = trunc i32 %t18 to i8
  %t20 = sext i8 %t19 to i32
  %t21 = call i32 @Test.wraps(i32 %t20)
  %t22 = add i32 %t16, %t21
  %t23 = load i32, ptr %t10
  %t24 = add i32 %t22, %t23
  %t25 = sub i32 %t24, 3
  ret i32 %t25

b1:
  ret i32 0
}

define i32 @Test.triangle(i32 %a0) {
entry:
  %t0 = alloca i32
  store i32 %a0, ptr %t0
  %t1 = alloca i32
  store i32 0, ptr %t1
  %t2 = alloca i32
  store i32 0, ptr %t2
  br label %b0

b0:
  store i32 0, ptr %t1
  store i32 1, ptr %t2
  br label %b1

b1:
  %t3 = load i32, ptr %t2
  %t4 = load i32, ptr %t0
  %t5 = icmp sle i32 %t3, %t4
  %t6 = zext i1 %t5 to i32
  %t7 = icmp eq i32 %t6, 0
  br i1 %t7, label %b2, label %b3

b2:
  %t13 = load i32, ptr %t1
  ret i32 %t13

b3:
  %t8 = load i32, ptr %t1
  %t9 = load i32, ptr %t2
  %t10 = add i32 %t8, %t9
  store i32 %t10, ptr %t1
  %t11 = load i32, ptr %t2
  %t12 = add i32 %t11, 1
  store i32 %t12, ptr %t2
  br label %b1

b4:
  ret i32 0
}

