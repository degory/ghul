// Unions: variants constructed, tested for and destructured, a unit
// variant's shared instance, a generic union, a recursive one walked by a
// case, fields a union's header shares with every variant, and the
// structural equality a union is given.
namespace Test is
    union Shape is
        CIRCLE(radius: int)
        SQUARE(side: int)
        DOT
    si

    union Option[T] is
        SOME(value: T)
        NONE
    si

    union Tree is
        NODE(left: Tree, right: Tree)
        LEAF(value: int)
    si

    union Tagged(tag: int) is
        NAMED(count: int, ..)
        BARE
    si

    area(s: Shape) -> int is
        if let c: Shape.CIRCLE = s then
            return c.radius * c.radius * 3
        elif let q: Shape.SQUARE = s then
            return q.side * q.side
        fi

        return 1
    si

    unwrap(o: Option[int]) -> int is
        if let (v): Option.SOME = o then
            return v
        fi

        return 7
    si

    sum(t: Tree) -> int =>
        case t
        when n: Tree.NODE then sum(n.left) + sum(n.right)
        when l: Tree.LEAF then l.value
        esac

    entry() -> int is
        let shapes = area(Shape.CIRCLE(2)) + area(Shape.SQUARE(3)) + area(Shape.DOT)
        let options = unwrap(Option.SOME(40)) + unwrap(Option.NONE[int])
        let shared = if Shape.DOT == Shape.DOT then 100 else 0 fi
        let tree = sum(Tree.NODE(Tree.LEAF(3), Tree.NODE(Tree.LEAF(4), Tree.LEAF(5))))
        let tagged: Tagged = Tagged.NAMED(2, 30)
        let equal = if Tree.LEAF(9) =~ Tree.LEAF(9) /\ !(Tree.LEAF(9) =~ Tree.LEAF(8)) then 0 else 1 fi

        return shapes + options + shared + tree * 1000 + tagged.tag * 100000 + equal * 1000000
    si
si
