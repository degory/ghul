@@suppress("non-upper-snake-case-name")

// What a union's synthesised members need from the core library, declared
// as the core library declares it: the operators, and the members its
// equality and hash read.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("compare.value") !=[T](a: T, b: T) -> bool pure
    @intrinsic("compare.value") =~(a: int, b: int) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
si

namespace Collections is
    trait List[T] is
        count: int
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count
    si

    class Exception is
        message: string

        init(message: string) is self.message = message si
    si

    class AssertFailedException: Exception is
        init(message: string) is super.init(message) si
    si

    partial object is
        get_hash_code() -> int => 0
    si

    partial string is
        get_hash_code() -> int => 0
    si
si
