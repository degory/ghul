use default

// A mutable local's join with its assignments is floored: where the only
// common type is object, or the types are scalars that would need a
// conversion, the local keeps its initializer's type and the assignment
// is reported.
class PLAIN is
    init() is si
si

struct POINT is
    x: int
    init(x: int) is self.x = x si
si

let count mut = 0
count = 1L

let label mut = "text"
label = 5

let thing mut = PLAIN()
thing = POINT(1)

write_line("{count} {label} {thing}")
