// A heap fact survives a call optimistically, but leaning on it
// afterwards is reported when the callee can change what it
// describes: a dereference warns - the hazard null-deref already
// covers - and flowing the value where only the narrowed type is
// accepted errors.

class BOX is
    n: int public;

    init() is
        n = 0;
    si

    touch() -> int is
        n = n + 1;
        return n;
    si
si

class HOLDER is
    _b: BOX?;

    init() is si

    // the callee writes a field, so it is not store-free and the
    // crossing cannot be discharged
    mutate() is
        _b = null;
    si

    // a dereference through the surviving fact is the hazard the
    // null-deref warning covers
    bare_use_after_call() -> int is
        if _b? then
            mutate();
            return _b.touch();
        fi

        return -1;
    si

    // flowing the value into a non-optional slot leans on presence
    // outright, so it is an error
    slot_use_after_call() -> int is
        if _b? then
            mutate();
            return consume(_b);
        fi

        return -1;
    si

    consume(b: BOX) -> int => b.n;

    // a type narrow dies the same way as a presence fact
    animal_use_after_call(a: Animal) -> int is
        if isa CAT(a) /\ _b? then
            mutate();
            return _b.touch();
        fi

        return -1;
    si
si

class Animal abstract is
    init() is si
si

class CAT: Animal is
    init() is super.init(); si
    purr() -> string => "purr";
si

entry() is
si
