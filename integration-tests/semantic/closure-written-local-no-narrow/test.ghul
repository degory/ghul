// A local assigned from inside a function literal shares one heap
// cell with the closure body, so invoking the closure rewrites it
// behind the enclosing scope's back. Flow narrowing forms no facts
// on such a local; the shapes a closure cannot rewrite keep
// narrowing as before.

get() -> string? => "hello";

// Assigned by the closure: no narrowing, so reading through `s`
// warns the way reading through any un-narrowed optional does.
closure_assigned() is
    let s: string? mut = get();

    let replace = () -> void is
        s = get();
    si;

    if s? then
        replace();

        IO.Std.write_line("{s.length}");
    fi
si

// Assigned by a closure that is never invoked between the test and
// the use: the decline is at formation, so this warns too.
closure_assigned_not_invoked() is
    let s: string? mut = get();

    let clear = () -> void is
        s = null;
    si;

    if s? then
        IO.Std.write_line("{s.length}");
    fi
si

// Captured but never assigned: captured by value, so the closure
// cannot rewrite it and the narrowing stands.
immutable_capture() is
    let s: string? = get();

    let show = () -> void is
        IO.Std.write_line("{s}");
    si;

    if s? then
        show();

        IO.Std.write_line("{s.length}");
    fi
si

// Reassigned but never captured: stays on the stack, and the
// narrowing stands.
not_captured() is
    let s: string? mut = get();

    s = get();

    if s? then
        IO.Std.write_line("{s.length}");
    fi
si

entry() is
    closure_assigned();
    closure_assigned_not_invoked();
    immutable_capture();
    not_captured();
si
