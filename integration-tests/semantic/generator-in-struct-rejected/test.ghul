namespace Test is
    // A struct method cannot be a generator. The rejection leaves the
    // member without a symbol, so its body is not compiled against one:
    // compiling it anyway reports every name in it as missing and trips
    // assertions that assume an enclosing function.
    //
    // What remains is the rejection itself plus one diagnostic per
    // parameter — a rejected declaration has no symbol to own its
    // parameters, so they are never declared.

    struct S is
        init() is si

        upto(times: int) -> Ghul.Pipes.Pipe[int] is
            let i mut = 0;

            while i < times do
                yield i;
                i = i + 1;
            od
        si
    si

    class Main is
        entry() static is
            let _ = S();

            return;
        si
    si
si
