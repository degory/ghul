namespace Test is
    // A struct method cannot be a generator. The rejection leaves the
    // member without a symbol, so its body is not compiled against one -
    // its parameters are still declared into a rejecting scope, so a
    // reference to one from the body (`times` below) resolves rather
    // than cascading into a further "symbol not found" report.

    struct S is
        init() is si

        upto(times: int) -> Ghul.Pipes.Pipe[int] is
            let i mut = 0;

            while i < times do
                yield i;
                i = i + 1;
            od
        si
    si

    class Main is
        entry() static is
            let _ = S();

            return;
        si
    si
si
