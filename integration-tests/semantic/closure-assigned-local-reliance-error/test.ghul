// A use only the narrowed view supports, after a call that can
// rewrite the closure-assigned local, is an error naming the call.
// The then-arm use before any call stays accepted: the fact is
// declined nowhere, only judged at uses that lean on it.

union Shape is
    CIRCLE(radius: int);
    SQUARE(side: int);
si

takes(s: string) => IO.Std.write_line(s);

get() -> string? => "hello";

lean_after_writer() is
    let s: string? mut = get();

    let clear = () -> void is
        s = null;
    si;

    if s? then
        clear();

        takes(s);
    fi
si

else_arm_after_writer() is
    let s: Shape mut = Shape.CIRCLE(3);

    let flip = () -> void is
        s = Shape.SQUARE(4);
    si;

    if isa Shape.CIRCLE(s) then
        IO.Std.write_line("then {s.radius}");
    else
        flip();

        IO.Std.write_line("else {s.side}");
    fi
si

entry() is
    lean_after_writer();
    else_arm_after_writer();
si
