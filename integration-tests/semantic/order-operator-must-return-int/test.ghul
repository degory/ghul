namespace Test is
    // `<>` answers how its operands are ordered, so it must return int.
    // That is a property of the operator's declaration, so it is
    // reported however the call is spelled: the relational tokens all
    // rewrite to `<>`, and a directly written `<>` reaches the same
    // member with the same requirement.

    class BOX is
        _v: int;

        init(v: int) is _v = v; si

        <>(other: BOX) -> string => "not an ordering";
    si

    class Main is
        entry() static is
            let a = BOX(3);
            let b = BOX(5);

            let written_directly = a <> b;
            let rewritten_from_a_relational_token = a < b;

            return;
        si
    si
si
