// A function that overrides or implements a declared-pure base must
// itself be pure - declared or proven. Call sites trust the base's
// declared bit across dispatch, so an unprovable, undeclared
// override is rejected; a declared or provably store-free one is
// accepted.

trait COUNTER is
    next() -> int pure;
si

use Collections;

class PROVEN: COUNTER is
    _base: int;
    init(base: int) is _base = base; si
    next() -> int => _base + 1;
si

class DECLARED: COUNTER is
    _count: int;
    init() is si
    next() -> int pure is
        return _count + 1;
    si
si

class STORING: COUNTER is
    _count: int;
    init() is si
    next() -> int is
        _count = _count + 1;
        return _count;
    si
si

// Assign accessors are bound through their property: declaring the
// property pure marks both accessors, so an overriding setter must be
// proven or declared even though the read side proves itself.

class BASEV is
    _v: int;

    init() is
        _v = 0;
    si

    v: int pure => _v,
        = nv is
            _v = nv;
        si
si

class SETTER_DECLARED: BASEV is
    _w: int;

    init() is
        _w = 7;
    si

    v: int pure => _w,
        = nv is
            _w = nv * 2;
        si
si

class SETTER_STORING: BASEV is
    _log: LIST[int];

    init() is
        _log = LIST[int]();
    si

    v: int => 0,
        = nv is
            _log.add(nv);
        si
si

entry() is
    IO.Std.write_line("{PROVEN(1).next()}");
si
