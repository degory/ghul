namespace Test is
    class Main is
        entry() static is
            check("hello");
            check_bare_tuple((1, "one"));
            check_meaningless_ascription((1, "one"));
        si

        check(o: object) static is
            // `int` is a value type, so this is an impossible match.
            // The one error for that must not be followed by a cascade:
            // `i` is still bound, with ERROR type, so the member access
            // below is absorbed rather than producing a spurious error.
            if let i: int = o then
                IO.Std.write_line("got {i.no_such_member}");
            fi

            // the binding is scoped to its own then-arm
            if let s: string = o then
                IO.Std.write_line(s);
            else
                IO.Std.write_line(s);
            fi

            IO.Std.write_line(s);
        si

        // A bare-form destructure with no refutable leaf anywhere can
        // never fail to match, whether or not the pattern's own
        // elements carry ascriptions or literals elsewhere. Unlike the
        // ascribed narrow above there is no unsafe cast underneath, so
        // this draws a warning rather than an error.
        check_bare_tuple(pair: (int, string)) static is
            if let (a, b) = pair then
                IO.Std.write_line("{a} {b}");
            fi
        si

        // A per-element ascription to the element's own type is the
        // nested equivalent of the top-level `i: int = o` case above
        // — narrowing `int` to `int` can never fail, so it
        // contributes no refutability either.
        check_meaningless_ascription(pair: (int, string)) static is
            if let (i: int, y) = pair then
                IO.Std.write_line("{i} {y}");
            fi
        si
    si
si
