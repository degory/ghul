namespace Test is
    // An operator declared on a type takes its left operand as `self`,
    // so its argument list holds the right operand alone. A second
    // argument leaves no call shape that could reach the declaration, so
    // it is rejected where it is written and declared undefined - uses of
    // it then report as an ordinary missing overload rather than
    // selecting a member whose arguments cannot match its parameters.

    class T is
        v: int;

        init(v: int) is
            self.v = v;
        si

        // rejected: two arguments on an instance operator
        +(a: T, b: T) -> int pure => 99;

        // accepted: one argument, the right operand
        -(other: T) -> int pure => v - other.v;

        // accepted: static, so both operands are arguments
        *(a: T, b: T) -> int static pure => a.v * b.v;

        use_them() static is
            let x = T(3);
            let y = T(4);

            let bad = x + y;
            let good = x - y;
            let also_good = x * y;
        si
    si

    // accepted: global, both operands are arguments
    /(a: T, b: T) -> int pure => a.v / b.v;

    class MAIN is
        entry() static is
            return;
        si
    si
si
