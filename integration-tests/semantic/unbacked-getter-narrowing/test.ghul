// A fact formed through a getter the solved effect relations cannot
// back for the fact's kind is never presented as a narrowing: a use
// that leans on it is an error naming the getter, a bare dereference
// draws the ordinary null-deref warning, and non-leaning uses behave
// exactly as they would on an un-narrowed optional. Shapes the
// relations do back - auto-properties, hand-written passthroughs,
// write-only getters, and monotone memoisers for presence - keep
// narrowing.

use IO.Std.write_line;

class INNER is
    label: string => "inner";

    init() is si
si

class SUB: INNER is
    init() is si
si

class HOST is
    init() is si

    _store: INNER? field;
    _frame: INNER? field;
    _touched: bool field;
    _count: int field;
    auto_prop: INNER?;

    // writes a member its own read closure contains - self-unstable
    // for both fact kinds
    dirty: INNER? is
        _count = _count + 1;
        return _store;
    si

    // hand-written passthrough - store-free once solved
    clean: INNER? is
        return _store;
    si

    // writes only a member its closure does not read - self-stable
    touched: INNER? is
        _touched = true;
        return _store;
    si

    // monotone memoiser - backs presence, never a type narrow
    frame: INNER? is
        if !_frame? then
            _frame = SUB();
        fi
        return _frame;
    si

    bump() is
        auto_prop = null;
    si
si

takes_inner(i: INNER) -> int => 1;

takes_sub(s: SUB) -> int => 2;

// a presence fact through the unbacked getter: leaning use errors
unbacked_presence_lean(h: HOST?) -> int is
    if h? /\ h.dirty? then
        return takes_inner(h.dirty);
    fi

    return 0;
si

// a type fact through the unbacked getter: leaning use errors
unbacked_type_lean(h: HOST?) -> int is
    if h? /\ isa SUB(h.dirty) then
        return takes_sub(h.dirty);
    fi

    return 0;
si

// a bare dereference through the unbacked fact warns, as it would
// with no test at all
unbacked_deref(h: HOST?) -> int is
    if h? /\ h.dirty? then
        write_line(h.dirty.label);
    fi

    return 0;
si

// non-leaning uses are untouched: interpolation, a read into a slot
// the wide type fills, and a re-test of the guarded path itself all
// behave as on an un-narrowed optional
unbacked_non_leaning(h: HOST?) -> int is
    if h? /\ h.dirty? then
        write_line("{h.dirty}");

        let copy: INNER? = h.dirty;
        write_line("{copy}");

        if h.dirty? then
            write_line("re-tested");
        fi
    fi

    return 0;
si

// backed shapes keep narrowing, all surfaces agreeing
backed_auto(h: HOST?) -> int is
    if h? /\ h.auto_prop? then
        return takes_inner(h.auto_prop);
    fi

    return 0;
si

backed_passthrough(h: HOST?) -> int is
    if h? /\ h.clean? then
        return takes_inner(h.clean);
    fi

    return 0;
si

backed_write_only(h: HOST?) -> int is
    if h? /\ h.touched? then
        return takes_inner(h.touched);
    fi

    return 0;
si

monotone_presence_backed(h: HOST?) -> int is
    if h? /\ h.frame? then
        return takes_inner(h.frame);
    fi

    return 0;
si

// the type narrow through a monotone memoiser stays declined
monotone_type_lean(h: HOST?) -> int is
    if h? /\ isa SUB(h.frame) then
        return takes_sub(h.frame);
    fi

    return 0;
si

// the test-site pointer on the error names the test that formed the
// fact at the erroring use, not a later re-test of the same path
two_tests_same_path(h: HOST?) -> int is
    if h? /\ h.dirty? then
        let r = takes_inner(h.dirty);
        return r;
    fi

    if h? /\ h.dirty? then
        write_line("{h.dirty}");
    fi

    return 0;
si

// a backed fact crossed by an undischargeable call keeps the
// existing kill treatment
external_kill(h: HOST?) -> int is
    if h? /\ h.auto_prop? then
        h.bump();
        return takes_inner(h.auto_prop);
    fi

    return 0;
si

entry() is
    let h = HOST();
    write_line("{unbacked_presence_lean(h)} {unbacked_type_lean(h)} {unbacked_deref(h)} {unbacked_non_leaning(h)}");
    write_line("{backed_auto(h)} {backed_passthrough(h)} {backed_write_only(h)} {monotone_presence_backed(h)}");
    write_line("{monotone_type_lean(h)} {two_tests_same_path(h)} {external_kill(h)}");
si
