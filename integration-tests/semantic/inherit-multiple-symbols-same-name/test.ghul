namespace Test is
    // `thing` arrives as a method from one trait and as a property from
    // two others, so the class inherits three symbols under one name
    // with nothing declared to override them.
    trait A is
        thing() -> int;
    si

    trait B is
        thing: int;
    si

    trait C is
        thing: int;
    si

    class D: A, B, C is
        init() is si
    si

    entry() is si
si
