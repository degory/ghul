// A member of the same name and parameter types as an inherited one,
// whose return type is neither the same nor narrower, reads as an
// implementation and is not one: a caller holding the base reaches what
// it did not override. The trait path already reports this.
class RESULT(value: int);

class Host is
    init() is si

    run() -> RESULT => RESULT(1)
si

class FAKE: Host is
    init() is super.init() si

    run() -> string? => null
si

entry() is si
