// A member of the same name and parameter types as an inherited one, whose
// return type is neither the same nor narrower, does not override it: it
// hides it, and a caller holding the base reaches the base's. That reads
// like an override and is not one, so it is warned about.
class RESULT(value: int);

class Host is
    init() is si

    run() -> RESULT => RESULT(1)
si

class FAKE: Host is
    init() is super.init() si

    run() -> string? => null
si

entry() is si
