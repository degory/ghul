use IO.Std.write_line

class HOLDER is
    name: string? public;
    init() is name = "x"; si

    run(h: System.Threading.ThreadStart) is
        if name? then
            h.invoke()
            write_line("{name.length}")
        fi
    si
si

_unused() is
    let holder = HOLDER()
    holder.run(() is holder.name = null; si)
si
