namespace Test is
    // Tests: a function type that takes an argument pack as its last
    // parameter with no marker written on it takes the pack as one
    // tuple. That is legal, and warned about at the declaration, since
    // a call written with the pack spread out then fails far from it.
    // The value form `v: T` is the tuple by design and is not warned
    // about, and neither is a formal that writes the marker.

    over_formal[T.., U](source: T, f: T -> U) -> U => f(source);

    over_return[T.., U](f: T.. -> U) -> T -> U => f;

    after_fixed[A, T..](f: (A, T) -> A) -> int => 0;

    nested[T.., U](make: (int) -> T -> U) -> int => 0;

    marked[T.., U](f: T.. -> U, v: T) -> U => f(v);

    class Main is
        entry() static is
        si
    si
si
