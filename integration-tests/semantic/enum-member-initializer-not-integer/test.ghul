// An enum member's initializer reaches metadata as a Constant row of
// the enum's underlying type, so anything that is not an integer
// literal is rejected where it is declared rather than emitted.

enum E is
    FROM_STRING = "x",
    FROM_CHARACTER = 'c',
    FROM_FLOAT = 1.5,
    FROM_BOOLEAN = true,
    ORDINARY = 1,
si

entry() is
    IO.Std.write_line("{E.ORDINARY}");
si
