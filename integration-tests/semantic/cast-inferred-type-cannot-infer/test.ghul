namespace Test is
    use Std = IO.Std;

    takes_a_double(d: double) is si
    takes_a_double(s: single) is si

    class HOLDER is
        init() is si
    si

    // An untyped operand matches every formal, so this second candidate
    // taking a double on the right leaves the operator below with two
    // it could be.
    +(a: HOLDER, b: double) -> double => b;

    class Main is
        entry() static is
            let count = 3;
            let other = 7;

            // Nothing constrains the initializer, so there is no target
            // type to take.
            let no_context = cast(count);

            // Neither operand can supply the other.
            let both_waiting = cast(count) + cast(other);

            // Resolution does not settle on one callee, so no formal
            // type is reached. Guessing between the overloads is the
            // thing this refuses to do.
            takes_a_double(cast(count));

            // Two operators accept a double on the right, and an
            // untyped left operand tells them apart no better than it
            // told the overloads above apart.
            let average = 2.5D;
            let ambiguous_operator = cast(count) + average;

            return;
        si
    si
si
