namespace Test is
    class Main is
        // A bare `_` in a call-argument position only infers the
        // parameter type when the call resolves to a single
        // unambiguous overload; here it could equally be `int` or
        // `string`, so the argument type cannot be inferred.
        f(x: int) static is si
        f(x: string) static is si

        entry() static is
            f(_);
        si
    si
si
