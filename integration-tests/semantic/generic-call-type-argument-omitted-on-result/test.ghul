namespace Test is
    use Std = IO.Std;

    class HOLDER is
        init() is si

        // T reaches the result, so the value the call produces carries
        // it too. One omission, reported once.
        get_value[T]() -> T => _[T];
    si

    class Main is
        entry() static is
            Std.write_line("{HOLDER().get_value()}");
        si
    si
si
