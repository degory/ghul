use IO.Std;

class ANIMAL is
    init() is si
    name() -> string => "animal";
si

class CAT: ANIMAL is
    init() is super.init(); si
    purr() -> string => "purr";
si

class DOG: ANIMAL is
    init() is super.init(); si
    bark() -> string => "woof";
si

reset() is
    pet = DOG();
si

let pet: ANIMAL mut = ANIMAL();

pet = CAT();

reset();

// the call can store to `pet`, so the narrow the assignment
// established cannot be leaned on here
Std.out.write_line(pet.purr());
