trait Source is
    items() -> Ghul.Pipes.Pipe[int] is
        yield 1;
    si
si

class Base: Source abstract is
    init() is si

    items() -> Ghul.Pipes.Pipe[int];
si

class ONE: Base is
    init() is super.init(); si
si

entry() is
    let s: Source = ONE();

    for i in s.items() do
        IO.Std.write_line("{i}");
    od
si
