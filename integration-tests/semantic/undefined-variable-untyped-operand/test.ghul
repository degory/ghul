// An undefined local variable has no type yet. Each of these reaches a
// consumer that assumes a typed operand, so the load has to produce an
// error-typed value rather than an untyped one.

binary() is
    let a = a + 1;
si

unary() is
    let b = -b;
si

index() is
    let xs = [1, 2, 3];
    let c = xs[c];
si

takes_int(i: int) -> int => i;

call() is
    let d = takes_int(d);
si

destructure_formal_without_aggregate_type((e: double, f: double)) -> double => e + f;

nested_destructure_formal_without_aggregate_type(((g: int, h: int), i: int)) -> int => g + h + i;

if_branch() is
    let j = if true then j else 2 fi;
si

interpolated_if_branch() -> string => (
    let k = "{if true then k else "b" fi}"
    k)

entry() static is
    return;
si
