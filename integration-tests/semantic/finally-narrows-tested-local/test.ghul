// A finally body runs on every path out of its try - completing,
// returning, or throwing - so it is walked as reachable, entering
// with only the pre-try definite-assignment facts. A presence test
// inside it narrows exactly as one outside would, even when the try
// body cannot complete normally.

class THING is
    init() is si

    poke() is si
si

get_thing() -> THING? => THING();

guard_after_returning_try() -> int is
    let mapping = get_thing();

    try
        return 1;
    finally
        if mapping? then
            mapping.poke();
        fi
    yrt
si

guard_after_completing_try() is
    let mapping = get_thing();

    try
        IO.Std.write_line("x");
    finally
        if mapping? then
            mapping.poke();
        fi
    yrt
si

entry() is
    guard_after_returning_try();
    guard_after_completing_try();
si
