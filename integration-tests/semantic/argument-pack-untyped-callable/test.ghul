namespace Test is
    // Tests: a pack binds to the tuple of the function written at its
    // own formal, which the function's parameter types are what say. A
    // literal leaving them to be inferred says nothing about what the
    // pack stands for, so there is still nothing to bind.

    n_ary[A.., B](f: A.. -> B) -> (A -> B) => f;

    untyped() is
        let g = n_ary((a, b) => a + b);
    si
si
