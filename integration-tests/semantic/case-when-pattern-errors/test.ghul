namespace Test is
    class Main is
        entry() static is
            check("hello", 1L);
        si

        check(o: object, n: long) static is
            case n
            // `n` is a plain `long`, so testing it for an `int` has
            // nothing to decide. The one error binds `i` with ERROR
            // type so the use below is absorbed rather than producing
            // a cascade.
            when i: int then
                IO.Std.write_line("got {i.no_such_member}");
            else
                IO.Std.write_line("other");
            esac

            case o
            when s: string then
                IO.Std.write_line(s);
            esac
        si
    si
si
