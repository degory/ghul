namespace Test is
    // Tests: a formal that does not carry the marker takes the pack as
    // the tuple it binds to, whatever the type parameter is declared as.
    // An N-ary function is not adapted to it, so the call is reported.

    apply[T.., U](f: T -> U, v: T) -> U => f(v);

    class Main is
        entry() static is
            apply((a, b) => "{a}{b}", ("x", "y"));
            return;
        si
    si
si
