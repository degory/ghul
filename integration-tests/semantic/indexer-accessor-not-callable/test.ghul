namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let s = "hello";

            // an indexer is reached by indexing and by nothing else:
            // neither the CLR-required accessor name nor the metadata
            // spelling of it is a member the language offers
            Std.write_line("{s.get_Item(0)}");
            Std.write_line("{s.get_chars(0)}");

            return;
        si
    si
si
