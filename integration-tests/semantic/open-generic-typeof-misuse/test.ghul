namespace Test is
    class THING[T] is
        init() is si
    si

    class PAIR[A, B] is
        init() is si
    si

    use Alias[T] = THING[T];

    // `FOO[_]` names a type only reflection can hold, so it is
    // accepted as the whole operand of a typeof and nowhere else.
    takes(x: THING[_]) is si

    class MAIN is
        entry() static is
            let declared: THING[_] = _;

            let mixed = typeof PAIR[_, int];
            let wrong_arity = typeof THING[_, _];
            let aliased = typeof Alias[_];
            let arrayed = typeof THING[_][];
            let nested = typeof PAIR[THING[_], int];
        si
    si
si
