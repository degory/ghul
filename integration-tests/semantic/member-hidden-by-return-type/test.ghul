// A class member with the same name and arguments as an inherited class
// member but a return type it does not accept hides the inherited one, with
// a warning. A narrower reference return still overrides, silently. A trait
// member's implementation has no such way out: a return that does not fit
// is an error.
namespace Test is
    class THING is
        init() is si
    si

    class OTHER is
        init() is si
    si

    class NARROWER: THING is
        init() is si
    si

    class BASE is
        init() is si

        make() -> THING => THING()

        narrowed() -> THING => THING()

        count() -> int => 0
    si

    class DERIVED: BASE is
        init() is si

        make() -> OTHER => OTHER()

        narrowed() -> NARROWER => NARROWER()

        count() -> long => 0L
    si

    trait Maker is
        make() -> THING
    si

    class MAKER: Maker is
        init() is si

        make() -> OTHER => OTHER()
    si
si
