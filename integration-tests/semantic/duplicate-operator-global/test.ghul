namespace Test is
    // Names beginning with `$` are the ones the compiler synthesises, and are
    // excluded from checks that only make sense for user-written code. A bare
    // `$` is a user-declared operator and gets checked like any other.
    $(value: object?) -> string => "a";
    $(value: object?) -> string => "b";

    class Main is
        entry() static is
            return;
        si
    si
si
