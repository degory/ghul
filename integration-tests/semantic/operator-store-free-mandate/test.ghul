// A member =~ or <> must be declared pure or provably store-free.
// PROVEN's operators are ordinary field comparisons the walk can
// verify without any annotation; DECLARED's operators loop over an
// array, which the walk cannot trace, so they need the pure
// declaration; STORING's operators mutate state and are rejected.

class PROVEN is
    x: int public;
    init(x: int) is self.x = x; si

    =~(other: PROVEN) -> bool => x == other.x;
    <>(other: PROVEN) -> int => x - other.x;

    get_hash_code() -> int => x;
si

class DECLARED is
    a: int[] public;
    init(a: int[]) is self.a = a; si

    =~(other: DECLARED) -> bool pure is
        for i in 0..a.count do
            if a[i] != other.a[i] then
                return false;
            fi
        od
        return true;
    si

    <>(other: DECLARED) -> int pure is
        for i in 0..a.count do
            if a[i] != other.a[i] then
                return a[i] - other.a[i];
            fi
        od
        return 0;
    si

    get_hash_code() -> int => a.count;
si

class STORING_EQ is
    n: int public;
    init(n: int) is self.n = n; si

    =~(other: STORING_EQ) -> bool is
        n = n + 1;
        return n == other.n;
    si

    get_hash_code() -> int => n;
si

class STORING_ORDER is
    n: int public;
    init(n: int) is self.n = n; si

    <>(other: STORING_ORDER) -> int is
        n = n + 1;
        return n - other.n;
    si
si

entry() is
    IO.Std.write_line("{PROVEN(1) =~ PROVEN(1)}");
si
