namespace Test is
    use Std = IO.Std;

    // A reference-type LUB whose only null-flagged arm is an ERROR
    // (an unresolved reference), not a genuine null, reports
    // "incompatible types" for that arm - matching the existing
    // value-type behaviour pinned by
    // integration-tests/semantic/mutual-recursion, rather than
    // silently widening the other arm's type to optional.

    class Main is
        entry() static is
            let x = if true then undefined_thing else "a" fi;
            Std.write_line(x);

            let y = case 1
                when 1 then undefined_thing_2
                else "b"
            esac;
            Std.write_line(y);

            return;
        si
    si
si
