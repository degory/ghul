namespace Test is
    use System.Runtime.CompilerServices.INotifyCompletion;

    // Has `get_awaiter`, but the awaiter lacks `get_result`.
    class NO_RESULT: INotifyCompletion is
        init() is si
        get_awaiter() -> NO_RESULT => self;
        is_completed: bool => true;
        on_completed(continuation: () -> void) is si
    si

    // Has every member but implements neither notify interface.
    class NO_NOTIFY is
        init() is si
        get_awaiter() -> NO_NOTIFY => self;
        is_completed: bool => true;
        get_result() -> int => 1;
        on_completed(continuation: () -> void) is si
    si

    // The awaiter's `is_completed` is not a bool.
    class BAD_COMPLETED: INotifyCompletion is
        init() is si
        get_awaiter() -> BAD_COMPLETED => self;
        is_completed: int => 1;
        get_result() -> int => 1;
        on_completed(continuation: () -> void) is si
    si

    class Main is
        compute() -> Tasks.TASK[int] static is
            await NO_RESULT();
            let a = await NO_NOTIFY();
            let b = await BAD_COMPLETED();
            return a + b;
        si

        entry() static is
            let _ = compute();
        si
    si
si
