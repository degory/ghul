// Construction of an imported type is trusted because the object
// being constructed did not exist before the call. A chained
// `super.init` to an imported base is the same callee reached where
// that does not hold: the receiver is an object of a type declared
// here, already in existence and reachable from elsewhere. The
// crossing must still end the fact, however scalar the base
// constructor's parameters are.

len(s: string) -> int => s.length;

class BOX is
    name: string? public;

    init() is
        name = null;
    si
si

class SUB: System.Exception is
    _length: int;

    init(box: BOX, message: string) is
        assert box.name?;
        super.init(message);
        _length = len(box.name);
    si
si
