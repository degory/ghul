namespace Test is
    use Std = IO.Std;

    union NUM is
        WHOLE(value: int);
        FRAC(value: double);
    si

    union PAIR is
        P(a: int, b: int);
        Q(x: int);
    si

    class Main is
        entry() static is
            Std.write_line("{by_value(NUM.WHOLE(7))}");
            Std.write_line("{by_element(PAIR.P(7, 8))}");
        si

        // The first arm matches only WHOLE(0), so WHOLE(7) matches
        // nothing and the arms do not cover the union.
        by_value(n: NUM) -> int static =>
            case n
            when (0): NUM.WHOLE then 100
            when (v): NUM.FRAC then 1
            esac;

        // Same, with the value test on one element of a multi-field
        // variant.
        by_element(n: PAIR) -> int static =>
            case n
            when (0, y): PAIR.P then 100
            when (v): PAIR.Q then 1
            esac;
    si
si
