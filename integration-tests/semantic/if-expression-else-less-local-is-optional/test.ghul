// An if expression with no else yields an optional, and a let that
// leaves its type to inference takes that optional: a member read
// through the local, and a store of it into the bare type, are both
// rejected, for a reference and a value branch type alike.
namespace Test is
    use IO.Std.write_line;

    t(c: bool) is
        let s = if c then "str" fi;
        let n = if c then 7 fi;

        write_line("{s.length}");

        let bare: string = s;
        let plain: int = n;
    si
si
