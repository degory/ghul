// An inferred cast whose target more than one overload could supply is
// refused with one error, whether the overloads are indexers or
// functions: nothing about the indexer is reported on top of it.
class TWO is
    init() is si
    [i: int]: string => "int {i}"
    [s: string]: string => "string {s}"
si

f(i: int) -> string => "int {i}"
f(s: string) -> string => "string {s}"

let n = 2L
let a = TWO()[cast(n)]
let b = f(cast(n))
