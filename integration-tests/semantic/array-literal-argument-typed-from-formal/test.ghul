namespace Test is
    trait Operation[T] is
        execute(left: T, right: T) -> T
    si

    class STRING_APPEND(): Operation[string] is
        execute(left: string, right: string) -> string => "{left}{right}"
    si

    takes(operations: Collections.Iterable[(name: string, operation: Operation[string])]) -> int => 0

    takes_any[T](operations: Collections.Iterable[(name: string, operation: Operation[T])]) -> int => 0

    class HOLDER(operations: Collections.Iterable[(name: string, operation: Operation[string])]);

    entry() is
        // an array literal argument is built at the formal it fills when
        // each of its elements converts to the formal's element type
        let a = takes([("+", STRING_APPEND())])
        let b = HOLDER([("+", STRING_APPEND())])
        let c = takes_any([("+", STRING_APPEND()), ("*", STRING_APPEND())])

        // and is still rejected where an element does not
        let d = takes([("+", "not an operation")])
    si
si
