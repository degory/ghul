namespace Test is
    // Tests: `..` in a declared return type marks the function the
    // result presents as N-ary. It may sit only on the parameter of a
    // function type on the return type's own spine; every other
    // position is reported, as is a name that no `[T..]` declares.

    inside_a_bigger_type[T.., U](v: T) -> Collections.LIST[T.. -> U] is si

    through_a_parameter[T.., U](v: T) -> (T.. -> U) -> U is si

    not_a_pack[A, U](v: A) -> A.. -> U is si

    on_the_type_itself[T.., U](v: T) -> U.. is si
si
