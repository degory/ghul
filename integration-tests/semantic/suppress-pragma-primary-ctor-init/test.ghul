namespace Test is
    // A @suppress on the primary init(..) reaches the synthesised
    // constructor's diagnostics even though the pragma's own span sits
    // on the written declaration, not on the class header the
    // synthesised constructor is anchored to.
    class SILENCED(p: int) is
        f: string public;

        @suppress("field-definite-assignment")
        init(..) is si
    si

    // Sibling without the pragma still warns.
    class WARNS(p: int) is
        f: string public;

        init(..) is si
    si

    // A pragma on a secondary init(..) reaches that constructor too.
    class SECONDARY(p: int) is
        f: string public;

        init(..) is si

        @suppress("field-definite-assignment")
        init(.., extra: int) is si
    si

    // Stacked pragmas on init(..): every one in the chain has to
    // survive, not just the outermost.
    class STACKED(p: int) is
        f: string public;

        @System.Obsolete("x")
        @suppress("field-definite-assignment")
        init(..) is si
    si

    entry() is si
si
