use IO.Std.write_line

class HOLDER is
    name: string? public;
    _run: System.Threading.ThreadStart;

    init() is
        name = "x"
        _run = () is name = null; si
    si

    // A non-generic named delegate reached through a field.
    go() is
        if name? then
            _run.invoke()
            write_line("{name.length}")
        fi
    si
si

_unused() is
    HOLDER().go()
si
