// A function literal that writes out a non-void return type is held
// to the same tail rule as a named function: a guard `if` whose only
// arm diverges is the statement it is, so the fall-through path
// returns the default value and no else is demanded. A terminator on
// the `fi` changes nothing.

namespace Test is
    class MAIN is
        entry() static is
            let broken = (c: bool) -> int is
                if c then
                    return 1;
                fi
            si;

            broken(true);
        si
    si
si
