// A function literal that writes out a non-void return type is held
// to the same tail rule as a named function: a guard `if` without
// `else` delivers no value on the fall-through path. Appending the
// `;` restores the old statement reading.

namespace Test is
    class MAIN is
        entry() static is
            let broken = (c: bool) -> int is
                if c then
                    return 1;
                fi
            si;

            broken(true);
        si
    si
si
