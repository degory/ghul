namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let d = 12.34m;

            // bool and word have no System.Decimal::op_* overload in
            // either direction, and no other user-defined conversion
            // operator reaches them either.
            let b = cast bool(d);
            let w = cast word(d);

            Std.out.write_line("{b} {w}");
        si
    si
si
