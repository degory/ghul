namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let d = 12.34m;

            // bool is not a numeric type, so there is no conversion to
            // reach - by a System.Decimal::op_* overload or otherwise.
            let b = cast bool(d);

            Std.out.write_line("{b}");
        si
    si
si
