// The reliance judge covers every consumption kind: one row per kind
// leans on a fact an unbacked getter cannot back and draws the
// reliance diagnostic by name, so a regression that re-opens any
// single slot is caught by name. The controls at the end use the
// same facts without leaning and stay clean.

use IO.Std.write_line;

class BASE is
    init() is si

    describe() -> string => "base";
si

class INNER: BASE is
    init() is si

    inner_only() -> string => "inner";
si

class HOST is
    init() is si

    _inner: INNER? field;
    _list: Collections.LIST[INNER]? field;
    _pair: (INNER, int)? field;
    _map: Collections.MAP[string, INNER]? field;
    _object: object? field;
    _count: int field;

    // Each getter writes _count, which its own body also reads, so
    // its own call is an undischargeable crossing: the relations
    // cannot back any fact read through it.
    dirty: INNER? is
        _count = _count + 1;
        return _inner;
    si

    dirty_list: Collections.LIST[INNER]? is
        _count = _count + 1;
        return _list;
    si

    dirty_pair: (INNER, int)? is
        _count = _count + 1;
        return _pair;
    si

    dirty_map: Collections.MAP[string, INNER]? is
        _count = _count + 1;
        return _map;
    si

    dirty_object: object? is
        _count = _count + 1;
        return _object;
    si
si

takes(b: BASE) is si

// A let initializer judged against the local's declared type.
lean_let_declared(h: HOST) is
    if h.dirty? then
        let a: BASE = h.dirty;
        write_line(a.describe());
    fi
si

// A let initializer judged against the local's inferred type: the
// inferred INNER only the narrowed view satisfies.
lean_let_inferred(h: HOST) is
    if h.dirty? then
        let a = h.dirty;
        write_line(a.inner_only());
    fi
si

// An arrow-bodied lambda delivers its value as the return: judged
// against the inferred return type.
lean_lambda_arrow(h: HOST) is
    if h.dirty? then
        let f = () => h.dirty;
        write_line(f().inner_only());
    fi
si

// An arrow-bodied named function: judged against the declared return.
lean_named_arrow(h: HOST) -> INNER =>
    val
        if h.dirty? then
            return h.dirty;
        fi

        INNER();
    lav;

// A tuple element whose declared type rejects the wide value.
lean_tuple_element(h: HOST) is
    if h.dirty? then
        let t = (h.dirty, 1);
        write_line(t.`0.inner_only());
    fi
si

// The iterable an iterator resolution ran against: a presence-only
// lean warns rather than errors.
lean_for_in(h: HOST) is
    if h.dirty_list? then
        for x in h.dirty_list do
            write_line(x.inner_only());
        od
    fi
si

// The source a destructure pulls its elements from: a presence-only
// lean warns rather than errors.
lean_destructure(h: HOST) is
    if h.dirty_pair? then
        let (a, b) = h.dirty_pair;
        write_line("{a.inner_only()} {b}");
    fi
si

// A thrown value whose wide type is not Exception-derived leans on
// the type narrow.
lean_throw(h: HOST) is
    if isa System.ArgumentException(h.dirty_object) then
        throw h.dirty_object;
    fi
si

// A checked cast's non-optional target assumes the operand's
// presence; castclass does not re-check a null.
lean_cast(h: HOST) is
    if h.dirty? then
        let x: BASE = cast(h.dirty);
        write_line(x.describe());
    fi
si

// A call argument whose formal rejects the wide type (judged before
// this change; pinned here with the rest of the matrix).
lean_call_argument(h: HOST) is
    if h.dirty? then
        takes(h.dirty);
    fi
si

// A dispatch through a receiver whose member only the narrowed type
// declares (judged before this change; pinned with the matrix).
lean_receiver_member(h: HOST) is
    if h.dirty? then
        h.dirty.inner_only();
    fi
si

// A return statement judged against the declared return type (judged
// before this change; pinned with the matrix).
lean_return_statement(h: HOST) is
    if h.dirty? then
        let f: () -> INNER = () is
            return h.dirty;
        si;

        write_line(f().inner_only());
    fi
si

// The indexer's receiver reached via the operator path (judged
// before this change; pinned with the matrix).
lean_indexer_receiver(h: HOST) is
    if h.dirty_map? then
        let v = h.dirty_map["k"];
        write_line(v.inner_only());
    fi
si

// Controls: the same facts, consumed without leaning.

// A wide slot accepts the un-narrowed type, and interpolation is a
// non-leaning use.
clean_let_wide(h: HOST) is
    if h.dirty? then
        let a: INNER? = h.dirty;
        write_line("{a}");
    fi
si

// A refutable pattern re-checks at runtime.
clean_if_let(h: HOST) is
    if let a = h.dirty then
        write_line(a.inner_only());
    fi
si

entry() is si
