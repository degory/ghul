// The tuple-in shape a pack formal takes is not a type an N-ary literal
// can be returned as: a literal declaring it is rejected at the body,
// and the report survives the spread-normalisation retry the call goes
// through, which once rolled it back and compiled the call.
namespace Grid is
    use IO.Std.write_line;

    run_1[T.., U](make: (int) -> T.. -> U, v: T..) -> U => make(10)(v);

    cell() -> int => run_1((k: int) -> ((int, int)) -> int => (a: int, b: int) -> int => a + b * k, 1, 2);

    cell_explicit() -> int =>
        run_1[(int, int), int]((k: int) -> ((int, int)) -> int pure => (a: int, b: int) -> int => a + b * k, 1, 2);

    entry() is
        write_line("{cell()}");
    si
si
