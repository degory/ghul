// Fact lifetime for a presence fact proved on a member of the
// enclosing instance, whether read bare or as the root of a longer
// path. Each function below reads the member after something that
// invalidates the fact, so each read is an error: the point of the
// test is that widening these facts to value positions did not widen
// how long they live.

len(s: string) -> int => s.length;

class HOLDER is
    name: string? public;

    init() is
        name = null;
    si
si

class SUBJECT is
    _prop: string?;
    _holder_prop: HOLDER;
    _holder_field: HOLDER field;
    _sink: int field;

    init() is
        _prop = null;
        _holder_prop = HOLDER();
        _holder_field = HOLDER();
    si

    _store() is
        _sink = _sink + 1;
    si

    // a possibly-storing call forgets the bare property fact
    call_after_bare_guard() -> int is
        if !_prop? then return -1; fi
        _store();
        return len(_prop);
    si

    // and a path rooted at an instance member
    call_after_path_guard() -> int is
        if !_holder_field.name? then return -1; fi
        _store();
        return len(_holder_field.name);
    si

    // a heap store forgets a property-rooted path: the root is read
    // through its getter, which the store may have changed
    store_after_property_root_guard() -> int is
        if !_holder_prop.name? then return -1; fi
        _sink = 1;
        return len(_holder_prop.name);
    si

    // reassigning the root member redirects the path
    root_reassigned() -> int is
        if !_holder_field.name? then return -1; fi
        _holder_field = HOLDER();
        return len(_holder_field.name);
    si

    // a store to the leaf through any receiver invalidates it
    aliased_leaf_store(other: HOLDER) -> int is
        if !_holder_field.name? then return -1; fi
        other.name = null;
        return len(_holder_field.name);
    si

    // assigning the member itself, written the other way round
    self_store_after_guard() -> int is
        if !self._prop? then return -1; fi
        _prop = null;
        return len(self._prop);
    si
si

// A local or parameter of the same name shadows the member in the
// lexical lookup the bare spelling uses, so `name` and `self.name`
// name different locations and neither may borrow the other's fact.
// The constructor that assigns `self.name = name` is the everyday
// case, and there the member is still absent where the parameter is
// present.
class SHADOWED is
    name: string?;

    init(name: string?) is
        self.name = null;

        if name? then
            let from_member: string = self.name;
        fi

        if self.name? then
            let from_parameter: string = name;
        fi

        self.name = name;
    si
si
