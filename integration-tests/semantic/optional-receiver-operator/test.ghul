namespace Test is
    // A user-declared operator resolved as a member takes its left
    // operand as the receiver, so an optional one not proven to hold a
    // value here warns exactly as `a.foo(b)` would. `=~` and `!~` are
    // written to survive absence - their null checks go around the call
    // - so they do not warn.

    class THING is
        v: int;

        init(v: int) is
            self.v = v;
        si

        -(other: THING) -> int pure => v - other.v;

        <>(other: THING) -> int pure => v - other.v;

        =~(other: THING) -> bool pure => v == other.v;

        get_hash_code() -> int => v;
    si

    class MAIN is
        subtract(a: THING?, b: THING) -> int => a - b;

        less(a: THING?, b: THING) -> bool => a < b;

        narrowed(a: THING?, b: THING) -> int is
            if a? then
                return a - b;
            fi

            return 0;
        si

        equal(a: THING?, b: THING) -> bool => a =~ b;

        unequal(a: THING?, b: THING) -> bool => a !~ b;

        entry() static is
            return;
        si
    si
si
