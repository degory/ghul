// A non-void tail of an incompatible type is an error at the tail,
// terminated or not - discarding a wrongly-typed value in a
// value-returning body is broken code, and `let _ = expr` is the
// explicit spelling for a genuine discard.
namespace Test is
    terminated() -> int is
        "not an int";
    si

    unterminated() -> int is
        "still not an int"
    si

    explicit_discard() -> int is
        let _ = "fine to drop"
        7
    si
si
