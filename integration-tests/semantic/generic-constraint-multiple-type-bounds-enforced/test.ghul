// A type parameter with two `/\`-joined bounds is enforced against both:
// `HALF` implements `NAMED` only, so the second bound rejects it while
// the first is satisfied.

namespace Test is
    trait NAMED is
        name: string;
    si

    trait SIZED is
        size: int;
    si

    class THING: NAMED, SIZED is
        name: string => "thing";
        size: int => 7;
        init() is si
    si

    class HALF: NAMED is
        name: string => "half";
        init() is si
    si

    f[T: NAMED /\ SIZED](x: T) -> string => "{x.name}/{x.size}";

    class Main is
        entry() static is
            f[THING](THING());
            f[HALF](HALF());
            return;
        si
    si
si
