// A property declared `stable` promises that two adjacent reads with
// nothing between them agree on presence and runtime type. Facts
// narrowed through one are backed although the classifier cannot
// prove the getter self-stable, the getter's own re-read discharges
// for both fact kinds, and other calls' crossings are judged as
// usual. Overrides must honour the contract — declared stable or
// provably self-stable. The controls at the end keep the errors the
// declaration removes and the ones it must not.

use IO.Std.write_line;

class INNER is
    init() is si

    inner_only() -> string => "inner";
si

class OUTER is
    init() is si

    other: INNER?;
si

// The classifier cannot prove this getter self-stable: the
// interpolation call inside is unwalked, so its read closure is
// unbounded. That is exactly the shape `stable` exists for.
class CACHE is
    init() is si

    _cached: string?;

    value: string? stable =>
        val
            if _cached? then
                return _cached;
            fi

            _cached = "{compute_part()}";
            _cached
        lav;

    item: INNER? stable =>
        val
            if _item? then
                return _item;
            fi

            _item = INNER();
            _item
        lav;

    _item: INNER?;

    nested: OUTER? stable =>
        val
            if _nested? then
                return _nested;
            fi

            _nested = OUTER();
            _nested
        lav;

    _nested: OUTER?;

    compute_part() -> string => "computed";

    invalidate() -> bool is
        _cached = null;
        return true;
    si
si

// The same getter without the declaration: the classifier refuses
// its facts.
class UNSTABLE_CACHE is
    init() is si

    _cached: string?;

    value: string? =>
        val
            if _cached? then
                return _cached;
            fi

            _cached = "{compute_part()}";
            _cached
        lav;

    compute_part() -> string => "computed";
si

class HOST is
    init() is si

    _count: int;

    mutate() -> bool is
        _count = _count + 1;
        return true;
    si
si

// Override enforcement: the base getter is declared stable.
class BASE_STORE is
    init() is si

    _v: string?;

    value: string? stable => _v;
si

// Declared stable: honours the contract.
class DECLARED_OVERRIDE: BASE_STORE is
    init() is si

    _w: string?;

    value: string? stable => _w;
si

// Provably self-stable without the declaration: a plain passthrough
// the classifier proves. Honours the contract.
class PROVEN_OVERRIDE: BASE_STORE is
    init() is si

    _w: string?;

    value: string? => _w;
si

// Neither declared stable nor provably self-stable: rejected.
class BAD_OVERRIDE: BASE_STORE is
    init() is si

    _w: string?;

    value: string? =>
        val
            if _w? then
                return _w;
            fi

            _w = "{compute_part()}";
            _w
        lav;

    compute_part() -> string => "computed";
si

// stable is only valid on a property: a function declaration
// carrying it is rejected.
class MISPLACED is
    init() is si

    frobnicate() -> int stable => 3;
si

takes(s: string) is
    write_line(s);
si

takes_inner(i: INNER) is
    write_line(i.inner_only());
si

entry() is
    let cache = CACHE();
    let unstable = UNSTABLE_CACHE();
    let host = HOST();

    // A presence fact through the stable getter leans cleanly —
    // including the branch's own re-read.
    if cache.value? then
        takes(cache.value);
    fi

    // A type fact through a stable getter leans cleanly too.
    if isa INNER(cache.item) then
        takes_inner(cache.item);
    fi

    // An intervening call that writes nothing the getter reads
    // discharges as usual.
    if cache.value? /\ host.mutate() then
        takes(cache.value);
    fi

    // A path fact read through a stable hop: the branch's re-read of
    // the stable hop discharges like the target case.
    if cache.nested? then
        if cache.nested.other? then
            takes_inner(cache.nested.other);
        fi
    fi

    // Controls — these must stay errors.

    // stable does not shield the fact from a call that writes what
    // the getter reads.
    if cache.value? /\ cache.invalidate() then
        takes(cache.value);
    fi

    // Without the declaration the classifier refuses the fact.
    if unstable.value? then
        takes(unstable.value);
    fi
si
