// A tuple type with some elements named renders the unnamed ones bare,
// and a function type taking one array or tuple keeps that parameter's
// parentheses, so neither message reads as a different type.
namespace Test is
    pair() -> (name: string, int) => (name = "a", 1);

    entry() is
        let a: int = pair();
        let f: (int[]) -> int = 1;
        let g: ((int, int)) -> int = 1;
    si
si
