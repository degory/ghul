// A value narrowed twice in one body has a record per drop, so the call
// the error names is the one the failing use was short of, and the
// narrowing it is judged against is that one too - not the narrowing to
// another type that an earlier branch lost.
class ANIMAL is
    init() is si
si

class CAT: ANIMAL is
    init() is super.init() si

    purr() -> string => "purr"
si

class DOG: ANIMAL is
    init() is super.init() si

    bark() -> string => "woof"
si

class CARRIER is
    occupant: ANIMAL public;

    init(occupant: ANIMAL) is
        self.occupant = occupant
    si

    swap(other: ANIMAL) is
        occupant = other
    si

    shuffle(other: ANIMAL) is
        occupant = other
    si
si

describe(carrier: CARRIER, other: ANIMAL) -> string is
    if isa DOG(carrier.occupant) then
        carrier.swap(other)
    fi

    if isa CAT(carrier.occupant) then
        carrier.shuffle(other)

        return carrier.occupant.purr()
    fi

    return "none"
si

entry() is si
