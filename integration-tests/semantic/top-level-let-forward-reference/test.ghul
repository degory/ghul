let add_one = (n: int) -> int => doubled(n) + 1;
let doubled = (n: int) -> int => n * 2;

let countdown = (n: int) -> int => if n <= 0 then 0 else countdown(n - 1) fi;

show() is
    IO.Std.write_line("{greeting}");
