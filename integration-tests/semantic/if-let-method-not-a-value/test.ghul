use IO.Std.write_line
use Ghul.Pipes.Pipe

reading(path: string) -> Pipe[string] is
    let reader = IO.File.open_text(path)

    while let reader.read_line do
        yield read_line
    od
si

entry() is
    let reader = IO.File.open_text("input.txt")

    if let reader.read_line then
        write_line("{read_line.length}")
    fi

    if let named = reader.read_line then
        write_line("{named}")
    fi

    for line in reading("input.txt") do
        write_line(line)
    od
si
