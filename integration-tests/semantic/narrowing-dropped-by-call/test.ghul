// A narrowing ends at the first call the effect relations cannot show
// left the value alone, so a member of the narrowed type is missing
// from the widened one the use sees. The error is the ordinary
// member-not-found, and it names the call the narrowing ended at.
class ANIMAL is
    init() is si
si

class CAT: ANIMAL is
    init() is super.init() si

    purr() -> string => "purr"
si

class CARRIER is
    occupant: ANIMAL public;

    init(occupant: ANIMAL) is
        self.occupant = occupant
    si

    swap(other: ANIMAL) is
        occupant = other
    si
si

describe(carrier: CARRIER, other: ANIMAL) -> string is
    if isa CAT(carrier.occupant) then
        carrier.swap(other)

        return carrier.occupant.purr()
    fi

    return "not a cat"
si

entry() is si
