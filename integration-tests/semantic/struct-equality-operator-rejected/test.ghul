namespace Test is
    // == and != lower to a single ceq instruction, which is a scalar
    // comparison. For a struct operand the runtime either refuses it
    // at JIT time or runs a shallow bitwise comparison instead of
    // value equality, so both operators are rejected on struct
    // operands. Primitive scalars, enums, references, decimal,
    // tuples and type parameters keep the operators.

    struct PAIR is
        a: int;
        b: int;

        init(a: int, b: int) is
            self.a = a;
            self.b = b;
        si
    si

    enum Suit is
        HEARTS,
        SPADES,
    si

    // type parameters keep both operators: the emitted comparison is
    // correct for primitive and reference instantiations, and
    // generic code has no alternative operator to reach for
    eq[T](a: T, b: T) -> bool => a == b;

    ne[T](a: T, b: T) -> bool => a != b;

    class Main is
        entry() static is
            let p1 = PAIR(1, 2);
            let p2 = PAIR(1, 2);

            let bad_eq = p1 == p2;
            let bad_ne = p1 != p2;

            let imported = System.DateTime(2020, 1, 1) == System.DateTime(2020, 1, 1);

            // an optional struct pair is rejected the same way:
            // PAIR? is a Nullable[PAIR], itself a struct
            let po1: PAIR? = PAIR(1, 2);
            let po2: PAIR? = PAIR(3, 4);
            let bad_optional = po1 == po2;

            // a null presence test on an optional struct fails the
            // non-assignable check instead: the null literal is not
            // comparable with a value type
            let bad_null_test = po1 == null;

            // all fine: primitive scalars, enums, references, decimal, tuples
            let ok_int = 1 == 2;
            let ok_ne = 1 != 2;
            let ok_bool = true == false;
            let ok_char = 'a' == 'b';
            let ok_string = "x" == "x";
            let ok_enum = Suit.HEARTS == Suit.SPADES;
            let ok_decimal = 1.0m == 1.0m;
            let ok_double = 1.0d == 1.0d;
            let ok_tuple = (1, 2) == (1, 2);

            let o: object? = null;
            let ok_null = o == null;
        si
    si
si
