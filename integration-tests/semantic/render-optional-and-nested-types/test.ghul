// Types render as they would be written where the message is read: a
// named tuple's elements scope-relatively, a keyword element name under
// its backtick, an optional function, action or array with its `?`, and
// an array of functions with its element in parentheses.
namespace Lib.Inner is
    class THING is
        init() is si
    si
si

namespace Lib is
    use Inner.THING;

    make() -> (value: int, thing: THING) => (value = 1, thing = THING());
si

namespace App is
    t(f: (() -> void)?, g: ((int) -> int)?, bytes: ubyte[]?, fs: (string -> string)[]) is
        let a: int = Lib.make();
        let b: int = (assembly = "a", `namespace = "b");
        let c: int = f;
        let d: int = g;
        let e: int = bytes;
        let h: int = fs;
    si
si
