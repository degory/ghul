namespace Test is
    use Collections;
    use Ghul.Pipes;

    // The `|` pipe operator is gone. Both of its readings report the
    // same thing: the postfix wrap on its own, and the wrap that a
    // combinator chain was written on. The wrap is still built for
    // recovery, so the chain behind it resolves and this error is
    // reported alone.
    class Main is
        entry() static is
            let xs = [1, 2, 3];

            let wrapped = xs|;

            let chained = xs | .map(x => x * 2);

            return;
        si
    si
si
