namespace Test is
    use IO.Std.write_line;

    entry() is
        // Every contribution null with no expected type: nothing to
        // infer the block's type from, so this stays an error.
        let all_null = val
            null
        lav;

        // A null tail beside a typed contributor widens the join to
        // the optional carrier.
        let widened: int? = val
            if true then return 10 fi;
            null
        lav;

        // All contributions null under an expected type: the block
        // settles at that type.
        let all_null_typed: string? = val
            null
        lav;

        write_line("done");
    si
    // A type-variable contribution cannot join a settled null: the
    // same verdict if / case expression arms reach.
    pick[T](t: T) -> int is
        let r = val
            return t;
            null
        lav;

        return 0;
    si
si
