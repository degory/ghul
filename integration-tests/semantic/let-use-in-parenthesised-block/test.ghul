namespace Test is
    use Ghul;
    use Std = IO.Std;

    class HANDLE: Disposable is
        init() is si

        read() -> string => "value";

        dispose() is si
    si

    class Main is
        in_a_block() -> string static is
            let text = (let use handle = HANDLE(); handle.read());

            return text;
        si

        as_a_body() -> string static =>
            (let use handle = HANDLE(); handle.read());

        entry() static is
            Std.write_line(in_a_block());
            Std.write_line(as_a_body());
        si
    si
si
