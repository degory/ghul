namespace Test is
    use IO.Std.write_line;

    zero_of[T](ignored: int) -> T => _[T];

    takes_int(i: int) -> int => i + 1;

    takes_string(s: string?) -> int => if s? then s.length else -1 fi;

    identity[T](value: T) -> T => value;

    entry() is
        let from_int_slot = takes_int(zero_of(1));
        let from_string_slot = takes_string(zero_of(1));
        let through_generic_slot = identity[int](zero_of(1));

        write_line("{from_int_slot} {from_string_slot} {through_generic_slot}");
    si
si
