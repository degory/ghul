namespace Test is
    use Collections;

    // A class, struct or trait declared `pure` requires its instance
    // members to be pure: proven store-free, or declared `pure` - a
    // trusted assertion like any other pure declaration, not a
    // verified one. Constructors, statics and assign accessors are
    // exempt. A getter that writes through an assign accessor counts
    // as storing, and members reaching the type through an impl block
    // are held to the same rule.

    class COUNTER pure is
        _n: int;

        init() is
            _n = 0;
        si

        // Stores: rejected.
        bump() is
            _n = _n + 1;
        si

        // The same body declared pure: trusted, not verified.
        bump_trusted() pure is
            _n = _n + 1;
        si

        n: int => _n,
            = v is
                _n = v;
            si

        // A getter that writes through the assign accessor of another
        // property is a storing member.
        doubled: int =>
            val
                n = 5;
                n * 2
            lav;
    si

    struct P pure is
        x: int;

        init(v: int) is
            x = v;
        si

        side(xs: LIST[int]) -> int is
            xs.add(1);
            return x;
        si
    si

    trait Q pure is
        d() -> int is
            let xs = LIST[int]();
            xs.add(1);
            return 1;
        si
    si

    trait M is
        bump() -> int;
    si

    class IMPLD pure is
        _n: int;

        init() is
            _n = 0;
        si
    si

    impl M for IMPLD is
        bump() -> int is
            _n = _n + 1;
            return _n;
        si
    si
si
