@no_std()
namespace Test is
    // Unrelated generic types must not gain access to each other's
    // private members: the member is private to its own declaring
    // type, and a second generic reading it is still an outsider.

    struct A[T] is
        _v: T;
        init(v: T) is _v = v; si
        peek(other: B[T]) -> T => other._w;
    si

    struct B[T] is
        _w: T;
        init(v: T) is _w = v; si
    si
si
