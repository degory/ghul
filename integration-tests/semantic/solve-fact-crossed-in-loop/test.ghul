// a fact established before a loop, crossed inside it, used after
use IO.Std.write_line
class H is
    n: string?
    init() is n = "start" si
    step(i: int) is if i == 2 then n = null fi si
    go() -> string is
        if n? then
            for i in 0..4 do step(i) od
            return n
        fi
        return "none"
    si
si
write_line(H().go())
