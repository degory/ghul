namespace Test is
    use IO.Std;

    // apply's type argument A appears only in the lambda's parameter
    // position. Matching describe[E] would bind A to Iterable[E] for
    // an unbound E that belongs to describe, which cannot be emitted
    // as a call-site type argument. The call must fail to infer A.
    describe(o: object?) -> string => "object";
    describe[E](i: Collections.Iterable[E]) -> string => "sequence";

    class PLAIN is
        init() is si

        apply[A, R](f: (A) -> R) -> R => f(_[A]);
    si

    entry() is
        Std.write_line(PLAIN().apply(x => describe(x)));
    si
si
