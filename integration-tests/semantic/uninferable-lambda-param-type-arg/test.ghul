namespace Test is
    use IO.Std;

    // apply's type argument A appears only in the lambda's parameter
    // position. With two describe overloads the untyped parameter
    // matches describe[E], which would bind A to Iterable[E] for an
    // unbound E belonging to describe — that specialization used to
    // emit as Iterable<!!0> and fail to load. Refuse the bind and
    // report that A cannot be inferred.
    describe(o: object?) -> string => "object";
    describe[E](i: Collections.Iterable[E]) -> string => "sequence";

    class PLAIN is
        init() is si

        apply[A, R](f: (A) -> R) -> R => f(_[A]);
    si

    entry() is
        Std.write_line(PLAIN().apply(x => describe(x)));
    si
si
