// The bitwise operators are only available on an enum carrying
// `System.FlagsAttribute` — an ordinal enum like this one was never
// meant to combine its members, so `&`/`|`/`^`/`\` on it are the
// ordinary overload-resolution failure rather than a special check.

enum Suit is
    SPADES,
    HEARTS,
    DIAMONDS,
    CLUBS,
si

entry() is
    let a = Suit.SPADES & Suit.HEARTS;
    let b = Suit.SPADES | Suit.HEARTS;
    let c = Suit.SPADES ^ Suit.HEARTS;
    let d = \Suit.SPADES;
si
