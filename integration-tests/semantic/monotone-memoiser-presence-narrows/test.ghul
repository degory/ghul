use IO.Std.write_line;

// A monotone memoiser - one whose written values are always present
// and whose absent returns only fire when the memoised member was
// absent - cannot change its presence answer between two adjacent
// reads, so a presence fact through it survives the getter's own
// call and leaning on it is sound. A type fact through the same
// getter is still declined, as is a getter that can make its member
// absent again, and a presence fact crossed by some other call that
// can change it is reported as before.

class BASE is
    init() is si
si

class SUB: BASE is
    init() is super.init(); si
si

class OTHER: BASE is
    init() is super.init(); si
si

class HOLDER is
    _frame: BASE? field;
    _hit: int field;
    _absent: BASE? field;

    init() is si

    source() -> int? => if _hit > 0 then _hit else null fi;

    // the monotone memoiser shape: writes only _frame, only a
    // present value, returns absent only under !_frame?
    frame: BASE? is
        if !_frame? then
            let e = source();

            if e? then
                _frame = SUB();
            else
                return null;
            fi
        fi

        return _frame;
    si

    // writes an absent value: not monotone
    non_monotone: BASE? is
        if !_absent? then
            _absent = null;
        fi

        return _absent;
    si

    // an if-let arm is not an else arm: its absent return fires when
    // source() is present regardless of _frame, so the _frame? test
    // on the later arm guards nothing here. The memoising write keeps
    // this getter off the store-free route, so only the shape check
    // can answer
    unguarded_arm: BASE? is
        if let e = source() then
            return null;
        elif _frame? then
            return _frame;
        else
            _frame = SUB();
        fi

        return _frame;
    si

    bump() is _hit = _hit + 1; si
si

takes(b: BASE) -> int => 1;
takes_sub(s: SUB) -> int => 2;

// a presence fact through the monotone memoiser carries its
// leaning uses: the reads re-invoke the getter, and its own call
// cannot change the answer
monotone_presence(h: HOLDER?) -> int is
    if h? /\ h.frame? then
        return takes(h.frame);
    fi

    return 0;
si

// a type fact through the same getter is still declined
monotone_type(h: HOLDER?) -> int is
    if h? /\ isa SUB(h.frame) then
        return takes_sub(h.frame);
    fi

    return 0;
si

// a getter that can make its member absent again is still declined
non_monotone_presence(h: HOLDER?) -> int is
    if h? /\ h.non_monotone? then
        return takes(h.non_monotone);
    fi

    return 0;
si

// an if-let arm's absent return is not guarded by a sibling's
// presence test: still declined
unguarded_arm_presence(h: HOLDER?) -> int is
    if h? /\ h.unguarded_arm? then
        return takes(h.unguarded_arm);
    fi

    return 0;
si

// a presence fact crossed by another call that can change it is
// still reported
crossed_presence(h: HOLDER?) -> int is
    if h? /\ h.frame? then
        h.bump();
        return takes(h.frame);
    fi

    return 0;
si

entry() is
    let h = HOLDER();
    write_line("{monotone_presence(h)} {monotone_type(h)} {non_monotone_presence(h)} {unguarded_arm_presence(h)} {crossed_presence(h)}");
si
