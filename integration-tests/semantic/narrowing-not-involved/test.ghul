// A member missing for its own sake, with a call in front of it that
// drops nothing, is reported without anything about a narrowing.
class ANIMAL is
    init() is si
si

class CARRIER is
    occupant: ANIMAL public;

    init(occupant: ANIMAL) is
        self.occupant = occupant
    si

    swap(other: ANIMAL) is
        occupant = other
    si
si

describe(carrier: CARRIER, other: ANIMAL) -> string is
    carrier.swap(other)

    return carrier.occupant.purr()
si

entry() is si
