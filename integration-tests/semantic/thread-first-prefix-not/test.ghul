namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;

    // Tests: a prefix `!` applies to the subject rather than to the answer
    // of the chain, so `!xs |> any(p)` negates the array and is rejected.

    entry() is
        let xs = [1, 2, 3];

        write_line("{!xs |> any(x => x > 2)}");
    si
si
