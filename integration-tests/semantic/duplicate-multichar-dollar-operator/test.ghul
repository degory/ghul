namespace Test is
    // A multi-character operator starting with `$` is still a
    // user-declared operator, not one of the compiler's own `$`-prefixed
    // synthesised names, and is checked for duplicates like any other.
    <$>(value: object?) -> string => "a";
    <$>(value: object?) -> string => "b";

    class Main is
        entry() static is
            return;
        si
    si
si
