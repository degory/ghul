namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            Std.write_line("{trap(true, false)}");
            Std.write_line("{gap(true, false)}");
        si

        // Each column carries a wildcard in some arm, so a check that
        // asked whether every column was covered would accept this.
        // Coverage is over the combinations, and (false, false)
        // reaches neither arm.
        trap(a: bool, b: bool) -> int static =>
            case (a, b)
            when (true, _) then 1
            when (_, true) then 2
            esac;

        // Several combinations left open are named together.
        gap(a: bool, b: bool) -> int static =>
            case (a, b)
            when (true, true) then 1
            esac;
    si
si
