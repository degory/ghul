// A condition's calls attach to its facts only when they ran after
// the fact's own establishing test: `mutate() /\ x?` leaves the
// presence fact uncrossed (the test observed the post-call heap),
// while `x? /\ mutate()` still owes the call. One row per leaf shape
// leans through a fact formed after the call and must stay clean; the
// controls lean through facts formed before the call and must draw
// the reliance error.

use IO.Std.write_line;

class BASE is
    init() is si

    describe() -> string => "base";
si

class DERIVED: BASE is
    init() is si

    inner_only() -> string => "derived";
si

class HOST is
    init() is si

    _name: string?;
    _item: BASE?;
    _count: int;

    name: string? => _name;
    item: BASE? => _item;

    mutate() -> bool is
        _name = null;
        _item = null;
        _count = _count + 1;
        return true;
    si

    takes_string(s: string) is
        write_line(s);
    si

    takes_derived(d: DERIVED) is
        write_line(d.inner_only());
    si

    // ---- facts formed after the call: no crossing attaches ----

    field_presence_after_call() is
        if mutate() /\ _name? then
            takes_string(_name);
        fi
    si

    property_presence_after_call() is
        if mutate() /\ name? then
            takes_string(name);
        fi
    si

    isa_after_call() is
        if mutate() /\ isa DERIVED(item) then
            takes_derived(item);
        fi
    si

    null_compare_after_call() is
        if mutate() /\ name != null then
            takes_string(name);
        fi
    si

    // The call precedes every leaf of a nested conjunction.
    nested_after_call() is
        if mutate() /\ item? /\ name? then
            takes_string(name);
        fi
    si

    while_after_call() is
        while mutate() /\ name? do
            takes_string(name);
        od
    si

    // A wide use never leans, crossed or not.
    wide_use_after_call() is
        if mutate() /\ _name? then
            write_line(_name);
        fi
    si

    // ---- facts formed before the call: the crossing still attaches ----

    field_presence_before_call() is
        if _name? /\ mutate() then
            takes_string(_name);
        fi
    si

    property_presence_before_call() is
        if name? /\ mutate() then
            takes_string(name);
        fi
    si

    isa_before_call() is
        if isa DERIVED(item) /\ mutate() then
            takes_derived(item);
        fi
    si
si

entry() is
    let h = HOST();
    h.field_presence_after_call();
    h.property_presence_after_call();
    h.isa_after_call();
    h.null_compare_after_call();
    h.nested_after_call();
    h.while_after_call();
    h.wide_use_after_call();
si
