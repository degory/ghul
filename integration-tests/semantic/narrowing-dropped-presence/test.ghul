// The presence half: a value proven to hold one is read through after a
// call that can make it absent again.
class BOX is
    label: string? public;

    init() is si

    mutate() is
        label = null
    si
si

describe(box: BOX) -> int is
    if box.label? then
        box.mutate()

        return box.label.length
    fi

    return 0
si

entry() is si
