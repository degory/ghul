// A second `/\`-joined bound belongs on a type parameter only. In a tuple
// type the same colon-bound element shape parses, and a second bound there
// is an error rather than something silently dropped.

namespace Test is
    trait NAMED is
        name: string;
    si

    pair: (p: NAMED /\ SIZED, q: int);

    class Main is
        entry() static is
            return;
        si
    si
si
