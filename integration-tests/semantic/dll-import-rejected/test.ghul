namespace Test is
    // Tests: what DllImport cannot be written on. A type the runtime
    // has not been told how to marshal, a returned string (whose buffer
    // is the library's to free rather than the runtime's), a method
    // with a body of its own, and an instance method.

    class BAD is
        @System.Runtime.InteropServices.DllImport("libc")
        takes_a_list(values: Collections.LIST[int]) -> int static;

        @System.Runtime.InteropServices.DllImport("libc")
        returns_a_string() -> string static;

        @System.Runtime.InteropServices.DllImport("libc")
        has_a_body() -> int static => 3;

        @System.Runtime.InteropServices.DllImport("libc")
        is_an_instance() -> int;

        init() is si
    si

    entry() is si
si
