namespace Test is
    use Std = IO.Std;

    class Main is
        entry() static is
            let xs = [1, 2, 3];

            // no consuming loop anywhere
            for x in xs do
                if x > 0 then break 5 fi;
            od;

            // valued break under unconsumed loops only
            do
                for v in xs do
                    if v > 0 then break v fi;
                od;
            od;

            // loop expression with neither breaks nor an expected type
            let unknown = while false do
                break;
            od;

            Std.write_line("{unknown}");
        si
    si
si
