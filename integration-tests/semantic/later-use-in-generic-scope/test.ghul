use Collections.LIST

// Pins a gap rather than a wanted behaviour.
//
// A construction whose type argument is settled by later use gets it
// from a concrete type today. Where the later use supplies a type
// variable of the enclosing declaration instead, nothing settles the
// construction and it is reported as uninferrable, though the element
// type is as fixed there as a concrete one would be. Writing the type
// argument out is the way through in the meantime.
//
// If a change makes either of these compile, that is an improvement:
// drop the site from this test rather than preserving the diagnostic.
collect_one[T](value: T) -> LIST[T] is
    let xs = LIST()

    xs.add(value)

    return xs
si

class HOLDER[T] is
    _value: T

    init(value: T) is _value = value; si

    twice() -> LIST[T] is
        let ys = LIST()

        ys.add(_value)
        ys.add(_value)

        return ys
    si
si

entry() is si
