namespace Test is
    class BOX(value: int);

    // The ctor constraint is spelled `init`, and the rejection of the
    // construction form must not reach it.
    first[T: init]() -> T;

    entry() is
        let a = new BOX(1);
        let b = new BOX(2).value;

        IO.Std.write_line("{a.value} {b}");
    si
si
