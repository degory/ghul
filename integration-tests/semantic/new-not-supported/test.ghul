namespace Test is
    class BOX(value: int);

    // `new` is still the constructor constraint, so this is legal and
    // must not be caught by the rejection of the construction form.
    first[T: init]() -> T;

    entry() is
        let a = new BOX(1);
        let b = new BOX(2).value;

        IO.Std.write_line("{a.value} {b}");
    si
si
