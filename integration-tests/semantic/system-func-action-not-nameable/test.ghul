namespace Test is
    use IO;
    class MAIN is
        // System.Func and System.Action are the IL representation of
        // ghūl function types, which are spelled (int) -> int — the
        // names must not resolve, rather than resolving to a single
        // wrong arity
        takes_func(f: System.Func[int, int]) -> int => 41;

        takes_action(a: System.Action[int]) is si

        entry() static is
            // the function type itself keeps working
            let f: (int, int) -> int = (a, b) => a + b;
            Std.error.write_line("{f(19, 23)}");
        si
    si
si
