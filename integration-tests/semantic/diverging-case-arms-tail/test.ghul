// A composite whose arms all diverge is not a void tail: every path
// returns, so the body has no fall-through to warn about, and only a
// composite that yields void values falls through under
// definite-return. The recursive arm is what makes this worth pinning:
// its type is unsettled on the first walk, so no arm registers a value
// there, and a rule keyed on "no arm yields a value" would take the
// whole case for a statement and report the body as falling through.
namespace Test is
    union Value is
        NUMBER(digit: int);
        WHEEL(name: char);
    si

    class MAIN is
        entry() static is
            IO.Std.write_line("{next(Value.NUMBER(7))}")
        si

        next(v: Value) -> int static is
            case v
            when number: Value.NUMBER then
                return number.digit
            when wheel: Value.WHEEL then
                return next(Value.NUMBER(0))
            esac
        si
    si
si
