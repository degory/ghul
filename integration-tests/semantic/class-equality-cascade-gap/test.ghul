// Equality asked for on a base cascades to every subclass. A subclass
// the compiler cannot write one for has to say what equality means
// there itself: left alone it would inherit an operator that reads
// the base and answers for state it cannot see.

@equality()
class Root abstract is
    describe() -> string;
si

// Declares half the pair already, so the operator the cascade owes is
// not one the compiler will write over the top of.
class HASH_ONLY: Root is
    value: int;

    init(value: int) is
        self.value = value;
    si

    get_hash_code() -> int => value;

    describe() -> string => "hash only";
si

// Answers for itself, so the cascade is satisfied and nothing is
// reported here.
class OWN_EQUALITY: Root is
    value: int;

    init(value: int) is
        self.value = value;
    si

    =~(other: Root) -> bool pure => isa OWN_EQUALITY(other) /\ value == (cast OWN_EQUALITY(other)).value;

    get_hash_code() -> int => value;

    describe() -> string => "own equality";
si

entry() is
    IO.Std.write_line("{HASH_ONLY(1).describe()}");
    IO.Std.write_line("{OWN_EQUALITY(1).describe()}");
si
