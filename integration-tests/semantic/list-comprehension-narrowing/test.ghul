use IO.Std.write_line

lengths(names: string?[]) -> int[] => [n.length for n in names if n?]

pairs(n: int) -> (int, int)[] => [(a, b) for a in 1::n for b in a::n if a * b == n]

widened(xs: int[]) -> object[] => [x for x in xs]

entry() is
    write_line("{lengths(["a", null, "ccc"])}")
    write_line("{pairs(12)}")
    write_line("{widened([1, 2])}")
si
