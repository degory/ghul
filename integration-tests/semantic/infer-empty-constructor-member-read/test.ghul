namespace Test is
    use Collections.LIST;
    use IO.Std.write_line;

    // Tests: an empty generic constructor with no type arguments, read
    // through a member, has nothing to infer its element type from. The
    // placeholder sits inside the constructed type rather than being the
    // whole of it, and is reported as the inference failure it is.

    entry() is
        let n = LIST().count;

        write_line("{n}");
    si
si
