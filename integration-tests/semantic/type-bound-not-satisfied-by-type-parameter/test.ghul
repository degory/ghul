// A type parameter passed as a type argument has to satisfy the bound
// like any other type argument. An unbounded one guarantees nothing, so
// the call is rejected where it is written rather than emitting IL the
// CLR refuses when the method is first reached.

trait Comparable[T] is
    compare_to(other: T) -> int;
si

pick[T: Comparable[T]](x: T) -> T => x;

relay[T](x: T) -> T => pick(x);

// A trait member cannot bound the trait's own parameter, so this is the
// shape that hits it in practice.
trait Seq[T] is
    head: T;

    biggest() -> T => pick(head);
si

entry() is
si
