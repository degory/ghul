// Kind constraints and `init` combine with `/\`-joined type bounds: the
// bounds, the reference kind and the constructor constraint all apply to
// the one parameter.

namespace Test is
    trait NAMED is
        name: string;
    si

    trait SIZED is
        size: int;
    si

    class THING: NAMED, SIZED is
        name: string => "thing";
        size: int => 7;
        init() is si
    si

    describe[T: NAMED /\ SIZED class init](x: T) -> string => "{x.name}/{x.size}";

    class Main is
        entry() static is
            describe[THING](THING());
            return;
        si
    si
si
