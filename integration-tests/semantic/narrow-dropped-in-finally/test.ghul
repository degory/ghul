use default

class THING is
    init() is si

    close() is
        write_line("closed")
    si
si

class HOLDER is
    thing: THING?

    init() is
        thing = make()
    si
si

make() -> THING? => THING()

entry() is
    let written mut = make()

    if written? then
        try
            written = null
        finally
            written.close()
        yrt
    fi

    let holder = HOLDER()

    if holder.thing? then
        try
            write_line("body")
        finally
            holder.thing.close()
        yrt
    fi
si
