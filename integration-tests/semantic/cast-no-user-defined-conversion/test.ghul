use IO.Std.write_line;

entry() is
    // System.Guid declares no conversion operator to or from
    // System.Half - `cast` between two unrelated value types must
    // still be a compile error rather than silently emitting an
    // invalid `conv.*` opcode.
    let g = System.Guid.new_guid();
    let h = cast System.Half(g);

    write_line("{h}");

    // An enum source decays to int32 on the stack, but the target
    // here is a real multi-field struct with no conversion operator
    // of its own - `conv.i4` would silently re-annotate an int32 as
    // a Half, which is unverifiable IL, not a valid conversion.
    let s = Suit.HEARTS;
    let h2 = cast System.Half(s);

    write_line("{h2}");
si

enum Suit is
    HEARTS,
    DIAMONDS,
si
