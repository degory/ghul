use IO.Std.write_line;

entry() is
    // System.Guid declares no conversion operator to or from
    // System.Half - `cast` between two unrelated value types must
    // still be a compile error rather than silently emitting an
    // invalid `conv.*` opcode.
    let g = System.Guid.new_guid();
    let h = cast System.Half(g);

    write_line("{h}");
si
