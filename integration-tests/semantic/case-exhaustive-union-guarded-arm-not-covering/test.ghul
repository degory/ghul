namespace Test is
    use IO.Std;

    union Shape is
        CIRCLE(radius: int);
        SQUARE(side: int);
    si

    class Main is
        entry() static is
            describe(Shape.CIRCLE(5));
        si

        describe(s: Shape) static is
            case s
            when c: Shape.CIRCLE /\ c.radius > 3 then Std.write_line("big circle {c.radius}");
            when q: Shape.SQUARE then Std.write_line("square {q.side}");
            esac
        si
    si
si
