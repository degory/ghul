class HOLDER is
    _count: int;

    // accepted: an expression-bodied getter with no setter
    GLOBALS_TYPE_NAME: string => "$globals";
    snake_name: string => "ok";

    // rejected: a block getter, a settable property, an auto-property, a field
    BLOCK_GETTER: string is
        return "block";
    si

    SETTABLE: int => _count, = value is
        _count = value;
    si

    AUTO: int;

    FIELD: int field;

    init() is
        _count = 0;
    si
si

entry() is
    let holder = HOLDER();

    assert holder.GLOBALS_TYPE_NAME =~ "$globals";
si
