// A class is given a memberwise `=~` only where nothing it holds or
// inherits stands in the way. Private state is an implementation
// detail whose part in equality only its author knows, and that
// applies to state a base holds as much as to state declared here: a
// comparison over this class's members alone would answer equal for
// two values the base distinguishes. A class holding no state at all
// is left alone too, since an operator over nothing would answer
// equal for any two instances.

class HIDDEN is
    index: int;
    _generation: int;

    init(index: int, generation: int) is
        self.index = index;
        _generation = generation;
    si
si

class OVER_HIDDEN: HIDDEN is
    tag: int;

    init(index: int, generation: int, tag: int) is
        super.init(index, generation);
        self.tag = tag;
    si
si

class STATELESS is
    init() is si
si

class HASH_ONLY is
    v: int;

    init(v: int) is self.v = v; si

    get_hash_code() -> int => v;
si

entry() is
    IO.Std.write_line("{HIDDEN(1, 2) =~ HIDDEN(1, 2)}");
    IO.Std.write_line("{OVER_HIDDEN(1, 2, 3) =~ OVER_HIDDEN(1, 2, 3)}");
    IO.Std.write_line("{STATELESS() =~ STATELESS()}");
    IO.Std.write_line("{HASH_ONLY(1) =~ HASH_ONLY(1)}");
si
