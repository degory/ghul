namespace Test is
    // A value whose type is an unconstrained type parameter is fixed
    // where the call is written, so a formal asking for a specific
    // class is a formal no instantiation can satisfy. With no formal
    // that accepts every type, the call has no overload to resolve to.

    class REF is
        init() is si
    si

    pick(r: REF) -> string => "REF";

    directly[T](x: T) -> string => pick(x);

    class BOX[B](item: B) is
        apply_n[R](f: (B) -> R) -> R => f(item);
    si

    // the call that had no overload to resolve leaves the lambda's return
    // type unknown, which is reported once, at the call
    through_lambda[T](x: T) -> string => BOX(x).apply_n(y => pick(y));

    entry() is si
si
