// Only a narrower reference return type overrides: an unrelated return
// type, and a value type in place of a reference, are errors at the
// member, for a class member and a trait member alike.

class RESULT(value: int)

class HOST is
    init() is si
    run() -> RESULT => RESULT(1)
    count() -> object => "x"
si

class FAKE: HOST is
    init() is super.init() si
    run() -> string? => null
    count() -> int => 1
si

trait Counted is
    count() -> object
si

class COUNTED: Counted is
    init() is si
    count() -> int => 1
si
