// Only a narrower reference return type overrides. An unrelated return type,
// and a value type in place of a reference, hide a class member, with a
// warning, and are an error for a trait member's implementation.

class RESULT(value: int)

class HOST is
    init() is si
    run() -> RESULT => RESULT(1)
    count() -> object => "x"
si

class FAKE: HOST is
    init() is super.init() si
    run() -> string? => null
    count() -> int => 1
si

trait Counted is
    count() -> object
si

class COUNTED: Counted is
    init() is si
    count() -> int => 1
si
