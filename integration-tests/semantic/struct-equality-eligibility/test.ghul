// Only a struct whose state is entirely public gets a synthesized
// `=~`. Private state is an implementation detail whose part in
// equality only its author knows, and comparing the public members
// alone would answer equal for two values the private one
// distinguishes. Declaring a hash without an operator opts out too,
// so a synthesized comparison can never disagree with a hand-written
// hash.

struct HANDLE is
    index: int;
    _generation: int;

    init(index: int, generation: int) is
        self.index = index;
        _generation = generation;
    si
si

struct GUARDED(a: int private);

struct PROTECTED_STATE is
    a: int protected;

    init(a: int) is self.a = a; si
si

struct HASH_ONLY is
    a: int;

    init(a: int) is self.a = a; si

    get_hash_code() -> int => a;
si

entry() is
    IO.Std.write_line("{HANDLE(1, 1) =~ HANDLE(1, 1)}");
    IO.Std.write_line("{GUARDED(1) =~ GUARDED(1)}");
    IO.Std.write_line("{PROTECTED_STATE(1) =~ PROTECTED_STATE(1)}");
    IO.Std.write_line("{HASH_ONLY(1) =~ HASH_ONLY(1)}");
si
