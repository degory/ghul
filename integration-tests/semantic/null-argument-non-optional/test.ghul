// A literal `null` argument is reported against a non-optional
// parameter, the same as `null` in a typed `let`, a `return` or an
// `if` branch. An optional parameter takes one without complaint, and
// so does a value-typed one, which cannot hold null at all.
namespace Test is
    class BOX is
        init() is si
        init(s: string) is si

        takes_non_optional(s: string) -> int => 1;

        [s: string]: int => 5;
    si

    takes_non_optional(s: string) -> int => 2;
    takes_optional(s: string?) -> int => 3;
    takes_value(i: int) -> int => 4;

    entry() is
        let a = takes_non_optional(null);
        let b = BOX().takes_non_optional(null);
        let c = takes_optional(null);
        let d = takes_value(0);

        // A constructor argument, and a call through a function-typed
        // value, are reported the same way.
        let e = BOX(null);
        let f = takes_non_optional;
        let g = f(null);

        // An index argument is NOT reported, though it is the same
        // mistake: the indexer resolves through the operator path
        // rather than either call path, so nothing checks the
        // argument against the formal there. Pinned as it stands
        // rather than left unrecorded - the correct behaviour is to
        // warn here too.
        let h = BOX()[null];

        IO.Std.write_line("{a} {b} {c} {d} {g} {h}");
    si
si
