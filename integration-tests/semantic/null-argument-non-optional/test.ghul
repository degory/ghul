// A literal `null` argument is reported against a non-optional
// parameter, the same as `null` in a typed `let`, a `return` or an
// `if` branch. An optional parameter takes one without complaint, and
// so does a value-typed one, which cannot hold null at all.
namespace Test is
    class BOX is
        init() is si

        takes_non_optional(s: string) -> int => 1;
    si

    takes_non_optional(s: string) -> int => 2;
    takes_optional(s: string?) -> int => 3;
    takes_value(i: int) -> int => 4;

    entry() is
        let a = takes_non_optional(null);
        let b = BOX().takes_non_optional(null);
        let c = takes_optional(null);
        let d = takes_value(0);

        IO.Std.write_line("{a} {b} {c} {d}");
    si
si
