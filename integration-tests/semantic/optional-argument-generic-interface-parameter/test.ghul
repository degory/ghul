namespace Test is
    only_string(s: string) -> string => "ok";
    only_iterable_char(i: Collections.Iterable[char]) -> string => "ok";
    only_iterable[T](i: Collections.Iterable[T]) -> string => "ok";

    entry() is
        let absent: string? = null;

        IO.Std.write_line(only_string(absent));
        IO.Std.write_line(only_iterable_char(absent));
        IO.Std.write_line(only_iterable(absent));
    si
si
