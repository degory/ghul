// A call whose declared return carries the pack marker re-presents its
// value by re-walking a wrapper; what the call's operands reported on
// the walk that is rolled back is reported again, not lost. Here the
// operand declares the tuple-in return an N-ary body cannot be returned
// as, and the call must not compile.
namespace Grid is
    use IO.Std.write_line;

    once_2[T.., U](make: (int) -> (int) -> T.. -> U) -> T.. -> U => v => make(10)(20)(v);

    entry() is
        let g = once_2((j: int) -> (int) -> ((int, int)) -> int => (k: int) -> ((int, int)) -> int => (a: int, b: int) -> int => a + b * 10);

        write_line("{g(1, 2)}");
    si
si
