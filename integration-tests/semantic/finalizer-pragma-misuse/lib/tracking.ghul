// A finalizer is accepted only on an instance method of a non-generic
// class that takes no arguments, and a class declares at most one.
namespace Tracking is
    class STATIC_FINALIZER is
        @finalizer()
        release() static is si
    si

    class WITH_ARGUMENT is
        @finalizer()
        release(how: int) is si
    si

    class BOX[T] is
        @finalizer()
        release() is si
    si

    struct VALUE is
        @finalizer()
        release() is si
    si

    class TWICE is
        @finalizer()
        release() is si

        @finalizer()
        also() is si
    si
si
