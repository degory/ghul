namespace Test is
    make[T](message: string) -> T => throw System.Exception(message);

    class THING is
        init() is si

        check(n: int) is
            if n < 0 then
                _fail("negative");
            fi
        si

        _fail[T](message: string) -> T => throw System.Exception(message);
    si

    global_statement() is
        make("x");
    si

    pinned_by_the_slot() -> string => make("x");
si
