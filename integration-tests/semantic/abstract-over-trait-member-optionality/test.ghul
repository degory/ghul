trait Renderable is
    render() -> string;
si

class Expr: Renderable abstract is
    init() is si

    render() -> string?;
si

class NUM: Expr is
    init() is super.init(); si

    render() -> string? => null;
si

entry() is
    let r: Renderable = NUM();

    IO.Std.write_line("{r.render()}");
si
