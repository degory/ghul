// A curated BCL mutator writes only its receiver's own internal
// storage and runs no user code, so it invalidates the same facts a
// direct heap store does and no more: a property's getter may read
// the mutated collection, but no ghūl field can name what it holds.
//
// Each function below guards a member, calls something, and then
// reads the member where a still-narrowed one is legal. The reads
// that draw an error are the facts that must die; the reads that
// draw nothing are the facts that must survive.

len(s: string) -> int => s.length;

class SUBJECT is
    _name: string? field;
    _items: Collections.LIST[string] field;
    _stack: Collections.STACK[string] field;
    _builder: System.Text.StringBuilder field;
    _boxed: object field;
    _sink: int field;

    // reads the collection, so its result changes when the
    // collection does
    count: int => _items.count;

    // does not, but the compiler has no way to tell the difference
    named: string? => _name;

    init() is
        _name = null;
        _items = Collections.LIST[string]();
        _stack = Collections.STACK[string]();
        _builder = System.Text.StringBuilder();
        _boxed = "boxed";
    si

    _store() is
        _sink = _sink + 1;
    si

    _clear() is
        _name = null;
    si

    // survives: `add` writes the list's backing array, which is not a
    // ghūl field
    field_survives_list_add() -> int is
        if !_name? then return -1; fi
        _items.add("x");
        return len(_name);
    si

    field_survives_stack_push() -> int is
        if !_name? then return -1; fi
        _stack.push("x");
        return len(_name);
    si

    field_survives_string_append() -> int is
        if !_name? then return -1; fi
        _builder.append("x");
        return len(_name);
    si

    // dies: the getter reads the list `add` just changed
    property_dies_on_list_add() -> int is
        if !named? then return -1; fi
        _items.add("x");
        return len(named);
    si

    // dies: `append(object)` calls `to_string` on its argument, so
    // the call can re-enter user code and store anything
    field_dies_on_object_append() -> int is
        if !_name? then return -1; fi
        _builder.append(_boxed);
        return len(_name);
    si

    // dies: `remove` runs the element type's equality through the
    // default comparer, which is user code
    field_dies_on_list_remove() -> int is
        if !_name? then return -1; fi
        _items.remove("x");
        return len(_name);
    si

    // survives: `_store` provably writes only `_sink`, which the
    // fact is not about
    field_survives_plain_call_elsewhere() -> int is
        if !_name? then return -1; fi
        _store();
        return len(_name);
    si

    // dies: the callee writes the fact's own member
    field_dies_on_nulling_call() -> int is
        if !_name? then return -1; fi
        _clear();
        return len(_name);
    si
si
