// An enum member's value is stored as int32, so an integer literal
// outside that range is reported where it is written. Emission relies
// on it: a member that reaches metadata has a value that parsed.

enum E is
    TOO_BIG = 2147483648,
    TOO_BIG_HEX = 0x80000000,
    LARGEST = 2147483647,
si

entry() is
    IO.Std.write_line("{E.LARGEST}");
si
