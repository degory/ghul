// A local read and assigned inside its own initializer, which is what a
// half-written `let` looks like while the value below it is being typed.
// The local has no type until the initializer it is waiting on has been
// compiled, so every read and store in there is reported as the use
// before the definition that it is, and none of them reaches code
// generation through a type that is not there.
f() -> int is
    let total mut =
    case total
    when 2 then
        total = 1
    else
        total = 2
    esac
    return total
si

entry() is si
