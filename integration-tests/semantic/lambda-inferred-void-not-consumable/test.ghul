namespace Test is
    use IO.Std.write_line;

    take_int(f: () -> int) is
        write_line("{f()}");
    si

    entry() is
        let flag = true;

        // not a function-literal body: the local needs a value
        let x = if flag then write_line("a") else write_line("b") fi;

        // one arm yields a value, so the position is a value position
        // after all and the void arm has nowhere to go
        let mixed = () => if flag then 1 else write_line("b") fi;

        // the slot wants an int back
        take_int(() => write_line("c"));

        // and a void element type is no more usable than a void local
        let mapped = [1, 2] | .map(i => write_line("{i}"));
    si
si
