// A synthesized operator compares by exact runtime type and reads
// only the members of the class it was written for, so it never
// serves a subclass. Every subclass therefore supplies its own, by
// asking for one with the pragma or by writing it, whatever it adds.

@equality()
class Root abstract is
    describe() -> string;
si

// Declares half the pair already, so the compiler will not write an
// operator over the top of it, and it has to say what equality means.
class HASH_ONLY: Root is
    value: int;

    init(value: int) is
        self.value = value;
    si

    get_hash_code() -> int => value;

    describe() -> string => "hash only";
si

// Answers for itself, so the requirement is met and nothing is
// reported here.
class OWN_EQUALITY: Root is
    value: int;

    init(value: int) is
        self.value = value;
    si

    =~(other: Root) -> bool pure => isa OWN_EQUALITY(other) /\ value == (cast OWN_EQUALITY(other)).value;

    get_hash_code() -> int => value;

    describe() -> string => "own equality";
si

// Adds no state of its own, and still owes an operator: what it
// inherits was written for Root and admits only Root values.
class BEHAVIOUR_ONLY: Root is
    describe() -> string => "behaviour only";
si

entry() is
    IO.Std.write_line("{HASH_ONLY(1).describe()}");
    IO.Std.write_line("{OWN_EQUALITY(1).describe()}");
si
