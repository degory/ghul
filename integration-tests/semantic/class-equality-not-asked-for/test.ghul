// A class is given a memberwise `=~` only where an `@equality()`
// pragma asked for one, on the class itself or on one it extends.
// None of these asked, so none has an operator at all and comparing
// two of their values reports that there is none to reach.

class HIDDEN is
    index: int;
    _generation: int;

    init(index: int, generation: int) is
        self.index = index;
        _generation = generation;
    si
si

class OVER_HIDDEN: HIDDEN is
    tag: int;

    init(index: int, generation: int, tag: int) is
        super.init(index, generation);
        self.tag = tag;
    si
si

class HASH_ONLY is
    v: int;

    init(v: int) is self.v = v; si

    get_hash_code() -> int => v;
si

entry() is
    IO.Std.write_line("{HIDDEN(1, 2) =~ HIDDEN(1, 2)}");
    IO.Std.write_line("{OVER_HIDDEN(1, 2, 3) =~ OVER_HIDDEN(1, 2, 3)}");
    IO.Std.write_line("{HASH_ONLY(1) =~ HASH_ONLY(1)}");
si
