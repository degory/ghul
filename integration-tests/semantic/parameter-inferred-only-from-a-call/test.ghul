// A parameter typed only by being called has a return type nothing
// settles. It is reported once, at the parameter, rather than reaching
// the end of compilation half-inferred.

class RGB(red: int, green: int)

run(a: RGB) -> int is
    mix(pick) -> int => pick(a)

    mix(p => p.red) + mix(p => p.green)
si

run_literal(a: RGB) -> string is
    let describe = pick => "{pick(a)}"

    describe(p => p.red)
si
