namespace Test is
    // The trust covers the marked body only. An override in this
    // compilation is judged as written, so one that can store ends the
    // narrowing at a call that could reach it.
    class BASE is
        init() is si

        @trusted_store_free()
        describe() -> string => "base"
    si

    class DERIVED: BASE is
        callback: () -> void public

        init(callback: () -> void) is
            super.init()
            self.callback = callback
        si

        describe() -> string is
            callback()
            return "derived"
        si
    si

    class HOLDER is
        _name: string?

        init() is si

        run(value: BASE) -> int is
            if _name? then
                let _ = value.describe()
                return _name.length
            fi

            return 0
        si
    si
si
