namespace Test is
    class THING is
        init() is si
    si

    // The parameter shadows the member, and the assignment still writes
    // the member.
    class SHADOWED is
        thing: THING;

        init(thing: THING) is
            self.thing = thing;
        si
    si

    class VIA_PRIMARY(thing: THING);

    // Credited through the call it cannot avoid making, and through the
    // one that helper in turn cannot avoid making.
    class VIA_HELPER is
        thing: THING;

        init() is
            one();
        si

        one() is
            two();
        si

        two() is
            thing = THING();
        si
    si

    class UNASSIGNED is
        thing: THING;

        init() is si
    si

    // The helper is reached on one path only, so it credits nothing.
    class CONDITIONAL is
        thing: THING;

        init(b: bool) is
            if b then
                setup();
            fi
        si

        setup() is
            thing = THING();
        si
    si

    // A cycle assigns nothing on the way round, and is credited with
    // nothing rather than with its own conclusion.
    class CYCLE is
        thing: THING;

        init() is
            p();
        si

        p() is
            q();
        si

        q() is
            p();
        si
    si

    // The helper can be overridden from another assembly by a body that
    // assigns nothing, so it credits nothing here either.
    class EXTENSIBLE open is
        thing: THING;

        init() is
            setup();
        si

        setup() is
            thing = THING();
        si
    si

    // Overridden in this build, so the call could reach a body that
    // assigns nothing.
    class OVERRIDABLE_BASE is
        thing: THING;

        init() is
            setup();
        si

        setup() is
            thing = THING();
        si
    si

    class OVERRIDES_IT: OVERRIDABLE_BASE is
        init() is
            super.init();
        si

        setup() is si
    si

    // Neither kind of slot can hold null in the first place.
    class NOT_CHECKED is
        thing: THING?;
        count: int;

        init() is si
    si

    class MAIN is
        entry() static is si
    si
si
