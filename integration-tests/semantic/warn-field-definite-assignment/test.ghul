namespace Test is
    class THING is
        init() is si
    si

    // The parameter shadows the member, and the assignment still writes
    // the member.
    class SHADOWED is
        thing: THING;

        init(thing: THING) is
            self.thing = thing;
        si
    si

    class VIA_PRIMARY(thing: THING);

    // A local of the same name shadows the member, so the bare
    // assignment writes the local and the member is left unassigned.
    class SHADOWED_BY_LOCAL is
        thing: THING;

        init() is
            let thing mut = THING();

            thing = THING();
        si
    si

    // Credited through the call it cannot avoid making, and through the
    // one that helper in turn cannot avoid making.
    class VIA_HELPER is
        thing: THING;

        init() is
            one();
        si

        one() is
            two();
        si

        two() is
            thing = THING();
        si
    si

    class UNASSIGNED is
        thing: THING;

        init() is si
    si

    // The helper is reached on one path only, so it credits nothing.
    class CONDITIONAL is
        thing: THING;

        init(b: bool) is
            if b then
                setup();
            fi
        si

        setup() is
            thing = THING();
        si
    si

    // A cycle assigns nothing on the way round, and is credited with
    // nothing rather than with its own conclusion.
    class CYCLE is
        thing: THING;

        init() is
            p();
        si

        p() is
            q();
        si

        q() is
            p();
        si
    si

    // A constructor cannot be overridden, so a call to another one is
    // credited even where the class can be extended.
    class OPEN_CHAINED(thing: THING) open is
        init(.., extra: int) is si
    si

    class OPEN_CALLS_INIT open is
        thing: THING;

        init() is
            thing = THING();
        si

        init(extra: int) is
            init();
        si
    si

    // An auto-property's getter cannot be proven store-free on a class
    // that can be extended, which is a reason not to narrow through it
    // and no reason to doubt that the write happened.
    class OPEN_ASSIGNS open is
        thing: THING;

        init() is
            thing = THING();
        si
    si

    // Each constructor is answered on its own, naming the members that
    // constructor leaves unassigned.
    class TWO_HOLES is
        first: THING;
        second: THING;

        init(x: int) is
            first = THING();
        si

        init(y: bool) is
            second = THING();
        si

        init() is
            first = THING();
            second = THING();
        si
    si

    // Missing every field of its own draws one warning naming all of
    // them, not one warning per field.
    class ALL_MISSING is
        first: THING;
        second: THING;

        init() is si
    si

    // The helper can be overridden from another assembly by a body that
    // assigns nothing, so it credits nothing here either.
    class EXTENSIBLE open is
        thing: THING;

        init() is
            setup();
        si

        setup() is
            thing = THING();
        si
    si

    // Overridden in this build, so the call could reach a body that
    // assigns nothing.
    class OVERRIDABLE_BASE is
        thing: THING;

        init() is
            setup();
        si

        setup() is
            thing = THING();
        si
    si

    class OVERRIDES_IT: OVERRIDABLE_BASE is
        init() is
            super.init();
        si

        setup() is si
    si

    // Neither kind of slot can hold null in the first place.
    class NOT_CHECKED is
        thing: THING?;
        count: int;

        init() is si
    si

    // A lambda literal later in the body is walked speculatively, and
    // the credit for the earlier call survives that walk.
    class HELPER_THEN_LAMBDA is
        thing: THING;

        init() is
            setup();

            let make = () -> int => 42;
        si

        setup() is
            thing = THING();
        si
    si

    class MAIN is
        entry() static is si
    si
si
