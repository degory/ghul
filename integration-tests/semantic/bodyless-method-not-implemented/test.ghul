class BASE is
    init() is si

    contract() -> int;
si

class ABSTRACT_SUB: BASE abstract is
    init() is super.init(); si
si

class GOOD: BASE is
    init() is super.init(); si

    contract() -> int => 7;
si

class BAD: BASE is
    init() is super.init(); si
si

entry() is
    IO.Std.write_line("{GOOD().contract()}");
si
