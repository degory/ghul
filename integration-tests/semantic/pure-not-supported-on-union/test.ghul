namespace Test is
    // Union members are held to purity through partial and impl blocks
    // unconditionally, so `pure` on the union header itself would say
    // nothing the language does not already expect - it is rejected
    // rather than accepted as a silent no-op.
    union U pure is
        A(x: int);
        B;
    si

    entry() is
        let u: U mut = U.A(1);
        IO.Std.write_line("{u}");
    si
si
