// Function-type variance must respect the CLR's value-type restriction:
// a varying position only converts implicitly when the type argument in
// that position is a reference type. `(object) -> string` does not
// convert to `(int) -> object`, even though `object` is a supertype of
// `int` in the covariant return position, because the varying argument
// position holds a value type.
namespace Test is
    class Main is
        entry() static is
            let wider = (x: object) -> string => "ref:{x}";

            let g: (int) -> object = wider; // fail expected: value-typed argument position is invariant

            return;
        si
    si
si
