namespace Test is
    // Tests: the spread walks the trailing actuals a second time to
    // collect them, so an error in one of them is still reported rather
    // than being dropped with the failed resolve that preceded it.

    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    concat(a: string, b: string) -> string => "{a}{b}";

    class Main is
        entry() static is
            let a = apply(concat, no_such_name, "y");
            return;
        si
    si
si
