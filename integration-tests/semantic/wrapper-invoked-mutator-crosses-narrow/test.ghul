// A function that only invokes its function-typed parameter is
// bounded by the values recorded flowing in at its call sites, so
// handing it a mutator makes its call cross the facts the mutator
// can write - it does not solve store-free just because its own
// body stores nothing.

maybe() -> string? => "y";

run(f: () -> void) is f(); si

tell(f: () -> void) is f(); si

class H is
    _f: string?;

    init() is _f = "x"; si

    poke() is _f = maybe(); si

    touch_via_wrapper() is
        if _f? then
            run(poke);

            IO.Std.write_line("a {_f.length}");
        fi
    si

    // The wrapper's effects are the union of every value recorded
    // flowing into it anywhere, so the harmless case goes through
    // its own wrapper, which was only ever handed the reader.
    read_via_wrapper() is
        if _f? then
            tell(() is IO.Std.write_line("b"); si);

            IO.Std.write_line("c {_f.length}");
        fi
    si
si

entry() is
    let h = H();
    h.touch_via_wrapper();
    h.read_via_wrapper();
si
