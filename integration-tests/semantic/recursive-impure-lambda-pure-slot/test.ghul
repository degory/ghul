// The revert half of the recursive-literal purity re-walk (see
// COMPILE_LAMBDAS): a genuinely impure recursive body must still warn
// even though the optimistic retype of `$recurse` is tried first.
namespace Test is
    use Std = IO.Std;

    take_pure(f: (int) -> int pure) -> int pure => f(4);

    class Main is
        calls: int static;

        entry() static is
            let fib = (n: int) -> int rec is
                calls = calls + 1;

                return if n < 2 then n else rec(n - 1) + rec(n - 2) fi;
            si;

            Std.write_line("{take_pure(fib)}");

            return;
        si
    si
si