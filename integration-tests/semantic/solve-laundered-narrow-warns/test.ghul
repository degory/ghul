// the compiler's own bug shape: a narrowed field laundered into a local across a call
use IO.Std.write_line
class H is
    t: string?
    init() is t = "t" si
    check() -> bool is t = "changed"; return true si
    go() -> int is
        if t? /\ check() then
            let local: string? mut = t
            return local.length
        fi
        return -1
    si
si
write_line(H().go().to_string())
