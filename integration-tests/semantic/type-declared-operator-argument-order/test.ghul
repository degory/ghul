use System.DateTime;
use System.TimeSpan;

// An operator found on the right operand's type is offered with its
// declared parameter order, never with the operands swapped.
class M is
    init() is si

    -(a: M, b: int) -> string static => "M-int";
si

entry() is
    let d = DateTime(2020, 1, 1);
    let t = TimeSpan.from_days(1.0D);
    let m = M();

    let fine_1 = d - t;
    let fine_2 = m - 1;

    let wrong_1 = t - d;
    let wrong_2 = 1 - m;
si
