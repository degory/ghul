namespace Test is
    // A struct has no ordering unless it supplies one. There is no
    // generic order operator standing in for every value type: the
    // comparison opcodes it would lower to can only compare the
    // integer-backed ones, so a struct like this reaching them would
    // compare whatever its fields happen to occupy.

    struct POINT is
        x: int;
        y: int;

        init(x: int, y: int) is
            self.x = x;
            self.y = y;
        si
    si

    class Main is
        entry() static is
            let a = POINT(1, 2);
            let b = POINT(3, 4);

            IO.Std.write_line("{a < b}");

            return;
        si
    si
si
