// A ghūl method whose only effects are receiver-interior BCL
// mutations - appending to a builder, adding to a list - and stores
// to its own fields writes no other ghūl member, and the effect
// solve must keep it bounded rather than treating the unwalked
// import as able to write anything. A fact proven before a call to
// such a method survives it, including a fact read through a
// property hop.

len(s: string) -> int => s.length;

class SINK is
    _builder: System.Text.StringBuilder field;
    _items: Collections.LIST[string] field;
    _pending: bool field;

    init() is
        _builder = System.Text.StringBuilder();
        _items = Collections.LIST[string]();
        _pending = true;
    si

    write(c: char) is
        if _pending then
            _builder.append(' ');
            _pending = false;
        fi

        _builder.append(c);
    si

    add(s: string) is
        _items.add(s);
    si
si

class NODE is
    expression: NODE?;

    init() is si

    label() -> string => "node";
si

class PRINTER is
    _sink: SINK field;

    init() is _sink = SINK(); si

    // survives: write reaches only receiver-interior mutators and
    // its own receiver's fields, so nothing it does can change what
    // the property hop answers
    through_builder_wrapper(r: NODE) -> int is
        if r.expression? then
            _sink.write(' ');
            return len(r.expression.label());
        fi

        return -1;
    si

    // survives: same through the list wrapper
    through_list_wrapper(r: NODE) -> int is
        if r.expression? then
            _sink.add("x");
            return len(r.expression.label());
        fi

        return -1;
    si
si

entry() is
si
