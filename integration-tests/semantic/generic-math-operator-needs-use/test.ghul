use System.Numerics.INumber;

// The operator is a static virtual member of
// System.Numerics.IAdditionOperators, which `T`'s bound implements. It
// is reachable only when it has been brought into scope by name, so
// without the `use` this does not resolve.
total[T: INumber[T]](a: T, b: T) -> T => a + b;

entry() is
si
