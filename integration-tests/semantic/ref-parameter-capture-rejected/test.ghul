namespace Test is
    use Std = IO.Std;

    // A function literal cannot capture a `T ref` parameter: the
    // parameter's slot dies when the enclosing method returns, so a
    // closure frame field would hold a dangling pointer. Each capture
    // site is an error, naming the mention that performs it.
    class MAIN is
        invoke(f: () -> void) static is
            f();
        si

        capture_read(x: int ref) static is
            invoke(() -> void is Std.write_line("{x!}"); si);
        si

        capture_write(x: int ref) static is
            invoke(() -> void is x! = x! + 1; si);
        si

        entry() static is
            let n mut = 0;

            capture_read(n ref);
            capture_write(n ref);
        si
    si
si
