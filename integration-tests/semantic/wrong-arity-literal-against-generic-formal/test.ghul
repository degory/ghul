namespace Test is
    use IO.Std;

    // Tests: a function literal whose arity differs from the formal it
    // is pushed onto, where the formal reached the literal through a
    // constructed generic owner. The implied argument types come from
    // that formal, so the literal has nothing at its second parameter's
    // index; the call is reported rather than reading off the end of
    // them.

    class EVENT[T] is
        _handlers: Collections.LIST[T -> void];

        init() is
            _handlers = Collections.LIST[T -> void]();
        si

        subscribe(handler: T -> void) is
            _handlers.add(handler);
        si
    si

    class Main is
        entry() static is
            let e = EVENT[(int, string)]();

            e.subscribe((n, s) => Std.write_line("{n} {s}"));
            return;
        si
    si
si
