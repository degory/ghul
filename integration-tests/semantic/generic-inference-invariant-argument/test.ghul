namespace Test is
    trait Op[T] is
        run(x: T) -> T
    si

    class APP(): Op[string] is
        run(x: string) -> string => x
    si

    class ANIMAL() open
    class CAT(): ANIMAL

    from_list[T](xs: Collections.LIST[Op[T]]) -> int => 0
    from_pairs[T](xs: Collections.Iterable[(name: string, op: Op[T])]) -> int => 0
    from_tagged[T](xs: Collections.Iterable[(string, T)], y: T) -> int => 0
    from_sequence[T](xs: Collections.Iterable[Op[T]]) -> int => 0

    entry() is
        let apps = Collections.LIST[APP]()
        let pairs = [("+", APP())]
        let cats = [("tom", CAT())]

        // a type argument bound through a subtype at a position the type
        // does not vary in leaves a formal the actual cannot convert to
        let a = from_list(apps)
        let b = from_pairs(pairs)
        let d = from_tagged(cats, ANIMAL())

        // a covariant position over reference types still converts
        let e = from_sequence(apps)
        let f = from_tagged(cats, CAT())
        let g = from_pairs([("+", cast Op[string](APP()))])

        // and an array literal is built at the formal its type argument binds
        let c = from_pairs([("+", APP())])
    si
si
