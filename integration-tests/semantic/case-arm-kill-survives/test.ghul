namespace Test is
    use Std = IO.Std;

    union K is
        A;
        B;
    si

    class Main is
        entry() static is
            // only the B path runs: on the A path `x` really is null
            // after the case, which is exactly what the warning says.
            probe(K.B);
        si

        // A narrowing an arm kills has to survive the `case`: arm exits
        // are joined, not rewound to the pre-arm environment. `x` is
        // narrowed to non-optional by the enclosing `if`, the first arm
        // sets it back to null, so on the joined path after the `case`
        // it is optional again and reading through it draws `null-deref`.
        // Rewinding to the pre-arm environment instead would put the
        // stale non-optional fact back and accept the read silently.
        probe(k: K) static is
            let x: string? mut = source();

            if x? then
                case k
                when v: K.A then
                    x = null;
                else
                    Std.write_line("b");
                esac

                Std.write_line("{x.length}");
            fi
        si

        source() -> string? static => "hello";
    si
si
