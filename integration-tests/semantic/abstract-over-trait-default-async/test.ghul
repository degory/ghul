trait Source is
    value() -> Tasks.TASK[int] is
        return 1;
    si
si

class Base: Source abstract is
    init() is si

    value() -> Tasks.TASK[int];
si

class ONE: Base is
    init() is super.init(); si
si

entry() is
    let s: Source = ONE();

    IO.Std.write_line("{s.value().result}");
si
