namespace Test is
    describe(x: int) -> string => "int:{x}";
    describe(x: string) -> string => "string:{x}";

    double_it(x: int) -> int => x * 2;

    class Main is
        entry() static is
            // An overloaded reference with no target type to pick a
            // member by is left alone, so it falls through to the
            // ordinary "value" diagnostic rather than guessing.
            let f = describe;

            // A single function reference whose shape doesn't match
            // the target gets a specific compatibility diagnostic.
            let g: (int, int) -> int = double_it;

            return;
        si
    si
si
