// An imported constructor can only invoke members its parameters give
// it a name for, and the object it constructs did not exist before
// the call, so a construction whose arguments hold no reference can
// reach nothing declared here. Facts live across one survive. A
// parameter typed as an interface a type declared here can implement
// is the case that must still die.


len(s: string) -> int => s.length;

class SUBJECT is
    _name: string? field;
    _items: Collections.List[string] field;

    init() is
        _name = null;
        _items = Collections.LIST[string]();
    si

    survives_parameterless_construction() -> int is
        if !_name? then return -1; fi
        let map = Collections.MAP[string, string]();
        return len(_name) + map.count;
    si

    survives_value_argument_construction() -> int is
        if !_name? then return -1; fi
        let list = Collections.LIST[string](16);
        return len(_name) + list.count;
    si

    survives_string_argument_construction() -> int is
        if !_name? then return -1; fi
        let builder = System.Text.StringBuilder("seed");
        return len(_name) + builder.length;
    si

    // Declines conservatively. A `TimeSpan` holds only a long, but
    // establishing that of a struct means trusting what reflection
    // has materialized of it, so anything that is not a scalar or a
    // string is left where it was.
    dies_on_struct_argument_construction(span: System.TimeSpan) -> int is
        if !_name? then return -1; fi
        let source = System.Threading.CancellationTokenSource(span);
        return len(_name) + source.get_hash_code();
    si

    dies_on_interface_argument_construction() -> int is
        if !_name? then return -1; fi
        let copy = Collections.LIST[string](_items);
        return len(_name) + copy.count;
    si
si
