namespace Test is
    use IO.Std.write_line;

    // Tests: a member read after a `~>` call reads the call's result, which
    // is optional, so a plain `.` is rejected where `?.` is accepted.

    name(n: int) -> string => "n{n}";
    maybe(present: bool) -> int? => if present then 42 else null fi;

    entry() is
        write_line("{maybe(true) ~> name().length}");
        write_line("{maybe(true) ~> name()?.length}");
    si
si
