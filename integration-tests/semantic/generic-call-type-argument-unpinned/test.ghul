namespace Test is
    use Std = IO.Std;

    class Main is
        // T is named only in the body, so neither the argument nor the
        // result gives the call anything to settle it from.
        describe[T](label: string) static is
            Std.write_line("{label}: {typeof T}");
        si

        entry() static is
            describe("byte");
        si
    si
si
