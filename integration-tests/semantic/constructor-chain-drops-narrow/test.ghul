// Soundness: a constructor is trusted for the fresh object only at a
// construction site. Reaching one by delegation from an ordinary
// method writes whatever receiver the caller already had, so calling
// a method that delegates to an occupant-nulling `init` drops a
// narrowing proven on any PEN — the written receiver may alias it —
// and `pen.occupant.purr()` must not resolve after it. A delegation
// that writes only unrelated members leaves the narrowing alone.

use IO.Std.write_line;

class ANIMAL is
    name: string public;

    init(name: string) is
        self.name = name;
    si
si

class CAT: ANIMAL is
    init(name: string) is
        super.init(name);
    si

    rename(name: string) is
        self.init(name);
    si

    purr() -> string => "{name} purrs";
si

class PEN is
    occupant: ANIMAL? field;

    init(occupant: ANIMAL?) is
        self.occupant = occupant;
    si

    evict() is
        self.init(null);
    si
si

entry() is
    let pen = PEN(CAT("tom"));
    let other = PEN(null);
    let stray = CAT("felix");

    if isa CAT(pen.occupant) then
        // rename delegates to CAT.init, which writes only `name`, so
        // the narrowing on `occupant` survives
        stray.rename("mog");

        write_line(pen.occupant.purr());
    fi

    if isa CAT(pen.occupant) then
        // evict delegates to PEN.init, which nulls `occupant` on an
        // existing receiver that may alias `pen`
        other.evict();

        write_line(pen.occupant.purr());
    fi
si
