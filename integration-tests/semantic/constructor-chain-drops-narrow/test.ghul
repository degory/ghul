// Soundness: a constructor is trusted only for the object a
// construction is building. Delegating to another constructor writes
// the receiver's own state, so reaching one from an ordinary method —
// where the receiver is whatever the caller already had — still drops
// a narrowing, and `pen.occupant.purr()` must not resolve.

use IO.Std.write_line;

class ANIMAL is
    name: string public;

    init(name: string) is
        self.name = name;
    si
si

class CAT: ANIMAL is
    init(name: string) is
        super.init(name);
    si

    rename(name: string) is
        self.init(name);
    si

    purr() -> string => "{name} purrs";
si

class PEN is
    occupant: ANIMAL? field;

    init(occupant: ANIMAL?) is
        self.occupant = occupant;
    si
si

entry() is
    let pen = PEN(CAT("tom"));
    let stray = CAT("felix");

    if isa CAT(pen.occupant) then
        stray.rename("mog");

        write_line(pen.occupant.purr());
    fi
si
