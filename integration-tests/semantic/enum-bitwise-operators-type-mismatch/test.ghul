// An enum's `&`/`|`/`^`/`\` operators are typesafe: they take and
// return the declaring enum's own type, with no coercion to or from
// the underlying integer or to any other enum. Mixing operand types is
// rejected as an ordinary overload-resolution failure. Both enums carry
// `System.Flags()` so the failure is about the type mismatch alone,
// not about either one lacking the operators in the first place — see
// `enum-bitwise-operators-need-flags` for that case.

@System.Flags()
enum A is
    X = 1,
si

@System.Flags()
enum B is
    Y = 1,
si

entry() is
    let cross_and = A.X & B.Y;
    let cross_or = A.X | B.Y;
    let cross_xor = A.X ^ B.Y;
    let int_and = A.X & 1;
si
