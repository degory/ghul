namespace Test is
    use Collections;

    // A bodiless member of a pure trait carries an implicit `pure`
    // declaration, so every implementor inherits the obligation through
    // the ordinary override contract: an implementation must itself be
    // proven store-free or declared pure.

    trait P pure is
        m() -> int;
    si

    class IMP: P is
        _n: int;

        init() is
            _n = 0;
        si

        // Stores, and overrides a pure member: rejected.
        m() -> int is
            _n = _n + 1;
            return _n;
        si
    si

    trait Q pure is
        n: int;
    si

    class IMPLQ: Q is
        init() is si

        // The getter stores through a captured list: the trait
        // property's implicit purity binds here too.
        n: int =>
            val
                let xs = Collections.LIST[int]();
                xs.add(1);
                xs[0]
            lav;
    si

    // An indexer requirement binds its implementor exactly as a
    // property does: the read direction carries the implicit
    // declaration, the write direction does not.
    trait CACHE pure is
        [i: int]: string;
    si

    class CACHED: CACHE is
        _log: LIST[int];

        init() is
            _log = LIST[int]();
        si

        [i: int]: string =>
            val
                _log.add(i);
                "x"
            lav;
    si

    // The write direction carries no implicit declaration: assign
    // accessors are the sanctioned write path, so a storing setter on
    // the implementing indexer is accepted while its getter must stay
    // clean.
    trait SESSION pure is
        [k: string]: int, = v;
    si

    class SESSIONS: SESSION is
        _log: LIST[int];

        init() is
            _log = LIST[int]();
        si

        [k: string]: int =>
            k.length,
            = v is
                _log.add(v);
            si
    si
si
