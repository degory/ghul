// `[T: A, B]` declares two type parameters, not one parameter with two
// bounds. `SIZED` is a second parameter here, so `T` is bounded by
// `NAMED` alone and `x.size` does not resolve.

namespace Test is
    trait NAMED is
        name: string;
    si

    trait SIZED is
        size: int;
    si

    f[T: NAMED, SIZED](x: T) -> string => "{x.name}/{x.size}";

    class Main is
        entry() static is
            return;
        si
    si
si
