namespace Test is
    use Collections;

    // Only a function literal is compiled as the delegate the slot
    // expects. An existing function value keeps its own type, which the
    // CLR does not convert, so it is rejected rather than emitted into a
    // slot of a different delegate type.
    sort_with(xs: LIST[int], compare: (int, int) -> int) static is
        xs.sort(compare);
    si

    entry() static is
        let compare = (a: int, b: int) -> int => b - a;
        let c: System.Comparison[int] = compare;
    si
si
