trait Maker is
    make() -> SHAPE;
si

class SHAPE is
    init() is si
si

class CIRCLE: SHAPE is
    init() is super.init(); si
si

class Factory: Maker abstract is
    init() is si

    make() -> CIRCLE;
si

class ONE: Factory is
    init() is super.init(); si

    make() -> CIRCLE => CIRCLE();
si

entry() is
    let m: Maker = ONE();

    IO.Std.write_line("{m.make()}");
si
