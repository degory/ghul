namespace Test is
    union Type is
        INT;
        ARRAY(element: Type);
    si

    describe(t: Type) -> string is
        case t
        when Type.INT then
            return "int";
        when Type.ARRAY then
            return "array";
        esac

        return "?";
    si

    whole(t: Type) -> string =>
        case t
        when Type then "type"
        else "other"
        esac;
si
