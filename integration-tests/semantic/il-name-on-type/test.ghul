namespace Test is
    @IL.name("Thing")
    class THING is
        init() is si
    si

    @IL.name("Point")
    struct POINT is
        x: int
    si

    @IL.name("Named")
    trait Named is
        name: string
    si

    @IL.name("Shape")
    union Shape is
        DOT
    si

    @IL.name("Suit")
    enum SUIT is
        HEARTS
    si

    class WIDGET is
        init() is si

        @IL.name("Run")
        run() is si

        @IL.name("Size")
        size: int => 1
    si

    entry() is
        WIDGET().run()
    si
si
