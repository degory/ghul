// A guard `if` without `else` as the tail of a non-void function is
// the statement it is: its only arm diverges, so the tail delivers no
// value, the body falls through to the default-value return, and the
// definite-return warning reports the fall-through path. No else is
// demanded, and a terminator on the `fi` changes nothing.

namespace Test is
    broken(c: bool) -> int is
        if c then
            return 1;
        fi
    si
si
