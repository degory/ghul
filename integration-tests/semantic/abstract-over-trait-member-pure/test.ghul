trait Renderable is
    tag() -> string pure;
si

class Expr: Renderable abstract is
    init() is si

    tag() -> string;
si

class NUM: Expr is
    _n: int

    init() is super.init(); _n = 0; si

    tag() -> string is
        _n = _n + 1;

        return "n";
    si
si

entry() is
    let r: Renderable = NUM();

    IO.Std.write_line(r.tag());
si
