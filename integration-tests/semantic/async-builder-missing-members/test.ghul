namespace Test is
    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(NO_RESULT))
    class NO_RESULT[T] is
        value: T;

        init(value: T) is self.value = value; si
    si

    // A builder missing set_result: reported at the function that
    // returns its task-like.
    class NO_CREATE_BUILDER[T] is
        init() is si

        create() -> NO_CREATE_BUILDER[T] static => NO_CREATE_BUILDER[T]();
        start() is si
        task: NO_CREATE_BUILDER[T] => self;
        set_exception(e: System.Exception) is si
    si

    f(x: int) -> NO_RESULT[int] is
        await Tasks.TASK.yield();
        return x;
    si
si
