namespace Test is
    use IO.Std.write_line;

    zero_of[T](ignored: int) -> T => _[T];

    from_return() -> int => zero_of(1);

    entry() is
        let from_annotation: int = zero_of(1);

        let from_assignment: int mut;
        from_assignment = zero_of(1);

        write_line("{from_annotation} {from_assignment} {from_return()}");
    si
si
