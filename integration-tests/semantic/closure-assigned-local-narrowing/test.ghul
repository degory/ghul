// A local assigned from inside a function literal shares one heap
// cell with the closure body, so a call can rewrite it. Its facts
// are judged like a field's: they survive calls as crossings, a
// leaning use is checked against what each callee can write, and
// re-observation absolves.

get() -> string? => "hello";

id(x: int) -> int pure => x;

counter: int;

bump() is counter = counter + 1; si

run(f: () -> void) is f(); si

// No call between test and use: narrows silently.
no_call_between() is
    let s: string? mut = get();

    let clear = () -> void is
        s = null;
    si;

    if s? then
        IO.Std.write_line("a {s.length}");
    fi

    clear();
si

// The writer closure invoked between test and use: reading through
// the stale view warns. The rewrite is statically possibly-absent,
// which is what the judge sees; at run time it happens to be
// present, so the guarded reads run.
writer_between() is
    let s: string? mut = get();

    let rewrite = () -> void is
        s = get();
    si;

    if s? then
        rewrite();

        IO.Std.write_line("b {s ?? "gone"}");
        IO.Std.write_line("c {s.length}");
    fi
si

// The writer laundered through a named function: the wrapper's
// effects absorb the closure it was handed, so the use still warns.
writer_through_wrapper() is
    let s: string? mut = get();

    let rewrite = () -> void is
        s = get();
    si;

    if s? then
        run(rewrite);

        IO.Std.write_line("d {s ?? "gone"}");
        IO.Std.write_line("e {s.length}");
    fi
si

// Calls that provably leave the local alone discharge: a pure
// function, and an unrelated impure function whose write set does
// not name the local.
harmless_calls_between() is
    let s: string? mut = get();

    let replace = () -> void is
        s = get();
    si;

    if s? then
        id(1);
        bump();

        IO.Std.write_line("f {s.length}");
    fi

    replace();
si

// Re-observation absolves: a fresh test after the writer ran reads
// the current value.
retest_after_writer() is
    let s: string? mut = get();

    let clear = () -> void is
        s = null;
    si;

    if s? then
        clear();

        if s? then
            IO.Std.write_line("unreachable {s.length}");
        else
            IO.Std.write_line("g gone");
        fi
    fi
si

// A fresh local is out of every closure's reach, so its facts
// survive the writer.
copy_to_local() is
    let s: string? mut = get();

    let clear = () -> void is
        s = null;
    si;

    if let present = s then
        clear();

        IO.Std.write_line("h {present.length}");
    fi
si

entry() is
    no_call_between();
    writer_between();
    writer_through_wrapper();
    harmless_calls_between();
    retest_after_writer();
    copy_to_local();
si
