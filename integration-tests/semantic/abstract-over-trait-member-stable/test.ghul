trait Held is
    value: string? stable;
si

class Holder: Held abstract is
    init() is si

    value: string?;
si

class ONE: Holder is
    _v: string?

    init() is super.init(); si

    value: string? is
        _v = "one";

        return _v;
    si
si

entry() is
    let h: Held = ONE();

    IO.Std.write_line("{h.value}");
si
