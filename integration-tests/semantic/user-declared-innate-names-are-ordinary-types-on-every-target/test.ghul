// A program declaring a type under a name the compiler gives special
// meaning to declares an ordinary type: only a library source can supply
// the task or the optional carrier.
namespace Tasks is
    class TASK is
        init() is si

        describe() -> string => "a program's own TASK"
    si
si

namespace Test is
    use IO.Std.write_line

    entry() is
        write_line(Tasks.TASK().describe())
    si
si
