// A generic `T?` formal nested inside a function type is taken
// literally by the CLR: `(int) -> U?` is `Func<int, MAYBE<U>>`, and a
// `Func<int, string?>` is not that delegate for any U. The slot-boundary
// coercion between the optional carriers cannot apply to a nested
// position, so a function value whose type is already fixed - a named
// function, or a literal with its return written out - is rejected
// rather than bound with the mismatched delegate passed through as-is.
namespace Test is
    use Std = IO.Std;

    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    spell(n: int) -> string? => if n < 10 then "small" else null fi;

    class Main is
        entry() static is
            let named = bind(30, spell);
            let annotated = bind(30, (n: int) -> string? => null);
            let explicit = bind[int, string](30, spell);
        si
    si
si
