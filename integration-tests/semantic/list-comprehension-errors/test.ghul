use IO.Std.write_line

not_iterable() -> int[] => [x for x in 42]

not_bool(xs: int[]) -> int[] => [x for x in xs if x]

wrong_annotation(xs: int[]) -> string[] => [x for x in xs]: string[]

leaves(xs: int[]) is
    for y in xs do
        let a = [(break; x) for x in xs]
        let b = [(continue; x) for x in xs]
        let c = [(for z in xs do break od; x) for x in xs]
    od
si

guarded(xs: int[]) -> int[] =>
    [
        (
            let y mut = 0
            try
                y = 100 / x
            catch e: System.Exception
                y = 0
            yrt
            y
        )
        for x in xs
    ]

generator(xs: int[]) -> Ghul.Pipes.Pipe[int] is
    let a = [(yield x; x) for x in xs]
si

awaiting(xs: int[]) -> Tasks.TASK is
    let a = [await Tasks.TASK.from_result(x) for x in xs]
si
