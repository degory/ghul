// A kind constraint is checked against a type-parameter type argument
// the same way a type bound is: an unbounded parameter satisfies neither
// `class` nor `struct`, while one declaring the kind satisfies it.

need_class[T: class](x: T) -> string => "{x}";

need_struct[T: struct](x: T) -> string => "{x}";

relay_unbounded[T](x: T) -> string => need_class(x);

relay_wrong_kind[T: struct](x: T) -> string => need_class(x);

// A trait bound does not guarantee a reference type - a struct can
// implement a trait - so it does not stand in for the `class` kind.
trait Named is
    name: string;
si

relay_trait_bound[T: Named](x: T) -> string => need_class(x);

// Declaring the kind the callee requires is accepted.
relay_class[T: class](x: T) -> string => need_class(x);

relay_struct[T: struct](x: T) -> string => need_struct(x);

entry() is
si
