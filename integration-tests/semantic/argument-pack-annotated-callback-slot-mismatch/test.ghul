namespace Test is
    use IO.Std;
    use Ghul.Pipes;
    use Collections.LIST;

    // Tests: an annotated N-ary literal going into a pack formal whose
    // element type is already pinned is checked against what the slot
    // supplies. The wrapper is declared at the slot's element type, so
    // written parameters that disagree with it are the author's to
    // answer for, not a way to rename what arrives.

    class Main is
        entry() static is
            let rows = LIST([3, 1]);

            rows |> index()
            |> each((row: string, column: string) =>
                Std.write_line("{row}{column}"));

            return;
        si
    si
si
