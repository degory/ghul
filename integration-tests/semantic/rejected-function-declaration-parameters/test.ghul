// Functions in a rejected block (here, adding members to an imported
// type) report only the block's rejection - not an error per function,
// nor one per parameter from nothing having declared them into any
// scope. Covers both a simple parameter and a destructured one.
namespace App is
    partial System.Text.StringBuilder is
        described(prefix: string, count: int) -> string => "{prefix}{count}";

        summarised((a: int, b: int): (int, int)) -> string => "{a}{b}";
    si
si
