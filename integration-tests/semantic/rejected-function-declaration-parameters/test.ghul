// A rejected function declaration (here, adding a member to an imported
// type) must report only the rejection itself - not a further error per
// parameter, from nothing having declared them into any scope. Covers
// both a simple parameter and a destructured one.
namespace App is
    partial System.Text.StringBuilder is
        described(prefix: string, count: int) -> string => "{prefix}{count}";

        summarised((a: int, b: int): (int, int)) -> string => "{a}{b}";
    si
si
