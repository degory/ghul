use System.IParsable.parse;

// `parse` is a static virtual member of System.IParsable[TSelf], and
// TSelf appears only in its return type. No argument binds it, there is
// no receiver naming a type parameter to dispatch through, and no bound
// pins it - so nothing at the call site determines what to parse to.
entry() is
    IO.Std.write_line("{parse("42", null)}");
si
