// Soundness: a constructor is trusted only for the object it is
// building. One that stores through its argument writes a
// pre-existing object, so constructing one drops a caller's
// narrowing on the member it writes, and `pen.occupant.purr()` must
// not resolve after the construction. A constructor that writes only
// elsewhere — a global here — leaves the narrowing alone.

use IO.Std.write_line;

escaped: ANIMAL?;

class ANIMAL is
    name: string public;

    init(name: string) is
        self.name = name;
    si
si

class CAT: ANIMAL is
    init(name: string) is
        super.init(name);
    si

    purr() -> string => "{name} purrs";
si

class LEAK is
    init(animal: ANIMAL) is
        escaped = animal;
    si
si

class SWEEP is
    init(pen: PEN) is
        pen.evacuate();
    si
si

class PEN is
    occupant: ANIMAL? field;

    init(occupant: ANIMAL?) is
        self.occupant = occupant;
    si

    evacuate() is
        occupant = null;
    si
si

entry() is
    let pen = PEN(CAT("tom"));

    if isa CAT(pen.occupant) then
        // writes only the global, so the narrowing survives
        let leak = LEAK(CAT("felix"));

        write_line(pen.occupant.purr());
    fi

    if isa CAT(pen.occupant) then
        // writes `occupant` through its argument
        let sweep = SWEEP(pen);

        write_line(pen.occupant.purr());
    fi
si
