// Soundness: a constructor is only trusted for the object it is
// building. One that writes anything else — a global here — still
// drops a caller's narrowing, so `pen.occupant.purr()` must not
// resolve after the construction.

use IO.Std.write_line;

escaped: ANIMAL?;

class ANIMAL is
    name: string public;

    init(name: string) is
        self.name = name;
    si
si

class CAT: ANIMAL is
    init(name: string) is
        super.init(name);
    si

    purr() -> string => "{name} purrs";
si

class LEAK is
    init(animal: ANIMAL) is
        escaped = animal;
    si
si

class PEN is
    occupant: ANIMAL? field;

    init(occupant: ANIMAL?) is
        self.occupant = occupant;
    si
si

entry() is
    let pen = PEN(CAT("tom"));

    if isa CAT(pen.occupant) then
        let leak = LEAK(CAT("felix"));

        write_line(pen.occupant.purr());
    fi
si
