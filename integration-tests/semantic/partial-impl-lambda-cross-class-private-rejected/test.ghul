namespace Test is
    use Std = IO.Std;

    class HOLDER is
        _n: int;
        init(n: int) is _n = n; si
    si

    class OTHER is
        _secret: int;
        init(s: int) is _secret = s; si
    si

    partial HOLDER is
        // a lambda in a partial block reading another class's private
        // member must still be rejected: the accessing type is HOLDER,
        // not OTHER
        peek(o: OTHER) -> int is
            let f = () -> int => o._secret;
            return f();
        si
    si
si
