class NEEDS_INT: System.Attribute is
    init(value: int) is si
si

use_unknown_attribute() is
    let f: (int) -> int = (@Nonexistent() n: int) -> int => n;
si

use_mismatched_attribute() is
    let f: (int) -> int = (@NEEDS_INT("not an int") n: int) -> int => n;
si

use_attribute_on_tuple_literal() is
    let t = (@NEEDS_INT(1) x: int = 1, y: int = 2);

    IO.Std.write_line("{t.x} {t.y}");
si

entry() static is
    return;
si
