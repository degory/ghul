namespace Test is
    class ANIMAL is
        init() is si
    si

    class CAT: ANIMAL is
        init() is super.init(); si
    si

    entry() static is
        let a: ANIMAL = CAT();

        // expect warning: the slug in the MSBuild code slot
        let c = cast CAT(a);

        // expect error: canonical form with no code
        let n: int = "not an int";

        IO.Std.out.write_line("{c} {n}");
    si
si
