namespace Test is
    use Std = IO.Std;

    class Main is
        double_async(x: int) -> Tasks.TASK[int] static is
            return x * 2;
        si

        entry() static is
            let f = ((a, b)) -> Tasks.TASK[int] is
                let d = await double_async(a);
                return d + b;
            si;

            for p in [(1, 2), (3, 4)] do
                Std.write_line("{f(p).result}");
            od
        si
    si
si
