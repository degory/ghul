namespace Test is
    struct S(n: int) is
        // rejected: the literal reads an instance member of the struct
        bad() -> int => (x => x * n)(3);

        // rejected: the literal reads self
        bad_self() -> int => (x => x * self.n)(3);

        // accepted: the literal reads nothing of the struct
        ok() -> int => (x => x * 2)(3);

        // accepted: a local copy is what the literal captures
        ok_copy() -> int is
            let by = n;

            return (x => x * by)(3);
        si

        // accepted: a struct reached through anything but self
        ok_other(other: S) -> int => (x => x * other.n)(3);
    si

    class C(n: int) is
        // accepted: a class instance member is a reference
        ok_class() -> int => (x => x * n)(3);
    si

    class Main is
        entry() static is
            return;
        si
    si
si
