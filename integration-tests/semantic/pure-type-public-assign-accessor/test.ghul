namespace Test is
    use IO.Std;

    // On a pure type only constructors and assign accessors may write,
    // and an assign accessor reachable from outside breaks the promise:
    // writes through one happen at arbitrary times from elsewhere.
    // Declaring a property `public` grants public write, so it is
    // rejected - on a body declaration and on a primary-constructor
    // parameter alike. The default write visibility (private to the
    // type) is fine.

    class C pure is
        pub: int public;

        init() is
            pub = 0;
        si
    si

    struct S pure is
        pub: int public;

        init(v: int) is
            pub = v;
        si
    si

    class E(v: int public) pure is
        init(..) is
            Std.write_line("{v}");
        si
    si
si
