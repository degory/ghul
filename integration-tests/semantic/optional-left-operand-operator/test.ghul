namespace Test is
    // An operator declared on a type takes its left operand as `self`,
    // which is never absent, so no such operator can accept a left
    // operand that may hold no value - the same rejection any other
    // non-optional formal makes of an optional actual. A global operator
    // declaring an optional left operand answers for absence itself and
    // resolves normally.

    class THING is
        v: int;

        init(v: int) is
            self.v = v;
        si

        -(other: THING) -> int pure => v - other.v;

        <>(other: THING) -> int pure => v - other.v;

        =~(other: THING) -> bool pure => v == other.v;

        get_hash_code() -> int => v;
    si

    +(a: THING?, b: THING) -> int pure => if a? then a.v + b.v else 0 fi;

    class MAIN is
        subtract(a: THING?, b: THING) -> int => a - b;

        less(a: THING?, b: THING) -> bool => a < b;

        narrowed(a: THING?, b: THING) -> int is
            if a? then
                return a - b;
            fi

            return 0;
        si

        present(a: THING, b: THING) -> int => a - b;

        equal(a: THING?, b: THING) -> bool => a =~ b;

        unequal(a: THING?, b: THING) -> bool => a !~ b;

        global_takes_optional(a: THING?, b: THING) -> int => a + b;

        // The candidate is resolved before it is declined, so an
        // argument the operator would have rejected anyway keeps its own
        // diagnostic rather than being told to narrow the left operand.
        wrong_argument(a: THING?, s: string) -> int => a - s;

        // An error-typed operand already drew its own diagnostic; the
        // operator is not reported on top of it.
        error_argument(a: THING?) -> int => a - no_such_thing;

        entry() static is
            return;
        si
    si
si
