namespace Test is
    // Tests: `..` on a formal's type marks one of the two things a pack
    // parameter can stand for - the arguments as an N-ary function, or
    // the tuple they are spread into. Every other position is reported,
    // as is a name that no `[T..]` declares.

    nested[T.., U](f: Collections.LIST[T.. -> U], v: T) is si

    pair[T.., U](f: (T.., int) -> U) is si

    not_a_pack[A, U](f: A.. -> U, v: A) -> U => f(v);
si
