namespace Test is
    // Tests: `..` on a formal's type marks one of the two things a pack
    // parameter can stand for - the arguments as an N-ary function, or
    // the tuple they are spread into. The first may sit on any function
    // type along the formal's return spine; every other position is
    // reported, as is a name that no `[T..]` declares.

    nested[T.., U](f: Collections.LIST[T.. -> U], v: T) is si

    pair[T.., U](f: (T.., int) -> U) is si

    not_a_pack[A, U](f: A.. -> U, v: A) -> U => f(v);

    // The return spine is what the marker may sit on. A function type
    // reached through a parameter is not on it: the formal's caller
    // supplies the function, not the arguments the pack stands for.
    parameter_position[T.., U](f: (T.. -> U) -> U) is si
si
