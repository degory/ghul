namespace Test is
    // Tests: `..` on a formal's type says that formal takes the pack
    // spread out, which is only a shape a function of one parameter has.
    // Every other position is reported, including a value formal - the
    // pack is a tuple there, and spreading a call's arguments across it
    // is not yet available - and a name that no `[T..]` declares.

    spread[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    nested[T.., U](f: Collections.LIST[T.. -> U], v: T) is si

    pair[T.., U](f: (T.., int) -> U) is si

    not_a_pack[A, U](f: A.. -> U, v: A) -> U => f(v);
si
