use IO.Std.write_line;

tally(xs: int[]) -> int => xs.count;

// A name in call position that resolves to something holding no
// function looks past it for a callable of the same name further out.
// Both the case where the local is the one being declared, and the
// case where it is already initialized, reach the enclosing function.
uninitialized_shadow() is
    let xs = [1, 2, 3];
    let tally = tally(xs);

    write_line("{tally}");
si

initialized_shadow() is
    let xs = [1, 2, 3];
    let tally = 0;

    write_line("{tally(xs)}");
si

// The shadow is looked past for a call, and only for a call: a plain
// read still sees the local.
read_is_not_a_call() is
    let tally = 0;

    write_line("{tally}");
si

// A function group whose overloads do not accept the arguments is a
// genuine argument mismatch, not a shadowed name, so it reports as one
// rather than reaching for something else.
wrong_arguments() is
    write_line("{tally(1, 2)}");
si

// A lambda that refers to its own name is reaching for itself rather
// than for a function that happens to share the name, so it keeps
// reporting the reference as one to a value that does not exist yet.
self_referential_literal() is
    let tally = (ys: int[]) -> int => tally(ys);

    write_line("{tally([1, 2, 3])}");
si

entry() is
    uninitialized_shadow();
    initialized_shadow();
    read_is_not_a_call();
    wrong_arguments();
    self_referential_literal();
si
