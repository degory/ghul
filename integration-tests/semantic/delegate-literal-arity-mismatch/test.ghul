// A literal converts to a named delegate only when it takes as many
// parameters as the delegate does. The delegate is constructed over
// the literal's own method and the runtime never checks the two
// signatures agree, so a literal of another arity is left as the
// function it is and reported where it fails to fit - as a value of a
// typed local, as a call argument, and at a pack formal spelled as a
// delegate over the pack, which carries no marker to spread it.
namespace Test is
    take(c: System.Converter[int, int]) -> int => c.invoke(3);

    once_d[T.., U](f: System.Converter[T, U]) -> T.. -> U => v => f.invoke(v);

    t() is
        let c: System.Converter[int, int] = (a: int, b: int) -> int => a + b;
        let d: System.Converter[int, int] = (a, b) => a + b;

        take((a, b) => a + b);

        let g: (int, int) -> int = once_d((a: int, b: int) -> int => a + b * 10);

        let ok: System.Converter[int, int] = a => a + 1;
    si
si
