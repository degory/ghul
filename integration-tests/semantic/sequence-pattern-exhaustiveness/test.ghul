use default

complete(xs: List[int]) -> int =>
    case xs
    when [] then 0
    when [x, ..rest] then x
    esac

missing_empty(xs: List[int]) -> int =>
    case xs
    when [x, ..rest] then x
    else 0
    esac

missing_longer(xs: List[int]) -> int is
    case xs
    when [] then return 0
    when [x] then return x
    esac

    return -1
si

redundant(xs: List[int]) -> int =>
    case xs
    when [] then 0
    when [x, ..rest] then x
    when [y] then y
    esac

dead_else(xs: List[int]) -> int =>
    case xs
    when [] then 0
    when [x, ..rest] then x
    else 1
    esac

entry() is
si
