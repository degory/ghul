// Imported methods whose parameters hand them no way to name code
// declared here or to reach storage that existed before the call are
// trusted structurally, without any addition to the curated lists:
//
//   - a static with only scalar, string or enum parameters has no
//     receiver and nothing overridable in its signature, so it
//     writes nothing pre-existing: store-free;
//   - instance members the CLR binds statically (non-virtual, final,
//     on a struct, or on a sealed owner) with the same parameter
//     shape can write its own receiver's interior and nothing else:
//     field facts survive them, property facts do not.
//
// Each function below guards a member, calls something, and then
// reads the member where a still-narrowed one is legal. The reads
// that draw an error are the false kills the tiers remove; the reads
// that still draw an error name the hazards the tiers must keep.

len(s: string) -> int => s.length;

class SUBJECT is
    _name: string? field;
    _when: System.DateTime field;
    _broken: System.Exception field;
    _sink: int field;

    named: string? => _name;

    // declared pure so the fact it backs is presented as a narrowing
    // at all
    when_year: int? pure => _when.year;

    init() is
        _name = null;
        _when = System.DateTime(2026, 8, 23);
        _broken = System.Exception("x");
    si

    _store() is
        _sink = _intermediate();
    si

    _intermediate() -> int => 7;

    _clear() is
        _name = null;
    si

    // survives: a static import whose parameters reach nothing is
    // trusted store-free without any curation
    field_survives_static_import_call() -> int is
        if !_name? then return -1; fi
        System.Convert.to_boolean(_name.length > 0);
        return len(_name);
    si

    // survives: constructing from unreaching arguments writes no
    // pre-existing slot; DateTimeKind is an enum, which counts as
    // scalar here
    field_survives_enum_parameter_construction() -> int is
        if !_name? then return -1; fi
        let stamped = System.DateTime(2026, 8, 23, 10, 30, 0, System.DateTimeKind.UTC);
        return len(_name) + (if stamped.year > 2020 then 0 else -2 fi);
    si

    // survives: add_years is declared on a struct, which cannot be
    // extended, so it binds statically and can only touch its
    // receiver's interior
    field_survives_struct_instance_method() -> int is
        if !_name? then return -1; fi
        _when.add_years(1);
        return len(_name);
    si

    // survives: year's getter is declared on a struct and binds
    // statically; it can read its receiver, never write anything
    // pre-existing
    field_survives_struct_getter() -> int is
        if !_name? then return -1; fi
        let y = _when.year;
        return len(_name) + (if y > 0 then 0 else -2 fi);
    si

    // dies: message is virtual on an unsealed owner, so an override
    // in another assembly could stand behind the call and store
    field_dies_on_virtual_getter() -> int is
        if !_name? then return -1; fi
        let m = _broken.message;
        return len(_name) + (if m =~ "x" then 0 else -2 fi);
    si

    // dies: even a struct instance member can change what a getter
    // returns, so property facts still die across it — `when_year`
    // reads `_when`, which `add_years` genuinely changes
    property_dies_on_struct_method() -> int is
        if !when_year? then return -1; fi
        _when.add_years(1);
        return when_year;
    si

    // control: a storing ghūl method still kills the fact, proving
    // the test is not vacuously green
    field_dies_on_storing_method_control() -> int is
        if !_name? then return -1; fi
        _clear();
        return len(_name);
    si
si
