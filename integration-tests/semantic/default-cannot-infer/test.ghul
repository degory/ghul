namespace Test is
    class Main is
        // A bare `_` in an unambiguous call-argument position infers
        // the parameter type from the resolved callee - but a `_`
        // argument never itself contributes to binding a generic
        // type variable, so it cannot resolve one that no other
        // argument or the call's context pins.
        only[T](a: T) -> T static => a;

        entry() static is
            only(_);
        si
    si
si
