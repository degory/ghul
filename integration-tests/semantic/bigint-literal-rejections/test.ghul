namespace Test is
    use IO.Std.write_line;

    class Main is
        entry() static is
            // `n` says bigint, which has no unsigned counterpart, so
            // the sign selector has nothing to select.
            let unsigned = 1un;

            // bigint is a struct, so identity comparison is rejected on
            // it as it is on every other struct.
            let identity = 1n == 2n;

            // And there is no implicit widening, so a mixed expression
            // is rejected the way `1.0D + 1` is.
            let mixed = 1n + 1;

            write_line("{unsigned} {identity} {mixed}");
        si
    si
si
