use System.Reflection.MetadataLoadContext

// `MetadataLoadContext` is in an assembly of its own, outside the reference
// pack, and `Collections.LIST` is in the pack: both resolving shows the
// assembly named with --reference was added to the default set, where -a
// would have replaced it.
describe(context: MetadataLoadContext, names: Collections.LIST[string]) -> string =>
    "{context.core_assembly} {names.count}"
