namespace Shapes is
    class POINT is
        init() is si
    si

    area(q: POINT) -> int => 1
si

namespace Drawing is
    class POINT is
        init() is si
    si

    class BOX[T] is
        item: T

        init(item: T) is
            self.item = item
        si

        swap[T](x: T) -> T => item
    si

    take_box[T](b: BOX[T], y: T) is
    si

    other[T](x: T) is
        take_box(BOX(1), x)
    si

    test() is
        Shapes.area(POINT())

        let p: Shapes.POINT = POINT()
    si
si
