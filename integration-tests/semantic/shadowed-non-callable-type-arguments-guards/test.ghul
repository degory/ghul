use IO.Std.write_line

pick[T](x: T) -> T => x

// A lambda that applies type arguments to its own name is reaching for
// itself rather than for a function that shares the name, so the
// reference is reported rather than rerouted.
self_reference() is
    let pick = (x: int) => pick[int](x)

    write_line("{pick(1)}")
si

// A local whose declaration already failed is not evidence that it
// holds no function, so there is no second diagnostic about it.
poisoned_local() is
    let pick = no_such_function()

    write_line("{pick[int](3)}")
si
