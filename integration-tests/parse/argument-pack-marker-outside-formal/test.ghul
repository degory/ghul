// The argument-pack marker is only read on a formal argument's type and
// a declared return type. Anywhere else it is reported once, and the
// type around it still parses, so nothing further is reported.
class EVENT[T..] is
    _handlers: Collections.LIST[T.. -> void]

    init() is
        _handlers = Collections.LIST[T.. -> void]()
    si

    subscribe(handler: T.. -> void) is
        _handlers.add(handler)
    si

    replay() is
        let first: T.. -> void = _handlers[0]
    si
si
