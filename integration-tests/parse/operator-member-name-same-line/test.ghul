namespace Test is
    class MAIN is
        entry() is
            let x = 1;

            // an operator is a member name only on the dot's own line:
            // a `.` ending a line must not swallow an operator leading
            // the next one, the same rule a partially typed keyword
            // member follows
            let y = x.
            -1;

            IO.Std.write_line("{y}");
        si
    si
si
