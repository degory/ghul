// A statement after a `let` ends at the line break whatever the columns
// involved: a deeper-indented next statement, and a continuation line
// ending left of the next statement's column, are both fine. The
// missing-comma recovery stays a same-line affair.
use IO.Std.write_line;

entry() is
    let a = 1
            write_line("{a}")

    let b = 1 +
2
    write_line("{b}")
si
