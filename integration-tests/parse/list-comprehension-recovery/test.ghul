use IO.Std.write_line

missing_in(xs: int[]) -> int[] => [x for x xs]

missing_variable(xs: int[]) -> int[] => [x for in xs]

missing_source(xs: int[]) -> int[] => [x for x in ]

missing_condition(xs: int[]) -> int[] => [x for x in xs if]

stray_token(xs: int[]) -> int[] => [x for x in xs 3]

never_closed(xs: int[]) -> int[] is
    let a = [x for x in xs
    let b = 1

    return [b]
si
