// The recovery skip has to stop somewhere even when the brackets it is
// counting do not balance, which is the ordinary state of code being
// edited. The unclosed `(` below sits in the region being skipped, so
// nothing after it can bring the nesting back to zero; the dedented lines
// are what bound the damage. Everything from the loop's `od` onwards must
// still be parsed.
namespace TEST.RecoveryUnbalancedBracketInSkippedRegion is
    collatz(n: int) -> int is
        let current mut = n

        while current > 1 do
            ) step(current
        od

        current = current + undefined_inside_the_body

        return current
    si

    next_definition() -> int => undefined_after_the_damage
si
