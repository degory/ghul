// A written statement terminator at end of line is redundant - the line
// break already infers it, and nothing reads the terminator for meaning.
// Reported only under --warn redundant-semicolon, and everywhere: before
// a closing keyword and before `)` included, since a body's tail is
// judged by its type. Silent for a `;` separating two statements on one
// line. Even a trailing `|` needs none: it closes as the postfix
// pipe-wrap it looks like when the next line does not carry the chain
// on. The one exemption is a `;` between two string literals, which
// would otherwise chain into a single literal across the line break -
// that one separates rather than terminates, and is never reported.
use IO.Std.write_line;

greet() -> string => "hello";

entry() is
    let a = 1;
    let b = 2; let c = 3;
    write_line("{a + b + c}");;
    if a > 0 then
        write_line("positive");
    fi;
    let d = (write_line("block"); a + 1);
    write_line(greet());
    write_line("{d}");
si

bare_pipe_wrap() is
    let pipe = [2, 1] |
    write_line(pipe.to_string())

    let chained = [3, 1] |
        .sort()
    write_line(chained.to_string())
si

// a `;` between two string literals separates fragments that would
// otherwise chain into one literal across the line break: never
// redundant, no warning
separating() -> string is
    let band = "top";
    "{band} band"
si

// the same shape with no string before the `;`: nothing to chain, so
// the terminator is redundant as usual
not_separating() -> string is
    let n = 1;
    "{n} band"
si

// no terminator between the fragments: the two lines are one literal
chained() -> string is
    let wrapped = "front "
        "back"
    wrapped
si

// the last token in the file: end of file ends the line too
last() -> int => 1;
