// A written statement terminator at end of line is redundant - the line
// break already infers it. Reported only under --warn redundant-semicolon;
// a terminator before a closing keyword or `)` stays semantic and silent,
// as does a `;` separating two statements on one line.
use IO.Std.write_line;

greet() -> string => "hello";

entry() is
    let a = 1;
    let b = 2; let c = 3;
    write_line("{a + b + c}");;
    if a > 0 then
        write_line("positive");
    fi;
    let d = (write_line("block"); a + 1);
    write_line(greet());
    write_line("{d}");
si

dangling() is
    let pipe = [2, 1] |;
    write_line(pipe.to_string())
si
