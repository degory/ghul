// A written statement terminator at end of line is redundant - the line
// break already infers it, and nothing reads the terminator for meaning.
// Reported only under --warn redundant-semicolon, and everywhere: before
// a closing keyword and before `)` included, since a body's tail is
// judged by its type. Silent for a `;` separating two statements on one
// line. Even a trailing `|` needs none: it closes as the postfix
// pipe-wrap it looks like when the next line does not carry the chain
// on.
use IO.Std.write_line;

greet() -> string => "hello";

entry() is
    let a = 1;
    let b = 2; let c = 3;
    write_line("{a + b + c}");;
    if a > 0 then
        write_line("positive");
    fi;
    let d = (write_line("block"); a + 1);
    write_line(greet());
    write_line("{d}");
si

bare_pipe_wrap() is
    let pipe = [2, 1] |
    write_line(pipe.to_string())

    let chained = [3, 1] |
        .sort()
    write_line(chained.to_string())
si

// the last token in the file: end of file ends the line too
last() -> int => 1;
