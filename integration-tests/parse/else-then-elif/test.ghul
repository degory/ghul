use IO.Std.write_line

describe(x: int) is
    if x == 1 then
        write_line("one")
    else
    elif x == 3 then
        write_line("three")
    else
        write_line("other")
    fi
si

twice_else(x: int) is
    if x == 1 then
        write_line("one")
    else
        write_line("not one")
    else
        write_line("never")
    fi
si

as_value(x: int) -> string =>
    if x == 1 then "one" else "other" elif x == 2 then "two" fi
