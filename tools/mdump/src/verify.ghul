namespace MetadataDump is
    use System.Reflection.Metadata.MetadataReader;
    use System.Reflection.Metadata.Ecma335.MetadataTokens;
    use System.Reflection.Metadata.TypeDefinition;
    use System.Reflection.Metadata.EntityHandle;
    use System.Reflection.PortableExecutable.PEReader;
    use System.Reflection.Metadata.PEReaderExtensions;

    // Checks what ILVerify does not.
    //
    // ILVerify is the instrument for anything to do with the IL a method
    // contains — it decodes each body, tracks the stack, and resolves
    // every token, which catches signature and instantiation faults far
    // more thoroughly than reading tables would. Run it first.
    //
    // What it does not do is notice a method that contains no IL at all.
    // An assembly whose every method row points at nothing verifies
    // clean, because there is nothing in any of them to disagree with.
    // That is not hypothetical: it is what a back end emitting rows
    // without bodies produces, and it loads as far as the first call.
    class VERIFY(_path: string) is
        violations() -> Collections.List[string] is
            let result = Collections.LIST[string]();

            let use stream = IO.File.open_read(_path);
            let use pe = PEReader(stream);

            let metadata = PEReaderExtensions.get_metadata_reader(pe);

            for handle in metadata.type_definitions do
                let type = metadata.get_type_definition(handle);

                _check_bodies(metadata, type, result);
            od

            return result;
        si

        _INTERFACE: int static => 32;

        _ABSTRACT: int static => 1024;
        _PINVOKE: int static => 8192;

        // A method implemented by the runtime or in native code carries
        // no IL by design, and says so in its implementation flags.
        _NOT_IL: int static => 3;

        _check_bodies(
            metadata: MetadataReader,
            type: TypeDefinition,
            into: Collections.LIST[string]
        ) is
            // An interface's members are declarations unless they carry
            // a default implementation, and a default one is not
            // abstract, so the type has to be consulted rather than the
            // method alone.
            let is_interface = (cast int(type.attributes) & _INTERFACE) != 0;

            for handle in type.get_methods() do
                let method = metadata.get_method_definition(handle);

                if method.relative_virtual_address != 0 then
                    continue;
                fi

                let attributes = cast int(method.attributes);

                if (attributes & _ABSTRACT) != 0 \/ (attributes & _PINVOKE) != 0 then
                    continue;
                fi

                if (cast int(method.impl_attributes) & _NOT_IL) != 0 then
                    continue;
                fi

                if is_interface then
                    continue;
                fi

                into.add(
                    "Method#{MetadataTokens.get_row_number(cast EntityHandle(handle))} "
                    "{_name(metadata, type)}.{metadata.get_string(method.name)} has no body");
            od
        si

        _name(metadata: MetadataReader, type: TypeDefinition) -> string is
            let space = metadata.get_string(type.`namespace);
            let name = metadata.get_string(type.name);

            return if space.length == 0 then name else "{space}.{name}" fi;
        si
    si
si
