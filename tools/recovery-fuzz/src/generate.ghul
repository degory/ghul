namespace RecoveryFuzz is
    use default

    // Builds a well-formed program around one damage site. The program is
    // compiled before it is damaged as well as after, so a generator bug
    // shows up as a baseline failure rather than as a recovery finding.
    //
    // The shapes it varies are the ones an editor holds half-written: a
    // method with no second half, an expression-bodied function, a body
    // nested two or three constructs deep, bare statements at the file
    // root. A half-finished method is the ordinary case in an IDE, not the
    // exceptional one, so the contexts are weighted evenly rather than
    // towards the tidy ones.
    contexts() -> LIST[string] =>
        LIST[string]([
            "top-level",
            "global-block",
            "global-expression",
            "method-block",
            "method-expression",
            "trait-default",
            "nested-literal",
            "generator"
        ])

    class GENERATOR(rng: RNG) is
        _lines: LIST[LINE];
        _next_name: int;
        _has_tail: bool;

        init(..) is
            _lines = LIST[LINE]()
            _next_name = 0
        si

        generate(seed: int, context: string) -> PROGRAM is
            _lines = LIST[LINE]()
            _next_name = 0
            _has_tail = false

            _plain(0, "use default")
            _plain(0, "")

            _canary(0, "before_canary", before_marker())
            _plain(0, "")

            case context
            when "top-level" then _top_level()
            when "global-block" then _global_block()
            when "global-expression" then _global_expression()
            when "method-block" then _classy("class", "CARRIER", false)
            when "method-expression" then _classy("class", "CARRIER", true)
            when "trait-default" then _classy("trait", "Carrier", false)
            when "nested-literal" then _nested_literal()
            when "generator" then _generator()
            esac

            _plain(0, "")
            _canary(0, "after_canary", after_marker())

            let program = PROGRAM(seed, context, _lines)
            program.has_tail = _has_tail

            program
        si

        // Contexts

        _top_level() is
            _body(0, true)
        si

        _global_block() is
            _opener(0, "worker(n: int) -> int is")
            _body(4, true)
            _statement(4, "return n")
            _closer(0, "si")
        si

        // An expression body has nowhere to put a tail marker, so its damage
        // site is the expression itself and only the outer canaries stand.
        _global_expression() is
            _opener(0, "worker(n: int) -> int =>")
            _statement(4, "if n > 0 then n * 2 else n + {rng.next(9) + 1} fi")
        si

        _classy(kind: string, name: string, expression_bodied: bool) is
            _opener(0, "{kind} {name} is")

            if kind =~ "class" then
                _plain(4, "init() is si")
                _plain(4, "")
            fi

            if expression_bodied then
                _opener(4, "measure(n: int) -> int =>")
                _statement(8, "if n > 0 then n * 2 else n + {rng.next(9) + 1} fi")
            else
                _opener(4, "measure(n: int) -> int is")
                _body(8, true)
                _statement(8, "return n")
                _closer(4, "si")
            fi

            _closer(0, "si")
        si

        _nested_literal() is
            _opener(0, "worker(n: int) -> int is")
            _opener(4, "let inner = (m: int) -> int is")
            _body(8, true)
            _statement(8, "return m")
            _closer(4, "si")
            _statement(4, "return inner(n)")
            _closer(0, "si")
        si

        _generator() is
            _opener(0, "worker(n: int) -> Pipe[int] is")
            _body(4, true)
            _statement(4, "yield n")
            _closer(0, "si")
        si

        // Bodies

        // A run of statements with a damage site somewhere in it, then the
        // tail marker, so that everything the recovery drops is measurable.
        _body(indent: int, want_tail: bool) is
            _statement(indent, "let total mut = 0")

            _nest(indent, rng.between(0, 2))

            if want_tail then
                _canary_statement(indent, tail_marker())
            fi
        si

        _nest(indent: int, depth: int) is
            if depth <= 0 then
                _leaf(indent)

                return
            fi

            case rng.next(5)
            when 0 then
                _opener(indent, "if total < {rng.next(9) + 1} then")
                _nest(indent + 4, depth - 1)
                _closer(indent, "fi")
            when 1 then
                _opener(indent, "while total < {rng.next(9) + 1} do")
                _nest(indent + 4, depth - 1)
                _statement(indent + 4, "total = total + 1")
                _closer(indent, "od")
            when 2 then
                _opener(indent, "for step in 1..{rng.next(5) + 2} do")
                _nest(indent + 4, depth - 1)
                _closer(indent, "od")
            when 3 then
                _opener(indent, "case total")
                _opener(indent, "when {rng.next(4)} then")
                _nest(indent + 4, depth - 1)
                _opener(indent, "else")
                _statement(indent + 4, "total = total - 1")
                _closer(indent, "esac")
            else
                _opener(indent, "try")
                _nest(indent + 4, depth - 1)
                _opener(indent, "catch caught: System.Exception")
                _statement(indent + 4, "total = total + 1")
                _closer(indent, "yrt")
            esac
        si

        // The innermost statements, and where a damage site lands most
        // often: an assignment with a value, which is the shape a
        // half-written line takes.
        _leaf(indent: int) is
            let a = _name()
            let b = _name()

            _statement(indent, "let {a} = total + {rng.next(20)}")
            _statement(indent, "total = {a} * {rng.next(5) + 1}")
            _statement(indent, "let {b} =")
            _statement(indent + 4, "{a} + total * {rng.next(7) + 1}")
            _statement(indent, "write_line(\"{{{b}}}\")")
        si

        // Lines

        _name() -> string is
            _next_name = _next_name + 1

            "value_{_next_name}"
        si

        _add(indent: int, text: string, role: string) is
            let line = LINE(indent, text)
            line.role = role
            _lines.add(line)
        si

        _plain(indent: int, text: string) is _add(indent, text, "plain") si
        _statement(indent: int, text: string) is _add(indent, text, "statement") si
        _opener(indent: int, text: string) is _add(indent, text, "opener") si
        _closer(indent: int, text: string) is _add(indent, text, "closer") si

        _canary(indent: int, name: string, marker: string) is
            _plain(indent, "{name}() -> int => {marker}")
        si

        _canary_statement(indent: int, marker: string) is
            _has_tail = true
            _plain(indent, "total = total + {marker}")
        si
    si
si
