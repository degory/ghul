namespace RecoveryFuzz is
    use default

    // The ways a program under an editor's cursor is broken. Each one names
    // the markers it leaves reachable: a mutation that deletes the rest of
    // the file cannot be asked to preserve what it deleted, and the oracle
    // reads the expectation rather than assuming it.
    mutations() -> LIST[string] =>
        LIST[string]([
            "truncate-file",
            "drop-value",
            "drop-line-tail",
            "drop-closer",
            "swap-closer",
            "duplicate-closer",
            "drop-opener-keyword",
            "drop-open-bracket",
            "drop-close-bracket",
            "insert-stray"
        ])

    strays() -> LIST[string] => LIST[string]([")", "]", "=", ",", "fi", "od", ".", "|>"])

    class MUTATOR(rng: RNG) is
        apply(program: PROGRAM, mutation: string) -> bool is
            case mutation
            when "truncate-file" then return _truncate_file(program)
            when "drop-value" then return _drop_value(program)
            when "drop-line-tail" then return _drop_line_tail(program)
            when "drop-closer" then return _drop_closer(program)
            when "swap-closer" then return _swap_closer(program)
            when "duplicate-closer" then return _duplicate_closer(program)
            when "drop-opener-keyword" then return _drop_opener_keyword(program)
            when "drop-open-bracket" then return _drop_bracket(program, true)
            when "drop-close-bracket" then return _drop_bracket(program, false)
            when "insert-stray" then return _insert_stray(program)
            esac

            false
        si

        // A method whose second half has not been written yet: everything
        // from a line inside the body onwards is simply gone, closers
        // included. Nothing after the cut can be expected to survive, so
        // only the leading canary stands.
        _truncate_file(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 then
                return false
            fi

            while program.lines.count > at do
                program.lines.remove_at(program.lines.count - 1)
            od

            _record(program, "truncate-file", at, false, false)
        si

        // `x = ` with nothing after it - the line the cursor is sitting on.
        _drop_value(program: PROGRAM) -> bool is
            let at = _pick_containing(program, "=")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.index_of("=")

            line.text = line.text[0..cut + 1]

            _record(program, "drop-value", at, program.has_tail, true)
        si

        // Half a line, cut at a random column: the state of a line being
        // typed left to right.
        _drop_line_tail(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]

            if line.text.length < 3 then
                return false
            fi

            line.text = line.text[0..rng.between(1, line.text.length - 1)]

            _record(program, "drop-line-tail", at, program.has_tail, true)
        si

        _drop_closer(program: PROGRAM) -> bool is
            let at = _pick(program, "closer")

            if at < 0 then
                return false
            fi

            program.lines.remove_at(at)

            _record(program, "drop-closer", at, program.has_tail, true)
        si

        // A closer that belongs to a different construct - what a rename or
        // a bad paste leaves behind.
        _swap_closer(program: PROGRAM) -> bool is
            let at = _pick(program, "closer")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let others = LIST[string]()

            for candidate in LIST[string](["fi", "od", "si", "esac", "yrt"]) do
                if candidate !~ line.text then
                    others.add(candidate)
                fi
            od

            line.text = rng.pick(others)

            _record(program, "swap-closer", at, program.has_tail, true)
        si

        _duplicate_closer(program: PROGRAM) -> bool is
            let at = _pick(program, "closer")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]

            program.lines.insert(at, LINE(line.indent, line.text))

            _record(program, "duplicate-closer", at, program.has_tail, true)
        si

        // `if c` with no `then`, `while c` with no `do`, a header with no
        // `is`: the keyword that has not been typed yet.
        _drop_opener_keyword(program: PROGRAM) -> bool is
            let at = _pick(program, "opener")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let dropped mut = false

            for keyword in LIST[string]([" then", " do", " is", " =>"]) do
                if !dropped /\ line.text.ends_with(keyword) then
                    line.text = line.text[0..line.text.length - keyword.length]
                    dropped = true
                fi
            od

            if !dropped then
                return false
            fi

            _record(program, "drop-opener-keyword", at, program.has_tail, true)
        si

        _drop_bracket(program: PROGRAM, opening: bool) -> bool is
            let bracket = if opening then "(" else ")" fi
            let at = _pick_containing(program, bracket)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.index_of(bracket)

            line.text = "{line.text[0..cut]}{line.text[cut + 1..<0]}"

            _record(
                program,
                if opening then "drop-open-bracket" else "drop-close-bracket" fi,
                at,
                program.has_tail,
                true
            )
        si

        _insert_stray(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 then
                return false
            fi

            program.lines.insert(at, LINE(program.lines[at].indent, rng.pick(strays())))

            _record(program, "insert-stray", at, program.has_tail, true)
        si

        // Picking

        _pick(program: PROGRAM, role: string) -> int is
            let candidates = LIST[int]()

            for i in 0..program.lines.count do
                if program.lines[i].role =~ role then
                    candidates.add(i)
                fi
            od

            if candidates.count == 0 then
                return -1
            fi

            rng.pick(candidates)
        si

        _pick_containing(program: PROGRAM, text: string) -> int is
            let candidates = LIST[int]()

            for i in 0..program.lines.count do
                let line = program.lines[i]

                if (line.role =~ "statement" \/ line.role =~ "opener") /\ line.text.contains(text) then
                    candidates.add(i)
                fi
            od

            if candidates.count == 0 then
                return -1
            fi

            rng.pick(candidates)
        si

        _record(program: PROGRAM, mutation: string, at: int, tail: bool, after: bool) -> bool is
            program.mutation = mutation
            program.damage_line = at + 1
            program.expect_tail = tail
            program.expect_after = after

            true
        si
    si
si
