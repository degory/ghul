namespace RecoveryFuzz is
    use default

    use IO.File
    use IO.Directory
    use IO.Path

    // What compiling one program found.
    class OUTCOME(errors: LIST[string] public, timed_out: bool public, crashed: bool public) is
        init() is
            init(LIST[string](), false, false)
        si

        count: int => errors.count

        mentions(marker: string) -> bool => errors |> any(e => e.contains(marker))

        // A cascade is a parser mistake described more than once. Counting
        // errors cannot see it - the damage legitimately produces semantic
        // fallout wherever the code that depended on it was - so what is
        // counted is the number of distinct source lines carrying a *parse*
        // error. One mistake earns one place to report it; a second line is
        // allowed, since a missing closer is often only noticed at the
        // closer that turned up instead. Anything beyond that is the pile-up.
        parse_error_lines() -> LIST[int] is
            let result = LIST[int]()

            for e in errors do
                if !is_parse_error(e) then
                    continue
                fi

                let line = line_of(e)

                if line >= 0 /\ !(result |> any(l => l == line)) then
                    result.add(line)
                fi
            od

            result
        si

        // The parser's own reports, as against the semantic passes'. Every
        // one of the parser's either says what it expected or names the
        // construct it was reading.
        is_parse_error(error: string) -> bool =>
            error.contains("syntax error") \/
            error.contains(": error: expected ") \/
            error.contains(": error: in ")
    si

    // `test.ghul: 12,5..12,9: error: ...` - the line is what the oracle
    // reads; an error carrying no line is not counted.
    line_of(error: string) -> int is
        let colon = error.index_of(": ")

        if colon < 0 then
            return -1
        fi

        let rest = error[colon + 2..<0]
        let comma = rest.index_of(",")

        if comma <= 0 then
            return -1
        fi

        try
            return int.parse(rest[0..comma])
        catch caught: System.Exception
            return -1
        yrt
    si

    class HARNESS(compiler: string, work: string, timeout_seconds: int) is
        compile(program: PROGRAM, suffix: string) -> OUTCOME is
            let directory = Path.combine(work, "{program.seed}{suffix}")

            Directory.create_directory(directory)

            let source = Path.combine(directory, "test.ghul")

            File.write_all_text(source, program.source)

            let info = System.Diagnostics.ProcessStartInfo("dotnet")

            info.argument_list.add(compiler)
            info.argument_list.add("test.ghul")
            info.working_directory = directory
            info.use_shell_execute = false
            info.redirect_standard_output = true
            info.redirect_standard_error = true

            let process = System.Diagnostics.Process.start(info)!
            let text = process.standard_error.read_to_end_async()

            if !process.wait_for_exit(timeout_seconds * 1000) then
                try
                    process.kill(true)
                catch caught: System.Exception
                yrt

                return OUTCOME(LIST[string](), true, false)
            fi

            let errors = LIST[string]()
            let crashed mut = false

            for raw in text.result.split(['\n']) do
                let cleaned = raw.trim()

                if cleaned.length == 0 then
                    continue
                fi

                if cleaned.contains(": error: ") then
                    errors.add(cleaned)
                elif
                    cleaned.contains("Unhandled exception") \/
                    cleaned.contains("parse exception") \/
                    cleaned.contains("internal error") \/
                    cleaned.contains("   at ")
                then
                    crashed = true
                fi
            od

            OUTCOME(errors, false, crashed)
        si
    si
si
