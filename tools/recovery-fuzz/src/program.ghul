namespace RecoveryFuzz is
    use default

    // One physical source line. Mutations rewrite `text` or drop the line
    // outright, so the indent is kept beside it rather than baked in: a
    // mutation that replaces a line keeps the layout of the one it replaced.
    class LINE(indent: int, text: string public) is
        // What the generator knows this line to be - "statement", "opener",
        // "closer", or "plain". Mutations choose their target by role, and
        // the markers and canaries are left "plain" so that the program's
        // own oracle is never the thing that gets damaged.
        role: string public;

        init(..) is
            role = "plain"
        si

        render() -> string => "{string(' ', indent)}{text}"
    si

    // The three markers whose diagnostics say how much of the file survived
    // the damage. Each reads a name that does not exist, so the compiler
    // reports it once the line has been parsed and resolved, and says
    // nothing at all when the line was never parsed.
    //
    //   before  a global function ahead of the damaged one
    //   tail    a statement inside the damaged body, after the damage
    //   after   a global function behind the damaged one
    //
    // `tail` is the one that matters most: it is the difference between
    // resynchronising inside the body and dropping the rest of it, which is
    // what completion and incremental editing both need.
    before_marker() -> string => "undefined_before_marker"
    tail_marker() -> string => "undefined_tail_marker"
    after_marker() -> string => "undefined_after_marker"

    class PROGRAM(seed: int, context: string, lines: LIST[LINE]) is
        // Filled in by the mutator: what it did, where, and which markers it
        // left reachable. A mutation that truncates the file cannot expect
        // the markers it deleted.
        mutation: string public;
        // Whether the program was written with a tail marker at all: an
        // expression body has nowhere to put a statement.
        has_tail: bool public;
        expect_tail: bool public;
        expect_after: bool public;
        damage_line: int public;

        init(..) is
            mutation = "none"
            has_tail = true
            expect_tail = true
            expect_after = true
            damage_line = 0
        si

        source: string => "{lines |> map(l => l.render()) |> join("\n")}\n"
    si
si
