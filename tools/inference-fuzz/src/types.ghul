namespace InferenceFuzz is
    use default

    // The types a generated program's values can have. `spell` writes the
    // type as the annotator writes it back, so an intended type and an
    // annotated one compare as text once `normalise` has stripped what
    // the annotator adds.
    class Type abstract is
        spell() -> string;
        same(other: Type) -> bool;

        to_string() -> string => spell()
    si

    class PRIM(name: string): Type is
        spell() -> string => name
        same(other: Type) -> bool => if let p: PRIM = other then p.name =~ name else false fi
    si

    class ARRAY(element: Type): Type is
        spell() -> string => "{element.spell()}[]"
        same(other: Type) -> bool => if let a: ARRAY = other then a.element.same(element) else false fi
    si

    class LIST_OF(element: Type): Type is
        spell() -> string => "LIST[{element.spell()}]"
        same(other: Type) -> bool => if let l: LIST_OF = other then l.element.same(element) else false fi
    si

    class OPTIONAL(inner: Type): Type is
        spell() -> string => "{inner.spell()}?"
        same(other: Type) -> bool => if let o: OPTIONAL = other then o.inner.same(inner) else false fi
    si

    class TUPLE(elements: LIST[Type]): Type is
        spell() -> string => "({elements |> map(e => e.spell()) |> join(", ")})"

        same(other: Type) -> bool is
            if let t: TUPLE = other then
                if t.elements.count != elements.count then
                    return false
                fi

                for i in 0..elements.count do
                    if !elements[i].same(t.elements[i]) then
                        return false
                    fi
                od

                true
            else
                false
            fi
        si
    si

    class FUNC(parameters: LIST[Type], result: Type): Type is
        // A function of one parameter is written without parentheses, as
        // the annotator writes it, unless that parameter is itself a
        // tuple, an array or a function.
        spell() -> string =>
            if parameters.count == 1 /\ !(isa TUPLE(parameters[0]) \/ isa ARRAY(parameters[0]) \/ isa FUNC(parameters[0])) then
                "{parameters[0].spell()} -> {result.spell()}"
            else
                "({parameters |> map(p => p.spell()) |> join(", ")}) -> {result.spell()}"
            fi

        same(other: Type) -> bool is
            if let f: FUNC = other then
                if f.parameters.count != parameters.count \/ !f.result.same(result) then
                    return false
                fi

                for i in 0..parameters.count do
                    if !parameters[i].same(f.parameters[i]) then
                        return false
                    fi
                od

                true
            else
                false
            fi
        si
    si

    class TYPES is
        int: Type static => PRIM("int")
        bool: Type static => PRIM("bool")
        string: Type static => PRIM("string")
        double: Type static => PRIM("double")

        tuple(a: Type, b: Type) -> Type static => TUPLE(LIST[Type]([a, b]))
        func(a: Type, result: Type) -> Type static => FUNC(LIST[Type]([a]), result)
        func(a: Type, b: Type, result: Type) -> Type static => FUNC(LIST[Type]([a, b]), result)
    si

    // What the annotator adds to a type that the generator does not
    // intend: the purity of a proven-pure literal, and the element names a
    // tuple literal takes from the identifiers in it.
    normalise(spelling: string) -> string is
        let without_pure = System.Text.RegularExpressions.Regex.replace(spelling, " pure\\b", "")
        let without_names = System.Text.RegularExpressions.Regex.replace(without_pure, "\\b[a-z_][a-z0-9_]*: ", "")

        without_names.trim()
    si
si

namespace InferenceFuzz is
    use default

    // A type the program declares in its prelude: a class in a hierarchy,
    // a union or one of its variants, or an enum. `parent` is the class's
    // superclass, or a variant's union.
    class NAMED(name: string, parent: NAMED?): Type is
        spell() -> string => name
        same(other: Type) -> bool => if let n: NAMED = other then n.name =~ name else false fi

        ancestors() -> LIST[NAMED] is
            let result = LIST[NAMED]()
            let cursor: NAMED? mut = self

            while cursor? do
                result.add(cursor)
                cursor = cursor.parent
            od

            result
        si

        is_subtype_of(other: NAMED) -> bool => ancestors() |> any(a => a.name =~ other.name)
    si

    // The least upper bound the generator expects the compiler to find:
    // the nearest common ancestor of two declared types, `object` where
    // they share none, and the same rule element-wise under `?` and `[]`.
    lub(a: Type, b: Type) -> Type is
        if a.same(b) then
            return a
        fi

        if let na: NAMED = a then
            if let nb: NAMED = b then
                for ancestor in na.ancestors() do
                    if nb.is_subtype_of(ancestor) then
                        return ancestor
                    fi
                od

                return PRIM("object")
            fi
        fi

        if let oa: OPTIONAL = a then
            let joined = lub(oa.inner, b)

            return if isa OPTIONAL(joined) then joined else OPTIONAL(joined) fi
        elif let ob: OPTIONAL = b then
            let joined = lub(a, ob.inner)

            return if isa OPTIONAL(joined) then joined else OPTIONAL(joined) fi
        fi

        if let aa: ARRAY = a then
            if let ab: ARRAY = b then
                return ARRAY(lub(aa.element, ab.element))
            fi
        fi

        if let ta: TUPLE = a then
            if let tb: TUPLE = b /\ tb.elements.count == ta.elements.count then
                let elements = LIST[Type]()

                for i in 0..ta.elements.count do
                    elements.add(lub(ta.elements[i], tb.elements[i]))
                od

                return TUPLE(elements)
            fi
        fi

        PRIM("object")
    si

    // The types one program declares. The names are fixed; what varies
    // is the shape: whether the class root is abstract, which classes
    // are open, how deep the hierarchy goes, and which variants carry
    // fields.
    class PRELUDE(rng: RNG) is
        animal: NAMED;
        cat: NAMED;
        dog: NAMED;
        pup: NAMED?;
        shape: NAMED;
        chain: NAMED;
        circle: NAMED;
        square: NAMED;
        dot: NAMED;
        colour: NAMED;
        root_abstract: bool;
        cat_open: bool;
        dog_open: bool;

        init(..) is
            animal = NAMED("Animal", null)
            cat = NAMED("CAT", animal)
            dog = NAMED("DOG", animal)
            pup = if rng.coin() then NAMED("PUP", dog) else null fi
            shape = NAMED("Shape", null)
            chain = NAMED("Chain", null)
            circle = NAMED("Shape.CIRCLE", shape)
            square = NAMED("Shape.SQUARE", shape)
            dot = NAMED("Shape.DOT", shape)
            colour = NAMED("Colour", null)
            root_abstract = rng.coin()
            cat_open = rng.chance(1, 3)
            dog_open = rng.chance(1, 3)
        si

        classes() -> LIST[NAMED] is
            let result = LIST[NAMED]([cat, dog])

            if pup? then
                result.add(pup)
            fi

            if !root_abstract then
                result.add(animal)
            fi

            result
        si

        variants() -> LIST[NAMED] => LIST[NAMED]([circle, square, dot])

        source() -> string is
            let out = System.Text.StringBuilder()

            out.append_line("class Animal{if root_abstract then " abstract" else "" fi} is")

            if root_abstract then
                out.append_line("    describe() -> string")
            else
                out.append_line("    init() is si")
                out.append_line("    describe() -> string => \"animal\"")
            fi

            out.append_line("    legs: int => 4")
            out.append_line("si")
            out.append_line("")
            out.append_line("class CAT: Animal{if cat_open then " open" else "" fi} is")
            out.append_line("    init() is si")
            out.append_line("    describe() -> string => \"cat\"")
            out.append_line("    purr() -> string => \"purr\"")
            out.append_line("si")
            out.append_line("")
            out.append_line("class DOG: Animal{if dog_open then " open" else "" fi} is")
            out.append_line("    init() is si")
            out.append_line("    describe() -> string => \"dog\"")
            out.append_line("    bark() -> string => \"bark\"")
            out.append_line("si")
            out.append_line("")

            if pup? then
                out.append_line("class PUP: DOG is")
                out.append_line("    init() is si")
                out.append_line("    describe() -> string => \"pup\"")
                out.append_line("si")
                out.append_line("")
            fi

            out.append_line("union Shape is")
            out.append_line("    CIRCLE(radius: int)")
            out.append_line("    SQUARE(side: int, label: string)")
            out.append_line("    DOT")
            out.append_line("si")
            out.append_line("")
            out.append_line("union Chain is")
            out.append_line("    LINK(value: int, next: Chain)")
            out.append_line("    END")
            out.append_line("si")
            out.append_line("")
            out.append_line("enum Colour is")
            out.append_line("    RED,")
            out.append_line("    GREEN,")
            out.append_line("    BLUE,")
            out.append_line("si")
            out.append_line("")
            // Pack-taking functions of the program's own, beside the
            // runtime's, so a pack is bound from a literal alone as well
            // as from a call's other arguments.
            out.append_line("pack_apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)")
            out.append_line("pack_twice[T.., U](f: T.. -> U, v: T) -> (U, U) => (f(v), f(v))")
            out.append_line("pack_retry[T.., U](f: T.. -> U) -> T.. -> U => v => f(v)")
            out.append_line("")

            out.to_string()
        si
    si
si
