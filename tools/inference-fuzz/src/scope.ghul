namespace InferenceFuzz is
    use default

    // A name a generated program can read, with the type the generator
    // gave it. A delayed-initialised local cannot be captured by a
    // literal, so literals see only the others.
    class BINDING(name: string, type: Type, capturable: bool);

    class SCOPE(parent: SCOPE?) is
        _bindings: LIST[BINDING];

        init(..) is
            _bindings = LIST[BINDING]()
        si

        child() -> SCOPE => SCOPE(self)

        add(binding: BINDING) is
            _bindings.add(binding)
        si

        all() -> LIST[BINDING] is
            let result = LIST[BINDING]()

            collect(result)

            result
        si

        collect(into: LIST[BINDING]) is
            for b in _bindings do
                into.add(b)
            od

            if parent? then
                parent.collect(into)
            fi
        si

        of_type(type: Type) -> LIST[BINDING] => LIST[BINDING](all() |> filter(b => b.type.same(type)))

        // The scope a literal body sees: every capturable name.
        capturable() -> SCOPE is
            let result = SCOPE(null)

            for b in all() do
                if b.capturable then
                    result.add(b)
                fi
            od

            result
        si
    si

    class NAMES is
        _next: int;

        init() is
            _next = 0
        si

        fresh() -> string is
            let n = _next

            _next = _next + 1

            "v{n}"
        si
    si

    class RNG(seed: int) is
        _random: System.Random;

        init(..) is
            _random = System.Random(seed)
        si

        next(n: int) -> int => _random.next(n)
        between(low: int, high: int) -> int => _random.next(low, high + 1)
        coin() -> bool => _random.next(2) == 0
        chance(numerator: int, denominator: int) -> bool => _random.next(denominator) < numerator

        pick[T](items: LIST[T]) -> T => items[_random.next(items.count)]

        pick_weighted[T](items: LIST[(item: T, weight: int)]) -> T is
            let total mut = 0

            for entry in items do
                total = total + entry.weight
            od

            let roll = _random.next(total)
            let seen mut = 0

            for entry in items do
                seen = seen + entry.weight

                if roll < seen then
                    return entry.item
                fi
            od

            items[items.count - 1].item
        si
    si
si
