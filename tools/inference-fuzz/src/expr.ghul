namespace InferenceFuzz is
    use default

    use System.Text.StringBuilder

    // Writes expressions of a wanted type, choosing among the forms that
    // can produce it at random. `depth` is a budget the recursive forms
    // spend; leaves cost nothing. Returns null when no form fits.
    //
    // `typed` says whether the position the expression goes into already
    // states its type - a typed local, a call argument - so a literal
    // written there can leave its parameters unannotated and be inferred
    // from the context. Elsewhere a literal annotates them, or constrains
    // them from its own body.
    class EXPRESSIONS(rng: RNG, names: NAMES) is
        gen(scope: SCOPE, target: Type, depth: int, typed: bool) -> string? is
            let candidates = LIST[(item: string, weight: int)]()

            leaves(scope, target, typed, candidates)

            if depth > 0 then
                recursive(scope, target, depth, typed, candidates)
            fi

            if candidates.count == 0 then
                return null
            fi

            rng.pick_weighted(candidates)
        si

        // A value that is safe to print and to call with: literals only,
        // no reads of the program's own locals.
        closed(target: Type, depth: int) -> string? => gen(SCOPE(null), target, depth, true)

        leaves(scope: SCOPE, target: Type, typed: bool, into: LIST[(item: string, weight: int)]) is
            let variables = scope.of_type(target)

            if variables.count > 0 then
                into.add((item = rng.pick(variables).name, weight = 30))
            fi

            if let p: PRIM = target then
                prim_leaf(p, into)
            elif let a: ARRAY = target then
                if let elements = literal_elements(scope, a.element, rng.between(1, 3), 0) then
                    into.add((item = "[{elements}]", weight = 10))
                fi
            elif let l: LIST_OF = target then
                if let elements = literal_elements(scope, l.element, rng.between(1, 3), 0) then
                    into.add((item = "[{elements}] |> collect_list()", weight = 10))
                fi
            elif let f: FUNC = target then
                if let literal = lambda(scope, f, 0, typed) then
                    into.add((item = literal, weight = 10))
                fi
            elif let t: TUPLE = target then
                let parts = LIST[string]()

                for e in t.elements do
                    if let part = gen(scope, e, 0, true) then
                        parts.add(part)
                    fi
                od

                if parts.count == t.elements.count then
                    into.add((item = "({parts |> join(", ")})", weight = 10))
                fi
            fi
        si

        prim_leaf(p: PRIM, into: LIST[(item: string, weight: int)]) is
            if p.name =~ "int" then
                into.add((item = "{rng.next(20)}", weight = 20))
            elif p.name =~ "bool" then
                into.add((item = if rng.coin() then "true" else "false" fi, weight = 20))
            elif p.name =~ "string" then
                into.add((item = "\"{rng.pick(LIST[string](["hello", "world", "ghul", "a", ""]))}\"", weight = 20))
            elif p.name =~ "double" then
                into.add((item = "{rng.next(20)}.5", weight = 20))
            fi
        si

        literal_elements(scope: SCOPE, element: Type, count: int, depth: int) -> string? is
            let parts = LIST[string]()

            for i in 0..count do
                if let e = gen(scope, element, depth, true) then
                    parts.add(e)
                else
                    return null
                fi
            od

            parts |> join(", ")
        si

        recursive(scope: SCOPE, target: Type, depth: int, typed: bool, into: LIST[(item: string, weight: int)]) is
            // Forms any type has: a conditional, a block, a call of a
            // function in scope that returns the type.
            if let condition = gen(scope, TYPES.bool, depth - 1, true) then
                let a = gen(scope, target, depth - 1, typed)
                let b = gen(scope, target, depth - 1, typed)

                if a? /\ b? then
                    into.add((item = "(if {condition} then {a} else {b} fi)", weight = 5))
                fi
            fi

            // The block's own local is not a typed position, whatever the
            // block's is, and nothing need read it; so a function literal,
            // whose parameter types come from its uses, is not written
            // there.
            if !isa FUNC(target) then
            if let value = gen(scope, target, depth - 1, false) then
                let t = names.fresh()
                let inner = scope.child()

                inner.add(BINDING(t, target, true))

                if let tail = gen(inner, target, depth - 1, typed) then
                    into.add((item = "(let {t} = {value}; {tail})", weight = 4))
                fi
            fi
            fi

            for b in scope.all() do
                if let f: FUNC = b.type /\ f.result.same(target) then
                    if let arguments = call_arguments(scope, f, depth - 1) then
                        into.add((item = "{b.name}({arguments})", weight = 8))

                        if f.parameters.count == 1 then
                            into.add((item = "({arguments} |> {b.name}())", weight = 3))
                        fi
                    fi
                fi
            od

            if let p: PRIM = target then
                prim_recursive(scope, p, depth, into)
            elif let a: ARRAY = target then
                pipe_recursive(scope, a.element, depth, "collect_array", into)

                if let elements = literal_elements(scope, a.element, rng.between(1, 3), depth - 1) then
                    into.add((item = "[{elements}]", weight = 6))
                fi
            elif let l: LIST_OF = target then
                pipe_recursive(scope, l.element, depth, "collect_list", into)
            elif let t: TUPLE = target then
                let parts = LIST[string]()

                for e in t.elements do
                    if let part = gen(scope, e, depth - 1, true) then
                        parts.add(part)
                    fi
                od

                if parts.count == t.elements.count then
                    into.add((item = "({parts |> join(", ")})", weight = 8))
                fi
            elif let f: FUNC = target then
                if let literal = lambda(scope, f, depth - 1, typed) then
                    into.add((item = literal, weight = 8))
                fi
            elif let o: OPTIONAL = target then
                let condition = gen(scope, TYPES.bool, depth - 1, true)
                let value = gen(scope, o.inner, depth - 1, typed)

                if condition? /\ value? then
                    into.add((item = "(if {condition} then {value} fi)", weight = 8))
                fi
            fi
        si

        call_arguments(scope: SCOPE, f: FUNC, depth: int) -> string? is
            let parts = LIST[string]()

            for p in f.parameters do
                if let argument = gen(scope, p, depth, true) then
                    parts.add(argument)
                else
                    return null
                fi
            od

            parts |> join(", ")
        si

        prim_recursive(scope: SCOPE, p: PRIM, depth: int, into: LIST[(item: string, weight: int)]) is
            if p.name =~ "int" then
                let a = gen(scope, TYPES.int, depth - 1, true)
                let b = gen(scope, TYPES.int, depth - 1, true)

                if a? /\ b? then
                    into.add((item = "({a} {rng.pick(LIST[string](["+", "-", "*"]))} {b})", weight = 10))
                fi

                for sequence in sequences(scope) do
                    into.add((item = "{sequence}.count", weight = 3))
                od

                if let s = gen(scope, TYPES.string, depth - 1, true) then
                    into.add((item = "{s}.length", weight = 3))
                fi

                for element in [TYPES.int, TYPES.string] do
                    if let xs = gen(scope, ARRAY(element), depth - 1, true) then
                        into.add((item = "({xs} |> count())", weight = 3))
                    fi
                od

                if let xs = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    let a = names.fresh()
                    let b = names.fresh()

                    into.add((item = "({xs} |> reduce(0, ({a}, {b}) => {a} + {b}))", weight = 5))
                fi

                if let o = gen(scope, OPTIONAL(TYPES.int), depth - 1, true) then
                    into.add((item = "({o} ?? {rng.next(10)})", weight = 4))
                fi
            elif p.name =~ "bool" then
                let operand = rng.pick(LIST[Type]([TYPES.int, TYPES.string, TYPES.bool]))
                let a = gen(scope, operand, depth - 1, true)
                let b = gen(scope, operand, depth - 1, true)

                if a? /\ b? then
                    let operators =
                        if operand.same(TYPES.string) then
                            LIST[string](["=~", "!~"])
                        elif operand.same(TYPES.int) then
                            LIST[string](["==", "!=", "<", ">", "<=", ">="])
                        else
                            LIST[string](["==", "!="])
                        fi

                    into.add((item = "({a} {rng.pick(operators)} {b})", weight = 10))
                fi

                if let inner = gen(scope, TYPES.bool, depth - 1, true) then
                    into.add((item = "!({inner})", weight = 3))
                fi

                let l = gen(scope, TYPES.bool, depth - 1, true)
                let r = gen(scope, TYPES.bool, depth - 1, true)

                if l? /\ r? then
                    into.add((item = "({l} {rng.pick(LIST[string](["/\\", "\\/"]))} {r})", weight = 5))
                fi

                if let xs = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    let x = names.fresh()

                    into.add((item = "({xs} |> any({x} => {x} > {rng.next(10)}))", weight = 4))
                fi

                if let o = gen(scope, OPTIONAL(TYPES.string), depth - 1, true) then
                    into.add((item = "{o}?", weight = 3))
                fi
            elif p.name =~ "string" then
                let shown = rng.pick(LIST[Type]([TYPES.int, TYPES.bool, TYPES.string, TYPES.double]))

                if let inner = gen(scope, shown, depth - 1, true) then
                    into.add((item = "\"<{{{inner}}}>\"", weight = 6))
                fi

                let a = gen(scope, TYPES.string, depth - 1, true)
                let b = gen(scope, TYPES.string, depth - 1, true)

                if a? /\ b? then
                    into.add((item = "\"{{{a}}}-{{{b}}}\"", weight = 4))
                fi

                if let xs = gen(scope, ARRAY(TYPES.string), depth - 1, true) then
                    into.add((item = "({xs} |> join(\",\"))", weight = 4))
                fi
            elif p.name =~ "double" then
                let a = gen(scope, TYPES.double, depth - 1, true)
                let b = gen(scope, TYPES.double, depth - 1, true)

                if a? /\ b? then
                    into.add((item = "({a} {rng.pick(LIST[string](["+", "-", "*"]))} {b})", weight = 10))
                fi
            fi
        si

        sequences(scope: SCOPE) -> LIST[string] =>
            LIST[string](scope.all() |> filter(b => isa ARRAY(b.type) \/ isa LIST_OF(b.type)) |> map(b => b.name))

        // A pipe over a sequence of the element type, ending in the named
        // collector: a map, a filter, or both.
        pipe_recursive(scope: SCOPE, element: Type, depth: int, collector: string, into: LIST[(item: string, weight: int)]) is
            if !(element.same(TYPES.int) \/ element.same(TYPES.string)) then
                return
            fi

            if let source = gen(scope, ARRAY(element), depth - 1, true) then
                let x = names.fresh()
                let inner = scope.capturable()

                inner.add(BINDING(x, element, true))

                if let mapped = gen(inner, element, 1, true) then
                    into.add((item = "({source} |> map({x} => {mapped}) |> {collector}())", weight = 6))
                fi

                if let kept = gen(inner, TYPES.bool, 1, true) then
                    into.add((item = "({source} |> filter({x} => {kept}) |> {collector}())", weight = 6))
                fi

                if element.same(TYPES.int) then
                    let y = names.fresh()

                    into.add((item = "({source} |> map({x} => {x} * 2) |> filter({y} => {y} > {rng.next(10)}) |> {collector}())", weight = 4))
                fi
            fi

            if element.same(TYPES.string) then
                if let source = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    let x = names.fresh()

                    into.add((item = "({source} |> map({x} => \"n{{{x}}}\") |> {collector}())", weight = 4))
                fi
            fi
        si

        // A function literal of the shape. In a typed position the
        // parameters go unannotated; elsewhere they are annotated, unless
        // a body that constrains them on its own is available.
        lambda(scope: SCOPE, f: FUNC, depth: int, typed: bool) -> string? is
            let inner = scope.capturable()
            let parameters = LIST[string]()

            for p in f.parameters do
                let n = names.fresh()

                parameters.add(n)
                inner.add(BINDING(n, p, true))
            od

            let annotate = !typed

            if annotate /\ f.parameters.count == 1 then
                if let constrained = constrained_body(parameters[0], f.parameters[0], f.result) then
                    return "{parameters[0]} => {constrained}"
                fi
            fi

            let heads = LIST[string]()

            for i in 0..parameters.count do
                heads.add(if annotate then "{parameters[i]}: {f.parameters[i].spell()}" else parameters[i] fi)
            od

            let head =
                if parameters.count == 1 /\ !annotate then
                    heads[0]
                else
                    "({heads |> join(", ")})"
                fi

            if let body = gen(inner, f.result, depth, true) then
                if rng.chance(1, 3) then
                    "{head} is {body} si"
                else
                    "{head} => {body}"
                fi
            else
                null
            fi
        si

        // A body whose operations fix the parameter's type without an
        // annotation, for the shapes where one exists.
        constrained_body(parameter: string, from: Type, to: Type) -> string? is
            if from.same(TYPES.int) /\ to.same(TYPES.int) then
                "{parameter} + {rng.next(10)}"
            elif from.same(TYPES.int) /\ to.same(TYPES.bool) then
                "{parameter} > {rng.next(10)}"
            elif from.same(TYPES.string) /\ to.same(TYPES.int) then
                "{parameter}.length"
            elif from.same(TYPES.string) /\ to.same(TYPES.string) then
                "{parameter}.to_upper()"
            elif from.same(ARRAY(TYPES.int)) /\ to.same(TYPES.int) then
                "(if {parameter}.count > 0 then {parameter}[0] else 0 fi)"
            elif from.same(TYPES.tuple(TYPES.int, TYPES.int)) /\ to.same(TYPES.int) then
                let a = names.fresh()
                let b = names.fresh()

                "(let ({a}, {b}) = {parameter}; {a} + {b})"
            else
                null
            fi
        si
    si
si
