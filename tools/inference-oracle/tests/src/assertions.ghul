namespace Assertions is
    use MSTEST = Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    // MSTest's assertion overloads all carry trailing optional
    // caller-expression parameters, which a call cannot omit, so
    // these wrappers supply them.
    are_equal[T](expected: T, actual: T) is
        MSTEST.are_equal[T](expected, actual, "", "", "")
    si

    are_not_equal[T](expected: T, actual: T) is
        MSTEST.are_not_equal[T](expected, actual, "", "", "")
    si
si
