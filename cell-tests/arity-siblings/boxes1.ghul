use IO.Std.write_line

class BOX is
    init() is si
    name() -> string => "plain"
si

class BOX[T] is
    value: T public;
    init(value: T) is self.value = value; si
    name() -> string => "generic"
si

class COUNTER is
    next_id: int static;
    init() static is next_id = 1000; si
    id: int public;
    init() is id = next_id; next_id = next_id + 1; si
si

let a = BOX()
let b = BOX[int](5)
let c = COUNTER()
write_line("cell1: {a.name()} {b.name()} {b.value} {c.id}")
