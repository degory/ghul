use IO.Std.write_line
use kinds1.SHAPE
use kinds1.area
use kinds1.COUNTER
use kinds1.counting
use kinds1.double_async

let second = COUNTER();
let total mut = 0;

for n in counting(5) do
    total = total + n;
od

write_line("cell2: {area(SHAPE.RECT(3, 4))} {second.id} {total} {double_async(5).result}");
