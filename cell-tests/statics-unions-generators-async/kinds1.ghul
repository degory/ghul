use IO.Std.write_line

union SHAPE is
    CIRCLE(r: int);
    RECT(w: int, h: int);
si

area(s: SHAPE) -> int is
    if let c: SHAPE.CIRCLE = s then
        return 3 * c.r * c.r;
    fi

    if let r: SHAPE.RECT = s then
        return r.w * r.h;
    fi

    return 0;
si

class COUNTER is
    next_id: int static;

    init() static is
        next_id = 1000;
    si

    id: int public;

    init() is
        id = next_id;
        next_id = next_id + 1;
    si
si

counting(limit: int) -> Ghul.Pipes.Pipe[int] is
    let i mut = 0;

    while i < limit do
        yield i;
        i = i + 1;
    od
si

double_async(x: int) -> Tasks.TASK[int] is
    await Tasks.TASK.yield();

    return x * 2;
si

let first = COUNTER();
write_line("cell1: {area(SHAPE.CIRCLE(2))} {first.id} {double_async(21).result}");
