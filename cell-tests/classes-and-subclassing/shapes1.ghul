use IO.Std.write_line

class SHAPE is
    init() is si

    name() -> string => "shape"
    area() -> int => 0
si

class SQUARE(side: int): SHAPE is
    name() -> string => "square"
    area() -> int => side * side
si

describe(s: SHAPE) -> string => "{s.name()} {s.area()}"

write_line(describe(SQUARE(3)))
