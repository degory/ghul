use IO.Std.write_line
use animals1.ANIMAL
use animals1.DOG
use animals1.kind
use animals1.pet

class CAT: ANIMAL is
    init() is si
    sound() -> string => "meow"
si

write_line(kind(CAT()))
write_line(kind(pet))
write_line(kind(ANIMAL()))

if isa CAT(pet) then
    write_line("pet is a cat")
else
    write_line("pet is not a cat")
fi

let c: ANIMAL = CAT()
if isa CAT(c) then
    write_line("c is a cat: {c.sound()}")
fi

let d = cast DOG(pet)
write_line(d.fetch())
