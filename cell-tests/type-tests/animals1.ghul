use IO.Std.write_line

class ANIMAL is
    init() is si
    sound() -> string => "..."
si

class DOG: ANIMAL is
    init() is si
    sound() -> string => "woof"
    fetch() -> string => "fetching"
si

let pet: ANIMAL = DOG()

kind(a: ANIMAL) -> string is
    if isa DOG(a) then
        return "dog"
    fi

    return "animal"
si

write_line(kind(pet))
