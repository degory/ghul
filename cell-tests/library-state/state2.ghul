use IO.Std.write_line
use Collections.LIST
use Collections.MAP
use state1.items
use state1.counts
use state1.adder
use state1.counter
use state1.COUNTER

items.add("three")
counts["b"] = 2
counter.bump()

let more = LIST[int]()
more.add(7)

write_line("cell2: {items.count} {counts["b"]} {adder(10, 20)} {counter.count} {more.count}")

try
    throw Ghul.Exception("boom")
catch e: Ghul.Exception
    write_line("caught {e.message}")
yrt
