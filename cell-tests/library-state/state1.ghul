use IO.Std.write_line
use Collections.LIST
use Collections.MAP

let items = LIST[string]()
items.add("one")
items.add("two")

let counts = MAP[string, int]()
counts["a"] = 1

let adder = (a: int, b: int) => a + b

class COUNTER is
    count: int public
    init() is si
    bump() is count = count + 1; si
si

let counter = COUNTER()
counter.bump()

write_line("cell1: {items.count} {counts["a"]} {adder(2, 3)} {counter.count}")
