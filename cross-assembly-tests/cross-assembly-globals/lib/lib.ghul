namespace CrossAssemblyGlobals is
    add_one(v: int) -> int => v + 1;

    answer: int => 42;

    class TAG is
        text: string public;

        init(text: string) is
            self.text = text;
        si
    si

    // The `=~` -> `Equals` IL rename is for a type's own value-equality
    // member; a global `=~` operator keeps its own name, or it comes back
    // from reflection as `equals` and the operator no longer resolves.
    =~(a: TAG, b: TAG) -> bool => a.text =~ b.text;

    // ghūl currently always builds an entry-point-bearing assembly; this stub
    // satisfies that requirement so the lib can be referenced cross-assembly.
    entry() is si
si
