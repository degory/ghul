namespace Lib is
    // A pack declared in one assembly and used from another. Neither
    // formal's type says which reading it wants - both are the tuple the
    // pack binds to - so both markers have to survive into metadata for
    // the consumer to see them.
    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    // A marker written past the formal's own function type. Its depth
    // is no more recoverable from the type than its presence is, so it
    // has to survive into metadata too.
    run[T.., U](make: (int) -> T.. -> U, v: T..) -> U => make(10)(v);

    class EVENT[T..] is
        _handlers: Collections.LIST[T -> void];

        init() is
            _handlers = Collections.LIST[T -> void]();
        si

        subscribe(handler: T.. -> void) is
            _handlers.add(handler);
        si

        raise(v: T..) is
            for h in _handlers do
                h(v);
            od
        si
    si
si
