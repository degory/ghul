namespace Test is
    use IO.Std;

    concat(a: string, b: string) -> string => "{a}{b}";

    class Main is
        entry() static is
            Std.write_line(Lib.apply(concat, "x", "y"));
            Std.write_line(Lib.apply((a, b) => "{a}-{b}", "p", "q"));
            Std.write_line(Lib.apply(concat, ("x", "y")));

            Std.write_line("{Lib.run(n => (a, b) => a + b + n, 1, 2)}");

            let e = Lib.EVENT[(int, string)]();

            e.subscribe((n, s) => Std.write_line("{n} {s}"));

            e.raise(7, "seven");

            return;
        si
    si
si
