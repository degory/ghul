namespace Tests is
    use IO.Std.write_line;
    use Collections;

    use Microsoft.VisualStudio.TestTools.UnitTesting;

    use Ghul.Pipes;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;
        
    @TestClass()
    class ADAPTOR_PIPE_SHOULD is
        init() is
        si

        @Test()
        pipe_from_array_returns_instance_of_adaptor_pipe() is
            let source = pipe([1, 2, 3, 4, 5]);

            expect_equal(source.get_type(), typeof ADAPTOR_PIPE[int]);
            is_instance_of_type(source, typeof ADAPTOR_PIPE[int]);
        si

        @Test()
        count_non_empty_array_returns_element_count() is
            let source = ADAPTOR_PIPE[int]([1, 2, 3, 4, 5]);

            expect_equal(source |> count(), 5);
            are_equal(5, source |> count());
        si

        @Test()
        count_empty_array_returns_zero() is
            let source = ADAPTOR_PIPE[int](empty`[int]());

            expect_equal(source |> count(), 0);
            are_equal(0, source |> count());
        si

        // If the collection is a MutableBag (ICollection) then the count method should
        // call the Count method of the collection, rather than iterating over
        // the collection to count the elements.

        @IF.dont()
        @Test()
        count_mutable_bag_calls_mutable_bag_count() is
            let collection = Substitute.`for`[MutableBag[int]](empty`[object]());

            returns(collection.iterator, [1, 2, 3, 4].iterator, null);
            returns(collection.count, 4, null);

            let source = ADAPTOR_PIPE[int](collection);

            let count = source |> count();

            let actual = received(collection, 1).count;
        si

        // If the collection is a MutableBag (IReadOnlyCollection) then the count
        // method should call the Count method of the collection, rather than
        // iterating over the collection to count the elements.

        @IF.dont()
        @Test()
        count_bag_calls_bag_count() is
            let collection = Substitute.`for`[MutableBag[int]](empty`[object]());

            returns(collection.iterator, [1, 2, 3, 4].iterator, null);
            returns(collection.count, 4, null);

            let source = ADAPTOR_PIPE[int](collection);

            let count = source |> count();

            let actual = received(collection, 1).count;
        si

        @Test()
        iterator_returns_self() is
            let source = ADAPTOR_PIPE[string]([ "a", "b", "c" ]);

            expect_equal(source, source.iterator);
            are_same(source, source.iterator);
        si
        
        @Test()
        iterator_returns_correct_elements() is
            let source = ADAPTOR_PIPE[string]([ "a", "b", "c" ]);

            // FIXME: this shouldn't need a cast - why are array literals
            // not reliably Iterable[T] anymore?
            expect_equal([ "a", "b", "c" ] |> join(", "), source);
 
            assert_are_equal(
                [ "a", "b", "c" ],
                source
            );
        si
    si
si
