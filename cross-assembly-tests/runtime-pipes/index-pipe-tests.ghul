namespace Tests is

    use Collections;

    use Microsoft.VisualStudio.TestTools.UnitTesting;

    use Ghul.Pipes;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    @TestClass()
    class INDEX_PIPE_SHOULD is
        init() is
        si

        @Test()
        index_empty_array_returns_empty_sequence() is
            let pipe = 
                Ghul.Pipes.Factory.from`[int](empty`[int]());

            let result = 
                pipe
                    .index();

            expect_equal(empty`[INDEXED_VALUE[int]]() |, result);
            assert_are_equal(empty`[INDEXED_VALUE[int]](), result);
        si

        @Test()
        index_multiple_elements_returns_expected_sequence() is
            let pipe = 
                Ghul.Pipes.Factory.from`[string](["3", "4", "1", "5", "2", "3", "1", "4", "5"]);

            let result = 
                pipe
                    .index();

            expect_equal([iv(0, "3"), iv(1, "4"), iv(2, "1"), iv(3, "5"), iv(4, "2"), iv(5, "3"), iv(6, "1"), iv(7, "4"), iv(8, "5")] |, result);
            assert_are_equal([iv(0, "3"), iv(1, "4"), iv(2, "1"), iv(3, "5"), iv(4, "2"), iv(5, "3"), iv(6, "1"), iv(7, "4"), iv(8, "5")], result);
        si

        @Test()
        index_multiple_elements_positive_initial_index_returns_expected_sequence() is
            let pipe = 
                Ghul.Pipes.Factory.from`[string](["3", "4", "1", "5", "2", "3", "1", "4", "5"]);

            let result = 
                pipe
                    .index(3);

            expect_equal([iv(3, "3"), iv(4, "4"), iv(5, "1"), iv(6, "5"), iv(7, "2"), iv(8, "3"), iv(9, "1"), iv(10, "4"), iv(11, "5")] |, result);
            assert_are_equal([iv(3, "3"), iv(4, "4"), iv(5, "1"), iv(6, "5"), iv(7, "2"), iv(8, "3"), iv(9, "1"), iv(10, "4"), iv(11, "5")], result);
        si

        @Test()
        index_multiple_elements_negative_initial_index_returns_expected_sequence() is
            let pipe = 
                Ghul.Pipes.Factory.from`[string](["3", "4", "1", "5", "2", "3", "1", "4", "5"]);

            let result = 
                pipe
                    .index(-3);

            expect_equal([iv(-3, "3"), iv(-2, "4"), iv(-1, "1"), iv(0, "5"), iv(1, "2"), iv(2, "3"), iv(3, "1"), iv(4, "4"), iv(5, "5")] |, result);
            assert_are_equal([iv(-3, "3"), iv(-2, "4"), iv(-1, "1"), iv(0, "5"), iv(1, "2"), iv(2, "3"), iv(3, "1"), iv(4, "4"), iv(5, "5")], result);
        si

        @Test()
        indexed_value_to_string_returns_index_and_value_in_parentheses() is
            let indexedValue = iv(1234, "ABCD");

            expect_equal("(1234,ABCD)", indexedValue.to_string());
            are_equal("(1234,ABCD)", indexedValue.to_string());
        si        
    si
si



