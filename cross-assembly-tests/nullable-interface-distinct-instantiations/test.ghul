namespace Test is
    use IO.Std.write_line;
    use DistinctInstantiations.IBox;
    use DistinctInstantiations.Impl;

    // Impl implements IBox[string?] and IBox[object] - two different
    // closed instantiations of the same open generic interface, one
    // nullable in its argument, one not. Both assignments have to
    // succeed independently: if the two rows collapsed onto one map
    // entry (keying by the open generic definition rather than the
    // full instantiation), whichever row was read last would win for
    // both, and one of these two lines would be rejected.
    class Main is
        entry() static is
            let a: IBox[string?] = Impl();
            let b: IBox[object] = Impl();

            write_line("a.value: {a.value}");
            write_line("b.value: {b.value}");
        si
    si
si
