// `Ghul.Internal` is re-homed into `Ghul` on import, so `tag` and `=~`
// each arrive on two carriers of one namespace.
namespace Lib is
    describe(x: int) -> string => "int {x}"

    class PAIR(a: int, b: int);
si

namespace Ghul is
    tag(x: int) -> string => "Ghul int {x}"

    =~(a: Lib.PAIR, b: Lib.PAIR) -> bool pure => a.a == b.a /\ a.b == b.b
si
