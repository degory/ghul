// A fourth overload declared here joins the three imported from two
// assemblies.
namespace Lib is
    describe(x: bool) -> string => "bool {x}"

    remember_read() -> string => last_described
si

namespace Test is
    use IO.Std.write_line
    use Lib

    class MAIN is
        entry() static is
            write_line(describe(1))
            write_line(describe("two"))
            write_line(describe(3.0D))
            write_line(describe(true))

            remember("kept")
            write_line(last_described)
            last_described = "written"
            write_line(remember_read())

            write_line(Ghul.tag(1))
            write_line(Ghul.tag("two"))

            let maybe: string? = "x"
            write_line("{maybe =~ "x"} {"a" =~ "b"} {PAIR(1, 2) =~ PAIR(1, 2)} {PAIR(1, 2) =~ PAIR(2, 1)}")
        si
    si
si
