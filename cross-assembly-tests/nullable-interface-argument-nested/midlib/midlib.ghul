namespace NestedInterfaceArgument is
    use NestedInterfaceArgument.Outer_IInner

    // Implements a nested C# interface at a nullable type argument.
    // Read back from a third assembly (`test.ghul`), the interface's
    // own metadata reference is nested too — this is the case
    // `Semantic.DotNet.INTERFACE_NULLABILITY` resolves through a
    // `TypeReference` whose `ResolutionScope` names the enclosing type
    // rather than through a namespace string.
    class IMPL: Outer_IInner[string?] is
        value: string? public;

        init() is
        si
    si
si
