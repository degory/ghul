namespace Cell1 is
    // An ordinary closed hierarchy, compiled as one cell of a session.
    class Animal abstract is
        init() is si
    si

    class CAT: Animal is
        init() is super.init(); si

        purr() -> string => "purr";
    si

    class DOG: Animal is
        init() is super.init(); si

        bark() -> string => "woof";
    si

    class PROBE is
        init() is si

        // Reaches DOG by eliminating CAT, so nothing checked the value.
        bark_of(a: Animal) -> string is
            if isa CAT(a) then
                return a.purr();
            fi

            return a.bark();
        si
    si
si
