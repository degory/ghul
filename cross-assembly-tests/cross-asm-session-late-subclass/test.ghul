namespace Cell2 is
    use Cell1.Animal;
    use Cell1.PROBE;

    // A subclass the earlier cell's elimination never saw. Reaching it
    // through that cell's compiled narrowing is what the guard catches.
    class BIRD: Animal is
        init() is super.init(); si
    si

    entry() is
        try
            IO.Std.write_line(PROBE().bark_of(BIRD()));
        catch e: System.InvalidCastException
            IO.Std.write_line("guarded: {e.message}");
        yrt
    si
si
