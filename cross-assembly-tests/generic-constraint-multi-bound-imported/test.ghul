namespace Test is
    use IO.Std.write_line;

    use MultiBoundImported;

    // `Repo`1` declares `where T : INamed, ISized`. ghūl reads both
    // constraints from the assembly metadata: `Widget` satisfies them,
    // so the type is used normally.
    class Main is
        entry() static is
            let repo = Repo[Widget](Widget());

            write_line("{repo.item.name}/{repo.item.size}");
        si
    si
si
