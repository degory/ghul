namespace CrossAssemblyOperatorGlobals is
    // `$` is stripped from a reflected name when it is de-camelled, so an
    // operator carrying one has to bypass that or it arrives under a
    // different name - or, for a bare `$`, under no name at all.
    $(value: object?) -> string => "<{value}>";

    <$>(a: int, b: int) -> int => a * 100 + b;

    display_in_declaring_assembly(value: object?) -> string => $(value);

    // ghūl currently always builds an entry-point-bearing assembly; this stub
    // satisfies that requirement so the lib can be referenced cross-assembly.
    entry() is si
si
