namespace Test is
    use IO.Std.write_line;
    use CrossAssemblyOperatorGlobals;

    class Main is
        entry() static is
            write_line("declaring assembly: {display_in_declaring_assembly(42)}");

            // Named by its assembly, because `Ghul.$` is in scope too
            // and declares the same `object?` parameter - the two are
            // indistinguishable, so an unqualified call picks one of
            // them by declaration order rather than on merit. What is
            // under test is that the operator survives reflection at
            // all, which needs the call to reach a known one of the
            // two. The dot is separated from the name by the backtick
            // escape; without it `.$` scans as one operator.
            write_line("dollar: {CrossAssemblyOperatorGlobals.`$(42)}");
            write_line("dollar within name: {3 <$> 4}");
        si
    si
si
