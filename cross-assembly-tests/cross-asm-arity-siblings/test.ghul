use IO.Std.write_line;

use LibArity.BOX;

// Each arity sibling is reached, at its own type, from another
// assembly. The pair only survives the assembly boundary if each
// carries a metadata name of its own.
entry() is
    write_line(BOX("plain").label);
    write_line("{BOX[int](42).item}");

    write_line("{typeof BOX}");
    write_line("{(typeof BOX[_]).is_generic_type_definition}");
si
