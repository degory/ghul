namespace LibArity is
    // A name declared at two generic arities. Each sibling needs a
    // metadata name of its own, or the pair occupies one name and a
    // consumer importing this assembly resolves whichever row it
    // reaches first for both.
    class BOX is
        label: string public;

        init(label: string) is self.label = label; si
    si

    class BOX[T] is
        item: T public;

        init(item: T) is self.item = item; si
    si

    // ghūl currently always builds an entry-point-bearing assembly;
    // this stub satisfies that requirement so the lib can be
    // referenced cross-assembly.
    entry() is si
si
