namespace Test is
    use IO.Std.write_line;
    use RecordMembersVisible;

    class Main is
        entry() static is
            let p = POINT(3, 4);

            write_line(p.to_string());
            write_line("{p =~ POINT(3, 4)}");

            let (x, y) = p;
            write_line("x={x} y={y}");
        si
    si
si
