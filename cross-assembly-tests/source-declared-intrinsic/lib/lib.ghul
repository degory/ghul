// An assembly that declares its own intrinsics gets an innate
// registered into `Ghul` for each one, so that a call within this same
// compilation lowers to the opcode rather than to a call of the method
// declared here. The innate is owned by that namespace but stands for no
// method, so no row may be emitted for it. A row for the member of a
// generic type carries that type's parameter into the globals carrier,
// which has none, and every later read of the assembly then fails - which
// is what the consumer here is checking by simply calling into it.
namespace Ghul.Internal is
    @INTRINSIC_ATTRIBUTE("type.reference")
    struct CELL[E] is
        value: E => throw System.NotImplementedException(), = value is si
    si

    @INTRINSIC_ATTRIBUTE("compare.value")
    same_value[T](a: T, b: T) -> bool => false;
si

namespace SourceDeclaredIntrinsic is
    greeting() -> string => "hello from the declaring assembly";

    // ghūl currently always builds an entry-point-bearing assembly; this
    // stub satisfies that requirement so the lib can be referenced.
    entry() is si
si
