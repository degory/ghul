namespace Test is
    use IO.Std.write_line

    use Shapes

    class BIG: CIRCLE is
        init() is super.init() si
        name() -> string => "big circle"
    si

    class BIG_FACTORY: CIRCLE_FACTORY is
        init() is super.init() si
        make() -> BIG => BIG()
    si

    class OTHER_CIRCLE_FACTORY: FACTORY is
        init() is super.init() si
        make() -> CIRCLE => BIG()
    si

    class BIG_MAKER: Maker is
        init() is si
        make() -> BIG => BIG()
    si

    entry() is
        // A narrower return declared in the library is reached through
        // the base type from here, and returns the narrower type through
        // its own.
        let factory: FACTORY = CIRCLE_FACTORY()
        write_line("library override, through the base: {factory.make().name()}")

        let circle: CIRCLE = CIRCLE_FACTORY().make()
        write_line("library override, through its own type: {circle.name()}")

        let maker: Maker = CIRCLE_MAKER()
        write_line("library trait implementation, through the trait: {maker.make().name()}")

        // An override declared here of a narrower-returning library member,
        // reached from here and from library code holding the base type.
        write_line("override of a library override: {cast FACTORY(BIG_FACTORY()).make().name()}")
        write_line("the same, called inside the library: {call_through_base(BIG_FACTORY())}")
        write_line("narrowing a library base directly: {call_through_base(OTHER_CIRCLE_FACTORY())}")
        write_line("implementing a library trait: {call_through_trait(BIG_MAKER())}")
    si
si
