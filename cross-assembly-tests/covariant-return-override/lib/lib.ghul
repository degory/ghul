namespace Shapes is
    class SHAPE open is
        init() is si
        name() -> string => "shape"
    si

    class CIRCLE: SHAPE open is
        init() is super.init() si
        name() -> string => "circle"
    si

    class FACTORY open is
        init() is si
        make() -> SHAPE => SHAPE()
    si

    class CIRCLE_FACTORY: FACTORY open is
        init() is super.init() si
        make() -> CIRCLE => CIRCLE()
    si

    trait Maker open is
        make() -> SHAPE;
    si

    class CIRCLE_MAKER: Maker open is
        init() is si
        make() -> CIRCLE => CIRCLE()
    si

    call_through_base(factory: FACTORY) -> string => factory.make().name()

    call_through_trait(maker: Maker) -> string => maker.make().name()
si
