namespace Test is
    use IO.Std.write_line;
    use UnderscoreCrossAssemblyAccess;
    use UnderscoreCrossAssemblyAccessCs;

    class Main is
        entry() static is
            write_line("public_fn: {public_fn(1)}");
            write_line("public_method: {WIDGET().public_method()}");

            write_line("secret_fn: {_secret_fn(1)}");
            write_line("secret_method: {WIDGET()._helper()}");
            write_line("secret_type: {_SECRET()}");

            let m = MIXED();

            m.both = 1;
            write_line("both: {m.both}");

            m.get_only = 2;

            // A property whose getter is out of reach is not imported at all, so
            // its setter is unreachable even when the setter itself is public.
            // Only the read should have been rejected; the write is collateral.
            // Pinned so that narrowing it later registers as a deliberate change.
            m.set_only = 3;
            write_line("set_only: {m.set_only}");
        si
    si
si
