namespace Test is
    use IO.Std.write_line;
    use ImportedTraitProperty.Named;

    // Each way a class can supply a trait's property: a property with a
    // body, an auto-property, and a primary-constructor parameter.
    class COMPUTED: Named is
        init() is count = 1; si

        name: string => "computed";
        count: int public;
        describe() -> string => "{name} {count}";
        [index: int]: string => "{name}[{index}]";
    si

    class STORED: Named is
        init() is
            name = "stored";
            count = 2;
        si

        name: string;
        count: int public;
        describe() -> string => "{name} {count}";
        [index: int]: string => "{name}[{index}]";
    si

    class CAPTURED(name: string, count: int public): Named is
        describe() -> string => "{name} {count}";
        [index: int]: string => "{name}[{index}]";
    si

    show(named: Named) is
        named.count = named.count * 10;

        write_line("{named.name} {named.count} {named.describe()} {named[named.count]}");
    si

    class Main is
        entry() static is
            show(COMPUTED());
            show(STORED());
            show(CAPTURED("captured", 3));
        si
    si
si
