namespace Cell1 is
    // A closed trait, compiled as one cell of a session. A later cell
    // implementing it adds a type rather than invalidating a narrowing,
    // so it needs no guard and must simply work.
    trait Named is
        name() -> string;
    si

    class USES is
        init() is si

        greet(n: Named) -> string => "hello {n.name()}";
    si
si
