<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AssemblyName>binary</AssemblyName>
    <GhulOptions>--submission cell2 --reference $(MSBuildThisFileDirectory)lib/bin/$(Configuration)/net10.0/cross-asm-session-late-trait-lib.dll</GhulOptions>
  </PropertyGroup>
  <ItemGroup>
    <GhulSources Include="*.ghul" />
    <ProjectReference Include="lib/lib.ghulproj" />
  </ItemGroup>
</Project>
