use IO.Std.write_line;

use LibStatics.SETTINGS;

// Cross-asm access to a ghūl-declared UPPER_SNAKE static member: the
// reflected loader must resolve it under its declared name rather
// than de-camel-casing it to snake_case.
entry() is
    write_line("{SETTINGS.MAX_RETRIES}");
    write_line(SETTINGS.DEFAULT_LABEL);
si
