namespace LibStatics is
    // An UPPER_SNAKE static property and a read-only one, so a
    // consumer in another assembly can be checked against the name
    // they were declared under rather than a de-camel-cased one.
    class SETTINGS is
        MAX_RETRIES: int static;
        DEFAULT_LABEL: string static => "none";

        init() static is
            MAX_RETRIES = 3;
        si
    si

    // ghūl currently always builds an entry-point-bearing assembly;
    // this stub satisfies that requirement so the lib can be
    // referenced cross-assembly.
    entry() is si
si
