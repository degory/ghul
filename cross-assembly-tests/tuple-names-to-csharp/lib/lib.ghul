namespace TupleNamesToCSharp is
    use Collections.LIST

    class SOURCE is
        init() is si

        line() -> LIST[(x: int, y: int)] =>
            LIST[(x: int, y: int)]([(1, 2), (3, 4)])

        labelled() -> (label: string, span: (left: int, right: int)) =>
            ("span", (5, 6))

        cells() -> (row: int, column: int)[] => [(7, 8)]

        // Names on a tuple after an unnamed one, which only line up if
        // the unnamed tuple's slots are counted as well.
        after_unnamed() -> ((int, int), (named: int, too: int)) =>
            ((9, 10), (11, 12))
    si
si
