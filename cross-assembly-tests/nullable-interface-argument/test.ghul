namespace Test is
    use IO.Std.write_line;
    use Collections.MutableMap;

    use Probe.THING;

    // `THING` implements `MutableMap[string, string?]` — a nullable
    // reference type argument on an interface the class implements
    // directly. Assigning it to that interface type here, from a
    // different assembly than the one that declares it, once lost
    // conformance whenever a type argument was `?`: that annotation had
    // no reflection-visible carrier, and the emitter never wrote one
    // either.
    class Main is
        entry() static is
            let m: MutableMap[string, string?] = THING();

            m.add("key", "value");

            write_line("m['key']: {m["key"]}");
        si
    si
si
