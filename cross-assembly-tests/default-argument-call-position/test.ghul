namespace Test is
    use IO.Std.write_line;

    use DefaultArgLib;

    class Main is
        entry() static is
            write_line(Widget.describe(3, "gadgets"));
            write_line(Widget.describe(3, default));

            // `default[T]` always means the literal zero value of
            // `T` - never the callee's declared default value.
            write_line(Widget.describe(3, default[string]));

            // A named call omitting `suffix` synthesises its own
            // resolved `default` filling in the callee's declared
            // value; that synthesised value must survive the retry
            // that resolves the bare `default` passed for `label`.
            write_line(Widget.describe_with_suffix(count = 3, label = default));

            return;
        si
    si
si
