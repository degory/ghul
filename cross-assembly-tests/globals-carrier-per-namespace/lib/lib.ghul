// `Ghul.Internal` is re-homed into `Ghul` on import, so an assembly with
// globals in both contributes two carriers to one namespace.
namespace Ghul is
    twice(v: int) -> int => v * 2;
si

namespace Ghul.Internal is
    thrice(v: int) -> int => v * 3;
si

namespace GlobalsCarrierPerNamespaceEntry is
    // ghūl currently always builds an entry-point-bearing assembly; this stub
    // satisfies that requirement so the lib can be referenced cross-assembly.
    entry() is si
si
