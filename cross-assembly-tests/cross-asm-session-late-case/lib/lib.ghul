namespace Cell1 is
    // An ordinary closed hierarchy, compiled as one cell of a session.
    class Animal abstract is
        init() is si
    si

    class CAT: Animal is
        init() is super.init(); si

        purr() -> string => "purr";
    si

    class DOG: Animal is
        init() is super.init(); si

        bark() -> string => "woof";
    si

    class PROBE is
        init() is si

        // Exhaustive over the closed hierarchy, so it needs no else
        // and runs no arm at all for an alternative added later.
        say(a: Animal) is
            case a
            when c: CAT then IO.Std.write_line("cat")
            when d: DOG then IO.Std.write_line("dog")
            esac
        si
    si
si
