namespace Test is
    use IO.Std.write_line;

    use CrossAsmTypeDeclaredOperator.VECTOR;
    use CrossAsmTypeDeclaredOperator.VECTOR_OPS.`*;

    class Main is
        entry() static is
            let a = VECTOR(1, 2);
            let b = VECTOR(10, 20);

            write_line("sum: {a + b}");
            write_line("negated: {-a}");
            write_line("scaled: {a * 3}");
        si
    si
si
