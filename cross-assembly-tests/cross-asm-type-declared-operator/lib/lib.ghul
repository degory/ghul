namespace CrossAsmTypeDeclaredOperator is
    class VECTOR is
        x: int public;
        y: int public;

        init(x: int, y: int) is
            self.x = x;
            self.y = y;
        si

        +(a: VECTOR, b: VECTOR) -> VECTOR static pure => VECTOR(a.x + b.x, a.y + b.y);
        -(a: VECTOR) -> VECTOR static pure => VECTOR(-a.x, -a.y);

        to_string() -> string => "({x}, {y})";
    si

    // Neither operand is a `VECTOR_OPS`, so a consumer reaches these
    // only by importing them.
    class VECTOR_OPS is
        *(a: VECTOR, k: int) -> VECTOR static pure => VECTOR(a.x * k, a.y * k);
    si

    // ghul always builds an entry-point-bearing assembly; this stub
    // satisfies that so the lib can be referenced cross-assembly.
    entry() is si
si
