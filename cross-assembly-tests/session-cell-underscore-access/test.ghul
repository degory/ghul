// An earlier REPL cell's assembly-private definitions are visible to a
// later cell that references it, as they would be within one file: a
// global function and a type named with an underscore, reached here from
// an assembly that names the cell with --reference.
use IO.Std.write_line
use cell_one.POINT
use cell_one._helper
use cell_one._HIDDEN

let p = POINT(1, 2)

write_line("{_helper(p.secret)} {_HIDDEN().value}")
