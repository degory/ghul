namespace Test is
    use IO.Std.write_line;

    use MultiBoundLib;

    class THING: NAMED, SIZED is
        name() -> string => "thing";
        size() -> int => 7;
        init() is si
    si

    // The library's generic was emitted with both GenericParamConstraint
    // rows; the consumer reads them back and the body runs under them.
    class Main is
        entry() static is
            write_line(describe[THING](THING()));
        si
    si
si
