namespace PureLib is
    trait TICKER open is
        tick() -> int pure;
    si

    entry() is
    si

    class SOURCE is
        label: string? public;

        init(l: string?) is
            label = l;
        si

        describe() -> int pure is
            return "abc".to_upper().length;
        si

        select(f: (int) -> int pure, x: int) -> int pure => f(x);

        // Declared pure and carrying an optional slot: the method-level
        // marker has to be emitted ahead of the per-slot directive, or it
        // attaches to the parameter and the import loses the contract.
        measure(tag: string?) -> int pure => if tag? then tag.length else 0 fi;
    si
si
