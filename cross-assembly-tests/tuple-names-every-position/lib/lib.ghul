namespace TupleNamesEveryPosition is
    use Collections.LIST

    class HOLDER is
        // A field, and a property, whose type is a named tuple.
        stored: (name: string, n: int) field
        shown: (name: string, n: int)

        // A property whose type carries a named tuple as a type argument.
        entries: LIST[(name: string, n: int)]

        init() is
            stored = ("field", 1)
            shown = ("property", 2)

            entries = LIST[(name: string, n: int)]()
            entries.add(("listed", 3))
        si

        // A parameter and a return type that are named tuples.
        echo(pair: (name: string, n: int)) -> (name: string, n: int) => pair

        // A named tuple nested inside another.
        nested() -> (outer: string, inner: (left: int, right: int)) => ("outer", (4, 5))

        // A named tuple as an array element type.
        array() -> (x: int, y: int)[] => [(6, 7)]

        // A named tuple as the return type of a function type.
        maker() -> () -> (x: int, y: int) => () => (8, 9)

        // A named tuple as a parameter of a function type.
        taker() -> ((x: int, y: int)) -> int => p => p.x + p.y

        // Two tuples in one signature, each named, one nested in a generic.
        both() -> (first: (a: int, b: int), rest: LIST[(c: int, d: int)]) =>
            ((10, 11), LIST[(c: int, d: int)]([(12, 13)]))
    si
si
