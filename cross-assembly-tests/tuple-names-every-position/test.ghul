namespace Test is
    use IO.Std.write_line
    use TupleNamesEveryPosition.HOLDER

    entry() is
        let holder = HOLDER()

        write_line("field {holder.stored.name} {holder.stored.n}")
        write_line("property {holder.shown.name} {holder.shown.n}")
        write_line("generic argument {holder.entries[0].name} {holder.entries[0].n}")
        write_line("return {holder.echo(("echoed", 3)).name}")
        write_line("nested {holder.nested().outer} {holder.nested().inner.left} {holder.nested().inner.right}")
        write_line("array {holder.array()[0].x} {holder.array()[0].y}")
        write_line("function return {holder.maker()().x} {holder.maker()().y}")
        write_line("function parameter {holder.taker()((x = 1, y = 2))}")
        write_line("both {holder.both().first.a} {holder.both().first.b} {holder.both().rest[0].c} {holder.both().rest[0].d}")
    si
si
