namespace Cell2 is
    use Cell1.Animal;
    use Cell1.HOLDER;
    use Cell1.PROBE;
    use Cell1.PROP;

    class BIRD: Animal is
        init() is super.init(); si
    si

    report(what: string, run: () -> string) is
        try
            IO.Std.write_line("{what}: unguarded, answered {run()}");
        catch e: System.InvalidCastException
            IO.Std.write_line("{what}: guarded");
        catch e: System.AggregateException
            if isa System.InvalidCastException(e.inner_exception) then
                IO.Std.write_line("{what}: guarded");
            else
                IO.Std.write_line("{what}: unguarded, {e.inner_exception}");
            fi
        yrt
    si

    entry() is
        let p = PROBE();

        report("local", () => p.local(BIRD()));
        report("optional", () => p.optional(BIRD()));
        report("field path", () => p.field_path(HOLDER(BIRD())));
        report("property path", () => p.property_path(PROP(BIRD())));
        report("generator", () => p.generator(BIRD()) |> Ghul.Pipes.join(","));
        report("asynchronous", () => p.asynchronous(BIRD()).result);
    si
si
