namespace Cell1 is
    // Every route by which an earlier cell can present a value at a
    // type it reached by eliminating the alternatives: a local, an
    // optional scrutinee, a field path, a property path, and the two
    // state-machine forms, whose loads come off the frame rather than
    // a slot.
    class Animal abstract is
        init() is si
    si

    class CAT: Animal is
        init() is super.init(); si
    si

    class DOG: Animal is
        init() is super.init(); si

        bark() -> string => "woof";
    si

    class HOLDER is
        pet: Animal field

        init(pet: Animal) is self.pet = pet; si
    si

    class PROP is
        _pet: Animal

        init(pet: Animal) is _pet = pet; si

        pet: Animal => _pet;
    si

    class PROBE is
        init() is si

        local(a: Animal) -> string is
            if isa CAT(a) then
                return "cat";
            fi

            return a.bark();
        si

        optional(a: Animal?) -> string is
            if a? then
                if isa CAT(a) then
                    return "cat";
                fi

                return a.bark();
            fi

            return "none";
        si

        field_path(h: HOLDER) -> string is
            if isa CAT(h.pet) then
                return "cat";
            fi

            return h.pet.bark();
        si

        property_path(p: PROP) -> string is
            if isa CAT(p.pet) then
                return "cat";
            fi

            return p.pet.bark();
        si

        generator(a: Animal) -> Ghul.Pipes.Pipe[string] is
            if isa CAT(a) then
                yield "cat";
            else
                yield a.bark();
            fi
        si

        asynchronous(a: Animal) -> Tasks.TASK[string] is
            if isa CAT(a) then
                return "cat";
            fi

            await Tasks.TASK.yield();

            return a.bark();
        si
    si
si
