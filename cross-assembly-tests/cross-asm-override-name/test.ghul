use IO.Std.write_line;

use LibOverrideName.POINT;

// Cross-asm access to a member whose IL name is forced to differ
// from its ghūl name by the base it overrides: to_string() on a
// ghūl-compiled class still resolves under its declared name from
// another assembly, even though the emitted IL method is ToString.
entry() is
    let p = POINT(3, 4);

    write_line(p.to_string());
    write_line("{p}");
si
