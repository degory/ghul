namespace LibOverrideName is
    // Overriding to_string() forces the emitted IL method name to
    // ToString — the CLR requires an override's IL name to match the
    // virtual slot it overrides — even though the assembly is ghūl-
    // compiled throughout. A consumer must still reach it as
    // `to_string()`.
    class POINT(x: int, y: int) is
        to_string() -> string => "({x}, {y})";
    si

    entry() is si
si
