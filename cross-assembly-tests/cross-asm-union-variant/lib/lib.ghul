namespace LibUnion is
    // A simple two-variant union exported from a library so a
    // consumer in another assembly can construct and destructure
    // each variant.
    union RESULT[T] is
        OK(value: T);
        ERR(message: string);
    si

    // A non-generic union with a unit variant. A unit variant is
    // interned to one shared instance, held in a field of the variant's
    // own type — so a consumer in another assembly reaches that
    // instance by reference rather than by a row of its own. The
    // generic union above does not cover it: a generic variant's
    // instance is already reached through its instantiation.
    union STATUS is
        READY;
        FAILED(reason: string);
    si

    // A function returning the union so callers can drive both
    // branches without constructing the variants themselves.
    classify(n: int) -> RESULT[int] is
        if n >= 0 then
            return RESULT.OK(n);
        else
            return RESULT.ERR("negative: {n}");
        fi
    si

    // ghūl currently always builds an entry-point-bearing assembly;
    // this stub satisfies that requirement so the lib can be
    // referenced cross-assembly.
    entry() is si
si
