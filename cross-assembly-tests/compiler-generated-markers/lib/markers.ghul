namespace GeneratedMarkers is
    class WIDGET is
        label: string;
        _tally: int field;

        init() is
            label = "hi";
            _tally = 0;
        si

        describe() -> string is
            let suffix = (n: int) => n + _tally;
            return "{label}:{suffix(1)}";
        si
    si

    counting(limit: int) -> Ghul.Pipes.Pipe[int] is
        let i mut = 0;
        while i < limit do
            yield i;
            i = i + 1;
        od
    si

    total: int;

    bump(n: int) -> int is
        total = total + n;
        return total;
    si
si
