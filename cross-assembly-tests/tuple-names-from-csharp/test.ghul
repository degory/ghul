namespace Test is
    use IO.Std.write_line;
    use TupleNamesFromCSharp;

    class Main is
        entry() static is
            let p = Points.make_point(3, 4);

            // element access through names recovered from the C# assembly
            write_line("p.x={p.x} p.y={p.y}");

            // pass a tuple to a C# method whose parameter is a named tuple
            write_line("describe: {Points.describe((10, 20))}");

            // names recovered from tuples nested inside other types
            write_line("line: {Points.line()[1].x},{Points.line()[1].y}");

            let labelled = Points.labelled();

            write_line("labelled: {labelled.label} {labelled.span.left}..{labelled.span.right}");
            write_line("cells: {Points.cells()[0].row},{Points.cells()[0].column}");
        si
    si
si
