use IO.Std.write_line
use Collections

entry() is
    // a ghūl library's Set and MutableSet returns, read through the mapped names
    let evens: Set[int] = SetLib.evens(10)
    write_line("evens: {evens.count} has 4 {evens.contains(4)} has 5 {evens.contains(5)}")

    let tags: MutableSet[string] = SetLib.tags()
    tags.add("new")
    write_line("tags: {tags.count} has new {tags.contains("new")}")

    // a SET passed where C# declares IReadOnlySet and ISet
    let local = SET[int]()
    local.add(1)
    local.add(2)
    write_line("count from C#: {SetSink.Sets.count_of(local)}")

    let names = SET[string]()
    write_line("added from C#: {SetSink.Sets.add_to(names, "x")} {names.contains("x")}")

    // C#'s IReadOnlySet and ISet returns, typed as Set and MutableSet
    let primes: Set[int] = SetSink.Sets.primes()
    write_line("primes: {primes.count} has 7 {primes.contains(7)} subset {primes.is_subset_of([2, 3, 5, 7, 11])}")

    let colours: MutableSet[string] = SetSink.Sets.colours()
    colours.add("blue")
    write_line("colours: {colours.count}")

    // the read-only view is what a Set parameter accepts
    write_line("evens passed back: {SetSink.Sets.count_of(evens)}")
si
