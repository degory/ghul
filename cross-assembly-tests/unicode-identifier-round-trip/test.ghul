namespace Test is
    use Std = IO.Std;

    // The name crosses the assembly boundary in metadata, which is
    // UTF-8, and is read back by the same spelling it was written in.
    class Main is
        entry() static is
            let чашка = Библиотека.ЧАШКА(5);

            Std.write_line(чашка.описание());
            Std.write_line("{чашка.größe}");
        si
    si
si
