use IO.Std.write_line;

use LibErrors.MY_ERROR;

// Cross-asm access to a member inherited from a BCL base: the derived
// class's own assembly is ghūl-compiled, but the member was declared by
// an ordinary .NET assembly, so it resolves under its de-camel-cased
// name.
entry() is
    let error = MY_ERROR("boom");
    write_line(error.message);
si
