namespace LibErrors is
    // A ghūl class deriving from a BCL base, so a consumer in another
    // assembly can be checked against the inherited members: they were
    // declared by an ordinary .NET assembly, so they must still be
    // reached under their de-camel-cased names even though the derived
    // type's own assembly is ghūl-compiled.
    class MY_ERROR: System.Exception is
        init(message: string) is
            super.init(message);
        si
    si

    // ghūl currently always builds an entry-point-bearing assembly;
    // this stub satisfies that requirement so the lib can be
    // referenced cross-assembly.
    entry() is si
si
