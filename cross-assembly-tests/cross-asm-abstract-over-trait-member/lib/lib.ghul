namespace Lib is
    trait Renderable open is
        render() -> string;

        describe() -> string => "described";
    si

    class Expr: Renderable abstract open is
        init() is si

        render() -> string;

        // Redeclared with no body although the trait supplies a
        // default, so the default is withdrawn for anything below this
        // class. Reading it back from another assembly must leave the
        // hierarchy this assembly settled exactly as it is.
        describe() -> string;
    si
si
