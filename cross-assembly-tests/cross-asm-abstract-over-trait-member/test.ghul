namespace App is
    use Lib.Expr;
    use Lib.Renderable;

    class NUM: Expr is
        init() is super.init(); si

        render() -> string => "num";
    si

    entry() is
        let n = NUM();
        let as_expr: Expr = n;
        let as_trait: Renderable = n;

        IO.Std.write_line(n.render());
        IO.Std.write_line(as_expr.render());
        IO.Std.write_line(as_trait.render());
        IO.Std.write_line(as_trait.describe());
    si
si
