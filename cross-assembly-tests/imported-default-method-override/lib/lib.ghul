namespace ImportedDefaultMethodOverride is
    enum Kind is
        SMALL,
        LARGE
    si

    trait Shape open is
        area() -> int;

        check(text: string) -> Kind? => null

        pair(a: int, b: string) -> string => "default {a} {b}"

        label: string => "default label"

        [index: int]: string => "default [{index}]"
    si

    class SQUARE(side: int): Shape is
        area() -> int => side * side

        check(text: string) -> Kind? => Kind.LARGE

        pair(a: int, b: string) -> string => "square {a} {b}"

        label: string => "square label"

        [index: int]: string => "square [{index}]"
    si

    // Implements the trait without overriding its defaults, so it
    // inherits them.
    class CIRCLE(radius: int): Shape is
        area() -> int => radius * radius * 3
    si

    trait Holder[T] open is
        hold(value: T) -> string => "default holds {value}"
    si

    class BOX: Holder[int] is
        init() is si

        hold(value: int) -> string => "box holds {value}"
    si
si
