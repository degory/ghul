namespace Test is
    use IO.Std.write_line
    use ImportedDefaultMethodOverride

    entry() is
        let square = SQUARE(3)

        write_line("{square.check("x")}")
        write_line(square.pair(1, "b"))
        write_line(square.label)
        write_line(square[2])

        let shape: Shape = square

        write_line("{shape.check("x")}")
        write_line(shape.pair(1, "b"))

        write_line(BOX().hold(7))

        let circle = CIRCLE(1)

        write_line("{circle.check("x")?}")
        write_line(circle.pair(2, "c"))
        write_line(circle.label)
        write_line(circle[4])
    si
si
