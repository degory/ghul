// Not a step of that session - an ordinary consumer, which reaches the
// assembly through a project reference rather than by naming it as an
// earlier cell. Both extensions are rejected, exactly as they would be
// against any other assembly's closed types.
namespace Later is
    use IO.Std.write_line

    use earlier.Animal
    use earlier.Greeter

    class CAT: Animal, Greeter is
        init() is super.init() si

        speak() -> string => "meow"
        greet() -> string => "hello from a cat"
    si

    entry() is

        let pet: Animal = CAT()
        let greeter: Greeter = CAT()

        write_line(pet.speak())
        write_line(greeter.greet())
    si
si
