namespace Test is
    use IO.Std.write_line;

    use CrossAsmImportedEquality.POINT;
    use CrossAsmImportedEquality.COUNT;

    class Main is
        entry() static is
            let a = POINT(3);
            let b = POINT(3);
            let c = COUNT(3);
            let d = COUNT(5);

            write_line("point equal: {a =~ b}");
            write_line("count less: {c < d}");
            write_line("count greater: {d > c}");
            write_line("count compare: {c <> d}");
        si
    si
si
