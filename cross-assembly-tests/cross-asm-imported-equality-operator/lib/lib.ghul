namespace CrossAsmImportedEquality is
    struct POINT: Ghul.Equatable[POINT] is
        x: int public;

        init(x: int) is self.x = x; si

        =~(other: POINT) -> bool pure => x == other.x;

        get_hash_code() -> int pure => x;
    si

    class COUNT: Ghul.Comparable[COUNT] is
        x: int public;

        init(x: int) is self.x = x; si

        <>(other: COUNT) -> int pure => x - other.x;

        get_hash_code() -> int pure => x;
    si
si
