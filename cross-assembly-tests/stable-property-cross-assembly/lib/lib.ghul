namespace StablePropertyCrossAssembly is
    // A memoiser shape the classifier cannot prove self-stable: the
    // declaration reaches the importing assembly only through the
    // STABLE_ATTRIBUTE on the read accessor.
    class CACHE open is
        init() is si

        _cached: string?;

        value: string? stable =>
            val
                if _cached? then
                    return _cached;
                fi

                _cached = "{compute_part()}";
                _cached
            lav;

        compute_part() -> string => "computed";
    si
si
