namespace Test is
    use IO.Std.write_line;
    use StablePropertyCrossAssembly;

    takes(s: string) is
        write_line(s);
    si

    // The imported stable contract holds: the fact is backed and the
    // branch's re-read discharges.
    narrowed_through_imported_stable() is
        let cache = CACHE();

        if cache.value? then
            takes(cache.value);
        fi
    si

    // Declared stable: honours the imported contract.
    class DECLARED_OVERRIDE: CACHE is
        init() is si

        _w: string?;

        value: string? stable => _w;
    si

    // Provably self-stable without the declaration: a plain
    // passthrough the classifier proves. Honours the contract.
    class PROVEN_OVERRIDE: CACHE is
        init() is si

        _w: string?;

        value: string? => _w;
    si

    // Neither declared stable nor provably self-stable: rejected
    // here in the overriding assembly.
    class BAD_OVERRIDE: CACHE is
        init() is si

        _w: string?;

        value: string? =>
            val
                if _w? then
                    return _w;
                fi

                _w = "{compute_part()}";
                _w
            lav;

        compute_part() -> string => "computed";
    si

    class Main is
        entry() static is
            narrowed_through_imported_stable();
        si
    si
si
