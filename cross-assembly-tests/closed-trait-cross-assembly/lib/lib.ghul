namespace ClosedTraitCrossAssembly is
    trait Sealed is
        describe() -> string => "sealed";
    si

    trait Extensible open is
        describe() -> string => "extensible";
    si

    // Deriving from and implementing a closed trait inside its own
    // assembly stays legal - the closure is a boundary, not a seal.
    trait Refined: Sealed is
    si

    class WIDGET: Sealed, Refined is
        init() is si
    si

    class SHUT is
        init() is si
    si

    class OPENED open is
        init() is si
    si
si
