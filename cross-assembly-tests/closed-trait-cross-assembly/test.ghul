namespace Test is
    use IO.Std.write_line;
    use ClosedTraitCrossAssembly;

    // An `open` trait and an `open` class stay extensible from here.
    class ALLOWED: Extensible is
        init() is si
    si

    class ALSO_ALLOWED: OPENED is
        init() is super.init(); si
    si

    // Everything below reaches for a closed declaration in another
    // assembly, from each shape that can name one as an ancestor.
    class REJECTED_CLASS: Sealed is
        init() is si
    si

    struct REJECTED_STRUCT: Sealed is
    si

    union RejectedUnion: Sealed is
        ONE;
    si

    trait RejectedTrait: Sealed is
    si

    class TARGET is
        init() is si
    si

    impl Sealed for TARGET is
    si

    class REJECTED_SUBCLASS: SHUT is
        init() is super.init(); si
    si

    class Main is
        entry() static is
            write_line("{ALLOWED().describe()}");
        si
    si
si
