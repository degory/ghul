use IO.Std.write_line;

use LibHeaderUnion.VALUE;

describe(v: VALUE) -> string is
    if let zero: VALUE.ZERO = v then
        let (w) = zero;
        return "zero({w})";
    elif let named: VALUE.NAMED = v then
        let (w, n) = named;
        return "named({w}, {n})";
    fi

    return "other({v.width})";
si

entry() is
    write_line(describe(VALUE.ZERO(8)));
    write_line(describe(VALUE.NAMED(16, "x")));
    write_line(describe(VALUE.NONE(32)));
si
